(defconstant +end+ #xff)

(defun op-code (name)
  (or (first (find name *ops* :key #'second :test #'string=)) (bad "no op ~a" name)))

(defun op-name (code) (second (assoc code *ops*)))

(defun op-arguments (code) (third (assoc code *ops*)))

(defstruct (reader (:constructor reader (octets &optional (at 0)))) octets at)

(defun take (r count)
  (let ((end (+ (reader-at r) count)))
    (when (> end (length (reader-octets r)))
      (bad "transaction runs out at ~d" (reader-at r)))
    (prog1 (subseq (reader-octets r) (reader-at r) end)
      (setf (reader-at r) end))))

(defun take-byte (r) (aref (take r 1) 0))

(defun take-le (r count)
  (let ((o (take r count)))
    (loop :for i :from (1- count) :downto 0
          :for n := (aref o i) :then (logior (ash n 8) (aref o i))
          :finally (return n))))

(defun writer () (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0))

(defun put (w &rest octets) (dolist (o octets) (vector-push-extend o w)))

(defun put-octets (w octets) (loop :for o :across octets :do (vector-push-extend o w)))

(defun put-le (w count n) (dotimes (i count) (put w (ldb (byte 8 (* 8 i)) n))))

(defun signed (bits n) (if (logbitp (1- bits) n) (- n (ash 1 bits)) n))

(defun put-packed (w n)
  (let* ((s (signed 64 (ldb (byte 64 0) n)))
         (count (ceiling (integer-length s) 8)))
    (put w (logior (if (minusp s) 1 0) (ash count 4)))
    (loop :for i :from (1- count) :downto 0 :do (put w (ldb (byte 8 (* 8 i)) s)))))

(defun take-packed (r &optional (header (take-byte r)))
  (let ((n (- (logand header 1))))
    (dotimes (i (ash header -4) n)
      (setf n (logior (ash n 8) (take-byte r))))))

(defun integralp (x)
  (and (= x (ffloor x)) (<= (- (expt 2 63)) x (1- (expt 2 63)))))

(defun put-float (w x tag size bits)
  (if (integralp x)
      (put-packed w (truncate x))
      (progn (put w tag) (put-le w size bits))))

(defun take-float (r tag size convert)
  (let ((header (take-byte r)))
    (if (= header tag)
        (funcall convert (take-le r size))
        (funcall convert nil (take-packed r header)))))

(defun put-string (w s)
  (if (null s)
      (put w 0)
      (let ((o (sb-ext:string-to-octets s :external-format :utf-8)))
        (when (zerop (length o)) (bad "an empty string can't be sent"))
        (put w 2)
        (put-le w 4 (length o))
        (put-octets w o))))

(defun take-string (r)
  (case (take-byte r)
    (0 nil)
    (1 (let ((count (take-le r 4)))
         (when (zerop count) (bad "empty string"))
         (sb-ext:octets-to-string (take r (* 2 count)) :external-format :utf-16le)))
    (2 (let ((count (take-le r 4)))
         (when (zerop count) (bad "empty string"))
         (sb-ext:octets-to-string (take r count) :external-format :utf-8)))
    (t (bad "string tag ~d" (aref (reader-octets r) (1- (reader-at r)))))))

(defun put-data (w octets)
  (put-packed w (length octets))
  (put-octets w octets))

(defun take-data (r) (take r (take-packed r)))

(defun octets (x) (coerce x '(simple-array (unsigned-byte 8) (*))))

(defgeneric encode-argument (type value w))
(defgeneric decode-argument (type r))

(defmacro define-argument (type (value w r) encode decode)
  `(progn
     (defmethod encode-argument ((type (eql ,type)) ,value ,w) ,encode)
     (defmethod decode-argument ((type (eql ,type)) ,r) ,decode)))

(define-argument :u32 (v w r) (put-packed w (ldb (byte 32 0) v)) (ldb (byte 32 0) (take-packed r)))
(define-argument :i32 (v w r) (put-packed w v) (signed 32 (ldb (byte 32 0) (take-packed r))))
(define-argument :u64 (v w r) (put-packed w v) (ldb (byte 64 0) (take-packed r)))
(define-argument :u8 (v w r) (put w v) (take-byte r))
(define-argument :order (v w r) (put w (ldb (byte 8 0) v)) (signed 8 (take-byte r)))
(define-argument :bool (v w r) (put w (if v 1 0)) (/= 0 (take-byte r)))
(define-argument :string (v w r) (put-string w v) (take-string r))
(define-argument :uuid (v w r) (put-octets w v) (take r 16))
(define-argument :data (v w r) (put-data w v) (take-data r))

(define-argument :f32 (v w r)
  (put-float w v #x48 4 (sb-kernel:single-float-bits (coerce v 'single-float)))
  (take-float r #x48 4 (lambda (bits &optional n)
                         (if n (coerce n 'single-float) (sb-kernel:make-single-float (signed 32 bits))))))

(define-argument :f64 (v w r)
  (let ((d (coerce v 'double-float)))
    (put-float w d #x88 8 (logior (ash (ldb (byte 32 0) (sb-kernel:double-float-high-bits d)) 32)
                                (sb-kernel:double-float-low-bits d))))
  (take-float r #x88 8 (lambda (bits &optional n)
                         (if n
                             (coerce n 'double-float)
                             (sb-kernel:make-double-float (signed 32 (ash bits -32)) (ldb (byte 32 0) bits))))))

(macrolet ((opaque (type)
             `(define-argument ,type (v w r)
                (put-data w (or v #()))
                (let ((o (take-data r))) (if (zerop (length o)) nil o)))))
  (opaque :region)
  (opaque :path)
  (opaque :plist))

(macrolet ((array-of (type element)
             `(define-argument ,type (v w r)
                (progn (put-packed w (length v))
                       (map nil (lambda (e) (encode-argument ,element e w)) v))
                (coerce (loop :repeat (take-packed r) :collect (decode-argument ,element r)) 'vector))))
  (array-of :u32-array :u32)
  (array-of :u64-array :u64))

(define-argument :property (v w r)
  (cond ((null v) (put w 0))
        ((stringp v) (put w 1) (put-string w v))
        ((member v '(:true :false)) (put w 2 (if (eq v :true) 1 0)))
        (t (put w 3) (put-data w v)))
  (ecase (take-byte r)
    (0 nil)
    (1 (take-string r))
    (2 (if (zerop (take-byte r)) :false :true))
    (3 (take-data r))))

(define-argument :corner-mask (v w r)
  (destructuring-bind (width height extra rect mask) v
    (encode-argument :u32 (length mask) w)
    (encode-argument :u32 width w)
    (encode-argument :u32 height w)
    (encode-argument :u32 extra w)
    (dolist (x rect) (encode-argument :f64 x w))
    (put-octets w mask))
  (let* ((length (decode-argument :u32 r))
         (width (decode-argument :u32 r))
         (height (decode-argument :u32 r))
         (extra (decode-argument :u32 r))
         (rect (loop :repeat 4 :collect (decode-argument :f64 r))))
    (list width height extra rect (take r length))))

(defparameter +menu-bar-record+
  '(:u32 :u32 :u32 :u32 :u32 :u32 :u64 :f32 :f32 :u32 :u32 :f64 :f64 :f64 :f64 :f64 :f64 :f64 :f64))

(define-argument :menu-bars (v w r)
  (destructuring-bind (header floats flags records) v
    (dolist (x header) (encode-argument :u32 x w))
    (dolist (x floats) (encode-argument :f32 x w))
    (dolist (x flags) (encode-argument :u8 x w))
    (encode-argument :u32 (length records) w)
    (dolist (record records)
      (destructuring-bind (fields widths) record
        (mapc (lambda (type x) (encode-argument type x w)) +menu-bar-record+ fields)
        (encode-argument :u32 (length widths) w)
        (dolist (x widths) (encode-argument :f32 x w)))))
  (let ((header (loop :repeat 4 :collect (decode-argument :u32 r)))
        (floats (loop :repeat 4 :collect (decode-argument :f32 r)))
        (flags (loop :repeat 6 :collect (decode-argument :u8 r))))
    (list header floats flags
          (loop :repeat (decode-argument :u32 r)
                :collect (list (mapcar (lambda (type) (decode-argument type r)) +menu-bar-record+)
                               (loop :repeat (decode-argument :u32 r) :collect (decode-argument :f32 r)))))))

(define-argument :shadow (v w r)
  (progn (put-packed w (length v))
         (loop :for (key . value) :in v
               :do (put-string w key)
                   (if (realp value)
                       (progn (put w 1) (encode-argument :f32 value w))
                       (progn (put w 0) (encode-argument :bool value w)))))
  (loop :repeat (take-packed r)
        :collect (cons (take-string r)
                       (ecase (take-byte r)
                         (0 (decode-argument :bool r))
                         (1 (decode-argument :f32 r))))))

(define-argument :warp (v w r)
  (destructuring-bind (columns rows points) v
    (encode-argument :i32 columns w)
    (encode-argument :i32 rows w)
    (map nil (lambda (p) (encode-argument :f32 p w)) points))
  (let ((columns (decode-argument :i32 r))
        (rows (decode-argument :i32 r)))
    (list columns rows
          (coerce (loop :repeat (* 4 columns rows) :collect (decode-argument :f32 r)) 'vector))))

(defun encode-transaction (forms)
  (let ((w (writer)))
    (dolist (form forms (octets w))
      (destructuring-bind (name . values) form
        (let* ((code (op-code name))
               (types (op-arguments code)))
          (unless (= (length types) (length values))
            (bad "~a takes ~d arguments, not ~d" name (length types) (length values)))
          (put w code)
          (mapc (lambda (type value) (encode-argument type value w)) types values))))))

(defun decode-transaction (octets)
  (let ((r (reader (octets octets))))
    (loop :for code := (and (< (reader-at r) (length (reader-octets r))) (take-byte r))
          :while (and code (/= code +end+))
          :collect (let ((name (or (op-name code) (bad "invalid transaction opcode: 0x~2,'0x" code))))
                     (cons name (mapcar (lambda (type) (decode-argument type r)) (op-arguments code)))))))
