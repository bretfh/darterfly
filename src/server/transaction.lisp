   #:region-bands #:bands-octets #:rect-region #:region-bounds
   #:decode-event #:encode-event #:event-value #:event-type #:event-character #:key-event
   #:mouse-event #:event-location #:event-window-location
   #:transaction-error #:encode-transaction #:decode-transaction
   #:op-code #:op-name #:op-arguments #:*ops*))
(in-package #:finch/server)

(define-condition transaction-error (error)
  ((text :initarg :text :reader transaction-error-text))
  (:report (lambda (c s) (write-string (transaction-error-text c) s))))

(defun bad (control &rest args)
  (error 'transaction-error :text (apply #'format nil control args)))

(defun expand (arguments)
  (loop :for a :in arguments
        :if (consp a) :nconc (make-list (first a) :initial-element (second a))
        :else :collect a))

