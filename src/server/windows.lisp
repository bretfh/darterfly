(in-package #:darterfly/windowserver)

(defvar *window-epoch* (list (get-universal-time) (random most-positive-fixnum)))
(defvar *window-revision* 0)
(defvar *minimize-sequence* 0)
(defvar *flight* nil)

(defun window-handle (w) (list *window-epoch* (window-id w) (owner w)))
(defun handle-window (handle)
  (when (and (consp handle) (consp (cdr handle)) (consp (cddr handle))
             (null (cdddr handle)) (integerp (second handle)) (integerp (third handle))
             (equal (first handle) *window-epoch*))
    (let ((w (find-window (second handle)))) (and w (eql (owner w) (third handle)) w))))
(defun named-windows ()
  (remove-if-not (lambda (w) (and (zerop (window-level w)) (not (window-transient w))
                                 (or (ordered w) (minimized w)))) *windows*))
(defun window-description (w)
  (let ((process (bsd:pfind (owner w))))
    (list :handle (window-handle w) :app (if process (bsd:proc-comm process) "Application")
          :title (if (plusp (length (window-title w))) (window-title w) "Untitled window")
          :content-revision (window-content-revision w) :location (window-location w) :minimized (minimized w) :minimized-at (minimized-at w)
          :active (eq w (key-window)))))
(defun window-descriptions () (mapcar #'window-description (named-windows)))
(defun window-page (offset limit)
  (let* ((all (window-descriptions)) (start (max 0 (min (length all) (if (integerp offset) offset 0))))
         (end (min (length all) (+ start (max 1 (min 128 (if (integerp limit) limit 128)))))))
    (list :windows (subseq all start end) :total (length all) :next (and (< end (length all)) end)
          :revision *window-revision* :epoch *window-epoch*)))
(defun metadata-from (message)
  (let* ((body (mach:msgh-body message)) (w (and (integerp (second body)) (find-window (second body))))
         (pid (bsd:task-pid (mach:msgh-audit message))) (args (cddr body)))
    (when (and w (eql pid (owner w)))
      (flet ((bounded (s) (if (stringp s) (subseq s 0 (min 1024 (length s))) "")))
        (setf (window-title w) (bounded (getf args :title))
              (window-location w) (bounded (getf args :location))
              (window-thumb w) nil
              (window-private w) (not (null (getf args :private)))
              (window-transient w) (not (null (getf args :transient)))
              (window-question w) (not (null (getf args :question))))
      (incf (window-content-revision w))
      (incf *window-revision*)))))

(defun thumbnail (w)
  (unless (window-private w)
    (or (window-thumb w)
        (let* ((client (context-client (window-context w)))
               (width 72) (height 44)
               (fb (make-instance 'io:framebuffer :width width :height height
                         :pixels (make-array (* width height) :element-type '(unsigned-byte 32) :initial-element #xffe0dcd5)))
               (scale (min (/ width (max 1 (window-width w))) (/ height (max 1 (window-height w)))))
               (pixels (make-array (* width height 4) :element-type '(unsigned-byte 8))))
          (when (and client (root client))
            (let ((io:*clip* '(0 0 72 44)))
              (draw-layer fb (layers client) (root client) 0 0 '(0 0 72 44) 1.0 scale)))
          (dotimes (i (* width height))
            (let ((p (aref (io:framebuffer-pixels fb) i)))
              (setf (aref pixels (* i 4)) (ldb (byte 8 16) p)
                    (aref pixels (+ (* i 4) 1)) (ldb (byte 8 8) p)
                    (aref pixels (+ (* i 4) 2)) (ldb (byte 8 0) p)
                    (aref pixels (+ (* i 4) 3)) 255)))
          (setf (window-thumb w) (list :width width :height height :pixels pixels))))))

(defun flight-position (flight)
  (let* ((t0 (/ (- (get-internal-real-time) (flight-start flight))
                (* internal-time-units-per-second (max .001 (flight-duration flight)))))
         (v (max 0.0 (min 1.0 t0))) (ease (* v v (- 3 (* 2 v)))))
    (+ (flight-from flight) (* (- (flight-to flight) (flight-from flight)) ease))))
(defun flight-rect (f)
  (let* ((w (flight-window f)) (p (flight-display-position f)) (target (flight-target f))
         (scale (+ 1 (* p (- (min (/ (third target) (max 1 (window-width w)))
                                  (/ (fourth target) (max 1 (window-height w)))) 1))))
         (x (round (+ (window-x w) (* p (- (first target) (window-x w))))))
         (y (round (+ (window-y w) (* p (- (second target) (window-y w)))))))
    (list (- x 2) (- y 2) (+ x (ceiling (* scale (window-width w))) 2)
          (+ y (ceiling (* scale (window-height w))) 2))))
(defun damage-flight (f) (when f (apply #'damage (flight-rect f))))
(defun finish-flight ()
  (when *flight*
    (let ((w (flight-window *flight*)))
      (damage-flight *flight*)
      (setf *flight* nil)
      (when (member w *windows*)
        (unless (minimized w) (setf (ordered w) t))
        (damage-window w)))
    (update-focus)))
(defun minimize-target (w)
  (let* ((layout (layer:dock-layout (window-descriptions) (io:framebuffer-width *framebuffer*)
                                   (io:framebuffer-height *framebuffer*)))
         (items (getf layout :items))
         (item (or (find (window-handle w) items :key (lambda (i) (getf i :key)) :test #'equal)
                   (find :more items :key (lambda (i) (getf i :kind))) (first items)))
         (dock (getf layout :frame)) (rect (getf item :frame)))
    (list (+ (first dock) (first rect)) (+ (second dock) (second rect)) (third rect) (fourth rect))))
(defun transition-window (w down &key reduced-motion)
  (unless (and w (zerop (window-level w)) (not (window-transient w))) (return-from transition-window nil))
  (let ((was (minimized w)) (same (and *flight* (eq w (flight-window *flight*)))))
    (when (and (eql was down) (not same))
      (unless down (setf *windows* (cons w (remove w *windows*))) (update-focus))
      (return-from transition-window t))
    (when (and *flight* (not same)) (finish-flight))
    (let* ((from (if same (flight-position *flight*) (if down 0.0 1.0)))
           (to (if down 1.0 0.0)) (target (or (and same (flight-target *flight*))
                       (and (not down) was *framebuffer* (minimize-target w)))))
      (when (and down (not was))
        (setf (minimized-at w) (incf *minimize-sequence*) (window-thumb w) nil)
        (thumbnail w))
      (setf (minimized w) down (ordered w) (not down))
      (when (eq *capture* w) (setf *capture* nil))
      (when (and *drag* (eq (first *drag*) w)) (setf *drag* nil))
      (unless down (setf *windows* (cons w (remove w *windows*))))
      (incf *window-revision*)
      (when *framebuffer*
        (damage-flight *flight*)
        (setf *flight* (make-flight :window w :from from :to to :start (get-internal-real-time)
                                   :duration (* .28 (abs (- to from))) :display-position from :target (or target (minimize-target w))))
        (damage-window w) (damage-flight *flight*)
        (when *motion-wakeup* (sb-thread:condition-notify *motion-wakeup*)))
      (when (or reduced-motion (null *framebuffer*)) (finish-flight))
      (update-focus)
      t)))
(defun restore-handle (handle &key reduced-motion)
  (let ((w (handle-window handle)))
    (when (and w (member w (named-windows)))
      (when *framebuffer*
        (let* ((sw (io:framebuffer-width *framebuffer*)) (sh (io:framebuffer-height *framebuffer*))
               (width (min (window-width w) (- sw 16))) (height (min (window-height w) (- sh 138))))
          (set-frame w (list (max 8 (min (window-x w) (- sw width 8)))
                             (max 34 (min (window-y w) (- sh height 104))) width height))))
      (transition-window w nil :reduced-motion reduced-motion))))
(defun render-flight (fb screen)
  (when *flight*
    (let* ((f *flight*) (w (flight-window f)) (client (context-client (window-context w)))
           (p (flight-display-position f)) (target (flight-target f))
           (scale (+ 1 (* p (- (min (/ (third target) (max 1 (window-width w)))
                                    (/ (fourth target) (max 1 (window-height w)))) 1))))
           (x (round (+ (window-x w) (* p (- (first target) (window-x w))))))
           (y (round (+ (window-y w) (* p (- (second target) (window-y w)))))))
      (when (and client (root client))
        (let* ((width (ceiling (* scale (window-width w))))
               (height (ceiling (* scale (window-height w))))
               (radius (max 0 (round (* scale (corner-radius w)))))
               (saved (and (plusp radius) (io:save-corners fb x y width height radius))))
          (draw-layer fb (layers client) (root client) x y
                      (intersect screen (list x y (+ x width) (+ y height)))
                      (- 1.0 (* .35 p)) scale)
          (when saved (io:restore-corners fb x y width height radius saved)))))))
(defun window-motion-loop ()
  (loop
    (let ((started 0))
      (sb-thread:with-mutex (*lock*)
        ;; No periodic compositor wakeups when no window is moving.
        (loop until *flight* do (sb-thread:condition-wait *motion-wakeup* *lock*))
        (setf started (get-internal-real-time))
        (damage-flight *flight*)
        (setf (flight-display-position *flight*) (flight-position *flight*))
        (damage-flight *flight*)
        (when (>= (- started (flight-start *flight*))
                  (* internal-time-units-per-second (flight-duration *flight*)))
          (finish-flight))
        (render))
      ;; Rendering consumes part of the frame budget, not an extra 16ms on top.
      (sleep (max .001 (- (/ 1.0 60) (/ (- (get-internal-real-time) started)
                                       internal-time-units-per-second)))))))
