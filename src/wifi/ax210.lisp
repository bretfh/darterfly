(in-package #:darterfly/wifi)

(defstruct ax210
  pci regs firmware (log nil)
  ctxt scratch info rx-status rx-free rx-used (rx-buffers (make-array 512)) (rx-cur 0)
  cmd-ring iml sections paging alive)

(defparameter *firmware-path* "/Library/Firmware/iwlwifi-ty-a0-gf-a0-77.ucode")

(defconstant +page+ 4096)
(defconstant +rx-count+ 512)
(defconstant +cmd-slots+ 32)
(defconstant +umac-prph+ #x300000)

(defun note (w &rest items) (push items (ax210-log w)) items)

(defun reg (w off) (devices:mmio-read (+ (ax210-regs w) off) 32))
(defun (setf reg) (value w off) (devices:mmio-write (+ (ax210-regs w) off) 32 (ldb (byte 32 0) value)) value)
(defun set-reg-bits (w off bits) (setf (reg w off) (logior (reg w off) bits)))
(defun clear-reg-bits (w off bits) (setf (reg w off) (logandc2 (reg w off) bits)))

(defun microseconds () (truncate (* (get-internal-real-time) 1000000) internal-time-units-per-second))

(defun poll-reg (w off bits mask microseconds)
  (loop with deadline = (+ (microseconds) microseconds)
        when (= (logand (reg w off) mask) (logand bits mask)) return t
        when (> (microseconds) deadline) return nil))

(defun prph (w addr)
  (setf (reg w #x448) (logior (logand addr #xFFFFFF) (ash 3 24)))
  (reg w #x450))

(defun (setf prph) (value w addr)
  (setf (reg w #x444) (logior (logand addr #xFFFFFF) (ash 3 24)))
  (setf (reg w #x44C) value))

(defun nic-lock (w)
  (set-reg-bits w #x24 #x8)
  (or (poll-reg w #x24 #x1 #x11 150000)
      (error "the AX210 did not wake for register access")))

(defun nic-unlock (w) (clear-reg-bits w #x24 #x8))

(defmacro with-nic ((w) &body body)
  `(progn (nic-lock ,w) (unwind-protect (progn ,@body) (nic-unlock ,w))))

(defun dma-pages (n) (devices:vm-pages-grab n))
(defun dma-sap (pa) (devices:phys-sap pa))
(defun put-16 (pa off v) (setf (sb-sys:sap-ref-16 (dma-sap pa) off) v))
(defun put-32 (pa off v) (setf (sb-sys:sap-ref-32 (dma-sap pa) off) v))
(defun put-64 (pa off v) (setf (sb-sys:sap-ref-64 (dma-sap pa) off) v))
(defun get-16 (pa off) (sb-sys:sap-ref-16 (dma-sap pa) off))
(defun get-32 (pa off) (sb-sys:sap-ref-32 (dma-sap pa) off))

(defun dma-copy (octets)
  (let* ((octets (octets octets))
         (pa (dma-pages (ceiling (length octets) +page+))))
    (sb-sys:with-pinned-objects (octets)
      (sb-kernel:system-area-ub8-copy (sb-sys:vector-sap octets) 0 (dma-sap pa) 0 (length octets)))
    pa))

(defun dma-octets (pa start length)
  (let ((v (make-array length :element-type '(unsigned-byte 8))))
    (sb-sys:with-pinned-objects (v)
      (sb-kernel:system-area-ub8-copy (dma-sap pa) start (sb-sys:vector-sap v) 0 length))
    v))

(defun find-ax210 ()
  (find #x27258086 (devices:find-entries 'devices:pci-node) :key #'devices:pci-primary-id))

(defun read-file-octets (path)
  (with-open-file (s path :element-type '(unsigned-byte 8))
    (let ((v (make-array (file-length s) :element-type '(unsigned-byte 8))))
      (read-sequence v s)
      v)))

(defun make-card ()
  (let* ((pci (or (find-ax210) (error "no AX210 on the PCI bus")))
         (w (make-ax210 :pci pci :regs (devices:map-virtual-address (devices:map-device-memory-with-index pci 0))
                        :firmware (parse-firmware (read-file-octets *firmware-path*)))))
    (devices:config-write-8 pci #x41 0)
    (devices:config-write-16 pci 4 (logior (devices:config-read-16 pci 4) #x6))
    (setf (ax210-ctxt w) (dma-pages 1)
          (ax210-scratch w) (dma-pages 1)
          (ax210-info w) (dma-pages 1)
          (ax210-rx-status w) (dma-pages 1)
          (ax210-rx-free w) (dma-pages (/ (* 16 +rx-count+) +page+))
          (ax210-rx-used w) (dma-pages (/ (* 32 +rx-count+) +page+))
          (ax210-cmd-ring w) (dma-pages (/ (* 256 +cmd-slots+) +page+)))
    (dotimes (i +rx-count+) (setf (aref (ax210-rx-buffers w) i) (devices:vm-page-grab)))
    (let ((fw (ax210-firmware w)))
      (setf (ax210-iml w) (dma-copy (firmware-iml fw)))
      (destructuring-bind (&key lmac umac paging) (firmware-images fw)
        (setf (ax210-sections w) (list (mapcar (lambda (s) (dma-copy (cdr s))) lmac)
                                       (mapcar (lambda (s) (dma-copy (cdr s))) umac))
              (ax210-paging w) (mapcar (lambda (s) (dma-copy (cdr s))) paging))))
    w))

(defun hw-ready-p (w)
  (set-reg-bits w #x0 #x400000)
  (when (poll-reg w #x0 #x400000 #x400000 50)
    (set-reg-bits w #x88 #x20)
    t))

(defun prepare-card (w)
  (or (hw-ready-p w)
      (progn
        (set-reg-bits w #x250 #x80000000)
        (sleep 0.001)
        (loop repeat 10
              do (set-reg-bits w #x0 #x08000000)
                 (loop with deadline = (+ (microseconds) 150000)
                       until (> (microseconds) deadline)
                       do (when (hw-ready-p w) (return-from prepare-card t)))
                 (sleep 0.025))
        (error "the AX210 never said it was ready"))))

(defun apm-init (w)
  (set-reg-bits w #x100 #x800000)
  (set-reg-bits w #x240 #xFFFF0000)
  (set-reg-bits w #x0 #x80000)
  (set-reg-bits w #x3C #x2)
  (set-reg-bits w #x24 #x4)
  (unless (poll-reg w #x24 #x1 #x1 25000)
    (error "the AX210's clock never settled")))

(defparameter +ivar-causes+ '(#x0 #x1 #x3 #x5 #x10 #x11 #x12 #x15 #x16 #x17 #x18 #x29 #x2a #x2b #x2d #x2e))

(defun configure-msix (w)
  (with-nic (w) (setf (prph w (+ #xA05C00 +umac-prph+)) (ash 1 25)))
  (setf (reg w #x2804) #xFFFFFFFF (reg w #x280C) #xFFFFFFFF)
  (flet ((ivar (off) (devices:mmio-write (+ (ax210-regs w) off) 8 #x80)))
    (ivar #x2880) (ivar #x2881)
    (dolist (cause +ivar-causes+) (ivar (+ #x2890 cause))))
  (clear-reg-bits w #x2804 (logior 1 2 (ash 1 16) (ash 1 17) (ash 1 19) (ash 1 21)))
  (clear-reg-bits w #x280C (logior 1 2 4 (ash 1 5) (ash 1 6) (ash 1 7) (ash 1 8) (ash 1 25) (ash 1 26) (ash 1 27) (ash 1 29) (ash 1 30))))

(defun start-hardware (w)
  (prepare-card w)
  (set-reg-bits w #x20 #x80)
  (sleep 0.005)
  (apm-init w)
  (configure-msix w)
  (note w :hardware-up :gp-cntrl (reg w #x24) :rf-kill (not (logtest (reg w #x24) #x08000000))))

(defun fill-rx-ring (w)
  (dotimes (i +rx-count+)
    (put-16 (ax210-rx-free w) (* 16 i) i)
    (put-64 (ax210-rx-free w) (+ 8 (* 16 i)) (aref (ax210-rx-buffers w) i))))

(defun write-context (w)
  (let ((s (ax210-scratch w)) (c (ax210-ctxt w)) (info (ax210-info w)))
    (put-16 s 0 (logand (reg w #x28) #xFFFF))
    (put-16 s 4 (/ 1660 4))
    (put-32 s 8 #xF0000)
    (put-64 s 48 (ax210-rx-free w))
    (destructuring-bind (lmac umac) (ax210-sections w)
      (loop for pa in umac for i from 0 do (put-64 s (+ 124 (* 8 i)) pa))
      (loop for pa in lmac for i from 0 do (put-64 s (+ 636 (* 8 i)) pa)))
    (loop for pa in (ax210-paging w) for i from 0 do (put-64 s (+ 1148 (* 8 i)) pa))
    (put-64 c 8 info)
    (put-64 c 16 (ax210-rx-status w))
    (put-64 c 24 (+ info 2048))
    (put-64 c 32 (+ info 3072))
    (put-64 c 52 (ax210-cmd-ring w))
    (put-64 c 60 (ax210-rx-used w))
    (put-16 c 68 (- (integer-length (1- +cmd-slots+)) 3))
    (put-16 c 70 (integer-length (1- +rx-count+)))
    (put-64 c 88 s)
    (put-32 c 96 1660)))

(defun boot-firmware (w)
  (setf (reg w #x8) #xFFFFFFFF)
  (setf (reg w #x2804) #xFFFFFFFF (reg w #x280C) #xFFFFFFFF)
  (setf (reg w #x5C) #x2 (reg w #x5C) #x4)
  (setf (reg w #x8) #xFFFFFFFF)
  (apm-init w)
  (devices:mmio-write (+ (ax210-regs w) #x4) 8 #x40)
  (set-reg-bits w #xA8 #x800fffff)
  (setf (reg w #x280C) (lognot 1) (reg w #x2804) (lognot (logior 1 2 (ash 1 16) (ash 1 17) (ash 1 19) (ash 1 21))))
  (fill-rx-ring w)
  (write-context w)
  (let ((c (ax210-ctxt w)) (iml (ax210-iml w)))
    (setf (reg w #x118) (ldb (byte 32 0) c) (reg w #x11C) (ash c -32)
          (reg w #x120) (ldb (byte 32 0) iml) (reg w #x124) (ash iml -32)
          (reg w #x128) (length (firmware-iml (ax210-firmware w)))))
  (set-reg-bits w #x0 #x2)
  (with-nic (w)
    (setf (reg w #xD4) #x82FA82FA)
    (setf (prph w (+ #xA05C44 +umac-prph+)) 1))
  (let ((deadline (+ (microseconds) 2000000)))
    (loop
      (let ((hw (reg w #x2808)) (fh (reg w #x2800)))
        (when (or (logtest hw 1) (logtest hw (logior (ash 1 3) (ash 1 5) (ash 1 25) (ash 1 29))) (logtest fh (ash 1 21)))
          (setf (reg w #x2808) hw (reg w #x2800) fh)
          (note w :causes :hw hw :fh fh)
          (return (if (logtest hw 1) (firmware-alive w) (values nil (list :hw hw :fh fh)))))
        (when (> (microseconds) deadline)
          (return (values nil (note w :no-alive :hw hw :fh fh :ipc (get-32 (ax210-info w) 4) :boot-stage (get-32 (ax210-info w) 0)))))))))

(defun firmware-alive (w)
  (fill-rx-ring w)
  (setf (reg w #x1C80) 8)
  (let ((deadline (+ (microseconds) 1000000)))
    (loop until (or (/= (ax210-rx-cur w) (logand (get-16 (ax210-rx-status w) 0) #xFFF))
                    (> (microseconds) deadline)))
    (let ((packets (receive-packets w)))
      (note w :alive-packets packets)
      (setf (ax210-alive w) (find-if (lambda (p) (and (= 0 (getf p :group)) (= 1 (getf p :code)))) packets)))))

(defun receive-packets (w)
  (let ((hw (logand (get-16 (ax210-rx-status w) 0) #xFFF (1- +rx-count+))))
    (loop while (/= (ax210-rx-cur w) hw)
          collect (let* ((i (ax210-rx-cur w))
                         (rbid (get-16 (ax210-rx-used w) (+ 4 (* 32 i))))
                         (buffer (aref (ax210-rx-buffers w) (logand rbid (1- +rx-count+))))
                         (length (logand (get-32 buffer 0) #x3FFF)))
                    (setf (ax210-rx-cur w) (mod (1+ i) +rx-count+))
                    (list :code (sb-sys:sap-ref-8 (dma-sap buffer) 4) :group (sb-sys:sap-ref-8 (dma-sap buffer) 5)
                          :length length :payload (dma-octets buffer 8 (max 0 (min (- length 4) (- +page+ 8)))))))))

(defun alive-summary (packet)
  (let ((p (getf packet :payload)))
    (when (and p (>= (length p) 116))
      (list :status (logior (aref p 0) (ash (aref p 1) 8))
            :lmac (list (u32le p 4) (u32le p 8))
            :umac (list (u32le p 100) (u32le p 104))))))

(defvar *card* nil)

(defun bring-up ()
  (let ((w (or *card* (setf *card* (make-card)))))
    (setf (ax210-log w) nil (ax210-rx-cur w) 0 (ax210-alive w) nil)
    (start-hardware w)
    (boot-firmware w)
    (list :alive (alive-summary (ax210-alive w)) :log (reverse (ax210-log w)))))
