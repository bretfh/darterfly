(in-package #:finch/iokit)

(defun efi-system-table ()
  (sb-sys:sap-ref-32 (sb-sys:int-sap (boot-args)) 1104))

(defun acpi-rsdp ()
  (let* ((st (efi-system-table))
         (count (ml-phys-read-64 (+ st 104)))
         (table (ml-phys-read-64 (+ st 112))))
    (loop for i below count
          for entry = (+ table (* i 24))
          when (and (= (ml-phys-read-32 entry) #x8868e871)
                    (= (ml-phys-read-64 (+ entry 8)) #x81883cc7800022bc))
            return (ml-phys-read-64 (+ entry 16)))))

(defun acpi-table (signature)
  (let* ((xsdt (ml-phys-read-64 (+ (acpi-rsdp) 24)))
         (n (floor (- (ml-phys-read-32 (+ xsdt 4)) 36) 8)))
    (loop for i below n
          for table = (ml-phys-read-64 (+ xsdt 36 (* i 8)))
          when (string= (ml-phys-string table 4) signature)
            return table)))

(defun acpi-tables (signature)
  (let* ((xsdt (ml-phys-read-64 (+ (acpi-rsdp) 24)))
         (n (floor (- (ml-phys-read-32 (+ xsdt 4)) 36) 8)))
    (loop for i below n
          for table = (ml-phys-read-64 (+ xsdt 36 (* i 8)))
          when (string= (ml-phys-string table 4) signature)
            collect table)))

(defun table-octets (pa)
  (let* ((n (ml-phys-read-32 (+ pa 4)))
         (v (make-array n :element-type '(unsigned-byte 8))))
    (dotimes (i n v) (setf (aref v i) (ml-phys-read-8 (+ pa i))))))

(defun definition-blocks ()
  (let* ((fadt (acpi-table "FACP"))
         (dsdt (and fadt (if (and (>= (ml-phys-read-32 (+ fadt 4)) 148) (plusp (ml-phys-read-64 (+ fadt 140))))
                             (ml-phys-read-64 (+ fadt 140))
                             (ml-phys-read-32 (+ fadt 40))))))
    (mapcar #'table-octets (append (and dsdt (plusp dsdt) (list dsdt)) (acpi-tables "SSDT")))))

(defun aml-pkg-length (v at)
  (let* ((lead (aref v at)) (extra (ldb (byte 2 6) lead)))
    (if (zerop extra)
        (values (ldb (byte 6 0) lead) 1)
        (values (loop with n = (ldb (byte 4 0) lead)
                      for i from 1 to extra
                      do (setf n (logior n (ash (aref v (+ at i)) (- (* 8 i) 4))))
                      finally (return n))
                (1+ extra)))))

(defun name-seg-p (v at)
  (and (<= (+ at 4) (length v))
       (loop for i below 4
             for c = (aref v (+ at i))
             always (or (<= 65 c 90) (<= 48 c 57) (= c 95)))
       (not (<= 48 (aref v at) 57))))

(defun aml-name (v at)
  (loop while (and (< at (length v)) (member (aref v at) '(#x5c #x5e))) do (incf at))
  (when (< at (length v))
    (multiple-value-bind (count at)
        (case (aref v at)
          (#x2e (values 2 (1+ at)))
          (#x2f (values (aref v (1+ at)) (+ at 2)))
          (t (values 1 at)))
      (when (loop for i below count always (name-seg-p v (+ at (* 4 i))))
        (values (loop for i below count collect (map 'string #'code-char (subseq v (+ at (* 4 i)) (+ at (* 4 i) 4))))
                (+ at (* 4 count)))))))

(defun aml-blocks (v &key devices-only)
  (loop for at below (- (length v) 6)
        for op = (cond ((and (= (aref v at) #x5b) (= (aref v (1+ at)) #x82)) 2)
                       ((and (not devices-only) (= (aref v at) #x10)) 1))
        for block = (when op
                      (multiple-value-bind (length used) (aml-pkg-length v (+ at op))
                        (multiple-value-bind (segs body) (aml-name v (+ at op used))
                          (let ((end (+ at op length)))
                            (when (and segs (< body end) (<= end (length v)))
                              (list (car (last segs)) body end))))))
        when block collect block))

(defun aml-find (v pattern start end)
  (search pattern v :start2 start :end2 (min end (length v))))

(defun aml-integer (v at)
  (case (aref v at)
    (#x00 0) (#x01 1) (#xff #xffffffffffffffff)
    (#x0a (aref v (1+ at)))
    (#x0b (logior (aref v (1+ at)) (ash (aref v (+ at 2)) 8)))
    (#x0c (loop for i below 4 sum (ash (aref v (+ at 1 i)) (* 8 i))))
    (#x0e (loop for i below 8 sum (ash (aref v (+ at 1 i)) (* 8 i))))))

(defun aml-integer-size (v at)
  (case (aref v at) (#x0a 2) (#x0b 3) (#x0c 5) (#x0e 9) (t 1)))

(defun octets-of (string) (map '(vector (unsigned-byte 8)) #'char-code string))

(defun aml-named-at (v name start end)
  (let ((at (aml-find v (concatenate '(vector (unsigned-byte 8)) #(8) (octets-of name)) start end)))
    (and at (+ at 5))))

(defun aml-resources (v start end)
  (let ((at (aml-named-at v "_CRS" start end)))
    (when (and at (= (aref v at) #x11))
      (multiple-value-bind (length used) (aml-pkg-length v (1+ at))
        (let* ((size-at (+ at 1 used))
               (data (+ size-at (aml-integer-size v size-at)))
               (stop (min (+ at 1 length) (length v)))
               (resources nil))
          (loop while (< data stop)
                do (let ((tag (aref v data)))
                     (if (logbitp 7 tag)
                         (let ((n (logior (aref v (1+ data)) (ash (aref v (+ data 2)) 8))))
                           (case tag
                             (#x8e (when (= (aref v (+ data 5)) 1)
                                     (let* ((tdlen (logior (aref v (+ data 10)) (ash (aref v (+ data 11)) 8)))
                                            (source (+ data 12 tdlen))
                                            (stop (or (position 0 v :start source :end (+ data 3 n)) (+ data 3 n))))
                                       (push (list :i2c
                                                   :speed (loop for i below 4 sum (ash (aref v (+ data 12 i)) (* 8 i)))
                                                   :address (logior (aref v (+ data 16)) (ash (aref v (+ data 17)) 8))
                                                   :source (map 'string #'code-char (subseq v source stop)))
                                             resources))))
                             (#x89 (push (list :interrupt
                                               :flags (aref v (+ data 3))
                                               :gsi (loop for i below 4 sum (ash (aref v (+ data 5 i)) (* 8 i))))
                                         resources)))
                           (incf data (+ 3 n)))
                         (progn
                           (when (= (ldb (byte 4 3) tag) #xf) (return))
                           (incf data (1+ (ldb (byte 3 0) tag)))))))
          (nreverse resources))))))

(defun aml-package-integers (v at)
  (when (and at (= (aref v at) #x12))
    (multiple-value-bind (length used) (aml-pkg-length v (1+ at))
      (declare (ignore length))
      (let ((p (+ at 1 used 1)))
        (loop repeat (aref v (+ at 1 used))
              collect (aml-integer v p)
              do (incf p (aml-integer-size v p)))))))

(defun i2c-controller-of (blocks segment)
  (let (adr fmcn)
    (dolist (v blocks)
      (loop for (name start end) in (aml-blocks v)
            when (string= name segment)
              do (let ((at (aml-named-at v "_ADR" start end)))
                   (when (and at (not adr)) (setf adr (aml-integer v at))))
                 (let ((at (aml-named-at v "FMCN" start end)))
                   (when (and at (not fmcn)) (setf fmcn (aml-package-integers v at))))))
    (values adr fmcn)))

(defvar *i2c-hid-devices* :unknown)

(defun i2c-hid-devices ()
  (when (eq *i2c-hid-devices* :unknown)
    (setf *i2c-hid-devices*
          (let ((blocks (definition-blocks))
                (found nil))
            (dolist (v blocks)
              (let ((devices (aml-blocks v :devices-only t)))
                (dolist (pattern (list (concatenate '(vector (unsigned-byte 8)) #(#x0d) (octets-of "PNP0C50") #(0))
                                       #(#x0c #x41 #xd0 #x0c #x50)))
                  (loop for hit = (search pattern v) then (search pattern v :start2 (1+ hit))
                        while hit
                        do (let ((device (first (sort (remove-if-not (lambda (b) (< (second b) hit (third b))) devices)
                                                      #'< :key (lambda (b) (- (third b) (second b)))))))
                             (when device
                               (let* ((resources (aml-resources v (second device) (third device)))
                                      (bus (find :i2c resources :key #'first))
                                      (irq (find :interrupt resources :key #'first)))
                                 (when bus
                                   (multiple-value-bind (adr fmcn)
                                       (i2c-controller-of blocks (car (last (uiop:split-string (getf (rest bus) :source) :separator ".\\"))))
                                     (pushnew (list :name (first device) :address (getf (rest bus) :address)
                                                    :speed (getf (rest bus) :speed) :controller adr :timing fmcn
                                                    :gsi (and irq (getf (rest irq) :gsi))
                                                    :flags (and irq (getf (rest irq) :flags)))
                                              found :test #'equal))))))))))
            (nreverse found))))
  *i2c-hid-devices*)
