(in-package #:finch/iokit)

(defconstant +ecm-receive-pages+ 16)
(defconstant +ecm-send-pages+ 16)

(define-io-class apple-usb-cdc-ecm "AppleUSBCDCECMData" (io-ethernet-controller)
  ((controller :initarg :controller :reader ecm-controller)
   (slot :initarg :slot :reader ecm-slot)
   (in-ring :accessor ecm-in-ring)
   (in-dci :accessor ecm-in-dci)
   (out-ring :accessor ecm-out-ring)
   (out-dci :accessor ecm-out-dci)
   (mps :accessor ecm-mps)
   (pending :initform (make-hash-table) :reader ecm-pending)
   (frames :initform nil :accessor ecm-frames)
   (send-pages :accessor ecm-send-pages)
   (send-next :initform 0 :accessor ecm-send-next)
   (in-flight :initform 0 :accessor ecm-in-flight)
   (counts :initform (list :received 0 :sent 0 :receive-codes nil :send-codes nil) :accessor ecm-counts)
   (mac :accessor network-mac)))

(defun ecm-layout (config)
  (let (interface class subclass alt comm mac-index data data-alt endpoints)
    (dolist (d (descriptors config))
      (case (aref d 1)
        (4 (setf interface (aref d 2) alt (aref d 3) class (aref d 5) subclass (aref d 6))
           (when (and (= class 2) (= subclass 6)) (setf comm interface)))
        (#x24 (when (and (> (length d) 3) (= (aref d 2) #x0f) (eql interface comm))
                (setf mac-index (aref d 3))))
        (5 (when (and (= class #x0a) (plusp alt) (= (logand (aref d 3) 3) 2))
             (setf data interface data-alt alt)
             (push (list (aref d 2) (logand (logior (aref d 4) (ash (aref d 5) 8)) #x7ff) 0) endpoints)))
        (#x30 (when (and endpoints (= class #x0a))
                (setf (third (first endpoints)) (aref d 2))))))
    (values comm mac-index data data-alt (nreverse endpoints))))

(defun ecm-mac (c slot ring index)
  (let ((v (and index (plusp index) (ignore-errors (read-descriptor c slot ring 3 index 26 #x0409)))))
    (if (and v (>= (length v) 26))
        (let ((text (map 'string (lambda (i) (code-char (aref v (+ 2 (* 2 i))))) (loop for i below 12 collect i))))
          (coerce (loop for i below 6 collect (parse-integer text :start (* 2 i) :end (+ 2 (* 2 i)) :radix 16))
                  '(vector (unsigned-byte 8))))
        (let ((state (make-random-state t)))
          (coerce (cons #x02 (loop repeat 5 collect (random 256 state))) '(vector (unsigned-byte 8)))))))

(defun ecm-queue-receive (e page)
  (let ((trb (ring-push (ecm-in-ring e) page 4096 (logior (ash 1 10) (ash 1 5) (ash 1 2)))))
    (setf (gethash trb (ecm-pending e)) page)))

(defun start-ecm (c slot ring speed input config)
  (multiple-value-bind (comm mac-index data data-alt endpoints) (ecm-layout config)
    (let ((in (find-if (lambda (ep) (logtest (first ep) #x80)) endpoints))
          (out (find-if-not (lambda (ep) (logtest (first ep) #x80)) endpoints)))
      (unless (and comm data in out) (error "usb ethernet: no bulk data interface"))
      (let ((e (make-instance 'apple-usb-cdc-ecm :name "USB Ethernet" :controller c :slot slot)))
        (setf (ecm-in-dci e) (1+ (* 2 (logand (first in) #x0f)))
              (ecm-out-dci e) (* 2 (logand (first out) #x0f))
              (ecm-in-ring e) (new-ring)
              (ecm-out-ring e) (new-ring)
              (ecm-mps e) (second out)
              (ecm-send-pages e) (coerce (loop repeat +ecm-send-pages+ collect (vm-page-grab)) 'vector))
        (control c slot ring 0 9 (aref config 5) 0 0)
        (zero-page input)
        (ml-phys-write-32 (+ input 4) (logior 1 (ash 1 (ecm-in-dci e)) (ash 1 (ecm-out-dci e))))
        (ml-phys-write-32 (context c input 1) (logior (ash speed 20) (ash (max (ecm-in-dci e) (ecm-out-dci e)) 27)))
        (loop for (ep dci type ring) in (list (list in (ecm-in-dci e) 6 (ecm-in-ring e))
                                               (list out (ecm-out-dci e) 2 (ecm-out-ring e)))
              for at = (context c input (1+ dci))
              do (ml-phys-write-32 (+ at 4) (logior (ash 3 1) (ash type 3) (ash (third ep) 8) (ash (second ep) 16)))
                 (ml-phys-write-64 (+ at 8) (logior (ring-page ring) 1))
                 (ml-phys-write-32 (+ at 16) 1024))
        (command c 12 :parameter input :slot slot)
        (control c slot ring #x01 #x0b data-alt data 0)
        (ignore-errors (control c slot ring #x21 #x43 #x0e comm 0))
        (setf (network-mac e) (ecm-mac c slot ring mac-index))
        (sb-thread:with-recursive-lock ((xhci-lock c))
          (setf (gethash (list slot (ecm-in-dci e)) (xhci-endpoints c))
                (lambda (trb code residual)
                  (let ((page (gethash trb (ecm-pending e))))
                    (when page
                      (remhash trb (ecm-pending e))
                      (incf (getf (ecm-counts e) :received))
                      (incf (getf (getf (ecm-counts e) :receive-codes) code 0))
                      (let ((n (- 4096 residual)))
                        (when (and (member code '(1 13)) (plusp n))
                          (let ((frame (make-array n :element-type '(unsigned-byte 8))))
                            (copy-from-phys page frame 0 n)
                            (push frame (ecm-frames e)))))
                      (ecm-queue-receive e page)
                      (ring-doorbell c slot (ecm-in-dci e)))))
                (gethash (list slot (ecm-out-dci e)) (xhci-endpoints c))
                (lambda (trb code residual)
                  (declare (ignore trb residual))
                  (incf (getf (ecm-counts e) :sent))
                  (incf (getf (getf (ecm-counts e) :send-codes) code 0))
                  (setf (ecm-in-flight e) (max 0 (1- (ecm-in-flight e))))))
          (loop repeat +ecm-receive-pages+ do (ecm-queue-receive e (vm-page-grab)))
          (ring-doorbell c slot (ecm-in-dci e)))
        (attach e c)
        (publish-ethernet e "USB Ethernet" nil)
        (register-service e)
        e))))

(defmethod network-receive ((e apple-usb-cdc-ecm))
  (let ((c (ecm-controller e)))
    (process-events c)
    (sb-thread:with-recursive-lock ((xhci-lock c))
      (nreverse (shiftf (ecm-frames e) nil)))))

(defmethod network-send ((e apple-usb-cdc-ecm) frame)
  (let ((c (ecm-controller e))
        (n (max 60 (length frame))))
    (loop repeat 1000
          while (>= (ecm-in-flight e) (1- +ecm-send-pages+))
          do (process-events c) (sleep 0.0005))
    (sb-thread:with-recursive-lock ((xhci-lock c))
      (let ((page (aref (ecm-send-pages e) (ecm-send-next e)))
            (zlp (zerop (mod n (ecm-mps e)))))
        (setf (ecm-send-next e) (mod (1+ (ecm-send-next e)) +ecm-send-pages+))
        (copy-to-phys frame 0 page (length frame))
        (loop for at from (length frame) below n do (ml-phys-write-8 (+ page at) 0))
        (ring-push (ecm-out-ring e) page n (logior (ash 1 10) (if zlp 0 (ash 1 5))))
        (when zlp (ring-push (ecm-out-ring e) 0 0 (logior (ash 1 10) (ash 1 5))))
        (incf (ecm-in-flight e))
        (ring-doorbell c (ecm-slot e) (ecm-out-dci e))))
    n))

(defmethod interrupt-vector ((e apple-usb-cdc-ecm)) nil)

(defun endpoint-state (c slot dci)
  (let ((output (ml-phys-read-64 (+ (xhci-dcbaa c) (* 8 slot)))))
    (nth (ldb (byte 3 0) (ml-phys-read-32 (context c output dci))) '(:disabled :running :halted :stopped :error))))

(defun ecm-status ()
  (let ((e (first (find-entries 'apple-usb-cdc-ecm))))
    (if (null e)
        (list :usb-ethernet nil :controllers (length (find-entries 'io-xhci-controller)))
        (let ((c (ecm-controller e)))
          (process-events c)
          (append (list :mac (format nil "~{~2,'0x~^:~}" (coerce (network-mac e) 'list))
                        :speed (ldb (byte 4 20) (ml-phys-read-32 (ml-phys-read-64 (+ (xhci-dcbaa c) (* 8 (ecm-slot e))))))
                        :in (endpoint-state c (ecm-slot e) (ecm-in-dci e))
                        :out (endpoint-state c (ecm-slot e) (ecm-out-dci e))
                        :waiting (ecm-in-flight e)
                        :posted (hash-table-count (ecm-pending e)))
                  (ecm-counts e))))))
