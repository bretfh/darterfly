(in-package #:finch/iokit)

(define-io-class io-platform-expert-device "IOPlatformExpertDevice" (io-service))
(define-io-class io-acpi-platform-device "IOACPIPlatformDevice" (io-service))
(define-io-class io-pci-bridge "IOPCIBridge" (io-service)
  ((ecam :initarg :ecam :reader bridge-ecam)
   (bus-maps :initform (make-hash-table) :reader bus-maps)))
(define-io-class apple-acpi-pci "AppleACPIPCI" (io-pci-bridge))

(define-io-class io-pci-device "IOPCIDevice" (io-service)
  ((bridge :initarg :bridge :reader device-bridge)
   (bus :initarg :bus :reader pci-bus)
   (device :initarg :device :reader pci-device)
   (function :initarg :function :reader pci-function)))

(defstruct (io-memory-map (:conc-name map-)) virtual-address physical-address length)

(defun bus-base (bridge bus)
  (or (gethash bus (bus-maps bridge))
      (setf (gethash bus (bus-maps bridge)) (ml-io-map (+ (bridge-ecam bridge) (ash bus 20)) (ash 1 20)))))

(defun config-address (bridge bus device function offset)
  (+ (bus-base bridge bus) (ash device 15) (ash function 12) offset))

(defun %config-read (bridge bus device function offset width)
  (let ((sap (io-sap (config-address bridge bus device function offset))))
    (ecase width (8 (sb-sys:sap-ref-8 sap 0)) (16 (sb-sys:sap-ref-16 sap 0)) (32 (sb-sys:sap-ref-32 sap 0)))))

(defun %config-write (bridge bus device function offset width value)
  (let ((sap (io-sap (config-address bridge bus device function offset))))
    (ecase width
      (8 (setf (sb-sys:sap-ref-8 sap 0) value))
      (16 (setf (sb-sys:sap-ref-16 sap 0) value))
      (32 (setf (sb-sys:sap-ref-32 sap 0) value)))))

(macrolet ((define-config (read write width)
             `(progn
                (defun ,read (device offset)
                  (%config-read (device-bridge device) (pci-bus device) (pci-device device) (pci-function device) offset ,width))
                (defun ,write (device offset value)
                  (%config-write (device-bridge device) (pci-bus device) (pci-device device) (pci-function device) offset ,width value)))))
  (define-config config-read-8 config-write-8 8)
  (define-config config-read-16 config-write-16 16)
  (define-config config-read-32 config-write-32 32))

(defun find-pci-capability (device id &optional after)
  (when (logtest (config-read-16 device 6) #x10)
    (loop for offset = (if after (config-read-8 device (1+ after)) (config-read-8 device #x34))
            then (config-read-8 device (1+ offset))
          until (zerop offset)
          when (= (config-read-8 device offset) id) return offset)))

(defun set-memory-enable (device enable)
  (let ((command (config-read-16 device 4)))
    (config-write-16 device 4 (if enable (logior command 2) (logandc2 command 2)))))

(defun set-bus-master-enable (device enable)
  (let ((command (config-read-16 device 4)))
    (config-write-16 device 4 (if enable (logior command 4) (logandc2 command 4)))))

(defun bar-register (index) (+ #x10 (* 4 index)))

(defun bar-64-p (device index)
  (let ((low (config-read-32 device (bar-register index))))
    (and (not (logtest low 1)) (= (ldb (byte 2 1) low) 2))))

(defun bar-address (device index)
  (let ((low (config-read-32 device (bar-register index))))
    (cond ((logtest low 1) nil)
          ((bar-64-p device index)
           (logior (logandc2 low #xf) (ash (config-read-32 device (bar-register (1+ index))) 32)))
          (t (logandc2 low #xf)))))

(defun bar-length (device index)
  (let* ((register (bar-register index))
         (wide (bar-64-p device index))
         (low (config-read-32 device register))
         (high (and wide (config-read-32 device (+ register 4))))
         (command (config-read-16 device 4)))
    (config-write-16 device 4 (logandc2 command 3))
    (config-write-32 device register #xffffffff)
    (when wide (config-write-32 device (+ register 4) #xffffffff))
    (let* ((mask-low (logandc2 (config-read-32 device register) #xf))
           (mask (if wide (logior mask-low (ash (config-read-32 device (+ register 4)) 32)) (logior mask-low (ash #xffffffff 32)))))
      (config-write-32 device register low)
      (when wide (config-write-32 device (+ register 4) high))
      (config-write-16 device 4 command)
      (if (zerop mask-low) 0 (1+ (logand (lognot mask) #xffffffffffffffff))))))

(defun map-device-memory-with-index (device index)
  (let ((address (bar-address device index))
        (length (bar-length device index)))
    (when (and address (plusp length))
      (make-io-memory-map :virtual-address (ml-io-map address length) :physical-address address :length length))))

(defun le-data (value) (coerce (loop for i below 4 collect (ldb (byte 8 (* 8 i)) value)) '(vector (unsigned-byte 8))))

(defun hex (n) (string-downcase (format nil "~x" n)))

(defun describe-pci-device (d)
  (let ((vendor (config-read-16 d 0)) (id (config-read-16 d 2))
        (class (ash (config-read-32 d 8) -8))
        (sub-vendor (config-read-16 d #x2c)) (sub-id (config-read-16 d #x2e)))
    (setf (entry-name d) (format nil "pci~a,~a" (hex vendor) (hex id))
          (entry-location d) (if (zerop (pci-function d)) (format nil "~X" (pci-device d)) (format nil "~X,~X" (pci-device d) (pci-function d))))
    (set-property d "vendor-id" (le-data vendor))
    (set-property d "device-id" (le-data id))
    (set-property d "class-code" (le-data class))
    (set-property d "revision-id" (le-data (ldb (byte 8 0) (config-read-32 d 8))))
    (set-property d "subsystem-vendor-id" (le-data sub-vendor))
    (set-property d "subsystem-id" (le-data sub-id))
    (set-property d "name" (entry-name d))
    (set-property d "compatible" (list (format nil "pci~a,~a" (hex sub-vendor) (hex sub-id)) (entry-name d)
                                       (format nil "pciclass,~6,'0x" class)))
    (set-property d "pcidebug" (format nil "~d:~d:~d" (pci-bus d) (pci-device d) (pci-function d)))
    (unless (= (ldb (byte 7 0) (config-read-8 d #xe)) 1)
      (let ((memory nil) (i 0))
        (loop while (< i 6)
              do (let ((address (bar-address d i)))
                   (when address
                     (let ((length (bar-length d i)))
                       (when (plusp length) (push (personality "address" address "length" length) memory))))
                   (incf i (if (and address (bar-64-p d i)) 2 1))))
        (set-property d "IODeviceMemory" (nreverse memory))))
    d))

(defun pci-primary-id (d) (logior (ash (config-read-16 d 2) 16) (config-read-16 d 0)))

(defun parse-match (spec)
  (loop for word in (uiop:split-string spec :separator " ")
        for amp = (position #\& word)
        unless (string= word "")
          collect (cons (parse-integer word :start 2 :end amp :radix 16)
                        (if amp (parse-integer word :start (+ amp 3) :radix 16) #xffffffff))))

(defun id-matches-p (spec id)
  (some (lambda (m) (= (logand id (cdr m)) (logand (car m) (cdr m)))) (parse-match spec)))

(defmethod match-property-table ((d io-pci-device) table)
  (let ((primary (gethash "IOPCIPrimaryMatch" table))
        (any (gethash "IOPCIMatch" table)))
    (and (or (null primary) (id-matches-p primary (pci-primary-id d)))
         (or (null any) (id-matches-p any (pci-primary-id d))))))

(defun probe-bus (bridge bus parent)
  (dotimes (device 32)
    (let ((functions (if (logtest (%config-read bridge bus device 0 #xe 8) #x80) 8 1)))
      (unless (= (%config-read bridge bus device 0 0 16) #xffff)
        (dotimes (fn functions)
          (unless (= (%config-read bridge bus device fn 0 16) #xffff)
            (let ((d (make-instance 'io-pci-device :bridge bridge :bus bus :device device :function fn)))
              (describe-pci-device d)
              (attach d parent)
              (when (= (ldb (byte 7 0) (config-read-8 d #xe)) 1)
                (probe-bus bridge (config-read-8 d #x19) d)))))))))

(defun start-iokit ()
  (let* ((root (make-instance 'io-registry-entry :name "Root"))
         (expert (attach (make-instance 'io-platform-expert-device :name "finch") root))
         (mcfg (acpi-table "MCFG"))
         (pci0 (attach (make-instance 'io-acpi-platform-device :name "PCI0") expert))
         (bridge (attach (make-instance 'apple-acpi-pci :ecam (ml-phys-read-64 (+ mcfg 44))) pci0)))
    (setf *registry-root* root *bsd-units* 0)
    (probe-bus bridge (ml-phys-read-8 (+ mcfg 54)) bridge)
    (dolist (d (find-entries 'io-pci-device root))
      (register-service d))
    root))
