(in-package #:darterfly/kern)

(defconstant +eperm+ 1)
(defconstant +efault+ 14)
(defconstant +ebadf+ 9)
(defconstant +enomem+ 12)
(defconstant +ebusy+ 16)
(defconstant +einval+ 22)
(defconstant +enosys+ 38)
(defconstant +eagain+ 11)
(defconstant +map-fixed+ #x10)
(defconstant +map-anon+ #x1000)
(defconstant +r-r10+ (+ +r-r8+ 16))
(defconstant +kernel-file-start+ 1328)
(defconstant +kernel-file-size+ 1336)
(defconstant +video+ 1192)
(defconstant +ramdisk-start+ 1544)
(defconstant +ramdisk-size+ 1552)
(defconstant +core-start+ 1560)
(defconstant +core-size+ 1568)
(defconstant +keep-start+ 1592)
(defconstant +keep-size+ 1600)

(define-global serial-event :u64)
(define-global restart-core :u64 :extern t)
(define-global restart-core-size :u64 :extern t)
(define-global user-file :u64 :extern t)
(define-global user-file-size :u64 :extern t)

(define-low ok (regs value)
  (setf (mem :u64 (+ regs +r-rax+)) value)
  (setf (mem :u64 (+ regs +r-rflags+)) (logand (mem :u64 (+ regs +r-rflags+)) (lognot 1))))

(define-low error (regs code)
  (setf (mem :u64 (+ regs +r-rax+)) code)
  (setf (mem :u64 (+ regs +r-rflags+)) (logior (mem :u64 (+ regs +r-rflags+)) 1)))

(define-low bsd-serial-wakeup ()
  (thread-wakeup (address serial-event) 1))

(define-low thread-by-id (id)
  (let ((th all-threads))
    (while th
      (when (and (= (mem :u64 (+ th +t-thread-id+)) id) (/= (mem :u32 (+ th +t-state+)) +th-terminate+)
                 (= (world-of th) (current-world)))
        (result th))
      (setf th (mem :u64 (+ th +t-all-next+))))
    0))

(define-low arguments-ok (n a b c d)
  (cond ((privileged) 1)
        ((= n 4) (user-ok b c 0))
        ((= n 361) (or (not d) (user-ok d 4 1)))
        ((= n 515) (user-ok b 4 0))
        ((= n 46) (and (or (not b) (user-ok b 32 0)) (or (not c) (user-ok c 24 1))))
        ((or (= n 48) (= n 329)) (and (or (not b) (user-ok b 8 0)) (or (not c) (user-ok c 8 1))))
        ((= n 111) (user-ok a 8 0))
        ((= n 83) (and (user-ok b 32 0) (or (not c) (user-ok c 32 1))))
        ((= n 86) (user-ok b 32 1))
        ((= n 230) (user-ok a (* b 8) 1))
        ((or (= n 73) (= n 74) (= n 75)) (user-range a b))
        ((= n 197) (or (not a) (user-range a b)))
        ((= n 184) (user-ok a +ucontext-size+ 0))
        (t 1)))

(define-low unix-syscall (regs)
  (let ((n (reg regs +r-rax+))
        (a (reg regs +r-rdi+))
        (b (reg regs +r-rsi+))
        (c (reg regs +r-rdx+))
        (d (reg regs +r-r10+)))
    (unless (the :u32 (arguments-ok n a b c d)) (result (error regs +efault+)))
    (when (and (not (privileged)) (= n 1))
      (native-exit (current-world) (ash (logand a 255) 8)))
    (when (and (not (privileged)) (= n 3)) (result (error regs +eperm+)))
    (when (and sigtrace (/= n 3) (/= n 4) (/= n 230))
      (kprintf "[syscall %lu thread 0x%lx (0x%lx, 0x%lx, 0x%lx) mask 0x%lx pending 0x%lx]
" n (mem :u64 (+ (current-thread) +t-thread-id+)) a
               (if (and b (or (= n 48) (= n 329))) (mem :u64 b) b) c
               (mem :u64 (+ (current-thread) +t-sigmask+))
               (logior (mem :u64 (siglist-of (current-world))) (mem :u64 (+ (current-thread) +t-siglist+)))))
    (cond
      ((= n 1)
       (kprintf "exit(%d)
" (logand a #xFFFFFFFF))
       (|platform_halt|))
      ((= n 3)
       (unless (= a 0) (result (error regs +ebadf+)))
       (when (= c 0) (result (ok regs 0)))
       (let ((r (the :u32 (tsleep (code-address serial-ready) (address serial-event) 0)))
             (i 0))
         (when r (result (error regs r)))
         (while (and (< i c) (the :u32 (serial-ready)))
           (setf (mem :u8 (+ b i)) (serial-getc))
           (incf i))
         (ok regs i)))
      ((= n 4)
       (unless (or (= a 1) (= a 2)) (result (error regs +ebadf+)))
       (let ((i 0))
         (while (< i c)
           (unless (the :u32 (serial-tx-room))
             (serial-tx-kick)
             (let ((r (the :u32 (tsleep (code-address serial-tx-room) (address serial-event) 0))))
               (when r
                 (result (if i (ok regs i) (error regs r))))))
           (serial-write (mem :u8 (+ b i)))
           (incf i))
         (serial-tx-kick)
         (ok regs c)))
      ((= n 20) (ok regs 1))
      ((= n 37) (psignal (current-world) b) (ok regs 0))
      ((= n 328)
       (let ((th (thread-by-id a)))
         (unless th (result (error regs 3)))
         (psignal-thread th b)
         (ok regs 0)))
      ((= n 360) (ok regs (mem :u64 (+ (thread-create-user a c b d) +t-thread-id+))))
      ((= n 361)
       (when d
         (setf (mem :u32 d) 1)
         (thread-wakeup-in d 1 (current-world)))
       (thread-terminate-self))
      ((= n 372) (ok regs (mem :u64 (+ (current-thread) +t-thread-id+))))
      ((= n 515)
       (unless (= (mem :u32 b) (logand c #xFFFFFFFF)) (result (error regs +eagain+)))
       (let* ((deadline (if d (deadline-after (truncate d 1000000) (* (rem d 1000000) 1000)) 0))
              (r (the :u32 (thread-wait b deadline))))
         (cond ((= r +thread-timed-out+) (error regs +etimedout+))
               ((= r +thread-interrupted+) (error regs +eintr+))
               (t (ok regs 0)))))
      ((= n 516) (ok regs (thread-wakeup-in b (if (logand a #x100) 1 0) (current-world))))
      ((= n 46)
       (when (or (= a 0) (>= a +nsig+)) (result (error regs +einval+)))
       (let ((act (sigact (current-world) a)))
         (when c (rep-movsb c act +sigact-size+))
         (when b
           (setf (mem :u64 (+ (current-world) +w-sigtramp+)) (mem :u64 (+ b 8)))
           (setf (mem :u64 act) (mem :u64 b))
           (setf (mem :u64 (+ act 8)) (mem :u64 (+ b 16)))
           (setf (mem :u32 (+ act 16)) (mem :u32 (+ b 24))))
         (ok regs 0)))
      ((or (= n 48) (= n 329))
       (let* ((self (current-thread))
              (old (mem :u64 (+ self +t-sigmask+))))
         (when b
           (let ((set (mem :u64 b)))
             (cond ((= a 0) (setf (mem :u64 (+ self +t-sigmask+)) (logior old set)))
                   ((= a 1) (setf (mem :u64 (+ self +t-sigmask+)) (logand old (lognot set))))
                   (t (setf (mem :u64 (+ self +t-sigmask+)) set)))
             (setf (mem :u64 (+ self +t-sigmask+)) (logand (mem :u64 (+ self +t-sigmask+)) (lognot +unblockable+)))))
         (when c (setf (mem :u64 c) old))
         (ok regs 0)))
      ((= n 111)
       ;; The syscall path holds the kernel lock through mask installation
       ;; and thread-wait. Save the original mask in the signal frame so
       ;; sigreturn restores it, including when this is a nested handler.
       (let* ((self (current-thread))
              (old (mem :u64 (+ self +t-sigmask+))))
         (setf (mem :u64 (+ self +t-sigmask+))
               (logand (mem :u64 a) (lognot +unblockable+)))
         (error regs +eintr+)
         (while 1
           (when (the :u32 (bsd-ast regs))
             (setf (mem :u64 (+ (mem :u64 (+ regs +r-rdx+)) +uc-sigmask+)) old)
             (result 0))
           (when (terminating)
             (setf (mem :u64 (+ self +t-sigmask+)) old)
             (result 0))
           (tsleep 0 0 0))))
      ((= n 83)
       (cond ((= a 0) (setitimer-real b c))
             ((= a 2) (setitimer-prof b c))
             (t (result (error regs +einval+))))
       (ok regs 0))
      ((= n 86)
       (cond ((= a 0) (getitimer-real b))
             ((= a 2) (getitimer-prof b))
             (t (result (error regs +einval+))))
       (ok regs 0))
      ((= n 230)
       (let ((negative (logand c #x80000000))
             (timeout (logand c #xFFFFFFFF))
             (deadline 0))
         (unless negative
           (setf deadline (deadline-after (truncate timeout 1000) (* (rem timeout 1000) 1000000))))
         (while 1
           (let ((ready 0) (i 0))
             (while (< i b)
               (let* ((fd (+ a (* i 8)))
                      (number (mem :u32 fd))
                      (events (mem :u16 (+ fd 4)))
                      (revents 0))
                 (when (or (= number 1) (= number 2)) (setf revents (logand events 4)))
                 (when (and (= number 0) (logand events 1) (the :u32 (serial-ready)))
                   (setf revents (logior revents 1)))
                 (setf (mem :u16 (+ fd 6)) revents)
                 (when revents (incf ready)))
               (incf i))
             (when (or ready (= timeout 0)) (result (ok regs ready)))
             (let ((r (the :u32 (tsleep (code-address serial-ready) (address serial-event) deadline))))
               (when (= r +eintr+) (result (error regs +eintr+)))
               (when (= r +etimedout+) (result (ok regs 0))))))))
      ((= n 334)
       (if (= (the :u32 (tsleep 0 0 (deadline-after a b))) +eintr+)
           (error regs +eintr+)
           (ok regs 0)))
      ((= n 73) (if (vm-map-remove a b) (ok regs 0) (error regs +enomem+)))
      ((= n 74)
       (if (vm-map-protection-allowed a b c)
           (if (vm-map-protect a b c) (ok regs 0) (error regs +enomem+))
           (error regs 13)))
      ((= n 75)
       (when (= c 4)
         (pmap-remove (logand a (lognot 4095))
                      (- (logand (+ a b 4095) (lognot 4095)) (logand a (lognot 4095)))))
       (ok regs 0))
      ((= n 184) (sigreturn regs a))
      ((= n 197)
       (unless (logand d +map-anon+) (result (error regs +enosys+)))
       (let ((at (if (or (logand d +map-fixed+) a) a (vm-map-find-space b))))
         (unless (vm-map-enter at b c) (result (error regs +enomem+)))
         (when (the :u32 (|platform_parse_boot_arg| "faulttrace"))
           (kprintf "[mmap 0x%lx len 0x%lx prot %lu -> 0x%lx]
" a b c at))
         (ok regs at)))
      (t
       (kprintf "unix_syscall: %lu not implemented
" n)
       (error regs +enosys+)))))

(define-low pair-out (out first second)
  (setf (mem :u64 out) first)
  (setf (mem :u64 (+ out 8)) second))

(define-low machdep-right (n)
  (cond ((or (= n 3) (= n 4) (= n 6) (= n 9) (= n 10) (= n 12) (= n 13) (= n 14) (= n 16) (= n 17)
             (= n 30) (= n 40) (= n 41) (= n 42) (= n 43) (= n 49) (= n 50) (= n 51) (= n 52) (= n 61)
             (= n 76) (= n 77) (= n 78))
         0)
        ((or (= n 5) (= n 11) (= n 21))
         +right-console+)
        ((or (= n 22) (= n 23) (= n 24) (= n 65) (= n 67) (= n 68))
         +right-hardware+)
        ((or (= n 26) (= n 27) (= n 66) (= n 73))
         +right-power+)
        ((or (= n 44) (= n 45) (= n 46) (= n 48) (= n 53) (= n 54) (= n 55) (= n 56) (= n 57)
             (= n 58) (= n 59) (= n 60) (= n 62) (= n 63) (= n 64) (= n 74) (= n 79) (= n 84))
         +right-worlds+)
        ((or (= n 25) (= n 28) (= n 29) (= n 47) (= n 75))
         +right-stats+)
        ((or (= n 7) (= n 8) (= n 19))
         +right-boot+)
        ((or (= n 69) (= n 70) (= n 71) (= n 72))
         +right-log+)
        (t
         +right-physmap+)))

(define-low machdep-arguments-ok (n a b)
  (cond ((privileged) 1)
        ((= n 16) (user-ok a b 1))
        ((or (= n 6) (= n 17)) (user-ok a 16 1))
        (t 1)))

(define-low machdep-syscall (regs)
  (let ((n (reg regs +r-rax+))
        (a (reg regs +r-rdi+))
        (b (reg regs +r-rsi+))
        (args |platform_boot_args|))
    (unless (the :u32 (has-rights (machdep-right n)))
      (result (error regs +eperm+)))
    (unless (the :u32 (machdep-arguments-ok n a b))
      (result (error regs +eperm+)))
    (cond
      ((= n 61) (ok regs (if (privileged) +physmap-base+ +phys-window+)))
      ((and (not (privileged)) (= n 9)) (ok regs (window-pages 1)))
      ((and (not (privileged)) (= n 30)) (ok regs (window-pages a)))
      ((and (not (privileged)) (or (= n 10) (= n 14))) (ok regs (window-io a)))
      ((and (not (privileged)) (= n 12))
       (ok regs (|platform_interrupt_wait| (logand a (mem :u64 (+ (current-world) +w-vectors+)))
                                           (if b (deadline-after (truncate b 1000000) (* (rem b 1000000) 1000)) 0))))
      ((= n 62) (ok regs (grant-memory a b (reg regs +r-rdx+) (reg regs +r-r10+))))
      ((= n 63) (ok regs (grant-vectors a b)))
      ((= n 64) (ok regs (port-into a b)))
      ((= n 84) (ok regs (port-give a b)))
      ((= n 65) (ok regs (if (< a |real_ncpus|) (read-cpu-msr a b) #xFFFFFFFFFFFFFFFF)))
      ((= n 66) (ok regs (request-sleep (logand a #xFFFF) (logand (shr a 16) #xFFFF) (logand (shr a 32) 7) b (logand (shr a 35) 1))))
      ((= n 68) (ok regs (changed-memory a b)))
      ((= n 69) (ok regs (log-read a b (if b (reg regs +r-rdx+) 0))))
      ((= n 70) (ok regs (log-started)))
      ((= n 74) (ok regs (grant-rights a b)))
      ((= n 79) (ok regs (set-when-silent a b)))
      ((= n 75) (ok regs (list-worlds a b)))
      ((= n 71) (ok regs (log-drained a)))
      ((= n 72) (ok regs (log-previous-read a b)))
      ((= n 73) (panic "requested by world 0
"))
      ((= n 67) (ok regs (if (logand b #x200)
                             (if (logand b #x100) (progn (outw a (logand (shr b 16) #xFFFF)) 0) (inw a))
                             (if (logand b #x100) (progn (outb a (logand b #xFF)) 0) (inb a)))))
      ((= n 80) (ok regs (native-spawn a b (reg regs +r-rdx+)
                                     (reg regs +r-r10+) (reg regs +r-r8+))))
      ((= n 81) (ok regs (native-wait a)))
      ((= n 82) (ok regs (native-validate a b)))
      ;; 80-83 retain master's native ABI; 85 extends it with signal delivery.
      ;; Like native launch/wait/map, this is a supervisor service, not a
      ;; direct escape from an unprivileged world into another world.
      ((= n 85)
       (let ((w (world-by-id a)))
         (unless w (result (ok regs (- 0 3))))
         (when (or (= b 0) (>= b +nsig+))
           (result (ok regs (- 0 +einval+))))
         (psignal w b)
         (ok regs 0)))
      ((= n 83) (ok regs (map-file-pages a b (reg regs +r-rdx+)
                                       (reg regs +r-r10+) (reg regs +r-r8+))))
      ((and (not (privileged)) (= n 6))
       (pair-out a (mem :u64 (+ (current-world) +w-image+)) (mem :u64 (+ (current-world) +w-image-size+)))
       (ok regs 0))
      ((and (not (privileged)) (= n 17))
       (pair-out a (mem :u64 (+ (current-world) +w-core+)) (mem :u64 (+ (current-world) +w-core-size+)))
       (ok regs 0))
      ((= n 48) (ok regs (world-run a b (reg regs +r-rdx+) (reg regs +r-r10+))))
      ((= n 40) (ok regs (port-create)))
      ((= n 41) (ok regs (port-call a b (reg regs +r-rdx+) (reg regs +r-r10+) (reg regs +r-r8+))))
      ((= n 42) (ok regs (port-receive a b (reg regs +r-rdx+) (reg regs +r-r10+)
                                       (if (reg regs +r-r8+) (deadline-after (truncate (reg regs +r-r8+) 1000000) (* (rem (reg regs +r-r8+) 1000000) 1000)) 0))))
      ((= n 43) (ok regs (port-reply a b (reg regs +r-rdx+))))
      ((= n 76) (ok regs (port-call-start a b (reg regs +r-rdx+))))
      ((= n 77) (ok regs (port-call-wait a b (reg regs +r-rdx+)
                                         (if (reg regs +r-r10+) (deadline-after (truncate (reg regs +r-r10+) 1000000) (* (rem (reg regs +r-r10+) 1000000) 1000)) 0))))
      ((= n 78) (ok regs (port-call-abandon a)))
      ((= n 44) (ok regs (world-spawn a b (reg regs +r-rdx+) (reg regs +r-r10+))))
      ((= n 45) (ok regs (world-stop-id a)))
      ((= n 46) (ok regs (world-state a)))
      ((= n 47) (ok regs (vm-page-free-count)))
      ((= n 51) (ok regs (map-shared a b (reg regs +r-rdx+))))
      ((= n 49) (ok regs (port-copy a b (reg regs +r-r10+) (reg regs +r-rdx+) 0)))
      ((= n 50) (ok regs (port-copy a b (reg regs +r-r10+) (reg regs +r-rdx+) 1)))
      ((= n 4) (ok regs (if (privileged) (address commpage) +commpage-va+)))
      ((= n 5) (ok regs (the :u32 (serial-ready))))
      ((= n 6)
       (pair-out a user-file user-file-size)
       (ok regs 0))
      ((= n 7)
       (pair-out a (if (mem :u64 (+ args +ramdisk-start+)) (+ (mem :u64 (+ args +ramdisk-start+)) +physmap-base+) 0)
                 (mem :u64 (+ args +ramdisk-size+)))
       (ok regs 0))
      ((= n 8) (ok regs args))
      ((= n 17)
       (if restart-core
           (pair-out a restart-core restart-core-size)
           (pair-out a (if (mem :u64 (+ args +core-start+)) (+ (mem :u64 (+ args +core-start+)) +physmap-base+) 0)
                     (mem :u64 (+ args +core-size+))))
       (ok regs 0))
      ((= n 19)
       (if (the :u32 (restart-user a b (reg regs +r-rdx+) (reg regs +r-r10+) (reg regs +r-r8+))) (ok regs 0) (error regs +ebusy+)))
      ((= n 9)
       (let ((pa (vm-page-grab)))
         (unless pa (result (error regs +enomem+)))
         (rep-stosb (+ pa +physmap-base+) 0 +page-size+)
         (ok regs pa)))
      ((= n 30)
       (let ((pa (vm-pages-grab-contiguous a)))
         (unless pa (result (error regs +enomem+)))
         (rep-stosb (+ pa +physmap-base+) 0 (* a +page-size+))
         (ok regs pa)))
      ((= n 10) (ok regs (ml-io-map a b)))
      ((= n 11) (console-off) (ok regs (+ args +video+)))
      ((= n 21) (ok regs (the :u32 (keyboard-raw a b))))
      ((= n 22) (route-interrupt a b) (ok regs 0))
      ((= n 23) (ok regs (the :u32 (ec-read a))))
      ((= n 24) (ok regs (rdmsr a)))
      ((= n 25) (ok regs (mem :u32 (+ (cpu-data) +cpu-phys-number+))))
      ((= n 26) (machine-reset))
      ((= n 52) (ok regs (heartbeat a)))
      ((= n 53) (ok regs (world-pause a)))
      ((= n 54) (ok regs (world-resume a)))
      ((= n 55) (ok regs (world-describe a b (reg regs +r-rdx+))))
      ((= n 56) (ok regs (world-pages a b (reg regs +r-rdx+) (reg regs +r-r10+))))
      ((= n 57) (ok regs (world-read a b (reg regs +r-rdx+) (reg regs +r-r10+))))
      ((= n 58) (ok regs (restore-begin a)))
      ((= n 59) (ok regs (restore-page a b (reg regs +r-rdx+))))
      ((= n 60) (ok regs (restore-threads a b (reg regs +r-rdx+))))
      ((= n 27) (cli) (outw a b) (while 1 (hlt)))
      ((= n 28) (ok regs (thread-times a b)))
      ((= n 29) (ok regs (cpu-times a)))
      ((= n 12)
       (ok regs (|platform_interrupt_wait| a (if b (deadline-after (truncate b 1000000) (* (rem b 1000000) 1000)) 0))))
      ((= n 13) (ok regs (mem :u32 (+ (cpu-datap 0) +cpu-phys-number+))))
      ((= n 14) (ok regs (ml-io-map-wcomb a b)))
      ((= n 16)
       ;; The device must fail when hardware entropy is unavailable. Never
       ;; substitute a clock or the Lisp PRNG for cryptographic seeding.
       (unless (logand (the :u32 (cpuid 1 :ecx)) (shl 1 30))
         (result (ok regs 0)))
       (let ((i 0) (rdrand-value (the :u64 0)))
         (while (< i b)
           (let ((tries 0) (got 0) (k 0))
             (while (and (< tries 10) (not got))
               (setf got (rdrand (address rdrand-value)))
               (incf tries))
             (unless got (result (ok regs i)))
             (while (and (< k 8) (< (+ i k) b))
               (setf (mem :u8 (+ a i k)) (logand (shr rdrand-value (* 8 k)) #xFF))
               (incf k)))
           (incf i 8))
         (ok regs b)))
      ((= n 3)
       (setf (mem :u64 (+ (current-thread) +t-fs-base+)) a)
       (wrmsr #xC0000100 a)
       (ok regs 0))
      (t (error regs +enosys+)))))


(define-low mach-call (regs)
  (let ((n (reg regs +r-rax+)))
    (if (or (= n -60) (= n -61))
        (progn (thread-block) (ok regs 0))
        (error regs +enosys+))))
