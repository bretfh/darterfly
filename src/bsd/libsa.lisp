(in-package #:darterfly/bsd)

(defparameter +libsa-ops+
  #(nil :open :close :read :write :pread :pwrite :lseek :stat :lstat :fstat :readlink :symlink :mkdir :rmdir
    :unlink :rename :chdir :fchdir :getcwd :realpath :chmod :fchmod :chown :fchown :truncate :ftruncate :dup :dup2
    :fcntl :readdir :link :utimes :fsync :umask :pipe :spawn :waitpid
    :socket :bind :listen :accept :connect :getsockname :getpeername :shutdown :recvfrom :sendto :resolve :socketpair :poll :spawn-packed :getpid :getppid))

(defun c-string (address)
  (let* ((sap (sb-sys:int-sap address))
         (n (loop :for i :from 0 :until (zerop (sb-sys:sap-ref-8 sap i)) :finally (return i)))
         (v (make-array n :element-type '(unsigned-byte 8))))
    (sb-sys:with-pinned-objects (v) (sb-kernel:system-area-ub8-copy sap 0 (sb-sys:vector-sap v) 0 n))
    (sb-ext:octets-to-string v :external-format :utf-8)))

(defun put-octets (octets address &optional (limit (length octets)))
  (let ((n (min limit (length octets)))
        (v (coerce octets '(simple-array (unsigned-byte 8) (*)))))
    (sb-sys:with-pinned-objects (v) (sb-kernel:system-area-ub8-copy (sb-sys:vector-sap v) 0 (sb-sys:int-sap address) 0 n))
    n))

(defun get-octets (address n)
  (let ((v (make-array n :element-type '(unsigned-byte 8))))
    (sb-sys:with-pinned-objects (v) (sb-kernel:system-area-ub8-copy (sb-sys:int-sap address) 0 (sb-sys:vector-sap v) 0 n))
    v))

(defun put-string (string address size)
  (let ((octets (sb-ext:string-to-octets string :external-format :utf-8 :null-terminate t)))
    (when (> (length octets) size) (fail :erange))
    (put-octets octets address)
    (1- (length octets))))

(defun signed (n) (if (logbitp 63 n) (- n (ash 1 64)) n))

(defun from-libsa-flags (flags)
  (logior (logand flags 3)
          (if (logtest flags #o100) +o-creat+ 0) (if (logtest flags #o200) +o-excl+ 0)
          (if (logtest flags #o1000) +o-trunc+ 0) (if (logtest flags #o2000) +o-append+ 0)
          (if (logtest flags #o4000) +o-nonblock+ 0) (if (logtest flags #o200000) +o-directory+ 0)))

(defun put-stat (attr id address)
  (let ((sap (sb-sys:int-sap address))
        (mtime (vfs:vattr-mtime attr)))
    (dotimes (i 144) (setf (sb-sys:sap-ref-8 sap i) 0))
    (setf (sb-sys:sap-ref-64 sap 8) id
          (sb-sys:sap-ref-64 sap 16) (vfs:vattr-nlink attr)
          (sb-sys:sap-ref-32 sap 24) (vfs:vattr-mode attr)
          (sb-sys:sap-ref-32 sap 28) (logand (vfs:vattr-uid attr) #xffffffff)
          (sb-sys:sap-ref-32 sap 32) (logand (vfs:vattr-gid attr) #xffffffff)
          (sb-sys:sap-ref-64 sap 40) (vfs:vattr-rdev attr)
          (sb-sys:sap-ref-64 sap 48) (vfs:vattr-size attr)
          (sb-sys:sap-ref-64 sap 56) 4096
          (sb-sys:sap-ref-64 sap 64) (ceiling (vfs:vattr-size attr) 512))
    (loop :for at :in '(72 88 104)
          :do (setf (sb-sys:sap-ref-64 sap at) (floor mtime 1000000000)
                    (sb-sys:sap-ref-64 sap (+ at 8)) (mod mtime 1000000000)))
    0))

(defun put-vnode-stat (vnode address)
  (put-stat (vfs:vnop-getattr vnode) (vfs:vnode-id vnode) address))

(defun put-dirent (name vnode address)
  (let ((sap (sb-sys:int-sap address))
        (octets (sb-ext:string-to-octets name :external-format :utf-8 :null-terminate t)))
    (setf (sb-sys:sap-ref-64 sap 0) (vfs:vnode-id vnode)
          (sb-sys:sap-ref-64 sap 8) 0
          (sb-sys:sap-ref-16 sap 16) 280
          (sb-sys:sap-ref-8 sap 18) (case (vfs:vnode-type vnode) (:vdir 4) (:vreg 8) (:vlnk 10) (:vchr 2) (t 0)))
    (put-octets octets (+ address 19) 256)
    1))

(defun vnode-file (fd)
  (let ((file (fd-file fd)))
    (unless (typep file 'vnode) (fail :espipe))
    file))

(defun fd-vnode (fd) (vfs (vfs:fd-vnode (vfs-fd (vnode-file fd)))))

(defun path-vnode (address &optional (follow t))
  (vfs (vfs:namei (path (c-string address)) :follow follow)))

(defun dup-from (fd from)
  (syscall
    (let ((file (fd-file fd)))
      (incf (file-refs file))
      (fd-alloc file from))))

(defun put-fds (read write address)
  (setf (sb-sys:sap-ref-32 (sb-sys:int-sap address) 0) read
        (sb-sys:sap-ref-32 (sb-sys:int-sap address) 4) write)
  0)

(defun libsa-waitpid (pid address options)
  (multiple-value-bind (reaped status)
      (native-wait pid options)
    (when (and status (plusp reaped) (not (zerop address)))
      (setf (sb-sys:signed-sap-ref-32 (sb-sys:int-sap address) 0) status))
    reaped))

(defun get-sockaddr (address length)
  (when (zerop address) (fail :efault))
  (unless (<= 2 length) (fail :einval))
  (let* ((sap (sb-sys:int-sap address)) (family (sb-sys:sap-ref-16 sap 0)))
    (when (= family 1)
      (unless (< 2 length 111) (fail :einval))
      ;; Linux abstract addresses are not filesystem names.
      (when (zerop (sb-sys:sap-ref-8 sap 2)) (fail :eopnotsupp))
      (let* ((bytes (get-octets (+ address 2) (- length 2)))
             (end (or (position 0 bytes) (length bytes))))
        (when (> end 107) (fail :enametoolong))
        (return-from get-sockaddr
          (values (sb-ext:octets-to-string bytes :end end :external-format :utf-8)
                  :local))))
    (unless (case family (2 (>= length 16)) (10 (>= length 28))
                         (t (fail :eafnosupport)))
      (fail :einval))
    (let ((port (logior (ash (sb-sys:sap-ref-8 sap 2) 8)
                       (sb-sys:sap-ref-8 sap 3))))
      (if (= family 2)
          (values (loop :for i :from 4 :below 8
                        :for ip := (sb-sys:sap-ref-8 sap i)
                          :then (logior (ash ip 8) (sb-sys:sap-ref-8 sap i))
                        :finally (return ip)) port)
          (values (get-octets (+ address 8) 16) port)))))

(defun put-sockaddr (ip port address length-address)
  (unless (zerop address)
    (when (zerop length-address) (fail :efault))
    (let* ((local (eq port :local))
           (ip (if (and (stringp ip) (not local)) (darterfly/net:ip-address ip) ip))
           (name (when local (sb-ext:string-to-octets ip :external-format :utf-8)))
           (length (if local (+ 2 (length name) (if (plusp (length name)) 1 0))
                       (if (integerp ip) 16 28)))
           (bytes (make-array length :element-type '(unsigned-byte 8) :initial-element 0))
           (len-sap (sb-sys:int-sap length-address)))
      (setf (aref bytes 0) (if local 1 (if (integerp ip) 2 10)))
      (cond (local (replace bytes name :start1 2))
            (t (setf (aref bytes 2) (ldb (byte 8 8) port)
                     (aref bytes 3) (ldb (byte 8 0) port))
               (if (integerp ip)
                   (dotimes (i 4) (setf (aref bytes (+ 4 i)) (ldb (byte 8 (* 8 (- 3 i))) ip)))
                   (replace bytes ip :start1 8))))
      (put-octets (subseq bytes 0 (min length (sb-sys:sap-ref-32 len-sap 0))) address)
      (setf (sb-sys:sap-ref-32 len-sap 0) length)))
  0)

(defun libsa-socket (domain type protocol)
  (unless (zerop (logandc2 type (logior #xf #o4000 #o2000000))) (fail :einval))
  (syscall
    (let ((fd (socket (case domain (2 +af-inet+) (10 +af-inet6+) (t domain))
                      (logand type #xf) protocol)))
      (when (< fd 3) (let ((new (dup-from fd 3))) (close fd) (setf fd new)))
      (when (logtest type #o4000) (setf (file-flags (fd-file fd)) +o-nonblock+))
      (when (logtest type #o2000000) (setf (cdr (aref (proc-fds *proc*) fd)) t))
      fd)))

(defun libsa-address (fd address length peer)
  (syscall
    (let ((s (fd-socket fd)))
      (if (typep s 'local-socket)
          (progn
            (when (and peer (not (eq (local-state s) :connected))) (fail :enotconn))
            (put-sockaddr (if peer (local-peer-name s) (local-name s)) :local address length))
          (if peer
              (destructuring-bind (&optional ip port) (socket-addresses fd)
                (unless ip (fail :enotconn))
                (put-sockaddr ip port address length))
              (put-sockaddr 0 (or (socket-port s) 0) address length))))))

(defun libsa-address-call (fd address length connectp)
  (multiple-value-bind (ip port) (get-sockaddr address length)
    (unless (eq (eq port :local) (not (internet-socket-p (fd-socket fd))))
      (fail :eafnosupport))
    (if connectp (connect fd ip port) (bind fd ip port))))

(defun libsa-socketpair (domain type protocol address)
  (when (zerop address) (fail :efault))
  ;; Linux constants match the foreign ABI used by libsa, not BSD F_SETFL.
  (unless (zerop (logandc2 type (logior #xf #o4000 #o2000000)))
    (fail :einval))
  (syscall
    (multiple-value-bind (a b) (new-socketpair (if (= domain 10) +af-inet6+ domain) (logand type #xf) protocol)
      (let ((left (fd-alloc a 3)) (right (fd-alloc b 3)))
        (dolist (fd (list left right))
          (when (logtest type #o4000)
            (setf (file-flags (fd-file fd)) +o-nonblock+))
          (when (logtest type #o2000000)
            (setf (cdr (aref (proc-fds *proc*) fd)) t)))
        (put-fds left right address)))))

(defun socket-addresses (fd)
  (let* ((s (fd-socket fd))
         (pcb (socket-pcb s)))
    (if (typep pcb 'darterfly/net:connection)
        (multiple-value-list (darterfly/net:tcp-peer pcb))
        (socket-peer s))))

(defun libsa-resolve (name addresses families encoded)
  (let* ((max (ldb (byte 8 0) encoded))
         (family (ldb (byte 8 8) encoded))
         (ips (or (ignore-errors (list (darterfly/net:ip-address name)))
                  (append (unless (= family 10) (ignore-errors (darterfly/net:resolve-name name :type :a)))
                          (unless (= family 2) (ignore-errors (darterfly/net:resolve-name name :type :aaaa))))))
         (ips (subseq ips 0 (min max (length ips)))))
    (loop :for ip :in ips
          :for i :from 0
          :for v := (if (stringp ip) (darterfly/net:ip-address ip) ip)
          :do (let ((sap (sb-sys:int-sap (+ addresses (* 16 i)))))
                (if (integerp v)
                    (progn (dotimes (k 4) (setf (sb-sys:sap-ref-8 sap k) (ldb (byte 8 (* 8 (- 3 k))) v)))
                           (setf (sb-sys:signed-sap-ref-32 (sb-sys:int-sap families) (* 4 i)) 2))
                    (progn (dotimes (k 16) (setf (sb-sys:sap-ref-8 sap k) (aref v k)))
                           (setf (sb-sys:signed-sap-ref-32 (sb-sys:int-sap families) (* 4 i)) 10)))))
    (length ips)))

(defun libsa-recvfrom (fd address)
  (flet ((word (i) (sb-sys:sap-ref-64 (sb-sys:int-sap address) (* 8 i))))
    (let ((s (fd-socket fd)))
      (if (= (socket-type s) +sock-dgram+)
          (multiple-value-bind (data ip port) (recvfrom fd (word 1))
            (put-sockaddr ip port (word 2) (word 3))
            (put-octets data (word 0)))
          (put-octets (read fd (word 1)) (word 0))))))

(defun libsa-sendto (fd address)
  (flet ((word (i) (sb-sys:sap-ref-64 (sb-sys:int-sap address) (* 8 i))))
    (let ((s (fd-socket fd))
          (octets (get-octets (word 0) (word 1))))
      (if (and (= (socket-type s) +sock-dgram+) (not (zerop (word 2))))
          (multiple-value-bind (ip port) (get-sockaddr (word 2) (word 3)) (sendto fd octets ip port))
          (write fd octets)))))

(defun libsa-call (op a b c d)
  (ecase op
    (:open (let ((fd (open (c-string a) (from-libsa-flags b) c)))
             (when (and (< fd 3) (not (proc-native-world *proc*)))
               (setf fd (prog1 (dup-from fd 3) (close fd))))
             (when (logtest b #o2000000)
               (setf (cdr (aref (proc-fds *proc*) fd)) t))
             fd))
    (:close (close a))
    (:read (put-octets (read a c) b))
    (:write (write a (get-octets b c)))
    (:pread (put-octets (vfs (vfs:vfs-read (vfs-fd (vnode-file a)) c (signed d))) b))
    (:pwrite (vfs (vfs:vfs-write (vfs-fd (vnode-file a)) (get-octets b c) (signed d))))
    (:lseek (lseek a (signed b) (ecase c (0 :set) (1 :cur) (2 :end))))
    (:stat (put-vnode-stat (path-vnode a) b))
    (:lstat (put-vnode-stat (path-vnode a nil) b))
    (:fstat (let ((file (fd-file a)))
              (if (typep file 'vnode)
                  (put-vnode-stat (fd-vnode a) b)
                  (put-stat (vfs:make-vattr :mode (logior (if (typep file 'socket) #o140000 +s-ififo+) #o600)) 0 b))))
    (:readlink (put-octets (sb-ext:string-to-octets (vfs (vfs:vfs-readlink (path (c-string a)))) :external-format :utf-8) b c))
    (:symlink (symlink (c-string a) (c-string b)))
    (:mkdir (mkdir (c-string a) b))
    (:rmdir (rmdir (c-string a)))
    (:unlink (unlink (c-string a)))
    (:rename (rename (c-string a) (c-string b)))
    (:chdir (chdir (c-string a)))
    (:fchdir (fail :enotsup))
    (:getcwd (put-string (getcwd) a b))
    (:realpath (put-string (unroot (vfs (vfs:vfs-realpath (path (c-string a))))) b c))
    (:chmod (vfs (vfs:vnop-setattr (path-vnode a) :mode b)))
    (:fchmod (vfs (vfs:vnop-setattr (fd-vnode a) :mode b)))
    (:chown (vfs (vfs:vnop-setattr (path-vnode a) :uid (signed b) :gid (signed c))))
    (:fchown (vfs (vfs:vnop-setattr (fd-vnode a) :uid (signed b) :gid (signed c))))
    (:truncate (vfs (vfs:vnop-truncate (path-vnode a) b)) 0)
    (:ftruncate (vfs (vfs:vnop-truncate (fd-vnode a) b)) 0)
    (:dup (dup-from a (if (proc-native-world *proc*) 0 3)))
    (:dup2 (if (and (< b 3) (not (proc-native-world *proc*)))
               (fail :ebadf) (dup2 a b)))
    (:fcntl (syscall (let ((file (fd-file a)))
              (case b
                (0 (dup-from a (max (native-fd c) (if (proc-native-world *proc*) 0 3))))
                (1 (if (cdr (aref (proc-fds *proc*) a)) 1 0))
                (2 (setf (cdr (aref (proc-fds *proc*) a)) (logbitp 0 c)) 0)
                (3 (logior (file-access file) (if (nonblocking-p file) #o4000 0)))
                (4 (setf (file-flags file) (if (logtest c #o4000) +o-nonblock+ 0)) 0)
                (t 0)))))
    (:readdir (let ((entry (vfs (vfs:vfs-readdir (vfs-fd (vnode-file a)) b))))
                (if entry (put-dirent (car entry) (cdr entry) c) 0)))
    (:link (fail :enotsup))
    (:utimes (path-vnode a) 0)
    (:fsync (fd-file a) (vfs:vfs-sync))
    (:umask (prog1 vfs:*umask* (setf vfs:*umask* (logand a #o777))))
    (:pipe (multiple-value-bind (read write) (pipe)
             (put-fds read write a)))
    (:spawn (fail :enosys)) ; retired pointer-based spawn slot
    (:waitpid (libsa-waitpid (signed a) b c))
    (:socket (libsa-socket a b c))
    (:bind (libsa-address-call a b c nil))
    (:listen (listen a b))
    (:accept (when (and (plusp b) (zerop c)) (fail :efault))
             (multiple-value-bind (fd ip port) (accept a)
               (handler-case (progn (put-sockaddr ip port b c) fd)
                 (error (e) (close fd) (error e)))))
    (:connect (libsa-address-call a b c t))
    (:getsockname (libsa-address a b c nil))
    (:getpeername (libsa-address a b c t))
    (:shutdown (shutdown a b))
    (:recvfrom (libsa-recvfrom a b))
    (:sendto (libsa-sendto a b))
    (:resolve (libsa-resolve (c-string a) b c d))
    (:socketpair (libsa-socketpair a b c d))
    (:poll (libsa-poll a b c))
    (:spawn-packed (unless (<= 24 b 4096) (fail :einval))
                   (native-spawn-request (get-octets a b) c :native-only nil))
    (:getpid (getpid))
    (:getppid (getppid))))

(defmacro as-libsa ((proc) &body body)
  `(sb-sys:without-interrupts
     (handler-case (or (let ((*proc* ,proc)) ,@body) 0)
       (errno (e) (- (vfs:errno-code (errno-name e))))
       (vfs:vfs-error (e) (- (vfs:errno-code (vfs:vfs-errno e))))
       (error () (- (vfs:errno-code :eio))))))

(defun libsa-entry (op a b c d &optional (proc *proc0*))
  (as-libsa (proc)
    (with-bsd
      (when (or (proc-closing proc) (eq (proc-state proc) :zombie))
        (fail :eintr))
      (libsa-call (aref +libsa-ops+ op) a b c d))))

(defvar *libsa-entry* nil)

(defun make-world-proc (cwd)
  (with-bsd
    (let ((proc (make-instance 'proc :pid (next-pid) :parent *proc0*
                                    :task darterfly/mach:*task*)))
      (setf (proc-cwd proc) cwd (proc-comm proc) "world"
            (proc-world-owner proc) proc
            (gethash (proc-pid proc) *procs*) proc)
      (dotimes (fd 3)
        (let ((slot (and (< fd (length (proc-fds *proc0*)))
                         (aref (proc-fds *proc0*) fd))))
          (when slot (incf (file-refs (car slot))))
          (vector-push-extend (and slot (cons (car slot) (cdr slot)))
                              (proc-fds proc))))
      proc)))

(defun end-world-proc (proc)
  (with-bsd
    ;; Prevent late calls from publishing children after teardown begins.
    (setf (proc-closing proc) t (proc-state proc) :zombie)
    (changed)
    (let ((children (loop for child being the hash-values of *procs*
                          when (and (not (eq child proc))
                                    (eq (proc-world-owner child) proc))
                            collect child)))
      (dolist (child children) (post child (signo :sigkill)))
      (loop while (some (lambda (child) (not (eq (proc-state child) :zombie)))
                        children)
            do (sb-thread:condition-wait *changed* *bsd*))
      (dolist (child children)
        (when (proc-parent child)
          (setf (proc-children (proc-parent child))
                (remove child (proc-children (proc-parent child)))))
        (remhash (proc-pid child) *procs*)))
    (loop for fd below (length (proc-fds proc))
          when (aref (proc-fds proc) fd) do (release-fd proc fd))
    (remhash (proc-pid proc) *procs*)))

(defun request-u64 (v at) (loop :for i :below 8 :sum (ash (aref v (+ at i)) (* 8 i))))

(defun request-u32 (v at) (loop :for i :below 4 :sum (ash (aref v (+ at i)) (* 8 i))))

(defun serve-transfer (proc token op fd there size offset)
  (case op
    ((:write :pwrite)
     (let ((octets (make-array size :element-type '(unsigned-byte 8))))
       (sb-sys:with-pinned-objects (octets)
         (darterfly/worlds:copy-from token there (sb-sys:sap-int (sb-sys:vector-sap octets)) size))
       (as-libsa (proc)
         (if (eq op :write)
             (write fd octets)
             (vfs (vfs:vfs-write (vfs-fd (vnode-file fd)) octets (signed offset)))))))
    ((:read :pread)
     (as-libsa (proc)
       (let ((octets (coerce (if (eq op :read)
                                 (if (zerop size) (progn (fd-file fd) #()) (read fd size))
                                 (vfs (vfs:vfs-read (vfs-fd (vnode-file fd)) size (signed offset))))
                             '(simple-array (unsigned-byte 8) (*)))))
         (sb-sys:with-pinned-objects (octets)
           (darterfly/worlds:copy-into token there (sb-sys:sap-int (sb-sys:vector-sap octets)) (length octets)))
         (length octets))))
    (t (- (vfs:errno-code :enosys)))))

(defun serve-socket-transfer (proc token op fd there size request sizes)
  (let ((address (make-array 28 :element-type '(unsigned-byte 8) :initial-element 0))
        (length (make-array 4 :element-type '(unsigned-byte 8) :initial-element 0)))
    (setf (aref length 0) 28)
    (values
     (case op
       (:sendto
        (let ((octets (make-array size :element-type '(unsigned-byte 8)))
              (to (subseq request 72 (+ 72 (third sizes)))))
          (sb-sys:with-pinned-objects (octets)
            (darterfly/worlds:copy-from token there (sb-sys:sap-int (sb-sys:vector-sap octets)) size))
          (as-libsa (proc)
            (if (and (= (socket-type (fd-socket fd)) +sock-dgram+) (plusp (length to)))
                (sb-sys:with-pinned-objects (to)
                  (multiple-value-bind (ip port) (get-sockaddr (sb-sys:sap-int (sb-sys:vector-sap to)) (length to))
                    (sendto fd octets ip port)))
                (write fd octets)))))
       (:recvfrom
        (as-libsa (proc)
          (let ((octets (if (= (socket-type (fd-socket fd)) +sock-dgram+)
                            (multiple-value-bind (data ip port) (recvfrom fd size)
                              (sb-sys:with-pinned-objects (address length)
                                (put-sockaddr ip port (sb-sys:sap-int (sb-sys:vector-sap address)) (sb-sys:sap-int (sb-sys:vector-sap length))))
                              data)
                            (read fd size))))
            (setf octets (coerce octets '(simple-array (unsigned-byte 8) (*))))
            (sb-sys:with-pinned-objects (octets)
              (darterfly/worlds:copy-into token there (sb-sys:sap-int (sb-sys:vector-sap octets)) (length octets)))
            (length octets))))
       (t (- (vfs:errno-code :enosys))))
     (if (eq op :recvfrom) (list nil nil address length) (list nil nil nil nil)))))

(defun reply-octets (result lens work offsets)
  (let ((reply (make-array (+ 24 (reduce #'+ lens)) :element-type '(unsigned-byte 8) :initial-element 0)))
    (dotimes (i 8) (setf (aref reply i) (ldb (byte 8 (* 8 i)) result)))
    (loop :for len :in lens :for i :from 0
          :do (dotimes (k 4) (setf (aref reply (+ 8 (* 4 i) k)) (ldb (byte 8 (* 8 k)) len))))
    (let ((out 24))
      (loop :for len :in lens :for at :in offsets
            :when (plusp len)
              :do (replace reply work :start1 out :start2 at :end2 (+ at len))
                  (incf out len)))
    reply))

(defparameter +world-refuses+ '(:spawn))

(defun valid-world-request-p (name args sizes kinds request)
  ;; The service reconstructs local pointers only from this checked schema.
  ;; Scalar fields can never masquerade as supervisor addresses.
  (labels ((layout (wanted) (equal kinds wanted))
           (len (i maximum &optional exact)
             (let ((n (nth i sizes)))
               (and (<= n maximum) (or (null exact) (= n exact))))))
    (and (loop for kind in kinds for size in sizes
               always (and (<= 0 kind 6) (<= size (ash 1 20))
                           (or (not (zerop kind)) (zerop size))))
         (= (length request)
            (+ 72 (loop for kind in kinds for size in sizes
                         when (member kind '(1 2 6)) sum size)))
         (let ((at 72))
           (loop for kind in kinds for size in sizes always
             (prog1 (or (/= kind 1)
                        (and (<= 1 size 4096)
                             (eql (position 0 request :start at :end (+ at size))
                                  (1- (+ at size)))))
               (when (member kind '(1 2 6)) (incf at size)))))
         (case name
           ((:open :mkdir :rmdir :unlink :chdir :chmod :chown :truncate)
            (layout '(1 0 0 0)))
           ((:symlink :rename :link) (layout '(1 1 0 0)))
           ((:close :lseek :fchdir :fchmod :fchown :ftruncate :dup :dup2
             :fcntl :fsync :umask :socket :listen :shutdown :getpid :getppid)
            (and (layout '(0 0 0 0))
                 (or (not (member name '(:dup2 :fcntl)))
                     (if (eq name :dup2) (<= (second args) 4095)
                         (and (<= (second args) 4)
                              (or (/= (second args) 0) (<= (third args) 4095)))))))
           ((:read :pread) (and (layout '(0 5 0 0)) (= (second sizes) (third args))))
           ((:write :pwrite) (and (layout '(0 4 0 0)) (= (second sizes) (third args))))
           ((:stat :lstat) (and (layout '(1 3 0 0)) (len 1 144 144)))
           (:fstat (and (layout '(0 3 0 0)) (len 1 144 144)))
           ((:readlink :realpath)
            (and (layout '(1 3 0 0)) (len 1 4096) (= (second sizes) (third args))))
           (:getcwd (and (layout '(3 0 0 0)) (len 0 4096)
                         (= (first sizes) (second args))))
           (:readdir (and (layout '(0 0 3 0)) (len 2 280 280)))
           (:utimes (and (layout '(1 2 0 0)) (member (second sizes) '(0 32))))
           (:pipe (and (layout '(3 0 0 0)) (len 0 8 8)))
           (:waitpid (and (layout '(0 3 0 0)) (member (second sizes) '(0 4))))
           ((:bind :connect)
            (and (layout '(0 2 0 0)) (len 1 110) (= (second sizes) (third args))))
           ((:accept :getsockname :getpeername)
            (and (layout '(0 6 6 0)) (len 1 110)
                 (member (third sizes) '(0 4))))
           (:recvfrom (and (layout '(0 5 3 3)) (member (third sizes) '(0 28))
                           (member (fourth sizes) '(0 4))))
           (:sendto (and (layout '(0 4 2 0)) (len 2 110)))
           (:resolve (and (layout '(1 3 3 0)) (len 1 128 128) (len 2 32 32)
                          (<= (ldb (byte 8 0) (fourth args)) 8)))
           (:socketpair (and (layout '(0 0 0 3)) (len 3 8 8)))
           (:poll (and (layout '(6 0 0 0)) (<= (second args) 256)
                       (or (and (zerop (first args)) (zerop (first sizes)))
                           (= (first sizes) (* 8 (second args))))))
           (:spawn-packed (and (layout '(2 0 0 0)) (<= 24 (second args) 4096)
                                (= (first sizes) (second args))))
           (t nil)))))

(defun serve-request (proc request token)
  (when (< (length request) 72)
    (return-from serve-request
      (reply-octets (- (vfs:errno-code :einval)) '(0 0 0 0) #() '(0 0 0 0))))
  (let* ((op (request-u64 request 8))
         (name (and (< 0 op (length +libsa-ops+)) (aref +libsa-ops+ op)))
         (args (loop :for i :below 4 :collect (request-u64 request (+ 16 (* 8 i)))))
         (sizes (loop :for i :below 4 :collect (request-u32 request (+ 48 (* 4 i)))))
         (kinds (loop :for i :below 4 :collect (aref request (+ 64 i))))
         (offsets (let ((at 0)) (loop :for size :in sizes :collect (prog1 at (incf at size))))))
    (cond ((or (null name) (member name +world-refuses+))
           (reply-octets -38 '(0 0 0 0) #() offsets))
          ((not (valid-world-request-p name args sizes kinds request))
           (reply-octets -22 '(0 0 0 0) #() offsets))
          ((eq name :spawn-packed)
           (let ((result
                   (as-libsa (proc)
                     (with-bsd
                       (native-spawn-request (subseq request 72) (third args))))))
             (reply-octets result '(0 0 0 0) #() offsets)))
          ((eq name :waitpid)
           (let ((status (make-array 4 :element-type '(unsigned-byte 8)
                                      :initial-element 0)))
             (let ((result (as-libsa (proc)
                             (multiple-value-bind (pid code)
                                 (native-wait (signed (first args)) (third args))
                               (when (and code (plusp pid))
                                 (native-put status 0 code 4))
                               pid))))
               (reply-octets result
                             (list 0 (if (plusp result) (second sizes) 0) 0 0)
                             status '(0 0 0 0)))))
          ((member name '(:sendto :recvfrom))
           (multiple-value-bind (result outs) (serve-socket-transfer proc token name (first args) (second args) (second sizes) request sizes)
             (let* ((lens (loop :for out :in outs :for size :in sizes :collect (if out (min size (length out)) 0)))
                    (work (apply #'concatenate '(vector (unsigned-byte 8)) (loop :for out :in outs :for len :in lens :collect (if out (subseq out 0 len) #()))))
                    (at 0)
                    (starts (loop :for len :in lens :collect (prog1 at (incf at len)))))
               (reply-octets result lens work starts))))
          ((member (second kinds) '(4 5))
           (reply-octets (serve-transfer proc token name (first args) (second args) (second sizes) (fourth args))
                         '(0 0 0 0) #() offsets))
          (t
           (let ((work (make-array (max 1 (reduce #'+ sizes)) :element-type '(unsigned-byte 8) :initial-element 0))
                 (in 72))
             (loop :for kind :in kinds :for size :in sizes :for at :in offsets
                   :when (and (member kind '(1 2 6)) (plusp size))
                     :do (replace work request :start1 at :start2 in :end2 (+ in size))
                         (incf in size))
             (when (and (member name '(:accept :getsockname :getpeername))
                        (= (third sizes) 4))
               (native-put work (third offsets)
                           (min (second sizes) (request-u32 work (third offsets))) 4))
             (sb-sys:with-pinned-objects (work)
               (let* ((base (sb-sys:sap-int (sb-sys:vector-sap work)))
                      (real (loop :for kind :in kinds :for size :in sizes :for at :in offsets :for arg :in args
                                  :collect (cond ((zerop kind) arg) ((zerop size) (if (and (= kind 6) (plusp arg)) base 0)) (t (+ base at)))))
                      (result (libsa-entry op (first real) (second real) (third real) (fourth real) proc))
                      (lens (loop :for kind :in kinds :for size :in sizes
                                  :collect (cond ((not (member kind '(3 6))) 0)
                                                 ((member name '(:read :pread :readlink)) (if (minusp result) 0 (min result size)))
                                                 (t size)))))
                 (reply-octets result lens work offsets))))))))

(defun console-fds ()
  (let ((fds (proc-fds *proc0*)))
    (dotimes (fd 3)
      (loop :while (<= (length fds) fd) :do (vector-push-extend nil fds))
      (unless (aref fds fd)
        (setf (aref fds fd) (cons (make-instance 'vnode :fd fd :device t :access 2) nil))))))

(defun libsa-start ()
  (setf sb-ext:*invoke-debugger-hook* 'report-and-unwind)
  (console-fds)
  (setf *libsa-entry* (sb-alien::alien-lambda sb-alien:long ((op sb-alien:long) (a sb-alien:unsigned-long)
                                                             (b sb-alien:unsigned-long) (c sb-alien:unsigned-long)
                                                             (d sb-alien:unsigned-long))
                        (libsa-entry op a b c d)))
  (sb-alien:alien-funcall
   (sb-alien:extern-alien "__libsa_vfs_register" (function sb-alien:void sb-alien:system-area-pointer))
   (sb-alien:alien-sap *libsa-entry*)))
