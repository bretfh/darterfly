(in-package #:darterfly/bsd)

(defparameter +libsa-ops+
  #(nil :open :close :read :write :pread :pwrite :lseek :stat :lstat :fstat :readlink :symlink :mkdir :rmdir
    :unlink :rename :chdir :fchdir :getcwd :realpath :chmod :fchmod :chown :fchown :truncate :ftruncate :dup :dup2
    :fcntl :readdir :link :utimes :fsync :umask :pipe :spawn :waitpid
    :socket :bind :listen :accept :connect :getsockname :getpeername :shutdown :recvfrom :sendto :resolve))

(defun c-string (address)
  (let* ((sap (sb-sys:int-sap address))
         (n (loop :for i :from 0 :until (zerop (sb-sys:sap-ref-8 sap i)) :finally (return i)))
         (v (make-array n :element-type '(unsigned-byte 8))))
    (sb-sys:with-pinned-objects (v) (sb-kernel:system-area-ub8-copy sap 0 (sb-sys:vector-sap v) 0 n))
    (sb-ext:octets-to-string v :external-format :utf-8)))

(defun put-octets (octets address &optional (limit (length octets)))
  (let ((n (min limit (length octets)))
        (v (coerce octets '(simple-array (unsigned-byte 8) (*)))))
    (sb-sys:with-pinned-objects (v) (sb-kernel:system-area-ub8-copy (sb-sys:vector-sap v) 0 (sb-sys:int-sap address) 0 n))
    n))

(defun get-octets (address n)
  (let ((v (make-array n :element-type '(unsigned-byte 8))))
    (sb-sys:with-pinned-objects (v) (sb-kernel:system-area-ub8-copy (sb-sys:int-sap address) 0 (sb-sys:vector-sap v) 0 n))
    v))

(defun put-string (string address size)
  (let ((octets (sb-ext:string-to-octets string :external-format :utf-8 :null-terminate t)))
    (when (> (length octets) size) (fail :erange))
    (put-octets octets address)
    (1- (length octets))))

(defun signed (n) (if (logbitp 63 n) (- n (ash 1 64)) n))

(defun from-libsa-flags (flags)
  (logior (logand flags 3)
          (if (logtest flags #o100) +o-creat+ 0) (if (logtest flags #o200) +o-excl+ 0)
          (if (logtest flags #o1000) +o-trunc+ 0) (if (logtest flags #o2000) +o-append+ 0)
          (if (logtest flags #o4000) +o-nonblock+ 0) (if (logtest flags #o200000) +o-directory+ 0)))

(defun put-stat (attr id address)
  (let ((sap (sb-sys:int-sap address))
        (mtime (vfs:vattr-mtime attr)))
    (dotimes (i 144) (setf (sb-sys:sap-ref-8 sap i) 0))
    (setf (sb-sys:sap-ref-64 sap 8) id
          (sb-sys:sap-ref-64 sap 16) (vfs:vattr-nlink attr)
          (sb-sys:sap-ref-32 sap 24) (vfs:vattr-mode attr)
          (sb-sys:sap-ref-32 sap 28) (logand (vfs:vattr-uid attr) #xffffffff)
          (sb-sys:sap-ref-32 sap 32) (logand (vfs:vattr-gid attr) #xffffffff)
          (sb-sys:sap-ref-64 sap 40) (vfs:vattr-rdev attr)
          (sb-sys:sap-ref-64 sap 48) (vfs:vattr-size attr)
          (sb-sys:sap-ref-64 sap 56) 4096
          (sb-sys:sap-ref-64 sap 64) (ceiling (vfs:vattr-size attr) 512))
    (loop :for at :in '(72 88 104)
          :do (setf (sb-sys:sap-ref-64 sap at) (floor mtime 1000000000)
                    (sb-sys:sap-ref-64 sap (+ at 8)) (mod mtime 1000000000)))
    0))

(defun put-vnode-stat (vnode address)
  (put-stat (vfs:vnop-getattr vnode) (vfs:vnode-id vnode) address))

(defun put-dirent (name vnode address)
  (let ((sap (sb-sys:int-sap address))
        (octets (sb-ext:string-to-octets name :external-format :utf-8 :null-terminate t)))
    (setf (sb-sys:sap-ref-64 sap 0) (vfs:vnode-id vnode)
          (sb-sys:sap-ref-64 sap 8) 0
          (sb-sys:sap-ref-16 sap 16) 280
          (sb-sys:sap-ref-8 sap 18) (case (vfs:vnode-type vnode) (:vdir 4) (:vreg 8) (:vlnk 10) (:vchr 2) (t 0)))
    (put-octets octets (+ address 19) 256)
    1))

(defun vnode-file (fd)
  (let ((file (fd-file fd)))
    (unless (typep file 'vnode) (fail :espipe))
    file))

(defun fd-vnode (fd) (vfs (vfs:fd-vnode (vfs-fd (vnode-file fd)))))

(defun path-vnode (address &optional (follow t))
  (vfs (vfs:namei (path (c-string address)) :follow follow)))

(defun dup-from (fd from)
  (syscall
    (let ((file (fd-file fd)))
      (incf (file-refs file))
      (fd-alloc file from))))

(defun put-fds (read write address)
  (setf (sb-sys:sap-ref-32 (sb-sys:int-sap address) 0) read
        (sb-sys:sap-ref-32 (sb-sys:int-sap address) 4) write)
  0)

(defun c-strings (address)
  (unless (zerop address)
    (loop :for at :from address :by 8
          :for p := (sb-sys:sap-ref-64 (sb-sys:int-sap at) 0)
          :until (zerop p)
          :collect (c-string p))))

(defun search-path (program)
  (if (find #\/ program)
      program
      (or (loop :for dir :in '("/bin" "/usr/bin" "/sbin" "/usr/sbin")
                :for full := (format nil "~a/~a" dir program)
                :when (ignore-errors (stat full)) :return full)
          program)))

(defun libsa-spawn (address)
  (flet ((word (i) (sb-sys:sap-ref-64 (sb-sys:int-sap address) (* 8 i))))
    (let ((program (c-string (word 0)))
          (pwd (unless (zerop (word 6)) (c-string (word 6)))))
      (posix-spawn (if (plusp (word 7)) (search-path program) program) (c-strings (word 1)) (c-strings (word 5))
                   :file-actions (append (loop :for i :from 2 :to 4
                                               :for from := (signed (word i))
                                               :when (>= from 0) :collect (list :dup2 from (- i 2)))
                                         (list (list :closefrom 3))
                                         (when pwd (list (list :chdir pwd))))))))

(defun libsa-waitpid (pid address options)
  (multiple-value-bind (reaped status)
      (wait4 pid :nohang (logtest options 1) :untraced (logtest options 2) :continued (logtest options 8))
    (when (and status (not (zerop address)))
      (setf (sb-sys:signed-sap-ref-32 (sb-sys:int-sap address) 0) status))
    reaped))

(defun get-sockaddr (address)
  (let ((sap (sb-sys:int-sap address)))
    (let ((port (logior (ash (sb-sys:sap-ref-8 sap 2) 8) (sb-sys:sap-ref-8 sap 3))))
      (case (sb-sys:sap-ref-16 sap 0)
        (2 (values (loop :for i :from 4 :below 8 :for ip := (sb-sys:sap-ref-8 sap i) :then (logior (ash ip 8) (sb-sys:sap-ref-8 sap i))
                         :finally (return ip))
                   port))
        (10 (values (let ((v (make-array 16 :element-type '(unsigned-byte 8))))
                      (dotimes (i 16 v) (setf (aref v i) (sb-sys:sap-ref-8 sap (+ 8 i)))))
                    port))
        (t (fail :eafnosupport))))))

(defun put-sockaddr (ip port address length-address)
  (unless (zerop address)
    (let ((sap (sb-sys:int-sap address))
          (ip (if (stringp ip) (darterfly/net:ip-address ip) ip)))
      (dotimes (i 28) (setf (sb-sys:sap-ref-8 sap i) 0))
      (setf (sb-sys:sap-ref-8 sap 2) (ldb (byte 8 8) port)
            (sb-sys:sap-ref-8 sap 3) (ldb (byte 8 0) port))
      (let ((length (if (integerp ip)
                        (progn (setf (sb-sys:sap-ref-16 sap 0) 2)
                               (dotimes (i 4) (setf (sb-sys:sap-ref-8 sap (+ 4 i)) (ldb (byte 8 (* 8 (- 3 i))) ip)))
                               16)
                        (progn (setf (sb-sys:sap-ref-16 sap 0) 10)
                               (dotimes (i 16) (setf (sb-sys:sap-ref-8 sap (+ 8 i)) (aref ip i)))
                               28))))
        (unless (zerop length-address)
          (setf (sb-sys:sap-ref-32 (sb-sys:int-sap length-address) 0) length)))))
  0)

(defun libsa-socket (domain type protocol)
  (let ((fd (socket (case domain (2 +af-inet+) (10 +af-inet6+) (t domain)) (logand type #xf) protocol)))
    (when (logtest type #o4000) (setf (file-flags (fd-file fd)) +o-nonblock+))
    fd))

(defun socket-addresses (fd)
  (let* ((s (fd-socket fd))
         (pcb (socket-pcb s)))
    (if (typep pcb 'darterfly/net:connection)
        (multiple-value-list (darterfly/net:tcp-peer pcb))
        (socket-peer s))))

(defun libsa-resolve (name addresses families encoded)
  (let* ((max (ldb (byte 8 0) encoded))
         (family (ldb (byte 8 8) encoded))
         (ips (or (ignore-errors (list (darterfly/net:ip-address name)))
                  (append (unless (= family 10) (ignore-errors (darterfly/net:resolve-name name :type :a)))
                          (unless (= family 2) (ignore-errors (darterfly/net:resolve-name name :type :aaaa))))))
         (ips (subseq ips 0 (min max (length ips)))))
    (loop :for ip :in ips
          :for i :from 0
          :for v := (if (stringp ip) (darterfly/net:ip-address ip) ip)
          :do (let ((sap (sb-sys:int-sap (+ addresses (* 16 i)))))
                (if (integerp v)
                    (progn (dotimes (k 4) (setf (sb-sys:sap-ref-8 sap k) (ldb (byte 8 (* 8 (- 3 k))) v)))
                           (setf (sb-sys:signed-sap-ref-32 (sb-sys:int-sap families) (* 4 i)) 2))
                    (progn (dotimes (k 16) (setf (sb-sys:sap-ref-8 sap k) (aref v k)))
                           (setf (sb-sys:signed-sap-ref-32 (sb-sys:int-sap families) (* 4 i)) 10)))))
    (length ips)))

(defun libsa-recvfrom (fd address)
  (flet ((word (i) (sb-sys:sap-ref-64 (sb-sys:int-sap address) (* 8 i))))
    (let ((s (fd-socket fd)))
      (if (= (socket-type s) +sock-dgram+)
          (multiple-value-bind (data ip port) (recvfrom fd (word 1))
            (put-sockaddr ip port (word 2) (word 3))
            (put-octets data (word 0)))
          (put-octets (read fd (word 1)) (word 0))))))

(defun libsa-sendto (fd address)
  (flet ((word (i) (sb-sys:sap-ref-64 (sb-sys:int-sap address) (* 8 i))))
    (let ((s (fd-socket fd))
          (octets (get-octets (word 0) (word 1))))
      (if (and (= (socket-type s) +sock-dgram+) (not (zerop (word 2))))
          (multiple-value-bind (ip port) (get-sockaddr (word 2)) (sendto fd octets ip port))
          (write fd octets)))))

(defun libsa-call (op a b c d)
  (ecase op
    (:open (let ((fd (open (c-string a) (from-libsa-flags b) c)))
             (if (< fd 3) (prog1 (dup-from fd 3) (close fd)) fd)))
    (:close (close a))
    (:read (put-octets (read a c) b))
    (:write (write a (get-octets b c)))
    (:pread (put-octets (vfs (vfs:vfs-read (vfs-fd (vnode-file a)) c (signed d))) b))
    (:pwrite (vfs (vfs:vfs-write (vfs-fd (vnode-file a)) (get-octets b c) (signed d))))
    (:lseek (lseek a (signed b) (ecase c (0 :set) (1 :cur) (2 :end))))
    (:stat (put-vnode-stat (path-vnode a) b))
    (:lstat (put-vnode-stat (path-vnode a nil) b))
    (:fstat (let ((file (fd-file a)))
              (if (typep file 'vnode)
                  (put-vnode-stat (fd-vnode a) b)
                  (put-stat (vfs:make-vattr :mode (logior +s-ififo+ #o600)) 0 b))))
    (:readlink (put-octets (sb-ext:string-to-octets (vfs (vfs:vfs-readlink (path (c-string a)))) :external-format :utf-8) b c))
    (:symlink (symlink (c-string a) (c-string b)))
    (:mkdir (mkdir (c-string a) b))
    (:rmdir (rmdir (c-string a)))
    (:unlink (unlink (c-string a)))
    (:rename (rename (c-string a) (c-string b)))
    (:chdir (chdir (c-string a)))
    (:fchdir (fail :enotsup))
    (:getcwd (put-string (getcwd) a b))
    (:realpath (put-string (unroot (vfs (vfs:vfs-realpath (path (c-string a))))) b c))
    (:chmod (vfs (vfs:vnop-setattr (path-vnode a) :mode b)))
    (:fchmod (vfs (vfs:vnop-setattr (fd-vnode a) :mode b)))
    (:chown (vfs (vfs:vnop-setattr (path-vnode a) :uid (signed b) :gid (signed c))))
    (:fchown (vfs (vfs:vnop-setattr (fd-vnode a) :uid (signed b) :gid (signed c))))
    (:truncate (vfs (vfs:vnop-truncate (path-vnode a) b)) 0)
    (:ftruncate (vfs (vfs:vnop-truncate (fd-vnode a) b)) 0)
    (:dup (dup-from a 3))
    (:dup2 (if (< b 3) (fail :ebadf) (dup2 a b)))
    (:fcntl (let ((file (fd-file a)))
              (case b
                (0 (dup-from a (max c 3)))
                (3 (logior (file-access file) (if (nonblocking-p file) #o4000 0)))
                (4 (setf (file-flags file) (if (logtest c #o4000) +o-nonblock+ 0)) 0)
                (t 0))))
    (:readdir (let ((entry (vfs (vfs:vfs-readdir (vfs-fd (vnode-file a)) b))))
                (if entry (put-dirent (car entry) (cdr entry) c) 0)))
    (:link (fail :enotsup))
    (:utimes (path-vnode a) 0)
    (:fsync (fd-file a) (vfs:vfs-sync))
    (:umask (prog1 vfs:*umask* (setf vfs:*umask* (logand a #o777))))
    (:pipe (multiple-value-bind (read write) (pipe)
             (put-fds read write a)))
    (:spawn (libsa-spawn a))
    (:waitpid (libsa-waitpid (signed a) b c))
    (:socket (libsa-socket a b c))
    (:bind (multiple-value-bind (ip port) (get-sockaddr b) (bind a ip port)))
    (:listen (listen a b))
    (:accept (multiple-value-bind (fd ip port) (accept a) (put-sockaddr ip port b c) fd))
    (:connect (multiple-value-bind (ip port) (get-sockaddr b) (connect a ip port)))
    (:getsockname (put-sockaddr 0 (or (socket-port (fd-socket a)) 0) b c))
    (:getpeername (destructuring-bind (&optional ip port) (socket-addresses a)
                    (unless ip (fail :enotconn))
                    (put-sockaddr ip port b c)))
    (:shutdown (fd-socket a) 0)
    (:recvfrom (libsa-recvfrom a b))
    (:sendto (libsa-sendto a b))
    (:resolve (libsa-resolve (c-string a) b c d))))

(defmacro as-libsa ((proc) &body body)
  `(sb-sys:without-interrupts
     (handler-case (or (let ((*proc* ,proc)) ,@body) 0)
       (errno (e) (- (vfs:errno-code (errno-name e))))
       (vfs:vfs-error (e) (- (vfs:errno-code (vfs:vfs-errno e))))
       (error () (- (vfs:errno-code :eio))))))

(defun libsa-entry (op a b c d &optional (proc *proc0*))
  (as-libsa (proc) (libsa-call (aref +libsa-ops+ op) a b c d)))

(defvar *libsa-entry* nil)

(defun make-world-proc (cwd)
  (with-bsd
    (let ((proc (make-instance 'proc :pid (next-pid) :parent *proc0* :task darterfly/mach:*task*)))
      (setf (proc-cwd proc) cwd
            (proc-comm proc) "world"
            (gethash (proc-pid proc) *procs*) proc)
      proc)))

(defun end-world-proc (proc)
  (with-bsd
    (loop :for fd :below (length (proc-fds proc))
          :when (aref (proc-fds proc) fd)
            :do (release-fd proc fd))
    (remhash (proc-pid proc) *procs*)))

(defun request-u64 (v at) (loop :for i :below 8 :sum (ash (aref v (+ at i)) (* 8 i))))

(defun request-u32 (v at) (loop :for i :below 4 :sum (ash (aref v (+ at i)) (* 8 i))))

(defun serve-transfer (proc token op fd there size offset)
  (case op
    ((:write :pwrite)
     (let ((octets (make-array size :element-type '(unsigned-byte 8))))
       (sb-sys:with-pinned-objects (octets)
         (darterfly/worlds:copy-from token there (sb-sys:sap-int (sb-sys:vector-sap octets)) size))
       (as-libsa (proc)
         (if (eq op :write)
             (write fd octets)
             (vfs (vfs:vfs-write (vfs-fd (vnode-file fd)) octets (signed offset)))))))
    ((:read :pread)
     (as-libsa (proc)
       (let ((octets (coerce (if (eq op :read)
                                 (read fd size)
                                 (vfs (vfs:vfs-read (vfs-fd (vnode-file fd)) size (signed offset))))
                             '(simple-array (unsigned-byte 8) (*)))))
         (sb-sys:with-pinned-objects (octets)
           (darterfly/worlds:copy-into token there (sb-sys:sap-int (sb-sys:vector-sap octets)) (length octets)))
         (length octets))))
    (t (- (vfs:errno-code :enosys)))))

(defun reply-octets (result lens work offsets)
  (let ((reply (make-array (+ 24 (reduce #'+ lens)) :element-type '(unsigned-byte 8) :initial-element 0)))
    (dotimes (i 8) (setf (aref reply i) (ldb (byte 8 (* 8 i)) result)))
    (loop :for len :in lens :for i :from 0
          :do (dotimes (k 4) (setf (aref reply (+ 8 (* 4 i) k)) (ldb (byte 8 (* 8 k)) len))))
    (let ((out 24))
      (loop :for len :in lens :for at :in offsets
            :when (plusp len)
              :do (replace reply work :start1 out :start2 at :end2 (+ at len))
                  (incf out len)))
    reply))

(defparameter +world-refuses+
  '(:spawn :socket :bind :listen :accept :connect :getsockname :getpeername :shutdown :recvfrom :sendto :resolve))

(defun serve-request (proc request token)
  (let* ((op (request-u64 request 8))
         (name (and (< 0 op (length +libsa-ops+)) (aref +libsa-ops+ op)))
         (args (loop :for i :below 4 :collect (request-u64 request (+ 16 (* 8 i)))))
         (sizes (loop :for i :below 4 :collect (request-u32 request (+ 48 (* 4 i)))))
         (kinds (loop :for i :below 4 :collect (aref request (+ 64 i))))
         (offsets (let ((at 0)) (loop :for size :in sizes :collect (prog1 at (incf at size))))))
    (cond ((or (null name) (member name +world-refuses+))
           (reply-octets (- (vfs:errno-code :enosys)) '(0 0 0 0) #() offsets))
          ((member (second kinds) '(4 5))
           (reply-octets (serve-transfer proc token name (first args) (second args) (second sizes) (fourth args))
                         '(0 0 0 0) #() offsets))
          (t
           (let ((work (make-array (max 1 (reduce #'+ sizes)) :element-type '(unsigned-byte 8) :initial-element 0))
                 (in 72))
             (loop :for kind :in kinds :for size :in sizes :for at :in offsets
                   :when (and (member kind '(1 2)) (plusp size))
                     :do (replace work request :start1 at :start2 in :end2 (+ in size))
                         (incf in size))
             (sb-sys:with-pinned-objects (work)
               (let* ((base (sb-sys:sap-int (sb-sys:vector-sap work)))
                      (real (loop :for kind :in kinds :for size :in sizes :for at :in offsets :for arg :in args
                                  :collect (cond ((zerop kind) arg) ((zerop size) 0) (t (+ base at)))))
                      (result (libsa-entry op (first real) (second real) (third real) (fourth real) proc))
                      (lens (loop :for kind :in kinds :for size :in sizes
                                  :collect (cond ((/= kind 3) 0)
                                                 ((member name '(:read :pread :readlink)) (if (minusp result) 0 (min result size)))
                                                 (t size)))))
                 (reply-octets result lens work offsets))))))))

(defun console-fds ()
  (let ((fds (proc-fds *proc0*)))
    (dotimes (fd 3)
      (loop :while (<= (length fds) fd) :do (vector-push-extend nil fds))
      (unless (aref fds fd)
        (setf (aref fds fd) (cons (make-instance 'vnode :fd fd :device t :access 2) nil))))))

(defun libsa-start ()
  (setf sb-ext:*invoke-debugger-hook* 'report-and-unwind)
  (console-fds)
  (setf *libsa-entry* (sb-alien::alien-lambda sb-alien:long ((op sb-alien:long) (a sb-alien:unsigned-long)
                                                             (b sb-alien:unsigned-long) (c sb-alien:unsigned-long)
                                                             (d sb-alien:unsigned-long))
                        (libsa-entry op a b c d)))
  (sb-alien:alien-funcall
   (sb-alien:extern-alien "__libsa_vfs_register" (function sb-alien:void sb-alien:system-area-pointer))
   (sb-alien:alien-sap *libsa-entry*)))
