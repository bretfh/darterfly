(in-package #:finch/kern)

(defconstant +nsig+ 65)
(defconstant +sigint+ 2)
(defconstant +sigkill+ 9)
(defconstant +sigalrm+ 14)
(defconstant +sigstop+ 19)
(defconstant +sigprof+ 27)
(defconstant +sa-nodefer+ #x40000000)
(defconstant +sa-resethand+ #x80000000)
(defconstant +sig-ign+ 1)
(defconstant +eintr+ 4)
(defconstant +etimedout+ 110)
(defconstant +unblockable+ (logior (ash 1 (- +sigkill+ 1)) (ash 1 (- +sigstop+ 1))))
(defconstant +t-siglist+ 72)
(defconstant +sigact-size+ 24)
(defconstant +r-rdx+ 24)
(defconstant +r-rsi+ 32)
(defconstant +r-rdi+ 40)
(defconstant +r-rip+ 136)
(defconstant +r-cs+ 144)
(defconstant +r-rflags+ 152)
(defconstant +r-rsp+ 160)
(defconstant +r-ss+ 168)
(defconstant +ucontext-size+ 816)
(defconstant +siginfo-size+ 128)
(defconstant +uc-sigmask+ 512)
(defconstant +uc-ss+ 640)

(define-global p-siglist :u64 :export t)
(define-global p-sigacts :u8 :count (* 65 24) :alignment 8 :export t)
(define-global sigtramp :u64 :export t)
(define-global sigtrace :u32 :alignment 4 :export t)
(define-global sigtrace-known :u64)
(define-global real-interval :u64)
(define-global real-deadline :u64)
(define-global profinterval :u64)
(define-global profnext :u64 :count 32)

(define-low sigmask ((sig :u32)) (shl 1 (- sig 1)))

(define-low deliverable (th)
  (logand (logior (mem :u64 (+ th +t-siglist+)) p-siglist)
          (lognot (logand (mem :u64 (+ th +t-sigmask+)) (lognot +unblockable+)))))

(define-low psignal-thread (th (sig :u32))
  (when (or (= sig 0) (>= sig +nsig+)) (result 0))
  (setf (mem :u64 (+ th +t-siglist+)) (logior (mem :u64 (+ th +t-siglist+)) (sigmask sig)))
  (when (deliverable th) (thread-abort-safely th)))

(define-low psignal ((sig :u32))
  (when (or (= sig 0) (>= sig +nsig+)) (result 0))
  (setf p-siglist (logior p-siglist (sigmask sig)))
  (let ((th all-threads))
    (while th
      (when (and (/= (mem :u32 (+ th +t-state+)) +th-terminate+)
                 (not (logand (mem :u64 (+ th +t-sigmask+)) (sigmask sig))))
        (thread-abort-safely th)
        (result 0))
      (setf th (mem :u64 (+ th +t-all-next+))))))

(define-low issignal ()
  (let ((ready (deliverable (current-thread)))
        (n 1))
    (unless ready (result 0))
    (while (not (logand ready 1))
      (setf ready (shr ready 1))
      (incf n))
    n))

(define-low bsd-hardclock ()
  (when (and real-deadline (>= (rdtsc) real-deadline))
    (psignal +sigalrm+)
    (setf real-deadline (if real-interval (+ (rdtsc) real-interval) 0))))

(define-low bsd-proftick ()
  (unless profinterval (result 0))
  (let ((cpu (cpu-number))
        (now (rdtsc)))
    (when (< now (ref profnext cpu)) (result 0))
    (setf (ref profnext cpu) (+ now profinterval))
    (psignal-thread (current-thread) +sigprof+)))

(define-low bsd-console-interrupt-char ()
  (psignal +sigint+))

(define-low bsd-ast (regs)
  (let ((self (current-thread))
        (sig 0))
    (setf (mem :u32 (+ self +t-sched-flags+)) (logand (mem :u32 (+ self +t-sched-flags+)) (lognot +abort-safely+)))
    (unless sigtrace-known
      (setf sigtrace (the :u32 (|platform_parse_boot_arg| "sigtrace")))
      (setf sigtrace-known 1))
    (while (setf sig (issignal))
      (if (logand (mem :u64 (+ self +t-siglist+)) (sigmask sig))
          (setf (mem :u64 (+ self +t-siglist+)) (logand (mem :u64 (+ self +t-siglist+)) (lognot (sigmask sig))))
          (setf p-siglist (logand p-siglist (lognot (sigmask sig)))))
      (when sigtrace
        (kprintf "[ast: thread 0x%lx deliver %d at 0x%lx mask 0x%lx]
" (mem :u64 (+ self +t-thread-id+)) sig (mem :u64 (+ regs +r-rip+)) (mem :u64 (+ self +t-sigmask+))))
      (unless (= (mem :u64 (+ (address p-sigacts) (* sig +sigact-size+))) +sig-ign+)
        (sendsig regs sig 0 0)
        (result 0)))))

(define-low tsleep (ready event deadline)
  (while 1
    (when (and ready (the :u32 (call-pointer ready))) (result 0))
    (when (issignal) (result +eintr+))
    (when (terminating) (result +eintr+))
    (when (and deadline (>= (rdtsc) deadline)) (result +etimedout+))
    (let ((r (the :u32 (thread-wait event deadline))))
      (when (and (= r +thread-interrupted+) (issignal)) (result +eintr+))
      (when (= r +thread-timed-out+) (result +etimedout+))
      (when (and (not ready) (= r +thread-awakened+) event) (result 0)))))

(define-low usec-to-tsc (sec usec)
  (+ (* sec (ref commpage 0)) (* usec (truncate (ref commpage 0) 1000000))))

(define-low tsc-to-timeval (tsc tv)
  (setf (mem :u64 tv) (truncate tsc (ref commpage 0)))
  (setf (mem :u64 (+ tv 8)) (truncate (rem tsc (ref commpage 0)) (truncate (ref commpage 0) 1000000))))

(define-low getitimer-real (out)
  (let ((now (rdtsc)))
    (tsc-to-timeval real-interval out)
    (tsc-to-timeval (if (> real-deadline now) (- real-deadline now) 0) (+ out 16))))

(define-low setitimer-real (in old)
  (when old (getitimer-real old))
  (setf real-interval (usec-to-tsc (mem :u64 in) (mem :u64 (+ in 8))))
  (let ((value (usec-to-tsc (mem :u64 (+ in 16)) (mem :u64 (+ in 24)))))
    (setf real-deadline (if value (+ (rdtsc) value) 0))))

(define-low getitimer-prof (out)
  (tsc-to-timeval profinterval out)
  (tsc-to-timeval profinterval (+ out 16)))

(define-low setitimer-prof (in old)
  (when old (getitimer-prof old))
  (let ((interval (usec-to-tsc (mem :u64 in) (mem :u64 (+ in 8))))
        (value (usec-to-tsc (mem :u64 (+ in 16)) (mem :u64 (+ in 24))))
        (i 0))
    (setf profinterval (if value (if interval interval value) 0))
    (while (< i 32)
      (setf (ref profnext i) 0)
      (incf i))))

(define-low deadline-after (sec nsec)
  (+ (rdtsc) (usec-to-tsc sec (truncate nsec 1000))))

(define-low sendsig (regs (sig :u32) (code :u32) addr)
  (unless sigtramp (result 0))
  (let* ((sp (logand (- (mem :u64 (+ regs +r-rsp+)) 128 +ucontext-size+) (lognot 15)))
         (low (- (logand (- sp +siginfo-size+) (lognot 15)) 8))
         (page (logand low (lognot 4095)))
         (uc 0)
         (si 0)
         (act 0))
    (while (< page (mem :u64 (+ regs +r-rsp+)))
      (unless (the :u32 (vm-fault page 2))
        (kprintf "sendsig: thread 0x%lx has no stack at 0x%lx for signal %d
" (mem :u64 (+ (current-thread) +t-thread-id+)) page sig)
        (thread-terminate-self))
      (incf page 4096))
    (setf uc sp)
    (setf sp (logand (- sp +siginfo-size+) (lognot 15)))
    (setf si sp)
    (decf sp 8)
    (setf (mem :u64 sp) 0)
    (fxsave uc)
    (rep-stosb (+ uc +uc-sigmask+) 0 128)
    (setf (mem :u64 (+ uc +uc-sigmask+)) (mem :u64 (+ (current-thread) +t-sigmask+)))
    (rep-movsb (+ uc +uc-ss+) regs +saved-state-size+)
    (setf (mem :u32 si) sig)
    (setf (mem :u32 (+ si 4)) 0)
    (setf (mem :u32 (+ si 8)) code)
    (setf (mem :u64 (+ si 16)) addr)
    (setf act (+ (address p-sigacts) (* sig +sigact-size+)))
    (setf (mem :u64 (+ (current-thread) +t-sigmask+))
          (logior (mem :u64 (+ (current-thread) +t-sigmask+)) (mem :u64 (+ act 8))))
    (unless (logand (mem :u32 (+ act 16)) +sa-nodefer+)
      (setf (mem :u64 (+ (current-thread) +t-sigmask+))
            (logior (mem :u64 (+ (current-thread) +t-sigmask+)) (sigmask sig))))
    (when (logand (mem :u32 (+ act 16)) +sa-resethand+)
      (setf (mem :u64 act) 0))
    (setf (mem :u64 (+ regs +r-rip+)) sigtramp)
    (setf (mem :u64 (+ regs +r-rdi+)) sig)
    (setf (mem :u64 (+ regs +r-rsi+)) si)
    (setf (mem :u64 (+ regs +r-rdx+)) uc)
    (setf (mem :u64 (+ regs +r-rsp+)) sp)
    (setf (mem :u64 (+ regs +r-rflags+)) (logand (mem :u64 (+ regs +r-rflags+)) (lognot #x100)))
    1))

(define-low sigreturn (regs uc)
  (fxrstor uc)
  (let ((rflags (mem :u64 (+ regs +r-rflags+))))
    (rep-movsb regs (+ uc +uc-ss+) +saved-state-size+)
    (setf (mem :u64 (+ regs +r-cs+)) +user64-cs+)
    (setf (mem :u64 (+ regs +r-ss+)) +user-ds+)
    (setf (mem :u64 (+ regs +r-rflags+))
          (logior (logand (mem :u64 (+ uc +uc-ss+ (- +r-rflags+ 0))) #x0DD5) (logand rflags (lognot #x0DD5))))
    (setf (mem :u64 (+ (current-thread) +t-sigmask+))
          (logand (mem :u64 (+ uc +uc-sigmask+)) (lognot +unblockable+)))))
