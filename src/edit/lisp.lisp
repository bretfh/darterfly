(in-package #:darterfly/edit)

(defun terminating-p (ch)
  (or (member ch '(#\Space #\Tab #\( #\) #\" #\' #\` #\, #\;))
      (char= ch #\Newline)))

(defun token-end (line from)
  (or (position-if #'terminating-p line :start from) (length line)))

(defun string-end (line from)
  (loop :with i := from
        :while (< i (length line))
        :do (case (char line i)
              (#\\ (incf i 2))
              (#\" (return (values (1+ i) t)))
              (t (incf i)))
        :finally (return (values (length line) nil))))

(defun block-end (line from depth)
  (loop :with i := from
        :while (< i (1- (length line)))
        :do (cond ((and (char= #\| (char line i)) (char= #\# (char line (1+ i))))
                   (decf depth)
                   (incf i 2)
                   (when (zerop depth) (return (values i 0))))
                  ((and (char= #\# (char line i)) (char= #\| (char line (1+ i))))
                   (incf depth)
                   (incf i 2))
                  (t (incf i)))
        :finally (return (values (length line) depth))))

(defun spans (line &optional state)
  (let ((out nil)
        (i 0)
        (n (length line)))
    (flet ((span (from to kind) (when (< from to) (push (list from to kind) out))))
      (case (first state)
        (:string
         (multiple-value-bind (end closed) (string-end line 0)
           (span 0 end :string)
           (setf i end)
           (unless closed (return-from spans (values (nreverse out) state)))))
        (:block
         (multiple-value-bind (end depth) (block-end line 0 (second state))
           (span 0 end :comment)
           (setf i end)
           (when (plusp depth) (return-from spans (values (nreverse out) (list :block depth)))))))
      (loop :while (< i n)
            :do (let ((ch (char line i)))
                  (cond
                    ((char= ch #\;)
                     (span i n :comment)
                     (setf i n))
                    ((char= ch #\")
                     (multiple-value-bind (end closed) (string-end line (1+ i))
                       (span i end :string)
                       (setf i end)
                       (unless closed (return-from spans (values (nreverse out) (list :string))))))
                    ((and (char= ch #\#) (< (1+ i) n) (char= #\| (char line (1+ i))))
                     (multiple-value-bind (end depth) (block-end line (+ i 2) 1)
                       (span i end :comment)
                       (setf i end)
                       (when (plusp depth)
                         (return-from spans (values (nreverse out) (list :block depth))))))
                    ((and (char= ch #\#) (< (+ i 2) n) (char= #\\ (char line (1+ i))))
                     (let ((end (token-end line (+ i 3))))
                       (span i end :char)
                       (setf i end)))
                    ((char= ch #\|)
                     (setf i (1+ (or (position #\| line :start (1+ i)) (1- n)))))
                    ((char= ch #\:)
                     (let ((end (token-end line i)))
                       (span i end :keyword)
                       (setf i (max end (1+ i)))))
                    ((terminating-p ch) (incf i))
                    (t (setf i (max (1+ i) (token-end line i))))))))
    (values (nreverse out) nil)))

(defun toplevel-form (buffer)
  (let ((from (loop :for n :downfrom (buffer-point-line buffer) :to 0
                    :when (uiop:string-prefix-p "(" (buffer-line buffer n))
                      :return n)))
    (when from
      (let ((text (with-output-to-string (s)
                    (loop :for n :from from :below (buffer-line-count buffer)
                          :do (write-line (buffer-line buffer n) s)))))
        (read-from-string text)))))
