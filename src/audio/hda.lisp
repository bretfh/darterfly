(in-package #:darterfly/audio)

(defstruct widget nid type caps connections pin-caps config amp-out-caps)
(defstruct codec controller address vendor afg widgets)

(devices:define-device-class hda-controller "HDAudioController" (audio-device)
  ((registers :accessor hda-registers)
   (verb-lock :initform (sb-thread:make-mutex :name "hda verbs") :reader hda-verb-lock)
   (lock :initform (sb-thread:make-mutex :name "hda") :reader hda-lock)
   (codecs :initform nil :accessor hda-codecs)
   (outputs :initform nil :accessor hda-outputs)
   (vector :initform nil :accessor hda-vector)
   (suspended :initform nil :accessor hda-suspended)
   (last-active :initform 0 :accessor hda-last-active)
   (volume :initform 0.5 :accessor hda-volume)
   (muted :initform nil :accessor hda-muted)
   (idle-thread :initform nil :accessor hda-idle-thread)
   (input-streams :initform 0 :reader input-streams :writer (setf hda-input-streams))
   (output-streams :initform 0 :reader output-streams :writer (setf hda-output-streams))))

(devices:add-personality "Class" "HDAudioController" "ProviderClass" "PCIDevice" "PCIClassMatch" "0x00040300")

(defun pci (c) (devices::provider c))

(defun reg (c offset width) (devices:mmio-read (+ (hda-registers c) offset) width))
(defun (setf reg) (value c offset width) (devices:mmio-write (+ (hda-registers c) offset) width value) value)

(defun wait-for (what test &optional (seconds 0.1))
  (let ((deadline (+ (get-internal-real-time) (* seconds internal-time-units-per-second))))
    (loop until (funcall test)
          do (when (> (get-internal-real-time) deadline) (error "hda: timed out waiting for ~a" what))
             (sleep 0.0001))))

(defun power-state (d)
  (let ((pm (devices:find-pci-capability d 1)))
    (if pm (ldb (byte 2 0) (devices:config-read-16 d (+ pm 4))) 0)))

(defun (setf power-state) (state d)
  (let ((pm (devices:find-pci-capability d 1)))
    (when pm
      (let ((csr (devices:config-read-16 d (+ pm 4))))
        (devices:config-write-16 d (+ pm 4) (logior (logand csr (lognot #x8003)) state))
        (sleep 0.01)))
    state))


(defun verb (c cad nid verb payload)
  (let ((command (if (> verb #xF)
                     (logior (ash cad 28) (ash nid 20) (ash verb 8) payload)
                     (logior (ash cad 28) (ash nid 20) (ash verb 16) payload))))
    (sb-thread:with-mutex ((hda-verb-lock c))
      (wait-for "the command interface" (lambda () (not (logbitp 0 (reg c #x68 16)))))
      (setf (reg c #x68 16) 2)
      (setf (reg c #x60 32) command)
      (setf (reg c #x68 16) 1)
      (wait-for "a codec response" (lambda () (logbitp 1 (reg c #x68 16))))
      (reg c #x64 32))))

(defun reset-controller (c)
  (let ((d (pci c)))
    (unless (zerop (power-state d)) (setf (power-state d) 0))
    (devices:config-write-16 d #x78 (logandc2 (devices:config-read-16 d #x78) (ash 1 11)))
    (devices:config-write-8 d #x44 (logandc2 (devices:config-read-8 d #x44) 7))
    (setf (reg c #x08 32) (logandc2 (reg c #x08 32) 1))
    (wait-for "the controller to enter reset" (lambda () (zerop (logand (reg c #x08 32) 1))))
    (sleep 0.001)
    (setf (reg c #x08 32) (logior (reg c #x08 32) 1))
    (wait-for "the controller to leave reset" (lambda () (logbitp 0 (reg c #x08 32))))
    (sleep 0.002)
    (when (hda-vector c) (devices::enable-msi d (hda-vector c)))
    (setf (reg c #x20 32) (ash 1 31))
    (setf (hda-suspended c) nil)
    (reg c #x0E 16)))

(defun wake (c)
  (when (hda-suspended c)
    (reset-controller c)
    (dolist (codec (hda-codecs c)) (verb c (codec-address codec) (codec-afg codec) #x705 0))))

(defun suspend (c)
  (setf (reg c #x20 32) 0)
  (dolist (codec (hda-codecs c)) (ignore-errors (verb c (codec-address codec) (codec-afg codec) #x705 3)))
  (setf (power-state (pci c)) 3)
  (setf (hda-suspended c) t))

(defmethod devices:start ((c hda-controller) (d devices:pci-node))
  (let ((address (devices::bar-address d 0)))
    (unless address (return-from devices:start nil))
    (setf (hda-registers c) (devices:ml-io-map address #x4000)))
  (devices::set-memory-enable d t)
  (devices::set-bus-master-enable d t)
  (setf (hda-vector c) (devices:allocate-vector))
  (let ((present (reset-controller c))
        (caps (reg c 0 16)))
    (setf (hda-input-streams c) (ldb (byte 4 8) caps)
          (hda-output-streams c) (ldb (byte 4 12) caps))
    (setf (hda-codecs c)
          (remove nil (loop for cad below 15
                            when (logbitp cad present)
                              collect (ignore-errors (read-codec c cad))))))
  (devices:set-property c "Codecs" (mapcar (lambda (k) (format nil "~8,'0x" (codec-vendor k))) (hda-codecs c)))
  (register-audio-device c)
  (setf (hda-idle-thread c) (sb-thread:make-thread #'idle-loop :name "audio idle" :arguments (list c)))
  t)

(defun idle-loop (c)
  (loop
    (sleep 0.25)
    (ignore-errors
     (sb-thread:with-recursive-lock ((hda-lock c))
       (let ((quiet (/ (- (get-internal-real-time) (hda-last-active c)) internal-time-units-per-second)))
         (dolist (o (hda-outputs c))
           (when (and (output-running-p o) (finished-p o) (> quiet 0.5))
             (stop-output o)))
         (when (and (not (hda-suspended c)) (> quiet 5)
                    (notany #'output-running-p (hda-outputs c)))
           (suspend c)))))))
