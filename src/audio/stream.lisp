(in-package #:darterfly/audio)

(defconstant +period-bytes+ 4096)
(defconstant +periods+ 16)
(defconstant +ring-bytes+ (* +period-bytes+ +periods+))

(defclass hda-output ()
  ((controller :initarg :controller :reader output-controller)
   (index :initarg :index :reader output-index)
   (ring :initarg :ring :reader output-ring)
   (bdl :initarg :bdl :reader output-bdl)
   (codec :initform nil :accessor output-codec)
   (path :initform nil :accessor output-path)
   (written :initform 0 :accessor output-written)
   (played :initform 0 :accessor output-played)
   (last-lpib :initform 0 :accessor output-last-lpib)
   (running :initform nil :reader output-running-p :writer (setf running))))

(defun output-tag (o) (1+ (output-index o)))
(defun descriptor (o)
  (let ((c (output-controller o)))
    (+ #x80 (* #x20 (+ (input-streams c) (output-index o))))))
(defun stream-bit (o) (ash 1 (+ (input-streams (output-controller o)) (output-index o))))

(defmethod open-output ((c hda-controller) &key (rate 48000) (channels 2) (bits 16))
  (unless (and (= rate 48000) (= channels 2) (= bits 16))
    (error "hda: only 48 kHz 16-bit stereo for now"))
  (sb-thread:with-recursive-lock ((hda-lock c))
    (let ((index (loop for i below (output-streams c)
                       unless (find i (hda-outputs c) :key #'output-index) return i)))
      (unless index (error "hda: no free output stream"))
      (let ((o (make-instance 'hda-output :controller c :index index
                                          :ring (devices:vm-pages-grab (ceiling +ring-bytes+ 4096))
                                          :bdl (devices:vm-page-grab))))
        (dotimes (i +periods+)
          (devices::ml-phys-write-64 (+ (output-bdl o) (* 16 i)) (+ (output-ring o) (* i +period-bytes+)))
          (devices::ml-phys-write-32 (+ (output-bdl o) (* 16 i) 8) +period-bytes+)
          (devices::ml-phys-write-32 (+ (output-bdl o) (* 16 i) 12) 1))
        (push o (hda-outputs c))
        o))))

(defun phys-zero (pa n) (loop for i from 0 below n by 8 do (devices::ml-phys-write-64 (+ pa i) 0)))

(defun ring-write (o offset data start end)
  (loop for i from start below end
        for at = (mod (+ offset (- i start)) +ring-bytes+)
        do (devices::ml-phys-write-8 (+ (output-ring o) at) (aref data i))))

(defun ring-zero (o offset n)
  (loop for i below n
        for at = (mod (+ offset i) +ring-bytes+)
        do (devices::ml-phys-write-8 (+ (output-ring o) at) 0)))

(defun start-output (o)
  (let* ((c (output-controller o)) (sd (descriptor o)))
    (wake c)
    (let* ((codec (or (find-if #'output-pins (hda-codecs c)) (error "hda: no codec with an output")))
           (path (or (path-to-dac codec (choose-pin codec)) (error "hda: no path to a DAC"))))
      (setf (output-codec o) codec (output-path o) path)
      (open-path codec path (output-tag o))
      (path-volume codec path (hda-volume c) (hda-muted c)))
    (setf (reg c sd 8) 1)
    (wait-for "the stream to enter reset" (lambda () (logbitp 0 (reg c sd 8))))
    (setf (reg c sd 8) 0)
    (wait-for "the stream to leave reset" (lambda () (not (logbitp 0 (reg c sd 8)))))
    (setf (reg c (+ sd 2) 8) (ash (output-tag o) 4)
          (reg c (+ sd 8) 32) +ring-bytes+
          (reg c (+ sd #x0C) 16) (1- +periods+)
          (reg c (+ sd #x12) 16) #x0011
          (reg c (+ sd #x18) 32) (ldb (byte 32 0) (output-bdl o))
          (reg c (+ sd #x1C) 32) (ash (output-bdl o) -32))
    (phys-zero (output-ring o) +ring-bytes+)
    (setf (output-played o) 0 (output-last-lpib o) 0 (output-written o) +period-bytes+)
    (setf (reg c #x20 32) (logior (reg c #x20 32) (stream-bit o)))
    (setf (reg c sd 8) (logior 2 4))
    (setf (running o) t)))

(defun stop-output (o)
  (let ((c (output-controller o)) (sd (descriptor o)))
    (setf (reg c sd 8) 0)
    (setf (reg c (+ sd 3) 8) #x1C)
    (setf (reg c #x20 32) (logandc2 (reg c #x20 32) (stream-bit o)))
    (when (output-path o) (close-path (output-codec o) (output-path o)))
    (setf (running o) nil)))

(defun update-played (o)
  (let* ((c (output-controller o)) (sd (descriptor o)) (lpib (reg c (+ sd 4) 32)))
    (incf (output-played o) (mod (- lpib (output-last-lpib o)) +ring-bytes+))
    (setf (output-last-lpib o) lpib)
    (setf (reg c (+ sd 3) 8) #x1C)))

(defun finished-p (o)
  (update-played o)
  (>= (output-played o) (output-written o)))

(defun wait-for-room (o n)
  (let ((c (output-controller o)))
    (loop
      (update-played o)
      (when (< (output-written o) (output-played o))
        (setf (output-written o) (+ (output-played o) +period-bytes+)))
      (when (<= (+ (- (output-written o) (output-played o)) n) (- +ring-bytes+ +period-bytes+)) (return))
      (sb-thread:release-mutex (hda-lock c))
      (unwind-protect
           (if (hda-vector c) (devices:wait-for-interrupt (list (hda-vector c)) 0.05) (sleep 0.005))
        (sb-thread:grab-mutex (hda-lock c))))))

(defmethod output-write ((o hda-output) data &key (start 0) (end (length data)))
  (let ((c (output-controller o)))
    (sb-thread:with-recursive-lock ((hda-lock c))
      (unless (output-running-p o) (start-output o))
      (loop with at = start
            while (< at end)
            do (let ((n (min (- end at) +period-bytes+)))
                 (wait-for-room o n)
                 (ring-write o (mod (output-written o) +ring-bytes+) data at (+ at n))
                 (incf (output-written o) n)
                 (ring-zero o (mod (output-written o) +ring-bytes+)
                            (min +period-bytes+ (- +ring-bytes+ (- (output-written o) (output-played o)))))
                 (incf at n)))
      (setf (hda-last-active c) (get-internal-real-time))
      (- end start))))

(defmethod output-close ((o hda-output))
  (let ((c (output-controller o)))
    (sb-thread:with-recursive-lock ((hda-lock c))
      (when (output-running-p o) (stop-output o))
      (setf (hda-outputs c) (remove o (hda-outputs c))))))

(defmethod device-outputs ((c hda-controller)) (hda-outputs c))

(defmethod device-volume ((c hda-controller)) (hda-volume c))

(defmethod (setf device-volume) (volume (c hda-controller))
  (sb-thread:with-recursive-lock ((hda-lock c))
    (setf (hda-volume c) (max 0.0 (min 1.0 (float volume))))
    (dolist (o (hda-outputs c))
      (when (output-running-p o) (path-volume (output-codec o) (output-path o) (hda-volume c) (hda-muted c))))
    (hda-volume c)))

(defmethod device-mute ((c hda-controller)) (hda-muted c))

(defmethod (setf device-mute) (mute (c hda-controller))
  (sb-thread:with-recursive-lock ((hda-lock c))
    (setf (hda-muted c) mute)
    (dolist (o (hda-outputs c))
      (when (output-running-p o) (path-volume (output-codec o) (output-path o) (hda-volume c) (hda-muted c))))
    mute))

(defmethod device-status ((c hda-controller))
  (list :codecs (devices:get-property c "Codecs")
        :suspended (hda-suspended c) :volume (hda-volume c) :muted (hda-muted c)
        :outputs (loop for o in (hda-outputs c)
                       collect (list :stream (output-tag o) :running (output-running-p o)
                                     :pin (and (output-path o) (list (widget-nid (first (output-path o))) (pin-device (first (output-path o)))))
                                     :written (output-written o) :played (output-played o)))))
