(defpackage #:finch/xpc
  (:use #:cl)
  (:export #:encode #:decode #:xpc-error #:dictionary #:value #:+magic+ #:+version+))
(in-package #:finch/xpc)

(define-condition xpc-error (error)
  ((text :initarg :text :reader xpc-error-text))
  (:report (lambda (c s) (write-string (xpc-error-text c) s))))

(defun bad (control &rest args)
  (error 'xpc-error :text (apply #'format nil control args)))

(defparameter +magic+ #x40585043)
(defparameter +version+ 5)

(defparameter *types*
  '((:null . #x1000) (:bool . #x2000) (:int64 . #x3000) (:uint64 . #x4000) (:double . #x5000)
    (:date . #x7000) (:data . #x8000) (:string . #x9000) (:uuid . #xa000) (:send . #xd000)
    (:array . #xe000) (:dictionary . #xf000) (:receive . #x15000)))

(defun type-code (name) (or (cdr (assoc name *types*)) (bad "no xpc type ~s" name)))
(defun type-name (code) (or (car (rassoc code *types*)) (bad "xpc type #x~x not read yet" code)))

(defun dictionary (&rest pairs)
  (cons :dictionary (loop :for (k v) :on pairs :by #'cddr :collect (cons k v))))

(defun value (dictionary key)
  (cdr (assoc key (rest dictionary) :test #'string=)))

(defstruct (reader (:constructor reader (octets))) octets (at 0))

(defun take-le (r n)
  (let ((o (reader-octets r)) (at (reader-at r)))
    (when (> (+ at n) (length o)) (bad "xpc runs out at ~d" at))
    (setf (reader-at r) (+ at n))
    (loop :for i :below n :sum (ash (aref o (+ at i)) (* 8 i)))))

(defun take-octets (r n)
  (let ((at (reader-at r)))
    (setf (reader-at r) (+ at n))
    (subseq (reader-octets r) at (+ at n))))

(defun align (r) (setf (reader-at r) (* 4 (ceiling (reader-at r) 4))))

(defun take-cstring (r)
  (let* ((o (reader-octets r))
         (end (position 0 o :start (reader-at r)))
         (s (map 'string #'code-char (subseq o (reader-at r) end))))
    (setf (reader-at r) (1+ end))
    (align r)
    s))

(defun signed (bits n) (if (logbitp (1- bits) n) (- n (ash 1 bits)) n))

(defun take-value (r rights)
  (let ((type (type-name (take-le r 4))))
    (ecase type
      (:null '(:null))
      (:bool (list :bool (plusp (take-le r 4))))
      (:int64 (list :int64 (signed 64 (take-le r 8))))
      (:uint64 (list :uint64 (take-le r 8)))
      (:double (let ((bits (take-le r 8))) (list :double (sb-kernel:make-double-float (signed 32 (ash bits -32)) (ldb (byte 32 0) bits)))))
      (:date (list :date (signed 64 (take-le r 8))))
      (:data (let ((n (take-le r 4))) (prog1 (list :data (take-octets r n)) (align r))))
      (:string (let ((n (take-le r 4)))
                 (prog1 (map 'string #'code-char (subseq (take-octets r n) 0 (1- n))) (align r))))
      (:uuid (list :uuid (take-octets r 16)))
      ((:send :receive) (list type (pop (car rights))))
      (:array (take-le r 4)
       (cons :array (loop :repeat (take-le r 4) :collect (take-value r rights))))
      (:dictionary (take-le r 4)
       (cons :dictionary (loop :repeat (take-le r 4)
                               :collect (let ((key (take-cstring r))) (cons key (take-value r rights)))))))))

(defun decode (octets &optional rights)
  (let ((r (reader (coerce octets '(simple-array (unsigned-byte 8) (*)))))
        (rights (list rights)))
    (unless (= (take-le r 4) +magic+) (bad "no CPX@"))
    (unless (= (take-le r 4) +version+) (bad "xpc version"))
    (take-value r rights)))

(defun put-le (w n v) (dotimes (i n) (vector-push-extend (ldb (byte 8 (* 8 i)) v) w)))
(defun pad (w) (loop :until (zerop (mod (fill-pointer w) 4)) :do (vector-push-extend 0 w)))
(defun put-octets (w o) (loop :for b :across o :do (vector-push-extend b w)))

(defun put-value (w v rights)
  (cond ((stringp v)
         (put-le w 4 (type-code :string)) (put-le w 4 (1+ (length v)))
         (put-octets w (map 'vector #'char-code v)) (vector-push-extend 0 w) (pad w))
        (t
         (let ((type (first v)))
           (put-le w 4 (type-code type))
           (ecase type
             (:null)
             (:bool (put-le w 4 (if (second v) 1 0)))
             ((:int64 :uint64 :date) (put-le w 8 (ldb (byte 64 0) (second v))))
             (:double (put-le w 8 (logior (ash (ldb (byte 32 0) (sb-kernel:double-float-high-bits (second v))) 32)
                                          (sb-kernel:double-float-low-bits (second v)))))
             (:data (put-le w 4 (length (second v))) (put-octets w (second v)) (pad w))
             (:uuid (put-octets w (second v)))
             ((:send :receive) (push (cons (second v) type) (car rights)))
             ((:array :dictionary)
              (let ((at (fill-pointer w)))
                (put-le w 4 0)
                (put-le w 4 (length (rest v)))
                (dolist (item (rest v))
                  (if (eq type :array)
                      (put-value w item rights)
                      (progn (put-octets w (map 'vector #'char-code (car item)))
                             (vector-push-extend 0 w) (pad w)
                             (put-value w (cdr item) rights))))
                (let ((length (- (fill-pointer w) at 4)))
                  (dotimes (i 4) (setf (aref w (+ at i)) (ldb (byte 8 (* 8 i)) length)))))))))))

(defun encode (value)
  (let ((w (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0))
        (rights (list nil)))
    (put-le w 4 +magic+)
    (put-le w 4 +version+)
    (put-value w value rights)
    (values (coerce w '(simple-array (unsigned-byte 8) (*))) (reverse (car rights)))))
