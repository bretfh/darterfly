(require :asdf)
(asdf:load-system :finch/test)
(setf finch/test::*finch-root* #p"/finch/")

(defun finch-sources ()
  (or (probe-file "/Users/finch/src/finch/finch.asd")
      (probe-file "/usr/src/finch/finch.asd")))

(defun finch-asdf ()
  (uiop:call-image-restore-hook)
  (asdf:clear-output-translations)
  (asdf:clear-source-registry)
  (let ((asd (finch-sources)))
    (when asd
      (asdf:initialize-source-registry
       `(:source-registry (:tree ,(uiop:pathname-directory-pathname asd)) :inherit-configuration))))
  (dolist (system (asdf:already-loaded-systems))
    (unless (uiop:string-prefix-p "finch" system)
      (asdf:register-immutable-system system))))

(defun finch-boot ()
  (finch/vfs:vfs-start)
  (finch/bsd::libsa-start)
  (finch/apfs:mountroot)
  (setf sb-sys::*sbcl-homedir-pathname* (sb-impl::%sbcl-homedir-pathname))
  (finch-asdf)
  (unless (finch/run:in-run-p)
    (when (ignore-errors (finch/generation:pending-build))
      (finch/generation:resume-build))
    (when (finch/iokit:boot-arg "launchd")
      (sb-thread:make-thread #'finch/kernel:launch :name "load_init_program"))))

(push 'finch-boot sb-ext:*init-hooks*)
(sb-ext:enable-debugger)
(sb-ext:save-lisp-and-die (second sb-ext:*posix-argv*))
