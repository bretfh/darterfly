(defpackage #:darterfly/storage
  (:use #:cl)
  (:export #:serve-disk #:op #:remote-vnode #:mount-remote #:start-storage-world))
(in-package #:darterfly/storage)

(defvar *volume* nil)

(defun vnode-of (id) (darterfly/apfs::wvnode *volume* id))

(defun describe-vnode (v) (list (darterfly/vfs:vnode-id v) (darterfly/vfs:vnode-type v)))

(defun attach-controller (ecam bus device function vector)
  (setf darterfly/devices::*free-vectors* (list vector)
        darterfly/devices:*registry-root* (make-instance 'darterfly/devices:entry :name "Root"))
  (let* ((bridge (make-instance 'darterfly/devices::acpi-pci :ecam ecam))
         (node (make-instance 'darterfly/devices:pci-node :bridge bridge :bus bus :device device :function function)))
    (darterfly/devices::attach node darterfly/devices:*registry-root*)
    (darterfly/devices::describe-pci-device node)
    (darterfly/devices:register-service node)))

(defun serve-disk (ecam bus device function vector)
  (attach-controller ecam bus device function vector)
  (let ((media (first (darterfly/devices:find-entries 'darterfly/apfs::apfs-volume-media))))
    (unless media (error "no APFS volume on the granted disk"))
    (setf *volume* (darterfly/apfs::make-wvolume
                    (darterfly/apfs:open-writable (lambda (at length) (darterfly/devices:media-read media at length))
                                                  (lambda (at octets) (darterfly/devices:media-write media at octets))
                                                  (lambda () (darterfly/devices:media-flush media)))))
    (darterfly/apfs::start-syncer)
    (describe-vnode (vnode-of darterfly/apfs::+root-dir-ino-num+))))

(defun op (name &rest args)
  (handler-case
      (darterfly/vfs::with-vfs
        (ecase name
          (:serve (apply #'serve-disk args))
          (:lookup (let ((v (darterfly/vfs:vnop-lookup (vnode-of (first args)) (second args)))) (and v (describe-vnode v))))
          (:readdir (mapcar (lambda (e) (cons (car e) (describe-vnode (cdr e)))) (darterfly/vfs:vnop-readdir (vnode-of (first args)))))
          (:read (darterfly/vfs:vnop-read (vnode-of (first args)) (second args) (third args)))
          (:write (darterfly/vfs:vnop-write (vnode-of (first args)) (second args) (coerce (third args) '(simple-array (unsigned-byte 8) (*)))))
          (:getattr (let ((a (darterfly/vfs:vnop-getattr (vnode-of (first args)))))
                      (list (darterfly/vfs:vattr-mode a) (darterfly/vfs:vattr-uid a) (darterfly/vfs:vattr-gid a) (darterfly/vfs:vattr-size a)
                            (darterfly/vfs:vattr-nlink a) (darterfly/vfs:vattr-mtime a) (darterfly/vfs:vattr-rdev a))))
          (:readlink (darterfly/vfs:vnop-readlink (vnode-of (first args))))
          (:create (describe-vnode (darterfly/vfs:vnop-create (vnode-of (first args)) (second args) (third args))))
          (:mkdir (describe-vnode (darterfly/vfs:vnop-mkdir (vnode-of (first args)) (second args) (third args))))
          (:symlink (describe-vnode (darterfly/vfs:vnop-symlink (vnode-of (first args)) (second args) (third args))))
          (:remove (darterfly/vfs:vnop-remove (vnode-of (first args)) (second args) (vnode-of (third args))))
          (:rmdir (darterfly/vfs:vnop-rmdir (vnode-of (first args)) (second args) (vnode-of (third args))))
          (:rename (darterfly/vfs:vnop-rename (vnode-of (first args)) (second args) (vnode-of (third args))
                                              (vnode-of (fourth args)) (fifth args)))
          (:setattr (apply #'darterfly/vfs:vnop-setattr (vnode-of (first args)) (rest args)))
          (:truncate (darterfly/vfs:vnop-truncate (vnode-of (first args)) (second args)))
          (:sync (darterfly/apfs::sync-volumes) t)))
    (darterfly/vfs:vfs-error (e) (list :error (darterfly/vfs:vfs-errno e)))))

(defclass remote-vnode (darterfly/vfs:vnode)
  ((world :initarg :world :reader remote-world)))

(defconstant +chunk+ 8192)

(defun call (world name &rest args)
  (let ((result (let ((*package* (find-package :darterfly/storage)))
                  (read-from-string
                   (darterfly/run:world-eval world (with-standard-io-syntax
                                                     (let ((*package* (find-package :cl-user)))
                                                       (prin1-to-string `(op ,name ,@(mapcar (lambda (a) `',a) args))))))))))
    (when (and (consp result) (eq (first result) :error)) (darterfly/vfs:fail (second result)))
    result))

(defun remote (world described)
  (and described (make-instance 'remote-vnode :world world :id (first described) :type (second described))))

(defmacro with-remote ((v) &body body) `(let ((world (remote-world ,v)) (id (darterfly/vfs:vnode-id ,v))) (declare (ignorable world id)) ,@body))

(defmethod darterfly/vfs:vnop-lookup ((dir remote-vnode) name) (with-remote (dir) (remote world (call world :lookup id name))))
(defmethod darterfly/vfs:vnop-readdir ((dir remote-vnode))
  (with-remote (dir) (mapcar (lambda (e) (cons (car e) (remote world (cdr e)))) (call world :readdir id))))
(defmethod darterfly/vfs:vnop-read ((v remote-vnode) offset count)
  (with-remote (v)
    (let ((out (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer t)))
      (loop :for at :from offset :below (+ offset count) :by +chunk+
            :for piece := (call world :read id at (min +chunk+ (- (+ offset count) at)))
            :do (loop :for b :across piece :do (vector-push-extend b out))
            :while (= (length piece) +chunk+))
      (coerce out '(simple-array (unsigned-byte 8) (*))))))
(defmethod darterfly/vfs:vnop-write ((v remote-vnode) offset octets)
  (with-remote (v)
    (loop :for at :from 0 :below (length octets) :by +chunk+
          :do (call world :write id (+ offset at) (coerce (subseq octets at (min (length octets) (+ at +chunk+))) 'list)))
    (length octets)))
(defmethod darterfly/vfs:vnop-getattr ((v remote-vnode))
  (with-remote (v)
    (destructuring-bind (mode uid gid size nlink mtime rdev) (call world :getattr id)
      (darterfly/vfs:make-vattr :mode mode :uid uid :gid gid :size size :nlink nlink :mtime mtime :rdev rdev))))
(defmethod darterfly/vfs:vnop-readlink ((v remote-vnode)) (with-remote (v) (call world :readlink id)))
(defmethod darterfly/vfs:vnop-create ((dir remote-vnode) name mode) (with-remote (dir) (remote world (call world :create id name mode))))
(defmethod darterfly/vfs:vnop-mkdir ((dir remote-vnode) name mode) (with-remote (dir) (remote world (call world :mkdir id name mode))))
(defmethod darterfly/vfs:vnop-symlink ((dir remote-vnode) name target) (with-remote (dir) (remote world (call world :symlink id name target))))
(defmethod darterfly/vfs:vnop-remove ((dir remote-vnode) name vnode) (with-remote (dir) (call world :remove id name (darterfly/vfs:vnode-id vnode))))
(defmethod darterfly/vfs:vnop-rmdir ((dir remote-vnode) name vnode) (with-remote (dir) (call world :rmdir id name (darterfly/vfs:vnode-id vnode))))
(defmethod darterfly/vfs:vnop-rename ((from remote-vnode) from-name vnode (to remote-vnode) to-name)
  (with-remote (from) (call world :rename id from-name (darterfly/vfs:vnode-id vnode) (darterfly/vfs:vnode-id to) to-name)))
(defmethod darterfly/vfs:vnop-setattr ((v remote-vnode) &key mode uid gid)
  (with-remote (v) (call world :setattr id :mode mode :uid uid :gid gid)))
(defmethod darterfly/vfs:vnop-truncate ((v remote-vnode) size) (with-remote (v) (call world :truncate id size)))

(defun mount-remote (world root path)
  (darterfly/vfs:vfs-mkdirs path)
  (darterfly/vfs:vfs-mount (remote world root) path))

(defun start-storage-world (node core &key (name "storage"))
  (let* ((world (darterfly/run:start-world core (darterfly/run::world-argv "(loop (sleep 60))") :cwd "/" :disk t :attach t :name name))
         (id (darterfly/run:world-id world))
         (bridge (darterfly/devices::device-bridge node))
         (ecam (darterfly/devices::bridge-ecam bridge))
         (bus (darterfly/devices::pci-bus node)) (device (darterfly/devices::pci-device node)) (function (darterfly/devices::pci-function node))
         (vector (darterfly/devices:allocate-vector)))
    (loop :repeat 300 :until (ignore-errors (darterfly/run:world-eval world "t")) :do (sleep 0.1))
    (darterfly/worlds:grant-memory id (+ ecam (ash bus 20)) (ash 1 20) :reserve)
    (darterfly/worlds:grant-memory id (+ ecam (ash bus 20) (ash device 15) (ash function 12)) 4096)
    (darterfly/worlds:grant-memory id (darterfly/devices::bar-address node 0) (darterfly/devices::bar-length node 0))
    (darterfly/worlds:grant-vectors id vector)
    (values world (call world :serve ecam bus device function vector))))
