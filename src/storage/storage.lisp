(defpackage #:darterfly/storage
  (:use #:cl)
  (:export #:serve-disk #:op #:serve-port #:remote-vnode #:mount-remote #:sync-remote #:start-storage-world #:mount-system-files))
(in-package #:darterfly/storage)

(defvar *volume* nil)

(defun vnode-of (id) (darterfly/apfs::wvnode *volume* id))

(defun describe-vnode (v) (list (darterfly/vfs:vnode-id v) (darterfly/vfs:vnode-type v)))

(defun serve-disk (ecam bus device function vector)
  (darterfly/drivers:attach-controller ecam bus device function vector)
  (let ((media (first (darterfly/devices:find-entries 'darterfly/apfs::apfs-volume-media))))
    (unless media (error "no APFS volume on the granted disk"))
    (setf *volume* (darterfly/apfs::make-wvolume
                    (darterfly/apfs:open-writable (lambda (at length) (darterfly/devices:media-read media at length))
                                                  (lambda (at octets) (darterfly/devices:media-write media at octets))
                                                  (lambda () (darterfly/devices:media-flush media)))))
    (darterfly/apfs::start-syncer)
    (describe-vnode (vnode-of darterfly/apfs::+root-dir-ino-num+))))

(defun op (name &rest args)
  (ecase name
    (:serve (apply #'serve-disk args))))

(defparameter +ops+ #(nil :lookup :readdir :read :write :getattr :readlink :create :mkdir :symlink :remove :rmdir :rename :setattr :truncate :sync :open :close))
(defparameter +types+ #(nil :vreg :vdir :vlnk :vchr))

(defun type-code (type) (or (position type +types+) 0))

(defun u64 (v at) (loop :for i :below 8 :sum (ash (aref v (+ at i)) (* 8 i))))
(defun signed (n) (if (logbitp 63 n) (- n (ash 1 64)) n))

(defun octets (&rest parts)
  (let ((out (make-array (loop :for p :in parts :sum (if (integerp p) 8 (length p))) :element-type '(unsigned-byte 8)))
        (at 0))
    (dolist (p parts out)
      (if (integerp p)
          (progn (dotimes (i 8) (setf (aref out (+ at i)) (ldb (byte 8 (* 8 i)) p))) (incf at 8))
          (progn (replace out p :start1 at) (incf at (length p)))))))

(defun utf8 (s) (sb-ext:string-to-octets s :external-format :utf-8))

(defun errno-of (code) (or (car (rassoc code darterfly/vfs::+errno+)) :eio))

(defun handle (request token &key (vnode-of #'vnode-of) (handle-of #'darterfly/vfs:vnode-id) (cross #'identity))
  (let* ((op (aref +ops+ (u64 request 0)))
         (v (funcall vnode-of (u64 request 8)))
         (a (u64 request 16)) (b (u64 request 24)) (c (u64 request 32))
         (n1 (u64 request 40)) (n2 (u64 request 48))
         (name1 (sb-ext:octets-to-string request :start 56 :end (+ 56 n1) :external-format :utf-8))
         (name2 (sb-ext:octets-to-string request :start (+ 56 n1) :end (+ 56 n1 n2) :external-format :utf-8)))
    (flet ((node (x) (if x (octets 0 (funcall handle-of x) (type-code (darterfly/vfs:vnode-type x))) (octets (- (ash 1 64) 2)))))
      (handler-case
          (darterfly/vfs::with-vfs
            (ecase op
              (:lookup (node (let ((x (darterfly/vfs:vnop-lookup v name1))) (and x (funcall cross x)))))
              (:readdir (let* ((entries (nthcdr a (darterfly/vfs:vnop-readdir v)))
                               (out (octets 0 0)) (n 0))
                          (loop :for (name . x) :in entries
                                :for bytes := (utf8 name)
                                :while (< (+ (length out) 24 (length bytes)) 60000)
                                :do (setf out (octets out (funcall handle-of x) (type-code (darterfly/vfs:vnode-type x)) (length bytes) bytes))
                                    (incf n))
                          (replace out (octets n) :start1 0)
                          out))
              (:read (let ((data (coerce (darterfly/vfs:vnop-read v a b) '(simple-array (unsigned-byte 8) (*)))))
                       (sb-sys:with-pinned-objects (data)
                         (darterfly/worlds:copy-into token c (sb-sys:sap-int (sb-sys:vector-sap data)) (length data)))
                       (octets (length data))))
              (:write (let ((data (make-array b :element-type '(unsigned-byte 8))))
                        (sb-sys:with-pinned-objects (data)
                          (darterfly/worlds:copy-from token c (sb-sys:sap-int (sb-sys:vector-sap data)) b))
                        (octets (darterfly/vfs:vnop-write v a data))))
              (:getattr (let ((x (darterfly/vfs:vnop-getattr v)))
                          (octets 0 (darterfly/vfs:vattr-mode x) (darterfly/vfs:vattr-uid x) (darterfly/vfs:vattr-gid x) (darterfly/vfs:vattr-size x)
                                  (darterfly/vfs:vattr-nlink x) (darterfly/vfs:vattr-mtime x) (darterfly/vfs:vattr-rdev x))))
              (:readlink (let ((bytes (utf8 (darterfly/vfs:vnop-readlink v)))) (octets 0 (length bytes) bytes)))
              (:create (node (darterfly/vfs:vnop-create v name1 a)))
              (:mkdir (node (darterfly/vfs:vnop-mkdir v name1 a)))
              (:symlink (node (darterfly/vfs:vnop-symlink v name1 name2)))
              (:remove (darterfly/vfs:vnop-remove v name1 (funcall vnode-of a)) (octets 0))
              (:rmdir (darterfly/vfs:vnop-rmdir v name1 (funcall vnode-of a)) (octets 0))
              (:rename (darterfly/vfs:vnop-rename v name1 (funcall vnode-of a) (funcall vnode-of b) name2) (octets 0))
              (:setattr (darterfly/vfs:vnop-setattr v :mode (and (/= a 0) a) :uid (and (/= b (1- (ash 1 64))) b) :gid (and (/= c (1- (ash 1 64))) c))
                        (octets 0))
              (:truncate (darterfly/vfs:vnop-truncate v a) (octets 0))
              (:sync (darterfly/apfs::sync-volumes) (octets 0))
              (:open (darterfly/vfs:vnop-open v) (octets 0))
              (:close (darterfly/vfs:vnop-close v) (octets 0))))
        (darterfly/vfs:vfs-error (e) (octets (- (ash 1 64) (darterfly/vfs:errno-code (darterfly/vfs:vfs-errno e)))))
        (error () (octets (- (ash 1 64) 5)))))))

(defun serve-port (name)
  (sb-thread:make-thread
   (lambda ()
     (let ((buf (make-array 65536 :element-type '(unsigned-byte 8))))
       (loop
         (multiple-value-bind (n token) (handler-case (darterfly/worlds:receive-into name buf) (darterfly/worlds:world-error () (values nil nil)))
           (when n
             (darterfly/worlds:reply token (handle (subseq buf 0 n) token)))))))
   :name "storage port")
  t)

(defclass remote-vnode (darterfly/vfs:vnode)
  ((world :initarg :world :reader remote-world)
   (port :initarg :port :reader remote-port)))

(defun call (v op &key (id (darterfly/vfs:vnode-id v)) (a 0) (b 0) (c 0) (name1 "") (name2 ""))
  (let* ((n1 (utf8 name1)) (n2 (utf8 name2))
         (reply (darterfly/worlds:call (remote-port v) (octets (position op +ops+) id a b c (length n1) (length n2) n1 n2)))
         (status (signed (u64 reply 0))))
    (when (minusp status) (darterfly/vfs:fail (errno-of (- status))))
    (values status reply)))

(defun remote-node (v reply)
  (let ((id (u64 reply 8)))
    (make-instance 'remote-vnode :world (remote-world v) :port (remote-port v) :id id :type (aref +types+ (u64 reply 16)))))

(defmethod darterfly/vfs:vnop-open ((v remote-vnode)) (call v :open) nil)
(defmethod darterfly/vfs:vnop-close ((v remote-vnode)) (call v :close) nil)

(defmethod darterfly/vfs:vnop-lookup ((dir remote-vnode) name)
  (multiple-value-bind (status reply) (handler-case (call dir :lookup :name1 name) (darterfly/vfs:vfs-error () (values -1 nil)))
    (and (>= status 0) (remote-node dir reply))))
(defmethod darterfly/vfs:vnop-readdir ((dir remote-vnode))
  (let ((entries nil) (start 0))
    (loop
      (multiple-value-bind (status reply) (call dir :readdir :a start)
        (declare (ignore status))
        (let ((n (u64 reply 0)) (at 16))
          (dotimes (i n)
            (let ((id (u64 reply at)) (type (u64 reply (+ at 8))) (len (u64 reply (+ at 16))))
              (push (cons (sb-ext:octets-to-string reply :start (+ at 24) :end (+ at 24 len) :external-format :utf-8)
                          (make-instance 'remote-vnode :world (remote-world dir) :port (remote-port dir) :id id :type (aref +types+ type)))
                    entries)
              (incf at (+ 24 len))))
          (incf start n)
          (when (zerop n) (return)))))
    (nreverse entries)))
(defmethod darterfly/vfs:vnop-read ((v remote-vnode) offset count)
  (let ((data (make-array count :element-type '(unsigned-byte 8))))
    (let ((n (sb-sys:with-pinned-objects (data)
               (call v :read :a offset :b count :c (sb-sys:sap-int (sb-sys:vector-sap data))))))
      (if (= n count) data (subseq data 0 n)))))
(defmethod darterfly/vfs:vnop-write ((v remote-vnode) offset octets)
  (let ((data (coerce octets '(simple-array (unsigned-byte 8) (*)))))
    (sb-sys:with-pinned-objects (data)
      (call v :write :a offset :b (length data) :c (sb-sys:sap-int (sb-sys:vector-sap data))))))
(defmethod darterfly/vfs:vnop-getattr ((v remote-vnode))
  (multiple-value-bind (status reply) (call v :getattr)
    (declare (ignore status))
    (darterfly/vfs:make-vattr :mode (u64 reply 8) :uid (u64 reply 16) :gid (u64 reply 24) :size (u64 reply 32)
                              :nlink (u64 reply 40) :mtime (u64 reply 48) :rdev (u64 reply 56))))
(defmethod darterfly/vfs:vnop-readlink ((v remote-vnode))
  (multiple-value-bind (status reply) (call v :readlink)
    (declare (ignore status))
    (sb-ext:octets-to-string reply :start 16 :end (+ 16 (u64 reply 8)) :external-format :utf-8)))
(defmethod darterfly/vfs:vnop-create ((dir remote-vnode) name mode) (remote-node dir (nth-value 1 (call dir :create :name1 name :a mode))))
(defmethod darterfly/vfs:vnop-mkdir ((dir remote-vnode) name mode) (remote-node dir (nth-value 1 (call dir :mkdir :name1 name :a mode))))
(defmethod darterfly/vfs:vnop-symlink ((dir remote-vnode) name target) (remote-node dir (nth-value 1 (call dir :symlink :name1 name :name2 target))))
(defmethod darterfly/vfs:vnop-remove ((dir remote-vnode) name vnode) (call dir :remove :name1 name :a (darterfly/vfs:vnode-id vnode)) 0)
(defmethod darterfly/vfs:vnop-rmdir ((dir remote-vnode) name vnode) (call dir :rmdir :name1 name :a (darterfly/vfs:vnode-id vnode)) 0)
(defmethod darterfly/vfs:vnop-rename ((from remote-vnode) from-name vnode (to remote-vnode) to-name)
  (call from :rename :name1 from-name :a (darterfly/vfs:vnode-id vnode) :b (darterfly/vfs:vnode-id to) :name2 to-name) 0)
(defmethod darterfly/vfs:vnop-setattr ((v remote-vnode) &key mode uid gid)
  (call v :setattr :a (or mode 0) :b (if (and uid (/= uid -1)) uid (1- (ash 1 64))) :c (if (and gid (/= gid -1)) gid (1- (ash 1 64)))) 0)
(defmethod darterfly/vfs:vnop-truncate ((v remote-vnode) size) (call v :truncate :a size) 0)

(defun eval-in (world form)
  (let ((*package* (find-package :darterfly/storage)))
    (read-from-string
     (darterfly/run:world-eval world (with-standard-io-syntax
                                       (let ((*package* (find-package :cl-user))) (prin1-to-string form)))))))

(defun mount-remote (world root path)
  (darterfly/vfs:vfs-mkdirs path)
  (darterfly/vfs:vfs-mount (make-instance 'remote-vnode :world world :port (getf root :port) :id (getf root :id) :type :vdir) path))

(defun sync-remote (path)
  (call (darterfly/vfs:namei path) :sync))

(defun start-storage-world (node core &key (name "storage"))
  (let* ((world (darterfly/run:start-world core (darterfly/run::world-argv "(loop (sleep 60))") :cwd "/" :disk t :attach t :name name))
         (id (darterfly/run:world-id world)))
    (darterfly/run:await-answer world)
    (destructuring-bind (&key ecam bus device function vector) (darterfly/drivers:grant-device id node)
      (multiple-value-bind (theirs ours) (darterfly/worlds:port-into id)
        (let ((root (eval-in world `(op :serve ,ecam ,bus ,device ,function ,vector))))
          (eval-in world `(serve-port ,theirs))
          (values world (list :port ours :id (first root))))))))

(defclass exported ()
  ((vnodes :initform (make-array 16 :adjustable t :fill-pointer 1) :reader exported-vnodes)
   (handles :initform (make-hash-table :test 'eq) :reader exported-handles)
   (lock :initform (sb-thread:make-mutex :name "exported files") :reader exported-lock)))

(defun handle-of (exported vnode)
  (sb-thread:with-mutex ((exported-lock exported))
    (or (gethash vnode (exported-handles exported))
        (setf (gethash vnode (exported-handles exported))
              (vector-push-extend vnode (exported-vnodes exported))))))

(defun exported-vnode (exported handle)
  (sb-thread:with-mutex ((exported-lock exported))
    (if (< 0 handle (fill-pointer (exported-vnodes exported)))
        (aref (exported-vnodes exported) handle)
        (darterfly/vfs:fail :ebadf))))

(defvar *exports* (make-hash-table))
(defvar *exports-lock* (sb-thread:make-mutex :name "exports"))

(defun exported-to (world)
  (sb-thread:with-mutex (*exports-lock*)
    (or (gethash world *exports*)
        (let ((exported (make-instance 'exported)))
          (handle-of exported (darterfly/vfs:namei "/"))
          (setf (gethash world *exports*) exported)))))

(defun serve-files (world proc request token)
  (declare (ignore proc))
  (let ((exported (exported-to world)))
    (handle request token
            :vnode-of (lambda (handle) (exported-vnode exported handle))
            :handle-of (lambda (vnode) (handle-of exported vnode))
            :cross #'darterfly/vfs::cross)))

(defun forget-exports (world)
  (sb-thread:with-mutex (*exports-lock*)
    (remhash world *exports*)))

(darterfly/run:offer-service "files" #'serve-files :gone #'forget-exports)

(defun mount-system-files ()
  (darterfly/vfs:vfs-mount (make-instance 'remote-vnode :world 0 :port (darterfly/run:look-up "files") :id 1 :type :vdir) "/")
  (darterfly/vfs:vfs-mount (darterfly/vfs::make-devfs) "/dev")
  (darterfly/vfs:vfs-mount (darterfly/vfs::make-procfs) "/proc"))
