(defpackage #:finch/boot
  (:use #:cl #:finch/low)
  (:export #:boot-image))
(in-package #:finch/boot)

(defconstant +com1+ #x3F8)
(defconstant +kernel-base+ #xFFFFFFFF80000000)
(defconstant +allocate-max-address+ 1)
(defconstant +efi-loader-data+ 2)
(defconstant +file-mode-read+ 1)
(defconstant +st-boot-services+ 96)
(defconstant +st-entries+ 104)
(defconstant +st-configuration+ 112)
(defconstant +bs-allocate-pages+ 40)
(defconstant +bs-get-memory-map+ 56)
(defconstant +bs-allocate-pool+ 64)
(defconstant +bs-handle-protocol+ 152)
(defconstant +bs-exit-boot-services+ 232)
(defconstant +bs-set-watchdog-timer+ 256)
(defconstant +bs-locate-protocol+ 320)
(defconstant +file-open+ 8)
(defconstant +file-close+ 16)
(defconstant +file-read+ 32)
(defconstant +file-get-position+ 48)
(defconstant +file-set-position+ 56)
(defconstant +acpi-guid-low+ #x11D3E4F18868E871)
(defconstant +acpi-guid-high+ #x81883CC7800022BC)
(defconstant +command-line+ 8)
(defconstant +line-length+ 1024)
(defconstant +memory-map+ 1032)
(defconstant +memory-map-size+ 1036)
(defconstant +descriptor-size+ 1040)
(defconstant +descriptor-version+ 1044)
(defconstant +video-v1+ 1048)
(defconstant +kaddr+ 1080)
(defconstant +ksize+ 1084)
(defconstant +efi-system-table+ 1104)
(defconstant +kslide+ 1108)
(defconstant +video+ 1192)
(defconstant +kernel-file-start+ 1328)
(defconstant +kernel-file-size+ 1336)
(defconstant +region-count+ 1344)
(defconstant +regions+ 1352)
(defconstant +ramdisk-start+ 1544)
(defconstant +ramdisk-size+ 1552)
(defconstant +core-start+ 1560)
(defconstant +core-size+ 1568)
(defconstant +boot-args-size+ 4096)

(define-global st :u64)
(define-global bs :u64)
(define-global guid :u64 :count 2)
(define-global key :u8 :count 64)
(define-global path :u8 :count 256)
(define-global wide-path :u16 :count 256)
(define-global kernel-pml4 :u64)

(define-low service (offset) (mem :u64 (+ bs offset)))

(define-low putc-serial ((c :u8))
  (while (= (logand (inb (+ +com1+ 5)) #x20) 0))
  (outb +com1+ c))

(define-low puts-serial (s)
  (while (mem :u8 s)
    (when (= (mem :u8 s) 10) (putc-serial 13))
    (putc-serial (mem :u8 s))
    (incf s)))

(define-low hex-digit (d) (if (< d 10) (+ 48 d) (+ 87 d)))

(define-low put-hex (v)
  (let ((shift 60))
    (putc-serial 48)
    (putc-serial 120)
    (while (and (> shift 0) (= (logand (shr v shift) 15) 0)) (decf shift 4))
    (while 1
      (putc-serial (hex-digit (logand (shr v shift) 15)))
      (when (= shift 0) (result 0))
      (decf shift 4))))

(define-low put-dec (v)
  (when (>= v 10) (put-dec (truncate v 10)))
  (putc-serial (+ 48 (rem v 10))))

(define-low fail (what status)
  (puts-serial "boot.efi: ")
  (puts-serial what)
  (puts-serial " failed: ")
  (put-hex status)
  (puts-serial "
")
  (while 1 (hlt)))

(define-low efi-error (status) (logand status (ash 1 63)))

(define-low allocate-low (size)
  (let ((address #xFFFFFFFF)
        (status 0))
    (setf status (efi-call (service +bs-allocate-pages+) +allocate-max-address+ +efi-loader-data+
                           (truncate (+ size 4095) 4096) (address address)))
    (when (efi-error status) (fail "AllocatePages" status))
    (rep-stosb address 0 size)
    address))

(define-low set-guid (low high)
  (setf (ref guid 0) low)
  (setf (ref guid 1) high)
  (address guid))

(define-low volume (image)
  (let ((loaded 0) (fs 0) (root 0) (status 0))
    (setf status (efi-call (service +bs-handle-protocol+) image
                           (set-guid #x11D295625B1B31A1 #x3B7269C9A0003F8E) (address loaded)))
    (when (efi-error status) (fail "LoadedImage" status))
    (setf status (efi-call (service +bs-handle-protocol+) (mem :u64 (+ loaded 24))
                           (set-guid #x11D26459964E5B22 #x3B7269C9A000398E) (address fs)))
    (when (efi-error status) (fail "SimpleFileSystem" status))
    (setf status (efi-call (mem :u64 (+ fs 8)) fs (address root)))
    (when (efi-error status) (fail "OpenVolume" status))
    root))

(define-low read-file (root name size-out)
  (let ((file 0) (end 0) (buffer 0) (status 0))
    (when (efi-error (efi-call (mem :u64 (+ root +file-open+)) root (address file) name +file-mode-read+ 0))
      (result 0))
    (efi-call (mem :u64 (+ file +file-set-position+)) file #xFFFFFFFFFFFFFFFF)
    (efi-call (mem :u64 (+ file +file-get-position+)) file (address end))
    (efi-call (mem :u64 (+ file +file-set-position+)) file 0)
    (setf (mem :u64 size-out) end)
    (setf status (efi-call (service +bs-allocate-pool+) +efi-loader-data+ (+ end 1) (address buffer)))
    (when (efi-error status) (fail "AllocatePool" status))
    (setf status (efi-call (mem :u64 (+ file +file-read+)) file size-out buffer))
    (when (efi-error status) (fail "Read" status))
    (setf (mem :u8 (+ buffer (mem :u64 size-out))) 0)
    (efi-call (mem :u64 (+ file +file-close+)) file)
    buffer))

(define-low find (hay needle)
  (while (mem :u8 hay)
    (let ((h hay) (n needle))
      (while (and (mem :u8 n) (= (mem :u8 h) (mem :u8 n)))
        (incf h)
        (incf n))
      (unless (mem :u8 n) (result hay)))
    (incf hay))
  0)

(define-low plist-string (plist key out max)
  (let ((at 0) (i 0))
    (unless plist (result 0))
    (setf at (find plist key))
    (unless at (result 0))
    (setf at (find at "<string>"))
    (unless at (result 0))
    (incf at 8)
    (while (and (< i (- max 1)) (mem :u8 at) (/= (mem :u8 at) 60))
      (setf (mem :u8 (+ out i)) (mem :u8 at))
      (incf at)
      (incf i))
    (setf (mem :u8 (+ out i)) 0)
    1))

(define-low read-path (root name size-out)
  (let ((i 0))
    (while (and (mem :u8 (+ name i)) (< i 255))
      (setf (ref wide-path i) (if (= (mem :u8 (+ name i)) 47) 92 (mem :u8 (+ name i))))
      (incf i))
    (setf (ref wide-path i) 0)
    (read-file root (address wide-path) size-out)))

(define-low loaded (name n)
  (puts-serial "boot.efi: ")
  (puts-serial name)
  (puts-serial " ")
  (put-dec n)
  (puts-serial " bytes
"))

(define-low append-string (to at s)
  (while (mem :u8 s)
    (setf (mem :u8 (+ to at)) (mem :u8 s))
    (incf at)
    (incf s))
  (setf (mem :u8 (+ to at)) 0)
  at)

(define-low boot-file (root plist name start-out size-out)
  (let ((n 0) (data 0) (k 0))
    (setf k (append-string (address key) 0 "<key>"))
    (setf k (append-string (address key) k name))
    (append-string (address key) k "</key>")
    (unless (plist-string plist (address key) (address path) 256) (result 0))
    (setf data (read-path root (address path) (address n)))
    (unless data (fail name 0))
    (setf (mem :u64 start-out) data)
    (setf (mem :u64 size-out) n)
    (loaded name n)))

(define-low kernel-flags (root args)
  (let ((size 0) (plist 0))
    (setf plist (read-file root (wide "\\Library\\Preferences\\SystemConfiguration\\com.apple.Boot.plist") (address size)))
    (plist-string plist "<key>Kernel Flags</key>" (+ args +command-line+) +line-length+)
    (boot-file root plist "RAMDisk" (+ args +ramdisk-start+) (+ args +ramdisk-size+))
    plist))

(define-low table ()
  (allocate-low 4096))

(define-low map-kernel (va pa size)
  (let ((off 0))
    (while (< off size)
      (let ((v (+ va off)) (tbl kernel-pml4) (shift 39))
        (while (> shift 12)
          (let ((e (+ tbl (* 8 (logand (shr v shift) 511)))))
            (unless (logand (mem :u64 e) 1)
              (setf (mem :u64 e) (logior (table) 3)))
            (setf tbl (logand (mem :u64 e) #x000FFFFFFFFFF000)))
          (decf shift 9))
        (setf (mem :u64 (+ tbl (* 8 (logand (shr v 12) 511)))) (logior (+ pa off) 3)))
      (incf off 4096))))

(define-low page-tables ()
  (let ((pdpt (table)) (g 0))
    (setf kernel-pml4 (table))
    (setf (mem :u64 kernel-pml4) (logior pdpt 3))
    (while (< g 64)
      (let ((pd (table)) (i 0))
        (while (< i 512)
          (setf (mem :u64 (+ pd (* 8 i))) (logior (shl g 30) (shl i 21) #x83))
          (incf i))
        (setf (mem :u64 (+ pdpt (* 8 g))) (logior pd 3)))
      (incf g))))

(define-low elf-p (image size)
  (and image (>= size 64) (= (mem :u8 image) #x7F) (= (mem :u8 (+ image 1)) 69)
       (= (mem :u16 (+ image 18)) 62)))

(define-low segment-type (ph i) (mem :u32 (+ ph (* i 56))))
(define-low segment-vaddr (ph i) (mem :u64 (+ ph (* i 56) 16)))
(define-low segment-memsz (ph i) (mem :u64 (+ ph (* i 56) 40)))

(define-low load-kernel (image size args)
  (let ((ph (+ image (mem :u64 (+ image 32))))
        (phnum (mem :u16 (+ image 56)))
        (n 0)
        (i 0))
    (page-tables)
    (while (< i phnum)
      (if (/= (segment-type ph i) 1)
          (incf i)
          (let ((start (logand (segment-vaddr ph i) (lognot 4095)))
                (end (+ (segment-vaddr ph i) (segment-memsz ph i)))
                (j (+ i 1))
                (scanning 1)
                (base 0)
                (k 0))
            (while (and scanning (< j phnum))
              (cond ((/= (segment-type ph j) 1) (incf j))
                    ((> (- (segment-vaddr ph j) end) (ash 1 30)) (setf scanning 0))
                    (t (setf end (+ (segment-vaddr ph j) (segment-memsz ph j)))
                       (incf j))))
            (setf end (logand (+ end 4095) (lognot 4095)))
            (setf base (allocate-low (- end start)))
            (setf k i)
            (while (< k j)
              (when (= (segment-type ph k) 1)
                (rep-movsb (+ base (- (segment-vaddr ph k) start))
                           (+ image (mem :u64 (+ ph (* k 56) 8)))
                           (mem :u64 (+ ph (* k 56) 32))))
              (incf k))
            (map-kernel start base (- end start))
            (when (= n 8) (fail "too many kernel regions" 0))
            (setf (mem :u64 (+ args +regions+ (* 24 n))) start)
            (setf (mem :u64 (+ args +regions+ (* 24 n) 8)) base)
            (setf (mem :u64 (+ args +regions+ (* 24 n) 16)) (- end start))
            (when (= start +kernel-base+)
              (setf (mem :u32 (+ args +kaddr+)) base)
              (setf (mem :u32 (+ args +ksize+)) (- end start)))
            (incf n)
            (setf i j))))
    (setf (mem :u32 (+ args +region-count+)) n)
    (setf (mem :u32 (+ args +kslide+)) 0)
    (setf (mem :u64 (+ args +kernel-file-start+)) image)
    (setf (mem :u64 (+ args +kernel-file-size+)) size)
    (mem :u64 (+ image 24))))

(define-low video (args)
  (let ((gop 0) (mode 0) (info 0))
    (when (efi-error (efi-call (service +bs-locate-protocol+)
                               (set-guid #x4A3823DC9042A9DE #x6A5180D0DE7AFB96) 0 (address gop)))
      (result 0))
    (setf mode (mem :u64 (+ gop 24)))
    (setf info (mem :u64 (+ mode 8)))
    (setf (mem :u32 (+ args +video+)) 1)
    (setf (mem :u32 (+ args +video+ 4)) (* (mem :u32 (+ info 32)) 4))
    (setf (mem :u32 (+ args +video+ 8)) (mem :u32 (+ info 4)))
    (setf (mem :u32 (+ args +video+ 12)) (mem :u32 (+ info 8)))
    (setf (mem :u32 (+ args +video+ 16)) 32)
    (setf (mem :u64 (+ args +video+ 48)) (mem :u64 (+ mode 24)))
    (setf (mem :u32 (+ args +video-v1+)) (mem :u64 (+ mode 24)))
    (setf (mem :u32 (+ args +video-v1+ 4)) 1)
    (setf (mem :u32 (+ args +video-v1+ 8)) (mem :u32 (+ args +video+ 4)))
    (setf (mem :u32 (+ args +video-v1+ 12)) (mem :u32 (+ args +video+ 8)))
    (setf (mem :u32 (+ args +video-v1+ 16)) (mem :u32 (+ args +video+ 12)))
    (setf (mem :u32 (+ args +video-v1+ 20)) 32)))

(define-low rsdp ()
  (let ((n (mem :u64 (+ st +st-entries+)))
        (ct (mem :u64 (+ st +st-configuration+)))
        (i 0))
    (while (< i n)
      (let ((e (+ ct (* i 24))))
        (when (and (= (mem :u64 e) +acpi-guid-low+) (= (mem :u64 (+ e 8)) +acpi-guid-high+))
          (result (mem :u64 (+ e 16)))))
      (incf i))
    0))

(define-low generation-path (name tail)
  (let ((at (append-string (address path) 0 "/EFI/finch/")))
    (setf at (append-string (address path) at name))
    (append-string (address path) at tail)
    (address path)))

(define-low try-generation (root link args)
  (let ((n 0) (name 0) (len 0) (kernel 0) (ksize 0) (core 0) (csize 0))
    (setf name (read-path root link (address n)))
    (unless name (result 0))
    (while (and (< len 64) (> (mem :u8 (+ name len)) 32)) (incf len))
    (setf (mem :u8 (+ name len)) 0)
    (puts-serial "boot.efi: generation ")
    (puts-serial name)
    (setf kernel (read-path root (generation-path name "/kernel") (address ksize)))
    (when (elf-p kernel ksize)
      (setf core (read-path root (generation-path name "/finch.core") (address csize))))
    (unless core
      (puts-serial " will not boot
")
      (result 0))
    (puts-serial "
")
    (setf (mem :u64 (+ args +core-start+)) core)
    (setf (mem :u64 (+ args +core-size+)) csize)
    (loaded "Core" csize)
    (load-kernel kernel ksize args)))

(define-efi-entry efi-main (image system-table)
  (let ((args 0) (root 0) (plist 0) (entry 0) (size 0) (key-out 0)
        (descriptor-size 0) (descriptor-version 0) (map 0) (capacity 0) (status 0) (tries 0))
    (setf st system-table)
    (setf bs (mem :u64 (+ st +st-boot-services+)))
    (efi-call (service +bs-set-watchdog-timer+) 0 0 0 0)
    (puts-serial "
finch boot.efi
")
    (setf args (allocate-low +boot-args-size+))
    (setf (mem :u16 args) 1)
    (setf (mem :u16 (+ args 2)) 2)
    (setf (mem :u8 (+ args 4)) 64)
    (setf (mem :u32 (+ args +efi-system-table+)) st)
    (setf root (volume image))
    (setf plist (kernel-flags root args))
    (setf entry (try-generation root "/EFI/finch/current" args))
    (unless entry (setf entry (try-generation root "/EFI/finch/previous" args)))
    (unless entry
      (let ((ksize 0) (kernel 0))
        (setf kernel (read-path root "/System/Library/Kernels/kernel" (address ksize)))
        (unless (elf-p kernel ksize) (fail "kernel is not x86_64 ELF" 0))
        (boot-file root plist "Core" (+ args +core-start+) (+ args +core-size+))
        (setf entry (load-kernel kernel ksize args))))
    (video args)
    (puts-serial "boot.efi: kernel ")
    (put-hex (mem :u32 (+ args +kaddr+)))
    (puts-serial " size ")
    (put-dec (mem :u32 (+ args +ksize+)))
    (puts-serial " entry ")
    (put-hex entry)
    (puts-serial "
boot.efi: video ")
    (put-dec (mem :u32 (+ args +video+ 8)))
    (puts-serial "x")
    (put-dec (mem :u32 (+ args +video+ 12)))
    (puts-serial " at ")
    (put-hex (mem :u64 (+ args +video+ 48)))
    (puts-serial "
boot.efi: rsdp ")
    (put-hex (rsdp))
    (puts-serial "
boot.efi: boot-args \"")
    (puts-serial (+ args +command-line+))
    (puts-serial "\"
")
    (efi-call (service +bs-get-memory-map+) (address size) 0 (address key-out) (address descriptor-size)
              (address descriptor-version))
    (setf capacity (+ size (* 16 descriptor-size)))
    (setf map (allocate-low capacity))
    (while 1
      (setf size capacity)
      (setf status (efi-call (service +bs-get-memory-map+) (address size) map (address key-out)
                             (address descriptor-size) (address descriptor-version)))
      (when (efi-error status) (fail "GetMemoryMap" status))
      (setf status (efi-call (service +bs-exit-boot-services+) image key-out))
      (unless (efi-error status)
        (enter-kernel args entry map size descriptor-size descriptor-version))
      (when (= tries 3) (fail "ExitBootServices" status))
      (incf tries))))

(define-low enter-kernel (args entry map size descriptor-size descriptor-version)
  (setf (mem :u32 (+ args +memory-map+)) map)
  (setf (mem :u32 (+ args +memory-map-size+)) size)
  (setf (mem :u32 (+ args +descriptor-size+)) descriptor-size)
  (setf (mem :u32 (+ args +descriptor-version+)) descriptor-version)
  (cli)
  (set-cr 3 kernel-pml4)
  (call-pointer entry args))

(defun boot-image ()
  (package-image "FINCH/BOOT" "efi_main"))
