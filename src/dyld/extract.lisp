(in-package #:finch/dyld)

(defconstant +page+ 4096)
(defconstant +dylib-in-cache+ #x80000000)

(defun align (n) (* +page+ (ceiling n +page+)))

(defun put-le (o at count n)
  (dotimes (i count) (setf (aref o (+ at i)) (ldb (byte 8 (* 8 i)) n))))

(defstruct slide address size info)

(defun slides (cache)
  (loop :for file :in (cache-files cache)
        :for h := (header file)
        :nconc (loop :for i :below (le h 316 4)
                     :for e := (read-at (file-path file) (+ (le h 312 4) (* 56 i)) 56)
                     :for size := (le e 32 8)
                     :when (plusp size)
                       :collect (let ((info (read-at (file-path file) (le e 24 8) size)))
                                  (unless (= 2 (le info 0 4))
                                    (bad "slide info version ~d" (le info 0 4)))
                                  (make-slide :address (le e 0 8) :size (le e 8 8) :info info)))))

(defun rebase-page (info page)
  (let* ((mask (le info 24 8))
         (add (le info 32 8))
         (shift (- (loop :for i :from 0 :until (logbitp i mask) :finally (return i)) 2)))
    (lambda (start)
      (loop :with at := (* 4 start)
            :for raw := (le page at 8)
            :for delta := (ash (logand raw mask) (- shift))
            :for value := (logandc2 raw mask)
            :do (put-le page at 8 (if (zerop value) 0 (+ value add)))
                (if (zerop delta) (return) (incf at delta))))))

(defun rebase (slides address page)
  (let ((s (find-if (lambda (s) (<= (slide-address s) address (+ (slide-address s) (slide-size s) -1)))
                    slides)))
    (when s
      (let* ((info (slide-info s))
             (index (floor (- address (slide-address s)) (le info 4 4)))
             (start (le info (+ (le info 8 4) (* 2 index)) 2))
             (walk (rebase-page info page)))
        (cond ((logtest start #x4000))
              ((logtest start #x8000)
               (loop :for j :from (logand start #x3fff)
                     :for extra := (le info (+ (le info 16 4) (* 2 j)) 2)
                     :do (funcall walk (logand extra #x3fff))
                     :until (logtest extra #x8000)))
              (t (funcall walk start)))))))

(defun segment-octets (cache slides address size)
  (let* ((low (* +page+ (floor address +page+)))
         (high (align (+ address size)))
         (out (make-array (- high low) :element-type '(unsigned-byte 8))))
    (loop :for page :from low :below high :by +page+
          :for bytes := (cache-read cache page +page+)
          :do (rebase slides page bytes)
              (replace out bytes :start1 (- page low)))
    (subseq out (- address low) (+ (- address low) size))))

(defun linkedit-reader (cache image)
  (let ((le (find "__LINKEDIT" (finch/macho:segments image)
                  :key #'finch/macho:segment-name :test #'string=)))
    (lambda (offset count)
      (if (zerop count)
          (make-array 0 :element-type '(unsigned-byte 8))
          (cache-read cache (+ (finch/macho:segment-vmaddr le)
                               (- offset (finch/macho:segment-fileoff le)))
                      count)))))

(defun grow (buffer octets)
  (prog1 (fill-pointer buffer)
    (loop :for b :across octets :do (vector-push-extend b buffer))
    (loop :until (zerop (mod (fill-pointer buffer) 8)) :do (vector-push-extend 0 buffer))))

(defun symbol-table (read symoff nsyms stroff)
  (let* ((nlists (funcall read symoff (* 16 nsyms)))
         (strx (loop :for i :below nsyms :collect (le nlists (* 16 i) 4)))
         (low (reduce #'min strx :initial-value most-positive-fixnum))
         (high (reduce #'max strx :initial-value 0))
         (strings (if (plusp nsyms) (funcall read (+ stroff low) (+ (- high low) 1024)) #()))
         (table (make-array 1 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 1
                              :initial-element 0)))
    (loop :for i :below nsyms
          :for x :in strx
          :for at := (- x low)
          :for end := (or (position 0 strings :start at)
                          (bad "symbol ~d runs past the strings read" i))
          :do (put-le nlists (* 16 i) 4 (fill-pointer table))
              (loop :for j :from at :below end :do (vector-push-extend (aref strings j) table))
              (vector-push-extend 0 table))
    (values nlists table)))

(defun extract-image (cache image destination)
  (let* ((image (if (stringp image) (find-image cache image) image))
         (address (image-address image))
         (head (cache-read cache address 32))
         (o (cache-read cache address (+ 32 (le head 20 4))))
         (m (finch/macho:read-macho o))
         (slides (slides cache))
         (read (linkedit-reader cache m))
         (linkedit (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0))
         (pieces '())
         (cursor 0))
    (put-le o 24 4 (logandc2 (le o 24 4) +dylib-in-cache+))
    (dolist (s (finch/macho:segments m))
      (unless (string= "__LINKEDIT" (finch/macho:segment-name s))
        (let* ((at (finch/macho:command-offset s))
               (off (if (zerop cursor) 0 (align cursor)))
               (bytes (segment-octets cache slides (finch/macho:segment-vmaddr s)
                                      (finch/macho:segment-filesize s))))
          (put-le o (+ at 40) 8 off)
          (loop :for i :below (le o (+ at 64) 4)
                :for sect := (+ at 72 (* 80 i))
                :unless (zerop (le o (+ sect 48) 4))
                  :do (put-le o (+ sect 48) 4
                              (+ off (- (le o (+ sect 32) 8) (finch/macho:segment-vmaddr s)))))
          (push (cons off bytes) pieces)
          (setf cursor (+ off (length bytes))))))
    (let ((base (align cursor)))
      (flet ((moved (offset size)
               (if (zerop size) 0 (+ base (grow linkedit (funcall read offset size))))))
        (dolist (c (finch/macho:image-commands m))
          (let ((at (finch/macho:command-offset c)))
            (case (finch/macho:command-kind c)
              (:lc-symtab
               (multiple-value-bind (nlists strings)
                   (symbol-table read (le o (+ at 8) 4) (le o (+ at 12) 4) (le o (+ at 16) 4))
                 (put-le o (+ at 8) 4 (+ base (grow linkedit nlists)))
                 (put-le o (+ at 16) 4 (+ base (grow linkedit strings)))
                 (put-le o (+ at 20) 4 (length strings))))
              (:lc-dysymtab
               (put-le o (+ at 56) 4 (moved (le o (+ at 56) 4) (* 4 (le o (+ at 60) 4))))
               (loop :for f :in '(32 40 48 64 72) :do (put-le o (+ at f) 8 0)))
              ((:lc-dyld-info :lc-dyld-info-only)
               (put-le o (+ at 40) 4 (moved (le o (+ at 40) 4) (le o (+ at 44) 4)))
               (loop :for f :in '(8 16 24 32) :do (put-le o (+ at f) 8 0)))
              ((:lc-function-starts :lc-data-in-code :lc-dyld-exports-trie)
               (put-le o (+ at 8) 4 (moved (le o (+ at 8) 4) (le o (+ at 12) 4))))
              ((:lc-code-signature :lc-segment-split-info :lc-dylib-code-sign-drs
                :lc-linker-optimization-hint :lc-dyld-chained-fixups)
               (put-le o (+ at 8) 8 0)))))
        (dolist (s (finch/macho:segments m))
          (when (string= "__LINKEDIT" (finch/macho:segment-name s))
            (let ((at (finch/macho:command-offset s)))
              (put-le o (+ at 32) 8 (align (length linkedit)))
              (put-le o (+ at 40) 8 base)
              (put-le o (+ at 48) 8 (length linkedit)))))
        (push (cons base linkedit) pieces)))
    (with-open-file (out destination :direction :output :element-type '(unsigned-byte 8)
                                     :if-exists :supersede)
      (dolist (p (reverse pieces))
        (file-position out (car p))
        (write-sequence (cdr p) out))
      (file-position out 0)
      (write-sequence o out))
    (probe-file destination)))
