(in-package #:darterfly/kit)

(export '(checkbox checked-p slider slider-value slider-minimum slider-maximum
          entry-field entry-error popup-button choices selected-value))

(defun control-ring-p (control)
  (let ((window (window-of control)))
    (and (button-enabled control) (focused-p control)
         (or (null window) (not (typep (frame-view window) 'theme-frame))
             (frame-active (frame-view window))))))

(defun control-face (control bitmap &key inset invalid)
  (let* ((w (view-width control)) (h (view-height control))
         (enabled (button-enabled control))
         (edge (theme-color (if enabled :edge :disabled-ink))))
    (when (control-ring-p control) (focus-outline bitmap (+ w 8) (+ h 8) 5))
    (when (and enabled (button-hovered control)) (setf edge (theme-color :hover-edge)))
    (when invalid (setf edge (theme-color :danger-top)))
    (apply #'text:fill-round-rect bitmap 4 4 w h 5 (coerce edge 'list))
    (cond ((not enabled)
           (apply #'text:fill-round-rect bitmap 5 5 (- w 2) (- h 2) 4 (coerce (theme-color :disabled) 'list)))
          (inset (text:fill-round-rect bitmap 5 5 (- w 2) (- h 2) 4 .976 .976 .969))
          (t (rounded-gradient bitmap 5 5 (- w 2) (- h 2) 4
                               (theme-color (if (button-armed control) :button-bottom :button-top))
                               (theme-color (if (button-armed control) :button-top :button-bottom)))))))

(defun control-stroke (bitmap x0 y0 x1 y1 color)
  (let ((steps (max 1 (abs (- x1 x0)) (abs (- y1 y0)))))
    (dotimes (i (1+ steps))
      (apply #'text:fill-rect bitmap (round (+ x0 (* (- x1 x0) (/ i steps))))
             (round (+ y0 (* (- y1 y0) (/ i steps)))) 1 1 (coerce color 'list)))))

(defclass checkbox (button)
  ((checked :initarg :checked :initform nil :accessor checked-p)))

(defmethod (setf checked-p) :after (value (control checkbox))
  (declare (ignore value)) (needs-display control))

(defmethod activate ((control checkbox))
  (setf (button-armed control) nil)
  (when (button-enabled control)
    (setf (checked-p control) (not (checked-p control)))
    (when (action control) (funcall (action control) control))))

(defmethod draw ((control checkbox) bitmap)
  (let* ((enabled (button-enabled control)) (checked (checked-p control))
         (edge (theme-color (if enabled :edge :disabled-ink)))
         (y (+ 4 (floor (- (view-height control) 15) 2))))
    (when (control-ring-p control)
      (let ((ring (text:make-bitmap 23 23)))
        (focus-outline ring 23 23 3)
        (draw-rgba bitmap (text:bitmap-pixels ring) 23 23 0 (- y 4))))
    (when (and enabled (button-hovered control)) (setf edge (theme-color :hover-edge)))
    (apply #'text:fill-round-rect bitmap 4 y 15 15 3 (coerce edge 'list))
    (let ((face (cond ((not enabled) (theme-color :disabled))
                      (checked (if (and (button-armed control) (button-hovered control))
                                   (theme-color :accent-pressed) (theme-color :accent)))
                      (t (theme-color (if (button-armed control) :button-bottom :button-top))))))
      (apply #'text:fill-round-rect bitmap 5 (1+ y) 13 13 2 (coerce face 'list)))
    (when checked
      (let ((ink (theme-color (if enabled :light-ink :disabled-ink))))
        (control-stroke bitmap 7 (+ y 7) 10 (+ y 10) ink)
        (control-stroke bitmap 10 (+ y 10) 16 (+ y 4) ink)
        (control-stroke bitmap 7 (+ y 8) 10 (+ y 11) ink)
        (control-stroke bitmap 10 (+ y 11) 16 (+ y 5) ink)))
    (let ((ink (theme-color (if enabled :ink :disabled-ink))))
      (text:draw-string bitmap (ui-font) (title control) 27 (+ 4 17)
                        (aref ink 0) (aref ink 1) (aref ink 2)))))

(defclass slider (button)
  ((value :initarg :value :initform 50 :accessor slider-value)
   (minimum :initarg :minimum :initform 0 :reader slider-minimum)
   (maximum :initarg :maximum :initform 100 :reader slider-maximum)
   (step :initarg :step :initform 1 :reader slider-step)
   (origin :initform 0 :accessor slider-origin)))

(defmethod initialize-instance :after ((control slider) &key)
  (unless (and (< (slider-minimum control) (slider-maximum control)) (plusp (slider-step control)))
    (error "A slider needs an increasing range and a positive step."))
  (setf (slider-value control) (slider-value control)))

(defmethod (setf slider-value) :around (value (control slider))
  (call-next-method (max (slider-minimum control) (min (slider-maximum control) value)) control))
(defmethod (setf slider-value) :after (value (control slider))
  (declare (ignore value)) (needs-display control))

(defun slide-to (control value)
  (let ((old (slider-value control)))
    (setf (slider-value control)
          (+ (slider-minimum control)
             (* (slider-step control) (round (- value (slider-minimum control)) (slider-step control)))))
    (unless (= old (slider-value control))
      (when (action control) (funcall (action control) control)))))

(defun slide-pointer (control x)
  (slide-to control (+ (slider-minimum control)
                      (* (/ (- x 8) (max 1 (- (view-width control) 16)))
                         (- (slider-maximum control) (slider-minimum control))))))

(defmethod draw ((control slider) bitmap)
  (let* ((enabled (button-enabled control)) (cy (+ 4 (floor (view-height control) 2)))
         (width (- (view-width control) 16))
         (cx (+ 12 (round (* width (/ (- (slider-value control) (slider-minimum control))
                                      (- (slider-maximum control) (slider-minimum control))))))))
    (apply #'text:fill-round-rect bitmap 12 (- cy 2) width 5 2 (coerce (theme-color :edge) 'list))
    (apply #'text:fill-round-rect bitmap 13 (1- cy) (- width 2) 3 1 (coerce (theme-color :track) 'list))
    (when enabled (apply #'text:fill-round-rect bitmap 12 (1- cy) (max 1 (- cx 12)) 3 1 (coerce (theme-color :accent) 'list)))
    (when (control-ring-p control)
      (let ((ring (text:make-bitmap 23 23)))
        (focus-outline ring 23 23 7)
        (draw-rgba bitmap (text:bitmap-pixels ring) 23 23 (- cx 11) (- cy 11))))
    (when enabled (text:fill-ellipse bitmap cx (1+ cy) 8 8 .20 .17 .14 .18))
    (let ((edge (theme-color (if enabled :edge :disabled-ink))))
      (text:fill-ellipse bitmap cx cy 7.5 7.5 (aref edge 0) (aref edge 1) (aref edge 2)))
    (let ((face (theme-color (cond ((not enabled) :disabled)
                                  ((button-armed control) :button-bottom)
                                  (t :button-top)))))
      (text:fill-ellipse bitmap cx cy 6.5 6.5 (aref face 0) (aref face 1) (aref face 2)))))

(defmethod mouse-down ((control slider) x y)
  (declare (ignore y))
  (when (button-enabled control)
    (setf (slider-origin control) (slider-value control) (button-armed control) t)
    (slide-pointer control x))
  t)
(defmethod mouse-moved ((control slider) x y)
  (call-next-method)
  (when (and (button-enabled control) (button-armed control)) (slide-pointer control x)))
(defmethod mouse-up ((control slider) x y)
  (declare (ignore y))
  (when (and (button-enabled control) (button-armed control)) (slide-pointer control x))
  (setf (button-armed control) nil) (needs-display control))
(defmethod cancel-pointer ((control slider))
  (when (button-armed control) (slide-to control (slider-origin control)))
  (call-next-method))
(defmethod key-down ((control slider) characters keycode)
  (declare (ignore characters))
  (when (button-enabled control)
    (let ((step (* (slider-step control) (if (member :shift *key-modifiers*) 10 1))))
      (case keycode
        (1 (cancel-pointer control))
        ((105 108) (slide-to control (- (slider-value control) step)))
        ((106 103) (slide-to control (+ (slider-value control) step)))
        (102 (slide-to control (slider-minimum control)))
        (107 (slide-to control (slider-maximum control)))))))

;; A single-line editor. Labels remain text-field; editing is an explicit class.

(defclass entry-field (text-field button)
  ((caret :initform 0 :accessor entry-caret)
   (anchor :initform 0 :accessor entry-anchor)
   (offset :initform 0 :accessor entry-offset)
   (undo :initform nil :accessor entry-undo)
   (redo :initform nil :accessor entry-redo)
   (validator :initarg :validator :initform nil :reader entry-validator)
   (error :initform nil :accessor entry-error)
   (limit :initarg :limit :initform 4096 :reader entry-limit)))

(defmethod initialize-instance :after ((control entry-field) &key)
  (setf (entry-caret control) (length (string-value control))
        (entry-anchor control) (entry-caret control)))

(defmethod (setf string-value) :after (value (control entry-field))
  (setf (entry-caret control) (min (length value) (entry-caret control))
        (entry-anchor control) (min (length value) (entry-anchor control))))

(defun entry-selection (control)
  (values (min (entry-caret control) (entry-anchor control))
          (max (entry-caret control) (entry-anchor control))))

(defun entry-state (control) (list (string-value control) (entry-caret control) (entry-anchor control)))
(defun entry-restore (control state)
  (setf (string-value control) (first state) (entry-caret control) (second state)
        (entry-anchor control) (third state) (entry-error control) nil)
  (needs-display control))

(defun entry-replace (control inserted &optional start end)
  (multiple-value-bind (lo hi) (entry-selection control)
    (let* ((lo (or start lo)) (hi (or end hi))
           (inserted (substitute #\Space #\Newline (substitute #\Space #\Return inserted)))
           (next (concatenate 'string (subseq (string-value control) 0 lo) inserted
                              (subseq (string-value control) hi))))
      (when (and (<= (length next) (entry-limit control)) (not (string= next (string-value control))))
        (push (entry-state control) (entry-undo control))
        (when (> (length (entry-undo control)) 50) (setf (cdr (nthcdr 49 (entry-undo control))) nil))
        (setf (entry-redo control) nil (string-value control) next
              (entry-caret control) (+ lo (length inserted)) (entry-anchor control) (entry-caret control)
              (entry-error control) nil)
        (needs-display control)))))

(defun entry-position (control x)
  (let* ((font (ui-font)) (string (string-value control)) (at (+ (- x 8) (entry-offset control))))
    (loop for i below (length string)
          for left = (text:string-width font (subseq string 0 i))
          for right = (text:string-width font (subseq string 0 (1+ i)))
          when (< at (/ (+ left right) 2)) return i
          finally (return (length string)))))

(defmethod draw ((control entry-field) bitmap)
  (control-face control bitmap :inset t :invalid (entry-error control))
  (let* ((string (string-value control)) (font (ui-font)) (w (- (view-width control) 16))
         (h (- (view-height control) 4)) (text (text:make-bitmap (max 1 w) (max 1 h)))
         (caret (ceiling (text:string-width font (subseq string 0 (min (length string) (entry-caret control))))))
         (window (window-of control))
         (editing (and (button-enabled control) window (eq control (first-responder window))
                       (or (not (typep (frame-view window) 'theme-frame)) (frame-active (frame-view window)))))
         (ink (theme-color (if (button-enabled control) :ink :disabled-ink))))
    (setf (entry-offset control)
          (max 0 (min (entry-offset control) caret
                      (- (ceiling (text:string-width font string)) w -2))))
    (when (> (- caret (entry-offset control)) (- w 2))
      (setf (entry-offset control) (max 0 (- caret w -2))))
    (multiple-value-bind (lo hi) (entry-selection control)
      (when (and editing (< lo hi))
        (let ((x (- (round (text:string-width font (subseq string 0 lo))) (entry-offset control)))
              (width (round (text:string-width font (subseq string lo hi)))))
          (apply #'text:fill-rect text x 1 width (- h 2) (coerce (theme-color :selection) 'list)))))
    (text:draw-string text font string (- (entry-offset control)) 16 (aref ink 0) (aref ink 1) (aref ink 2))
    (when editing
      (text:fill-rect text (round (- caret (entry-offset control))) 2 1 (- h 4) .20 .18 .16))
    (draw-rgba bitmap (text:bitmap-pixels text) (max 1 w) (max 1 h) 12 6)))

(defmethod mouse-down ((control entry-field) x y)
  (declare (ignore y))
  (when (button-enabled control)
    (setf (button-armed control) t (entry-caret control) (entry-position control x)
          (entry-anchor control) (entry-caret control))
    (when (>= *click-count* 2) (setf (entry-anchor control) 0 (entry-caret control) (length (string-value control))))
    (needs-display control))
  t)
(defmethod mouse-moved ((control entry-field) x y)
  (call-next-method)
  (when (and (button-enabled control) (button-armed control))
    (setf (entry-caret control) (entry-position control x)) (needs-display control)))
(defmethod mouse-up ((control entry-field) x y)
  (declare (ignore x y)) (setf (button-armed control) nil) (needs-display control))

(defmethod key-down ((control entry-field) characters keycode)
  (when (button-enabled control)
    (let ((command (or (member :control *key-modifiers*) (member :meta *key-modifiers*)))
          (shift (member :shift *key-modifiers*)))
      (multiple-value-bind (lo hi) (entry-selection control)
        (cond
          ((and command (= keycode 30)) (setf (entry-anchor control) 0 (entry-caret control) (length (string-value control))))
          ((and command (member keycode '(46 45)))
           (when (< lo hi)
             (setf (layer:clipboard-text) (subseq (string-value control) lo hi))
             (when (= keycode 45) (entry-replace control ""))))
          ((and command (= keycode 47)) (entry-replace control (layer:clipboard-text)))
          ((and command (member keycode '(44 21)))
           (let ((redo (or (= keycode 21) shift)))
             (when (if redo (entry-redo control) (entry-undo control))
               (if redo
                   (progn (push (entry-state control) (entry-undo control))
                          (entry-restore control (pop (entry-redo control))))
                   (progn (push (entry-state control) (entry-redo control))
                          (entry-restore control (pop (entry-undo control))))))))
          ((member keycode '(105 106 102 107))
           (setf (entry-caret control)
                 (case keycode (102 0) (107 (length (string-value control)))
                   (105 (if (and (not shift) (< lo hi)) lo (max 0 (1- (entry-caret control)))))
                   (106 (if (and (not shift) (< lo hi)) hi (min (length (string-value control)) (1+ (entry-caret control)))))))
           (unless shift (setf (entry-anchor control) (entry-caret control))))
          ((member keycode '(14 111))
           (cond ((< lo hi) (entry-replace control ""))
                 ((and (= keycode 14) (plusp lo)) (entry-replace control "" (1- lo) lo))
                 ((and (= keycode 111) (< hi (length (string-value control)))) (entry-replace control "" hi (1+ hi)))))
          ((= keycode 28)
           (setf (entry-error control) (and (entry-validator control) (funcall (entry-validator control) (string-value control))))
           (unless (entry-error control) (when (action control) (funcall (action control) control))))
          ((and (not command) (plusp (length characters))
                (every (lambda (c) (and (>= (char-code c) 32) (/= (char-code c) 127)
                                       (not (<= #xF700 (char-code c) #xF8FF)))) characters))
           (entry-replace control characters))))
      (needs-display control))))

(defclass popup-button (button)
  ((choices :initarg :choices :initform nil :reader choices)
   (value :initarg :value :initform nil :accessor selected-value)
   (popup :initform nil :accessor choice-popup)))

(defun choice-enabled-p (choice) (getf choice :enabled t))
(defun popup-choice-label (choice)
  (if (and (not (choice-enabled-p choice)) (getf choice :reason))
      (format nil "~a — ~a" (getf choice :label "") (getf choice :reason))
      (getf choice :label "")))
(defun selected-choice (control) (find (selected-value control) (choices control) :key (lambda (item) (getf item :value)) :test #'equal))
(defmethod (setf selected-value) :after (value (control popup-button))
  (declare (ignore value)) (needs-display control))

(defmethod draw ((control popup-button) bitmap)
  (control-face control bitmap)
  (let ((ink (theme-color (if (button-enabled control) :ink :disabled-ink)))
        (x (- (view-width control) 8)))
    (let ((label (text:make-bitmap (max 1 (- (view-width control) 36)) 20)))
      (text:draw-string label (ui-font) (popup-choice-label (selected-choice control)) 0 14
                        (aref ink 0) (aref ink 1) (aref ink 2))
      (draw-rgba bitmap (text:bitmap-pixels label) (text:bitmap-width label) 20 15 7))
    (control-stroke bitmap (- x 5) 15 (- x 2) 18 ink)
    (control-stroke bitmap (- x 2) 18 (1+ x) 15 ink)))

(defclass choice-menu (view)
  ((control :initarg :control :reader choice-control)
   (candidate :initarg :candidate :accessor choice-candidate)
   (offset :initform 0 :accessor choice-offset)
   (rows :initarg :rows :reader choice-rows)
   (prefix :initform "" :accessor choice-prefix)
   (typed :initform 0 :accessor choice-typed)
   (pressed :initform nil :accessor choice-pressed)))

(defun choice-row-at (menu x y)
  (let ((index (+ (choice-offset menu) (floor (- y 5) 26))))
    (and (<= 4 x (- (view-width menu) 5)) (<= 5 y (- (view-height menu) 6))
         (< -1 index (length (choices (choice-control menu))))
         (choice-enabled-p (nth index (choices (choice-control menu)))) index)))

(defun reveal-choice (menu)
  (let ((index (choice-candidate menu)))
    (when index
      (setf (choice-offset menu) (max 0 (min (choice-offset menu) index)))
      (when (>= index (+ (choice-offset menu) (choice-rows menu)))
        (setf (choice-offset menu) (- (1+ index) (choice-rows menu))))))
  (needs-display menu))

(defmethod draw ((menu choice-menu) bitmap)
  (let ((w (view-width menu)) (h (view-height menu)) (control (choice-control menu)))
    (apply #'text:fill-round-rect bitmap 0 0 w h 7 (coerce (theme-color :edge) 'list))
    (apply #'text:fill-round-rect bitmap 1 1 (- w 2) (- h 2) 6 (coerce (theme-color :paper) 'list))
    (loop for item in (nthcdr (choice-offset menu) (choices control)) for row below (choice-rows menu)
          for index from (choice-offset menu) for y = (+ 5 (* row 26)) do
      (when (eql index (choice-candidate menu))
        (apply #'text:fill-round-rect bitmap 4 y (- w 8) 26 4 (coerce (theme-color :selection) 'list)))
      (let ((ink (theme-color (if (choice-enabled-p item) :ink :disabled-ink))))
        (when (equal (getf item :value) (selected-value control))
          (control-stroke bitmap 11 (+ y 13) 14 (+ y 16) ink)
          (control-stroke bitmap 14 (+ y 16) 20 (+ y 9) ink))
        (text:draw-string bitmap (ui-font) (popup-choice-label item) 28 (+ y 17) (aref ink 0) (aref ink 1) (aref ink 2))))))

(defun close-choices (control &optional commit)
  (let ((popup (shiftf (choice-popup control) nil)))
    (when popup
      (let* ((menu (first-responder popup)) (index (choice-candidate menu))
             (item (and index (nth index (choices control))))
             (old (selected-value control)))
        (close-window popup)
        (setf (button-armed control) nil)
        (let ((parent (window-of control))) (when parent (set-key-focus parent control t)))
        (when (and commit item (choice-enabled-p item))
          (setf (selected-value control) (getf item :value))
          (unless (equal old (selected-value control))
            (when (action control) (funcall (action control) control))))
        (needs-display control)))))

(defmethod popup-dismissed ((menu choice-menu))
  (let ((control (choice-control menu)))
    (setf (choice-popup control) nil (button-armed control) nil)
    (needs-display control)))

(defun view-screen-origin (view)
  (let ((x 0) (y 0) (window (window-of view)))
    (loop for v = view then (superview v) while v do
      (incf x (aref (view-frame v) 0)) (incf y (aref (view-frame v) 1)))
    (values (+ x (window-x window)) (+ y (window-y window)))))

(defmethod activate ((control popup-button))
  (when (and (button-enabled control) (choices control))
    (if (choice-popup control) (close-choices control)
        (multiple-value-bind (x y) (view-screen-origin control)
          (let* ((bounds (layer:main-display-bounds))
                 (rows (min (length (choices control)) (max 1 (floor (- (fourth bounds) 52) 26))))
                 (height (+ 10 (* 26 rows)))
                 (width (min (- (third bounds) 4) (max (view-width control) (+ 44 (ceiling (reduce #'max (choices control) :initial-value 0
                           :key (lambda (item) (text:string-width (ui-font) (popup-choice-label item)))))))))
                 (top (if (<= (+ y (view-height control) 3 height) (fourth bounds))
                          (+ y (view-height control) 3) (max 26 (- y height 3))))
                 (window (make-window :style :borderless :level :pop-up-menu
                                     :x (max 2 (min x (- (third bounds) width 2))) :y top :width width :height height :background nil))
                 (menu (make-instance 'choice-menu :control control :rows rows
                                      :candidate (position (selected-choice control) (choices control))
                                      :frame (vector 0 0 width height))))
            (add-subview (content-view window) menu)
            (setf (choice-popup control) window (first-responder window) menu (button-armed control) t)
            (reveal-choice menu)
            (needs-display control) (show window))))))

(defmethod mouse-moved ((menu choice-menu) x y)
  (setf (choice-candidate menu) (choice-row-at menu x y)) (needs-display menu))
(defmethod mouse-exited ((menu choice-menu))
  (setf (choice-candidate menu) nil) (needs-display menu))
(defmethod mouse-down ((menu choice-menu) x y)
  (setf (choice-pressed menu) t) (mouse-moved menu x y) t)
(defmethod mouse-up ((menu choice-menu) x y)
  (when (shiftf (choice-pressed menu) nil)
    (setf (choice-candidate menu) (choice-row-at menu x y))
    (close-choices (choice-control menu) t)))
(defmethod key-down ((menu choice-menu) characters keycode)
  (let* ((control (choice-control menu))
         (enabled (loop for choice in (choices control) for i from 0 when (choice-enabled-p choice) collect i)))
    (case keycode
      (1 (close-choices control))
      (15 (let ((parent (window-of control))) (close-choices control) (when parent (cycle-focus parent))))
      ((28 57) (close-choices control t))
      ((103 108 102 107 104 109)
       (when enabled
         (let* ((at (position (choice-candidate menu) enabled))
                (delta (case keycode (103 -1) (108 1) (104 (- (choice-rows menu))) (109 (choice-rows menu)) (t 0)))
                (index (case keycode (102 0) (107 (1- (length enabled)))
                         (t (max 0 (min (1- (length enabled)) (+ (or at -1) delta)))))))
           (setf (choice-candidate menu) (nth index enabled))
           (reveal-choice menu))))
      (t
       (when (and (plusp (length characters)) (>= (char-code (char characters 0)) 32))
         (let ((now (get-internal-real-time)))
           (when (> (- now (choice-typed menu)) internal-time-units-per-second) (setf (choice-prefix menu) ""))
           (setf (choice-typed menu) now (choice-prefix menu) (concatenate 'string (choice-prefix menu) characters))
           (let ((match (find-if (lambda (i) (let ((name (popup-choice-label (nth i (choices control)))) (prefix (choice-prefix menu)))
                                  (and (<= (length prefix) (length name)) (string-equal prefix name :end2 (length prefix))))) enabled)))
             (when match (setf (choice-candidate menu) match) (reveal-choice menu)))))))))


(defmethod key-down ((control popup-button) characters keycode)
  (if (member keycode '(103 108)) (activate control) (call-next-method)))

(defmethod (setf button-enabled) :after (value (control popup-button))
  (unless value (close-choices control)))

(defmethod scroll-wheel ((menu choice-menu) dx dy)
  (declare (ignore dx))
  (let ((limit (max 0 (- (length (choices (choice-control menu))) (choice-rows menu)))))
    (setf (choice-offset menu) (max 0 (min limit (- (choice-offset menu) (* 3 dy))))
          (choice-candidate menu) nil)
    (needs-display menu)))

(defmethod resumed ((control popup-button))
  ;; The old popup's IPC context belongs to the saved session. Never close or
  ;; reuse it after restoration; resume recreates only persistent app windows.
  (setf (choice-popup control) nil)
  (call-next-method))


(defmethod keyboard-target ((control popup-button))
  (let ((popup (choice-popup control)))
    (if popup (first-responder popup) control)))
