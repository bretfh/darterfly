(in-package #:darterfly/kit)

(bsd:define-process-variable *choice-panel* nil)
(bsd:define-process-variable *reduced-motion* nil)

(defclass choice-panel (view)
  ((session :accessor panel-session) (window :accessor panel-window)
   (input :accessor panel-input) (status :accessor panel-status)
   (retry :accessor panel-retry) (list :accessor panel-list) (prompt :initarg :prompt :reader panel-prompt)
   (source :initarg :source :reader panel-source)
   (refresh :initarg :refresh :initform nil :reader panel-refresh)
   (previous :initarg :previous :reader panel-previous)
   (offset :initform 0 :accessor panel-offset) (rows :initarg :rows :reader panel-rows)
   (lock :initform (sb-thread:make-mutex :name "choice requests") :reader panel-lock)
   (pending :initform nil :accessor panel-pending) (worker :initform nil :accessor panel-worker)))
(defclass completion-retry (button) ())
(defmethod draw ((button completion-retry) bitmap)
  (when (button-enabled button) (call-next-method)))
(defclass completion-status (text-field) ((panel :initarg :panel :reader status-panel)))
(defun focus-choice-input (panel)
  (set-key-focus (panel-window panel) (panel-input panel) t))
(defmethod mouse-down ((panel choice-panel) x y)
  (declare (ignore x y)) (focus-choice-input panel) t)
(defmethod mouse-down ((status completion-status) x y)
  (declare (ignore x y)) (focus-choice-input (status-panel status)) t)
(defclass completion-entry (entry-field) ((panel :initarg :panel :reader entry-panel)))
(defclass completion-list (view) ((panel :initarg :panel :reader list-panel) (pressed :initform nil :accessor list-pressed)))

(defun fit-label (string font width)
  (if (<= (text:string-width font string) width) string
      (loop for end downfrom (length string) to 0
            for label = (concatenate 'string (subseq string 0 end) "…")
            when (<= (text:string-width font label) width) return label finally (return ""))))
(defun ink-string (bitmap string x y &optional (size 12) (role :ink) width)
  (let* ((font (ui-font size)) (color (theme-color role))
         (string (if width (fit-label string font width) string)))
    (text:draw-string bitmap font string x y (aref color 0) (aref color 1) (aref color 2))))
(defmethod draw ((panel choice-panel) bitmap)
  (fill-surface bitmap)
  (rounded-gradient bitmap 0 0 (view-width panel) 42 0 (rgb8 231 229 225) (rgb8 220 217 212))
  (ink-string bitmap (panel-prompt panel) 16 27 13)
  (ink-string bitmap "Up/Down choose · Enter return · Esc cancel" 16 (- (view-height panel) 14) 11 :muted)
  (let ((items (choice-items (panel-session panel))))
    (ink-string bitmap (format nil "~d–~d / ~d" (if items (1+ (panel-offset panel)) 0)
                              (min (length items) (+ (panel-offset panel) (panel-rows panel))) (length items))
                (- (view-width panel) 112) (- (view-height panel) 14) 11 :muted)))
(defun refresh-choice-panel (panel)
  (let* ((s (panel-session panel)) (items (choice-items s))
         (selected (position (choice-selected s) items :key #'choice-id :test #'equal)))
    (setf (panel-offset panel) (max 0 (min (panel-offset panel) (max 0 (- (length items) (panel-rows panel))))))
    (when selected
      (when (< selected (panel-offset panel)) (setf (panel-offset panel) selected))
      (when (>= selected (+ (panel-offset panel) (panel-rows panel)))
        (setf (panel-offset panel) (- selected (panel-rows panel) -1))))
    (let* ((rows (max 1 (min (panel-rows panel) (length items))))
           (height (+ 142 (* rows 48))) (window (panel-window panel)))
      (unless (= height (view-height panel))
        (window-frame-changed window (list (window-x window) (window-y window) (window-width window) height))
        (setf (view-frame (panel-list panel)) (vector 0 112 (view-width panel) (* rows 48)))
        (when (window-id window) (layer:transaction-commit (list (list :shape (window-id window) (window-width window) height))))))
    (setf (button-enabled (panel-retry panel)) (not (null (choice-error s))))
    (setf (string-value (panel-status panel))
          (cond ((choice-error s) (princ-to-string (choice-error s)))
                ((choice-session-lost s) "That choice is no longer available. Choose another.")
                ((eq :loading (choice-status s)) "Looking for choices…")
                ((null items) "No matches. Try a name, application or location.")
                (t (format nil "~d ~a" (length items) (if (= 1 (length items)) "choice" "choices")))))
    (needs-display (panel-list panel)) (needs-display panel)))
(defun request-panel (panel &optional refresh)
  ;; A timer must not continuously invalidate a slow, still useful response.
  (when (and refresh (panel-worker panel)) (return-from request-panel nil))
  (let* ((s (panel-session panel))
         (serial (if refresh (incf (choice-session-serial s))
                     (begin-choice-query s (string-value (panel-input panel))))))
    (unless (choice-session-closed s)
      (sb-thread:with-mutex ((panel-lock panel))
        (setf (panel-pending panel) (list serial (choice-query s)))
        (unless (panel-worker panel)
          (setf (panel-worker panel) t)
          (bsd:bsdthread-create
           (lambda ()
             (loop
               (let ((job (sb-thread:with-mutex ((panel-lock panel))
                            (or (shiftf (panel-pending panel) nil)
                                (progn (setf (panel-worker panel) nil) nil)))))
                 (unless job (return))
                 (let* ((ticket (first job)) (query (second job))
                        (error nil)
                        (choices (handler-case
                                     (funcall (panel-source panel) query
                                              (lambda () (or (choice-session-closed s)
                                                             (/= ticket (choice-session-serial s)))))
                                   (error (e) (setf error (princ-to-string e)) nil))))
                   (perform-on-main
                    (lambda ()
                      (when (publish-choices s ticket choices :error error) (refresh-choice-panel panel))))))))
           "completion source")))
      (unless refresh (refresh-choice-panel panel)))))
(defun dismiss-choice-panel (panel result callback)
  (close-window (panel-window panel))
  (when (eq *choice-panel* panel) (setf *choice-panel* nil))
  (let ((previous (panel-previous panel)))
    (when (and previous (window-id previous))
      (let ((r (first-responder previous))) (when r (focus-changed r)))))
  (when callback (funcall callback result)))
(defmethod popup-dismissed ((panel choice-panel)) (cancel-choice (panel-session panel)))
(defmethod resumed ((panel choice-panel))
  (setf (choice-session-closed (panel-session panel)) t *choice-panel* nil))

(defmethod draw ((view completion-list) bitmap)
  (fill-surface bitmap)
  (let* ((panel (list-panel view)) (s (panel-session panel)) (items (choice-items s))
         (start (panel-offset panel)) (width (view-width view)))
    (loop for choice in (nthcdr start items) for row below (panel-rows panel) for y = (* row 48) do
      (when (equal (choice-id choice) (choice-selected s))
        (apply #'text:fill-rect bitmap 0 y width 48 (coerce (theme-color :selection) 'list))
        (apply #'text:fill-rect bitmap 0 y 3 48 (coerce (theme-color :selection-edge) 'list)))
      (text:fill-rect bitmap 0 (+ y 47) width 1 .87 .85 .82)
      (let ((pixels (and (choice-icon choice) (icon-pixels (choice-icon choice) 20))))
        (when pixels
          (let ((tinted (copy-seq pixels)))
            (loop for i below (length tinted) by 4 for alpha = (aref tinted (+ i 3)) do
              (dotimes (c 3) (setf (aref tinted (+ i c)) (round (* alpha 65) 255))))
            (draw-rgba bitmap tinted 20 20 12 (+ y 13)))))
      (ink-string bitmap (choice-label choice) 44 (+ y 20) 13 (if (choice-enabled choice) :ink :disabled-ink) (- width 55))
      (ink-string bitmap (or (choice-reason choice) (choice-detail choice)) 44 (+ y 37) 11 :muted (- width 55)))))
(defun choice-at (view x y)
  (when (inside-view-p view x y)
    (let* ((panel (list-panel view)) (index (+ (panel-offset panel) (floor y 48))))
      (nth index (choice-items (panel-session panel))))))
(defmethod mouse-down ((view completion-list) x y)
  (focus-choice-input (list-panel view))
  (let ((choice (choice-at view x y)))
    (setf (list-pressed view) (and choice (choice-enabled choice) (choice-id choice)))
    (when choice (choose-candidate (panel-session (list-panel view)) (choice-id choice)) (needs-display view))) t)
(defmethod mouse-up ((view completion-list) x y)
  (let ((choice (choice-at view x y)) (old (shiftf (list-pressed view) nil)))
    (when (and choice old (choice-enabled choice) (equal old (choice-id choice))
               (equal old (choice-selected (panel-session (list-panel view)))))
      (accept-choice (panel-session (list-panel view)))
      (unless (choice-session-closed (panel-session (list-panel view)))
        (refresh-choice-panel (list-panel view))))))
(defmethod cancel-pointer ((view completion-list)) (setf (list-pressed view) nil))
(defmethod scroll-wheel ((view completion-list) dx dy)
  (declare (ignore dx))
  (let ((panel (list-panel view)))
    (move-choice (panel-session panel) (* -3 (signum dy))) (refresh-choice-panel panel)))
(defmethod key-down ((field completion-entry) chars code)
  (let* ((panel (entry-panel field)) (s (panel-session panel))
         (control (member :control *key-modifiers*)) (before (string-value field)))
    (cond ((or (= code 1) (and control (= code 34))) (cancel-choice s))
          ((= code 28) (accept-choice s))
          ((and control (= code 19)) (request-panel panel))
          ((or (member code '(103 108 104 109)) (and control (member code '(49 25 102 107))))
           (move-choice s (cond ((or (= code 103) (= code 25)) -1) ((or (= code 108) (= code 49)) 1)
                               ((= code 104) (- (panel-rows panel))) ((= code 109) (panel-rows panel))
                               ((= code 102) (- (length (choice-items s)))) (t (length (choice-items s))))))
          ((and control (= code 57))
           (let ((choice (find (choice-selected s) (choice-items s) :key #'choice-id :test #'equal)))
             (when choice (setf (string-value field) (choice-label choice)
                                (entry-caret field) (length (string-value field)) (entry-anchor field) (entry-caret field)))))
          (t (call-next-method)))
    (unless (choice-session-closed s)
      (unless (equal before (string-value field)) (setf (panel-offset panel) 0) (request-panel panel))
      (refresh-choice-panel panel))))

(defun read-choice (&key (prompt "Choose") source on-result validator (initial "") refresh)
  "Open a nonblocking, match-required question. SOURCE(query,cancelled-p) runs on a worker.
Returns a choice-session. Results are delivered once on the owning UI loop."
  (when *choice-panel* (cancel-choice (panel-session *choice-panel*)))
  (destructuring-bind (sx sy sw sh) (layer:main-display-bounds)
    (declare (ignore sx sy))
    (let* ((width (min 540 (- sw 32))) (rows (max 2 (min 8 (floor (- sh 230) 48))))
           (height (+ 142 (* rows 48)))
           (window (make-window :title prompt :style :borderless :level :pop-up-menu
                                :x (floor (- sw width) 2) :y (if (< sh 700) 42 64) :width width :height height
                                :transient t :question t))
           (panel (make-instance 'choice-panel :prompt prompt :source source :refresh refresh
                                 :rows rows :previous (front-window) :frame (vector 0 0 width height)))
           (s (make-choice-session :validator validator
                                   :on-result (lambda (result) (dismiss-choice-panel panel result on-result))))
           (field (make-instance 'completion-entry :panel panel :string initial :frame (vector 16 54 (- width 32) 32)))
           (list (make-instance 'completion-list :panel panel :frame (vector 0 112 width (* rows 48))))
           (retry (make-instance 'completion-retry :title "Retry" :enabled nil :frame (vector (- width 166) 8 70 26)
                                :action (lambda (sender) (declare (ignore sender)) (request-panel panel) (set-key-focus window field t))))
           (status (make-instance 'completion-status :panel panel :string "" :font-size 11 :text-color (theme-color :muted)
                                  :frame (vector 16 92 (- width 112) 18))))
      (setf *choice-panel* panel (panel-session panel) s (panel-window panel) window
            (panel-input panel) field (panel-status panel) status (panel-list panel) list (panel-retry panel) retry)
      (add-subview (content-view window) panel)
      (dolist (v (list field list status retry
                      (make-instance 'button :title "Cancel" :frame (vector (- width 86) 8 70 26)
                                     :action (lambda (sender) (declare (ignore sender)) (cancel-choice s)))))
        (add-subview panel v))
      (show window) (set-key-focus window field t) (request-panel panel)
      (when refresh
        (bsd:bsdthread-create
         (lambda () (loop (sleep .5) (when (choice-session-closed s) (return))
                         (perform-on-main (lambda () (unless (choice-session-closed s) (request-panel panel t))))))
         "completion refresh"))
      s)))

(defun all-window-descriptions ()
  (loop repeat 3 do
    (let ((result nil) (offset 0) (revision nil) (changed nil))
      (loop for page = (layer:window-list :offset offset)
            do (when (and revision (/= revision (getf page :revision)))
                 (setf changed t) (return))
               (setf revision (getf page :revision) result (nconc result (getf page :windows)))
            while (setf offset (getf page :next)))
      (unless changed (return-from all-window-descriptions result))))
  (error "Windows are changing. Try again."))
(defun window-app-icon (app)
  (format nil "/usr/share/icons/Adwaita/~a.png"
          (cond ((equal app "Files") "legacy/system-file-manager-symbolic")
                ((equal app "Editor") "legacy/accessories-text-editor-symbolic")
                ((equal app "Terminal") "legacy/utilities-terminal-symbolic")
                ((equal app "Generations") "status/software-update-available-symbolic")
                (t "actions/system-run-symbolic"))))
(defun read-window (&key app minimized)
  (read-choice :prompt (if minimized "Return to a window" "Switch to a window") :refresh t
    :source (lambda (query cancelled-p)
              (declare (ignore query))
              (loop for w in (all-window-descriptions)
                    unless (funcall cancelled-p)
                    when (and (or (not app) (equal app (getf w :app))) (or (not minimized) (getf w :minimized)))
                    collect (let ((name (getf w :app)) (location (getf w :location))
                                  (state (if (getf w :minimized) "Minimized" "On desktop")))
                              (make-choice :id (getf w :handle) :value (getf w :handle) :label (getf w :title)
                                :icon (window-app-icon name) :search (list name location state)
                                :detail (format nil "~a · ~a~a~a" name state (if (equal location "") "" " · ") location)))))
    :validator (lambda (choice)
                 (unless (layer:window-restore (choice-value choice) :reduced-motion *reduced-motion*)
                   "That window is no longer available. Choose another."))))
(defun read-command (&key (window (front-window)))
  (ensure-standard-commands)
  ;; Availability predicates may read application state: evaluate on its UI loop.
  (let ((choices (loop for command in (reverse *commands*)
                       for enabled = (command-enabled-p command window)
                       collect (make-choice :id (command-id command) :value (command-id command)
                                 :label (command-label command) :enabled enabled
                                 :reason (unless enabled "Unavailable in this window")))))
    (read-choice :prompt "Run a command"
      :source (lambda (query cancelled-p) (declare (ignore query cancelled-p)) choices)
      :validator (lambda (choice) (unless (command-enabled-p (find-command (choice-value choice)) window) "This command is no longer available."))
      :on-result (lambda (result) (when (eq :accepted (choice-result-status result)) (invoke-command (choice-result-value result) window))))))
(defun minimize-window (window)
  (when (and window (window-id window))
    (layer:transaction-commit (list (list :minimize (window-id window) *reduced-motion*)))))
