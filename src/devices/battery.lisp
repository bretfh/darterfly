(in-package #:finch/devices)

(defun aml-region-names (v space)
  (loop for at below (- (length v) 7)
        when (and (= (aref v at) #x5b) (= (aref v (1+ at)) #x80) (name-seg-p v (+ at 2)) (= (aref v (+ at 6)) space))
          collect (map 'string #'code-char (subseq v (+ at 2) (+ at 6)))))

(defun aml-fields (v region)
  (let ((fields nil))
    (loop for at below (- (length v) 8)
          when (and (= (aref v at) #x5b) (= (aref v (1+ at)) #x81))
            do (multiple-value-bind (length used) (aml-pkg-length v (+ at 2))
                 (multiple-value-bind (segs p) (aml-name v (+ at 2 used))
                   (when (and segs (string= (car (last segs)) region))
                     (let ((end (min (length v) (+ at 2 length)))
                           (bit 0))
                       (incf p)
                       (loop while (< p end)
                             do (case (aref v p)
                                  (0 (multiple-value-bind (n u) (aml-pkg-length v (1+ p))
                                       (incf bit n) (incf p (1+ u))))
                                  (1 (incf p 3))
                                  (3 (incf p 4))
                                  (t (if (name-seg-p v p)
                                         (multiple-value-bind (n u) (aml-pkg-length v (+ p 4))
                                           (push (list (map 'string #'code-char (subseq v p (+ p 4))) bit n) fields)
                                           (incf bit n)
                                           (incf p (+ 4 u)))
                                         (return))))))))))
    (nreverse fields)))

(defun aml-method-body (v name start end)
  (loop for at from start below end
        when (= (aref v at) #x14)
          do (multiple-value-bind (length used) (aml-pkg-length v (1+ at))
               (let ((p (+ at 1 used)))
                 (when (and (< (+ p 4) end) (string= name (map 'string #'code-char (subseq v p (+ p 4)))))
                   (return (values (+ p 5) (min end (+ at 1 length)))))))))

(defun names-used (v start end fields)
  (let ((used nil))
    (loop for at from start below (- end 3)
          for name = (and (name-seg-p v at) (map 'string #'code-char (subseq v at (+ at 4))))
          when (and name (assoc name fields :test #'string=) (not (member name used :test #'string=)))
            do (push name used))
    (nreverse used)))

(defvar *battery* :unknown)

(defun innermost-device (v at)
  (first (sort (remove-if-not (lambda (b) (< (second b) at (third b))) (aml-blocks v :devices-only t))
               #'< :key (lambda (b) (- (third b) (second b))))))

(defun battery-in (v fields)
  (let* ((hit (search #(#x0c #x41 #xd0 #x0c #x0a) v))
         (device (and hit (innermost-device v hit))))
    (when device
      (multiple-value-bind (bs be) (aml-method-body v "_BST" (second device) (third device))
        (multiple-value-bind (is ie) (aml-method-body v "_BIF" (second device) (third device))
          (let ((status (and bs (names-used v bs be fields)))
                (info (and is (names-used v is ie fields))))
            (when (and (>= (length status) 3) (>= (length info) 2))
              (flet ((field (name) (assoc name fields :test #'string=)))
                (list :state (field (first status)) :rate (field (second status))
                      :remaining (field (third status)) :full (field (second info)))))))))))

(defun battery-layout ()
  (when (eq *battery* :unknown)
    (setf *battery*
          (ignore-errors
           (let* ((blocks (definition-blocks))
                  (fields (loop for v in blocks
                                append (loop for region in (aml-region-names v 3) append (aml-fields v region)))))
             (some (lambda (v) (battery-in v fields)) blocks)))))
  *battery*)

(defun ec-field (field)
  (destructuring-bind (name bit size) field
    (declare (ignore name))
    (let ((value 0))
      (dotimes (i (ceiling size 8))
        (let ((b (machdep 23 (+ (floor bit 8) i))))
          (when (> b 255) (return-from ec-field nil))
          (setf value (logior value (ash b (* 8 i))))))
      (ldb (byte size (mod bit 8)) value))))

(defun battery ()
  (let ((layout (battery-layout)))
    (when layout
      (let ((state (ec-field (getf layout :state)))
            (remaining (ec-field (getf layout :remaining)))
            (full (ec-field (getf layout :full))))
        (when (and state remaining full (plusp full) (< remaining #xffff))
          (list :percent (min 100 (round (* 100 remaining) full))
                :charging (logbitp 1 state)
                :discharging (logbitp 0 state)))))))
