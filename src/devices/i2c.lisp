(in-package #:darterfly/devices)

(define-device-class intel-lpss-i2c-controller "IntelLpssI2CController" (device)
  ((base :accessor i2c-base)
   (target :initform nil :accessor i2c-target)
   (depth :initform 16 :accessor i2c-depth)
   (lock :initform (sb-thread:make-mutex :name "i2c") :reader i2c-lock)))

(add-personality "Class" "IntelLpssI2CController" "ProviderClass" "PCIDevice"
                 "PCIClassMatch" "0x000c8000")

(define-device-class i2c-hid-device "IOHIDI2CDevice" (device)
  ((controller :initarg :controller :reader hid-controller)
   (address :initarg :address :reader hid-address)
   (descriptor :accessor hid-descriptor)
   (report-descriptor :accessor hid-report-descriptor)
   (gsi :initarg :gsi :reader hid-gsi)
   (flags :initarg :flags :reader hid-flags)
   (vector :initform nil :accessor hid-vector)
   (routing :initform 0 :accessor hid-routing)
   (queue :initform nil :accessor hid-queue)
   (queue-lock :initform (sb-thread:make-mutex :name "i2c-hid") :reader hid-queue-lock)
   (fields :initform nil :accessor hid-fields)
   (state :initform nil :accessor hid-state)))

(defun ir32 (c offset) (mmio-read (+ (i2c-base c) offset) 32))
(defun iw32 (c offset value) (mmio-write (+ (i2c-base c) offset) 32 value))

(defun i2c-enable (c on)
  (iw32 c #x6c (if on 1 0))
  (wait-until (lambda () (eq on (logbitp 0 (ir32 c #x9c)))) 0.1))

(defun i2c-set-target (c address)
  (unless (eql address (i2c-target c))
    (i2c-enable c nil)
    (iw32 c #x04 address)
    (i2c-enable c t)
    (setf (i2c-target c) address)))

(defun i2c-transfer (c address write read)
  (sb-thread:with-mutex ((i2c-lock c))
    (i2c-set-target c address)
    (ir32 c #x40)
    (let* ((commands (append (loop for b across write collect b)
                             (loop for i below read
                                   collect (logior #x100 (if (and (zerop i) (plusp (length write))) #x400 0)))))
           (total (length commands))
           (result (make-array read :element-type '(unsigned-byte 8)))
           (sent 0) (reads-sent 0) (got 0)
           (deadline (+ (get-internal-real-time) (* internal-time-units-per-second (+ 0.05 (* total 0.0001))))))
      (loop
        (when (logbitp 6 (ir32 c #x34))
          (let ((source (ir32 c #x80)))
            (ir32 c #x54)
            (error "i2c: transfer to ~x aborted (~x)" address source)))
        (when (and (= sent total) (= got read)
                   (logbitp 2 (ir32 c #x70)) (not (logbitp 5 (ir32 c #x70))))
          (return result))
        (loop while (and (< sent total) (< (ir32 c #x74) (i2c-depth c))
                         (< (- reads-sent got) (i2c-depth c)))
              do (let ((command (pop commands)))
                   (incf sent)
                   (when (logbitp 8 command) (incf reads-sent))
                   (iw32 c #x10 (if (= sent total) (logior command #x200) command))))
        (loop repeat (ir32 c #x78)
              while (< got read)
              do (setf (aref result got) (ldb (byte 8 0) (ir32 c #x10)))
                 (incf got))
        (when (> (get-internal-real-time) deadline)
          (error "i2c: transfer to ~x timed out (~d of ~d sent, ~d of ~d read)" address sent total got read))))))

(defun le16 (v at) (logior (aref v at) (ash (aref v (1+ at)) 8)))
(defun le16-octets (&rest values)
  (let ((v (make-array (* 2 (length values)) :element-type '(unsigned-byte 8))))
    (loop for x in values for i from 0 by 2
          do (setf (aref v i) (ldb (byte 8 0) x) (aref v (1+ i)) (ldb (byte 8 8) x)))
    v))

(defmethod start ((c intel-lpss-i2c-controller) (d pci-node))
  (let* ((here (logior (ash (pci-device d) 16) (pci-function d)))
         (devices (remove-if-not (lambda (h) (and (zerop (pci-bus d)) (eql (getf h :controller) here)))
                                 (ignore-errors (i2c-hid-devices)))))
    (unless devices (return-from start nil))
    (let ((map (map-device-memory-with-index d 0)))
      (unless map (return-from start nil))
      (setf (i2c-base c) (map-virtual-address map)))
    (let ((pm (find-pci-capability d 1)))
      (when (and pm (logtest (config-read-16 d (+ pm 4)) 3))
        (config-write-16 d (+ pm 4) (logandc2 (config-read-16 d (+ pm 4)) 3))
        (sleep 0.01)))
    (set-memory-enable d t)
    (unless (= (logand (ir32 c #x204) 3) 3)
      (iw32 c #x204 0)
      (iw32 c #x204 7)
      (sleep 0.001))
    (unless (= (ir32 c #xfc) #x44570140)
      (set-property c "error" (format nil "not a DesignWare I2C controller (~x)" (ir32 c #xfc)))
      (return-from start nil))
    (setf (i2c-depth c) (min 16 (1+ (ldb (byte 8 16) (ir32 c #xf4))) (1+ (ldb (byte 8 8) (ir32 c #xf4)))))
    (destructuring-bind (&optional (hcnt 106) (lcnt 213) (hold 40)) (getf (first devices) :timing)
      (i2c-enable c nil)
      (iw32 c #x00 #x65)
      (iw32 c #x1c hcnt)
      (iw32 c #x20 lcnt)
      (iw32 c #x7c hold)
      (iw32 c #x30 0)
      (iw32 c #x38 0)
      (iw32 c #x3c 0))
    (register-service c)
    (dolist (h devices)
      (handler-case (start-i2c-hid c h)
        (error (e) (set-property c (format nil "~a" (getf h :name)) (princ-to-string e)))))
    t))

(defun i2c-hid-command (h opcode &optional (argument 0))
  (let ((command (le16 (hid-descriptor h) 16)))
    (i2c-transfer (hid-controller h) (hid-address h)
                  (concatenate '(vector (unsigned-byte 8)) (le16-octets command) (vector argument opcode))
                  0)))

(defun i2c-hid-set-feature (h report)
  (let* ((descriptor (hid-descriptor h))
         (id (aref report 0))
         (header (if (< id 15)
                     (vector (logior #x30 id) 3)
                     (vector #x3f 3 id))))
    (i2c-transfer (hid-controller h) (hid-address h)
                  (concatenate '(vector (unsigned-byte 8))
                               (le16-octets (le16 descriptor 16)) header
                               (le16-octets (le16 descriptor 18) (+ 2 (length report))) report)
                  0)))

(defun i2c-hid-input (h)
  (let* ((report (i2c-transfer (hid-controller h) (hid-address h) #() (le16 (hid-descriptor h) 10)))
         (length (le16 report 0)))
    (when (and (> length 2) (<= length (length report)))
      (subseq report 2 length))))

(defun i2c-hid-unmask (h)
  (machdep 22 (hid-gsi h) (hid-routing h)))

(defun i2c-hid-loop (h)
  (loop
    (when (wait-for-interrupt (list (hid-vector h)) 1)
      (let ((report (ignore-errors (i2c-hid-input h))))
        (when report
          (sb-thread:with-mutex ((hid-queue-lock h))
            (setf (hid-queue h) (nconc (hid-queue h) (list report))))
          (note-interrupt +input-vector+))))
    (i2c-hid-unmask h)))

(defun start-i2c-hid (c h)
  (let* ((device (make-instance 'i2c-hid-device :name (getf h :name) :controller c :address (getf h :address)
                                                   :gsi (getf h :gsi) :flags (or (getf h :flags) 0)))
         (descriptor (loop for register in '(#x20 #x01 #x00)
                           for d = (ignore-errors (i2c-transfer c (getf h :address) (le16-octets register) 30))
                           when (and d (= (le16 d 0) 30) (= (le16 d 2) #x100))
                             return d)))
    (unless descriptor (error "i2c-hid: no HID descriptor at ~x" (getf h :address)))
    (setf (hid-descriptor device) descriptor)
    (set-property device "VendorID" (le16 descriptor 20))
    (set-property device "ProductID" (le16 descriptor 22))
    (i2c-hid-command device 8 0)
    (sleep 0.01)
    (i2c-hid-command device 1 0)
    (sleep 0.1)
    (ignore-errors (i2c-hid-input device))
    (setf (hid-report-descriptor device)
          (i2c-transfer c (getf h :address) (le16-octets (le16 descriptor 6)) (le16 descriptor 4)))
    (attach device c)
    (when (getf h :gsi)
      (let ((vector (allocate-vector)))
        (when vector
          (setf (hid-vector device) vector
                (hid-routing device) (logior vector
                                             (if (logbitp 1 (hid-flags device)) 0 (ash 1 15))
                                             (if (logbitp 2 (hid-flags device)) (ash 1 13) 0)))
          (i2c-hid-unmask device)
          (sb-thread:make-thread #'i2c-hid-loop :name "i2c-hid" :arguments (list device)))))
    (register-service device)
    device))

(defmethod interrupt-vector ((h i2c-hid-device)) (hid-vector h))

(defun i2c-hid-reports (h)
  (sb-thread:with-mutex ((hid-queue-lock h))
    (shiftf (hid-queue h) nil)))
