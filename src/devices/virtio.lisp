(in-package #:darterfly/devices)

(defun add-personality (&rest kv)
  (let ((p (apply #'personality kv)))
    (setf *personalities*
          (append (remove (gethash "Class" p) *personalities* :key (lambda (q) (gethash "Class" q)) :test #'equal)
                  (list p)))))

(define-device-class virtio-transport "VirtIOTransport" (device)
  ((device-type :initform nil :accessor virtio-device-type)))

(define-device-class virtio-pci-transport "VirtIOPCITransport" (virtio-transport)
  ((common :initform nil :accessor common-cfg)
   (notify :initform nil :accessor notify-base)
   (notify-multiplier :initform 0 :accessor notify-multiplier)
   (isr :initform nil :accessor isr-cfg)
   (device :initform nil :accessor device-cfg)
   (msi-x :initform nil :accessor msi-x-table)
   (entries :initform 0 :accessor msi-x-entries)))

(add-personality "Class" "VirtIOPCITransport" "ProviderClass" "PCIDevice"
                 "PCIPrimaryMatch" "0x00001af4&0x0000FFFF" "ProbeScore" 10000)

(defmethod match-property-table ((tr virtio-transport) table)
  (let ((primary (gethash "VirtIOPrimaryMatch" table)))
    (or (null primary)
        (and (virtio-device-type tr) (id-matches-p primary (logior (ash (virtio-device-type tr) 16) #x1af4))))))

(defun common-read (tr offset width) (mmio-read (+ (common-cfg tr) offset) width))
(defun common-write (tr offset width value) (mmio-write (+ (common-cfg tr) offset) width value))
(defun common-write-64 (tr offset value)
  (common-write tr offset 32 (ldb (byte 32 0) value))
  (common-write tr (+ offset 4) 32 (ldb (byte 32 32) value)))

(defun device-status (tr) (common-read tr 20 8))
(defun (setf device-status) (status tr) (common-write tr 20 8 status))
(defun add-status (tr bits) (setf (device-status tr) (logior (device-status tr) bits)))

(defun device-config-read (tr offset width) (mmio-read (+ (device-cfg tr) offset) width))
(defun device-config-read-64 (tr offset)
  (logior (device-config-read tr offset 32) (ash (device-config-read tr (+ offset 4) 32) 32)))

(defmethod start ((tr virtio-pci-transport) (d pci-node))
  (let ((maps (make-hash-table)))
    (flet ((region (cap)
             (let ((bar (config-read-8 d (+ cap 4))))
               (+ (map-virtual-address (or (gethash bar maps) (setf (gethash bar maps) (map-device-memory-with-index d bar))))
                  (config-read-32 d (+ cap 8))))))
      (loop for cap = (find-pci-capability d 9) then (find-pci-capability d 9 cap)
            while cap
            do (case (config-read-8 d (+ cap 3))
                 (1 (setf (common-cfg tr) (region cap)))
                 (2 (setf (notify-base tr) (region cap)
                          (notify-multiplier tr) (config-read-32 d (+ cap 16))))
                 (3 (setf (isr-cfg tr) (region cap)))
                 (4 (setf (device-cfg tr) (region cap)))))))
  (when (common-cfg tr)
    (set-memory-enable d t)
    (set-bus-master-enable d t)
    (multiple-value-bind (table entries) (enable-msi-x d)
      (setf (msi-x-table tr) table (msi-x-entries tr) (or entries 0)))
    (let ((id (config-read-16 d 2)))
      (setf (virtio-device-type tr) (if (>= id #x1040) (- id #x1040) (config-read-16 d #x2e))))
    (setf (device-status tr) 0)
    (loop until (zerop (device-status tr)))
    (add-status tr 3)
    (register-service tr)
    t))

(defun device-features (tr)
  (common-write tr 0 32 0)
  (let ((low (common-read tr 4 32)))
    (common-write tr 0 32 1)
    (logior low (ash (common-read tr 4 32) 32))))

(defun set-driver-features (tr features)
  (common-write tr 8 32 0)
  (common-write tr 12 32 (ldb (byte 32 0) features))
  (common-write tr 8 32 1)
  (common-write tr 12 32 (ldb (byte 32 32) features))
  (add-status tr 8)
  (logtest (device-status tr) 8))

(defun driver-ok (tr) (add-status tr 4))

(defstruct virtqueue index size desc avail used notify free vector (last-used 0) (lock (sb-thread:make-mutex :name "virtqueue")))

(defun setup-queue (tr index &optional (limit 128))
  (common-write tr 22 16 index)
  (let* ((size (min limit (common-read tr 24 16)))
         (q (make-virtqueue :index index :size size :desc (vm-page-grab) :avail (vm-page-grab) :used (vm-page-grab)
                            :free (loop for i below size collect i)
                            :notify (+ (notify-base tr) (* (common-read tr 30 16) (notify-multiplier tr))))))
    (common-write tr 24 16 size)
    (common-write-64 tr 32 (virtqueue-desc q))
    (common-write-64 tr 40 (virtqueue-avail q))
    (common-write-64 tr 48 (virtqueue-used q))
    (let ((vector (and (< index (msi-x-entries tr)) (allocate-vector))))
      (when vector
        (set-msi-x-vector (msi-x-table tr) index vector)
        (common-write tr 26 16 index)
        (if (= (common-read tr 26 16) index)
            (setf (virtqueue-vector q) vector)
            (free-vector vector))))
    (common-write tr 28 16 1)
    q))

(defun virtqueue-run (q buffers)
  (sb-thread:with-mutex ((virtqueue-lock q))
    (let* ((ids (loop repeat (length buffers) collect (pop (virtqueue-free q))))
           (size (virtqueue-size q)))
      (loop for (pa length writable) in buffers
            for (id . more) on ids
            for at = (+ (virtqueue-desc q) (* 16 id))
            do (ml-phys-write-64 at pa)
               (ml-phys-write-32 (+ at 8) length)
               (ml-phys-write-16 (+ at 12) (logior (if more 1 0) (if writable 2 0)))
               (ml-phys-write-16 (+ at 14) (if more (car more) 0)))
      (let ((idx (ml-phys-read-16 (+ (virtqueue-avail q) 2))))
        (ml-phys-write-16 (+ (virtqueue-avail q) 4 (* 2 (mod idx size))) (first ids))
        (sb-thread:barrier (:write))
        (ml-phys-write-16 (+ (virtqueue-avail q) 2) (ldb (byte 16 0) (1+ idx))))
      (mmio-write (virtqueue-notify q) 16 (virtqueue-index q))
      (loop while (= (ml-phys-read-16 (+ (virtqueue-used q) 2)) (virtqueue-last-used q))
            do (if (virtqueue-vector q)
                   (wait-for-interrupt (list (virtqueue-vector q)) 1)
                   (sb-thread:thread-yield)))
      (sb-thread:barrier (:read))
      (let* ((slot (+ (virtqueue-used q) 4 (* 8 (mod (virtqueue-last-used q) size))))
             (length (ml-phys-read-32 (+ slot 4))))
        (setf (virtqueue-last-used q) (ldb (byte 16 0) (1+ (virtqueue-last-used q))))
        (setf (virtqueue-free q) (append ids (virtqueue-free q)))
        length))))
