(in-package #:darterfly/devices)

(defconstant +trbs+ 256)

(define-device-class xhci-controller "USBXHCI" (device)
  ((base :accessor xhci-base)
   (operational :accessor xhci-operational)
   (runtime :accessor xhci-runtime)
   (doorbells :accessor xhci-doorbells)
   (context-size :accessor xhci-context-size)
   (ports :accessor xhci-ports)
   (dcbaa :accessor xhci-dcbaa)
   (command-ring :accessor xhci-command-ring)
   (event-ring :accessor xhci-event-ring)
   (event-index :initform 0 :accessor xhci-event-index)
   (event-cycle :initform 1 :accessor xhci-event-cycle)
   (vector :initform nil :accessor xhci-vector)
   (results :initform (make-hash-table) :reader xhci-results)
   (endpoints :initform (make-hash-table :test 'equal) :reader xhci-endpoints)
   (lock :initform (sb-thread:make-mutex :name "xhci") :reader xhci-lock)
   (changed-ports :initform nil :accessor xhci-changed-ports)
   (port-slots :initform (make-hash-table) :reader xhci-port-slots)
   (attached :initform (make-hash-table) :reader xhci-attached)))

(add-personality "Class" "USBXHCI" "ProviderClass" "PCIDevice" "PCIClassMatch" "0x000c0330")

(define-device-class usb-hid-device "USBHostHIDDevice" (device)
  ((controller :initarg :controller :reader hid-controller)
   (protocol :initarg :protocol :reader hid-protocol)
   (queue :initform nil :accessor hid-queue)
   (last :initform (make-array 8 :element-type '(unsigned-byte 8) :initial-element 0) :accessor hid-last)))

(defstruct ring page (index 0) (cycle 1))

(defun xr32 (va) (mmio-read va 32))
(defun xw32 (va value) (mmio-write va 32 value))
(defun xw64 (va value) (xw32 va (ldb (byte 32 0) value)) (xw32 (+ va 4) (ldb (byte 32 32) value)))

(defun op (c offset) (+ (xhci-operational c) offset))
(defun portsc (c port) (op c (+ #x400 (* #x10 (1- port)))))

(defun wait-until (test &optional (seconds 2))
  (loop :repeat (round (* seconds 1000))
        :until (funcall test)
        :do (sleep 0.001)
        :finally (return (funcall test))))

(defun new-ring ()
  (let ((page (vm-page-grab)))
    (zero-page page)
    (let ((link (+ page (* 16 (1- +trbs+)))))
      (ml-phys-write-64 link page)
      (ml-phys-write-32 (+ link 12) (logior (ash 6 10) 2)))
    (make-ring :page page)))

(defun ring-push (ring parameter status control)
  (let ((trb (+ (ring-page ring) (* 16 (ring-index ring)))))
    (ml-phys-write-64 trb parameter)
    (ml-phys-write-32 (+ trb 8) status)
    (sb-thread:barrier (:write))
    (ml-phys-write-32 (+ trb 12) (logior control (ring-cycle ring)))
    (incf (ring-index ring))
    (when (= (ring-index ring) (1- +trbs+))
      (let ((link (+ (ring-page ring) (* 16 (1- +trbs+)))))
        (ml-phys-write-32 (+ link 12) (logior (ash 6 10) 2 (ring-cycle ring))))
      (setf (ring-index ring) 0
            (ring-cycle ring) (- 1 (ring-cycle ring))))
    trb))

(defun ring-doorbell (c slot target)
  (sb-thread:barrier (:write))
  (xw32 (+ (xhci-doorbells c) (* 4 slot)) target))

(defun take-ownership (c)
  (let ((offset (* 4 (ldb (byte 16 16) (xr32 (+ (xhci-base c) #x10))))))
    (loop :while (plusp offset)
          :do (let* ((at (+ (xhci-base c) offset))
                     (cap (xr32 at)))
                (when (= (ldb (byte 8 0) cap) 1)
                  (xw32 at (logior cap (ash 1 24)))
                  (wait-until (lambda () (not (logbitp 16 (xr32 at)))) 1)
                  (xw32 (+ at 4) (logand (xr32 (+ at 4)) #xe0000000)))
                (let ((next (ldb (byte 8 8) cap)))
                  (setf offset (if (zerop next) 0 (+ offset (* 4 next)))))))))

(defun process-events (c)
  (sb-thread:with-recursive-lock ((xhci-lock c))
    (loop
      (let* ((trb (+ (xhci-event-ring c) (* 16 (xhci-event-index c))))
             (control (ml-phys-read-32 (+ trb 12))))
        (unless (= (logand control 1) (xhci-event-cycle c)) (return))
        (sb-thread:barrier (:read))
        (let ((type (ldb (byte 6 10) control))
              (parameter (ml-phys-read-64 trb))
              (status (ml-phys-read-32 (+ trb 8))))
          (case type
            (33 (setf (gethash parameter (xhci-results c)) (list (ldb (byte 8 24) status) (ldb (byte 8 24) control))))
            (34 (pushnew (ldb (byte 8 24) parameter) (xhci-changed-ports c)))
            (32 (let ((endpoint (gethash (list (ldb (byte 8 24) control) (ldb (byte 5 16) control)) (xhci-endpoints c))))
                  (if endpoint
                      (funcall endpoint parameter (ldb (byte 8 24) status) (ldb (byte 24 0) status))
                      (setf (gethash parameter (xhci-results c)) (list (ldb (byte 8 24) status) (ldb (byte 24 0) status))))))))
        (incf (xhci-event-index c))
        (when (= (xhci-event-index c) +trbs+)
          (setf (xhci-event-index c) 0 (xhci-event-cycle c) (- 1 (xhci-event-cycle c))))
        (xw64 (+ (xhci-runtime c) #x38) (logior (+ (xhci-event-ring c) (* 16 (xhci-event-index c))) 8))))))

(defun await (c trb)
  (loop :repeat 2000
        :do (process-events c)
            (let ((result (gethash trb (xhci-results c))))
              (when result
                (remhash trb (xhci-results c))
                (return-from await result)))
            (if (xhci-vector c)
                (wait-for-interrupt (list (xhci-vector c)) 0.001)
                (sleep 0.001)))
  (error "xhci: no completion for TRB ~x" trb))

(defun command (c type &key (parameter 0) (slot 0) (extra 0))
  (let* ((trb (sb-thread:with-recursive-lock ((xhci-lock c))
                (ring-push (xhci-command-ring c) parameter 0 (logior (ash type 10) (ash slot 24) extra))))
         (result (progn (ring-doorbell c 0 0) (await c trb))))
    (unless (= (first result) 1)
      (error "xhci: command ~d failed with code ~d" type (first result)))
    (second result)))

(defun control (c slot ring request-type request value index length &optional buffer)
  (let ((in (logtest request-type #x80)))
    (ring-push ring (logior request-type (ash request 8) (ash value 16) (ash index 32) (ash length 48)) 8
               (logior (ash 2 10) (ash 1 6) (ash (cond ((zerop length) 0) (in 3) (t 2)) 16)))
    (when (plusp length)
      (ring-push ring buffer length (logior (ash 3 10) (if in (ash 1 16) 0))))
    (let ((trb (ring-push ring 0 0 (logior (ash 4 10) (ash 1 5) (if (and in (plusp length)) 0 (ash 1 16))))))
      (ring-doorbell c slot 1)
      (let ((result (await c trb)))
        (unless (member (first result) '(1 13))
          (error "xhci: control request ~x failed with code ~d" request (first result)))))))

(defun context (c page index) (+ page (* index (xhci-context-size c))))

(defun port-speed (c port) (ldb (byte 4 10) (xr32 (portsc c port))))

(defun reset-port (c port)
  (let ((at (portsc c port))
        (changes (logior (ash 1 21) (ash 1 19))))
    (xw32 at (logior (logand (xr32 at) #x0e00c3e0) (if (>= (port-speed c port) 4) (ash 1 31) (ash 1 4))))
    (wait-until (lambda () (logtest (xr32 at) changes)) 1)
    (xw32 at (logior (logand (xr32 at) #x0e00c3e0) changes))
    (wait-until (lambda () (logbitp 1 (xr32 at))) 1)))

(defun read-descriptor (c slot ring type index length &optional (language 0))
  (let ((page (vm-page-grab)))
    (control c slot ring #x80 6 (logior (ash type 8) index) language length page)
    (let ((v (make-array length :element-type '(unsigned-byte 8))))
      (dotimes (i length v) (setf (aref v i) (ml-phys-read-8 (+ page i)))))))

(defun interval-for (speed binterval)
  (if (member speed '(3 4))
      (max 0 (1- binterval))
      (max 3 (min 10 (+ 3 (integer-length (max 1 (1- binterval))))))))

(defun address-device (c port)
  (let* ((speed (port-speed c port))
         (slot (command c 9))
         (output (vm-page-grab))
         (input (vm-page-grab))
         (ring (new-ring))
         (mps (case speed (4 512) (3 64) (t 8))))
    (zero-page output)
    (zero-page input)
    (ml-phys-write-64 (+ (xhci-dcbaa c) (* 8 slot)) output)
    (ml-phys-write-32 (+ input 4) 3)
    (let ((slot-ctx (context c input 1)) (ep0 (context c input 2)))
      (ml-phys-write-32 slot-ctx (logior (ash speed 20) (ash 1 27)))
      (ml-phys-write-32 (+ slot-ctx 4) (ash port 16))
      (ml-phys-write-32 (+ ep0 4) (logior (ash 3 1) (ash 4 3) (ash mps 16)))
      (ml-phys-write-64 (+ ep0 8) (logior (ring-page ring) 1))
      (ml-phys-write-32 (+ ep0 16) 8))
    (setf (gethash port (xhci-port-slots c)) slot)
    (command c 11 :parameter input :slot slot)
    (let ((real (aref (read-descriptor c slot ring 1 0 8) 7)))
      (when (and (< speed 3) (/= real mps) (plusp real))
        (zero-page input)
        (ml-phys-write-32 (+ input 4) 2)
        (ml-phys-write-32 (+ (context c input 2) 4) (logior (ash 3 1) (ash 4 3) (ash real 16)))
        (command c 13 :parameter input :slot slot)))
    (values slot ring speed input output)))

(defun start-hid (c slot ring speed input interface protocol endpoint mps binterval)
  (control c slot ring #x21 #x0b 0 interface 0)
  (when (= protocol 1) (ignore-errors (control c slot ring #x21 #x0a 0 interface 0)))
  (let* ((dci (1+ (* 2 (logand endpoint #x0f))))
         (ep-ring (new-ring))
         (buffer (vm-page-grab))
         (device (make-instance 'usb-hid-device :controller c :protocol protocol
                                                   :name (if (= protocol 1) "Keyboard" "Mouse"))))
    (zero-page input)
    (ml-phys-write-32 (+ input 4) (logior 1 (ash 1 dci)))
    (let ((slot-ctx (context c input 1)) (ep (context c input (1+ dci))))
      (ml-phys-write-32 slot-ctx (logior (ash speed 20) (ash dci 27)))
      (ml-phys-write-32 ep (ash (interval-for speed binterval) 16))
      (ml-phys-write-32 (+ ep 4) (logior (ash 3 1) (ash 7 3) (ash mps 16)))
      (ml-phys-write-64 (+ ep 8) (logior (ring-page ep-ring) 1))
      (ml-phys-write-32 (+ ep 16) mps))
    (command c 12 :parameter input :slot slot)
    (flet ((queue-report ()
             (ring-push ep-ring buffer (min mps 64) (logior (ash 1 10) (ash 1 5) (ash 1 2)))
             (ring-doorbell c slot dci)))
      (setf (gethash (list slot dci) (xhci-endpoints c))
            (lambda (trb code residual)
              (declare (ignore trb residual))
              (when (member code '(1 13))
                (let ((report (make-array 8 :element-type '(unsigned-byte 8))))
                  (dotimes (i 8) (setf (aref report i) (ml-phys-read-8 (+ buffer i))))
                  (setf (hid-queue device) (nconc (hid-queue device) (list report)))))
              (queue-report)))
      (queue-report))
    (attach device c)
    (register-service device)))

(defun read-configuration (c slot ring index)
  (let ((head (read-descriptor c slot ring 2 index 9)))
    (read-descriptor c slot ring 2 index (logior (aref head 2) (ash (aref head 3) 8)))))

(defun descriptors (config)
  (loop with at = 0
        while (< (1+ at) (length config))
        for length = (aref config at)
        until (zerop length)
        collect (subseq config at (min (length config) (+ at length)))
        do (incf at length)))

(defun ethernet-configuration-p (config)
  (some (lambda (d) (and (= (aref d 1) 4) (= (aref d 5) 2) (= (aref d 6) 6))) (descriptors config)))

(defun configure-device (c port)
  (multiple-value-bind (slot ring speed input) (address-device c port)
    (let ((configurations (aref (read-descriptor c slot ring 1 0 18) 17)))
      (loop for index below configurations
            for config = (read-configuration c slot ring index)
            when (ethernet-configuration-p config)
              do (return-from configure-device (start-ecm c slot ring speed input config))))
    (let* ((head (read-descriptor c slot ring 2 0 9))
           (config (read-descriptor c slot ring 2 0 (logior (aref head 2) (ash (aref head 3) 8))))
           (configured nil))
      (let ((at 0) (interface nil) (protocol nil))
        (loop :while (< (+ at 1) (length config))
              :do (let ((length (aref config at)) (type (aref config (1+ at))))
                    (when (zerop length) (return))
                    (case type
                      (4 (setf interface (aref config (+ at 2))
                               protocol (and (= (aref config (+ at 5)) 3) (= (aref config (+ at 6)) 1)
                                             (member (aref config (+ at 7)) '(1 2))
                                             (aref config (+ at 7)))))
                      (5 (when (and protocol (logtest (aref config (+ at 2)) #x80) (= (logand (aref config (+ at 3)) 3) 3))
                           (unless configured
                             (control c slot ring 0 9 (aref config 5) 0 0)
                             (setf configured t))
                           (start-hid c slot ring speed input interface protocol (aref config (+ at 2))
                                      (logand (logior (aref config (+ at 4)) (ash (aref config (+ at 5)) 8)) #x7ff)
                                      (aref config (+ at 6)))
                           (setf protocol nil))))
                    (incf at length)))))))

(defmethod start ((c xhci-controller) (d pci-node))
  (let ((map (map-device-memory-with-index d 0)))
    (unless map (return-from start nil))
    (setf (xhci-base c) (map-virtual-address map)))
  (set-memory-enable d t)
  (set-bus-master-enable d t)
  (let* ((base (xhci-base c))
         (params1 (xr32 (+ base 4)))
         (params2 (xr32 (+ base 8)))
         (scratch (logior (ash (ldb (byte 5 21) params2) 5) (ldb (byte 5 27) params2)))
         (slots (ldb (byte 8 0) params1)))
    (setf (xhci-operational c) (+ base (ldb (byte 8 0) (xr32 base)))
          (xhci-runtime c) (+ base (logand (xr32 (+ base #x18)) (lognot #x1f)))
          (xhci-doorbells c) (+ base (logand (xr32 (+ base #x14)) (lognot 3)))
          (xhci-context-size c) (if (logbitp 2 (xr32 (+ base #x10))) 64 32)
          (xhci-ports c) (ldb (byte 8 24) params1))
    (take-ownership c)
    (xw32 (op c 0) (logand (xr32 (op c 0)) (lognot 1)))
    (wait-until (lambda () (logbitp 0 (xr32 (op c 4)))) 1)
    (xw32 (op c 0) 2)
    (wait-until (lambda () (and (not (logbitp 1 (xr32 (op c 0)))) (not (logbitp 11 (xr32 (op c 4)))))) 2)
    (xw32 (op c #x38) slots)
    (let ((dcbaa (vm-page-grab)))
      (zero-page dcbaa)
      (setf (xhci-dcbaa c) dcbaa)
      (when (plusp scratch)
        (let ((array (vm-page-grab)))
          (zero-page array)
          (dotimes (i scratch)
            (let ((page (vm-page-grab))) (zero-page page) (ml-phys-write-64 (+ array (* 8 i)) page)))
          (ml-phys-write-64 dcbaa array)))
      (xw64 (op c #x30) dcbaa))
    (setf (xhci-command-ring c) (new-ring))
    (xw64 (op c #x18) (logior (ring-page (xhci-command-ring c)) 1))
    (let ((events (vm-page-grab)) (table (vm-page-grab)))
      (zero-page events)
      (zero-page table)
      (ml-phys-write-64 table events)
      (ml-phys-write-32 (+ table 8) +trbs+)
      (setf (xhci-event-ring c) events)
      (xw32 (+ (xhci-runtime c) #x28) 1)
      (xw64 (+ (xhci-runtime c) #x38) events)
      (xw64 (+ (xhci-runtime c) #x30) table))
    (multiple-value-bind (table entries) (enable-msi-x d)
      (when (and table entries (plusp entries))
        (let ((vector (allocate-vector)))
          (when vector
            (set-msi-x-vector table 0 vector)
            (setf (xhci-vector c) vector)))))
    (xw32 (+ (xhci-runtime c) #x20) 2)
    (xw32 (op c 0) (logior 1 4))
    (wait-until (lambda () (not (logbitp 0 (xr32 (op c 4))))) 1)
    (sleep 0.2)
    (loop :for port :from 1 :to (xhci-ports c)
          :when (logbitp 0 (xr32 (portsc c port)))
            :do (attach-port c port))
    (register-service c)
    (sb-thread:make-thread #'watch-ports :name "usb ports" :arguments (list c))
    t))

(defun attach-port (c port)
  (let ((before (copy-list (entry-children c))))
    (handler-case
        (when (reset-port c port)
          (configure-device c port)
          (let ((added (remove-if (lambda (child) (member child before)) (entry-children c))))
            (setf (gethash port (xhci-attached c)) added)
            (dolist (device added) (announce :added device))))
      (error (e) (set-property c (format nil "port ~d" port) (princ-to-string e))))))

(defun detach-port (c port)
  (let ((devices (gethash port (xhci-attached c)))
        (slot (gethash port (xhci-port-slots c))))
    (remhash port (xhci-attached c))
    (remhash port (xhci-port-slots c))
    (dolist (device devices)
      (announce :removed device)
      (detach device))
    (when slot
      (sb-thread:with-recursive-lock ((xhci-lock c))
        (loop for key in (loop for k being the hash-keys of (xhci-endpoints c) when (eql (first k) slot) collect k)
              do (remhash key (xhci-endpoints c))))
      (ignore-errors (command c 10 :slot slot))
      (ml-phys-write-64 (+ (xhci-dcbaa c) (* 8 slot)) 0))))

(defun port-changed (c port)
  (let* ((at (portsc c port))
         (value (xr32 at))
         (connected (logbitp 0 value))
         (attached (nth-value 1 (gethash port (xhci-attached c)))))
    (xw32 at (logior (logand value #x0e00c3e0) (logand value #x00fe0000)))
    (cond ((and connected (not attached)) (attach-port c port))
          ((and (not connected) attached) (detach-port c port)))))

(defun watch-ports (c)
  (loop
    (if (xhci-vector c)
        (wait-for-interrupt (list (xhci-vector c)) 1)
        (sleep 0.5))
    (process-events c)
    (dolist (port (sb-thread:with-recursive-lock ((xhci-lock c)) (shiftf (xhci-changed-ports c) nil)))
      (port-changed c port))))

(defmethod interrupt-vector ((d usb-hid-device)) (xhci-vector (hid-controller d)))

(defun hid-reports (device)
  (process-events (hid-controller device))
  (sb-thread:with-recursive-lock ((xhci-lock (hid-controller device)))
    (shiftf (hid-queue device) nil)))
