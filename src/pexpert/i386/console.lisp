(in-package #:finch/pexpert)

(defconstant +physmap-base+ #xFFFF800000000000)
(defconstant +video+ 1192)
(defconstant +foreground+ #x00D8D8D0)
(defconstant +background+ #x00141814)
(defconstant +kbd-data+ #x60)
(defconstant +kbd-status+ #x64)

(define-global console-fb :u64)
(define-global console-pitch :u64)
(define-global console-cols :u64)
(define-global console-rows :u64)
(define-global console-x :u64)
(define-global console-y :u64)
(define-global console-scale :u64)
(define-global console-on :u32 :alignment 4)

(macrolet ((glyphs () `(define-low console-glyphs () ,+console-font+)))
  (glyphs))

(define-low console-fill (y0 rows)
  (let ((y y0))
    (while (< y (+ y0 rows))
      (let ((line (+ console-fb (* y console-pitch)))
            (x 0))
        (while (< x (* console-cols 8 console-scale))
          (setf (mem :u32 (+ line (* x 4))) +background+)
          (incf x)))
      (incf y))))

(define-low console-clear-line (row)
  (console-fill (* row 16 console-scale) (* 16 console-scale)))

(define-low console-glyph (c col row)
  (let ((bits (+ (console-glyphs) (* (logand c 127) 16)))
        (top (* row 16 console-scale))
        (left (* col 8 console-scale))
        (gy 0))
    (while (< gy (* 16 console-scale))
      (let ((b (mem :u8 (+ bits (truncate gy console-scale))))
            (line (+ console-fb (* (+ top gy) console-pitch)))
            (gx 0))
        (while (< gx (* 8 console-scale))
          (setf (mem :u32 (+ line (* (+ left gx) 4)))
                (if (logand b (shr #x80 (truncate gx console-scale))) +foreground+ +background+))
          (incf gx)))
      (incf gy))))

(define-low console-newline ()
  (setf console-x 0)
  (incf console-y)
  (when (>= console-y console-rows) (setf console-y 0))
  (console-clear-line console-y))

(define-low console-putc ((c :u8))
  (unless console-on (result 0))
  (cond ((= c 10) (console-newline))
        ((= c 13) (setf console-x 0))
        ((= c 8)
         (when console-x
           (decf console-x)
           (console-glyph 32 console-x console-y)))
        ((= c 9)
         (setf console-x (logand (+ console-x 8) (lognot 7)))
         (when (>= console-x console-cols) (console-newline)))
        ((and (>= c 32) (< c 127))
         (console-glyph c console-x console-y)
         (incf console-x)
         (when (>= console-x console-cols) (console-newline))))
  0)

(define-low console-init ()
  (let ((width (mem :u32 (+ |PE_boot_args| +video+ 8)))
        (height (mem :u32 (+ |PE_boot_args| +video+ 12)))
        (base (mem :u64 (+ |PE_boot_args| +video+ 48))))
    (unless (and base width height) (result 0))
    (setf console-scale (if (>= width 2560) 2 1))
    (setf console-fb (+ base +physmap-base+))
    (setf console-pitch (mem :u32 (+ |PE_boot_args| +video+ 4)))
    (setf console-cols (truncate width (* 8 console-scale)))
    (setf console-rows (truncate height (* 16 console-scale)))
    (setf console-x 0)
    (setf console-y 0)
    (console-fill 0 height)
    (setf console-on 1)))

(define-low console-off ()
  (setf console-on 0))

(define-global kbd-line :u8 :count 256)
(define-global kbd-length :u64)
(define-global kbd-shift :u32 :alignment 4)
(define-global kbd-control :u32 :alignment 4)
(define-global kbd-caps :u32 :alignment 4)
(define-global kbd-extended :u32 :alignment 4)

(define-low kbd-char ((code :u32))
  (let ((plain "  1234567890-=  qwertyuiop[]  asdfghjkl;'` \\zxcvbnm,./")
        (shifted "  !@#$%^&*()_+  QWERTYUIOP{}  ASDFGHJKL:\"~ |ZXCVBNM<>?"))
    (cond ((= code #x39) 32)
          ((and (>= code 2) (< code 54))
           (let ((c (mem :u8 (+ (if kbd-shift shifted plain) code))))
             (when (= c 32) (result 0))
             (when (and kbd-caps (>= c 97) (<= c 122)) (setf c (- c 32)))
             (when (and kbd-control (>= c 97) (<= c 122)) (setf c (- c 96)))
             c))
          (t 0))))

(define-low kbd-push ((c :u8))
  (when (< (logand (- head tail) #xFFFFFFFF) 4096)
    (setf (ref ring (logand head #xFFF)) c)
    (incf head)))

(define-low kbd-key ((code :u32))
  (let ((up (logand code #x80))
        (key (logand code #x7F)))
    (when kbd-extended
      (setf kbd-extended 0)
      (result 0))
    (when (= code #xE0)
      (setf kbd-extended 1)
      (result 0))
    (cond ((or (= key #x2A) (= key #x36)) (setf kbd-shift (if up 0 1)))
          ((= key #x1D) (setf kbd-control (if up 0 1)))
          (up 0)
          ((= key #x3A) (setf kbd-caps (if kbd-caps 0 1)))
          ((= key #x1C)
           (console-putc 10)
           (let ((i 0))
             (while (< i kbd-length)
               (kbd-push (ref kbd-line i))
               (incf i)))
           (kbd-push 10)
           (setf kbd-length 0))
          ((= key #x0E)
           (when kbd-length
             (decf kbd-length)
             (console-putc 8)))
          (t
           (let ((c (the :u32 (kbd-char key))))
             (cond ((= c 3)
                    (setf kbd-length 0)
                    (console-putc 10)
                    (bsd-console-interrupt-char))
                   ((and c (< kbd-length 255))
                    (setf (ref kbd-line kbd-length) c)
                    (incf kbd-length)
                    (console-putc c))))))))

(define-global kbd-raw :u8 :count 256)
(define-global kbd-raw-head :u32 :alignment 4)
(define-global kbd-raw-tail :u32 :alignment 4)

(define-low keyboard-interrupt ()
  (while (logand (inb +kbd-status+) 1)
    (let ((aux (logand (inb +kbd-status+) #x20))
          (code (inb +kbd-data+)))
      (unless aux
        (if console-on
            (kbd-key code)
            (progn
              (when (< (logand (- kbd-raw-head kbd-raw-tail) #xFFFFFFFF) 256)
                (setf (ref kbd-raw (logand kbd-raw-head #xFF)) code)
                (incf kbd-raw-head))
              (|PE_incoming_interrupt| #x3F)))))))

(define-low keyboard-raw (buffer (max :u32))
  (let ((n 0))
    (while (and (< n max) (/= kbd-raw-tail kbd-raw-head))
      (setf (mem :u8 (+ buffer n)) (ref kbd-raw (logand kbd-raw-tail #xFF)))
      (incf kbd-raw-tail)
      (incf n))
    n))

(define-low keyboard-init ()
  (let ((i 0))
    (while (and (< i 64) (logand (inb +kbd-status+) 1))
      (inb +kbd-data+)
      (incf i))))
