(defpackage #:finch/pexpert
  (:use #:cl #:finch/asm)
  (:export #:serial-object))
(in-package #:finch/pexpert)

(defconstant +com1+ #x3F8)

(defmacro outb (port value)
  `(progn (inst mov :word (reg :word 2) ,port)
          (inst mov :dword (reg :dword 0) ,value)
          (out :byte)))

(defmacro inb (port)
  `(progn (inst mov :word (reg :word 2) ,port)
          (in :byte)))

(defun serial-object ()
  (object
   (list
    (routine "serial_init"
      (outb (+ +com1+ 1) #x00)
      (outb (+ +com1+ 3) #x80)
      (outb (+ +com1+ 0) #x01)
      (outb (+ +com1+ 1) #x00)
      (outb (+ +com1+ 3) #x03)
      (outb (+ +com1+ 2) #xC7)
      (outb (+ +com1+ 4) #x03)
      (inst ret))
    (routine "serial_put_polled"
     wait
      (inb (+ +com1+ 5))
      (inst test :byte (reg :byte 0) #x20)
      (inst jmp :z wait)
      (inst mov :word (reg :word 2) +com1+)
      (inst mov :dword (reg :dword 0) (reg :dword 7))
      (out :byte)
      (inst ret))
    (routine "serial_putc"
      (inst mov :dword (reg :dword 6) (reg :dword 7))
     drain
      (inst mov :dword (reg :dword 0) (data "txtail"))
      (inst cmp :dword (reg :dword 0) (data "txhead"))
      (inst jmp :e done)
      (inst mov :dword (reg :dword 1) (reg :dword 0))
      (inst and :dword (reg :dword 1) #xFFFF)
      (inst lea r8-tn (data "tx"))
      (inst movzx '(:byte :dword) (reg :dword 7) (ea 0 r8-tn rcx-tn))
      (inst add :dword (reg :dword 0) 1)
      (inst mov :dword (data "txtail") (reg :dword 0))
      (inst call (external "serial_put_polled"))
      (inst jmp drain)
     done
      (inst cmp :byte (reg :byte 6) 10)
      (inst jmp :ne emit)
      (inst mov :dword (reg :dword 7) 13)
      (inst call (external "serial_put_polled"))
     emit
      (inst mov :dword (reg :dword 7) (reg :dword 6))
      (inst call (external "serial_put_polled"))
      (inst ret))
    (routine "serial_tx_kick"
     outer
      (inst mov :dword (reg :dword 1) (data "txtail"))
      (inst cmp :dword (reg :dword 1) (data "txhead"))
      (inst jmp :e after)
      (inb (+ +com1+ 5))
      (inst test :byte (reg :byte 0) #x20)
      (inst jmp :z after)
      (inst mov :dword (reg :dword 6) 16)
     inner
      (inst mov :dword (reg :dword 1) (data "txtail"))
      (inst cmp :dword (reg :dword 1) (data "txhead"))
      (inst jmp :e outer)
      (inst mov :dword (reg :dword 0) (reg :dword 1))
      (inst and :dword (reg :dword 0) #xFFFF)
      (inst lea r8-tn (data "tx"))
      (inst movzx '(:byte :dword) (reg :dword 0) (ea 0 r8-tn rax-tn))
      (inst mov :word (reg :word 2) +com1+)
      (out :byte)
      (inst add :dword (reg :dword 1) 1)
      (inst mov :dword (data "txtail") (reg :dword 1))
      (inst sub :dword (reg :dword 6) 1)
      (inst jmp :nz inner)
      (inst jmp outer)
     after
      (inst lea r8-tn (data "interrupts_on"))
      (inst cmp :dword (ea 0 r8-tn) 0)
      (inst jmp :e finish)
      (inst mov :dword (reg :dword 1) (data "txtail"))
      (inst mov :dword (reg :dword 0) 1)
      (inst cmp :dword (reg :dword 1) (data "txhead"))
      (inst jmp :e send)
      (inst mov :dword (reg :dword 0) 3)
     send
      (inst mov :word (reg :word 2) (+ +com1+ 1))
      (out :byte)
     finish
      (inst ret))
    (routine "serial_tx_room"
      (inst mov :dword (reg :dword 0) (data "txhead"))
      (inst sub :dword (reg :dword 0) (data "txtail"))
      (inst cmp :dword (reg :dword 0) (- 65536 2))
      (inst set :b (reg :byte 0))
      (inst movzx '(:byte :dword) (reg :dword 0) (reg :byte 0))
      (inst ret))
    (routine "serial_write"
      (inst lea r8-tn (data "interrupts_on"))
      (inst cmp :dword (ea 0 r8-tn) 0)
      (inst jmp :ne buffered)
      (inst call (external "serial_putc"))
      (inst ret)
     buffered
      (inst lea r8-tn (data "tx"))
      (inst mov :dword (reg :dword 0) (data "txhead"))
      (inst cmp :byte (reg :byte 7) 10)
      (inst jmp :ne plain)
      (inst mov :dword (reg :dword 1) (reg :dword 0))
      (inst and :dword (reg :dword 1) #xFFFF)
      (inst mov :byte (ea 0 r8-tn rcx-tn) 13)
      (inst add :dword (reg :dword 0) 1)
     plain
      (inst mov :dword (reg :dword 1) (reg :dword 0))
      (inst and :dword (reg :dword 1) #xFFFF)
      (inst mov :byte (ea 0 r8-tn rcx-tn) (reg :byte 7))
      (inst add :dword (reg :dword 0) 1)
      (inst mov :dword (data "txhead") (reg :dword 0))
      (inst ret))
    (routine "serial_enable_interrupts"
      (outb (+ +com1+ 1) #x01)
      (outb (+ +com1+ 4) #x0B)
      (inst lea r8-tn (data "interrupts_on"))
      (inst mov :dword (ea 0 r8-tn) 1)
      (inst ret))
    (routine "serial_interrupt"
     next
      (inb (+ +com1+ 5))
      (inst test :byte (reg :byte 0) 1)
      (inst jmp :z done)
      (inb +com1+)
      (inst cmp :byte (reg :byte 0) 3)
      (inst jmp :ne store)
      (inst call (external "bsd_console_interrupt_char"))
      (inst jmp next)
     store
      (inst mov :dword (reg :dword 1) (data "head"))
      (inst mov :dword (reg :dword 6) (reg :dword 1))
      (inst sub :dword (reg :dword 6) (data "tail"))
      (inst cmp :dword (reg :dword 6) 4096)
      (inst jmp :ae next)
      (inst mov :dword (reg :dword 6) (reg :dword 1))
      (inst and :dword (reg :dword 6) #xFFF)
      (inst lea r8-tn (data "ring"))
      (inst mov :byte (ea 0 r8-tn rsi-tn) (reg :byte 0))
      (inst add :dword (reg :dword 1) 1)
      (inst mov :dword (data "head") (reg :dword 1))
      (inst jmp next)
     done
      (inst call (external "serial_tx_kick"))
      (inst ret))
    (routine "serial_ready"
      (inst lea r8-tn (data "interrupts_on"))
      (inst cmp :dword (ea 0 r8-tn) 0)
      (inst jmp :ne ring)
      (inb (+ +com1+ 5))
      (inst movzx '(:byte :dword) (reg :dword 0) (reg :byte 0))
      (inst and :dword (reg :dword 0) 1)
      (inst ret)
     ring
      (inst mov :dword (reg :dword 0) (data "head"))
      (inst cmp :dword (reg :dword 0) (data "tail"))
      (inst set :ne (reg :byte 0))
      (inst movzx '(:byte :dword) (reg :dword 0) (reg :byte 0))
      (inst ret))
    (routine "serial_getc"
      (inst lea r8-tn (data "interrupts_on"))
      (inst cmp :dword (ea 0 r8-tn) 0)
      (inst jmp :ne ring)
     poll
      (inb (+ +com1+ 5))
      (inst test :byte (reg :byte 0) 1)
      (inst jmp :nz got)
      (inst pause)
      (inst jmp poll)
     got
      (inb +com1+)
      (inst movzx '(:byte :dword) (reg :dword 0) (reg :byte 0))
      (inst ret)
     ring
      (inst mov :dword (reg :dword 1) (data "tail"))
      (inst cmp :dword (reg :dword 1) (data "head"))
      (inst jmp :ne take)
      (inst mov :dword (reg :dword 0) -1)
      (inst ret)
     take
      (inst mov :dword (reg :dword 0) (reg :dword 1))
      (inst and :dword (reg :dword 0) #xFFF)
      (inst lea r8-tn (data "ring"))
      (inst movzx '(:byte :dword) (reg :dword 0) (ea 0 r8-tn rax-tn))
      (inst add :dword (reg :dword 1) 1)
      (inst mov :dword (data "tail") (reg :dword 1))
      (inst ret)))
   :bss '(("tx" 65536 64) ("txhead" 4 4) ("txtail" 4 4) ("interrupts_on" 4 4)
          ("ring" 4096 64) ("head" 4 4) ("tail" 4 4))))
