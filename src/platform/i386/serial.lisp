(defpackage #:darterfly/platform
  (:use #:cl #:darterfly/low)
  (:export #:platform-object))
(in-package #:darterfly/platform)

(defconstant +com1+ #x3F8)
(defconstant +lsr+ (+ +com1+ 5))
(defconstant +ier+ (+ +com1+ 1))

(define-global tx :u8 :count 65536 :alignment 64)
(define-global txhead :u32 :alignment 4)
(define-global txtail :u32 :alignment 4)
(define-global interrupts-on :u32 :alignment 4)
(define-global ring :u8 :count 4096 :alignment 64)
(define-global head :u32 :alignment 4)
(define-global tail :u32 :alignment 4)
(defconstant +log-magic+ #x676F6C796C667264)

(define-global log-ring :u8 :count 262144 :alignment 64)
(define-global log-head :u32 :alignment 4)
(define-global log-epoch :u64)
(define-global log-base :u64)
(define-global log-head-at :u64)
(define-global log-header :u64)
(define-global log-previous :u8 :count 262144 :alignment 64)
(define-global log-previous-size :u64)

(define-low log-putc ((c :u8))
  (when log-base
    (setf (mem :u8 (+ log-base (logand (fetch-add log-head-at 1) #x3FFFF))) c)))

(define-low log-start ()
  (setf log-epoch (rdtsc))
  (setf log-head-at (address log-head))
  (setf log-base (address log-ring)))

(define-low log-started ()
  log-epoch)

(define-low log-keep (va size)
  (when (< size (+ 4096 262144)) (result 0))
  (when (= (mem :u64 va) +log-magic+)
    (let* ((head (mem :u32 (+ va 16)))
           (from (mem :u32 (+ va 20)))
           (n (logand (- head from) #xFFFFFFFF))
           (i 0))
      (when (> n 262144)
        (setf from (logand (- head 262144) #xFFFFFFFF))
        (setf n 262144))
      (while (< i n)
        (setf (ref log-previous i) (mem :u8 (+ va 4096 (logand (+ from i) #x3FFFF))))
        (incf i))
      (setf log-previous-size n)))
  (let ((i 0))
    (while (< i log-head)
      (setf (mem :u8 (+ va 4096 i)) (ref log-ring i))
      (incf i)))
  (setf (mem :u32 (+ va 16)) log-head)
  (setf (mem :u32 (+ va 20)) 0)
  (setf (mem :u64 (+ va 8)) log-epoch)
  (setf (mem :u64 va) +log-magic+)
  (setf log-base (+ va 4096))
  (setf log-head-at (+ va 16))
  (setf log-header va)
  1)

(define-low log-drained (position)
  (when log-header
    (setf (mem :u32 (+ log-header 20)) position))
  0)

(define-low log-read (from buffer count)
  (let ((i 0))
    (while (< i count)
      (setf (mem :u8 (+ buffer i)) (mem :u8 (+ log-base (logand (+ from i) #x3FFFF))))
      (incf i)))
  (mem :u32 log-head-at))

(define-low log-previous-read (buffer count)
  (let ((i 0))
    (while (and (< i count) (< i log-previous-size))
      (setf (mem :u8 (+ buffer i)) (ref log-previous i))
      (incf i)))
  log-previous-size)

(define-low serial-init ()
  (outb +ier+ #x00)
  (outb (+ +com1+ 3) #x80)
  (outb +com1+ #x01)
  (outb +ier+ #x00)
  (outb (+ +com1+ 3) #x03)
  (outb (+ +com1+ 2) #xC7)
  (outb (+ +com1+ 4) #x03))

(define-low serial-put-polled ((c :u8))
  (while (= (logand (inb +lsr+) #x20) 0))
  (outb +com1+ c))

(define-low serial-putc ((c :u8))
  (while (/= txhead txtail)
    (serial-put-polled (ref tx (logand txtail #xFFFF)))
    (incf txtail))
  (when (= c 10) (serial-put-polled 13))
  (serial-put-polled c)
  (log-putc c)
  (console-putc c))

(define-low serial-tx-kick ()
  (while (and (/= txhead txtail) (/= (logand (inb +lsr+) #x20) 0))
    (let ((i 0))
      (while (and (< i 16) (/= txhead txtail))
        (outb +com1+ (ref tx (logand txtail #xFFFF)))
        (incf txtail)
        (incf i))))
  (when interrupts-on
    (outb +ier+ (if (/= txhead txtail) 3 1))))

(define-low serial-tx-room ()
  (< (logand (- txhead txtail) #xFFFFFFFF) (- 65536 2)))

(define-low serial-write ((c :u8))
  (if (not interrupts-on)
      (serial-putc c)
      (progn
        (when (= c 10)
          (setf (ref tx (logand txhead #xFFFF)) 13)
          (incf txhead))
        (setf (ref tx (logand txhead #xFFFF)) c)
        (incf txhead)
        (log-putc c)
        (console-putc c))))

(define-low serial-enable-interrupts ()
  (outb +ier+ #x01)
  (outb (+ +com1+ 4) #x0B)
  (setf interrupts-on 1))

(define-low serial-interrupt ()
  (while (/= (logand (inb +lsr+) 1) 0)
    (let ((c (inb +com1+)))
      (if (= c 3)
          (bsd-console-interrupt-char)
          (when (< (logand (- head tail) #xFFFFFFFF) 4096)
            (setf (ref ring (logand head #xFFF)) c)
            (incf head)))))
  (serial-tx-kick))

(define-low serial-ready ()
  (if (not interrupts-on)
      (logand (inb +lsr+) 1)
      (/= head tail)))

(define-low serial-getc ()
  (if (not interrupts-on)
      (progn
        (while (= (logand (inb +lsr+) 1) 0) (pause))
        (inb +com1+))
      (if (= head tail)
          -1
          (let ((c (ref ring (logand tail #xFFF))))
            (incf tail)
            c))))

