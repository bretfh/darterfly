(in-package #:darterfly/install)

(defparameter *boot-payload* "/usr/lib/darterfly/boot/")
(defparameter *skipped* '("/dev" "/proc" "/tmp" "/Volumes" "/System/Library/Kernels"))

(defun internal-disk ()
  (find-if (lambda (m) (and (darterfly/devices:get-property m "Whole")
                            (typep (darterfly/devices:media-device m) 'darterfly/devices::nvme-disk)))
           (darterfly/devices:find-entries 'darterfly/devices:media)))

(defun file-octets (path)
  (let ((fd (darterfly/vfs:vfs-open path (list :access :rdonly) 0)))
    (unwind-protect (darterfly/vfs:vfs-read fd (darterfly/vfs:vattr-size (darterfly/vfs:vfs-fstat fd)))
      (darterfly/vfs:vfs-close fd))))

(defun children (dir)
  (let ((fd (darterfly/vfs:vfs-open dir (list :access :rdonly) 0)))
    (unwind-protect (loop for i from 0
                          for entry = (darterfly/vfs:vfs-readdir fd i)
                          while entry
                          unless (member (car entry) '("." "..") :test #'string=)
                            collect (car entry))
      (darterfly/vfs:vfs-close fd))))

(defparameter *copy-chunk* (ash 1 20))
(defparameter *commit-every* (ash 64 20))

(defun copy-file (from to mode)
  (let ((in (darterfly/vfs:vfs-open from (list :access :rdonly) 0))
        (out (darterfly/vfs:vfs-open to (list :access :wronly :creat t :trunc t) mode))
        (copied 0))
    (unwind-protect
         (loop :for chunk := (darterfly/vfs:vfs-read in *copy-chunk* copied)
               :while (plusp (length chunk))
               :do (darterfly/vfs:vfs-write out chunk copied)
                   (incf copied (length chunk)))
      (darterfly/vfs:vfs-close in)
      (darterfly/vfs:vfs-close out))
    copied))

(defparameter *left-behind* '("Library/Settings/setup-pending" "Users/darterfly/Library/Preferences/desktop.sexp"
                              "Users/darterfly/Library/Preferences/desktop.sexp.new"))

(defun copy-system (root target &key skip (progress (lambda (bytes) bytes)))
  (let ((copied 0) (since-commit 0))
    (labels ((walk (dir rel)
               (dolist (name (sort (children dir) #'string<))
                 (let* ((path (concatenate 'string (string-right-trim "/" dir) "/" name))
                        (rel (if (string= rel "") name (concatenate 'string rel "/" name)))
                        (to (concatenate 'string target "/" rel))
                        (mode (darterfly/vfs:vattr-mode (darterfly/vfs:vfs-stat path :follow nil))))
                   (unless (or (member path skip :test #'string=) (member rel *left-behind* :test #'string=))
                     (case (logand mode #o170000)
                       (#o040000 (darterfly/vfs:vfs-mkdir to (logand mode #o7777)) (walk path rel))
                       (#o100000 (let ((n (copy-file path to (logand mode #o7777))))
                                   (incf copied n)
                                   (incf since-commit n)
                                   (when (> since-commit *commit-every*)
                                     (darterfly/vfs:vfs-sync)
                                     (setf since-commit 0)
                                     (funcall progress copied))))
                       (#o120000 (darterfly/vfs:vfs-symlink (darterfly/vfs:vfs-readlink path) to))))))))
      (walk root ""))
    copied))

(defun new-uuid ()
  (let ((state (make-random-state t)))
    (format nil "~:@(~8,'0x-~4,'0x-4~3,'0x-~4,'0x-~12,'0x~)"
            (random (ash 1 32) state) (random (ash 1 16) state) (random (ash 1 12) state)
            (logior #x8000 (random (ash 1 14) state)) (random (ash 1 48) state))))

(defun boot-conf (boot-args)
  (format nil "kernel-flags=~a -- --core /System/Library/Kernels/darterfly.core~%ramdisk=/System/Library/RAMDisk/root.cpio~%" boot-args))

(defun esp-entries (boot-args)
  (flet ((payload (name) (file-octets (concatenate 'string *boot-payload* name))))
    (let ((loader (payload "boot.efi")))
      (list (list :dir "EFI") (list :dir "EFI/BOOT") (list :file "EFI/BOOT/BOOTX64.EFI" loader)
            (list :dir "EFI/darterfly") (list :dir "EFI/darterfly/gen-1")
            (list :file "EFI/darterfly/gen-1/kernel" (payload "kernel"))
            (list :file "EFI/darterfly/gen-1/darterfly.core" (payload "darterfly.core"))
            (list :dir "System") (list :dir "System/Library") (list :dir "System/Library/RAMDisk")
            (list :file "System/Library/RAMDisk/root.cpio" (payload "root.cpio"))
            (list :file "EFI/darterfly/boot.conf" (sb-ext:string-to-octets (boot-conf boot-args)))))))

(defparameter *target* "/Volumes/darterfly-install")

(defun install-disk (&key (disk (internal-disk)) (esp-size (* 1024 1048576))
                          (progress (lambda (step) (declare (ignore step)))))
  (unless disk (error "install: no internal disk"))
  (let* ((sectors (floor (darterfly/devices:get-property disk "Size") 512))
         (esp-first 2048)
         (esp-last (+ esp-first (floor esp-size 512) -1))
         (root-first (* 2048 (ceiling (1+ esp-last) 2048)))
         (root-last (- sectors 34))
         (root-size (* 4096 (floor (* (- root-last root-first -1) 512) 4096)))
         (uuid (new-uuid))
         (key (darterfly/devices:boot-arg "nrepl-key"))
         (boot-args (format nil "rd=uuid:~a init~@[ nrepl-key=~a~]" uuid (and (stringp key) key))))
    (when (< root-size (* 1024 1048576)) (error "install: the disk is too small"))
    (darterfly/vfs:vfs-sync)
    (flet ((at (offset) (lambda (at octets) (darterfly/devices:media-write disk (+ offset at) octets)))
           (from (offset) (lambda (at length) (darterfly/devices:media-read disk (+ offset at) length)))
           (flush () (darterfly/devices:media-flush disk)))
      (funcall progress "Partitioning")
      (darterfly/gpt:write-table (at 0) sectors
                                 (list (list darterfly/gpt:+esp-type+ (new-uuid) "EFI" esp-first esp-last)
                                       (list darterfly/gpt:+apfs-type+ (new-uuid) "darterfly" root-first root-last)))
      (funcall progress "Formatting")
      (let ((offset (* esp-first 512)))
        (darterfly/fat::format-volume (from offset) (darterfly/fat::whole-blocks (from offset) (at offset)) esp-size "EFI"))
      (darterfly/apfs:newfs (at (* root-first 512)) :size root-size :volume-name "darterfly" :volume-uuid uuid
                                                    :container-uuid (new-uuid))
      (flush)
      (funcall progress "Copying the system")
      (darterfly/vfs:vfs-mkdirs *target*)
      (darterfly/apfs:mount-writable (from (* root-first 512)) (at (* root-first 512)) *target* #'flush)
      (unwind-protect
           (progn
             (copy-system "/" *target* :skip (cons *target* *skipped*)
                                     :progress (lambda (bytes)
                                                 (funcall progress (format nil "Copying the system: ~d MB" (round bytes 1048576)))))
             (darterfly/vfs:vfs-mkdirs (concatenate 'string *target* "/Library/Settings"))
             (with-open-file (s (concatenate 'string *target* "/Library/Settings/setup-pending") :direction :output :if-exists :supersede)
               (write-line "1" s))
             (darterfly/vfs:vfs-sync))
        (darterfly/vfs:vfs-unmount *target*))
      (flush)
      (funcall progress "Writing the boot partition")
      (let* ((offset (* esp-first 512))
             (v (darterfly/fat::open-volume (from offset) (darterfly/fat::whole-blocks (from offset) (at offset)))))
        (darterfly/fat::with-volume (v) (darterfly/fat::put-entries v (esp-entries boot-args)))
        (flush)
        (darterfly/fat::with-volume (v)
          (darterfly/fat::put-entries v (list (list :file "EFI/darterfly/current" (sb-ext:string-to-octets (format nil "gen-1~%"))))))
        (flush))
      (funcall progress "Done")
      uuid)))
