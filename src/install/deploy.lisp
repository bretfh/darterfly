(in-package #:finch/install)

(defparameter *deploy-dir* "/Users/finch/deploy/")

(defun read-header (stream)
  (let ((octets (loop for b = (read-byte stream nil)
                      until (or (null b) (= b 10))
                      collect b)))
    (and octets (map 'string #'code-char octets))))

(defun read-octets (stream length)
  (let ((v (make-array length :element-type '(unsigned-byte 8))))
    (loop with at = 0
          while (< at length)
          do (let ((n (read-sequence v stream :start at)))
               (when (= n at) (error "deploy: stream ended inside a file"))
               (setf at n)))
    v))

(defun same-octets-p (path octets)
  (let ((attr (ignore-errors (finch/vfs:vfs-stat path))))
    (and attr (= (finch/vfs:vattr-size attr) (length octets))
         (let ((fd (finch/vfs:vfs-open path (list :access :rdonly) 0)))
           (unwind-protect (equalp (finch/vfs:vfs-read fd (length octets)) octets)
             (finch/vfs:vfs-close fd))))))

(defun put-octets (path octets mode)
  (unless (same-octets-p path octets)
    (ensure-directories-exist path)
    (let ((fd (finch/vfs:vfs-open path (list :access :wronly :creat t :trunc t) mode)))
      (unwind-protect (finch/vfs:vfs-write fd octets)
        (finch/vfs:vfs-close fd)))
    t))

(defun deployed-boot-conf ()
  (let ((flags (subseq (finch/devices:kernel-flags) 0 (search " -- " (finch/devices:kernel-flags)))))
    (format nil "kernel-flags=~{~a~^ ~} -- --core /System/Library/Kernels/finch.core~%ramdisk=/System/Library/RAMDisk/root.cpio~%"
            (substitute "init" "launchd" (uiop:split-string flags :separator " ") :test #'string=))))

(defun receive-deployment (host port)
  (let ((socket (make-instance 'sb-bsd-sockets:inet-socket :type :stream :protocol :tcp))
        (written 0) (kept 0))
    (sb-bsd-sockets:socket-connect socket (sb-bsd-sockets:make-inet-address host) port)
    (unwind-protect
         (let ((stream (sb-bsd-sockets:socket-make-stream socket :input t :element-type '(unsigned-byte 8) :buffering :full)))
           (loop for header = (read-header stream)
                 until (or (null header) (string= header "end"))
                 do (destructuring-bind (kind length mode &rest path) (uiop:split-string header :separator " ")
                      (let ((path (format nil "~{~a~^ ~}" path))
                            (octets (read-octets stream (parse-integer length))))
                        (if (if (string= kind "gen")
                                (put-octets (concatenate 'string *deploy-dir* path) octets #o644)
                                (put-octets (concatenate 'string "/" path) octets (parse-integer mode :radix 8)))
                            (incf written)
                            (incf kept))))))
      (sb-bsd-sockets:socket-close socket))
    (finch/vfs:vfs-sync)
    (let ((name (install (concatenate 'string *deploy-dir* "kernel") (concatenate 'string *deploy-dir* "finch.core")
                         :loader (concatenate 'string *deploy-dir* "boot.efi"))))
      (with-open-file (s (esp-path "boot.conf") :direction :output :if-exists :supersede)
        (write-string (deployed-boot-conf) s))
      (flush-disks)
      (list :generation name :written written :unchanged kept))))

(defun flush-disks ()
  (finch/vfs:vfs-sync)
  (dolist (m (finch/devices:find-entries 'finch/devices:media))
    (when (finch/devices:get-property m "Whole")
      (ignore-errors (finch/devices:media-flush m)))))

(defun restart-machine ()
  (flush-disks)
  (finch/devices:machdep 26))

(defun restart-soon (&optional (seconds 2))
  (sb-thread:make-thread (lambda () (sleep seconds) (restart-machine)) :name "restart")
  :restarting)
