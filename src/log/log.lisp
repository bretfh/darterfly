(defpackage #:darterfly/log
  (:use #:cl)
  (:export #:*system-log* #:start-log #:drain #:tail))
(in-package #:darterfly/log)

(defparameter *system-log* "/Library/Logs/system")
(defparameter *kept-size* (* 4 1024 1024))
(defconstant +ring-size+ 262144)
(defconstant +readable+ (- +ring-size+ 4096))

(defvar *epoch* nil)
(defvar *position* 0)
(defvar *partial* "")
(defvar *saved* 0)
(defvar *previous* nil)
(defvar *log-lock* (sb-thread:make-mutex :name "system log"))
(defvar *logger* nil)

(defun machdep (n &optional (a 0) (b 0) (c 0))
  (sb-alien:alien-funcall
   (sb-alien:extern-alien "__machdep5" (function sb-alien:unsigned-long sb-alien:long sb-alien:unsigned-long sb-alien:unsigned-long
                                                 sb-alien:unsigned-long sb-alien:unsigned-long sb-alien:unsigned-long))
   n a b c 0 0))

(defun read-ring ()
  (let ((epoch (machdep 70))
        (lost 0))
    (unless (eql epoch *epoch*)
      (setf *epoch* epoch *position* 0 *saved* 0 *partial* "" *previous* (previous-boot)))
    (let ((n (ldb (byte 32 0) (- (machdep 69) *position*))))
      (when (> n +readable+)
        (setf lost (- n +readable+)
              *position* (ldb (byte 32 0) (+ *position* lost))
              n +readable+))
      (let ((buffer (make-array n :element-type '(unsigned-byte 8))))
        (when (plusp n)
          (sb-sys:with-pinned-objects (buffer)
            (machdep 69 *position* (sb-sys:sap-int (sb-sys:vector-sap buffer)) n))
          (setf *position* (ldb (byte 32 0) (+ *position* n))))
        (values buffer lost)))))

(defun previous-boot ()
  (let* ((n (machdep 72))
         (buffer (make-array n :element-type '(unsigned-byte 8))))
    (when (plusp n)
      (sb-sys:with-pinned-objects (buffer)
        (machdep 72 (sb-sys:sap-int (sb-sys:vector-sap buffer)) n))
      (sb-ext:octets-to-string buffer :external-format '(:utf-8 :replacement #\?)))))

(defun lines (text)
  (mapcar (lambda (line) (string-right-trim '(#\Return) line))
          (uiop:split-string (string-right-trim '(#\Newline) text) :separator '(#\Newline))))

(defun stamp ()
  (multiple-value-bind (s m h day month year) (decode-universal-time (get-universal-time))
    (format nil "~d-~2,'0d-~2,'0d ~2,'0d:~2,'0d:~2,'0d " year month day h m s)))

(defun rotate ()
  (let ((size (ignore-errors (with-open-file (s *system-log*) (file-length s)))))
    (when (and size (> size *kept-size*))
      (let ((old (concatenate 'string *system-log* ".0")))
        (when (probe-file old) (delete-file old))
        (rename-file *system-log* old)))))

(defun drain ()
  (sb-thread:with-mutex (*log-lock*)
    (multiple-value-bind (octets lost) (read-ring)
      (machdep 71 *saved*)
      (let* ((text (concatenate 'string *partial* (sb-ext:octets-to-string octets :external-format '(:utf-8 :replacement #\?))))
             (end (position #\Newline text :from-end t))
             (previous (shiftf *previous* nil)))
        (setf *partial* (if end (subseq text (1+ end)) text))
        (when (or end (plusp lost) previous)
          (rotate)
          (ensure-directories-exist *system-log*)
          (with-open-file (s *system-log* :direction :output :if-exists :append :if-does-not-exist :create)
            (let ((stamp (stamp)))
              (when previous
                (format s "~alog: the last boot ended before these lines were saved:~%" stamp)
                (dolist (line (lines previous))
                  (format s "~a| ~a~%" stamp line)))
              (when (plusp lost)
                (format s "~alog: ~d bytes lost~%" stamp lost))
              (when end
                (dolist (line (lines (subseq text 0 end)))
                  (write-string stamp s)
                  (write-line line s))))))
        (setf *saved* (ldb (byte 32 0) (- *position* (length (sb-ext:string-to-octets *partial* :external-format :utf-8)))))))))

(defun start-log (&optional (interval 1))
  (unless (and *logger* (sb-thread:thread-alive-p *logger*))
    (setf *logger*
          (sb-thread:make-thread
           (lambda ()
             (let ((last nil))
               (loop (handler-case (progn (drain) (setf last nil))
                       (error (e)
                         (let ((text (princ-to-string e)))
                           (unless (equal text last)
                             (setf last text)
                             (format *error-output* "~&log: ~a~%" text)))))
                     (sleep interval))))
           :name "system log"))))

(defun tail (&optional (lines 40))
  (ignore-errors (drain))
  (with-open-file (s *system-log* :element-type '(unsigned-byte 8) :if-does-not-exist nil)
    (if (null s)
        ""
        (let* ((length (file-length s))
               (from (max 0 (- length (* lines 400))))
               (octets (make-array (- length from) :element-type '(unsigned-byte 8))))
          (file-position s from)
          (let* ((text (sb-ext:octets-to-string octets :end (read-sequence octets s) :external-format '(:utf-8 :replacement #\?)))
                 (all (uiop:split-string (string-right-trim '(#\Newline) text) :separator '(#\Newline))))
            (format nil "~{~a~%~}" (last all lines)))))))
