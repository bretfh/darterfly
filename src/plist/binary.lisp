(in-package #:finch/plist)

(defun be (octets start count)
  (loop :with n := 0
        :for i :from start :below (+ start count)
        :do (setf n (logior (ash n 8) (aref octets i)))
        :finally (return n)))

(defun signed (n bits)
  (if (logbitp (1- bits) n) (- n (ash 1 bits)) n))

(defun utf-16be (octets start units)
  (with-output-to-string (s)
    (loop :with i := 0
          :while (< i units)
          :do (let ((u (be octets (+ start (* 2 i)) 2)))
                (incf i)
                (if (and (<= #xd800 u #xdbff) (< i units))
                    (let ((lo (be octets (+ start (* 2 i)) 2)))
                      (incf i)
                      (write-char (code-char (+ #x10000 (ash (- u #xd800) 10) (- lo #xdc00))) s))
                    (write-char (code-char u) s))))))

(defun ieee (bits size)
  (ecase size
    (4 (sb-kernel:make-single-float (signed bits 32)))
    (8 (sb-kernel:make-double-float (signed (ldb (byte 32 32) bits) 32)
                                    (ldb (byte 32 0) bits)))))

(defun read-binary-plist (source)
  (let* ((o (file-octets source))
         (n (length o)))
    (unless (and (starts-with o "bplist00") (>= n 40))
      (bad "no bplist00 header"))
    (let* ((trailer (- n 32))
           (offset-size (aref o (+ trailer 6)))
           (ref-size (aref o (+ trailer 7)))
           (count (be o (+ trailer 8) 8))
           (top (be o (+ trailer 16) 8))
           (table (be o (+ trailer 24) 8))
           (seen (make-array count :initial-element '#1=#:unread)))
      (labels ((offset (i)
                 (be o (+ table (* i offset-size)) offset-size))
               (ref (at k)
                 (be o (+ at (* k ref-size)) ref-size))
               (int-at (at)
                 (let ((size (ash 1 (ldb (byte 4 0) (aref o at)))))
                   (values (let ((v (be o (1+ at) size)))
                             (if (>= size 8) (signed v (* 8 size)) v))
                           (+ at 1 size))))
               (span (at)
                 (let ((low (ldb (byte 4 0) (aref o at))))
                   (if (= low 15)
                       (int-at (1+ at))
                       (values low (1+ at)))))
               (object (i)
                 (when (>= i count) (bad "object ~d of ~d" i count))
                 (let ((v (aref seen i)))
                   (if (eq v '#1#)
                       (setf (aref seen i) (decode (offset i)))
                       v)))
               (decode (at)
                 (let ((marker (aref o at)))
                   (case (ldb (byte 4 4) marker)
                     (0 (case marker
                          (#x00 +null+)
                          (#x08 nil)
                          (#x09 t)
                          (t (bad "marker #x~2,'0x" marker))))
                     (1 (values (int-at at)))
                     (2 (let ((size (ash 1 (ldb (byte 4 0) marker))))
                          (ieee (be o (1+ at) size) size)))
                     (3 (make-date (ieee (be o (1+ at) 8) 8)))
                     (4 (multiple-value-bind (len start) (span at)
                          (subseq o start (+ start len))))
                     (5 (multiple-value-bind (len start) (span at)
                          (map 'string #'code-char (subseq o start (+ start len)))))
                     (6 (multiple-value-bind (len start) (span at)
                          (utf-16be o start len)))
                     (8 (make-uid (be o (1+ at) (1+ (ldb (byte 4 0) marker)))))
                     ((10 12)
                      (multiple-value-bind (len start) (span at)
                        (let ((v (make-array len)))
                          (dotimes (k len v)
                            (setf (aref v k) (object (ref start k)))))))
                     (13
                      (multiple-value-bind (len start) (span at)
                        (let ((h (make-hash-table :test 'equal :size (max len 1))))
                          (dotimes (k len h)
                            (setf (gethash (object (ref start k)) h)
                                  (object (ref start (+ k len))))))))
                     (t (bad "marker #x~2,'0x" marker))))))
        (object top)))))
