(setf sb-sys::*sbcl-homedir-pathname* (probe-file "../../obj/sbcl-home/"))

(shadow '("RUN-PROGRAM" "PROCESS-STATUS"))

(defun run-program (program files &key output &allow-other-keys)
  (declare (ignore program))
  (with-open-file (out output :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
    (dolist (file files)
      (with-open-file (in file :element-type '(unsigned-byte 8))
        (let ((octets (make-array (file-length in) :element-type '(unsigned-byte 8))))
          (read-sequence octets in)
          (write-sequence octets out)))))
  0)

(defun process-status (code) code)

(defun grovel-c (inputs output)
  (unless (probe-file output)
    (let ((headers nil) (definitions nil) (package nil))
      (dolist (input inputs)
        (setf package (cdr input))
        (with-open-file (stream (merge-pathnames (make-pathname :type "lisp") (car input)))
          (setf headers (nconc headers (read stream))
                definitions (nconc definitions (read stream)))))
      (with-open-file (stream (merge-pathnames "runme.c" output) :direction :output :if-exists :supersede)
        (funcall (find-symbol "PRINT-C-SOURCE" "SB-GROVEL") stream headers definitions package))
      (sb-ext:exit :code 0 :abort t))))

(with-open-file (f "../make-contrib.lisp")
  (let ((eof (list nil)) (pending nil))
    (loop :for form := (read f nil eof)
          :until (eq form eof)
          :do (when pending (eval pending))
              (setf pending form))
    (setf (fdefinition 'run-defs-to-lisp) #'grovel-c)
    (eval pending)))
