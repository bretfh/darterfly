(in-package #:darterfly/net)

(defun ip6-p (address) (and (vectorp address) (= (length address) 16)))

(defun ip6-address (string)
  (let* ((gap (search "::" string))
         (groups (lambda (s) (mapcar (lambda (g) (parse-integer g :radix 16))
                                     (remove "" (uiop:split-string s :separator ":") :test #'string=))))
         (head (funcall groups (if gap (subseq string 0 gap) string)))
         (tail (and gap (funcall groups (subseq string (+ gap 2)))))
         (words (append head (make-list (- 8 (length head) (length tail)) :initial-element 0) tail))
         (v (make-array 16 :element-type '(unsigned-byte 8))))
    (loop for w in words for i from 0 by 2
          do (setf (aref v i) (ldb (byte 8 8) w) (aref v (1+ i)) (ldb (byte 8 0) w)))
    v))

(defun ip6-string (a)
  (let* ((words (loop for i below 16 by 2 collect (u16be a i)))
         (best nil) (best-length 1))
    (loop for i below 8
          for run = (loop for j from i below 8 while (zerop (nth j words)) count t)
          when (> run best-length) do (setf best i best-length run))
    (flet ((hex (ws) (format nil "~(~{~x~^:~}~)" ws)))
      (if best
          (format nil "~a::~a" (hex (subseq words 0 best)) (hex (subseq words (+ best best-length))))
          (hex words)))))

(defun in6-address (prefix id)
  (let ((v (make-array 16 :element-type '(unsigned-byte 8))))
    (replace v prefix :end2 8)
    (replace v id :start1 8)
    v))

(defun eui-64 (mac)
  (let ((id (octets (subseq mac 0 3) (octets (be #xfffe 2)) (subseq mac 3 6))))
    (setf (aref id 0) (logxor (aref id 0) 2))
    id))

(defparameter +all-nodes+ (ip6-address "ff02::1"))
(defparameter +all-routers+ (ip6-address "ff02::2"))
(defparameter +unspecified+ (ip6-address "::"))

(defun link-local-p (a) (and (= (aref a 0) #xfe) (= (logand (aref a 1) #xc0) #x80)))
(defun multicast-p (a) (= (aref a 0) #xff))

(defun solicited-node (a)
  (let ((v (ip6-address "ff02::1:ff00:0")))
    (replace v a :start1 13 :start2 13)
    v))

(defun multicast-mac (a) (octets (octets (be #x3333 2)) (subseq a 12 16)))

(defun source-address (dst)
  (if (ip6-p dst)
      (let ((all (interface-ip6 *interface*)))
        (or (and (not (link-local-p dst)) (not (multicast-p dst)) (find-if-not #'link-local-p all))
            (find-if #'link-local-p all)
            +unspecified+))
      (interface-ip *interface*)))

(defun transport-checksum (src dst protocol data)
  (let ((pseudo (if (ip6-p dst)
                    (octets src dst (be (length data) 4) (be 0 3) (be protocol 1))
                    (octets (be src 4) (be dst 4) (be protocol 2) (be (length data) 2)))))
    (let ((sum (fold16 (sum16 data 0 (length data) (sum16 pseudo 0 (length pseudo) 0)))))
      (if (and (= protocol 17) (zerop sum)) #xffff sum))))

(defun on-link-6-p (dst)
  (or (link-local-p dst)
      (some (lambda (a) (and (not (link-local-p a)) (equalp (subseq a 0 8) (subseq dst 0 8))))
            (interface-ip6 *interface*))))

(defun icmp6-packet (type code body src dst)
  (let ((packet (octets (be type 1) (be code 1) (be 0 2) body)))
    (replace packet (be (transport-checksum src dst 58 packet) 2) :start1 2)
    packet))

(defun send-icmp6 (type code body dst &key (hops 255) src)
  (let ((src (or src (source-address dst))))
    (send-ip6 58 dst (icmp6-packet type code body src dst) :hops hops :src src)))

(defun link-option (type) (octets (be type 1) (be 1 1) (interface-mac *interface*)))

(defun nd6-resolve (dst)
  (when (multicast-p dst) (return-from nd6-resolve (multicast-mac dst)))
  (let ((hop (if (on-link-6-p dst) dst (or (interface-router6 *interface*) (net-fail :enetunreach "nd6: no router for ~a" (ip6-string dst)))))
        (if *interface*))
    (dotimes (try 4 (net-fail :ehostunreach "nd6: no answer from ~a" (ip6-string hop)))
      (sb-thread:with-mutex ((interface-lock if))
        (let ((mac (gethash hop (interface-nd6 if))))
          (when mac (return mac))))
      (send-icmp6 135 0 (octets (be 0 4) hop (link-option 1)) (solicited-node hop))
      (sb-thread:with-mutex ((interface-lock if))
        (unless (gethash hop (interface-nd6 if))
          (sb-thread:condition-wait (interface-changed if) (interface-lock if) :timeout 0.5))))))

(defun send-ip6 (protocol dst payload &key (hops 64) src)
  (let ((header (octets (be #x60000000 4) (be (length payload) 2) (be protocol 1) (be hops 1)
                        (or src (source-address dst)) dst)))
    (send-frame (nd6-resolve dst) +ethertype-ip6+ (octets header payload))))

(defun nd6-options (packet start)
  (loop with at = start
        while (< (+ at 1) (length packet))
        for length = (* 8 (aref packet (1+ at)))
        until (zerop length)
        collect (cons (aref packet at) (subseq packet at (min (length packet) (+ at length))))
        do (incf at length)))

(defun nd6-learn (address mac)
  (let ((if *interface*))
    (sb-thread:with-mutex ((interface-lock if))
      (setf (gethash address (interface-nd6 if)) mac)
      (sb-thread:condition-broadcast (interface-changed if)))))

(defun add-ip6 (address)
  (let ((if *interface*))
    (sb-thread:with-mutex ((interface-lock if))
      (unless (member address (interface-ip6 if) :test #'equalp)
        (setf (interface-ip6 if) (append (interface-ip6 if) (list address))))
      (sb-thread:condition-broadcast (interface-changed if)))))

(defun nd6-ra-input (src packet hops)
  (when (and (= hops 255) (link-local-p src))
    (let ((if *interface*) (lifetime (u16be packet 6)))
      (dolist (option (nd6-options packet 16))
        (let ((o (cdr option)))
          (case (car option)
            (1 (nd6-learn src (subseq o 2 8)))
            (3 (when (and (= (aref o 2) 64) (logtest (aref o 3) #x40))
                 (add-ip6 (in6-address (subseq o 16 32) (eui-64 (interface-mac if))))))
            (25 (sb-thread:with-mutex ((interface-lock if))
                  (setf (interface-dns6 if)
                        (loop for at from 8 below (length o) by 16 collect (subseq o at (+ at 16)))))))))
      (sb-thread:with-mutex ((interface-lock if))
        (when (plusp lifetime) (setf (interface-router6 if) src))
        (sb-thread:condition-broadcast (interface-changed if))))))

(defun receive-icmp6 (src dst packet hops)
  (declare (ignore dst))
  (case (aref packet 0)
    (128 (send-icmp6 129 0 (subseq packet 4) src :hops 64))
    (129 (let ((if *interface*))
           (sb-thread:with-mutex ((interface-lock if))
             (setf (gethash (list src (u16be packet 4) (u16be packet 6)) (interface-pings if)) (get-internal-real-time))
             (sb-thread:condition-broadcast (interface-changed if)))))
    (134 (nd6-ra-input src packet hops))
    (135 (let ((target (subseq packet 8 24)))
           (when (and (= hops 255) (member target (interface-ip6 *interface*) :test #'equalp))
             (let ((source (assoc 1 (nd6-options packet 24)))
                   (to (if (equalp src +unspecified+) +all-nodes+ src)))
               (when (and source (not (equalp src +unspecified+))) (nd6-learn src (subseq (cdr source) 2 8)))
               (send-icmp6 136 0 (octets (be (if (equalp to src) #x60000000 #x20000000) 4) target (link-option 2))
                           to :src target)))))
    (136 (when (= hops 255)
           (let ((target (assoc 2 (nd6-options packet 24))))
             (when target (nd6-learn (subseq packet 8 24) (subseq (cdr target) 2 8))))))))

(defun ip6-ours-p (dst)
  (let ((all (interface-ip6 *interface*)))
    (or (member dst all :test #'equalp)
        (equalp dst +all-nodes+)
        (some (lambda (a) (equalp dst (solicited-node a))) all))))

(defun receive-ip6 (packet)
  (when (and (>= (length packet) 40) (= (ash (aref packet 0) -4) 6))
    (let* ((length (u16be packet 4))
           (next (aref packet 6))
           (hops (aref packet 7))
           (src (subseq packet 8 24))
           (dst (subseq packet 24 40))
           (payload (subseq packet 40 (min (length packet) (+ 40 length)))))
      (when (ip6-ours-p dst)
        (case next
          (58 (receive-icmp6 src dst payload hops))
          (6 (receive-tcp src payload))
          (17 (receive-udp src payload)))))))

(defun start-ip6 ()
  (add-ip6 (in6-address (ip6-address "fe80::") (eui-64 (interface-mac *interface*))))
  (send-icmp6 133 0 (octets (be 0 4) (link-option 1)) +all-routers+))
