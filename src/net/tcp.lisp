(in-package #:darterfly/net)

(defconstant +fin+ 1)
(defconstant +syn+ 2)
(defconstant +rst+ 4)
(defconstant +psh+ 8)
(defconstant +ack+ 16)
(defconstant +mss+ 1460)
(defconstant +window+ 65535)
(defconstant +cwnd-init-pkts+ 10)
(defconstant +rexmtthresh+ 3)
(defconstant +rtobase+ 1)
(defconstant +rexmtmax+ 64)
(defconstant +sndbuf+ 65536)

(defvar *tcp-lock* (sb-thread:make-mutex :name "tcp"))
(defvar *tcp-changed* (sb-thread:make-waitqueue))
(defvar *connections* (make-hash-table :test 'equalp))
(defvar *listeners* (make-hash-table))
(defvar *next-port* 49152)
(defvar *tcp-timer* nil)

(defstruct (connection (:conc-name tcp-))
  local-port remote-ip remote-port (state :closed) (maxseg +mss+)
  iss snd-una snd-nxt (snd-wnd +window+) irs rcv-nxt
  (unacked nil) (received (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0))
  (eof nil) (reset nil) listener (closed-at nil) (out-of-order nil)
  (snd-buffer (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)) (snd-off 0)
  (snd-cwnd (* +cwnd-init-pkts+ +mss+)) (snd-ssthresh +window+) snd-recover (dupacks 0) (bytes-acked 0)
  srtt rttvar (rxtcur +rtobase+))

(defstruct listener port (pending nil))

(defun seq+ (a b) (ldb (byte 32 0) (+ a b)))
(defun seq- (a b) (let ((d (ldb (byte 32 0) (- a b)))) (if (logbitp 31 d) (- d (ash 1 32)) d)))
(defun seq< (a b) (minusp (seq- a b)))
(defun seq<= (a b) (not (plusp (seq- a b))))

(defun tcp-key (local remote-ip remote-port) (list local remote-ip remote-port))

(defun send-segment (c flags seq &optional (data #()) (options #()))
  (let* ((header-length (+ 20 (length options)))
         (segment (octets (be (tcp-local-port c) 2) (be (tcp-remote-port c) 2) (be seq 4)
                          (be (if (logtest flags +ack+) (tcp-rcv-nxt c) 0) 4)
                          (be (ash (/ header-length 4) 4) 1) (be flags 1) (be +window+ 2) (be 0 2) (be 0 2)
                          options (coerce data '(vector (unsigned-byte 8))))))
    (replace segment (be (transport-checksum (source-address (tcp-remote-ip c)) (tcp-remote-ip c) 6 segment) 2) :start1 16)
    (send-ip 6 (tcp-remote-ip c) segment)))

(defun mss-option (c) (octets (be 2 1) (be 4 1) (be (tcp-maxseg c) 2)))

(defun maxseg-for (ip) (if (ip6-p ip) (- +mss+ 20) +mss+))

(defun queue-segment (c flags data)
  (let ((seq (tcp-snd-nxt c)))
    (setf (tcp-snd-nxt c) (seq+ seq (+ (length data) (if (logtest flags (logior +syn+ +fin+)) 1 0))))
    (push (list seq flags data (get-internal-real-time) 0) (tcp-unacked c))
    (send-segment c flags seq data (if (logtest flags +syn+) (mss-option c) #()))))

(defvar *tcp-random* nil)
(defun new-iss ()
  (random (ash 1 32) (or *tcp-random* (setf *tcp-random* (make-random-state t)))))

(defun send-reset (src src-port dst-port seq ack flags)
  (let ((c (make-connection :local-port dst-port :remote-ip src :remote-port src-port :rcv-nxt ack)))
    (send-segment c (logior +rst+ flags) seq)))

(defun segment-end (s)
  (seq+ (first s) (+ (length (third s)) (if (logtest (second s) (logior +syn+ +fin+)) 1 0))))

(defun ack-up-to (c ack)
  (when (and (seq< (tcp-snd-una c) ack) (seq<= ack (tcp-snd-nxt c)))
    (let ((acked (remove-if-not (lambda (s) (seq<= (segment-end s) ack)) (tcp-unacked c)))
          (bytes (seq- ack (tcp-snd-una c))))
      (setf (tcp-snd-una c) ack
            (tcp-unacked c) (set-difference (tcp-unacked c) acked))
      (let ((timed (find 0 acked :key #'fifth)))
        (when timed (xmit-timer c (/ (- (get-internal-real-time) (fourth timed)) internal-time-units-per-second))))
      bytes)))

(defun xmit-timer (c rtt)
  (if (tcp-srtt c)
      (setf (tcp-rttvar c) (+ (* 3/4 (tcp-rttvar c)) (* 1/4 (abs (- (tcp-srtt c) rtt))))
            (tcp-srtt c) (+ (* 7/8 (tcp-srtt c)) (* 1/8 rtt)))
      (setf (tcp-srtt c) rtt (tcp-rttvar c) (/ rtt 2)))
  (setf (tcp-rxtcur c) (min +rexmtmax+ (max +rtobase+ (+ (tcp-srtt c) (* 4 (tcp-rttvar c)))))))

(defun flight-size (c) (seq- (tcp-snd-nxt c) (tcp-snd-una c)))

(defun oldest-unacked (c)
  (let ((best nil))
    (dolist (s (tcp-unacked c) best)
      (when (or (null best) (seq< (first s) (first best))) (setf best s)))))

(defun retransmit (c s)
  (setf (fourth s) (get-internal-real-time))
  (incf (fifth s))
  (send-segment c (second s) (first s) (third s) (if (logtest (second s) +syn+) (mss-option c) #())))

(defun halve-window (c)
  (setf (tcp-snd-ssthresh c) (* (tcp-maxseg c) (max 2 (floor (min (tcp-snd-wnd c) (tcp-snd-cwnd c)) (* 2 (tcp-maxseg c)))))))

(defun ack-rcvd (c acked)
  (setf (tcp-dupacks c) 0)
  (cond ((tcp-snd-recover c)
         (if (seq< (tcp-snd-una c) (tcp-snd-recover c))
             (let ((next (oldest-unacked c)))
               (when next (retransmit c next))
               (setf (tcp-snd-cwnd c) (max (tcp-maxseg c) (+ (- (tcp-snd-cwnd c) acked) (tcp-maxseg c)))))
             (let ((ss (flight-size c)))
               (setf (tcp-snd-recover c) nil (tcp-bytes-acked c) 0
                     (tcp-snd-cwnd c) (if (< ss (tcp-snd-ssthresh c)) (+ (max ss (tcp-maxseg c)) (tcp-maxseg c)) (tcp-snd-ssthresh c))))))
        ((>= (tcp-snd-cwnd c) (tcp-snd-ssthresh c))
         (incf (tcp-bytes-acked c) acked)
         (when (>= (tcp-bytes-acked c) (tcp-snd-cwnd c))
           (decf (tcp-bytes-acked c) (tcp-snd-cwnd c))
           (incf (tcp-snd-cwnd c) (tcp-maxseg c))))
        (t (incf (tcp-snd-cwnd c) (min acked (tcp-maxseg c))))))

(defun dupack-rcvd (c)
  (incf (tcp-dupacks c))
  (cond ((tcp-snd-recover c) (incf (tcp-snd-cwnd c) (tcp-maxseg c)))
        ((= (tcp-dupacks c) +rexmtthresh+)
         (halve-window c)
         (setf (tcp-snd-recover c) (tcp-snd-nxt c))
         (let ((s (oldest-unacked c))) (when s (retransmit c s)))
         (setf (tcp-snd-cwnd c) (+ (tcp-snd-ssthresh c) (* +rexmtthresh+ (tcp-maxseg c)))))))

(defun after-timeout (c)
  (halve-window c)
  (setf (tcp-snd-cwnd c) (tcp-maxseg c) (tcp-dupacks c) 0 (tcp-bytes-acked c) 0
        (tcp-snd-recover c) (tcp-snd-nxt c)
        (tcp-rxtcur c) (min +rexmtmax+ (* 2 (tcp-rxtcur c)))))

(defun unsent (c) (- (length (tcp-snd-buffer c)) (tcp-snd-off c)))

(defun tcp-output (c)
  (loop for size = (min (tcp-maxseg c) (unsent c))
        while (and (plusp size)
                   (member (tcp-state c) '(:established :close-wait))
                   (or (zerop (flight-size c))
                       (<= (+ (flight-size c) size) (min (tcp-snd-cwnd c) (max (tcp-maxseg c) (tcp-snd-wnd c))))))
        do (let ((start (tcp-snd-off c)))
             (incf (tcp-snd-off c) size)
             (queue-segment c (logior +ack+ +psh+) (subseq (tcp-snd-buffer c) start (+ start size)))))
  (let ((buffer (tcp-snd-buffer c)) (off (tcp-snd-off c)))
    (when (or (zerop (unsent c)) (> off +sndbuf+))
      (replace buffer buffer :start2 off)
      (setf (fill-pointer buffer) (- (length buffer) off) (tcp-snd-off c) 0))))

(defun all-acked-p (c) (= (tcp-snd-una c) (tcp-snd-nxt c)))

(defun receive-tcp (src packet)
  (let* ((src-port (u16be packet 0)) (dst-port (u16be packet 2))
         (seq (u32be packet 4)) (ack (u32be packet 8))
         (offset (* 4 (ash (aref packet 12) -4)))
         (flags (aref packet 13)) (window (u16be packet 14))
         (data (subseq packet offset))
         (key (tcp-key dst-port src src-port)))
    (sb-thread:with-recursive-lock (*tcp-lock*)
      (let ((c (gethash key *connections*)))
        (cond
          ((and (null c) (logtest flags +syn+) (not (logtest flags +ack+)) (gethash dst-port *listeners*))
           (let ((c (make-connection :local-port dst-port :remote-ip src :remote-port src-port :state :syn-received
                                     :irs seq :rcv-nxt (seq+ seq 1) :snd-wnd window
                                     :maxseg (maxseg-for src) :snd-cwnd (* +cwnd-init-pkts+ (maxseg-for src))
                                     :listener (gethash dst-port *listeners*))))
             (let ((iss (new-iss))) (setf (tcp-iss c) iss (tcp-snd-una c) iss (tcp-snd-nxt c) iss))
             (setf (gethash key *connections*) c)
             (queue-segment c (logior +syn+ +ack+) #())))
          ((null c)
           (unless (logtest flags +rst+)
             (if (logtest flags +ack+)
                 (send-reset src src-port dst-port ack 0 0)
                 (send-reset src src-port dst-port 0 (seq+ seq (+ (length data) (if (logtest flags +syn+) 1 0))) +ack+))))
          ((logtest flags +rst+)
           (setf (tcp-reset c) t (tcp-state c) :closed)
           (remhash key *connections*))
          ((eq (tcp-state c) :syn-sent)
           (when (and (logtest flags +syn+) (logtest flags +ack+) (ack-up-to c ack))
             (setf (tcp-irs c) seq (tcp-rcv-nxt c) (seq+ seq 1) (tcp-snd-wnd c) window (tcp-state c) :established)
             (send-segment c +ack+ (tcp-snd-nxt c))))
          (t
           (when (logtest flags +ack+)
             (let ((acked (ack-up-to c ack)))
               (cond (acked (unless (eq (tcp-state c) :syn-received) (ack-rcvd c acked)))
                     ((and (= ack (tcp-snd-una c)) (zerop (length data)) (not (logtest flags (logior +syn+ +fin+)))
                           (= window (tcp-snd-wnd c)) (tcp-unacked c))
                      (dupack-rcvd c))))
             (setf (tcp-snd-wnd c) window)
             (when (and (eq (tcp-state c) :syn-received) (all-acked-p c))
               (setf (tcp-state c) :established)
               (let ((l (tcp-listener c))) (when l (setf (listener-pending l) (append (listener-pending l) (list c))))))
             (when (all-acked-p c)
               (case (tcp-state c)
                 (:fin-wait-1 (setf (tcp-state c) :fin-wait-2))
                 (:closing (setf (tcp-state c) :time-wait (tcp-closed-at c) (get-internal-real-time)))
                 (:last-ack (setf (tcp-state c) :closed) (remhash key *connections*)))))
           (when (or (plusp (length data)) (logtest flags +fin+))
             (receive-in-order c seq data (logtest flags +fin+))
             (send-segment c +ack+ (tcp-snd-nxt c)))
           (tcp-output c))))
      (sb-thread:condition-broadcast *tcp-changed*))))

(defun receive-in-order (c seq data fin)
  (let ((behind (seq- (tcp-rcv-nxt c) seq)))
    (cond ((minusp behind)
           (when (< (- behind) +window+)
             (pushnew (list seq data fin) (tcp-out-of-order c) :key #'first)))
          ((or (< behind (length data)) (and fin (= behind (length data))))
           (accept-data c (subseq data behind) fin)
           (loop for next = (find-if (lambda (s) (seq<= (first s) (tcp-rcv-nxt c))) (tcp-out-of-order c))
                 while next
                 do (setf (tcp-out-of-order c) (remove next (tcp-out-of-order c)))
                    (destructuring-bind (seq data fin) next
                      (let ((behind (seq- (tcp-rcv-nxt c) seq)))
                        (when (or (< behind (length data)) (and fin (= behind (length data))))
                          (accept-data c (subseq data behind) fin)))))))))

(defun accept-data (c data fin)
  (unless (tcp-eof c)
    (loop for b across data do (vector-push-extend b (tcp-received c)))
    (setf (tcp-rcv-nxt c) (seq+ (tcp-rcv-nxt c) (length data)))
    (when fin
      (setf (tcp-rcv-nxt c) (seq+ (tcp-rcv-nxt c) 1) (tcp-eof c) t (tcp-out-of-order c) nil)
      (setf (tcp-state c)
            (case (tcp-state c)
              ((:established :syn-received) :close-wait)
              (:fin-wait-1 (if (all-acked-p c) :time-wait :closing))
              (:fin-wait-2 :time-wait)
              (t (tcp-state c))))
      (when (eq (tcp-state c) :time-wait) (setf (tcp-closed-at c) (get-internal-real-time))))))

(defun tcp-timer ()
  (loop
    (sleep 0.2)
    (handler-case (tcp-tick)
      (error (e) (format *error-output* "~&tcp timer: ~a~%" e)))))

(defun tcp-tick ()
  (sb-thread:with-recursive-lock (*tcp-lock*)
      (let ((now (get-internal-real-time)) (dead nil))
        (maphash (lambda (key c)
                   (let ((s (oldest-unacked c)))
                     (when (and s (> (- now (fourth s)) (* (tcp-rxtcur c) internal-time-units-per-second)))
                       (if (> (fifth s) 8)
                           (progn (setf (tcp-reset c) t (tcp-state c) :closed) (push key dead))
                           (progn (after-timeout c)
                                  (handler-case (retransmit c s) (net-error () nil))))))
                   (when (and (eq (tcp-state c) :time-wait)
                              (> (- now (tcp-closed-at c)) (* 2 internal-time-units-per-second)))
                     (push key dead)))
                 *connections*)
        (dolist (key dead) (remhash key *connections*))
        (when dead (sb-thread:condition-broadcast *tcp-changed*)))))

(defun ensure-tcp-timer ()
  (unless *tcp-timer* (setf *tcp-timer* (sb-thread:make-thread #'tcp-timer :name "tcp timer"))))

(defun tcp-wait (predicate timeout)
  (let ((deadline (and timeout (+ (get-internal-real-time) (* timeout internal-time-units-per-second)))))
    (loop until (funcall predicate)
          do (let ((left (and deadline (/ (- deadline (get-internal-real-time)) internal-time-units-per-second))))
               (when (and left (<= left 0)) (return nil))
               (sb-thread:condition-wait *tcp-changed* *tcp-lock* :timeout (or left 1))
               (unless (sb-thread:holding-mutex-p *tcp-lock*) (sb-thread:grab-mutex *tcp-lock*)))
          finally (return t))))

(defun tcp-listen (port)
  (ensure-tcp-timer)
  (sb-thread:with-recursive-lock (*tcp-lock*)
    (setf (gethash port *listeners*) (make-listener :port port))))

(defun tcp-unlisten (listener)
  (sb-thread:with-recursive-lock (*tcp-lock*)
    (when (eq (gethash (listener-port listener) *listeners*) listener)
      (remhash (listener-port listener) *listeners*))))

(defun tcp-accept (listener &key timeout)
  (sb-thread:with-recursive-lock (*tcp-lock*)
    (when (tcp-wait (lambda () (listener-pending listener)) timeout)
      (pop (listener-pending listener)))))

(defun tcp-connect (address port &key (timeout 10))
  (ensure-tcp-timer)
  (let* ((ip (if (stringp address) (ip-address address) address))
         (local (sb-thread:with-recursive-lock (*tcp-lock*) (prog1 *next-port* (incf *next-port*))))
         (iss (new-iss))
         (c (make-connection :local-port local :remote-ip ip :remote-port port :state :syn-sent
                             :maxseg (maxseg-for ip) :snd-cwnd (* +cwnd-init-pkts+ (maxseg-for ip))
                             :iss iss :snd-una iss :snd-nxt iss)))
    (sb-thread:with-recursive-lock (*tcp-lock*)
      (setf (gethash (tcp-key local ip port) *connections*) c)
      (queue-segment c +syn+ #())
      (unless (tcp-wait (lambda () (or (eq (tcp-state c) :established) (tcp-reset c))) timeout)
        (net-fail :etimedout "tcp: no answer from ~a:~d" (address-string ip) port))
      (when (tcp-reset c) (net-fail :econnrefused "tcp: ~a:~d refused the connection" (address-string ip) port))
      c)))

(defun tcp-send (c data)
  (let ((data (coerce data '(simple-array (unsigned-byte 8) (*)))))
    (sb-thread:with-recursive-lock (*tcp-lock*)
      (loop for start from 0 below (length data) by +sndbuf+
            do (tcp-wait (lambda () (or (tcp-reset c) (< (unsent c) +sndbuf+))) nil)
               (when (tcp-reset c) (net-fail :econnreset "tcp: connection reset"))
               (loop for b across (subseq data start (min (length data) (+ start +sndbuf+)))
                     do (vector-push-extend b (tcp-snd-buffer c)))
               (tcp-output c)))
    (length data)))

(defun tcp-receive (c &key timeout)
  (sb-thread:with-recursive-lock (*tcp-lock*)
    (tcp-wait (lambda () (or (plusp (length (tcp-received c))) (tcp-eof c) (tcp-reset c))) timeout)
    (cond ((plusp (length (tcp-received c)))
           (prog1 (coerce (tcp-received c) '(simple-array (unsigned-byte 8) (*)))
             (setf (tcp-received c) (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0))))
          ((or (tcp-eof c) (tcp-reset c)) nil)
          (t (make-array 0 :element-type '(unsigned-byte 8))))))

(defun tcp-peer (c) (values (address-string (tcp-remote-ip c)) (tcp-remote-port c)))

(defun tcp-reset-p (c) (and (tcp-reset c) t))

(defun tcp-close (c)
  (sb-thread:with-recursive-lock (*tcp-lock*)
    (tcp-wait (lambda () (or (tcp-reset c) (zerop (unsent c)))) 30)
    (case (tcp-state c)
      ((:established :syn-received) (setf (tcp-state c) :fin-wait-1) (queue-segment c (logior +fin+ +ack+) #()))
      (:close-wait (setf (tcp-state c) :last-ack) (queue-segment c (logior +fin+ +ack+) #())))
    (tcp-wait (lambda () (member (tcp-state c) '(:closed :time-wait :fin-wait-2))) 5)))

(defun tcp-echo (port)
  (let ((listener (tcp-listen port)))
    (sb-thread:make-thread
     (lambda ()
       (loop (let ((c (tcp-accept listener)))
               (when c
                 (sb-thread:make-thread
                  (lambda ()
                    (loop for data = (tcp-receive c)
                          while data do (tcp-send c data))
                    (tcp-close c))
                  :name "tcp echo connection")))))
     :name (format nil "tcp echo ~d" port))))

(pushnew 'forget-interface sb-ext:*save-hooks*)

(defun forget-interface ()
  (setf *interface* nil *tcp-timer* nil))
