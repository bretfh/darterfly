(in-package #:finch/net)

(defconstant +fin+ 1)
(defconstant +syn+ 2)
(defconstant +rst+ 4)
(defconstant +psh+ 8)
(defconstant +ack+ 16)
(defconstant +mss+ 1460)
(defconstant +window+ 65535)

(defvar *tcp-lock* (sb-thread:make-mutex :name "tcp"))
(defvar *tcp-changed* (sb-thread:make-waitqueue))
(defvar *connections* (make-hash-table :test 'equal))
(defvar *listeners* (make-hash-table))
(defvar *next-port* 49152)
(defvar *tcp-timer* nil)

(defstruct (connection (:conc-name tcp-))
  local-port remote-ip remote-port (state :closed)
  iss snd-una snd-nxt (snd-wnd +window+) irs rcv-nxt
  (unacked nil) (received (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0))
  (eof nil) (reset nil) listener (closed-at nil))

(defstruct listener port (pending nil))

(defun seq+ (a b) (ldb (byte 32 0) (+ a b)))
(defun seq- (a b) (let ((d (ldb (byte 32 0) (- a b)))) (if (logbitp 31 d) (- d (ash 1 32)) d)))
(defun seq< (a b) (minusp (seq- a b)))
(defun seq<= (a b) (not (plusp (seq- a b))))

(defun tcp-key (local remote-ip remote-port) (list local remote-ip remote-port))

(defun tcp-checksum (src dst segment)
  (let ((pseudo (octets (be src 4) (be dst 4) (be 6 2) (be (length segment) 2))))
    (checksum (octets pseudo segment))))

(defun send-segment (c flags seq &optional (data #()) (options #()))
  (let* ((header-length (+ 20 (length options)))
         (segment (octets (be (tcp-local-port c) 2) (be (tcp-remote-port c) 2) (be seq 4)
                          (be (if (logtest flags +ack+) (tcp-rcv-nxt c) 0) 4)
                          (be (ash (/ header-length 4) 4) 1) (be flags 1) (be +window+ 2) (be 0 2) (be 0 2)
                          options (coerce data '(vector (unsigned-byte 8))))))
    (replace segment (be (tcp-checksum (interface-ip *interface*) (tcp-remote-ip c) segment) 2) :start1 16)
    (send-ip 6 (tcp-remote-ip c) segment)))

(defun mss-option () (octets (be 2 1) (be 4 1) (be +mss+ 2)))

(defun queue-segment (c flags data)
  (let ((seq (tcp-snd-nxt c)))
    (setf (tcp-snd-nxt c) (seq+ seq (+ (length data) (if (logtest flags (logior +syn+ +fin+)) 1 0))))
    (push (list seq flags data (get-internal-real-time) 0) (tcp-unacked c))
    (send-segment c flags seq data (if (logtest flags +syn+) (mss-option) #()))))

(defvar *tcp-random* nil)
(defun new-iss ()
  (random (ash 1 32) (or *tcp-random* (setf *tcp-random* (make-random-state t)))))

(defun send-reset (src src-port dst-port seq ack flags)
  (let ((c (make-connection :local-port dst-port :remote-ip src :remote-port src-port :rcv-nxt ack)))
    (send-segment c (logior +rst+ flags) seq)))

(defun ack-up-to (c ack)
  (when (and (seq< (tcp-snd-una c) ack) (seq<= ack (tcp-snd-nxt c)))
    (setf (tcp-snd-una c) ack
          (tcp-unacked c) (remove-if (lambda (s) (seq<= (seq+ (first s) (+ (length (third s))
                                                                             (if (logtest (second s) (logior +syn+ +fin+)) 1 0)))
                                                        ack))
                                     (tcp-unacked c)))
    t))

(defun all-acked-p (c) (= (tcp-snd-una c) (tcp-snd-nxt c)))

(defun receive-tcp (src packet)
  (let* ((src-port (u16be packet 0)) (dst-port (u16be packet 2))
         (seq (u32be packet 4)) (ack (u32be packet 8))
         (offset (* 4 (ash (aref packet 12) -4)))
         (flags (aref packet 13)) (window (u16be packet 14))
         (data (subseq packet offset))
         (key (tcp-key dst-port src src-port)))
    (sb-thread:with-recursive-lock (*tcp-lock*)
      (let ((c (gethash key *connections*)))
        (cond
          ((and (null c) (logtest flags +syn+) (not (logtest flags +ack+)) (gethash dst-port *listeners*))
           (let ((c (make-connection :local-port dst-port :remote-ip src :remote-port src-port :state :syn-received
                                     :irs seq :rcv-nxt (seq+ seq 1) :snd-wnd window
                                     :listener (gethash dst-port *listeners*))))
             (let ((iss (new-iss))) (setf (tcp-iss c) iss (tcp-snd-una c) iss (tcp-snd-nxt c) iss))
             (setf (gethash key *connections*) c)
             (queue-segment c (logior +syn+ +ack+) #())))
          ((null c)
           (unless (logtest flags +rst+)
             (if (logtest flags +ack+)
                 (send-reset src src-port dst-port ack 0 0)
                 (send-reset src src-port dst-port 0 (seq+ seq (+ (length data) (if (logtest flags +syn+) 1 0))) +ack+))))
          ((logtest flags +rst+)
           (setf (tcp-reset c) t (tcp-state c) :closed)
           (remhash key *connections*))
          ((eq (tcp-state c) :syn-sent)
           (when (and (logtest flags +syn+) (logtest flags +ack+) (ack-up-to c ack))
             (setf (tcp-irs c) seq (tcp-rcv-nxt c) (seq+ seq 1) (tcp-snd-wnd c) window (tcp-state c) :established)
             (send-segment c +ack+ (tcp-snd-nxt c))))
          (t
           (when (logtest flags +ack+)
             (ack-up-to c ack)
             (setf (tcp-snd-wnd c) window)
             (when (and (eq (tcp-state c) :syn-received) (all-acked-p c))
               (setf (tcp-state c) :established)
               (let ((l (tcp-listener c))) (when l (setf (listener-pending l) (append (listener-pending l) (list c))))))
             (when (all-acked-p c)
               (case (tcp-state c)
                 (:fin-wait-1 (setf (tcp-state c) :fin-wait-2))
                 (:closing (setf (tcp-state c) :time-wait (tcp-closed-at c) (get-internal-real-time)))
                 (:last-ack (setf (tcp-state c) :closed) (remhash key *connections*)))))
           (cond ((/= seq (tcp-rcv-nxt c))
                  (when (or (plusp (length data)) (logtest flags +fin+))
                    (send-segment c +ack+ (tcp-snd-nxt c))))
                 (t
                  (when (plusp (length data))
                    (loop for b across data do (vector-push-extend b (tcp-received c)))
                    (setf (tcp-rcv-nxt c) (seq+ (tcp-rcv-nxt c) (length data))))
                  (when (logtest flags +fin+)
                    (setf (tcp-rcv-nxt c) (seq+ (tcp-rcv-nxt c) 1) (tcp-eof c) t)
                    (setf (tcp-state c)
                          (case (tcp-state c)
                            ((:established :syn-received) :close-wait)
                            (:fin-wait-1 (if (all-acked-p c) :time-wait :closing))
                            (:fin-wait-2 :time-wait)
                            (t (tcp-state c))))
                    (when (eq (tcp-state c) :time-wait) (setf (tcp-closed-at c) (get-internal-real-time))))
                  (when (or (plusp (length data)) (logtest flags +fin+))
                    (send-segment c +ack+ (tcp-snd-nxt c))))))))
      (sb-thread:condition-broadcast *tcp-changed*))))

(defun tcp-timer ()
  (loop
    (sleep 0.2)
    (sb-thread:with-recursive-lock (*tcp-lock*)
      (let ((now (get-internal-real-time)) (dead nil))
        (maphash (lambda (key c)
                   (dolist (s (tcp-unacked c))
                     (when (> (- now (fourth s)) (* 1 internal-time-units-per-second))
                       (if (> (fifth s) 8)
                           (progn (setf (tcp-reset c) t (tcp-state c) :closed) (push key dead))
                           (progn (setf (fourth s) now) (incf (fifth s))
                                  (send-segment c (second s) (first s) (third s)
                                                (if (logtest (second s) +syn+) (mss-option) #()))))))
                   (when (and (eq (tcp-state c) :time-wait)
                              (> (- now (tcp-closed-at c)) (* 2 internal-time-units-per-second)))
                     (push key dead)))
                 *connections*)
        (dolist (key dead) (remhash key *connections*))
        (when dead (sb-thread:condition-broadcast *tcp-changed*))))))

(defun ensure-tcp-timer ()
  (unless *tcp-timer* (setf *tcp-timer* (sb-thread:make-thread #'tcp-timer :name "tcp timer"))))

(defun tcp-wait (predicate timeout)
  (let ((deadline (and timeout (+ (get-internal-real-time) (* timeout internal-time-units-per-second)))))
    (loop until (funcall predicate)
          do (let ((left (and deadline (/ (- deadline (get-internal-real-time)) internal-time-units-per-second))))
               (when (and left (<= left 0)) (return nil))
               (sb-thread:condition-wait *tcp-changed* *tcp-lock* :timeout (or left 1))
               (unless (sb-thread:holding-mutex-p *tcp-lock*) (sb-thread:grab-mutex *tcp-lock*)))
          finally (return t))))

(defun tcp-listen (port)
  (ensure-tcp-timer)
  (sb-thread:with-recursive-lock (*tcp-lock*)
    (setf (gethash port *listeners*) (make-listener :port port))))

(defun tcp-accept (listener &key timeout)
  (sb-thread:with-recursive-lock (*tcp-lock*)
    (when (tcp-wait (lambda () (listener-pending listener)) timeout)
      (pop (listener-pending listener)))))

(defun tcp-connect (address port &key (timeout 10))
  (ensure-tcp-timer)
  (let* ((ip (if (stringp address) (ip-address address) address))
         (local (sb-thread:with-recursive-lock (*tcp-lock*) (prog1 *next-port* (incf *next-port*))))
         (iss (new-iss))
         (c (make-connection :local-port local :remote-ip ip :remote-port port :state :syn-sent
                             :iss iss :snd-una iss :snd-nxt iss)))
    (sb-thread:with-recursive-lock (*tcp-lock*)
      (setf (gethash (tcp-key local ip port) *connections*) c)
      (queue-segment c +syn+ #())
      (unless (tcp-wait (lambda () (or (eq (tcp-state c) :established) (tcp-reset c))) timeout)
        (error "tcp: no answer from ~a:~d" (address-string ip) port))
      (when (tcp-reset c) (error "tcp: ~a:~d refused the connection" (address-string ip) port))
      c)))

(defun tcp-send (c data)
  (let ((data (coerce data '(simple-array (unsigned-byte 8) (*)))))
    (sb-thread:with-recursive-lock (*tcp-lock*)
      (loop for start from 0 below (length data) by +mss+
            do (tcp-wait (lambda () (or (tcp-reset c) (< (seq- (tcp-snd-nxt c) (tcp-snd-una c)) (max +mss+ (tcp-snd-wnd c))))) nil)
               (when (tcp-reset c) (error "tcp: connection reset"))
               (queue-segment c (logior +ack+ +psh+) (subseq data start (min (length data) (+ start +mss+))))))
    (length data)))

(defun tcp-receive (c &key timeout)
  "Octets that have arrived, waiting for some; NIL at end of stream."
  (sb-thread:with-recursive-lock (*tcp-lock*)
    (tcp-wait (lambda () (or (plusp (length (tcp-received c))) (tcp-eof c) (tcp-reset c))) timeout)
    (if (plusp (length (tcp-received c)))
        (prog1 (coerce (tcp-received c) '(simple-array (unsigned-byte 8) (*)))
          (setf (tcp-received c) (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
        nil)))

(defun tcp-close (c)
  (sb-thread:with-recursive-lock (*tcp-lock*)
    (case (tcp-state c)
      ((:established :syn-received) (setf (tcp-state c) :fin-wait-1) (queue-segment c (logior +fin+ +ack+) #()))
      (:close-wait (setf (tcp-state c) :last-ack) (queue-segment c (logior +fin+ +ack+) #())))
    (tcp-wait (lambda () (member (tcp-state c) '(:closed :time-wait :fin-wait-2))) 5)))

(defun tcp-echo (port)
  (let ((listener (tcp-listen port)))
    (sb-thread:make-thread
     (lambda ()
       (loop (let ((c (tcp-accept listener)))
               (when c
                 (sb-thread:make-thread
                  (lambda ()
                    (loop for data = (tcp-receive c)
                          while data do (tcp-send c data))
                    (tcp-close c))
                  :name "tcp echo connection")))))
     :name (format nil "tcp echo ~d" port))))
