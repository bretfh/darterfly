(in-package #:darterfly/net)

(defun dns-name (name)
  (apply #'octets (append (loop for label in (uiop:split-string name :separator ".")
                                unless (string= label "")
                                  collect (octets (be (length label) 1) (sb-ext:string-to-octets label :external-format :utf-8)))
                          (list (be 0 1)))))

(defun skip-name (v at)
  (loop
    (unless (< at (length v)) (net-fail :eio "dns: truncated name"))
    (let ((n (aref v at)))
      (cond ((zerop n) (return (1+ at)))
            ((= (logand n #xc0) #xc0)
             (unless (and (< (1+ at) (length v))
                          (< (logand (u16be v at) #x3fff) (length v)))
               (net-fail :eio "dns: invalid compression pointer"))
             (return (+ at 2)))
            ((or (> n 63) (> (+ at n 1) (length v)))
             (net-fail :eio "dns: invalid label"))
            (t (incf at (1+ n)))))))

(defun dns-answers (v id)
  (when (and (>= (length v) 12) (= (u16be v 0) id) (logbitp 15 (u16be v 2)))
    (let ((rcode (logand (u16be v 2) 15)) (at 12) (addresses nil))
      (unless (zerop rcode) (return-from dns-answers (values nil rcode)))
      (dotimes (i (u16be v 4))
        (setf at (+ (skip-name v at) 4))
        (when (> at (length v)) (net-fail :eio "dns: truncated question")))
      (dotimes (i (u16be v 6))
        (let ((name-end (skip-name v at)))
          (when (> (+ name-end 10) (length v))
            (net-fail :eio "dns: truncated record"))
          (let* ((type (u16be v name-end))
                 (class (u16be v (+ name-end 2)))
                 (size (u16be v (+ name-end 8)))
                 (start (+ name-end 10)))
            (when (> (+ start size) (length v))
              (net-fail :eio "dns: truncated record data"))
            (when (= class 1)
              (cond ((and (= type 1) (= size 4)) (push (u32be v start) addresses))
                    ((and (= type 28) (= size 16))
                     (push (subseq v start (+ start 16)) addresses))))
            (setf at (+ start size)))))
      (values (nreverse addresses) 0))))

(defun resolve-name (name &key (type :a) (timeout 2) (tries 3))
  (let ((reply (query-dns name :type (ecase type (:a 1) (:aaaa 28))
                         :timeout timeout :tries tries)))
    (multiple-value-bind (addresses rcode) (dns-answers reply (u16be reply 0))
      (unless (eql rcode 0)
        (net-fail :enoent "dns: ~a: rcode ~d" name rcode))
      (mapcar #'address-string addresses))))

(defun dns-query-packet (name type class)
  (let ((wire (dns-name name)))
    (unless (and (<= (length wire) 255) (<= 1 type 65535)
                 (<= 1 class 65535)
                 (loop for label in (uiop:split-string name :separator ".")
                       always (<= (length (sb-ext:string-to-octets label
                                           :external-format :utf-8)) 63)))
      (net-fail :einval "dns: invalid question"))
    (octets (be (random #x10000) 2) (be #x100 2) (be 1 2)
            (be 0 2) (be 0 2) (be 0 2) wire (be type 2) (be class 2))))

(defun dns-reply-p (reply query)
  (and (>= (length reply) (length query))
       (= (u16be reply 0) (u16be query 0))
       (= (logand (u16be reply 2) #xf800) #x8000)
       (= (u16be reply 4) 1)
       ;; Our question is uncompressed. A server normally echoes it verbatim.
       ;; Compare ASCII names case-insensitively, but type/class exactly.
       (equalp (map 'string #'code-char
                    (subseq reply 12 (- (length query) 4)))
               (map 'string #'code-char
                    (subseq query 12 (- (length query) 4))))
       (equalp (subseq reply (- (length query) 4) (length query))
               (subseq query (- (length query) 4)))))

(defun dns-tcp-query (server query timeout)
  (let ((connection (tcp-connect server 53 :timeout timeout))
        (data (make-array 0 :element-type '(unsigned-byte 8)
                            :adjustable t :fill-pointer 0))
        (deadline (+ (get-internal-real-time)
                     (* timeout internal-time-units-per-second))))
    (unwind-protect
         (progn
           (tcp-send connection (octets (be (length query) 2) query))
           (loop
             (when (and (>= (length data) 2)
                        (>= (length data) (+ 2 (u16be data 0))))
               (let ((reply (subseq data 2 (+ 2 (u16be data 0)))))
                 (unless (dns-reply-p reply query)
                   (net-fail :eio "dns: invalid TCP response"))
                 (return reply)))
             (let ((remaining (/ (- deadline (get-internal-real-time))
                                 internal-time-units-per-second)))
               (when (<= remaining 0) (net-fail :etimedout "dns: TCP timeout"))
               (let ((chunk (tcp-receive connection :timeout remaining)))
                 (unless (and chunk (plusp (length chunk)))
                   (net-fail :etimedout "dns: incomplete TCP response"))
                 (loop for byte across chunk do (vector-push-extend byte data))))))
      (tcp-close connection))))

(defun query-dns (name &key (type 1) (class 1) (timeout 2) (tries 3))
  "Return a validated wire response using the configured DNS server."
  (unless *interface* (net-fail :enetdown "dns: network is not configured"))
  (let* ((server (or (first (interface-dns *interface*))
                     (first (interface-dns6 *interface*))
                     (net-fail :edestaddrreq "dns: no server")))
         (server-ip (if (stringp server) (ip-address server) server))
         (query (dns-query-packet name type class)))
    (dotimes (try tries (net-fail :etimedout "dns: no answer for ~a" name))
      (let* ((port
               (sb-thread:with-mutex ((interface-lock *interface*))
                 (loop repeat 16384 for number = (+ 49152 (random 16384))
                       unless (gethash number (interface-ports *interface*))
                         return (setf (gethash number (interface-ports *interface*))
                                      (make-port :number number))
                       finally (net-fail :eaddrinuse "dns: no local UDP port"))))
             (deadline (+ (get-internal-real-time)
                          (* timeout internal-time-units-per-second))))
        (unwind-protect
             (progn
               (udp-send server (port-number port) 53 query)
               (loop for remaining = (/ (- deadline (get-internal-real-time))
                                         internal-time-units-per-second)
                     while (plusp remaining)
                     do (multiple-value-bind (reply source source-port)
                            (udp-receive port :timeout remaining)
                          (unless reply (return))
                          (when (and (= source-port 53) (equalp source server-ip)
                                     (dns-reply-p reply query))
                            (return-from query-dns
                              (if (logbitp 9 (u16be reply 2))
                                  (dns-tcp-query server query timeout)
                                  reply))))))
          (udp-close port))))))
