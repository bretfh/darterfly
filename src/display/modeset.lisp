(in-package #:darterfly/display)

(defconstant +ddi-buf-ctl-a+ #x64000)
(defconstant +dp-tp-ctl-a+ #x60540)
(defconstant +dp-tp-status-a+ #x60544)
(defconstant +trans-clk-sel-a+ #x46140)
(defconstant +transconf-a+ #x70008)
(defconstant +ddi-func-ctl2-a+ #x60404)
(defconstant +plane-ctl-a+ #x70180)
(defconstant +plane-surface-a+ #x7019C)

(defun wait-until (what test &key (seconds 0.1))
  (let ((deadline (+ (get-internal-real-time) (* seconds internal-time-units-per-second))))
    (loop until (funcall test)
          do (when (> (get-internal-real-time) deadline) (error "timed out waiting for ~a" what))
             (sleep 0.0001))))

(defun set-bits (offset bits on)
  (setf (reg offset) (if on (logior (reg offset) bits) (logandc2 (reg offset) bits))))

(defun plane-off ()
  (let ((ctl (reg +plane-ctl-a+)))
    (setf (reg +plane-ctl-a+) (logandc2 ctl (ash 1 31))
          (reg +plane-surface-a+) (reg +plane-surface-a+))
    (sleep 0.05)
    ctl))

(defun plane-on (ctl)
  (setf (reg +plane-ctl-a+) (logior ctl (ash 1 31))
        (reg +plane-surface-a+) (reg +plane-surface-a+)))

(defun transcoder-off ()
  (set-bits +transconf-a+ (ash 1 31) nil)
  (wait-until "the transcoder to stop" (lambda () (not (logbitp 30 (reg +transconf-a+)))) :seconds 0.1))

(defun transcoder-on ()
  (set-bits +transconf-a+ (ash 1 31) t)
  (wait-until "the transcoder to start" (lambda () (logbitp 30 (reg +transconf-a+))) :seconds 0.1))

(defun link-off ()
  (setf (reg +ddi-func-ctl2-a+) 0)
  (setf (reg +ddi-func-ctl-a+) (logandc2 (reg +ddi-func-ctl-a+) (logior (ash 1 31) (ash #xF 27) (ash 7 24))))
  (set-bits +ddi-buf-ctl-a+ (ash 1 31) nil)
  (set-bits +dp-tp-ctl-a+ (ash 1 31) nil)
  (wait-until "the DDI buffer to go idle" (lambda () (logbitp 7 (reg +ddi-buf-ctl-a+))) :seconds 0.01)
  (setf (reg +trans-clk-sel-a+) 0))

(defun lane-status (lanes)
  (destructuring-bind (lane01 lane23 align) (aux-read #x202 3)
    (let ((bits (logior lane01 (ash lane23 8))))
      (values (loop for i below lanes always (logbitp (* 4 i) bits))
              (loop for i below lanes always (= 7 (ldb (byte 3 (* 4 i)) bits)))
              (logbitp 0 align)))))

(defun set-pattern (pattern dpcd)
  (setf (reg +dp-tp-ctl-a+) (logior (logandc2 (reg +dp-tp-ctl-a+) (ash 7 8)) (ash pattern 8)))
  (aux-write #x102 dpcd))

(defun train-link (&key (rate 270000) (lanes 2))
  (aux-write #x600 1)
  (aux-write #x100 (floor rate 27000) (logior lanes #x80))
  (setf (reg +dp-tp-ctl-a+) (logior (ash 1 31) (ash 1 18)))
  (setf (reg +ddi-buf-ctl-a+) (logior (ash 1 31) (ash (1- lanes) 1)))
  (wait-until "the DDI buffer to wake" (lambda () (not (logbitp 7 (reg +ddi-buf-ctl-a+)))) :seconds 0.01)
  (set-pattern 0 #x21)
  (aux-write #x103 0 0)
  (loop repeat 5
        do (sleep 0.001)
        until (lane-status lanes)
        finally (unless (lane-status lanes) (error "clock recovery failed: ~a" (aux-read #x202 6))))
  (set-pattern 1 #x22)
  (loop repeat 5
        do (sleep 0.001)
        until (multiple-value-bind (cr eq aligned) (lane-status lanes) (and cr eq aligned))
        finally (multiple-value-bind (cr eq aligned) (lane-status lanes)
                  (unless (and cr eq aligned) (error "channel equalisation failed: ~a" (aux-read #x202 6)))))
  (setf (reg +dp-tp-ctl-a+) (logior (logandc2 (reg +dp-tp-ctl-a+) (ash 7 8)) (ash 2 8)))
  (wait-until "idle patterns" (lambda () (logbitp 25 (reg +dp-tp-status-a+))) :seconds 0.01)
  (set-pattern 3 0))

(defun link-on (func &key (rate 270000) (lanes 2))
  (setf (reg +trans-clk-sel-a+) (ash 1 28))
  (setf (reg +ddi-func-ctl-a+) (logandc2 func (ash 1 31)))
  (train-link :rate rate :lanes lanes)
  (setf (reg +ddi-func-ctl-a+) (logior func (ash 1 31))))

(defun relink ()
  (let ((psr *psr*) (func (reg +ddi-func-ctl-a+)) (plane nil))
    (when psr (disable-psr) (sleep 0.1))
    (setf plane (plane-off))
    (handler-case
        (progn
          (transcoder-off)
          (link-off)
          (link-on func)
          (transcoder-on)
          (plane-on plane)
          (when psr (enable-psr))
          (display-state))
      (error (e)
        (ignore-errors (link-off))
        (ignore-errors (link-on func))
        (ignore-errors (transcoder-on))
        (ignore-errors (plane-on plane))
        (list :failed (princ-to-string e) :state (ignore-errors (display-state)))))))
