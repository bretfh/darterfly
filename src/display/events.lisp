(in-package #:darterfly/display)

(defconstant +misc-imr+ #x44464)
(defconstant +misc-iir+ #x44468)
(defconstant +misc-ier+ #x4446C)
(defconstant +psr-imr-a+ #x60814)
(defconstant +psr-iir-a+ #x60818)
(defconstant +sde-imr+ #xC4004)
(defconstant +sde-iir+ #xC4008)
(defconstant +sde-ier+ #xC400C)
(defconstant +hotplug-ddi+ #xC4030)
(defconstant +psr-error+ (ash 1 2))
(defconstant +misc-psr+ (ash 1 19))
(defconstant +hotplug-a+ (ash 1 16))

(defvar *events-thread* nil)
(defvar *psr-watch* nil)
(defvar *psr-seen* (list :entries 0 :exits 0))
(defvar *psr-failures* nil)
(defvar *short-pulses* 0)

(pushnew 'forget-events sb-ext:*save-hooks*)

(defun forget-events () (setf *events-thread* nil *psr-unreliable* nil))

(defun psr-failed (where detail)
  (setf *psr-unreliable* t)
  (push (list :time (get-universal-time) :where where :detail detail) *psr-failures*)
  (format *error-output* "~&display: self-refresh turned off after a ~(~a~) error ~s~%" where detail)
  (disable-psr)
  (ignore-errors (aux-write #x600 1)))

(defun watch-psr (on)
  (setf *psr-watch* on)
  (awake (setf (reg +psr-imr-a+) (logandc2 #xFFFFFFFF (if on 7 +psr-error+)))))

(defun check-sink ()
  (when *psr*
    (destructuring-bind (errors debug status) (aux-read #x2006 3)
      (declare (ignore debug))
      (when (plusp errors) (aux-write #x2006 errors))
      (when (or (= (logand status 7) 7) (logtest errors 7))
        (psr-failed :panel (list :status status :errors errors))))))

(defun take-events ()
  (let ((actions nil))
    (setf (reg +master-irq+) 0)
    (let ((ctl (reg +display-int-ctl+)))
      (when (logbitp 16 ctl)
        (setf (reg +pipe-a-iir+) (reg +pipe-a-iir+)))
      (when (logbitp 22 ctl)
        (let ((misc (reg +misc-iir+)))
          (setf (reg +misc-iir+) misc)
          (when (logtest misc +misc-psr+)
            (let ((psr (reg +psr-iir-a+)))
              (setf (reg +psr-iir-a+) psr)
              (when (logbitp 0 psr) (incf (getf *psr-seen* :entries)))
              (when (logbitp 1 psr) (incf (getf *psr-seen* :exits)))
              (when (logtest psr +psr-error+)
                (setf (reg +psr-imr-a+) (logior (reg +psr-imr-a+) +psr-error+))
                (push (list :source psr) actions))))))
      (when (logbitp 23 ctl)
        (let ((sde (reg +sde-iir+)) (hotplug (reg +hotplug-ddi+)))
          (setf (reg +hotplug-ddi+) hotplug (reg +sde-iir+) sde)
          (when (logbitp 0 hotplug)
            (incf *short-pulses*)
            (push (list :short-pulse) actions)))))
    (setf (reg +master-irq+) (ash 1 31))
    actions))

(defun handle-events ()
  (dolist (action (awake (take-events)))
    (case (first action)
      (:source (psr-failed :source (second action)))
      (:short-pulse (check-sink)))))

(defun event-loop (vector)
  (loop
    (devices:wait-for-interrupt (list vector))
    (handler-case (handle-events)
      (error (e) (format *error-output* "~&display events: ~a~%" e)))))

(defun arm-events (vector)
  (setf (reg +misc-imr+) (logandc2 (reg +misc-imr+) +misc-psr+)
        (reg +misc-ier+) (logior (reg +misc-ier+) +misc-psr+)
        (reg +psr-imr-a+) (logandc2 #xFFFFFFFF (if *psr-watch* 7 +psr-error+))
        (reg +hotplug-ddi+) (logior (reg +hotplug-ddi+) 8)
        (reg +sde-imr+) (logandc2 (reg +sde-imr+) +hotplug-a+)
        (reg +sde-ier+) (logior (reg +sde-ier+) +hotplug-a+)
        (reg +sde-iir+) (reg +sde-iir+))
  (unless (and *events-thread* (sb-thread:thread-alive-p *events-thread*))
    (setf *events-thread* (sb-thread:make-thread #'event-loop :name "display events" :arguments (list vector)))))
