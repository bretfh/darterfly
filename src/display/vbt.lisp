(in-package #:darterfly/display)

(defun u16le (v i) (logior (aref v i) (ash (aref v (1+ i)) 8)))

(defun opregion ()
  (let ((address (devices:config-read-32 (graphics) #xFC)))
    (unless (string= (devices::ml-phys-string address 16) "IntelGraphicsMem")
      (error "no graphics OpRegion at ~x" address))
    address))

(defun phys-octets (address size)
  (let ((v (make-array size :element-type '(unsigned-byte 8))))
    (dotimes (i size v) (setf (aref v i) (devices::ml-phys-read-8 (+ address i))))))

(defun read-vbt ()
  (let* ((region (opregion))
         (in-mailbox (+ region #x400))
         (beside (devices::ml-phys-read-64 (+ region #x3BA)))
         (at (cond ((string= (devices::ml-phys-string in-mailbox 4) "$VBT") in-mailbox)
                   ((plusp beside) (+ region beside))
                   (t (error "the OpRegion carries no VBT"))))
         (size (devices::ml-phys-read-16 (+ at 24))))
    (unless (string= (devices::ml-phys-string at 4) "$VBT") (error "no VBT signature at ~x" at))
    (phys-octets at size)))

(defun vbt-blocks (v)
  (let* ((bdb (u32le v 28))
         (start (+ bdb (u16le v (+ bdb 18)))))
    (unless (string= (map 'string #'code-char (subseq v bdb (+ bdb 16))) "BIOS_DATA_BLOCK ")
      (error "no BIOS data block in the VBT"))
    (values (loop with at = start
                  while (< (+ at 3) (length v))
                  for size = (u16le v (+ at 1))
                  until (zerop size)
                  collect (list (aref v at) (+ at 3) size)
                  do (incf at (+ 3 size)))
            (u16le v (+ bdb 16)))))

(defun vbt-panel (&optional (v (read-vbt)))
  (multiple-value-bind (blocks version) (vbt-blocks v)
    (flet ((block-at (id) (second (assoc id blocks))))
      (let* ((panel (let ((b (block-at 40))) (if b (aref v b) 0)))
             (panel (if (> panel 15) 0 panel))
             (psr (block-at 9))
             (edp (block-at 27))
             (dtd (block-at 58))
             (backlight (block-at 43)))
        (list
         :version version
         :panel panel
         :psr (when psr
                (let ((e (+ psr (* 6 panel))))
                  (list :full-link (logbitp 0 (aref v e))
                        :aux-wakeup (logbitp 1 (aref v e))
                        :idle-frames (ldb (byte 4 0) (aref v (+ e 1)))
                        :tp1 (u16le v (+ e 2))
                        :tp2-tp3 (u16le v (+ e 4)))))
         :edp (when edp
                (let ((p (+ edp (* 10 panel))))
                  (list :t1-t3 (u16le v p) :t8 (u16le v (+ p 2)) :t9 (u16le v (+ p 4))
                        :t10 (u16le v (+ p 6)) :t11-t12 (u16le v (+ p 8))
                        :bpp (nth (ldb (byte 2 (* 2 panel)) (u32le v (+ edp 160))) '(18 24 30 nil))
                        :rate (* 20 (u16le v (+ edp 748 (* 2 panel))))
                        :lanes (1+ (ldb (byte 4 4) (aref v (+ edp 164 (* 2 panel))))))))
         :mode (when dtd
                 (let* ((size (u16le v dtd))
                        (e (+ dtd 2 (* size panel))))
                   (list :clock (u32le v e)
                         :hactive (u16le v (+ e 4)) :hblank (u16le v (+ e 6))
                         :hfront (u16le v (+ e 8)) :hsync (u16le v (+ e 10))
                         :vactive (u16le v (+ e 12)) :vblank (u16le v (+ e 14))
                         :vfront (u16le v (+ e 16)) :vsync (u16le v (+ e 18))
                         :width-mm (u16le v (+ e 20)) :height-mm (u16le v (+ e 22)))))
         :backlight (when backlight
                      (let ((e (+ backlight 1 (* (aref v backlight) panel))))
                        (list :type (ldb (byte 2 0) (aref v e))
                              :active-low (logbitp 2 (aref v e))
                              :pwm-hz (u16le v (+ e 1))
                              :controller (ldb (byte 4 4) (aref v (+ backlight 113 panel)))
                              :min-level (u16le v (+ backlight 193 (* 4 panel)))))))))))
