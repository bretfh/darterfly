(defpackage #:darterfly/stats
  (:use #:cl)
  (:export #:note #:series #:snapshot #:sample #:top #:print-sample #:trace-scheduling #:scheduling))
(in-package #:darterfly/stats)

(defconstant +series-length+ 512)

(defvar *series* (make-hash-table :test 'eq))
(defvar *series-lock* (sb-thread:make-mutex :name "stats"))

(defun note (name value)
  (sb-thread:with-mutex (*series-lock*)
    (let ((ring (or (gethash name *series*)
                    (setf (gethash name *series*) (cons 0 (make-array +series-length+ :initial-element nil))))))
      (setf (aref (cdr ring) (mod (car ring) +series-length+)) value)
      (incf (car ring))))
  value)

(defun series (name &key (clear nil))
  (sb-thread:with-mutex (*series-lock*)
    (let ((ring (gethash name *series*)))
      (when ring
        (prog1 (loop for i from (max 0 (- (car ring) +series-length+)) below (car ring)
                     collect (aref (cdr ring) (mod i +series-length+)))
          (when clear (setf (car ring) 0)))))))

(defvar *gc-seen* 0)

(defun forget-series ()
  (setf *series-lock* (sb-thread:make-mutex :name "stats")
        *series* (make-hash-table :test 'eq)
        *gc-seen* sb-ext:*gc-run-time*))

(pushnew 'forget-series sb-ext:*save-hooks*)

(defun note-gc ()
  (let ((now sb-ext:*gc-run-time*))
    (note :gc-ms (/ (- now (shiftf *gc-seen* now)) (/ internal-time-units-per-second 1000.0)))))

(pushnew 'note-gc sb-ext:*after-gc-hooks*)

(defun tsc-hz ()
  (sb-sys:sap-ref-64 (sb-sys:int-sap (darterfly/devices:machdep 4)) 0))

(defun kernel-times ()
  (let ((buffer (make-array 3072 :element-type '(unsigned-byte 8))))
    (let ((cpus (sb-sys:with-pinned-objects (buffer)
                  (darterfly/devices:machdep 29 (sb-sys:sap-int (sb-sys:vector-sap buffer))))))
      (flet ((u64 (i) (sb-kernel:%vector-raw-bits buffer i)))
        (list :cpus (loop for c below cpus collect (list :idle (u64 (+ (* 4 c) 1)) :switches (u64 (+ (* 4 c) 2))))
              :interrupts (loop for v below 256 for n = (u64 (+ 128 v)) when (plusp n) collect (cons v n)))))))

(defun thread-times ()
  (let* ((max 4096) (buffer (make-array (* 24 max) :element-type '(unsigned-byte 8)))
         (n (sb-sys:with-pinned-objects (buffer)
              (darterfly/devices:machdep 28 (sb-sys:sap-int (sb-sys:vector-sap buffer)) max)))
         (table (make-hash-table)))
    (dotimes (i n table)
      (setf (gethash (sb-kernel:%vector-raw-bits buffer (* 3 i)) table)
            (cons (sb-kernel:%vector-raw-bits buffer (+ 1 (* 3 i)))
                  (sb-kernel:%vector-raw-bits buffer (+ 2 (* 3 i))))))))

(defun kernel-thread-id (thread)
  (let ((os (sb-thread::thread-os-thread thread)))
    (and os (plusp os) (sb-sys:sap-ref-64 (sb-sys:int-sap os) 8))))

(defun scheduling-supported-p ()
  (= #x53434801 (darterfly/devices:machdep 88 0)))
(defun trace-scheduling (enabled)
  "Reset bounded wake-to-run counters and enable or disable collection. Requires physical-memory authority."
  (unless (and (scheduling-supported-p)
               (= 1 (darterfly/devices:machdep 88 1 (if enabled 1 0))))
    (error "Kernel scheduling trace unavailable or not permitted"))
  enabled)
(defun scheduling ()
  "Snapshot kernel wake-to-run delays. Collection is opt-in; times are microseconds."
  (unless (scheduling-supported-p) (return-from scheduling (list :unavailable t)))
  (let ((buffer (make-array 10240 :element-type '(unsigned-byte 8)))
        (names (make-hash-table)) (scale (/ 1000000d0 (tsc-hz))))
    (dolist (thread (sb-thread:list-all-threads))
      (let ((id (ignore-errors (kernel-thread-id thread))))
        (when id (setf (gethash id names) (sb-thread:thread-name thread)))))
    (unless (= 1 (sb-sys:with-pinned-objects (buffer)
                   (darterfly/devices:machdep 88 2 (sb-sys:sap-int (sb-sys:vector-sap buffer)))))
      (error "Cannot read scheduling counters"))
    (list :preemption (not (zerop (darterfly/devices:machdep 88 4)))
          :collisions (darterfly/devices:machdep 88 5)
          :threads
          (loop for i below 256 for at = (* i 5)
                for id = (sb-kernel:%vector-raw-bits buffer at)
                for count = (sb-kernel:%vector-raw-bits buffer (+ at 1))
                when (plusp count)
                  collect (list :id id :name (gethash id names) :count count
                                :total-us (* scale (sb-kernel:%vector-raw-bits buffer (+ at 2)))
                                :max-us (* scale (sb-kernel:%vector-raw-bits buffer (+ at 3))))))))

(defun named-thread-times (times)
  (loop for thread in (sb-thread:list-all-threads)
        for id = (ignore-errors (kernel-thread-id thread))
        when id collect (let ((entry (gethash id times)))
                          (list thread (sb-thread:thread-name thread) (if entry (car entry) 0) (if entry (cdr entry) 0)))))

(defun process-times (times)
  (loop for proc in (darterfly/bsd:procs)
        collect (list :pid (darterfly/bsd:proc-pid proc) :name (darterfly/bsd:proc-comm proc)
                      :ticks (loop for thread in (remove nil (cons (darterfly/bsd::proc-thread proc) (darterfly/bsd::proc-threads proc)))
                                   for id = (ignore-errors (kernel-thread-id thread))
                                   sum (or (and id (car (gethash id times))) 0)))))

(defun rapl-p ()
  (multiple-value-bind (max vendor) (sb-vm::%cpu-identification 0 0)
    (declare (ignore max))
    (and (= vendor #x756e6547)
         (not (logbitp 31 (nth-value 2 (sb-vm::%cpu-identification 1 0)))))))

(defun energy ()
  (and (rapl-p) (logand (darterfly/devices:machdep 24 #x611) #xffffffff)))

(defun energy-unit ()
  (and (rapl-p) (/ 1.0 (expt 2 (ldb (byte 5 8) (darterfly/devices:machdep 24 #x606))))))

(defun battery-ma ()
  (let ((layout (ignore-errors (darterfly/devices::battery-layout))))
    (and layout (ignore-errors (darterfly/devices::ec-field (getf layout :rate))))))

(defun snapshot ()
  (let ((times (thread-times)))
    (list :time (get-internal-real-time) :tsc (darterfly/devices:machdep 24 #x10) :threads (named-thread-times times)
          :kernel (kernel-times) :processes (process-times times)
          :wakeups (loop for entry being the hash-values of times sum (cdr entry))
          :gc-ms (/ sb-ext:*gc-run-time* (/ internal-time-units-per-second 1000.0))
          :consed (sb-ext:get-bytes-consed) :heap (sb-kernel:dynamic-usage) :heap-size (sb-ext:dynamic-space-size)
          :energy (energy) :energy-unit (energy-unit) :battery-ma (battery-ma))))

(defun percent (part whole) (if (plusp whole) (/ (round (* 1000 part) whole) 10.0) 0.0))

(defun sample (&optional (seconds 2))
  (series :gc-ms :clear t)
  (series :frame-ms :clear t)
  (let ((a (snapshot)))
    (sleep seconds)
    (let* ((b (snapshot))
           (tsc (- (getf b :tsc) (getf a :tsc)))
           (secs (/ tsc (float (tsc-hz))))
           (ka (getf a :kernel)) (kb (getf b :kernel)))
      (list :seconds (/ (round (* 100 secs)) 100.0)
            :cpu-busy (loop for ca in (getf ka :cpus) for cb in (getf kb :cpus)
                            collect (- 100.0 (percent (- (getf cb :idle) (getf ca :idle)) tsc)))
            :switches-per-s (round (loop for ca in (getf ka :cpus) for cb in (getf kb :cpus)
                                         sum (- (getf cb :switches) (getf ca :switches)))
                                   secs)
            :processes (sort (loop for pb in (getf b :processes)
                                   for pa = (find (getf pb :pid) (getf a :processes) :key (lambda (p) (getf p :pid)))
                                   collect (list :pid (getf pb :pid) :name (getf pb :name)
                                                 :cpu (percent (- (getf pb :ticks) (if pa (getf pa :ticks) 0)) tsc)))
                             #'> :key (lambda (p) (getf p :cpu)))
            :threads (subseq (sort (loop for (thread name ticks) in (getf b :threads)
                                         for before = (or (third (find thread (getf a :threads) :key #'first)) 0)
                                         collect (list :name name :cpu (percent (- ticks before) tsc)))
                                   #'> :key (lambda (x) (getf x :cpu)))
                             0 (min 8 (length (getf b :threads))))
            :wakeups-per-s (round (- (getf b :wakeups) (getf a :wakeups)) secs)
            :wakers (let ((rows (loop for (thread name nil wakeups) in (getf b :threads)
                                      for before = (or (fourth (find thread (getf a :threads) :key #'first)) 0)
                                      when (> wakeups before)
                                        collect (list :name name :per-s (/ (round (* 10 (- wakeups before)) secs) 10.0)))))
                      (subseq (sort rows #'> :key (lambda (x) (getf x :per-s))) 0 (min 8 (length rows))))
            :interrupts-per-s (sort (loop for (v . n) in (getf kb :interrupts)
                                          for before = (or (cdr (assoc v (getf ka :interrupts))) 0)
                                          when (> n before) collect (cons (format nil "#x~x" v) (round (- n before) secs)))
                                    #'> :key #'cdr)
            :gc (let ((pauses (series :gc-ms)))
                  (list :count (length pauses) :ms (/ (round (* 10 (- (getf b :gc-ms) (getf a :gc-ms)))) 10.0)
                        :longest-ms (and pauses (reduce #'max pauses))))
            :allocation-mb-per-s (/ (round (- (getf b :consed) (getf a :consed)) (* 10000 secs)) 100.0)
            :heap-mb (round (getf b :heap) 1000000) :heap-size-mb (round (getf b :heap-size) 1000000)
            :frames (let ((frames (series :frame-ms)))
                      (list :count (length frames)
                            :median-ms (and frames (nth (floor (length frames) 2) (sort (copy-list frames) #'<)))
                            :longest-ms (and frames (reduce #'max frames))))
            :package-w (let ((ea (getf a :energy)) (eb (getf b :energy)))
                         (and ea eb (getf b :energy-unit)
                              (/ (round (* 100 (logand (- eb ea) #xffffffff) (getf b :energy-unit)) secs) 100.0)))
            :battery-ma (getf b :battery-ma)))))

(defun print-sample (s &optional (stream *standard-output*))
  (format stream "~&~,2fs  cpu~{ ~3d%~}  ~d switches/s  ~@[package ~,2f W  ~]~@[battery ~d mA~]~%"
          (getf s :seconds) (mapcar #'round (getf s :cpu-busy)) (getf s :switches-per-s) (getf s :package-w) (getf s :battery-ma))
  (let ((gc (getf s :gc)) (frames (getf s :frames)))
    (format stream "heap ~d/~d MB  allocating ~,2f MB/s  gc ~d (~,1f ms~@[, longest ~,1f ms~])  frames ~d~@[ median ~,1f ms~]~@[ longest ~,1f ms~]~%"
            (getf s :heap-mb) (getf s :heap-size-mb) (getf s :allocation-mb-per-s)
            (getf gc :count) (getf gc :ms) (getf gc :longest-ms)
            (getf frames :count) (getf frames :median-ms) (getf frames :longest-ms)))
  (format stream "interrupts/s~{ ~a:~d~}~%" (loop for (v . n) in (getf s :interrupts-per-s) append (list v n)))
  (format stream "~&busiest threads~{ ~a ~,1f%~^,~}~%" (loop for th in (getf s :threads) append (list (getf th :name) (getf th :cpu))))
  (format stream "~&wakeups ~d/s:~{ ~a ~,1f~^,~}~%" (getf s :wakeups-per-s) (loop for th in (getf s :wakers) append (list (getf th :name) (getf th :per-s))))
  (format stream "~&  PID  CPU%  NAME~%")
  (dolist (p (getf s :processes))
    (format stream "~5d ~5,1f  ~a~%" (getf p :pid) (getf p :cpu) (getf p :name))))

(defun top (&optional (seconds 2))
  (print-sample (sample seconds))
  (values))

(darterfly/bsd:define-program "top" (argv envp)
  (top (if (second argv) (parse-integer (second argv)) 2))
  0)
