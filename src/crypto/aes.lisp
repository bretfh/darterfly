(in-package #:darterfly/crypto)

(defun gf-mul (a b)
  (let ((p 0))
    (loop repeat 8
          do (when (logbitp 0 b) (setf p (logxor p a)))
             (setf a (logxor (ldb (byte 8 0) (ash a 1)) (if (logbitp 7 a) #x1B 0))
                   b (ash b -1)))
    p))

(defun gf-inverse (a)
  (if (zerop a) 0 (loop for b from 1 below 256 when (= 1 (gf-mul a b)) return b)))

(defun make-sbox ()
  (let ((box (make-array 256 :element-type '(unsigned-byte 8))))
    (dotimes (a 256 box)
      (let ((b (gf-inverse a)) (s 0))
        (dotimes (i 8)
          (setf s (logior s (ash (logand 1 (logxor (ldb (byte 1 i) b) (ldb (byte 1 (mod (+ i 4) 8)) b)
                                                    (ldb (byte 1 (mod (+ i 5) 8)) b) (ldb (byte 1 (mod (+ i 6) 8)) b)
                                                    (ldb (byte 1 (mod (+ i 7) 8)) b) (ldb (byte 1 i) #x63)))
                                 i))))
        (setf (aref box a) s)))))

(defparameter *sbox* (make-sbox))

(defparameter *inverse-sbox*
  (let ((box (make-array 256 :element-type '(unsigned-byte 8))))
    (dotimes (a 256 box) (setf (aref box (aref *sbox* a)) a))))

(defstruct (aes-key (:constructor %aes-key (rounds schedule))) rounds schedule)

(defun aes-key (key)
  (let* ((nk (floor (length key) 4))
         (rounds (+ nk 6))
         (words (* 4 (1+ rounds)))
         (w (make-array (* 4 words) :element-type '(unsigned-byte 8)))
         (rcon 1))
    (assert (member (length key) '(16 24 32)))
    (replace w key)
    (loop for i from nk below words
          do (let ((temp (subseq w (* 4 (1- i)) (* 4 i))))
               (cond ((zerop (mod i nk))
                      (setf temp (map 'octet-vector (lambda (b) (aref *sbox* b)) (list (aref temp 1) (aref temp 2) (aref temp 3) (aref temp 0))))
                      (setf (aref temp 0) (logxor (aref temp 0) rcon)
                            rcon (gf-mul rcon 2)))
                     ((and (> nk 6) (= 4 (mod i nk)))
                      (setf temp (map 'octet-vector (lambda (b) (aref *sbox* b)) temp))))
               (dotimes (j 4)
                 (setf (aref w (+ (* 4 i) j)) (logxor (aref w (+ (* 4 (- i nk)) j)) (aref temp j))))))
    (%aes-key rounds w)))

(defun add-round-key (state key round)
  (dotimes (i 16) (setf (aref state i) (logxor (aref state i) (aref (aes-key-schedule key) (+ (* 16 round) i))))))

(defun shift-rows (state direction)
  (let ((copy (copy-seq state)))
    (dotimes (c 4)
      (dotimes (r 4)
        (setf (aref state (+ r (* 4 c))) (aref copy (+ r (* 4 (mod (+ c (* direction r)) 4)))))))))

(defun mix-columns (state matrix)
  (dotimes (c 4)
    (let ((column (subseq state (* 4 c) (* 4 (1+ c)))))
      (dotimes (r 4)
        (setf (aref state (+ r (* 4 c)))
              (logxor (gf-mul (aref matrix (mod (- 0 r) 4)) (aref column 0))
                      (gf-mul (aref matrix (mod (- 1 r) 4)) (aref column 1))
                      (gf-mul (aref matrix (mod (- 2 r) 4)) (aref column 2))
                      (gf-mul (aref matrix (mod (- 3 r) 4)) (aref column 3))))))))

(defun aes-encrypt-block (key block)
  (let ((state (octets block)) (rounds (aes-key-rounds key)))
    (add-round-key state key 0)
    (loop for round from 1 to rounds
          do (map-into state (lambda (b) (aref *sbox* b)) state)
             (shift-rows state 1)
             (unless (= round rounds) (mix-columns state #(2 3 1 1)))
             (add-round-key state key round))
    state))

(defun aes-decrypt-block (key block)
  (let ((state (octets block)) (rounds (aes-key-rounds key)))
    (add-round-key state key rounds)
    (loop for round from (1- rounds) downto 0
          do (shift-rows state -1)
             (map-into state (lambda (b) (aref *inverse-sbox* b)) state)
             (add-round-key state key round)
             (unless (zerop round) (mix-columns state #(14 11 13 9))))
    state))

(defparameter +wrap-iv+ #(#xA6 #xA6 #xA6 #xA6 #xA6 #xA6 #xA6 #xA6))

(defun xor-counter (a tt)
  (let ((a (copy-seq a)))
    (dotimes (i 8 a)
      (setf (aref a (- 7 i)) (logxor (aref a (- 7 i)) (ldb (byte 8 (* 8 i)) tt))))))

(defun aes-wrap (kek plaintext)
  (let* ((key (aes-key kek))
         (n (floor (length plaintext) 8))
         (a (octets +wrap-iv+))
         (r (coerce (loop for i below n collect (subseq (octets plaintext) (* 8 i) (* 8 (1+ i)))) 'vector)))
    (assert (and (zerop (mod (length plaintext) 8)) (>= n 2)))
    (dotimes (j 6)
      (dotimes (i n)
        (let ((b (aes-encrypt-block key (octets a (aref r i)))))
          (setf a (xor-counter (subseq b 0 8) (+ (* n j) i 1))
                (aref r i) (subseq b 8)))))
    (apply #'octets a (coerce r 'list))))

(defun aes-unwrap (kek ciphertext)
  (let* ((key (aes-key kek))
         (n (1- (floor (length ciphertext) 8)))
         (a (subseq (octets ciphertext) 0 8))
         (r (coerce (loop for i from 1 to n collect (subseq (octets ciphertext) (* 8 i) (* 8 (1+ i)))) 'vector)))
    (when (and (zerop (mod (length ciphertext) 8)) (>= n 2))
      (loop for j from 5 downto 0
            do (loop for i from (1- n) downto 0
                     do (let ((b (aes-decrypt-block key (octets (xor-counter a (+ (* n j) i 1)) (aref r i)))))
                          (setf a (subseq b 0 8)
                                (aref r i) (subseq b 8)))))
      (when (equalp a +wrap-iv+)
        (apply #'octets (coerce r 'list))))))
