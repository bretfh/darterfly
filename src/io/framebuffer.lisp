(defpackage #:darterfly/io
  (:use #:cl)
  (:export #:framebuffer #:open-framebuffer #:framebuffer-width #:framebuffer-height
           #:framebuffer-pixels #:capture-framebuffer #:flush #:fill-rect #:test-pattern
           #:read-events #:wait-for-events #:hid-event #:event-type #:event-code #:event-value #:blend-rect
           #:input-devices #:abs-range #:event-fd #:blit-image #:key-character #:shift-key-p #:control-key-p #:alt-key-p #:meta-key-p #:+key-esc+ #:shadow-under #:save-corners #:restore-corners #:*clip*))
(in-package #:darterfly/io)

(defclass framebuffer ()
  ((width :initarg :width :reader framebuffer-width)
   (height :initarg :height :reader framebuffer-height)
   (depth :initarg :depth :reader depth)
   (stride :initarg :stride :reader stride)
   (sap :initarg :sap :reader sap)
   (surfaces :initarg :surfaces :initform nil :reader surfaces)
   (front :initform 0 :accessor front)
   (behind :initform nil :accessor behind)
   (pixels :initarg :pixels :reader framebuffer-pixels)))

(defun open-framebuffer ()
  (destructuring-bind (&key row-bytes width height depth base) (darterfly/devices:boot-video)
    (let* ((bytes (* row-bytes height))
           (sap (sb-sys:int-sap (darterfly/devices:ml-io-map-wcomb base bytes)))
           (second (and (= depth 32) (ignore-errors (darterfly/display:second-surface bytes)))))
      (make-instance 'framebuffer :width width :height height :depth depth :stride row-bytes :sap sap
                                  :surfaces (when second
                                              (vector (cons sap 0)
                                                      (cons (sb-sys:int-sap (darterfly/devices:ml-io-map-wcomb (+ base second) bytes)) second)))
                                  :pixels (make-array (* width height) :element-type '(unsigned-byte 32)
                                                                       :initial-element #xff000000)))))

(defun capture-framebuffer (fb)
  "Retain the firmware/kernel surface using its real row pitch and pixel depth."
  (let* ((w (framebuffer-width fb)) (h (framebuffer-height fb))
         (out (make-array (* w h) :element-type '(unsigned-byte 32)))
         (source (sap fb)) (pitch (stride fb)) (bytes (truncate (depth fb) 8)))
    (unless (member (depth fb) '(24 32)) (error "Unsupported framebuffer depth"))
    (dotimes (y h)
      (dotimes (x w)
        (let ((at (+ (* y pitch) (* x bytes))))
          (setf (aref out (+ x (* y w)))
                (logior #xff000000 (sb-sys:sap-ref-8 source at)
                        (ash (sb-sys:sap-ref-8 source (+ at 1)) 8)
                        (ash (sb-sys:sap-ref-8 source (+ at 2)) 16))))))
    out))

(defun flush (fb &key (x 0) (y 0) (width (framebuffer-width fb)) (height (framebuffer-height fb)))
  (if (surfaces fb)
      (let* ((back (- 1 (front fb)))
             (target (car (aref (surfaces fb) back)))
             (rect (list x y width height)))
        (copy-rect fb target x y width height)
        (destructuring-bind (&optional bx by bw bh) (or (behind fb) (list 0 0 (framebuffer-width fb) (framebuffer-height fb)))
          (copy-rect fb target bx by bw bh))
        (darterfly/display:flip (cdr (aref (surfaces fb) back)))
        (setf (front fb) back (behind fb) rect))
      (progn (copy-rect fb (sap fb) x y width height)
             (darterfly/display:screen-changed)))
  fb)

(defun copy-rect (fb sap x y width height)
  (declare (optimize (speed 3) (safety 0)) (type fixnum x y width height))
  (let ((pixels (framebuffer-pixels fb))
        (stride (stride fb))
        (w (framebuffer-width fb))
        (x0 (max 0 x)) (y0 (max 0 y)))
    (declare (type (simple-array (unsigned-byte 32) (*)) pixels)
             (type fixnum stride w x0 y0))
    (let ((x1 (min w (+ x0 width)))
          (y1 (min (framebuffer-height fb) (+ y0 height))))
      (declare (type fixnum x1 y1))
      (ecase (depth fb)
        (32 (loop :for row fixnum :from y0 :below y1
                  :do (loop :for col fixnum :from x0 :below x1
                            :do (setf (sb-sys:sap-ref-32 sap (+ (* row stride) (* col 4)))
                                      (aref pixels (+ (* row w) col))))))
        (24 (loop :for row fixnum :from y0 :below y1
                  :do (loop :for col fixnum :from x0 :below x1
                            :for p :of-type (unsigned-byte 32) := (aref pixels (+ (* row w) col))
                            :for at :of-type fixnum := (+ (* row stride) (* col 3))
                            :do (setf (sb-sys:sap-ref-8 sap at) (ldb (byte 8 0) p)
                                      (sb-sys:sap-ref-8 sap (+ at 1)) (ldb (byte 8 8) p)
                                      (sb-sys:sap-ref-8 sap (+ at 2)) (ldb (byte 8 16) p)))))))))

(defun fill-rect (fb x y width height argb)
  (declare (optimize (speed 3)) (type fixnum x y width height) (type (unsigned-byte 32) argb))
  (let ((pixels (framebuffer-pixels fb))
        (w (framebuffer-width fb)))
    (declare (type (simple-array (unsigned-byte 32) (*)) pixels) (type fixnum w))
    (loop :for row fixnum :from (max 0 y) :below (min (framebuffer-height fb) (+ y height))
          :do (fill pixels argb :start (+ (* row w) (max 0 x)) :end (+ (* row w) (min w (+ x width)))))
    fb))

(defun test-pattern (fb)
  (let ((w (framebuffer-width fb)) (h (framebuffer-height fb)))
    (fill-rect fb 0 0 w h #xff202020)
    (fill-rect fb 0 0 (floor w 2) (floor h 2) #xffff0000)
    (fill-rect fb (floor w 2) 0 (floor w 2) (floor h 2) #xff00ff00)
    (fill-rect fb 0 (floor h 2) (floor w 2) (floor h 2) #xff0000ff)
    (flush fb)))
