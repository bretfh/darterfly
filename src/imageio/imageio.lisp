(defpackage #:finch/imageio
  (:use #:cl)
  (:export #:read-icns #:icon #:scale-rgba))
(in-package #:finch/imageio)

(defun be32 (octets at)
  (logior (ash (aref octets at) 24) (ash (aref octets (+ at 1)) 16)
          (ash (aref octets (+ at 2)) 8) (aref octets (+ at 3))))

(defun file-octets (path)
  (with-open-file (s path :element-type '(unsigned-byte 8))
    (let ((v (make-array (file-length s) :element-type '(unsigned-byte 8))))
      (read-sequence v s)
      v)))

(defun read-icns (path)
  (let ((octets (file-octets path)))
    (unless (string= "icns" (map 'string #'code-char (subseq octets 0 4)))
      (error "~a is not an icns" path))
    (loop :with at := 8
          :while (< at (length octets))
          :collect (let ((type (map 'string #'code-char (subseq octets at (+ at 4))))
                         (size (be32 octets (+ at 4))))
                     (prog1 (cons type (subseq octets (+ at 8) (+ at size)))
                       (incf at size))))))

(defun png-p (data)
  (and (> (length data) 8) (= (aref data 0) #x89) (= (aref data 1) #x50)))

(defun paeth (a b c)
  (let* ((p (- (+ a b) c)) (pa (abs (- p a))) (pb (abs (- p b))) (pc (abs (- p c))))
    (cond ((and (<= pa pb) (<= pa pc)) a) ((<= pb pc) b) (t c))))

(defun decode-png (data)
  (let ((at 8) width height depth color (idat (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    (loop :while (< at (length data))
          :do (let ((length (be32 data at))
                    (type (map 'string #'code-char (subseq data (+ at 4) (+ at 8)))))
                (cond ((string= type "IHDR")
                       (setf width (be32 data (+ at 8)) height (be32 data (+ at 12))
                             depth (aref data (+ at 16)) color (aref data (+ at 17))))
                      ((string= type "IDAT")
                       (loop :for i :from (+ at 8) :below (+ at 8 length) :do (vector-push-extend (aref data i) idat))))
                (incf at (+ 12 length))))
    (unless (and (= depth 8) (member color '(2 6))) (error "png colour type ~d depth ~d not read yet" color depth))
    (let* ((channels (if (= color 6) 4 3))
           (stride (* width channels))
           (raw (chipz:decompress nil 'chipz:zlib (coerce idat '(simple-array (unsigned-byte 8) (*)))))
           (out (make-array (* height stride) :element-type '(unsigned-byte 8)))
           (rgba (make-array (* width height 4) :element-type '(unsigned-byte 8))))
      (dotimes (y height)
        (let ((filter (aref raw (* y (1+ stride)))))
          (dotimes (x stride)
            (let* ((v (aref raw (+ (* y (1+ stride)) 1 x)))
                   (a (if (>= x channels) (aref out (+ (* y stride) (- x channels))) 0))
                   (b (if (> y 0) (aref out (+ (* (1- y) stride) x)) 0))
                   (c (if (and (> y 0) (>= x channels)) (aref out (+ (* (1- y) stride) (- x channels))) 0)))
              (setf (aref out (+ (* y stride) x))
                    (ldb (byte 8 0) (+ v (ecase filter
                                           (0 0) (1 a) (2 b) (3 (floor (+ a b) 2)) (4 (paeth a b c))))))))))
      (dotimes (i (* width height))
        (let ((alpha (if (= channels 4) (aref out (+ (* 4 i) 3)) 255)))
          (dotimes (k 3)
            (setf (aref rgba (+ (* 4 i) k)) (round (* (aref out (+ (* channels i) k)) alpha) 255)))
          (setf (aref rgba (+ (* 4 i) 3)) alpha)))
      (values rgba width height))))

(defun scale-rgba (pixels width height size)
  (let ((out (make-array (* size size 4) :element-type '(unsigned-byte 8))))
    (dotimes (y size)
      (dotimes (x size)
        (let ((x0 (floor (* x width) size)) (x1 (max (1+ (floor (* x width) size)) (floor (* (1+ x) width) size)))
              (y0 (floor (* y height) size)) (y1 (max (1+ (floor (* y height) size)) (floor (* (1+ y) height) size))))
          (let ((sums (make-array 4 :initial-element 0)) (n 0))
            (loop :for sy :from y0 :below y1
                  :do (loop :for sx :from x0 :below x1
                            :do (incf n)
                                (dotimes (c 4) (incf (aref sums c) (aref pixels (+ c (* 4 (+ sx (* sy width)))))))))
            (dotimes (c 4)
              (setf (aref out (+ c (* 4 (+ x (* y size))))) (round (aref sums c) n)))))))
    out))

(defun icon (path size)
  (let ((octets (file-octets path)))
    (if (png-p octets)
        (multiple-value-bind (pixels width height) (decode-png octets)
          (scale-rgba pixels width height size))
        (icns-icon path size))))

(defun icns-icon (path size)
  (let* ((entries (remove-if-not (lambda (e) (png-p (cdr e))) (read-icns path)))
         (sized (mapcar (lambda (e) (multiple-value-list (decode-png (cdr e)))) entries))
         (best (or (first (sort (remove-if (lambda (s) (< (second s) size)) sized) #'< :key #'second))
                   (first (sort sized #'> :key #'second)))))
    (destructuring-bind (pixels width height) best
      (scale-rgba pixels width height size))))
