(in-package #:finch/apps)

(defun text-layer (string font r g b &optional (a 1.0))
  (let* ((width (ceiling (+ 2 (text:string-width font string))))
         (height (ceiling (+ (text:font-ascent font) (text:font-descent font))))
         (bitmap (text:make-bitmap width height)))
    (text:draw-string bitmap font string 1 (text:font-ascent font) r g b a)
    (let ((layer (ca:make-layer :contents (ca:image width height (text:bitmap-pixels bitmap)))))
      (setf (ca:layer-frame layer) (vector 0 0 width height))
      layer)))

(defun screen-size ()
  (destructuring-bind (x y width height) (ca:main-display-bounds)
    (declare (ignore x y))
    (values width height)))

(defun clock ()
  (multiple-value-bind (s m h day month year weekday) (decode-universal-time (get-universal-time))
    (declare (ignore s year))
    (format nil "~a ~a ~d  ~d:~2,'0d ~a"
            (nth weekday '("Mon" "Tue" "Wed" "Thu" "Fri" "Sat" "Sun"))
            (nth (1- month) '("Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec"))
            day (if (zerop (mod h 12)) 12 (mod h 12)) m (if (< h 12) "AM" "PM"))))

(bsd:define-program "loginwindow" (argv envp)
  (dolist (label '("finch.finder" "finch.systemuiserver" "finch.dock"))
    (finch/launchd:kickstart label))
  (loop (bsd:pause)))

(bsd:define-program "SystemUIServer" (argv envp)
  (let* ((context (ca:context-create))
         (width (screen-size))
         (font (text:font "AdwaitaSans-Regular" 13))
         (bar (ca:make-layer :background-color #(0.96 0.96 0.96 0.92))))
    (setf (ca:layer-frame bar) (vector 0 0 width 24)
          (ca:context-layer context) bar)
    (flet ((draw ()
             (let ((time (text-layer (clock) font 0.0 0.0 0.0)))
               (place time (- width (round (aref (ca:layer-frame time) 2)) 14) 4)
               (setf (ca:layer-sublayers bar) (list time))
               (ca:commit context))))
      (draw)
      (ca:window-create context 0 0 width 24 :level :main-menu :order :below)
      (loop (sleep 30) (draw)))))

(defparameter +icons+ "/usr/share/icons/Adwaita/")

(defparameter *dock-items*
  '(("Finder" "/System/Library/CoreServices/Finder.app/Contents/MacOS/Finder" #(0.21 0.52 0.89 1.0)
     "legacy/system-file-manager-symbolic")
    ("Terminal" "/System/Applications/Utilities/Terminal.app/Contents/MacOS/Terminal" #(0.24 0.22 0.27 1.0)
     "legacy/utilities-terminal-symbolic")
    ("Hello" "/Applications/Hello.app/Contents/MacOS/Hello" #(0.90 0.38 0.0 1.0)
     "legacy/accessories-text-editor-symbolic")))

(defun icon-path (name) (format nil "~a~a.png" +icons+ name))

(defun icon-layer (name color size)
  (let ((tile (text:make-bitmap size size))
        (inset (round size 4))
        (glyph (ignore-errors (finch/imageio:icon (icon-path name) (- size (* 2 (round size 4)))))))
    (text:fill-round-rect tile 0 0 size size (round size 5) (aref color 0) (aref color 1) (aref color 2))
    (when glyph
      (let ((out (text:bitmap-pixels tile)) (g (- size (* 2 inset))))
        (dotimes (y g)
          (dotimes (x g)
            (let* ((from (* 4 (+ x (* y g))))
                   (to (* 4 (+ inset x (* (+ inset y) size))))
                   (keep (- 255 (aref glyph (+ from 3)))))
              (dotimes (c 4)
                (setf (aref out (+ to c)) (min 255 (+ (aref glyph (+ from c)) (round (* keep (aref out (+ to c))) 255))))))))))
    (ca:make-layer :contents (ca:image size size (text:bitmap-pixels tile)))))

(bsd:define-program "Dock" (argv envp)
  (multiple-value-bind (width height) (screen-size)
    (let* ((context (ca:context-create))
           (tile 56) (gap 12)
           (dock-width (+ gap (* (length *dock-items*) (+ tile gap))))
           (font (text:font "AdwaitaSans-Regular" 10))
           (dock (ca:make-layer :background-color #(0.85 0.85 0.88 0.85)
                                :sublayers (loop :for (name nil color icns) :in *dock-items*
                                                 :for x :from gap :by (+ tile gap)
                                                 :collect (let ((icon (icon-layer icns color tile))
                                                                (label (text-layer name font 0.1 0.1 0.1)))
                                                            (setf (ca:layer-frame icon) (vector x 8 tile tile))
                                                            (place label (+ x (round (- tile (aref (ca:layer-frame label) 2)) 2)) (+ 10 tile))
                                                            (setf (ca:layer-sublayers icon) nil)
                                                            (list icon label))))))
      (setf (ca:layer-sublayers dock) (apply #'append (ca:layer-sublayers dock))
            (ca:layer-frame dock) (vector 0 0 dock-width 88)
            (ca:context-layer context) dock)
      (ca:commit context)
      (ca:window-create context (floor (- width dock-width) 2) (- height 92) dock-width 88 :level :dock)
      (loop
        (let ((event (ca:next-event context)))
          (when (and event (eq (finch/server:event-type event) :left-mouse-down))
            (let ((x (first (finch/server:event-window-location event))))
              (let ((index (floor (- x gap) (+ tile gap))))
                (when (< 0 index (length *dock-items*))
                  (bsd:posix-spawn (second (nth index *dock-items*))
                                   (list (second (nth index *dock-items*))) nil))))))))))

(defun file-icon (path)
  (let ((mode (getf (ignore-errors (bsd:stat path)) :mode 0)))
    (icon-path (cond ((uiop:string-suffix-p path ".app") "mimetypes/application-x-executable")
                     ((= (logand mode bsd:+s-ifmt+) bsd:+s-ifdir+) "places/folder")
                     (t "mimetypes/text-x-generic")))))

(defun child-path (dir name)
  (if (string= dir "/") (format nil "/~a" name) (format nil "~a/~a" dir name)))

(defun directory-p (path)
  (let ((mode (getf (ignore-errors (bsd:stat path)) :mode 0)))
    (= (logand mode bsd:+s-ifmt+) bsd:+s-ifdir+)))

(defclass file-icon-view (kit:icon-view)
  ((path :initarg :path :reader path)
   (browser :initarg :browser :reader browser)))

(defmethod kit:mouse-down ((view file-icon-view) x y)
  (declare (ignore x y))
  (when (>= kit:*click-count* 2)
    (if (directory-p (path view))
        (browse (browser view) (path view))
        (when (uiop:string-suffix-p (path view) ".app")
          (let ((program (format nil "~a/Contents/MacOS/~a" (path view)
                                 (subseq (pathname-name (path view)) 0))))
            (ignore-errors (bsd:posix-spawn program (list program) nil))))))
  t)

(defun browse (window path)
  (let* ((content (kit:content-view window))
         (names (sort (remove-if (lambda (n) (char= (char n 0) #\.))
                                 (or (ignore-errors (bsd:readdir path)) nil))
                      #'string-lessp))
         (columns 6) (cell 92) (row 96))
    (kit:remove-subviews content)
    (kit:set-window-title window (if (string= path "/") "finch HD" (subseq path (1+ (position #\/ path :from-end t)))))
    (loop :for name :in names
          :for i :from 0
          :do (let ((child (child-path path name)))
                (kit:add-subview content (make-instance 'file-icon-view
                                                        :path child :browser window
                                                        :icon-path (file-icon child) :label name
                                                        :frame (vector (+ 8 (* cell (mod i columns)))
                                                                       (+ 8 (* row (floor i columns)))
                                                                       cell row)))))))

(defclass disk-view (kit:icon-view) ())

(defmethod kit:mouse-down ((view disk-view) x y)
  (declare (ignore x y))
  (when (>= kit:*click-count* 2)
    (let ((window (kit:make-window :title "finch HD" :x 120 :y 80 :width 600 :height 420)))
      (browse window "/")
      (kit:show window)))
  t)

(bsd:define-program "Finder" (argv envp)
  (setf kit:*menus* (list (list "Finder" (cons "About Finder" nil))
                          (list "File" (cons "New Finder Window" nil)) (list "Edit" (cons "Copy" nil))
                          (list "View" (cons "as Icons" nil)) (list "Go" (cons "Computer" nil))
                          (list "Window" (cons "Minimize" nil)) (list "Help" (cons "finch Help" nil))))
  (multiple-value-bind (width height) (screen-size)
    (let ((desktop (kit:make-window :style :borderless :level :desktop :x 0 :y 0 :width width :height height
                                    :background #(0.18 0.36 0.56 1.0))))
      (kit:add-subview (kit:content-view desktop)
                       (make-instance 'disk-view :icon-path (icon-path "devices/drive-harddisk")
                                                 :label "finch HD" :label-color #(1.0 1.0 1.0)
                                                 :frame (vector (- width 112) 36 100 90)))
      (kit:show desktop)
      (kit:run))))

(bsd:define-program "finch-gui" (argv envp)
  (finch/launchd:bootstrap-look-up "com.apple.windowserver")
  0)
