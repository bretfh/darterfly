(in-package #:darterfly/apps)

(defun text-layer (string font r g b &optional (a 1.0))
  (let* ((width (ceiling (+ 2 (text:string-width font string))))
         (height (ceiling (+ (text:font-ascent font) (text:font-descent font))))
         (bitmap (text:make-bitmap width height)))
    (text:draw-string bitmap font string 1 (text:font-ascent font) r g b a)
    (let ((layer (layer:make-layer :contents (layer:image width height (text:bitmap-pixels bitmap)))))
      (setf (layer:layer-frame layer) (vector 0 0 width height))
      layer)))

(defun screen-size ()
  (destructuring-bind (x y width height) (layer:main-display-bounds)
    (declare (ignore x y))
    (values width height)))

(defun clock ()
  (multiple-value-bind (s m h day month year weekday) (decode-universal-time (get-universal-time))
    (declare (ignore s year))
    (format nil "~a ~a ~d  ~a"
            (nth weekday '("Mon" "Tue" "Wed" "Thu" "Fri" "Sat" "Sun"))
            (nth (1- month) '("Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec"))
            day (if (getf *desktop-preferences* :clock-24)
                    (format nil "~2,'0d:~2,'0d" h m)
                    (format nil "~d:~2,'0d ~a" (if (zerop (mod h 12)) 12 (mod h 12)) m (if (< h 12) "AM" "PM"))))))

(bsd:define-program "Session" (argv envp)
  (setf *desktop-preferences* (read-desktop-preferences))
  (dolist (label '("darterfly.files" "darterfly.menubar" "darterfly.dock"))
    (darterfly/init:launch label))
  (cond ((equal (darterfly/devices:boot-arg "rd") "ram") (launch-app "Install"))
        ((setup-needed-p) (launch-app "Setup")))
  (bsd:resume-processes)
  (loop (bsd:pause)))

(defun battery-layer (battery)
  (let* ((width 26) (height 12)
         (bitmap (text:make-bitmap width height))
         (percent (getf battery :percent))
         (inner (round (* 19 percent) 100)))
    (text:fill-rect bitmap 0 0 23 12 0.15 0.15 0.15)
    (text:fill-rect bitmap 1 1 21 10 0.96 0.96 0.96)
    (text:fill-rect bitmap 23 3 3 6 0.15 0.15 0.15)
    (multiple-value-bind (r g b)
        (cond ((getf battery :charging) (values 0.22 0.62 0.28))
              ((< percent 20) (values 0.85 0.22 0.18))
              (t (values 0.15 0.15 0.15)))
      (when (plusp inner) (text:fill-rect bitmap 2 2 inner 8 r g b)))
    (let ((layer (layer:make-layer :contents (layer:image width height (text:bitmap-pixels bitmap)))))
      (setf (layer:layer-frame layer) (vector 0 0 width height))
      layer)))

(defun signal-bars (signal)
  (cond ((null signal) 0) ((> signal -55) 4) ((> signal -65) 3) ((> signal -75) 2) ((> signal -85) 1) (t 0)))

(defun network-layer (status font)
  (if (eq (getf status :kind) :wired)
      (text-layer "Wired" font 0.15 0.15 0.15)
      (let* ((bars (if (getf status :up) (signal-bars (getf status :signal)) 0))
             (name (and (getf status :up) (getf status :ssid)))
             (label (and name (text-layer name font 0.15 0.15 0.15)))
             (label-width (if label (+ 6 (round (aref (layer:layer-frame label) 2))) 0))
             (width (+ 16 label-width)) (height 16)
             (bitmap (text:make-bitmap width height)))
        (dotimes (i 4)
          (let ((h (* 3 (1+ i))))
            (multiple-value-call #'text:fill-rect bitmap (* i 4) (- height 2 h) 3 h
              (if (< i bars) (values 0.15 0.15 0.15) (values 0.72 0.72 0.72)))))
        (let ((layer (layer:make-layer :contents (layer:image width height (text:bitmap-pixels bitmap)))))
          (setf (layer:layer-frame layer) (vector 0 0 width height))
          (when label
            (place label 22 0)
            (setf (layer:layer-sublayers layer) (list label)))
          layer))))

(bsd:define-program "MenuBar" (argv envp)
  (let* ((context (layer:context-create))
         (width (screen-size))
         (font (text:font "AdwaitaSans-Regular" 13))
         (bar (layer:make-layer :background-color #(0.96 0.96 0.96 0.92))))
    (setf (layer:layer-frame bar) (vector 0 0 width 24)
          (layer:context-layer context) bar)
    (flet ((draw ()
             (let* ((time (text-layer (clock) font 0.0 0.0 0.0))
                    (left (- width (round (aref (layer:layer-frame time) 2)) 14))
                    (battery (ignore-errors (darterfly/devices:battery))))
               (place time left 4)
               (let* ((items (list time))
                      (edge left))
                 (when battery
                   (let* ((gauge (battery-layer battery))
                          (text (text-layer (format nil "~d%" (getf battery :percent)) font 0.0 0.0 0.0))
                          (gauge-x (- left 18 (round (aref (layer:layer-frame gauge) 2)))))
                     (place gauge gauge-x 6)
                     (setf edge (- gauge-x 4 (round (aref (layer:layer-frame text) 2))))
                     (place text edge 4)
                     (setf items (list* text gauge items))))
                 (let ((net (ignore-errors (network-layer (darterfly/wifi:network-status) font))))
                   (when net
                     (place net (- edge 18 (round (aref (layer:layer-frame net) 2))) 4)
                     (push net items)))
                 (setf (layer:layer-sublayers bar) items))
               (layer:commit context))))
      (draw)
      (layer:window-create context 0 0 width 24 :level :main-menu :order :below)
      (loop (sleep 5) (draw)))))

(defparameter +icons+ "/usr/share/icons/Adwaita/")

(defparameter *dock-items*
  '(("Files" "/System/Library/Services/Files.app/Contents/Programs/Files" #(0.21 0.52 0.89 1.0)
     "legacy/system-file-manager-symbolic")
    ("Terminal" "/System/Applications/Utilities/Terminal.app/Contents/Programs/Terminal" #(0.24 0.22 0.27 1.0)
     "legacy/utilities-terminal-symbolic")
    ("Listener" "/System/Applications/Listener.app/Contents/Programs/Listener" #(0.90 0.38 0.0 1.0)
     "actions/system-run-symbolic")
    ("Generations" "/System/Applications/Generations.app/Contents/Programs/Generations" #(0.20 0.55 0.35 1.0)
     "status/software-update-available-symbolic")))

(defun icon-path (name) (format nil "~a~a.png" +icons+ name))

(defun icon-layer (name color size)
  (let ((tile (text:make-bitmap size size))
        (inset (round size 4))
        (glyph (ignore-errors (darterfly/imageio:icon (icon-path name) (- size (* 2 (round size 4)))))))
    (text:fill-round-rect tile 0 0 size size (round size 5) (aref color 0) (aref color 1) (aref color 2))
    (when glyph
      (let ((out (text:bitmap-pixels tile)) (g (- size (* 2 inset))))
        (dotimes (y g)
          (dotimes (x g)
            (let* ((from (* 4 (+ x (* y g))))
                   (to (* 4 (+ inset x (* (+ inset y) size))))
                   (keep (- 255 (aref glyph (+ from 3)))))
              (dotimes (c 4)
                (setf (aref out (+ to c)) (min 255 (+ (aref glyph (+ from c)) (round (* keep (aref out (+ to c))) 255))))))))))
    (layer:make-layer :contents (layer:image size size (text:bitmap-pixels tile)))))

(bsd:define-program "Dock" (argv envp)
  (multiple-value-bind (width height) (screen-size)
    (let* ((context (layer:context-create))
           (tile 56) (gap 12)
           (dock-width (+ gap (* (length *dock-items*) (+ tile gap))))
           (font (text:font "AdwaitaSans-Regular" 10))
           (dock (layer:make-layer :background-color #(0.85 0.85 0.88 0.85)
                                :sublayers (loop :for (name nil color icns) :in *dock-items*
                                                 :for x :from gap :by (+ tile gap)
                                                 :collect (let ((icon (icon-layer icns color tile))
                                                                (label (text-layer name font 0.1 0.1 0.1)))
                                                            (setf (layer:layer-frame icon) (vector x 8 tile tile))
                                                            (place label (+ x (round (- tile (aref (layer:layer-frame label) 2)) 2)) (+ 10 tile))
                                                            (setf (layer:layer-sublayers icon) nil)
                                                            (list icon label))))))
      (setf (layer:layer-sublayers dock) (apply #'append (layer:layer-sublayers dock))
            (layer:layer-frame dock) (vector 0 0 dock-width 88)
            (layer:context-layer context) dock)
      (layer:commit context)
      (layer:window-create context (floor (- width dock-width) 2) (- height 92) dock-width 88 :level :dock)
      (loop
        (let ((event (layer:next-event context)))
          (when (and event (eq (darterfly/server:event-type event) :left-mouse-down))
            (let ((x (first (darterfly/server:event-window-location event))))
              (let ((index (floor (- x gap) (+ tile gap))))
                (when (< -1 index (length *dock-items*))
                  (ignore-errors (open-application (second (nth index *dock-items*)))))))))))))

(defun file-icon (path)
  (let ((mode (getf (ignore-errors (bsd:stat path)) :mode 0)))
    (icon-path (cond ((uiop:string-suffix-p path ".app") "mimetypes/application-x-executable")
                     ((= (logand mode bsd:+s-ifmt+) bsd:+s-ifdir+) "places/folder")
                     (t "mimetypes/text-x-generic")))))

(defun child-path (dir name)
  (if (string= dir "/") (format nil "/~a" name) (format nil "~a/~a" dir name)))

(defun directory-p (path)
  (let ((mode (getf (ignore-errors (bsd:stat path)) :mode 0)))
    (= (logand mode bsd:+s-ifmt+) bsd:+s-ifdir+)))

(defclass file-icon-view (kit:icon-view)
  ((path :initarg :path :reader path)
   (browser :initarg :browser :reader browser)))

(defmethod kit:mouse-down ((view file-icon-view) x y)
  (declare (ignore x y))
  (when (>= kit:*click-count* 2)
    (if (directory-p (path view))
        (browse (browser view) (path view))
        (when (uiop:string-suffix-p (path view) ".app")
          (let ((program (format nil "~a/Contents/Programs/~a" (path view)
                                 (subseq (pathname-name (path view)) 0))))
            (ignore-errors (open-application program))))))
  t)

(defun browse (window path)
  (let* ((content (kit:content-view window))
         (names (sort (remove-if (lambda (n) (char= (char n 0) #\.))
                                 (or (ignore-errors (bsd:readdir path)) nil))
                      #'string-lessp))
         (columns 6) (cell 92) (row 96))
    (kit:remove-subviews content)
    (kit:set-window-title window (if (string= path "/") "darterfly HD" (subseq path (1+ (position #\/ path :from-end t)))))
    (loop :for name :in names
          :for i :from 0
          :do (let ((child (child-path path name)))
                (kit:add-subview content (make-instance 'file-icon-view
                                                        :path child :browser window
                                                        :icon-path (file-icon child) :label name
                                                        :frame (vector (+ 8 (* cell (mod i columns)))
                                                                       (+ 8 (* row (floor i columns)))
                                                                       cell row)))))))

(defclass desktop-app-view (kit:icon-view)
  ((app :initarg :app :reader desktop-app)))

(defmethod kit:mouse-down ((view desktop-app-view) x y)
  (declare (ignore x y))
  (when (>= kit:*click-count* 2) (launch-app (desktop-app view)))
  t)

(defclass disk-view (kit:icon-view) ())

(defmethod kit:mouse-down ((view disk-view) x y)
  (declare (ignore x y))
  (when (>= kit:*click-count* 2)
    (let ((window (kit:make-window :title "darterfly HD" :x 120 :y 80 :width 600 :height 420)))
      (browse window "/")
      (kit:show window)))
  t)

(bsd:define-program "Files" (argv envp)
  (setf kit:*menus* (list (list "Files" (cons "About Files" nil)
                            (cons "Set Up darterfly..." (lambda (sender) (declare (ignore sender)) (launch-app "Setup"))))
                          (list "File" (cons "New Window" nil)) (list "Edit" (cons "Copy" nil))
                          (list "View" (cons "as Icons" nil)) (list "Go" (cons "Computer" nil))
                          (list "Window" (cons "Minimize" nil)) (list "Help" (cons "darterfly Help" nil))))
  (multiple-value-bind (width height) (screen-size)
    (let ((desktop (kit:make-window :style :borderless :level :desktop :x 0 :y 0 :width width :height height
                                    :background (desktop-color))))
      (kit:add-subview (kit:content-view desktop)
                       (make-instance 'disk-view :icon-path (icon-path "devices/drive-harddisk")
                                                 :label "darterfly HD" :label-color #(1.0 1.0 1.0)
                                                 :frame (vector (- width 112) 36 100 90)))
      (when (equal (darterfly/devices:boot-arg "rd") "ram")
        (kit:add-subview (kit:content-view desktop)
                         (make-instance 'desktop-app-view :app "Install"
                                        :icon-path (icon-path "mimetypes/application-x-executable")
                                        :label "Install darterfly" :label-color #(1.0 1.0 1.0)
                                        :frame (vector (- width 120) 144 116 90))))
      (kit:show desktop)
      (bsd:bsdthread-create
       (lambda ()
         (let ((color (desktop-color)))
           (loop (sleep 1)
                 (unless (equalp color (desktop-color))
                   (setf color (desktop-color))
                   (kit:perform-on-main
                    (lambda ()
                      (setf (kit:background (kit:content-view desktop)) (desktop-color))
                      (kit:needs-display (kit:content-view desktop))))))))
       "desktop appearance")
      (kit:run))))

(bsd:define-program "darterfly-gui" (argv envp)
  (darterfly/init:bootstrap-look-up "windowserver")
  0)
