(in-package #:finch/apps)

(defun text-layer (string font r g b &optional (a 1.0))
  (let* ((width (ceiling (+ 2 (text:string-width font string))))
         (height (ceiling (+ (text:font-ascent font) (text:font-descent font))))
         (bitmap (text:make-bitmap width height)))
    (text:draw-string bitmap font string 1 (text:font-ascent font) r g b a)
    (let ((layer (ca:make-layer :contents (ca:image width height (text:bitmap-pixels bitmap)))))
      (setf (ca:layer-frame layer) (vector 0 0 width height))
      layer)))

(defun screen-size ()
  (values 1024 768))

(defun clock ()
  (multiple-value-bind (s m h day month year weekday) (decode-universal-time (get-universal-time))
    (declare (ignore s year))
    (format nil "~a ~a ~d  ~d:~2,'0d ~a"
            (nth weekday '("Mon" "Tue" "Wed" "Thu" "Fri" "Sat" "Sun"))
            (nth (1- month) '("Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec"))
            day (if (zerop (mod h 12)) 12 (mod h 12)) m (if (< h 12) "AM" "PM"))))

(bsd:define-program "loginwindow" (argv envp)
  (dolist (label '("com.apple.Finder" "com.apple.SystemUIServer.agent" "com.apple.Dock.agent"))
    (finch/launchd:kickstart label))
  (loop (bsd:pause)))

(bsd:define-program "SystemUIServer" (argv envp)
  (let* ((context (ca:context-create))
         (width (screen-size))
         (font (text:font "SFNS" 13))
         (bar (ca:make-layer :background-color #(0.96 0.96 0.96 0.92))))
    (setf (ca:layer-frame bar) (vector 0 0 width 24)
          (ca:context-layer context) bar)
    (flet ((draw ()
             (let ((name (place (text-layer "finch" (text:font "SFNS" 14) 0.0 0.0 0.0) 14 3))
                   (time (text-layer (clock) font 0.0 0.0 0.0)))
               (place time (- width (round (aref (ca:layer-frame time) 2)) 14) 4)
               (setf (ca:layer-sublayers bar) (list name time))
               (ca:commit context))))
      (draw)
      (ca:window-create context 0 0 width 24 :level :main-menu)
      (loop (sleep 30) (draw)))))

(defparameter *dock-items*
  '(("Terminal" "/System/Applications/Utilities/Terminal.app/Contents/MacOS/Terminal" #(0.15 0.15 0.15 1.0))
    ("Hello" "/Applications/Hello.app/Contents/MacOS/Hello" #(0.25 0.55 0.95 1.0))))

(bsd:define-program "Dock" (argv envp)
  (multiple-value-bind (width height) (screen-size)
    (let* ((context (ca:context-create))
           (tile 56) (gap 12)
           (dock-width (+ gap (* (length *dock-items*) (+ tile gap))))
           (font (text:font "SFNS" 10))
           (dock (ca:make-layer :background-color #(0.85 0.85 0.88 0.85)
                                :sublayers (loop :for (name nil color) :in *dock-items*
                                                 :for x :from gap :by (+ tile gap)
                                                 :collect (let ((icon (ca:make-layer :background-color color))
                                                                (label (text-layer name font 0.1 0.1 0.1)))
                                                            (setf (ca:layer-frame icon) (vector x 8 tile tile))
                                                            (place label (+ x (round (- tile (aref (ca:layer-frame label) 2)) 2)) (+ 10 tile))
                                                            (setf (ca:layer-sublayers icon) nil)
                                                            (list icon label))))))
      (setf (ca:layer-sublayers dock) (apply #'append (ca:layer-sublayers dock))
            (ca:layer-frame dock) (vector 0 0 dock-width 88)
            (ca:context-layer context) dock)
      (ca:commit context)
      (ca:window-create context (floor (- width dock-width) 2) (- height 92) dock-width 88 :level :dock)
      (loop
        (let ((event (ca:next-event context)))
          (when (and event (eq (finch/server:event-type event) :left-mouse-down))
            (let ((x (first (finch/server:event-window-location event))))
              (let ((index (floor (- x gap) (+ tile gap))))
                (when (< -1 index (length *dock-items*))
                  (bsd:posix-spawn (second (nth index *dock-items*))
                                   (list (second (nth index *dock-items*))) nil))))))))))

(bsd:define-program "Finder" (argv envp)
  (multiple-value-bind (width height) (screen-size)
    (let* ((context (ca:context-create))
           (desktop (ca:make-layer :background-color #(0.18 0.36 0.56 1.0)))
           (disk (ca:make-layer :background-color #(0.75 0.78 0.82 1.0)))
           (label (text-layer "Macintosh HD" (text:font "SFNS" 12) 1.0 1.0 1.0)))
      (setf (ca:layer-frame desktop) (vector 0 0 width height)
            (ca:layer-frame disk) (vector (- width 88) 40 48 40))
      (place label (- width 64 (round (aref (ca:layer-frame label) 2) 2)) 84)
      (setf (ca:layer-sublayers desktop) (list disk label)
            (ca:context-layer context) desktop)
      (ca:commit context)
      (ca:window-create context 0 0 width height :level :desktop)
      (loop (bsd:pause)))))

(bsd:define-program "finch-gui" (argv envp)
  (finch/launchd:bootstrap-look-up "com.apple.windowserver")
  0)
