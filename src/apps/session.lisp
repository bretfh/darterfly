(in-package #:darterfly/apps)

(defun text-layer (string font r g b &optional (a 1.0))
  (let* ((width (ceiling (+ 2 (text:string-width font string))))
         (height (ceiling (+ (text:font-ascent font) (text:font-descent font))))
         (bitmap (text:make-bitmap width height)))
    (text:draw-string bitmap font string 1 (text:font-ascent font) r g b a)
    (let ((layer (layer:make-layer :contents (layer:image width height (text:bitmap-pixels bitmap)))))
      (setf (layer:layer-frame layer) (vector 0 0 width height))
      layer)))

(defun screen-size ()
  (destructuring-bind (x y width height) (layer:main-display-bounds)
    (declare (ignore x y))
    (values width height)))

(defun clock ()
  (multiple-value-bind (s m h day month year weekday) (decode-universal-time (get-universal-time))
    (declare (ignore s year))
    (format nil "~a ~a ~d  ~a"
            (nth weekday '("Mon" "Tue" "Wed" "Thu" "Fri" "Sat" "Sun"))
            (nth (1- month) '("Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec"))
            day (if (getf *desktop-preferences* :clock-24)
                    (format nil "~2,'0d:~2,'0d" h m)
                    (format nil "~d:~2,'0d ~a" (if (zerop (mod h 12)) 12 (mod h 12)) m (if (< h 12) "AM" "PM"))))))

(bsd:define-program "Session" (argv envp)
  (setf *desktop-preferences* (read-desktop-preferences))
  (dolist (label '("darterfly.files" "darterfly.menubar" "darterfly.dock"))
    (darterfly/init:launch label))
  (cond ((equal (darterfly/devices:boot-arg "rd") "ram") (launch-app "Install"))
        ((setup-needed-p) (launch-app "Setup")))
  (bsd:resume-processes)
  (loop (bsd:pause)))

(defun battery-layer (battery)
  (let* ((width 26) (height 12)
         (bitmap (text:make-bitmap width height))
         (percent (getf battery :percent))
         (inner (round (* 19 percent) 100)))
    (text:fill-rect bitmap 0 0 23 12 0.15 0.15 0.15)
    (text:fill-rect bitmap 1 1 21 10 0.96 0.96 0.96)
    (text:fill-rect bitmap 23 3 3 6 0.15 0.15 0.15)
    (multiple-value-bind (r g b)
        (cond ((getf battery :charging) (values 0.22 0.62 0.28))
              ((< percent 20) (values 0.85 0.22 0.18))
              (t (values 0.15 0.15 0.15)))
      (when (plusp inner) (text:fill-rect bitmap 2 2 inner 8 r g b)))
    (let ((layer (layer:make-layer :contents (layer:image width height (text:bitmap-pixels bitmap)))))
      (setf (layer:layer-frame layer) (vector 0 0 width height))
      layer)))

(defun signal-bars (signal)
  (cond ((null signal) 0) ((> signal -55) 4) ((> signal -65) 3) ((> signal -75) 2) ((> signal -85) 1) (t 0)))

(defun network-layer (status font)
  (if (eq (getf status :kind) :wired)
      (text-layer "Wired" font 0.15 0.15 0.15)
      (let* ((bars (if (getf status :up) (signal-bars (getf status :signal)) 0))
             (name (and (getf status :up) (getf status :ssid)))
             (label (and name (text-layer name font 0.15 0.15 0.15)))
             (label-width (if label (+ 6 (round (aref (layer:layer-frame label) 2))) 0))
             (width (+ 16 label-width)) (height 16)
             (bitmap (text:make-bitmap width height)))
        (dotimes (i 4)
          (let ((h (* 3 (1+ i))))
            (multiple-value-call #'text:fill-rect bitmap (* i 4) (- height 2 h) 3 h
              (if (< i bars) (values 0.15 0.15 0.15) (values 0.72 0.72 0.72)))))
        (let ((layer (layer:make-layer :contents (layer:image width height (text:bitmap-pixels bitmap)))))
          (setf (layer:layer-frame layer) (vector 0 0 width height))
          (when label
            (place label 22 0)
            (setf (layer:layer-sublayers layer) (list label)))
          layer))))

(bsd:define-program "MenuBar" (argv envp)
  (let* ((context (layer:context-create))
         (width (screen-size))
         (font (kit:ui-font 12))
         (bar (layer:make-layer :background-color #(0.96 0.96 0.96 0.92))))
    (let ((bitmap (text:make-bitmap width 26)))
      (kit::rounded-gradient bitmap 0 0 width 26 0 (kit::rgb8 244 244 244) (kit::rgb8 220 221 224))
      (setf (layer:layer-contents bar) (layer:image width 26 (text:bitmap-pixels bitmap))))
    (setf (layer:layer-frame bar) (vector 0 0 width 26)
          (layer:context-layer context) bar)
    (flet ((draw ()
             (let* ((time (text-layer (clock) font 0.0 0.0 0.0))
                    (left (- width (round (aref (layer:layer-frame time) 2)) 14))
                    (battery (ignore-errors (darterfly/devices:battery))))
               (place time left 4)
               (let* ((items (list time))
                      (edge left))
                 (when battery
                   (let* ((gauge (battery-layer battery))
                          (text (text-layer (format nil "~d%" (getf battery :percent)) font 0.0 0.0 0.0))
                          (gauge-x (- left 18 (round (aref (layer:layer-frame gauge) 2)))))
                     (place gauge gauge-x 6)
                     (setf edge (- gauge-x 4 (round (aref (layer:layer-frame text) 2))))
                     (place text edge 4)
                     (setf items (list* text gauge items))))
                 (let ((net (ignore-errors (network-layer (darterfly/wifi:network-status) font))))
                   (when net
                     (place net (- edge 18 (round (aref (layer:layer-frame net) 2))) 4)
                     (push net items)))
                 (setf (layer:layer-sublayers bar) items))
               (layer:commit context))))
      (draw)
      (layer:window-create context 0 0 width 26 :level :menu-background :order :below)
      (loop (sleep 5) (draw)))))

(defparameter +icons+ "/usr/share/icons/Adwaita/")

(defparameter *dock-items*
  '(("Files" "/System/Library/Services/Files.app/Contents/Programs/Files" #(0.21 0.52 0.89 1.0)
     "legacy/system-file-manager-symbolic")
    ("Terminal" "/System/Applications/Utilities/Terminal.app/Contents/Programs/Terminal" #(0.24 0.22 0.27 1.0)
     "legacy/utilities-terminal-symbolic")
    ("Listener" "/System/Applications/Listener.app/Contents/Programs/Listener" #(0.90 0.38 0.0 1.0)
     "actions/system-run-symbolic")
    ("Generations" "/System/Applications/Generations.app/Contents/Programs/Generations" #(0.20 0.55 0.35 1.0)
     "status/software-update-available-symbolic")))

(defun icon-path (name) (format nil "~a~a.png" +icons+ name))

(defun icon-layer (name color size)
  ;; Application bundles supply their own full-size artwork. Theme glyphs
  ;; retain the existing inset tile treatment.
  (when (and name (uiop:absolute-pathname-p name))
    (let ((pixels (ignore-errors (darterfly/imageio:icon name size))))
      (when pixels
        (return-from icon-layer
          (layer:make-layer :contents (layer:image size size pixels))))))
  (let ((tile (text:make-bitmap size size))
        (inset (round size 4))
        (glyph (ignore-errors (darterfly/imageio:icon (icon-path name) (- size (* 2 (round size 4)))))))
    (text:fill-round-rect tile 0 0 size size (round size 5) (aref color 0) (aref color 1) (aref color 2))
    (when glyph
      (let ((out (text:bitmap-pixels tile)) (g (- size (* 2 inset))))
        (dotimes (y g)
          (dotimes (x g)
            (let* ((from (* 4 (+ x (* y g))))
                   (to (* 4 (+ inset x (* (+ inset y) size))))
                   (keep (- 255 (aref glyph (+ from 3)))))
              (dotimes (c 4)
                (setf (aref out (+ to c)) (min 255 (+ (aref glyph (+ from c)) (round (* keep (aref out (+ to c))) 255))))))))))
    (layer:make-layer :contents (layer:image size size (text:bitmap-pixels tile)))))

(defun available-dock-items ()
  (let ((nyxt "/System/Applications/Nyxt.app/Contents/Programs/Nyxt"))
    (append *dock-items*
      (when (ignore-errors (bsd:stat nyxt))
        (list (list "Nyxt" nyxt #(0.88 0.40 0.12)
                    "/System/Applications/Nyxt.app/Contents/Resources/icon.png"))))))

(defclass dock-view (kit:view)
  ((layout :initform nil :accessor dock-geometry)
   (windows :initform nil :accessor dock-windows)
   (thumbs :initform nil :accessor dock-thumbs)
   (pressed :initform nil :accessor dock-pressed)
   (hover :initform nil :accessor dock-hover)
   (pending :initform nil :accessor dock-pending)
   (window :initarg :window :reader dock-window)))

(defun dock-item-at (view x y)
  (find-if (lambda (item)
             (destructuring-bind (ix iy w h) (getf item :frame)
               (declare (ignore h)) (and (<= ix x (+ ix w)) (<= iy y 72))))
           (getf (dock-geometry view) :items)))
(defun dock-item-icon (app)
  (or (fourth (assoc app (available-dock-items) :test #'equal))
      (if (equal app "Editor") "legacy/accessories-text-editor-symbolic" "actions/system-run-symbolic")))
(defmethod kit:draw ((view dock-view) bitmap)
  (kit::rounded-gradient bitmap 0 0 (kit:view-width view) 78 12 (kit::rgb8 224 222 218) (kit::rgb8 206 203 199))
  (dolist (item (getf (dock-geometry view) :items))
    (destructuring-bind (x y w h) (getf item :frame)
      (when (equal (getf item :key) (dock-hover view))
        (text:fill-round-rect bitmap (- x 4) 4 (+ w 8) 68 5 .76 .73 .68 .65))
      (case (getf item :kind)
        (:app
         (let* ((app (getf item :key)) (entry (assoc app (available-dock-items) :test #'equal))
                (icon (icon-layer (dock-item-icon app) (or (third entry) #(.32 .38 .45 1.0)) 44))
                (pixels (getf (layer:layer-contents icon) :pixels)))
           (kit:draw-rgba bitmap pixels 44 44 x y)
           (when (getf item :running)
             (text:fill-round-rect bitmap (+ x 19) 72 6 3 1 .39 .36 .32))
           (when (plusp (getf item :count 0))
             (text:fill-round-rect bitmap (+ x 33) 2 19 15 6 .35 .32 .28)
             (kit::ink-string bitmap (princ-to-string (getf item :count)) (+ x 37) 13 10 :paper))))
        (:window
         (let ((thumb (cdr (assoc (getf item :key) (dock-thumbs view) :test #'equal))))
           (text:fill-round-rect bitmap (1- x) (1- y) (+ w 2) (+ h 2) 4 .53 .49 .43)
           (if thumb (kit:draw-rgba bitmap (getf thumb :pixels) 72 44 x y)
               (text:fill-rect bitmap x y w h .85 .82 .77))
           (let ((icon (icon-layer (dock-item-icon (getf item :app)) #(.32 .38 .45 1.0) 18)))
             (kit:draw-rgba bitmap (getf (layer:layer-contents icon) :pixels) 18 18 (+ x w -14) (+ y h -14)))))
        (:more
         (text:fill-round-rect bitmap x y w h 5 .85 .82 .77)
         (kit::ink-string bitmap (format nil "+~d" (getf item :count)) (+ x 12) (+ y 28) 16)))
      (let* ((font (kit:ui-font 10)) (span (if (eq :app (getf item :kind)) 66 w))
             (label (kit::fit-label (getf item :label) font span)))
        (kit::ink-string bitmap label (+ x (round (- w (text:string-width font label)) 2)) 66 10 :ink span))))
  ;; A single full-title line for the hovered window, within the Dock's bounds.
  )
(defun apply-dock-state (view state)
  (if (dock-pressed view) (setf (dock-pending view) state)
      (destructuring-bind (layout windows thumbs) state
        (unless (equalp state (list (dock-geometry view) (dock-windows view) (dock-thumbs view)))
          (setf (dock-geometry view) layout (dock-windows view) windows (dock-thumbs view) thumbs)
          (destructuring-bind (x y w h) (getf layout :frame)
            (kit::window-frame-changed (dock-window view) (list x y w h))
            (layer:transaction-commit (list (list :shape (kit::window-id (dock-window view)) w h)
                                            (list :move (kit::window-id (dock-window view)) x y))))
          (kit:needs-display view)))))
(defmethod kit:mouse-down ((view dock-view) x y)
  (setf (dock-pressed view) (getf (dock-item-at view x y) :key)) t)
(defmethod kit:mouse-moved ((view dock-view) x y)
  (let ((key (getf (dock-item-at view x y) :key)))
    (unless (equal key (dock-hover view)) (setf (dock-hover view) key) (kit:needs-display view))))
(defmethod kit:mouse-exited ((view dock-view)) (setf (dock-hover view) nil) (kit:needs-display view))
(defmethod kit::cancel-pointer ((view dock-view))
  (setf (dock-pressed view) nil)
  (when (dock-pending view) (apply-dock-state view (shiftf (dock-pending view) nil))))
(defmethod kit:mouse-up ((view dock-view) x y)
  (let ((item (dock-item-at view x y)) (pressed (shiftf (dock-pressed view) nil)))
    (when (and pressed (equal pressed (getf item :key)))
      (case (getf item :kind)
        (:app
         (if (member :control kit:*key-modifiers*) (kit:read-window :app pressed)
             (unless (layer:activate-application pressed)
               (let ((entry (assoc pressed *dock-items* :test #'equal)))
                 (when entry (bsd:posix-spawn (second entry) (list (second entry)) nil))))))
        (:window (layer:window-restore pressed :reduced-motion kit:*reduced-motion*))
        (:more (kit:read-window :minimized (getf item :minimized-only))))))
  (when (dock-pending view) (apply-dock-state view (shiftf (dock-pending view) nil))))

(bsd:define-program "Dock" (argv envp)
  (let ((*dock-items* (available-dock-items)))
    (setf layer:*dock-pinned-applications* (mapcar #'first *dock-items*))
  (multiple-value-bind (width height) (screen-size)
    (let* ((initial (layer:dock-layout nil width height))
           (rect (getf initial :frame))
           (window (kit:make-window :title "Dock" :style :borderless :level :dock
                                    :x (first rect) :y (second rect) :width (third rect) :height (fourth rect)))
           (view (make-instance 'dock-view :window window :frame (vector 0 0 (third rect) (fourth rect)))))
      (setf (dock-geometry view) initial)
      (kit:add-subview (kit:content-view window) view)
      (kit:show window)
      (bsd:bsdthread-create
       (lambda ()
         (let ((cache nil))
           (loop
             (handler-case
                 (multiple-value-bind (sw sh) (screen-size)
                   (let* ((windows (kit::all-window-descriptions))
                          (layout (layer:dock-layout windows sw sh))
                          (thumbs (loop for item in (getf layout :items)
                                        when (eq :window (getf item :kind))
                                        collect (let* ((key (getf item :key))
                                                       (version (list key (getf item :version)))
                                                       (thumb (or (cdr (assoc version cache :test #'equal))
                                                                  (layer:window-thumbnail key)))) (cons key thumb)))))
                     (setf cache (loop for item in (getf layout :items) when (eq :window (getf item :kind))
                                       collect (cons (list (getf item :key) (getf item :version)) (cdr (assoc (getf item :key) thumbs :test #'equal)))))
                     (kit:perform-on-main (lambda () (apply-dock-state view (list layout windows thumbs))))))
               (error () nil))
             (sleep .2)))) "Dock discovery")
      (kit:run)))))

(defun file-icon (path)
  (let ((mode (getf (ignore-errors (bsd:stat path)) :mode 0)))
    (icon-path (cond ((uiop:string-suffix-p path ".app") "mimetypes/application-x-executable")
                     ((= (logand mode bsd:+s-ifmt+) bsd:+s-ifdir+) "places/folder")
                     (t "mimetypes/text-x-generic")))))

(defun child-path (dir name)
  (if (string= dir "/") (format nil "/~a" name) (format nil "~a/~a" dir name)))

(defun directory-p (path)
  (let ((mode (getf (ignore-errors (bsd:stat path)) :mode 0)))
    (= (logand mode bsd:+s-ifmt+) bsd:+s-ifdir+)))

(defclass file-icon-view (kit:icon-view)
  ((path :initarg :path :reader path)
   (browser :initarg :browser :reader browser)))

(defmethod kit:mouse-down ((view file-icon-view) x y)
  (declare (ignore x y))
  (when (>= kit:*click-count* 2)
    (if (directory-p (path view))
        (browse (browser view) (path view))
        (when (uiop:string-suffix-p (path view) ".app")
          (let ((program (format nil "~a/Contents/Programs/~a" (path view)
                                 (subseq (pathname-name (path view)) 0))))
            (ignore-errors (open-application program))))))
  t)

(defun browse (window path)
  (kit:set-window-location window path)
  (let* ((content (kit:content-view window))
         (names (sort (remove-if (lambda (n) (char= (char n 0) #\.))
                                 (or (ignore-errors (bsd:readdir path)) nil))
                      #'string-lessp))
         (columns 6) (cell 92) (row 96))
    (kit:remove-subviews content)
    (kit:set-window-title window (if (string= path "/") "darterfly HD" (subseq path (1+ (position #\/ path :from-end t)))))
    (loop :for name :in names
          :for i :from 0
          :do (let ((child (child-path path name)))
                (kit:add-subview content (make-instance 'file-icon-view
                                                        :path child :browser window
                                                        :icon-path (file-icon child) :label name
                                                        :frame (vector (+ 8 (* cell (mod i columns)))
                                                                       (+ 8 (* row (floor i columns)))
                                                                       cell row)))))))

(defclass desktop-app-view (kit:icon-view)
  ((app :initarg :app :reader desktop-app)))

(defmethod kit:mouse-down ((view desktop-app-view) x y)
  (declare (ignore x y))
  (when (>= kit:*click-count* 2) (launch-app (desktop-app view)))
  t)

(defclass disk-view (kit:icon-view) ())

(defmethod kit:open-application ((view disk-view))
  (let ((window (kit:make-window :title "darterfly HD" :x 120 :y 80 :width 600 :height 420
                                :min-width 600 :min-height 420)))
    (browse window "/")
    (kit:show window)))

(defmethod kit:mouse-down ((view disk-view) x y)
  (declare (ignore x y))
  (when (>= kit:*click-count* 2) (kit:open-application view))
  t)

(defclass desktop-view (kit:view)
  ((image :initform nil :accessor desktop-image)
   (scaled :initform nil :accessor desktop-scaled)
   (size :initform nil :accessor desktop-image-size)))

(defmethod kit:draw ((view desktop-view) bitmap)
  (let ((color (desktop-color)))
    (apply #'text:fill-bitmap bitmap (coerce color 'list))
    (when (eq (getf *desktop-preferences* :color) :ocean)
      (handler-case
          (let ((size (list (kit:view-width view) (kit:view-height view))))
            (unless (desktop-image view)
              (setf (desktop-image view) (multiple-value-list
                 (darterfly/imageio:read-image "/System/Library/Desktop Pictures/Asheville Drawn.png"))))
            (unless (equal size (desktop-image-size view))
              (setf (desktop-scaled view) (apply #'darterfly/imageio:cover-rgba (append (desktop-image view) size))
                    (desktop-image-size view) size))
            (replace (text:bitmap-pixels bitmap) (desktop-scaled view)))
        (error (e) (format *error-output* "Desktop artwork: ~a~%" e))))))

(bsd:define-program "Files" (argv envp)
  (setf kit:*menus* (list (list "Files" (cons "About Files" nil)
                            (cons "Set Up darterfly..." (lambda (sender) (declare (ignore sender)) (launch-app "Setup"))))
                          (list "File" (cons "New Window" nil)) (list "Edit" (cons "Copy" nil))
                          (list "View" (cons "as Icons" nil)) (list "Go" (cons "Computer" nil))
                          (list "Window" (cons "Minimize" nil)) (list "Help" (cons "darterfly Help" nil))))
  (multiple-value-bind (width height) (screen-size)
    (let ((desktop (kit:make-window :style :borderless :level :desktop :x 0 :y 0 :width width :height height
                                    :background (desktop-color))))
      (let ((background (make-instance 'desktop-view :frame (vector 0 0 width height))))
        (kit:add-subview (kit:content-view desktop) background))
      (kit:add-subview (kit:content-view desktop)
                       (make-instance 'disk-view :icon-path (icon-path "devices/drive-harddisk")
                                                 :label "darterfly HD" :label-color #(1.0 1.0 1.0)
                                                 :frame (vector (- width 112) 36 100 90)))
      (when (equal (darterfly/devices:boot-arg "rd") "ram")
        (kit:add-subview (kit:content-view desktop)
                         (make-instance 'desktop-app-view :app "Install"
                                        :icon-path (icon-path "mimetypes/application-x-executable")
                                        :label "Install darterfly" :label-color #(1.0 1.0 1.0)
                                        :frame (vector (- width 120) 144 116 90))))
      (kit:show desktop)
      (bsd:bsdthread-create
       (lambda ()
         (let ((color (desktop-color)))
           (loop (sleep 1)
                 (unless (equalp color (desktop-color))
                   (setf color (desktop-color))
                   (kit:perform-on-main
                    (lambda ()
                      (setf (kit:background (kit:content-view desktop)) (desktop-color))
                      (kit:needs-display (first (kit:subviews (kit:content-view desktop))))
                      (kit:needs-display (kit:content-view desktop))))))))
       "desktop appearance")
      (kit:run))))

(bsd:define-program "darterfly-gui" (argv envp)
  (darterfly/init:bootstrap-look-up "windowserver")
  0)
