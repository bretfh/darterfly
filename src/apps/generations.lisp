(in-package #:darterfly/apps)

(defun generation-lines ()
  (let ((current (ignore-errors (darterfly/install:current)))
        (failed (ignore-errors (darterfly/install:failed))))
    (append
     (list (cons "Generations (click one to boot it next)" nil))
     (loop :for name :in (ignore-errors (darterfly/install:generations))
           :for manifest := (ignore-errors (darterfly/install:manifest name))
           :collect (cons (format nil "~a~:[         ~; (current)~] ~@[~a~]~@[ from ~a~]~:[~; (never came up)~]" name (equal name current)
                                  (getf manifest :build-id) (getf manifest :parent) (equal name failed))
                          (list :generation name)))
     (list (cons "" nil))
     (let ((progress (ignore-errors (darterfly/generation:progress))))
       (if progress
           (let* ((steps (getf progress :steps))
                  (busy (find-if (lambda (s) (member (second s) '(:running :failed))) steps)))
             (list (cons (format nil "Build into ~a: ~d of ~d steps done~:[~;, finished~]~@[, ~(~a~)~]~@[ ~a~]"
                                 (getf progress :out) (count :done steps :key #'second) (length steps)
                                 (getf progress :finished) (second busy) (first busy))
                         nil)))
           (list (cons "No build yet" nil))))
     (list (cons "" nil)
           (cons "Build the next generation" (list :build))))))

(defun generations-choose (view)
  (lambda (object)
    (case (first object)
      (:generation (ignore-errors (darterfly/install:select (second object))))
      (:build (unless (ignore-errors (darterfly/generation:pending-build))
                (darterfly/generation:start))))
    (setf (lines view) (generation-lines))
    (kit:needs-display view)))

(bsd:define-program "Generations" (argv envp)
  (setf kit:*menus* (kit:standard-menus "Generations"))
  (let* ((window (kit:make-window :title "Generations" :x 200 :y 110 :width 720 :height 480))
         (view (make-instance 'transcript-view :file "/tmp/Generations.txt" :frame (vector 0 0 696 428))))
    (setf (choose view) (generations-choose view)
          (lines view) (generation-lines))
    (kit:add-subview (kit:content-view window) view)
    (kit:show window)
    (bsd:bsdthread-create
     (lambda ()
       (loop (sleep 2)
             (let ((lines (generation-lines)))
               (kit:perform-on-main (lambda () (setf (lines view) lines) (kit:needs-display view))))))
     "generations refresh")
    (kit:run)))
