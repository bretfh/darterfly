(in-package #:darterfly/apps)

(defparameter +editor-colors+
  '(:comment (0.45 0.45 0.45) :string (0.1 0.5 0.1) :keyword (0.55 0.2 0.6) :char (0.7 0.4 0.0)))

(defclass editor-view (kit:view)
  ((buffer :initarg :buffer :reader editor-buffer)
   (window :initarg :window :reader editor-window)
   (top :initform 0 :accessor editor-top)
   (echo :initform "" :accessor editor-echo)
   (prefix :initform nil :accessor editor-prefix)
   (diagnostics :initform nil :accessor editor-diagnostics)))

(defun compile-diagnostics (path)
  (let ((found nil)
        (text (uiop:read-file-string path))
        (fasl (format nil "/tmp/~a.fasl" (pathname-name path))))
    (flet ((line-of (pos)
             (if pos
                 (let ((at (or (position-if-not (lambda (c) (member c '(#\Space #\Tab #\Newline))) text :start (min pos (length text)))
                               (length text))))
                   (count #\Newline text :end at))
                 0)))
      (multiple-value-bind (output warnings failure)
          (handler-bind ((warning (lambda (c)
                                    (let* ((context (ignore-errors (sb-c::find-error-context nil)))
                                           (pos (and context (sb-c::compiler-error-context-file-position context))))
                                      (push (list (line-of pos) (if (typep c 'style-warning) :style-warning :warning)
                                                  (substitute #\Space #\Newline (princ-to-string c)))
                                            found))
                                    (muffle-warning c))))
            (let ((*compile-verbose* nil) (*compile-print* nil))
              (compile-file path :output-file fasl)))
        (declare (ignore warnings))
        (when (and output (not failure)) (load output))
        (values (sort (nreverse found) #'< :key #'first) (and output (not failure)))))))

(defun compiled (view)
  (let ((path (edit:buffer-path (editor-buffer view))))
    (bsd:bsdthread-create
     (lambda ()
       (multiple-value-bind (found loaded) (handler-case (compile-diagnostics path)
                                             (error (e) (values (list (list 0 :error (princ-to-string e))) nil)))
         (kit:perform-on-main
          (lambda ()
            (setf (editor-diagnostics view) found
                  (editor-echo view) (format nil "compiled~:[, not loaded~;~]: ~d warning~:p, ~d style warning~:p"
                                             loaded (count-if-not (lambda (d) (eq (second d) :style-warning)) found)
                                             (count :style-warning found :key #'second)))
            (kit:needs-display view)))))
     "editor compile")))

(defun next-diagnostic (view)
  (let* ((buffer (editor-buffer view))
         (at (edit:buffer-point-line buffer))
         (found (editor-diagnostics view))
         (next (or (find-if (lambda (d) (> (first d) at)) found) (first found))))
    (if next
        (progn (edit:goto buffer (first next) 0)
               (setf (editor-echo view) (format nil "L~d ~(~a~): ~a" (1+ (first next)) (second next) (third next))))
        (setf (editor-echo view) "no diagnostics"))))

(defun text-rows (view)
  (max 1 (- (floor (- (kit:view-height view) 8) +line-height+) 2)))

(defun scrolled (view)
  (let ((at (edit:buffer-point-line (editor-buffer view)))
        (rows (text-rows view))
        (top (editor-top view)))
    (setf (editor-top view)
          (if (or (< at top) (>= at (+ top rows))) (max 0 (- at (floor rows 2))) top))))

(defun state-at (buffer line)
  (let ((state nil))
    (dotimes (i line state)
      (setf state (nth-value 1 (edit:spans (edit:buffer-line buffer i) state))))))

(defun mode-line (buffer)
  (format nil " ~:[  ~;** ~]~a   L~d C~d" (edit:buffer-modified-p buffer) (edit:buffer-name buffer)
          (1+ (edit:buffer-point-line buffer)) (edit:buffer-point-col buffer)))

(defun draw-spans (bitmap font line state x y cw)
  (multiple-value-bind (spans after) (edit:spans line state)
    (let ((at 0))
      (flet ((run (from to color)
               (when (< from to)
                 (destructuring-bind (r g b) color
                   (text:draw-string bitmap font (subseq line from to) (+ x (* cw from)) y r g b)))))
        (loop :for (from to kind) :in spans
              :do (run at from '(0.0 0.0 0.0))
                  (run from to (getf +editor-colors+ kind))
                  (setf at to))
        (run at (length line) '(0.0 0.0 0.0))))
    after))

(defmethod kit:draw ((view editor-view) bitmap)
  (kit:fill-surface bitmap)
  (let* ((buffer (editor-buffer view))
         (font (text:font +listener-font+ +terminal-size+))
         (cw (text:string-width font "M"))
         (rows (text-rows view))
         (top (scrolled view))
         (state (state-at buffer top))
         (shown nil))
    (dotimes (i rows)
      (let ((n (+ top i)))
        (when (< n (edit:buffer-line-count buffer))
          (let ((line (substitute #\Space #\Tab (edit:buffer-line buffer n))))
            (push line shown)
            (let ((d (find n (editor-diagnostics view) :key #'first)))
              (when d
                (destructuring-bind (r g b) (if (eq (second d) :style-warning) '(0.95 0.6 0.1) '(0.85 0.1 0.1))
                  (text:fill-rect bitmap 0 (+ (* i +line-height+) 6) 4 +line-height+ r g b))))
            (setf state (draw-spans bitmap font line state 6 (+ (* (1+ i) +line-height+) 4 -4) cw))))))
    (let ((cy (* (- (edit:buffer-point-line buffer) top) +line-height+)))
      (text:fill-rect bitmap (round (+ 6 (* cw (edit:buffer-point-col buffer)))) (+ cy 6) 2 +line-height+ 0.1 0.3 0.8))
    (let ((y (* rows +line-height+)))
      (text:fill-rect bitmap 0 (+ y 6) (kit:view-width view) +line-height+ 0.85 0.85 0.85)
      (text:draw-string bitmap font (mode-line buffer) 6 (+ y +line-height+ 2) 0.1 0.1 0.1)
      (text:draw-string bitmap font (editor-echo view) 6 (+ y (* 2 +line-height+) 2) 0.0 0.0 0.0))
    (with-open-file (s "/tmp/Editor.txt" :direction :output :if-exists :supersede :if-does-not-exist :create)
      (format s "~{~a~%~}~a~%~a~%" (reverse shown) (mode-line buffer) (editor-echo view))
      (loop :for (line severity message) :in (editor-diagnostics view)
            :do (format s "! L~d ~(~a~): ~a~%" (1+ line) severity message)))))

(defun chord (char)
  (case char
    (#\Return "RET") (#\Tab "TAB") (#\Backspace "DEL")
    (#.(code-char #xF700) "Up") (#.(code-char #xF701) "Down")
    (#.(code-char #xF702) "Left") (#.(code-char #xF703) "Right")
    (#.(code-char #xF729) "Home") (#.(code-char #xF72B) "End")
    (#.(code-char #xF72C) "PageUp") (#.(code-char #xF72D) "PageDown")
    (#\Rubout "Delete")
    (t (if (< (char-code char) 32)
           (format nil "C-~c" (code-char (+ (char-code char) 96)))
           (string char)))))

(defun evaluated (view form)
  (bsd:bsdthread-create
   (lambda ()
     (let ((echo (handler-case (let ((*package* (find-package :cl-user)))
                                 (format nil "~{~a~^ ~}" (mapcar #'printed (multiple-value-list (eval form)))))
                   (error (e) (format nil "error: ~a" e)))))
       (kit:perform-on-main (lambda () (setf (editor-echo view) echo) (kit:needs-display view)))))
   "editor eval"))

(defun editor-command (view chord)
  (let ((buffer (editor-buffer view)))
    (flet ((echo (control &rest args) (setf (editor-echo view) (apply #'format nil control args))))
      (cond ((string= chord "C-f") (edit:forward-char buffer))
            ((string= chord "Right") (edit:forward-char buffer))
            ((string= chord "C-b") (edit:backward-char buffer))
            ((string= chord "Left") (edit:backward-char buffer))
            ((string= chord "C-n") (edit:next-line buffer))
            ((string= chord "Down") (edit:next-line buffer))
            ((string= chord "C-p") (edit:previous-line buffer))
            ((string= chord "Up") (edit:previous-line buffer))
            ((member chord '("Home" "C-a") :test #'string=) (edit:line-start buffer))
            ((member chord '("End" "C-e") :test #'string=) (edit:line-end buffer))
            ((string= chord "RET") (edit:newline buffer))
            ((string= chord "TAB") (edit:insert buffer "  "))
            ((string= chord "DEL") (edit:delete-backward buffer))
            ((member chord '("Delete" "C-d") :test #'string=) (edit:delete-forward buffer))
            ((string= chord "C-k") (edit:kill-line buffer))
            ((string= chord "C-g") (echo ""))
            ((string= chord "C-x C-s")
             (if (edit:buffer-path buffer)
                 (echo "wrote ~a" (edit:save-buffer buffer))
                 (echo "no file")))
            ((string= chord "C-x C-c") (kit:close-window (editor-window view)))
            ((string= chord "C-c C-k")
             (if (edit:buffer-path buffer)
                 (progn (edit:save-buffer buffer) (echo "compiling ~a" (edit:buffer-name buffer)) (compiled view))
                 (echo "no file")))
            ((string= chord "C-x `") (next-diagnostic view))
            ((string= chord "C-c C-c")
             (let ((form (ignore-errors (edit:toplevel-form buffer))))
               (if form (evaluated view form) (echo "no form"))))
            ((member chord '("C-x" "C-c") :test #'string=) (setf (editor-prefix view) chord) (echo "~a-" chord))
            ((= 1 (length chord)) (edit:insert buffer chord))
            (t (echo "~a is undefined" chord))))))

(defmethod kit:key-down ((view editor-view) characters keycode)
  (declare (ignore keycode))
  (let ((chord (chord (char characters 0)))
        (prefix (shiftf (editor-prefix view) nil)))
    (setf (editor-echo view) "")
    (editor-command view (if prefix (format nil "~a ~a" prefix chord) chord))
    (kit:needs-display view))
  t)

(defun edit-window (path)
  (let* ((buffer (edit:read-buffer path))
         (window (kit:make-window :title (edit:buffer-name buffer) :x 240 :y 120 :width 760 :height 520))
         (view (make-instance 'editor-view :buffer buffer :window window :frame (vector 0 0 736 468))))
    (kit:add-subview (kit:content-view window) view)
    (setf (kit:first-responder window) view)
    (kit:set-window-location window path)
    (kit:show window)
    window))

(defun ed-in-window (x)
  (when (or (stringp x) (pathnamep x))
    (kit:perform-on-main (lambda () (edit-window (uiop:native-namestring x))))
    t))

(bsd:define-program "Editor" (argv envp)
  (setf kit:*menus* (kit:standard-menus "Editor"))
  (edit-window (or (second argv) "/Users/darterfly/scratch.lisp"))
  (kit:run))
