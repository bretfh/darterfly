(in-package #:finch/osfmk)

(define-low digit ((d :u8))
  (if (< d 10) (+ 48 d) (+ 87 d)))

(define-low put-digits (v base)
  (when (>= v base) (put-digits (truncate v base) base))
  (serial-putc (digit (rem v base))))

(define-low put-unsigned (v base (width :u32) (pad :u8))
  (let ((n 1) (left v))
    (while (>= left base)
      (setf left (truncate left base))
      (incf n))
    (while (> width n)
      (serial-putc pad)
      (decf width))
    (put-digits v base)))

(define-low vkprintf (format ap)
  (let ((f format))
    (while (mem :u8 f)
      (if (/= (mem :u8 f) 37)
          (serial-putc (mem :u8 f))
          (let ((pad 32) (width 0) (wide 0) (c 0))
            (incf f)
            (when (= (mem :u8 f) 48)
              (setf pad 48)
              (incf f))
            (while (and (>= (mem :u8 f) 48) (<= (mem :u8 f) 57))
              (setf width (+ (* width 10) (- (mem :u8 f) 48)))
              (incf f))
            (while (= (mem :u8 f) 108)
              (setf wide 1)
              (incf f))
            (setf c (mem :u8 f))
            (cond ((= c 115)
                   (let ((s (va-next ap)))
                     (while (mem :u8 s)
                       (serial-putc (mem :u8 s))
                       (incf s))))
                  ((= c 99) (serial-putc (logand (va-next ap) #xFF)))
                  ((= c 100)
                   (let ((v (va-next ap)))
                     (unless wide
                       (setf v (logand v #xFFFFFFFF))
                       (when (logand v #x80000000)
                         (setf v (logior v #xFFFFFFFF00000000))))
                     (when (logand v #x8000000000000000)
                       (serial-putc 45)
                       (setf v (- 0 v)))
                     (put-unsigned v 10 width pad)))
                  ((= c 117)
                   (let ((v (va-next ap)))
                     (unless wide (setf v (logand v #xFFFFFFFF)))
                     (put-unsigned v 10 width pad)))
                  ((= c 120)
                   (let ((v (va-next ap)))
                     (unless wide (setf v (logand v #xFFFFFFFF)))
                     (put-unsigned v 16 width pad)))
                  ((= c 112)
                   (serial-putc 48)
                   (serial-putc 120)
                   (put-unsigned (va-next ap) 16 0 32))
                  (t (serial-putc 37) (serial-putc c)))))
      (incf f))))

(define-low kprintf (format &va ap)
  (vkprintf format ap))
