(in-package #:finch/osfmk)

(defconstant +max-entries+ 1024)
(defconstant +user-mmap-base+ #x0000200000000000)
(defconstant +io-map-base+ #xFFFFFE0000000000)
(defconstant +user-top+ #x0000800000000000)
(defconstant +prot-write+ 2)
(defconstant +prot-execute+ 4)

(define-global entry-start :u64 :count 1024)
(define-global entry-end :u64 :count 1024)
(define-global entry-prot :u64 :count 1024)
(define-global nentries :u64)
(define-global mmap-next :u64)
(define-global io-next :u64)

(define-low page-down (a) (logand a (lognot (- +page-size+ 1))))

(define-low page-up (a) (logand (+ a +page-size+ -1) (lognot (- +page-size+ 1))))

(define-low insert-at (i start end prot)
  (when (= nentries +max-entries+) (panic "vm_map: out of entries"))
  (let ((j nentries))
    (while (> j i)
      (setf (ref entry-start j) (ref entry-start (- j 1)))
      (setf (ref entry-end j) (ref entry-end (- j 1)))
      (setf (ref entry-prot j) (ref entry-prot (- j 1)))
      (decf j)))
  (setf (ref entry-start i) start)
  (setf (ref entry-end i) end)
  (setf (ref entry-prot i) prot)
  (incf nentries))

(define-low delete-at (i)
  (let ((j i))
    (while (< (+ j 1) nentries)
      (setf (ref entry-start j) (ref entry-start (+ j 1)))
      (setf (ref entry-end j) (ref entry-end (+ j 1)))
      (setf (ref entry-prot j) (ref entry-prot (+ j 1)))
      (incf j)))
  (decf nentries))

(define-low clip (at)
  (let ((i 0))
    (while (< i nentries)
      (when (and (< (ref entry-start i) at) (< at (ref entry-end i)))
        (insert-at (+ i 1) at (ref entry-end i) (ref entry-prot i))
        (setf (ref entry-end i) at)
        (result 0))
      (incf i))))

(define-low vm-map-remove (start len)
  (let ((s (page-down start))
        (e (page-up (+ start len)))
        (i 0))
    (clip s)
    (clip e)
    (while (< i nentries)
      (if (and (>= (ref entry-start i) s) (<= (ref entry-end i) e))
          (progn
            (pmap-remove (ref entry-start i) (- (ref entry-end i) (ref entry-start i)))
            (delete-at i))
          (incf i)))))

(define-low vm-map-reset (keep len)
  (let ((s (page-down keep))
        (e (page-up (+ keep len)))
        (i 0))
    (clip s)
    (clip e)
    (while (< i nentries)
      (if (or (and (>= (ref entry-start i) s) (<= (ref entry-end i) e))
              (>= (ref entry-start i) +user-top+))
          (incf i)
          (progn
            (pmap-remove (ref entry-start i) (- (ref entry-end i) (ref entry-start i)))
            (delete-at i))))))

(define-low vm-map-enter (start len (prot :u32))
  (let ((s (page-down start))
        (e (page-up (+ start len)))
        (i 0))
    (vm-map-remove s (- e s))
    (while (and (< i nentries) (< (ref entry-start i) s)) (incf i))
    (insert-at i s e prot)
    1))

(define-low vm-map-protect (start len (prot :u32))
  (let ((s (page-down start))
        (e (page-up (+ start len)))
        (i 0))
    (clip s)
    (clip e)
    (while (< i nentries)
      (when (and (>= (ref entry-start i) s) (<= (ref entry-end i) e))
        (setf (ref entry-prot i) prot))
      (incf i))
    (pmap-protect s (- e s) prot)))

(define-low vm-map-find-space (len)
  (when (= mmap-next 0) (setf mmap-next +user-mmap-base+))
  (let ((at mmap-next))
    (incf mmap-next (+ (page-up len) +page-size+))
    at))

(define-low lookup (va)
  (let ((i 0))
    (while (< i nentries)
      (when (and (<= (ref entry-start i) va) (< va (ref entry-end i)))
        (result i))
      (incf i))
    i))

(define-low vm-fault (va err)
  (when (the :u32 (pmap-access-ok (page-down va) err)) (result 1))
  (let ((i (lookup va)))
    (when (or (= i nentries) (logand err 1) (not (ref entry-prot i))) (result 0))
    (when (and (logand err 2) (not (logand (ref entry-prot i) +prot-write+))) (result 0))
    (when (and (logand err #x10) (not (logand (ref entry-prot i) +prot-execute+))) (result 0))
    (when (pmap-find-phys va) (result 0))
    (let ((pa (vm-page-grab)))
      (when (= pa 0) (result 0))
      (rep-stosb (+ pa +physmap-base+) 0 +page-size+)
      (pmap-enter (page-down va) pa (ref entry-prot i))
      1)))

(define-low io-map (pa size wcomb)
  (when (= io-next 0) (setf io-next +io-map-base+))
  (let* ((offset (logand pa (- +page-size+ 1)))
         (base (page-down pa))
         (len (page-up (+ size offset)))
         (va io-next)
         (off 0))
    (incf io-next len)
    (while (< off len)
      (pmap-enter-io (+ va off) (+ base off) wcomb)
      (incf off +page-size+))
    (+ va offset)))

(define-low ml-io-map (pa size) (io-map pa size 0))

(define-low ml-io-map-wcomb (pa size) (io-map pa size 1))
