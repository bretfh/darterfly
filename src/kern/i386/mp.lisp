(in-package #:finch/kern)

(defconstant +max-cpus+ 32)
(defconstant +c-tlb-invalid+ 40)
(defconstant +c-rsp0+ (+ 112 4))
(defconstant +efi-system-table+ 1104)
(defconstant +st-entries+ 104)
(defconstant +st-configuration+ 112)
(defconstant +acpi-guid-low+ #x11D3E4F18868E871)
(defconstant +acpi-guid-high+ #x81883CC7800022BC)

(define-global funnel-owner :u32 :alignment 4)
(define-global funnel-depth-count :u32 :alignment 4)
(define-global cpu-ids :u32 :count 32 :alignment 4)
(define-global cpu-limit :u32 :alignment 4)
(define-global bsp-cr0 :u64)
(define-global bsp-cr3 :u64)
(define-global bsp-cr4 :u64)

(define-low funnel-lock ()
  (let ((me (+ (cpu-number) 1)))
    (when (= funnel-owner me)
      (incf funnel-depth-count)
      (result 0))
    (while (not (compare-and-swap (address funnel-owner) 0 me))
      (process-pmap-updates)
      (pause))
    (setf funnel-depth-count 1)))

(define-low funnel-unlock ()
  (unless (= funnel-owner (+ (cpu-number) 1))
    (panic "funnel_unlock: cpu %d does not hold the funnel" (cpu-number)))
  (decf funnel-depth-count)
  (when (= funnel-depth-count 0) (setf funnel-owner 0)))

(define-low funnel-depth ()
  (if (= funnel-owner (+ (cpu-number) 1)) funnel-depth-count 0))

(define-low process-pmap-updates ()
  (unless (mem :u32 (+ (cpu-data) +c-tlb-invalid+)) (result 0))
  (set-cr 3 (read-cr 3))
  (setf (mem :u32 (+ (cpu-data) +c-tlb-invalid+)) 0))

(define-low pmap-flush-tlbs ()
  (let ((me (cpu-number)) (any 0) (i 0))
    (while (< i |real_ncpus|)
      (when (and (/= i me) (mem :u32 (+ (cpu-datap i) +c-running+)))
        (setf (mem :u32 (+ (cpu-datap i) +c-tlb-invalid+)) 1)
        (setf any 1))
      (incf i))
    (unless any (result 0))
    (setf i 0)
    (while (< i |real_ncpus|)
      (when (mem :u32 (+ (cpu-datap i) +c-tlb-invalid+)) (i386-signal-cpu i))
      (incf i))
    (setf i 0)
    (while (< i |real_ncpus|)
      (while (mem :u32 (+ (cpu-datap i) +c-tlb-invalid+)) (pause))
      (incf i))))

(define-low cause-ast-check (th)
  (let ((i 0))
    (while (< i |real_ncpus|)
      (when (and (/= i (cpu-number)) (= (mem :u64 (+ (cpu-datap i) +c-active-thread+)) th))
        (i386-signal-cpu i)
        (result 0))
      (incf i))))

(define-low acpi-find ((signature :u32))
  (let* ((st (+ (mem :u32 (+ |platform_boot_args| +efi-system-table+)) +physmap-base+))
         (ct (+ (mem :u64 (+ st +st-configuration+)) +physmap-base+))
         (n (mem :u64 (+ st +st-entries+)))
         (rsdp 0)
         (i 0))
    (while (< i n)
      (let ((entry (+ ct (* i 24))))
        (when (and (= (mem :u64 entry) +acpi-guid-low+) (= (mem :u64 (+ entry 8)) +acpi-guid-high+))
          (setf rsdp (+ (mem :u64 (+ entry 16)) +physmap-base+))))
      (incf i))
    (unless rsdp (result 0))
    (let* ((xsdt (+ (mem :u64 (+ rsdp 24)) +physmap-base+))
           (count (truncate (- (mem :u32 (+ xsdt 4)) 36) 8))
           (j 0))
      (while (< j count)
        (let ((h (+ (mem :u64 (+ xsdt 36 (* j 8))) +physmap-base+)))
          (when (= (mem :u32 h) signature) (result h)))
        (incf j))
      0)))

(define-low madt-cpus ()
  (let ((madt (acpi-find #x43495041))
        (n 0))
    (unless madt (result 0))
    (let ((p (+ madt 44))
          (end (+ madt (mem :u32 (+ madt 4)))))
      (while (and (< p end) (mem :u8 (+ p 1)))
        (when (and (= (mem :u8 p) 0) (logand (mem :u32 (+ p 4)) 1) (< n +max-cpus+))
          (setf (ref cpu-ids n) (mem :u8 (+ p 3)))
          (incf n))
        (incf p (mem :u8 (+ p 1)))))
    n))

(define-low slave-boot-page ()
  (let* ((args |platform_boot_args|)
         (size (mem :u32 (+ args +descriptor-size+)))
         (n (truncate (mem :u32 (+ args +memory-map-size+)) size))
         (i 0))
    (while (< i n)
      (let ((r (+ (mem :u32 (+ args +memory-map+)) (* i size) +physmap-base+)))
        (when (= (mem :u32 r) 7)
          (let* ((physical (mem :u64 (+ r 8)))
                 (start (if (< physical #x1000) #x1000 physical))
                 (end (+ physical (* (mem :u64 (+ r 24)) +page-size+))))
            (when (> end #x9F000) (setf end #x9F000))
            (when (<= (+ start (* 4 +page-size+)) end) (result start)))))
      (incf i))
    0))

(define-low delay-us (us)
  (let ((end (+ (rdtsc) (* us (truncate (ref commpage 0) 1000000)))))
    (while (< (rdtsc) end) (pause))))

(define-low i386-init-slave (cdp)
  (set-cr 3 bsp-cr3)
  (set-cr 4 bsp-cr4)
  (set-cr 0 bsp-cr0)
  (fninit)
  (mp-desc-init cdp)
  (setf (mem :u64 (+ cdp +c-active-thread+)) (mem :u64 (+ cdp +c-idle-thread+)))
  (set-kernel-stack (mem :u64 (+ (mem :u64 (+ cdp +c-idle-thread+)) +t-kstack-top+)))
  (pat-init)
  (lapic-init-slave)
  (setf (mem :u32 (+ cdp +c-running+)) 1)
  (funnel-lock)
  (idle-thread))

(define-low start-cpu ((cpu :u32) page)
  (let ((cdp (cpu-datap cpu))
        (code (+ page +physmap-base+))
        (i 0))
    (setf (mem :u32 (+ code +slave-cr3+)) (+ page +page-size+))
    (setf (mem :u64 (+ code +slave-rsp+)) (mem :u64 (+ (mem :u64 (+ cdp +c-idle-thread+)) +t-kstack-top+)))
    (setf (mem :u64 (+ code +slave-cpu+)) cdp)
    (setf (mem :u64 (+ code +slave-entry+)) (code-address i386-init-slave))
    (lapic-send-ipi (mem :u32 (+ cdp +cpu-phys-number+)) #x4500)
    (delay-us 10000)
    (while (and (< i 2) (not (mem :u32 (+ cdp +c-running+))))
      (lapic-send-ipi (mem :u32 (+ cdp +cpu-phys-number+)) (logior #x4600 (shr page 12)))
      (delay-us 200)
      (incf i))
    (setf i 0)
    (while (and (< i 1000) (not (mem :u32 (+ cdp +c-running+))))
      (delay-us 100)
      (incf i))
    (mem :u32 (+ cdp +c-running+))))

(define-low i386-start-cpus ()
  (let* ((bsp (cpu-datap 0))
         (n 0)
         (page 0)
         (started 1)
         (i 0))
    (setf (mem :u32 (+ bsp +cpu-phys-number+)) (lapic-id))
    (setf (mem :u32 (+ bsp +c-running+)) 1)
    (setf n (madt-cpus))
    (setf page (slave-boot-page))
    (when (and (the :u32 (|platform_parse_boot_argn| "cpus" (address cpu-limit))) (> cpu-limit 0) (< cpu-limit n))
      (setf n cpu-limit))
    (when (<= n 1)
      (kprintf "mp: 1 cpu
")
      (result 0))
    (unless page (panic "mp: no page below 1 MB for the slave boot code"))
    (setf bsp-cr0 (read-cr 0))
    (setf bsp-cr3 (read-cr 3))
    (setf bsp-cr4 (read-cr 4))
    (let ((code (+ page +physmap-base+))
          (k 0))
      (while (< k +slave-size+)
        (setf (mem :u8 (+ code k)) (mem :u8 (+ (code-address slave-boot-base) k)))
        (incf k)))
    (let ((pml4 (+ page +page-size+ +physmap-base+))
          (pdpt (+ page (* 2 +page-size+) +physmap-base+))
          (pd (+ page (* 3 +page-size+) +physmap-base+))
          (kernel-pml4 (+ (logand bsp-cr3 (lognot #xFFF)) +physmap-base+))
          (k 0))
      (while (< k 512)
        (setf (mem :u64 (+ pml4 (* 8 k))) (mem :u64 (+ kernel-pml4 (* 8 k))))
        (setf (mem :u64 (+ pdpt (* 8 k))) 0)
        (setf (mem :u64 (+ pd (* 8 k))) 0)
        (incf k))
      (setf (mem :u64 pml4) (logior (+ page (* 2 +page-size+)) 3))
      (setf (mem :u64 pdpt) (logior (+ page (* 3 +page-size+)) 3))
      (setf (mem :u64 pd) #x83))
    (while (< i n)
      (unless (= (ref cpu-ids i) (mem :u32 (+ bsp +cpu-phys-number+)))
        (let ((cdp (cpu-datap started)))
          (setf (mem :u32 (+ cdp +cpu-number+)) started)
          (setf (mem :u32 (+ cdp +cpu-phys-number+)) (ref cpu-ids i))
          (setf (mem :u64 (+ cdp +c-idle-thread+)) (idle-thread-create))
          (setf (mem :u64 (+ cdp +c-rsp0+)) (mem :u64 (+ (mem :u64 (+ cdp +c-idle-thread+)) +t-kstack-top+)))
          (setf |real_ncpus| (+ started 1))
          (if (the :u32 (start-cpu started page))
              (incf started)
              (progn
                (kprintf "mp: cpu with apic id %u did not start
" (ref cpu-ids i))
                (setf |real_ncpus| started)))))
      (incf i))
    (kprintf "mp: %d cpus, slave boot code at 0x%lx
" |real_ncpus| page)))
