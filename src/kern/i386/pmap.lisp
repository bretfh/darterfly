(in-package #:darterfly/kern)

(defconstant +pte-valid+ 1)
(defconstant +pte-write+ 2)
(defconstant +pte-user+ 4)
(defconstant +pte-wthru+ 8)
(defconstant +pte-ncache+ #x10)
(defconstant +pte-ps+ #x80)
(defconstant +pte-pat+ #x80)
(defconstant +pte-frame+ #x200)
(defconstant +pte-nx+ (ash 1 63))
(defconstant +pte-pfn+ #x000FFFFFFFFFF000)
(defconstant +kernel-base+ #xFFFFFFFF80000000)
(defconstant +efer+ #xC0000080)

(define-global idle-pml4 :u64 :count 512 :alignment 4096)
(define-global idle-phys-pdpt :u64 :count 512 :alignment 4096)
(define-global idle-phys-pd :u64 :count (* 64 512) :alignment 4096)
(define-global bootstrap-tables :u64 :count (* 16 512) :alignment 4096)
(define-global bootstrap-used :u64)
(define-global physmap-ready :u64)
(define-global kernel-phys :u64 :export t)
(define-global freed :u64 :count 64)
(define-global |platform_boot_args| :u64 :extern t)

(define-low kvtophys (va) (+ (- va +kernel-base+) kernel-phys))

(define-low ptov (pa) (if physmap-ready (+ pa +physmap-base+) pa))

(define-low table-page ()
  (let ((pa 0))
    (if (not physmap-ready)
        (progn
          (when (= bootstrap-used 16) (panic "pmap: out of bootstrap tables"))
          (setf pa (kvtophys (+ (address bootstrap-tables) (* bootstrap-used +page-size+))))
          (incf bootstrap-used))
        (progn
          (setf pa (vm-page-grab))
          (when (= pa 0) (panic "pmap: out of pages"))))
    (rep-stosb (ptov pa) 0 +page-size+)
    pa))

(define-low pte (va create)
  (pte-in (if physmap-ready (logand (read-cr 3) +pte-pfn+) (kvtophys (address idle-pml4))) va create))

(define-low pte-in (root va create)
  (let ((table (ptov root))
        (shift 39))
    (while (> shift 12)
      (let ((e (+ table (* 8 (logand (shr va shift) 511)))))
        (unless (logand (mem :u64 e) +pte-valid+)
          (unless create (result 0))
          (setf (mem :u64 e) (logior (table-page) +pte-valid+ +pte-write+ +pte-user+)))
        (when (logand (mem :u64 e) +pte-ps+)
          (panic "pmap: 0x%lx is inside a large page" va))
        (setf table (ptov (logand (mem :u64 e) +pte-pfn+))))
      (decf shift 9))
    (+ table (* 8 (logand (shr va 12) 511)))))

(define-low prot-bits (prot)
  (if (not prot)
      0
      (logior +pte-valid+ +pte-user+
              (if (logand prot +prot-write+) +pte-write+ 0)
              (if (logand prot +prot-execute+) 0 +pte-nx+))))

(define-low pmap-enter (va pa (prot :u32))
  (let* ((e (pte va 1))
         (old (mem :u64 e)))
    (setf (mem :u64 e) (logior (logand pa +pte-pfn+) (prot-bits prot) +pte-frame+))
    (invlpg va)
    (when (logand old +pte-valid+) (pmap-flush-tlbs))))

(define-low pmap-protect (va len (prot :u32))
  (let ((changed 0)
        (a (page-down va)))
    (while (< a (+ va len))
      (let ((e (pte a 0)))
        (when (and e (logand (mem :u64 e) +pte-frame+))
          (setf (mem :u64 e) (logior (logand (mem :u64 e) +pte-pfn+) (prot-bits prot) +pte-frame+))
          (invlpg a)
          (setf changed 1)))
      (incf a +page-size+))
    (when changed (pmap-flush-tlbs))))

(define-low pmap-remove (va len)
  (let ((n 0)
        (a (page-down va)))
    (while (< a (+ va len))
      (let ((e (pte a 0)))
        (when (and e (logand (mem :u64 e) +pte-frame+))
          (setf (ref freed n) (logand (mem :u64 e) +pte-pfn+))
          (incf n)
          (setf (mem :u64 e) 0)
          (invlpg a)
          (when (= n 64)
            (pmap-flush-tlbs)
            (while n
              (decf n)
              (vm-page-free (ref freed n))))))
      (incf a +page-size+))
    (when n (pmap-flush-tlbs))
    (while n
      (decf n)
      (vm-page-free (ref freed n)))))

(define-low pmap-enter-io (va pa (wcomb :u32))
  (setf (mem :u64 (pte va 1))
        (logior (logand pa +pte-pfn+) +pte-valid+ +pte-write+ +pte-user+ +pte-nx+
                (if wcomb (logior +pte-pat+ +pte-ncache+) (logior +pte-ncache+ +pte-wthru+))))
  (invlpg va))

(define-low pmap-access-ok (va err)
  (let ((e (pte va 0)))
    (when (or (not e) (not (logand (mem :u64 e) +pte-valid+))) (result 0))
    (when (and (logand err 2) (not (logand (mem :u64 e) +pte-write+))) (result 0))
    (when (and (logand err #x10) (logand (mem :u64 e) +pte-nx+)) (result 0))
    (invlpg va)
    1))

(define-low pmap-find-phys (va)
  (let ((e (pte va 0)))
    (if (and e (logand (mem :u64 e) +pte-frame+))
        (logior (logand (mem :u64 e) +pte-pfn+) (logand va (- +page-size+ 1)))
        0)))

(defconstant +kaddr+ 1080)
(defconstant +region-count+ 1344)
(defconstant +regions+ 1352)

(define-low pmap-bootstrap (args)
  (let ((gigs 64)
        (kaddr (mem :u32 (+ args +kaddr+))))
    (setf kernel-phys kaddr)
    (if (logand (shr (cpuid-edx #x80000001) 26) 1)
        (let ((i 0))
          (setf gigs 512)
          (while (< i 512)
            (setf (ref idle-phys-pdpt i)
                  (logior (shl i 30) +pte-valid+ +pte-write+ +pte-user+ +pte-ps+ +pte-nx+))
            (incf i)))
        (let ((g 0))
          (while (< g 64)
            (let ((i 0))
              (while (< i 512)
                (setf (ref idle-phys-pd (+ (* g 512) i))
                      (logior (shl g 30) (shl i 21) +pte-valid+ +pte-write+ +pte-user+ +pte-ps+ +pte-nx+))
                (incf i)))
            (setf (ref idle-phys-pdpt g)
                  (logior (kvtophys (+ (address idle-phys-pd) (* g 4096))) +pte-valid+ +pte-write+ +pte-user+))
            (incf g))))
    (wrmsr +efer+ (logior (rdmsr +efer+) (ash 1 11)))
    (setf (ref idle-pml4 256) (logior (kvtophys (address idle-phys-pdpt)) +pte-valid+ +pte-write+ +pte-user+))
    (let ((r 0))
      (while (< r (mem :u32 (+ args +region-count+)))
        (let* ((region (+ args +regions+ (* 24 r)))
               (off 0))
          (while (< off (mem :u64 (+ region 16)))
            (pmap-enter (+ (mem :u64 region) off) (+ (mem :u64 (+ region 8)) off) 7)
            (incf off +page-size+)))
        (incf r)))
    (set-cr3 (kvtophys (address idle-pml4)))
    (setf physmap-ready 1)
    (let ((i 257))
      (while (< i 512)
        (unless (logand (ref idle-pml4 i) +pte-valid+)
          (setf (ref idle-pml4 i) (logior (table-page) +pte-valid+ +pte-write+ +pte-user+)))
        (incf i)))
    (setf |platform_boot_args| (+ args +physmap-base+))
    (kprintf "pmap: physmap %d GB at 0x%lx with %s pages, kernel at 0x%lx from 0x%x
" gigs +physmap-base+ (if (= gigs 512) "1 GB" "2 MB") +kernel-base+ kaddr)))

(define-low pmap-create ()
  (let ((pa (vm-page-grab))
        (i 256))
    (when (= pa 0) (result 0))
    (rep-stosb (ptov pa) 0 +page-size+)
    (while (< i 512)
      (setf (mem :u64 (+ (ptov pa) (* 8 i))) (logand (ref idle-pml4 i) (lognot +pte-user+)))
      (incf i))
    (setf (mem :u64 (pte-in pa +commpage-va+ 1)) (logior (kvtophys (address commpage)) (prot-bits 1)))
    pa))
