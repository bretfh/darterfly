(in-package #:darterfly/kern)

;; Static ELF64 bring-up ABI. Only the system world may create/reap children.
;; Status records outlive page tables, and are bounded until explicitly waited.
(defconstant +native-slots+ 128)
(define-global native-ids :u64 :count 128)
(define-global native-status :u64 :count 128)

(define-low native-slot (id)
  (let ((i 0))
    (while (< i +native-slots+)
      (when (= (ref native-ids i) id) (result (+ i 1)))
      (incf i))
    0))

(define-low native-note-exit (w status)
  (unless (mem :u64 (+ w +w-id+)) (result 0))
  (let ((slot (native-slot (mem :u64 (+ w +w-id+)))))
    (when (and slot (not (ref native-status (- slot 1))))
      (setf (ref native-status (- slot 1)) (+ status 1)))))

(define-low native-exit (w status)
  (native-note-exit w status)
  (world-stop w))

(define-low native-wait (id)
  (let ((slot (if id (native-slot id) 0)))
    (unless slot (result (- 0 10))) ; ECHILD, including double wait
    (reap-threads)
    (when (world-by-id id) (result (- 0 +eagain+)))
    (let ((status (ref native-status (- slot 1))))
      (setf (ref native-status (- slot 1)) 0)
      (setf (ref native-ids (- slot 1)) 0)
      (- status 1))))

(define-low native-tls-ok (file size h)
  (let ((off (mem :u64 (+ h 8))) (va (mem :u64 (+ h 16)))
        (fs (mem :u64 (+ h 32))) (ms (mem :u64 (+ h 40)))
        (align (mem :u64 (+ h 48))) (i 0)
        (ph (+ file (mem :u64 (+ file 32)))) (n (mem :u16 (+ file 56))))
    (when (or (> off size) (> fs (- size off)) (> fs ms)
              (> ms (ash 128 20)) (> align (ash 1 20))
              (and (> align 1)
                   (or (logand align (- align 1))
                       (/= (logand va (- align 1)) (logand off (- align 1))))))
      (result 0))
    (while (< i n)
      (let* ((p (+ ph (* i 56))) (base (mem :u64 (+ p 16)))
             (delta (- va base)))
        (when (and (= (mem :u32 p) 1) (>= va base)
                   (<= delta (mem :u64 (+ p 40)))
                   (<= ms (- (mem :u64 (+ p 40)) delta))
                   (<= delta (mem :u64 (+ p 32)))
                   (<= fs (- (mem :u64 (+ p 32)) delta))
                   (= off (+ (mem :u64 (+ p 8)) delta)))
          (result 1)))
      (incf i))
    0))

;; Validate everything before allocating a world. Deliberately reject dynamic
;; images, executable stacks, page-sharing segments and W+X mappings.
(define-low native-elf-ok (file (size :u64))
  (when (< size 64) (result 0))
  (unless (and (= (mem :u32 file) #x464C457F)
               (= (mem :u8 (+ file 4)) 2)
               (= (mem :u8 (+ file 5)) 1)
               (= (mem :u8 (+ file 6)) 1)
               (= (mem :u16 (+ file 16)) 2)
               (= (mem :u16 (+ file 18)) 62)
               (= (mem :u32 (+ file 20)) 1)
               (= (mem :u16 (+ file 52)) 64)
               (= (mem :u16 (+ file 54)) 56)) (result 0))
  (let ((ph (mem :u64 (+ file 32)))
        (n (mem :u16 (+ file 56)))
        (entry (mem :u64 (+ file 24)))
        (last 4096) (total 0) (executable 0) (tls 0) (i 0))
    (when (or (= n 0) (> n 32) (> ph size)
              (> (* n 56) (- size ph))) (result 0))
    (while (< i n)
      (let* ((h (+ file ph (* i 56)))
             (kind (mem :u32 h)) (flags (mem :u32 (+ h 4))))
        (when (or (= kind 2) (= kind 3)
                  (and (= kind #x6474E551) (logand flags 1)))
          (result 0))
        (when (= kind 7)
          (when (or tls (not (the :u32 (native-tls-ok file size h)))) (result 0))
          (setf tls 1))
        (when (= kind 1)
          (let ((off (mem :u64 (+ h 8)))
                (va (mem :u64 (+ h 16)))
                (fs (mem :u64 (+ h 32)))
                (ms (mem :u64 (+ h 40)))
                (align (mem :u64 (+ h 48))))
            (when (or (> off size) (> fs (- size off)) (> fs ms)
                      (= ms 0) (> ms (ash 128 20))
                      (< (page-down va) last) (>= va +user-mmap-base+)
                      (> ms (- +user-mmap-base+ va))
                      (not (logand flags 4)) (> flags 7)
                      (= (logand flags 3) 3)
                      (and (> align 1)
                           (or (logand align (- align 1))
                               (/= (logand va (- align 1))
                                   (logand off (- align 1))))))
              (result 0))
            (setf last (page-up (+ va ms)))
            (incf total (- last (page-down va)))
            (when (> total (ash 128 20)) (result 0))
            (when (and (logand flags 1) (>= entry va) (< entry (+ va fs)))
              (setf executable 1)))))
      (incf i))
    executable))

;; Copy through physical mappings; child permissions are never relaxed.
(define-low native-copy (w at source (size :u64))
  (let ((done 0))
    (while (< done size)
      (let* ((va (+ at done))
             (offset (logand va 4095))
             (n (- 4096 offset))
             (pa (world-page w va 0)))
        (unless pa (result 0))
        (when (> n (- size done)) (setf n (- size done)))
        (rep-movsb (+ (ptov pa) offset) (+ source done) n)
        (incf done n)))
    1))

(define-low native-validate (file (size :u64))
  (when (> size (ash 128 20)) (result (- 0 +einval+)))
  (unless (the :u32 (user-ok file size 0)) (result (- 0 +efault+)))
  (if (the :u32 (native-elf-ok file size)) 0 (- 0 8)))

(define-low native-spawn (file (size :u64) stack (stack-size :u64) name)
  (when (or (> size (ash 128 20)) (< stack-size 16)
            (> stack-size 65536) (logand stack-size 15))
    (result (- 0 +einval+)))
  (unless (and (the :u32 (user-ok file size 0))
               (the :u32 (user-ok stack stack-size 0)))
    (result (- 0 +efault+)))
  (unless (the :u32 (native-elf-ok file size)) (result (- 0 8)))
  (let ((slot (native-slot 0))
        (port (if name (name-port (current-world) name 1) 0)))
    (when (and name (not port)) (result (- 0 +ebadf+)))
    (unless slot (result (- 0 +eagain+)))
    (let ((w (world-create)) (i 0)
          (ph (+ file (mem :u64 (+ file 32))))
          (n (mem :u16 (+ file 56))))
      (unless w (result (- 0 +enomem+)))
      (while (< i n)
        (let ((h (+ ph (* i 56))))
          (when (= (mem :u32 h) 1)
            (let* ((va (mem :u64 (+ h 16)))
                   (flags (mem :u32 (+ h 4)))
                   (prot (logior 1 (logand flags 2)
                                  (if (logand flags 1) 4 0))))
              (insert-at w (count-of w) (page-down va)
                         (page-up (+ va (mem :u64 (+ h 40)))) prot)
              (unless (the :u32 (native-copy w va
                                            (+ file (mem :u64 (+ h 8)))
                                            (mem :u64 (+ h 32))))
                (world-destroy w)
                (result (- 0 +enomem+))))))
        (incf i))
      (insert-at w (count-of w) (- +world-stack-top+ +world-stack-size+)
                 +world-stack-top+ 3)
      (unless (the :u32 (native-copy w (- +world-stack-top+ stack-size)
                                    stack stack-size))
        (world-destroy w)
        (result (- 0 +enomem+)))
      (when port (name-add w port 0))
      (setf (ref native-status (- slot 1)) 0)
      (setf (ref native-ids (- slot 1)) (mem :u64 (+ w +w-id+)))
      (thread-create-user-in w (mem :u64 (+ file 24))
                             (- +world-stack-top+ stack-size) 0 0)
      (mem :u64 (+ w +w-id+)))))
