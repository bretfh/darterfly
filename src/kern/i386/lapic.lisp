(in-package #:finch/kern)

(defconstant +lapic-start+ #xFEE00000)
(defconstant +ioapic-start+ #xFEC00000)
(defconstant +lapic-id+ #x20)
(defconstant +lapic-eoi+ #xB0)
(defconstant +lapic-icr+ #x300)
(defconstant +lapic-icrd+ #x310)
(defconstant +lapic-icr-ds-pending+ (ash 1 12))
(defconstant +lapic-svr+ #xF0)
(defconstant +lapic-timer+ #x320)
(defconstant +lapic-timer-initial-count+ #x380)
(defconstant +lapic-timer-current-count+ #x390)
(defconstant +lapic-timer-divide-config+ #x3E0)
(defconstant +lapic-lint0+ #x350)
(defconstant +lapic-timer-periodic+ (ash 1 17))
(defconstant +lapic-spurious-vector+ #xDA)
(defconstant +lapic-timer-vector+ #xDD)
(defconstant +lapic-interprocessor-interrupt+ #xDE)
(defconstant +com1-vector+ #x24)
(defconstant +keyboard-vector+ #x25)
(defconstant +hz+ 100)
(defconstant +apic-base-msr+ #x1B)
(defconstant +cpu-number+ 24)
(defconstant +cpu-phys-number+ 28)

(define-global ticks :u64 :export t)
(define-global per-tick :u32)
(define-global |cpu_data_master| :u64 :extern t)

(define-low lapic (reg) (+ +physmap-base+ +lapic-start+ reg))

(define-low ioapic-write ((reg :u32) (value :u32))
  (setf (mem :u32 (+ +physmap-base+ +ioapic-start+)) reg)
  (setf (mem :u32 (+ +physmap-base+ +ioapic-start+ #x10)) value))

(define-low pic-disable ()
  (outb #x20 #x11) (outb #xA0 #x11)
  (outb #x21 #x20) (outb #xA1 #x28)
  (outb #x21 #x04) (outb #xA1 #x02)
  (outb #x21 #x01) (outb #xA1 #x01)
  (outb #x21 #xFF) (outb #xA1 #xFF))

(define-low lapic-calibrate ()
  (setf (mem :u32 (lapic +lapic-timer-divide-config+)) 3)
  (setf (mem :u32 (lapic +lapic-timer+)) (ash 1 16))
  (setf (mem :u32 (lapic +lapic-timer-initial-count+)) #xFFFFFFFF)
  (let ((start (mem :u32 (lapic +lapic-timer-current-count+)))
        (t0 (rdtsc))
        (span (truncate (ref commpage 0) +hz+)))
    (while (< (- (rdtsc) t0) span) (pause))
    (logand (- start (mem :u32 (lapic +lapic-timer-current-count+))) #xFFFFFFFF)))

(define-low lapic-id ()
  (shr (mem :u32 (lapic +lapic-id+)) 24))

(define-low lapic-send-ipi ((apic-id :u32) (icr :u32))
  (while (logand (mem :u32 (lapic +lapic-icr+)) +lapic-icr-ds-pending+) (pause))
  (setf (mem :u32 (lapic +lapic-icrd+)) (shl apic-id 24))
  (setf (mem :u32 (lapic +lapic-icr+)) icr)
  (while (logand (mem :u32 (lapic +lapic-icr+)) +lapic-icr-ds-pending+) (pause)))

(define-low enable-lapic ()
  (when (logand (rdmsr +apic-base-msr+) (ash 1 10))
    (wrmsr +apic-base-msr+ (logand (rdmsr +apic-base-msr+) (lognot (logior (ash 1 10) (ash 1 11))))))
  (wrmsr +apic-base-msr+ (logior (rdmsr +apic-base-msr+) (ash 1 11)))
  (setf (mem :u32 (lapic +lapic-lint0+)) (ash 1 16))
  (setf (mem :u32 (lapic +lapic-svr+)) (logior #x100 +lapic-spurious-vector+)))

(define-low start-timer ()
  (setf (mem :u32 (lapic +lapic-timer-divide-config+)) 3)
  (setf (mem :u32 (lapic +lapic-timer+)) (logior +lapic-timer-vector+ +lapic-timer-periodic+))
  (setf (mem :u32 (lapic +lapic-timer-initial-count+)) per-tick))

(define-low lapic-init-slave ()
  (enable-lapic)
  (start-timer))

(define-low lapic-init ()
  (pic-disable)
  (enable-lapic)
  (setf per-tick (lapic-calibrate))
  (start-timer)
  (ioapic-write (+ #x10 (* 2 4)) +com1-vector+)
  (ioapic-write (+ #x10 (* 2 4) 1) (shl (lapic-id) 24))
  (keyboard-init)
  (ioapic-write (+ #x10 (* 2 1)) +keyboard-vector+)
  (ioapic-write (+ #x10 (* 2 1) 1) (shl (lapic-id) 24))
  (serial-enable-interrupts)
  (kprintf "lapic: timer %u counts per tick at %d Hz, com1 on vector 0x%x
" per-tick +hz+ +com1-vector+))

(define-global level-gsi :u32 :count 16)
(define-global level-low :u32 :count 16)

(define-low route-interrupt ((gsi :u32) (low :u32))
  (let ((v (logand low #xFF)))
    (when (and (>= v #x30) (< v #x40) (logand low (ash 1 15)))
      (setf (ref level-gsi (- v #x30)) (+ gsi 1))
      (setf (ref level-low (- v #x30)) low))
    (ioapic-write (+ #x10 (* 2 gsi) 1) (shl (mem :u32 (+ (address |cpu_data_master|) +cpu-phys-number+)) 24))
    (ioapic-write (+ #x10 (* 2 gsi)) low)))

(define-low lapic-interrupt (vector)
  (cond ((= vector +lapic-timer-vector+)
         (when (= (cpu-number) 0)
           (incf ticks)
           (bsd-hardclock))
         (sched-tick))
        ((= vector +com1-vector+)
         (serial-interrupt)
         (bsd-serial-wakeup))
        ((= vector +keyboard-vector+)
         (keyboard-interrupt)
         (bsd-serial-wakeup))
        ((and (>= vector #x30) (< vector #x40))
         (let ((gsi (ref level-gsi (- vector #x30))))
           (when gsi
             (ioapic-write (+ #x10 (* 2 (- gsi 1))) (logior (ref level-low (- vector #x30)) (ash 1 16)))))
         (|platform_incoming_interrupt| vector)))
  (unless (or (= vector +lapic-spurious-vector+)
              (and (>= vector #x20) (< vector #x30) (/= vector +com1-vector+) (/= vector +keyboard-vector+)))
    (setf (mem :u32 (lapic +lapic-eoi+)) 0)))

(defconstant +cpu-data-size+ 8416)

(define-low cpu-number () (mem :u32 (+ (cpu-data) +cpu-number+)))

(define-low i386-signal-cpu ((cpu :u32))
  (lapic-send-ipi (mem :u32 (+ (address |cpu_data_master|) (* cpu +cpu-data-size+) +cpu-phys-number+))
                  +lapic-interprocessor-interrupt+))
