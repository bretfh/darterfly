(in-package #:darterfly/kern)

(define-global sleep-request :u32 :export t)
(define-global sleep-parked :u32)
(define-global sleep-done :u32)
(define-global sleep-context :u64 :count 8)
(define-global sleep-tsc :u64)
(define-global tsc-delta :u64)
(define-global sleep-control :u64)
(define-global sleep-event :u64)
(define-global sleep-type :u32)
(define-global sleep-facs :u64)
(define-global sleep-count :u64 :export t)
(define-global boot-page :u64)
(define-global parked-cpus :u32 :count 64)
(define-global resume-stack :u8 :count 16384 :alignment 16)

(define-low ap-park ()
  (when (and sleep-request (/= (cpu-number) 0))
    (cli)
    (setf (ref parked-cpus (cpu-number)) 1)
    (fetch-add (address sleep-parked) 1)
    (wbinvd)
    (while 1 (cli) (hlt))))

(define-low tsc-adjust-p () (logand (the :u32 (cpuid 7 :ebx)) 2))

(define-low apply-tsc-delta ()
  (when tsc-delta
    (if (tsc-adjust-p)
        (wrmsr #x3B (+ (rdmsr #x3B) tsc-delta))
        (wrmsr #x10 (+ (rdtsc) tsc-delta)))))

(define-low enter-s3 ()
  (let ((code (+ boot-page +physmap-base+))
        (facs (+ sleep-facs +physmap-base+)))
    (setf (mem :u64 (+ code +slave-rsp+)) (+ (address resume-stack) 16384))
    (setf (mem :u64 (+ code +slave-cpu+)) (cpu-datap 0))
    (setf (mem :u64 (+ code +slave-entry+)) (code-address sleep-resume))
    (setf (mem :u32 (+ code +slave-cr3+)) (+ boot-page +page-size+))
    (setf (mem :u32 (+ facs 12)) boot-page)
    (setf (mem :u64 (+ facs 24)) 0)
    (setf sleep-tsc (rdtsc))
    (wbinvd)
    (outw sleep-event #xC731)
    (let ((v (logand (inw sleep-control) (lognot (shl 7 10)))))
      (setf v (logior v (shl sleep-type 10)))
      (outw sleep-control v)
      (outw sleep-control (logior v (shl 1 13))))
    (while 1 (hlt))))

(define-low sleep-resume (cdp)
  (set-cr 3 bsp-cr3)
  (set-cr 4 bsp-cr4)
  (set-cr 0 bsp-cr0)
  (fninit)
  (mp-desc-init cdp)
  (let ((now (rdtsc)))
    (setf tsc-delta (if (< now sleep-tsc) (- sleep-tsc now) 0)))
  (apply-tsc-delta)
  (pat-init)
  (power-init)
  (enable-lapic)
  (serial-init)
  (start-timer)
  (platform-routes)
  (replay-routes)
  (sleep-restore (address sleep-context)))

(define-low sleep-now ()
  (let ((others (- |real_ncpus| 1)) (t0 (rdtsc)) (i 1))
    (funnel-unlock)
    (while (< i |real_ncpus|) (i386-signal-cpu i) (incf i))
    (while (and (< sleep-parked others) (< (- (rdtsc) t0) (ref commpage 0))) (pause))
    (funnel-lock)
    (if (and (= sleep-parked others) boot-page sleep-facs)
        (when (= (sleep-save (address sleep-context)) 0)
          (enter-s3))
        (kprintf "sleep: %u of %u cpus parked, page 0x%lx, facs 0x%lx; not sleeping
" sleep-parked others boot-page sleep-facs))
    (setf (ref commpage 2) (- (rtc-epoch) (truncate (- (rdtsc) (ref commpage 1)) (ref commpage 0))))
    (setf i 1)
    (while (< i |real_ncpus|)
      (when (ref parked-cpus i)
        (setf (ref parked-cpus i) 0)
        (setf (mem :u32 (+ (cpu-datap i) +c-running+)) 0)
        (start-cpu i boot-page))
      (incf i))
    (incf sleep-count)
    (setf sleep-request 0)
    (setf sleep-done 1)
    (thread-wakeup (address sleep-done) 1)))

(define-low request-sleep (control event (type :u32) facs)
  (setf sleep-control control)
  (setf sleep-event event)
  (setf sleep-type type)
  (setf sleep-facs facs)
  (setf sleep-parked 0)
  (setf sleep-done 0)
  (setf sleep-request 1)
  (unless (= (cpu-number) 0) (i386-signal-cpu 0))
  (while (= sleep-done 0)
    (thread-wait (address sleep-done) 0))
  sleep-count)
