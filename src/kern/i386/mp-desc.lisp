(in-package #:darterfly/kern)

(defconstant +kernel-stack-bytes+ 65536)
(defconstant +c-gdt+ 48)
(defconstant +c-ktss+ 112)
(defconstant +c-df-stack+ 224)
(defconstant +df-stack-size+ 8192)
(defconstant +tss-size+ 104)
(defconstant +kernel-tss+ #x18)

(define-global |cpu_data_master| :u8 :count (* 32 8416) :alignment 64 :export t)
(define-global |real_ncpus| :u32 :alignment 4 :export t)
(define-global kernel-stack :u8 :count 65536 :alignment 16)
(define-global master-idt64 :u8 :count (* 256 16) :alignment 16)
(define-global idt-ready :u64)
(define-global descriptor :u8 :count 16 :alignment 16)

(define-low cpu-data-set-gs (cdp)
  (setf (mem :u64 cdp) cdp)
  (wrmsr #xC0000101 cdp))

(define-low set-kernel-stack (top)
  (setf (mem :u64 (+ (cpu-data) +c-rsp0+)) top))

(define-low boot-kernel-stack-top ()
  (+ (address kernel-stack) +kernel-stack-bytes+))

(define-low gate ((vector :u32) at (access :u8) (ist :u8))
  (let ((g (+ (address master-idt64) (* vector 16))))
    (setf (mem :u16 g) (logand at #xFFFF))
    (setf (mem :u16 (+ g 2)) 8)
    (setf (mem :u8 (+ g 4)) ist)
    (setf (mem :u8 (+ g 5)) access)
    (setf (mem :u16 (+ g 6)) (logand (shr at 16) #xFFFF))
    (setf (mem :u32 (+ g 8)) (shr at 32))
    (setf (mem :u32 (+ g 12)) 0)))

(defmacro define-idt-init ()
  `(define-low idt-init ()
     ,@(loop :for v :in +trap-vectors+
             :collect `(gate ,v (code-address ,(trap-name v))
                             ,(if (or (= v 3) (= v 4) (member v '(#x80 #x81 #x82))) #xEE #x8E)
                             ,(if (= v 8) 1 0)))
     (setf idt-ready 1)))

(define-idt-init)

(define-low mp-desc-init (cdp)
  (let* ((gdt (+ cdp +c-gdt+))
         (ktss (+ cdp +c-ktss+))
         (limit (- +tss-size+ 1)))
    (setf (mem :u64 gdt) 0)
    (setf (mem :u64 (+ gdt 8)) #x00209A0000000000)
    (setf (mem :u64 (+ gdt 16)) #x0000920000000000)
    (setf (mem :u64 (+ gdt 24))
          (logior (logand limit #xFFFF) (shl (logand ktss #xFFFFFF) 16) (shl #x89 40)
                  (shl (logand (shr ktss 24) #xFF) 56)))
    (setf (mem :u64 (+ gdt 32)) (shr ktss 32))
    (setf (mem :u64 (+ gdt 40)) #x0000F20000000000)
    (setf (mem :u64 (+ gdt 48)) #x0020FA0000000000)
    (unless (mem :u64 (+ ktss 4))
      (setf (mem :u64 (+ ktss 4)) (boot-kernel-stack-top)))
    (setf (mem :u64 (+ ktss 36)) (+ cdp +c-df-stack+ +df-stack-size+))
    (setf (mem :u16 (+ ktss 102)) +tss-size+)
    (setf (mem :u16 (address descriptor)) (- (* 7 8) 1))
    (setf (mem :u64 (+ (address descriptor) 2)) gdt)
    (gdt-load (address descriptor))
    (cpu-data-set-gs cdp)
    (wrmsr #xC0000103 (mem :u32 (+ cdp +cpu-number+)))
    (ltr +kernel-tss+)
    (unless idt-ready (idt-init))
    (setf (mem :u16 (address descriptor)) (- (* 256 16) 1))
    (setf (mem :u64 (+ (address descriptor) 2)) (address master-idt64))
    (lidt (address descriptor))))
