(in-package #:darterfly/kern)

(defconstant +max-names+ 64)
(defconstant +max-message+ 16384)
(defconstant +receive-right+ 1)
(defconstant +epipe+ 32)
(defconstant +world-code-va+ #x40000000)
(defconstant +world-stack-size+ (ash 1 20))
(defconstant +world-stack-top+ #x00007FF000000000)

(defconstant +p-receiver+ 0)
(defconstant +p-head+ 8)
(defconstant +p-tail+ 16)
(defconstant +p-next+ 24)
(defconstant +port-size+ 32)

(defconstant +m-next+ 0)
(defconstant +m-caller+ 8)
(defconstant +m-world+ 16)
(defconstant +m-state+ 24)
(defconstant +m-length+ 32)
(defconstant +m-data+ 40)
(defconstant +m-port+ 48)
(defconstant +m-all+ 56)
(defconstant +call-size+ 64)

(defconstant +queued+ 0)
(defconstant +received+ 1)
(defconstant +replied+ 2)
(defconstant +failed+ 3)
(defconstant +abandoned+ 4)

(define-global all-ports :u64)
(define-global all-calls :u64)
(define-global next-world-id :u64)

(define-low name-slot (w (name :u64)) (+ w +w-names+ (* 8 name)))

(define-low name-port (w (name :u64) (receive :u32))
  (when (or (= name 0) (>= name +max-names+)) (result 0))
  (let ((e (mem :u64 (name-slot w name))))
    (when (and receive (not (logand e +receive-right+))) (result 0))
    (logand e (lognot 15))))

(define-low name-add (w port (right :u64))
  (let ((i 1))
    (while (< i +max-names+)
      (unless (mem :u64 (name-slot w i))
        (setf (mem :u64 (name-slot w i)) (logior port right))
        (result i))
      (incf i))
    0))

(define-low port-create ()
  (let ((p (kalloc +port-size+)))
    (rep-stosb p 0 +port-size+)
    (setf (mem :u64 (+ p +p-receiver+)) (current-world))
    (setf (mem :u64 (+ p +p-next+)) all-ports)
    (setf all-ports p)
    (let ((name (name-add (current-world) p +receive-right+)))
      (if name name (- 0 +enomem+)))))

(define-low call-live (m)
  (let ((x all-calls))
    (while x
      (when (= x m) (result 1))
      (setf x (mem :u64 (+ x +m-all+))))
    0))

(define-low call-free (m)
  (if (= all-calls m)
      (setf all-calls (mem :u64 (+ m +m-all+)))
      (let ((x all-calls))
        (while (and x (/= (mem :u64 (+ x +m-all+)) m))
          (setf x (mem :u64 (+ x +m-all+))))
        (when x (setf (mem :u64 (+ x +m-all+)) (mem :u64 (+ m +m-all+))))))
  (when (mem :u64 (+ m +m-data+)) (kfree (mem :u64 (+ m +m-data+))))
  (kfree m))

(define-low unqueue (p m)
  (if (= (mem :u64 (+ p +p-head+)) m)
      (progn
        (setf (mem :u64 (+ p +p-head+)) (mem :u64 (+ m +m-next+)))
        (unless (mem :u64 (+ p +p-head+)) (setf (mem :u64 (+ p +p-tail+)) 0)))
      (let ((x (mem :u64 (+ p +p-head+))))
        (while (and x (/= (mem :u64 (+ x +m-next+)) m))
          (setf x (mem :u64 (+ x +m-next+))))
        (when x
          (setf (mem :u64 (+ x +m-next+)) (mem :u64 (+ m +m-next+)))
          (when (= (mem :u64 (+ p +p-tail+)) m) (setf (mem :u64 (+ p +p-tail+)) x))))))

(define-low copy-in (from (len :u64))
  (let ((buf (kalloc (if len len 1))))
    (rep-movsb buf from len)
    buf))

(define-low port-call ((name :u64) msg (len :u64) reply (max :u64))
  (let ((p (name-port (current-world) name 0)))
    (unless p (result (- 0 +ebadf+)))
    (when (> len +max-message+) (result (- 0 +einval+)))
    (unless (and (the :u32 (user-ok msg len 0)) (the :u32 (user-ok reply max 1))) (result (- 0 +efault+)))
    (when (logand (mem :u64 (+ (mem :u64 (+ p +p-receiver+)) +w-flags+)) +stopped+) (result (- 0 +epipe+)))
    (let ((m (kalloc +call-size+)))
      (rep-stosb m 0 +call-size+)
      (setf (mem :u64 (+ m +m-caller+)) (current-thread))
      (setf (mem :u64 (+ m +m-world+)) (current-world))
      (setf (mem :u64 (+ m +m-length+)) len)
      (setf (mem :u64 (+ m +m-data+)) (copy-in msg len))
      (setf (mem :u64 (+ m +m-port+)) p)
      (setf (mem :u64 (+ m +m-all+)) all-calls)
      (setf all-calls m)
      (if (mem :u64 (+ p +p-tail+))
          (setf (mem :u64 (+ (mem :u64 (+ p +p-tail+)) +m-next+)) m)
          (setf (mem :u64 (+ p +p-head+)) m))
      (setf (mem :u64 (+ p +p-tail+)) m)
      (thread-wakeup p 1)
      (while (< (mem :u64 (+ m +m-state+)) +replied+)
        (unless (= (the :u32 (thread-wait m 0)) +thread-awakened+)
          (when (< (mem :u64 (+ m +m-state+)) +replied+)
            (if (= (mem :u64 (+ m +m-state+)) +queued+)
                (progn (unqueue p m) (call-free m))
                (setf (mem :u64 (+ m +m-state+)) +abandoned+))
            (result (- 0 +eintr+)))))
      (if (= (mem :u64 (+ m +m-state+)) +failed+)
          (progn (call-free m) (- 0 +epipe+))
          (let ((n (mem :u64 (+ m +m-length+))))
            (when (> n max) (setf n max))
            (rep-movsb reply (mem :u64 (+ m +m-data+)) n)
            (call-free m)
            n)))))

(define-low port-receive ((name :u64) buf (max :u64) out deadline)
  (let ((p (name-port (current-world) name 1)))
    (unless p (result (- 0 +ebadf+)))
    (unless (and (the :u32 (user-ok buf max 1)) (the :u32 (user-ok out 24 1))) (result (- 0 +efault+)))
    (while (not (mem :u64 (+ p +p-head+)))
      (let ((r (the :u32 (thread-wait p deadline))))
        (when (= r +thread-timed-out+) (result (- 0 +etimedout+)))
        (when (= r +thread-interrupted+) (result (- 0 +eintr+)))))
    (let* ((m (mem :u64 (+ p +p-head+)))
           (n (mem :u64 (+ m +m-length+))))
      (unqueue p m)
      (setf (mem :u64 (+ m +m-state+)) +received+)
      (when (> n max) (setf n max))
      (rep-movsb buf (mem :u64 (+ m +m-data+)) n)
      (setf (mem :u64 out) m)
      (setf (mem :u64 (+ out 8)) (mem :u64 (+ m +m-length+)))
      (setf (mem :u64 (+ out 16)) (mem :u64 (+ (mem :u64 (+ m +m-world+)) +w-id+)))
      n)))

(define-low port-reply (m msg (len :u64))
  (unless (and (the :u32 (call-live m))
               (= (mem :u64 (+ (mem :u64 (+ m +m-port+)) +p-receiver+)) (current-world))
               (or (= (mem :u64 (+ m +m-state+)) +received+) (= (mem :u64 (+ m +m-state+)) +abandoned+)))
    (result (- 0 +einval+)))
  (when (= (mem :u64 (+ m +m-state+)) +abandoned+)
    (call-free m)
    (result 0))
  (when (> len +max-message+) (result (- 0 +einval+)))
  (unless (the :u32 (user-ok msg len 0)) (result (- 0 +efault+)))
  (kfree (mem :u64 (+ m +m-data+)))
  (setf (mem :u64 (+ m +m-data+)) (copy-in msg len))
  (setf (mem :u64 (+ m +m-length+)) len)
  (setf (mem :u64 (+ m +m-state+)) +replied+)
  (thread-wakeup m 1)
  0)

(define-low ports-fail (w)
  (let ((m all-calls))
    (while m
      (let ((next (mem :u64 (+ m +m-all+)))
            (state (mem :u64 (+ m +m-state+))))
        (when (= (mem :u64 (+ (mem :u64 (+ m +m-port+)) +p-receiver+)) w)
          (cond ((or (= state +queued+) (= state +received+))
                 (when (= state +queued+) (unqueue (mem :u64 (+ m +m-port+)) m))
                 (setf (mem :u64 (+ m +m-state+)) +failed+)
                 (thread-wakeup m 1))
                ((= state +abandoned+) (call-free m))))
        (setf m next)))))

(define-low world-by-id (id)
  (let ((w (world-0)))
    (while w
      (when (= (mem :u64 (+ w +w-id+)) id) (result w))
      (setf w (mem :u64 (+ w +w-next+))))
    0))

(define-low world-spawn (code (len :u64) (entry :u64) (name :u64))
  (let ((p (if name (name-port (current-world) name 1) 0))
        (off 0))
    (when (and name (not p)) (result (- 0 +ebadf+)))
    (when (or (= len 0) (> len (ash 1 30)) (>= entry len)) (result (- 0 +einval+)))
    (let ((w (world-create)))
      (unless w (result (- 0 +enomem+)))
      (while (< off len)
        (let ((pa (vm-page-grab))
              (n (- len off)))
          (unless pa (result (- 0 +enomem+)))
          (when (> n +page-size+) (setf n +page-size+))
          (rep-stosb (ptov pa) 0 +page-size+)
          (rep-movsb (ptov pa) (+ code off) n)
          (setf (mem :u64 (pte-in (mem :u64 (+ w +w-pml4+)) (+ +world-code-va+ off) 1))
                (logior pa (prot-bits 7) +pte-frame+)))
        (incf off +page-size+))
      (insert-at w 0 +world-code-va+ (+ +world-code-va+ (page-up len)) 7)
      (insert-at w 1 (- +world-stack-top+ +world-stack-size+) +world-stack-top+ 3)
      (when p (name-add w p 0))
      (thread-create-user-in w (+ +world-code-va+ entry) +world-stack-top+ 0 0)
      (mem :u64 (+ w +w-id+)))))

(define-low world-stop-id (id)
  (let ((w (world-by-id id)))
    (when (or (= id 0) (not w)) (result (- 0 +einval+)))
    (unless (logand (mem :u64 (+ w +w-flags+)) +stopped+) (world-stop w))
    0))

(define-low world-state (id)
  (let ((w (world-by-id id)))
    (unless w (result (- 0 +einval+)))
    (mem :u64 (+ w +w-flags+))))
