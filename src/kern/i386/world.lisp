(in-package #:darterfly/kern)

(defconstant +max-names+ 64)
(defconstant +max-message+ 65536)
(defconstant +receive-right+ 1)
(defconstant +epipe+ 32)
(defconstant +world-code-va+ #x40000000)
(defconstant +world-stack-size+ (ash 1 20))
(defconstant +world-stack-top+ #x00007FF000000000)

(defconstant +p-receiver+ 0)
(defconstant +p-head+ 8)
(defconstant +p-tail+ 16)
(defconstant +p-next+ 24)
(defconstant +port-size+ 32)

(defconstant +m-next+ 0)
(defconstant +m-caller+ 8)
(defconstant +m-world+ 16)
(defconstant +m-state+ 24)
(defconstant +m-length+ 32)
(defconstant +m-data+ 40)
(defconstant +m-port+ 48)
(defconstant +m-all+ 56)
(defconstant +call-size+ 64)

(defconstant +queued+ 0)
(defconstant +received+ 1)
(defconstant +replied+ 2)
(defconstant +failed+ 3)
(defconstant +abandoned+ 4)

(define-global all-ports :u64)
(define-global all-calls :u64)
(define-global next-world-id :u64)
(define-global user-entry :u64 :extern t)

(define-low name-slot (w (name :u64)) (+ w +w-names+ (* 8 name)))

(define-low name-port (w (name :u64) (receive :u32))
  (when (or (= name 0) (>= name +max-names+)) (result 0))
  (let ((e (mem :u64 (name-slot w name))))
    (when (and receive (not (logand e +receive-right+))) (result 0))
    (logand e (lognot 15))))

(define-low name-add (w port (right :u64))
  (let ((i 1))
    (while (< i +max-names+)
      (unless (mem :u64 (name-slot w i))
        (setf (mem :u64 (name-slot w i)) (logior port right))
        (result i))
      (incf i))
    0))

(define-low port-make (receiver)
  (let ((p (kalloc +port-size+)))
    (rep-stosb p 0 +port-size+)
    (setf (mem :u64 (+ p +p-receiver+)) receiver)
    (setf (mem :u64 (+ p +p-next+)) all-ports)
    (setf all-ports p)
    p))

(define-low port-create ()
  (let ((name (name-add (current-world) (port-make (current-world)) +receive-right+)))
    (if name name (- 0 +enomem+))))

(define-low call-live (m)
  (let ((x all-calls))
    (while x
      (when (= x m) (result 1))
      (setf x (mem :u64 (+ x +m-all+))))
    0))

(define-low call-free (m)
  (if (= all-calls m)
      (setf all-calls (mem :u64 (+ m +m-all+)))
      (let ((x all-calls))
        (while (and x (/= (mem :u64 (+ x +m-all+)) m))
          (setf x (mem :u64 (+ x +m-all+))))
        (when x (setf (mem :u64 (+ x +m-all+)) (mem :u64 (+ m +m-all+))))))
  (when (mem :u64 (+ m +m-data+)) (kfree (mem :u64 (+ m +m-data+))))
  (kfree m))

(define-low unqueue (p m)
  (if (= (mem :u64 (+ p +p-head+)) m)
      (progn
        (setf (mem :u64 (+ p +p-head+)) (mem :u64 (+ m +m-next+)))
        (unless (mem :u64 (+ p +p-head+)) (setf (mem :u64 (+ p +p-tail+)) 0)))
      (let ((x (mem :u64 (+ p +p-head+))))
        (while (and x (/= (mem :u64 (+ x +m-next+)) m))
          (setf x (mem :u64 (+ x +m-next+))))
        (when x
          (setf (mem :u64 (+ x +m-next+)) (mem :u64 (+ m +m-next+)))
          (when (= (mem :u64 (+ p +p-tail+)) m) (setf (mem :u64 (+ p +p-tail+)) x))))))

(define-low copy-in (from (len :u64))
  (let ((buf (kalloc (if len len 1))))
    (rep-movsb buf from len)
    buf))

(define-low port-call ((name :u64) msg (len :u64) reply (max :u64))
  (let ((p (name-port (current-world) name 0)))
    (unless p (result (- 0 +ebadf+)))
    (when (> len +max-message+) (result (- 0 +einval+)))
    (unless (and (the :u32 (user-ok msg len 0)) (the :u32 (user-ok reply max 1))) (result (- 0 +efault+)))
    (when (or (not (mem :u64 (+ p +p-receiver+)))
              (logand (mem :u64 (+ (mem :u64 (+ p +p-receiver+)) +w-flags+)) +stopped+))
      (result (- 0 +epipe+)))
    (let ((m (kalloc +call-size+)))
      (rep-stosb m 0 +call-size+)
      (setf (mem :u64 (+ m +m-caller+)) (current-thread))
      (setf (mem :u64 (+ m +m-world+)) (current-world))
      (setf (mem :u64 (+ m +m-length+)) len)
      (setf (mem :u64 (+ m +m-data+)) (copy-in msg len))
      (setf (mem :u64 (+ m +m-port+)) p)
      (setf (mem :u64 (+ m +m-all+)) all-calls)
      (setf all-calls m)
      (if (mem :u64 (+ p +p-tail+))
          (setf (mem :u64 (+ (mem :u64 (+ p +p-tail+)) +m-next+)) m)
          (setf (mem :u64 (+ p +p-head+)) m))
      (setf (mem :u64 (+ p +p-tail+)) m)
      (thread-wakeup p 1)
      (while (< (mem :u64 (+ m +m-state+)) +replied+)
        (unless (= (the :u32 (thread-wait m 0)) +thread-awakened+)
          (when (< (mem :u64 (+ m +m-state+)) +replied+)
            (if (= (mem :u64 (+ m +m-state+)) +queued+)
                (progn (unqueue p m) (call-free m))
                (setf (mem :u64 (+ m +m-state+)) +abandoned+))
            (result (- 0 +eintr+)))))
      (if (= (mem :u64 (+ m +m-state+)) +failed+)
          (progn (call-free m) (- 0 +epipe+))
          (let ((n (mem :u64 (+ m +m-length+))))
            (when (> n max) (setf n max))
            (rep-movsb reply (mem :u64 (+ m +m-data+)) n)
            (call-free m)
            n)))))

(define-low port-receive ((name :u64) buf (max :u64) out deadline)
  (let ((p (name-port (current-world) name 1)))
    (unless p (result (- 0 +ebadf+)))
    (unless (and (the :u32 (user-ok buf max 1)) (the :u32 (user-ok out 24 1))) (result (- 0 +efault+)))
    (while (not (mem :u64 (+ p +p-head+)))
      (let ((r (the :u32 (thread-wait p deadline))))
        (when (= r +thread-timed-out+) (result (- 0 +etimedout+)))
        (when (= r +thread-interrupted+) (result (- 0 +eintr+)))))
    (let* ((m (mem :u64 (+ p +p-head+)))
           (n (mem :u64 (+ m +m-length+))))
      (unqueue p m)
      (setf (mem :u64 (+ m +m-state+)) +received+)
      (when (> n max) (setf n max))
      (rep-movsb buf (mem :u64 (+ m +m-data+)) n)
      (setf (mem :u64 out) m)
      (setf (mem :u64 (+ out 8)) (mem :u64 (+ m +m-length+)))
      (setf (mem :u64 (+ out 16)) (mem :u64 (+ (mem :u64 (+ m +m-world+)) +w-id+)))
      n)))

(define-low port-reply (m msg (len :u64))
  (unless (and (the :u32 (call-live m))
               (= (mem :u64 (+ (mem :u64 (+ m +m-port+)) +p-receiver+)) (current-world))
               (or (= (mem :u64 (+ m +m-state+)) +received+) (= (mem :u64 (+ m +m-state+)) +abandoned+)))
    (result (- 0 +einval+)))
  (when (= (mem :u64 (+ m +m-state+)) +abandoned+)
    (call-free m)
    (result 0))
  (when (> len +max-message+) (result (- 0 +einval+)))
  (unless (the :u32 (user-ok msg len 0)) (result (- 0 +efault+)))
  (kfree (mem :u64 (+ m +m-data+)))
  (setf (mem :u64 (+ m +m-data+)) (copy-in msg len))
  (setf (mem :u64 (+ m +m-length+)) len)
  (setf (mem :u64 (+ m +m-state+)) +replied+)
  (thread-wakeup m 1)
  0)

(define-low ports-fail (w)
  (let ((m all-calls))
    (while m
      (let ((next (mem :u64 (+ m +m-all+)))
            (state (mem :u64 (+ m +m-state+))))
        (when (= (mem :u64 (+ (mem :u64 (+ m +m-port+)) +p-receiver+)) w)
          (cond ((or (= state +queued+) (= state +received+))
                 (when (= state +queued+) (unqueue (mem :u64 (+ m +m-port+)) m))
                 (setf (mem :u64 (+ m +m-state+)) +failed+)
                 (thread-wakeup m 1))
                ((= state +abandoned+) (call-free m))))
        (setf m next)))))

(define-low world-by-id (id)
  (let ((w (world-0)))
    (while w
      (when (= (mem :u64 (+ w +w-id+)) id) (result w))
      (setf w (mem :u64 (+ w +w-next+))))
    0))

(define-low world-spawn (code (len :u64) (entry :u64) (name :u64))
  (let ((p (if name (name-port (current-world) name 1) 0))
        (off 0))
    (when (and name (not p)) (result (- 0 +ebadf+)))
    (when (or (= len 0) (> len (ash 1 30)) (>= entry len)) (result (- 0 +einval+)))
    (let ((w (world-create)))
      (unless w (result (- 0 +enomem+)))
      (while (< off len)
        (let ((pa (vm-page-grab))
              (n (- len off)))
          (unless pa (result (- 0 +enomem+)))
          (when (> n +page-size+) (setf n +page-size+))
          (rep-stosb (ptov pa) 0 +page-size+)
          (rep-movsb (ptov pa) (+ code off) n)
          (setf (mem :u64 (pte-in (mem :u64 (+ w +w-pml4+)) (+ +world-code-va+ off) 1))
                (logior pa (prot-bits 7) +pte-frame+)))
        (incf off +page-size+))
      (insert-at w 0 +world-code-va+ (+ +world-code-va+ (page-up len)) 7)
      (insert-at w 1 (- +world-stack-top+ +world-stack-size+) +world-stack-top+ 3)
      (when p (name-add w p 0))
      (thread-create-user-in w (+ +world-code-va+ entry) +world-stack-top+ 0 0)
      (mem :u64 (+ w +w-id+)))))

(define-low world-stop-id (id)
  (let ((w (world-by-id id)))
    (when (= id 0) (result (- 0 +einval+)))
    (unless w (result (if (<= id next-world-id) 0 (- 0 +einval+))))
    (unless (logand (mem :u64 (+ w +w-flags+)) +stopped+) (world-stop w))
    0))

(define-low free-tables (pa (level :u32))
  (let ((i 0) (n (if (= level 4) 256 512)))
    (while (< i n)
      (let ((e (mem :u64 (+ (ptov pa) (* 8 i)))))
        (when (logand e +pte-valid+)
          (cond ((= level 1) (when (logand e +pte-frame+) (vm-page-free (logand e +pte-pfn+))))
                ((not (logand e +pte-ps+)) (free-tables (logand e +pte-pfn+) (- level 1))))))
      (incf i))
    (vm-page-free pa)))

(define-low world-destroy (w)
  (let ((x (world-0)))
    (while (/= (mem :u64 (+ x +w-next+)) w)
      (setf x (mem :u64 (+ x +w-next+))))
    (setf (mem :u64 (+ x +w-next+)) (mem :u64 (+ w +w-next+))))
  (let ((p all-ports))
    (while p
      (when (= (mem :u64 (+ p +p-receiver+)) w) (setf (mem :u64 (+ p +p-receiver+)) 0))
      (setf p (mem :u64 (+ p +p-next+)))))
  (free-tables (mem :u64 (+ w +w-pml4+)) 4)
  (kfree w))

(define-low world-state (id)
  (reap-threads)
  (let ((w (world-by-id id)))
    (unless w (result (if (and id (<= id next-world-id)) +gone+ (- 0 +einval+))))
    (mem :u64 (+ w +w-flags+))))

(define-low load-image (w file)
  (let* ((pml4 (mem :u64 (+ w +w-pml4+)))
         (ph (+ file (mem :u64 (+ file 32))))
         (n (mem :u16 (+ file 56)))
         (i 0))
    (while (< i n)
      (let ((h (+ ph (* i 56))))
        (when (and (= (mem :u32 h) 1) (< (mem :u64 (+ h 16)) +physmap-base+))
          (let* ((vaddr (mem :u64 (+ h 16)))
                 (filesz (mem :u64 (+ h 32)))
                 (src (+ file (mem :u64 (+ h 8))))
                 (pg (page-down vaddr))
                 (end (page-up (+ vaddr (mem :u64 (+ h 40))))))
            (while (< pg end)
              (let ((e (pte-in pml4 pg 1)))
                (unless (logand (mem :u64 e) +pte-valid+)
                  (let ((pa (vm-page-grab)))
                    (unless pa (result 0))
                    (rep-stosb (ptov pa) 0 +page-size+)
                    (setf (mem :u64 e) (logior pa (prot-bits 7) +pte-frame+))))
                (let ((from (if (> vaddr pg) vaddr pg))
                      (to (if (< (+ vaddr filesz) (+ pg +page-size+)) (+ vaddr filesz) (+ pg +page-size+))))
                  (when (< from to)
                    (rep-movsb (+ (ptov (logand (mem :u64 e) +pte-pfn+)) (- from pg)) (+ src (- from vaddr)) (- to from)))))
              (incf pg +page-size+)))))
      (incf i))
    1))

(define-low share-pages (w base (size :u64) at)
  (let ((pml4 (mem :u64 (+ w +w-pml4+)))
        (pg (page-down base)))
    (while (< pg (+ base size))
      (let ((pa (if (>= pg +physmap-base+)
                    (- pg +physmap-base+)
                    (progn (unless (pmap-find-phys pg) (vm-fault pg 0)) (pmap-find-phys pg)))))
        (unless pa (result 0))
        (setf (mem :u64 (pte-in pml4 (+ at (- pg (page-down base))) 1)) (logior (logand pa +pte-pfn+) (prot-bits 1))))
      (incf pg +page-size+))
    1))

(defconstant +world-image-va+ #x0000500000000000)

(defconstant +run-stack-size+ (ash 8 20))

(define-low world-run (base (size :u64) (name :u64) out)
  (let ((p (name-port (current-world) name 1)))
    (unless p (result (- 0 +ebadf+)))
    (unless (and (user-range base size) size) (result (- 0 +einval+)))
    (when (and out (not (the :u32 (user-ok out 8 1)))) (result (- 0 +efault+)))
    (let ((w (world-create)))
      (unless w (result (- 0 +enomem+)))
      (unless (and (the :u32 (load-image w user-file))
                   (the :u32 (share-pages w base size base))
                   (the :u32 (share-pages w user-file user-file-size +world-image-va+)))
        (world-stop w)
        (result (- 0 +enomem+)))
      (setf (mem :u64 (+ w +w-core+)) base)
      (setf (mem :u64 (+ w +w-core-size+)) size)
      (setf (mem :u64 (+ w +w-image+)) (+ +world-image-va+ (logand user-file (- +page-size+ 1))))
      (setf (mem :u64 (+ w +w-image-size+)) user-file-size)
      (insert-at w 0 (- +world-stack-top+ +run-stack-size+) +world-stack-top+ 3)
      (name-add w p 0)
      (let ((inward (port-make w)))
        (name-add w inward +receive-right+)
        (when out (setf (mem :u64 out) (name-add (current-world) inward 0))))
      (thread-create-user-in w user-entry (- +world-stack-top+ 72) 0 0)
      (mem :u64 (+ w +w-id+)))))

(define-low break-cow (e va (prot :u32))
  (let ((pa (vm-page-grab)))
    (when (= pa 0) (result 0))
    (rep-movsb (ptov pa) (ptov (logand (mem :u64 e) +pte-pfn+)) +page-size+)
    (setf (mem :u64 e) (logior pa (prot-bits prot) +pte-frame+))
    (invlpg (page-down va))
    (pmap-flush-tlbs)
    pa))

(define-low cow-fault (va (prot :u32))
  (let ((e (pte (page-down va) 0)))
    (if (and e (logand (mem :u64 e) +pte-cow+) (break-cow e va prot)) 1 0)))

(define-low world-page (w va (write :u32))
  (let* ((pml4 (mem :u64 (+ w +w-pml4+)))
         (page (page-down va))
         (e (pte-in pml4 page 0)))
    (when (and e (logand (mem :u64 e) +pte-valid+))
      (when (and write (not (logand (mem :u64 e) +pte-write+)))
        (let ((x (lookup w page)))
          (unless (and (logand (mem :u64 e) +pte-cow+) x (logand (mem :u64 (+ x 16)) +prot-write+)) (result 0))
          (result (break-cow e page (mem :u64 (+ x 16))))))
      (result (logand (mem :u64 e) +pte-pfn+)))
    (let ((x (lookup w page)))
      (when (or (not x) (not (mem :u64 (+ x 16)))) (result 0))
      (when (and write (not (logand (mem :u64 (+ x 16)) +prot-write+))) (result 0))
      (let ((pa (vm-page-grab)))
        (when (= pa 0) (result 0))
        (rep-stosb (ptov pa) 0 +page-size+)
        (setf (mem :u64 (pte-in pml4 page 1)) (logior pa (prot-bits (mem :u64 (+ x 16))) +pte-frame+))
        pa))))

(define-low port-copy (m there here (len :u64) (out :u32))
  (unless (and (the :u32 (call-live m))
               (= (mem :u64 (+ (mem :u64 (+ m +m-port+)) +p-receiver+)) (current-world))
               (= (mem :u64 (+ m +m-state+)) +received+))
    (result (- 0 +einval+)))
  (unless (and (user-range there len) (the :u32 (user-ok here len (if out 0 1)))) (result (- 0 +efault+)))
  (let ((w (mem :u64 (+ m +m-world+)))
        (done 0))
    (while (< done len)
      (let* ((at (+ there done))
             (n (- +page-size+ (logand at (- +page-size+ 1))))
             (pa (world-page w at out)))
        (unless pa (result (- 0 +efault+)))
        (when (> n (- len done)) (setf n (- len done)))
        (if out
            (rep-movsb (+ (ptov pa) (logand at (- +page-size+ 1))) (+ here done) n)
            (rep-movsb (+ here done) (+ (ptov pa) (logand at (- +page-size+ 1))) n))
        (incf done n)))
    len))

(define-low map-shared (dst src (len :u64))
  (unless (and (not (logand dst (- +page-size+ 1))) (not (logand src (- +page-size+ 1)))
               (user-range dst len) (user-range src len))
    (result (- 0 +einval+)))
  (let ((pml4 (mem :u64 (+ (current-world) +w-pml4+)))
        (off 0))
    (while (< off len)
      (let ((from (pte-in pml4 (+ src off) 0))
            (x (lookup (current-world) (+ dst off))))
        (unless (and from (logand (mem :u64 from) +pte-valid+) x) (result (- 0 +efault+)))
        (let ((old (pte-in pml4 (+ dst off) 1)))
          (when (logand (mem :u64 old) +pte-frame+) (vm-page-free (logand (mem :u64 old) +pte-pfn+)))
          (setf (mem :u64 old) (logior (logand (mem :u64 from) +pte-pfn+)
                                       (logand (prot-bits (mem :u64 (+ x 16))) (lognot +pte-write+))
                                       +pte-cow+))
          (invlpg (+ dst off))))
      (incf off +page-size+))
    (pmap-flush-tlbs)
    len))

(define-global beat-at :u64)
(define-global beat-limit :u64)
(define-global beat-warned :u64)

(define-low machine-reset ()
  (cli)
  (outb #xCF9 2)
  (outb #xCF9 6)
  (while 1 (hlt)))

(define-low heartbeat ((seconds :u64))
  (setf beat-limit (* seconds (ref commpage 0)))
  (setf beat-at (rdtsc))
  (setf beat-warned 0)
  0)

(define-low watchdog-deadline ()
  (if beat-limit (+ beat-at (* beat-limit (if beat-warned 2 1))) 0))

(define-low watchdog-report ()
  (let ((th all-threads))
    (while th
      (when (and (= (world-of th) (world-0)) (/= (mem :u32 (+ th +t-state+)) +th-terminate+))
        (let ((frame (- (mem :u64 (+ th +t-kstack-top+)) +saved-state-size+)))
          (kprintf "watchdog:   thread 0x%lx state %u rip 0x%lx rsp 0x%lx
" (mem :u64 (+ th +t-thread-id+)) (mem :u32 (+ th +t-state+))
                   (mem :u64 (+ frame 136)) (mem :u64 (+ frame 160)))))
      (setf th (mem :u64 (+ th +t-all-next+))))))

(define-low watchdog-check ()
  (when (and beat-limit (> (rdtsc) (+ beat-at beat-limit)))
    (if (not beat-warned)
        (progn
          (setf beat-warned 1)
          (kprintf "watchdog: world 0 has not checked in for %lu s; its threads:
" (truncate beat-limit (ref commpage 0)))
          (watchdog-report))
        (when (> (rdtsc) (+ beat-at (* 2 beat-limit)))
          (kprintf "watchdog: world 0 is still silent; restarting the machine
")
          (machine-reset)))))

(define-low live-threads (w)
  (let ((th all-threads) (n 0))
    (while th
      (when (and (= (world-of th) w) (/= (mem :u32 (+ th +t-state+)) +th-terminate+)) (incf n))
      (setf th (mem :u64 (+ th +t-all-next+))))
    n))

(define-low world-pause ((id :u64))
  (let ((w (world-by-id id)) (th all-threads) (tries 0))
    (when (or (not w) (physmap-world-p w)) (result (- 0 +einval+)))
    (setf (mem :u64 (+ w +w-flags+)) (logior (mem :u64 (+ w +w-flags+)) +paused+))
    (while th
      (when (and (= (world-of th) w) (/= (mem :u32 (+ th +t-state+)) +th-terminate+))
        (thread-abort-safely th))
      (setf th (mem :u64 (+ th +t-all-next+))))
    (while (and (< (mem :u64 (+ w +w-parked+)) (live-threads w)) (< tries 2000))
      (thread-wait (+ w +w-parked+) (deadline-after 0 1000000))
      (incf tries))
    (when (< (mem :u64 (+ w +w-parked+)) (live-threads w))
      (setf th all-threads)
      (kprintf "pause: world %lu parked %lu of %lu
" id (mem :u64 (+ w +w-parked+)) (live-threads w))
      (while th
        (when (= (world-of th) w)
          (kprintf "pause:   thread 0x%lx state %u event 0x%lx flags 0x%x
" (mem :u64 (+ th +t-thread-id+)) (mem :u32 (+ th +t-state+))
                   (mem :u64 (+ th +t-wait-event+)) (mem :u32 (+ th +t-sched-flags+))))
        (setf th (mem :u64 (+ th +t-all-next+)))))
    (if (< (mem :u64 (+ w +w-parked+)) (live-threads w)) (- 0 +etimedout+) (live-threads w))))

(define-low world-resume ((id :u64))
  (let ((w (world-by-id id)))
    (unless w (result (- 0 +einval+)))
    (setf (mem :u64 (+ w +w-flags+)) (logand (mem :u64 (+ w +w-flags+)) (lognot +paused+)))
    (thread-wakeup (+ w +w-flags+) 1)
    0))

(define-low put-u64 (out (at :u64) value) (setf (mem :u64 (+ out at)) value) (+ at 8))

(define-low world-describe ((id :u64) out (max :u64))
  (let ((w (world-by-id id)) (at 0) (i 0) (th all-threads) (count-at 0))
    (unless (and w (logand (mem :u64 (+ w +w-flags+)) +paused+)) (result (- 0 +einval+)))
    (unless (the :u32 (user-ok out max 1)) (result (- 0 +efault+)))
    (when (< max (+ 4096 (* 24 (count-of w)) 1560 (* 64 1024))) (result (- 0 +einval+)))
    (setf at (put-u64 out at (count-of w)))
    (while (< i (count-of w))
