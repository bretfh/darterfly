(in-package #:darterfly/kern)

(defconstant +th-run+ 1)
(defconstant +th-wait+ 2)
(defconstant +th-terminate+ 4)
(defconstant +abort-safely+ #x20)
(defconstant +terminate-requested+ #x40)
(defconstant +thread-awakened+ 0)
(defconstant +thread-timed-out+ 1)
(defconstant +thread-interrupted+ 2)
(defconstant +thread-size+ 624)
(defconstant +kernel-stack-size+ (* 32 1024))
(defconstant +saved-state-size+ 176)
(defconstant +user64-cs+ #x33)
(defconstant +user-ds+ #x2B)

(defconstant +t-kernel-rsp+ 0)
(defconstant +t-kstack-top+ 8)
(defconstant +t-fs-base+ 16)
(defconstant +t-thread-id+ 24)
(defconstant +t-state+ 32)
(defconstant +t-sched-flags+ 36)
(defconstant +t-wait-result+ 40)
(defconstant +t-wait-event+ 48)
(defconstant +t-wait-deadline+ 56)
(defconstant +t-sigmask+ 64)
(defconstant +t-runq-next+ 80)
(defconstant +t-all-next+ 88)
(defconstant +t-fpu+ 96)
(defconstant +t-cpu+ 608)

(defconstant +c-active-thread+ 8)
(defconstant +c-idle-thread+ 16)
(defconstant +c-running+ 32)
(defconstant +c-idle+ 36)
(defconstant +c-pending-ast+ 44)

(define-global all-threads :u64 :export t)
(define-global cpu-stats :u64 :count 128)
(define-global irq-counts :u64 :count 256)
(define-global runq-head :u64)
(define-global runq-tail :u64)
(define-global next-thread-id :u64)
(define-global |real_ncpus| :u32 :extern t)

(define-low rdtsc () (rdtsc))

(define-low current-thread () (mem :u64 (+ (cpu-data) +c-active-thread+)))

(define-low cpu-datap ((i :u32)) (+ (address |cpu_data_master|) (* i +cpu-data-size+)))

(define-low enqueue (th)
  (setf (mem :u64 (+ th +t-runq-next+)) 0)
  (if runq-tail
      (setf (mem :u64 (+ runq-tail +t-runq-next+)) th)
      (setf runq-head th))
  (setf runq-tail th))

(define-low dequeue ()
  (let ((th runq-head))
    (when th
      (setf runq-head (mem :u64 (+ th +t-runq-next+)))
      (unless runq-head (setf runq-tail 0)))
    th))

(define-low thread-alloc-unlisted ()
  (let ((th (logand (+ (kalloc (+ +thread-size+ 16)) 15) (lognot 15))))
    (rep-stosb th 0 +thread-size+)
    th))

(define-low thread-alloc ()
  (let ((th (thread-alloc-unlisted)))
    (when (= next-thread-id 0) (setf next-thread-id #x100))
    (setf (mem :u64 (+ th +t-thread-id+)) next-thread-id)
    (incf next-thread-id)
    (setf (mem :u64 (+ th +t-all-next+)) all-threads)
    (setf all-threads th)
    th))

(define-low thread-bootstrap (kstack-top)
  (let ((th (thread-alloc)))
    (setf (mem :u64 (+ th +t-kstack-top+)) kstack-top)
    (setf (mem :u32 (+ th +t-state+)) +th-run+)
    (setf (mem :u64 (+ (cpu-data) +c-active-thread+)) th)
    (setf (mem :u64 (+ (cpu-data) +c-idle-thread+)) (idle-thread-create))
    th))

(define-low push-word (at value)
  (setf (mem :u64 (- at 8)) value)
  (- at 8))

(define-low idle-thread-create ()
  (let* ((th (thread-alloc-unlisted))
         (stack (kalloc +kernel-stack-size+))
         (k (logand (+ stack +kernel-stack-size+) (lognot 15)))
         (i 0))
    (rep-stosb stack 0 +kernel-stack-size+)
    (setf (mem :u64 (+ th +t-kstack-top+)) k)
    (setf (mem :u32 (+ th +t-state+)) +th-run+)
    (setf k (push-word k 0))
    (setf k (push-word k (code-address idle-thread)))
    (while (< i 6) (setf k (push-word k 0)) (incf i))
    (setf (mem :u64 (+ th +t-kernel-rsp+)) k)
    th))

(define-low idle-thread ()
  (while 1
    (let ((next (dequeue)))
      (if next
          (switch-to next)
          (progn
            (unless (= (the :u32 (funnel-depth)) 1)
              (panic "idle_thread: funnel depth %d" (funnel-depth)))
            (setf (mem :u32 (+ (cpu-data) +c-idle+)) 1)
            (funnel-unlock)
            (idle-wait)
            (funnel-lock)
            (setf (mem :u32 (+ (cpu-data) +c-idle+)) 0))))))

(define-low thread-create-user (rip rsp arg fs-base)
  (let* ((th (thread-alloc))
         (stack (kalloc +kernel-stack-size+))
         (top (+ stack +kernel-stack-size+))
         (frame (- top +saved-state-size+))
         (k frame)
         (i 0))
    (rep-stosb stack 0 +kernel-stack-size+)
    (setf (mem :u64 (+ th +t-kstack-top+)) top)
    (setf (mem :u64 (+ th +t-fs-base+)) fs-base)
    (setf (mem :u64 (+ th +t-sigmask+)) (mem :u64 (+ (current-thread) +t-sigmask+)))
    (fxsave (+ th +t-fpu+))
    (setf (mem :u64 (+ frame 136)) rip)
    (setf (mem :u64 (+ frame 144)) +user64-cs+)
    (setf (mem :u64 (+ frame 152)) #x202)
    (setf (mem :u64 (+ frame 160)) rsp)
    (setf (mem :u64 (+ frame 168)) +user-ds+)
    (setf (mem :u64 (+ frame 40)) arg)
    (setf k (push-word k (code-address return-to-user)))
    (while (< i 6) (setf k (push-word k 0)) (incf i))
    (setf (mem :u64 (+ th +t-kernel-rsp+)) k)
    (thread-setrun th)
    th))

(define-low thread-setrun (th)
  (when (= (mem :u32 (+ th +t-state+)) +th-run+) (result 0))
  (setf (mem :u32 (+ th +t-state+)) +th-run+)
  (enqueue th)
  (let ((i 0))
    (while (< i |real_ncpus|)
      (let ((cdp (cpu-datap i)))
        (when (and (/= i (cpu-number)) (mem :u32 (+ cdp +c-running+)) (mem :u32 (+ cdp +c-idle+)))
          (setf (mem :u32 (+ cdp +c-idle+)) 0)
          (i386-signal-cpu i)
          (result 0)))
      (incf i))))

(define-low charge (old)
  (let* ((c (* 4 (cpu-number))) (now (rdtsc)) (since (ref cpu-stats c)))
    (when since
      (setf (mem :u64 (+ old +t-cpu+)) (+ (mem :u64 (+ old +t-cpu+)) (- now since)))
      (when (= old (mem :u64 (+ (cpu-data) +c-idle-thread+)))
        (setf (ref cpu-stats (+ c 1)) (+ (ref cpu-stats (+ c 1)) (- now since)))))
    (setf (ref cpu-stats c) now)
    (setf (ref cpu-stats (+ c 2)) (+ (ref cpu-stats (+ c 2)) 1))))

(define-low running-since (th)
  (let ((i 0))
    (while (< i 32)
      (when (and (= (mem :u64 (+ (cpu-datap i) +c-active-thread+)) th) (ref cpu-stats (* 4 i)))
        (result (- (rdtsc) (ref cpu-stats (* 4 i)))))
      (incf i))
    0))

(define-low thread-times (buffer (count :u64))
  (let ((n 0) (th all-threads))
    (while (and th (< n count))
      (setf (mem :u64 (+ buffer (* 16 n))) (mem :u64 (+ th +t-thread-id+)))
      (setf (mem :u64 (+ buffer (* 16 n) 8)) (+ (mem :u64 (+ th +t-cpu+)) (running-since th)))
      (incf n)
      (setf th (mem :u64 (+ th +t-all-next+))))
    n))

(define-low cpu-times (buffer)
  (let ((i 0) (now (rdtsc)))
    (while (< i 128)
      (setf (mem :u64 (+ buffer (* 8 i))) (ref cpu-stats i))
      (incf i))
    (setf i 0)
    (while (< i 32)
      (let ((cdp (cpu-datap i)))
        (when (and (ref cpu-stats (* 4 i))
                   (= (mem :u64 (+ cdp +c-active-thread+)) (mem :u64 (+ cdp +c-idle-thread+))))
          (setf (mem :u64 (+ buffer (* 8 (+ (* 4 i) 1))))
                (+ (ref cpu-stats (+ (* 4 i) 1)) (- now (ref cpu-stats (* 4 i)))))))
      (incf i))
    (setf i 0)
    (while (< i 256)
      (setf (mem :u64 (+ buffer 1024 (* 8 i))) (ref irq-counts i))
      (incf i))
    (let ((n 0) (k 0))
      (while (< k 32)
        (when (mem :u32 (+ (cpu-datap k) +c-running+)) (incf n))
        (incf k))
      n)))

(define-low switch-to (next)
  (let ((old (current-thread)))
    (when (= next old) (result 0))
    (charge old)
    (fxsave (+ old +t-fpu+))
    (fxrstor (+ next +t-fpu+))
    (setf (mem :u64 (+ (cpu-data) +c-active-thread+)) next)
    (set-kernel-stack (mem :u64 (+ next +t-kstack-top+)))
    (wrmsr #xC0000100 (mem :u64 (+ next +t-fs-base+)))
    (|Switch_context| (+ old +t-kernel-rsp+) (mem :u64 (+ next +t-kernel-rsp+)))))

(define-low thread-block ()
  (let ((self (current-thread)))
    (when (= (mem :u32 (+ self +t-state+)) +th-run+) (enqueue self))
    (let ((next (dequeue)))
      (unless next (setf next (mem :u64 (+ (cpu-data) +c-idle-thread+))))
      (unless (= next self) (switch-to next)))))

(define-low thread-wait (event deadline)
  (let ((self (current-thread)))
    (when (logand (mem :u32 (+ self +t-sched-flags+)) +abort-safely+)
      (setf (mem :u32 (+ self +t-sched-flags+)) (logand (mem :u32 (+ self +t-sched-flags+)) (lognot +abort-safely+)))
      (result +thread-interrupted+))
    (setf (mem :u32 (+ self +t-state+)) +th-wait+)
    (setf (mem :u64 (+ self +t-wait-event+)) event)
    (setf (mem :u64 (+ self +t-wait-deadline+)) deadline)
    (setf (mem :u32 (+ self +t-wait-result+)) +thread-awakened+)
    (thread-block)
    (mem :u32 (+ self +t-wait-result+))))

(define-low thread-wakeup-thread (th (wait-result :u32))
  (unless (= (mem :u32 (+ th +t-state+)) +th-wait+) (result 0))
  (setf (mem :u32 (+ th +t-wait-result+)) wait-result)
  (setf (mem :u64 (+ th +t-wait-event+)) 0)
  (setf (mem :u64 (+ th +t-wait-deadline+)) 0)
  (thread-setrun th))

(define-low thread-abort-safely (th)
  (when (= (mem :u32 (+ th +t-state+)) +th-wait+)
    (thread-wakeup-thread th +thread-interrupted+)
    (result 0))
  (setf (mem :u32 (+ th +t-sched-flags+)) (logior (mem :u32 (+ th +t-sched-flags+)) +abort-safely+))
  (cause-ast-check th))

(define-low thread-wakeup (event (all :u32))
  (let ((n 0) (th all-threads))
    (while th
      (when (and (= (mem :u32 (+ th +t-state+)) +th-wait+) (= (mem :u64 (+ th +t-wait-event+)) event))
        (thread-wakeup-thread th +thread-awakened+)
        (incf n)
        (unless all (result n)))
      (setf th (mem :u64 (+ th +t-all-next+))))
    n))

(define-low thread-terminate-self ()
  (setf (mem :u32 (+ (current-thread) +t-state+)) +th-terminate+)
  (thread-block)
  (panic "thread_terminate_self: came back"))

(define-low sched-tick ()
  (when (= (cpu-number) 0)
    (let ((now (rdtsc)) (th all-threads))
      (while th
        (when (and (= (mem :u32 (+ th +t-state+)) +th-wait+)
                   (mem :u64 (+ th +t-wait-deadline+))
                   (>= now (mem :u64 (+ th +t-wait-deadline+))))
          (thread-wakeup-thread th +thread-timed-out+))
        (setf th (mem :u64 (+ th +t-all-next+))))))
  (when runq-head (setf (mem :u32 (+ (cpu-data) +c-pending-ast+)) 1)))

(define-low terminating ()
  (logand (mem :u32 (+ (current-thread) +t-sched-flags+)) +terminate-requested+))

(define-low thread-terminate (th)
  (setf (mem :u32 (+ th +t-sched-flags+)) (logior (mem :u32 (+ th +t-sched-flags+)) +terminate-requested+))
  (thread-abort-safely th))

(define-low sched-ast ()
  (when (logand (mem :u32 (+ (current-thread) +t-sched-flags+)) +terminate-requested+)
    (thread-terminate-self))
  (unless (mem :u32 (+ (cpu-data) +c-pending-ast+)) (result 0))
  (setf (mem :u32 (+ (cpu-data) +c-pending-ast+)) 0)
  (thread-block))
