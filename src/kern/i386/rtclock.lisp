(in-package #:finch/kern)

(define-global commpage :u64 :count 3 :alignment 4096 :export t)

(define-low tsc-from-cpuid ()
  (when (< (the :u32 (cpuid 0 :eax)) #x15) (result 0))
  (let ((denominator (the :u32 (cpuid #x15 :eax)))
        (numerator (the :u32 (cpuid #x15 :ebx)))
        (crystal (the :u32 (cpuid #x15 :ecx))))
    (if (and denominator numerator crystal)
        (truncate (* crystal numerator) denominator)
        0)))

(define-low tsc-calibrate ()
  (let ((reported (tsc-from-cpuid)))
    (when reported (result reported)))
  (outb #x61 (logior (logand (inb #x61) (lognot 2)) 1))
  (outb #x43 #xB0)
  (outb #x42 (logand 11932 #xFF))
  (outb #x42 (ash 11932 -8))
  (let ((t0 (rdtsc)))
    (while (and (= (logand (inb #x61) #x20) 0) (< (- (rdtsc) t0) 100000000000)))
    (* (- (rdtsc) t0) 100)))

(define-low cmos ((reg :u8))
  (outb #x70 reg)
  (inb #x71))

(define-low bcd (v binary)
  (if binary v (+ (logand v 15) (* (shr v 4) 10))))

(define-low days-before ((month :u32))
  (cond ((= month 1) 0) ((= month 2) 31) ((= month 3) 59) ((= month 4) 90)
        ((= month 5) 120) ((= month 6) 151) ((= month 7) 181) ((= month 8) 212)
        ((= month 9) 243) ((= month 10) 273) ((= month 11) 304) (t 334)))

(define-low rtc-epoch ()
  (while (logand (cmos #x0A) #x80))
  (let* ((binary (logand (cmos #x0B) 4))
         (sec (bcd (cmos #x00) binary))
         (min (bcd (cmos #x02) binary))
         (hour (bcd (logand (cmos #x04) #x7F) binary))
         (day (bcd (cmos #x07) binary))
         (month (bcd (cmos #x08) binary))
         (year (+ (bcd (cmos #x09) binary) 2000))
         (days (+ (* (- year 1970) 365) (truncate (- year 1969) 4)
                  (- 0 (truncate (- year 1901) 100)) (truncate (- year 1601) 400)
                  (days-before month) day -1)))
    (when (and (> month 2)
               (or (and (= (rem year 4) 0) (/= (rem year 100) 0)) (= (rem year 400) 0)))
      (incf days))
    (+ (* days 86400) (* hour 3600) (* min 60) sec)))

(define-low rtclock-init ()
  (setf (ref commpage 0) (tsc-calibrate))
  (setf (ref commpage 2) (rtc-epoch))
  (setf (ref commpage 1) (rdtsc))
  (kprintf "rtclock: tsc %lu MHz, epoch %lu
" (truncate (ref commpage 0) 1000000) (ref commpage 2)))

(define-low panic (format &va ap)
  (kprintf "panic(cpu 0 caller 0x%lx): " (return-address))
  (vkprintf format ap)
  (when (the :u32 (|platform_parse_boot_arg| "halt")) (|platform_halt|))
  (while 1 (cli) (hlt)))
