(in-package #:darterfly/kern)

(defconstant +user-stack-top+ #x00007FF000000000)
(defconstant +user-stack-size+ (ash 8 20))
(defconstant +command-line+ 8)
(defconstant +ksize+ 1084)
(defconstant +kslide+ 1108)

(define-global |platform_boot_args| :u64 :export t)
(define-global restart-core :u64 :export t)
(define-global restart-core-size :u64 :export t)
(define-global user-file :u64 :export t)
(define-global user-file-size :u64 :export t)
(define-global user-entry :u64)
(define-global run-pages :u64 :count 32768)
(define-global run-page-count :u64)

(define-low usable ((type :u32))
  (or (= type 1) (= type 2) (= type 3) (= type 4) (= type 7)))

(define-low vm-test ()
  (let ((base #x1200000000)
        (len (ash 1 30))
        (before (vm-page-free-count))
        (sum 0)
        (a 0))
    (vm-map-enter base len 3)
    (setf a base)
    (while (< a (+ base len))
      (unless (= (mem :u64 a) 0) (panic "vmtest: page at 0x%lx is not zero" a))
      (setf (mem :u64 a) a)
      (incf a (ash 2 20)))
    (setf a base)
    (while (< a (+ base len))
      (when (= (mem :u64 a) a) (incf sum))
      (incf a (ash 2 20)))
    (kprintf "vmtest: %lu demand-zero pages, %lu read back, %lu pages taken
" (truncate len (ash 2 20)) sum (- before (vm-page-free-count)))
    (let* ((x (kalloc 100))
           (y (kalloc 100000)))
      (kfree x)
      (kprintf "vmtest: kalloc %s
" (if (and (= x (kalloc 90)) y) "reuses freed blocks" "is wrong")))))

(defconstant +world-test-va+ #x1300000000)

(define-global world-test-seen :u64)
(define-global world-test-found :u64)

(define-low world-test-thread ()
  (vm-map-enter +world-test-va+ +page-size+ 3)
  (setf world-test-found (mem :u64 +world-test-va+))
  (setf (mem :u64 +world-test-va+) #x2222)
  (setf world-test-seen (mem :u64 +world-test-va+))
  (thread-wakeup (address world-test-seen) 1)
  (thread-terminate-self))

(define-low world-test ()
  (let ((w (world-create))
        (tries 0))
    (vm-map-enter +world-test-va+ +page-size+ 3)
    (setf (mem :u64 +world-test-va+) #x1111)
    (thread-create-kernel (code-address world-test-thread) w)
    (while (and (not world-test-seen) (< tries 100))
      (thread-wait (address world-test-seen) (deadline-after 0 10000000))
      (incf tries))
    (kprintf "worldtest: world 0 sees 0x%lx, world 1 found 0x%lx and wrote 0x%lx, world 1 has %lu entries
" (mem :u64 +world-test-va+) world-test-found world-test-seen (mem :u64 (+ w +w-nentries+)))
    (vm-map-remove +world-test-va+ +page-size+)
    (world-user-test)))

(defconstant +world-code-va+ #x40000000)

(define-low world-user-test ()
  (let* ((u (world-create))
         (pa (vm-page-grab))
         (p (ptov pa))
         (tries 0))
    (rep-stosb p 0 +page-size+)
    (setf (mem :u64 (+ p 0)) #x4882CD00000004B8)
    (setf (mem :u64 (+ p 8)) #x00A348D88948188B)
    (setf (mem :u64 (+ p 16)) #xB800000000400008)
    (setf (mem :u64 (+ p 24)) #xA34882CD00000009)
    (setf (mem :u64 (+ p 32)) #x0000000040000808)
    (setf (mem :u64 (+ p 40)) #x00BE4800000001BF)
    (setf (mem :u64 (+ p 48)) #xBAFFFFFFFF800000)
    (setf (mem :u64 (+ p 56)) #x000004B800000008)
    (setf (mem :u64 (+ p 64)) #x000810A34880CD00)
    (setf (mem :u64 (+ p 72)) #x00B9480000000040)
    (setf (mem :u64 (+ p 80)) #x48FFFF8000000000)
    (setf (mem :u64 (+ p 88)) #x90909090FEEB118B)
    (setf (mem :u64 (pte-in (mem :u64 (+ u +w-pml4+)) +world-code-va+ 1)) (logior pa (prot-bits 7)))
    (thread-create-user-in u +world-code-va+ (+ +world-code-va+ +page-size+) 0 0)
    (while (and (not (logand (mem :u64 (+ u +w-flags+)) +stopped+)) (< tries 100))
      (thread-wait u (deadline-after 0 10000000))
      (incf tries))
    (kprintf "worldtest: world 2 read the clock: %s, raw pages: error %lu, a kernel buffer: error %lu, stopped: %s
" (if (= (mem :u64 (+ p #x800)) (ref commpage 0)) "yes" "no") (mem :u64 (+ p #x808)) (mem :u64 (+ p #x810))
             (if (logand (mem :u64 (+ u +w-flags+)) +stopped+) "yes" "no"))))

(define-low reset-user-image ()
  (let* ((file (+ (mem :u64 (+ |platform_boot_args| +kernel-file-start+)) +physmap-base+))
         (ph (+ file (mem :u64 (+ file 32))))
         (n (mem :u16 (+ file 56)))
         (i 0))
    (while (< i n)
      (let ((h (+ ph (* i 56))))
        (when (and (= (mem :u32 h) 1) (logand (mem :u32 (+ h 4)) 2)
                   (< (mem :u64 (+ h 16)) +physmap-base+))
          (rep-movsb (mem :u64 (+ h 16)) (+ file (mem :u64 (+ h 8))) (mem :u64 (+ h 32)))
          (rep-stosb (+ (mem :u64 (+ h 16)) (mem :u64 (+ h 32))) 0
                     (- (mem :u64 (+ h 40)) (mem :u64 (+ h 32))))))
      (incf i))))

(define-low other-threads (self (terminate :u32))
  (let ((th all-threads) (n 0))
    (while th
      (when (and (/= th self) (/= (mem :u32 (+ th +t-state+)) +th-terminate+))
        (when terminate (thread-terminate th))
        (incf n))
      (setf th (mem :u64 (+ th +t-all-next+))))
    n))

(define-low boot-user-file ()
  (+ (mem :u64 (+ |platform_boot_args| +kernel-file-start+)) +physmap-base+))

(define-low release-run-pages ()
  (while run-page-count
    (decf run-page-count)
    (vm-page-free (ref run-pages run-page-count))))

(define-low map-boot-user-image ()
  (let ((r 0))
    (while (< r (mem :u32 (+ |platform_boot_args| +region-count+)))
      (let ((region (+ |platform_boot_args| +regions+ (* 24 r)))
            (off 0))
        (while (< off (mem :u64 (+ region 16)))
          (pmap-enter (+ (mem :u64 region) off) (+ (mem :u64 (+ region 8)) off) 7)
          (incf off +page-size+)))
      (incf r)))
  (reset-user-image)
  (setf user-file (boot-user-file))
  (setf user-file-size (mem :u64 (+ |platform_boot_args| +kernel-file-size+)))
  (setf user-entry (mem :u64 (code-address libsa-start-address))))

(define-low map-run-user-image (file size entry)
  (let* ((ph (+ file (mem :u64 (+ file 32))))
         (n (mem :u16 (+ file 56)))
         (mapped 0)
         (i 0))
    (while (< i n)
      (let ((h (+ ph (* i 56))))
        (when (and (= (mem :u32 h) 1) (< (mem :u64 (+ h 16)) +physmap-base+))
          (let ((va (page-down (mem :u64 (+ h 16))))
                (end (page-up (+ (mem :u64 (+ h 16)) (mem :u64 (+ h 40))))))
            (when (< va mapped) (setf va mapped))
            (when (> end mapped) (setf mapped end))
            (while (< va end)
              (let ((pa (vm-page-grab)))
                (unless pa (result 0))
                (when (>= run-page-count 32768) (result 0))
                (rep-stosb (ptov pa) 0 +page-size+)
                (pmap-enter va pa 7)
                (setf (ref run-pages run-page-count) pa)
                (incf run-page-count))
              (incf va +page-size+)))
          (rep-movsb (mem :u64 (+ h 16)) (+ file (mem :u64 (+ h 8))) (mem :u64 (+ h 32)))))
      (incf i)))
  (setf user-file file)
  (setf user-file-size size)
  (setf user-entry entry)
  1)

(define-low restart-user (core size file file-size entry)
  (let ((self (current-thread))
        (tries 0))
    (while (the :u32 (other-threads self 1))
      (when (> tries 100) (result 0))
      (thread-wait 0 (deadline-after 0 10000000))
      (incf tries))
    (vm-map-reset core size)
    (release-run-pages)
    (if file
        (unless (the :u32 (map-run-user-image file file-size entry))
          (release-run-pages)
          (map-boot-user-image)
          (kprintf "restart: no room for the run's user image
"))
        (map-boot-user-image))
    (setf restart-core core)
    (setf restart-core-size size)
    (setf (mem :u64 (+ self +t-sigmask+)) 0)
    (setf (mem :u64 (+ self +t-siglist+)) 0)
    (setf (mem :u64 (siglist-of (current-world))) 0)
    (kprintf "restart: core 0x%lx size %lu
" core size)
    (load-init-program)
    1))

(define-low load-init-program ()
  (vm-map-enter (- +user-stack-top+ +user-stack-size+) +user-stack-size+ 3)
  (kprintf "load_init_program: sbcl
")
  (funnel-unlock)
  (thread-bootstrap-return user-entry (- +user-stack-top+ 72)
                           (+ |platform_boot_args| +command-line+)))

(define-low i386-init (args)
  (setf |real_ncpus| 1)
  (cpu-data-set-gs (cpu-datap 0))
  (funnel-lock)
  (setf |platform_boot_args| args)
  (serial-init)
  (kprintf "darterfly Kernel Version 0.1: %s; root:darterfly/RELEASE_X86_64
" (build-date))
  (kprintf "boot_args: Revision %u Version %u efiMode %u
" (mem :u16 args) (mem :u16 (+ args 2)) (mem :u8 (+ args 4)))
  (kprintf "boot-args: %s
" (+ args +command-line+))
  (kprintf "kernel: 0x%x size %u kslide 0x%x
" (mem :u32 (+ args +kaddr+)) (mem :u32 (+ args +ksize+)) (mem :u32 (+ args +kslide+)))
  (let* ((size (mem :u32 (+ args +descriptor-size+)))
         (ranges (truncate (mem :u32 (+ args +memory-map-size+)) size))
         (pages 0)
         (i 0))
    (while (< i ranges)
      (let ((r (+ (mem :u32 (+ args +memory-map+)) (* i size))))
        (when (usable (mem :u32 r)) (incf pages (mem :u64 (+ r 24)))))
      (incf i))
    (kprintf "memory: %u ranges, %lu MB usable
" ranges (truncate (* pages 4096) (* 1024 1024))))
  (kprintf "video: %ux%ux%u at 0x%lx
" (mem :u32 (+ args +video+ 8)) (mem :u32 (+ args +video+ 12)) (mem :u32 (+ args +video+ 16))
           (mem :u64 (+ args +video+ 48)))
  (mp-desc-init (cpu-datap 0))
  (kprintf "mp_desc: gdt, idt and ktss loaded
")
  (vm-page-bootstrap args)
  (pmap-bootstrap args)
  (console-init)
  (kalloc-init)
  (kprintf "vm: %lu MB free
" (truncate (* (vm-page-free-count) +page-size+) (* 1024 1024)))
  (when (the :u32 (|platform_parse_boot_arg| "vmtest")) (vm-test))
  (rtclock-init)
  (pat-init)
  (power-init)
  (lapic-init)
  (thread-bootstrap (boot-kernel-stack-top))
  (i386-start-cpus)
  (when (the :u32 (|platform_parse_boot_arg| "worldtest")) (world-test))
  (when (the :u32 (|platform_parse_boot_arg| "trap")) (int3))
  (when (the :u32 (|platform_parse_boot_arg| "halt"))
    (kprintf "halt
")
    (|platform_halt|))
  (setf user-file (boot-user-file))
  (setf user-file-size (mem :u64 (+ |platform_boot_args| +kernel-file-size+)))
  (setf user-entry (mem :u64 (code-address libsa-start-address)))
  (load-init-program))
