(in-package #:darterfly/kern)

(defconstant +max-entries+ 1024)
(defconstant +user-mmap-base+ #x0000200000000000)
(defconstant +io-map-base+ #xFFFFFE0000000000)
(defconstant +user-top+ #x0000800000000000)
(defconstant +prot-write+ 2)
(defconstant +prot-execute+ 4)

(defconstant +w-pml4+ 0)
(defconstant +w-nentries+ 8)
(defconstant +w-mmap-next+ 16)
(defconstant +w-next+ 24)
(defconstant +w-siglist+ 32)
(defconstant +w-sigtramp+ 40)
(defconstant +w-real-interval+ 48)
(defconstant +w-real-deadline+ 56)
(defconstant +w-entries+ 64)
(defconstant +w-sigacts+ 24640)
(defconstant +w-flags+ 26200)
(defconstant +w-id+ 26208)
(defconstant +w-names+ 26216)
(defconstant +w-core+ 26728)
(defconstant +w-core-size+ 26736)
(defconstant +w-image+ 26744)
(defconstant +w-image-size+ 26752)
(defconstant +w-parked+ 26760)
(defconstant +w-vectors+ 26768)
(defconstant +w-io-next+ 26776)
(defconstant +w-grants+ 26784)
(defconstant +max-grants+ 16)
(defconstant +w-rights+ 27168)
(defconstant +w-beat-at+ 27176)
(defconstant +w-beat-limit+ 27184)
(defconstant +w-beat-warned+ 27192)
(defconstant +w-when-silent+ 27200)
(defconstant +world-size+ 27208)
(defconstant +silent-stop+ 0)
(defconstant +silent-reset+ 1)
(defconstant +io-window+ #x0000700000000000)
(defconstant +phys-window+ #x0000600000000000)
(defconstant +window-limit+ #x00001F0000000000)
(defconstant +right-physmap+ 1)
(defconstant +right-console+ 2)
(defconstant +right-hardware+ 4)
(defconstant +right-power+ 8)
(defconstant +right-worlds+ 16)
(defconstant +right-stats+ 32)
(defconstant +right-boot+ 64)
(defconstant +right-log+ 128)
(defconstant +all-rights+ 255)
(defconstant +stopped+ 2)
(defconstant +paused+ 4)
(defconstant +gone+ 8)
(defconstant +commpage-va+ #x00007FFFFFE00000)

(define-global world-0-map :u8 :count 27208 :alignment 4096)
(define-global kernel-map :u8 :count 27168 :alignment 4096)
(define-global io-next :u64)

(define-low page-down (a) (logand a (lognot (- +page-size+ 1))))

(define-low page-up (a) (logand (+ a +page-size+ -1) (lognot (- +page-size+ 1))))

(define-low world-0 () (address world-0-map))

(define-low map-for (va) (if (>= va +user-top+) (address kernel-map) (current-world)))

(define-low entry (m i) (+ m +w-entries+ (* 24 i)))

(define-low count-of (m) (mem :u64 (+ m +w-nentries+)))

(define-low copy-entry (m to from)
  (setf (mem :u64 (entry m to)) (mem :u64 (entry m from)))
  (setf (mem :u64 (+ (entry m to) 8)) (mem :u64 (+ (entry m from) 8)))
  (setf (mem :u64 (+ (entry m to) 16)) (mem :u64 (+ (entry m from) 16))))

(define-low insert-at (m i start end prot)
  (when (= (count-of m) +max-entries+) (panic "vm_map: out of entries"))
  (let ((j (count-of m)))
    (while (> j i)
      (copy-entry m j (- j 1))
      (decf j)))
  (setf (mem :u64 (entry m i)) start)
  (setf (mem :u64 (+ (entry m i) 8)) end)
  (setf (mem :u64 (+ (entry m i) 16)) prot)
  (setf (mem :u64 (+ m +w-nentries+)) (+ (count-of m) 1)))

(define-low delete-at (m i)
  (let ((j i))
    (while (< (+ j 1) (count-of m))
      (copy-entry m j (+ j 1))
      (incf j)))
  (setf (mem :u64 (+ m +w-nentries+)) (- (count-of m) 1)))

(define-low clip (m at)
  (let ((i 0))
    (while (< i (count-of m))
      (let ((e (entry m i)))
        (when (and (< (mem :u64 e) at) (< at (mem :u64 (+ e 8))))
          (insert-at m (+ i 1) at (mem :u64 (+ e 8)) (mem :u64 (+ e 16)))
          (setf (mem :u64 (+ e 8)) at)
          (result 0)))
      (incf i))))

(define-low vm-map-remove (start len)
  (let ((m (map-for start))
        (s (page-down start))
        (e (page-up (+ start len)))
        (i 0))
    (clip m s)
    (clip m e)
    (while (< i (count-of m))
      (let ((x (entry m i)))
        (if (and (>= (mem :u64 x) s) (<= (mem :u64 (+ x 8)) e))
            (progn
              (pmap-remove (mem :u64 x) (- (mem :u64 (+ x 8)) (mem :u64 x)))
              (delete-at m i))
            (incf i))))))

(define-low vm-map-reset (keep len)
  (let ((m (current-world))
        (s (page-down keep))
        (e (page-up (+ keep len)))
        (i 0))
    (clip m s)
    (clip m e)
    (while (< i (count-of m))
      (let ((x (entry m i)))
        (if (and (>= (mem :u64 x) s) (<= (mem :u64 (+ x 8)) e))
            (incf i)
            (progn
              (pmap-remove (mem :u64 x) (- (mem :u64 (+ x 8)) (mem :u64 x)))
              (delete-at m i)))))))

(define-low vm-map-enter (start len (prot :u32))
  (let ((m (map-for start))
        (s (page-down start))
        (e (page-up (+ start len)))
        (i 0))
    (vm-map-remove s (- e s))
    (while (and (< i (count-of m)) (< (mem :u64 (entry m i)) s)) (incf i))
    (insert-at m i s e prot)
    1))

(define-low vm-map-protect (start len (prot :u32))
  (let ((m (map-for start))
        (s (page-down start))
        (e (page-up (+ start len)))
        (i 0))
    (clip m s)
    (clip m e)
    (while (< i (count-of m))
      (let ((x (entry m i)))
        (when (and (>= (mem :u64 x) s) (<= (mem :u64 (+ x 8)) e))
          (setf (mem :u64 (+ x 16)) prot)))
      (incf i))
    (pmap-protect s (- e s) prot)))

(define-low vm-map-find-space (len)
  (let* ((m (current-world))
         (at (mem :u64 (+ m +w-mmap-next+))))
    (when (= at 0) (setf at +user-mmap-base+))
    (setf (mem :u64 (+ m +w-mmap-next+)) (+ at (page-up len) +page-size+))
    at))

(define-low lookup (m va)
  (let ((i 0))
    (while (< i (count-of m))
      (let ((x (entry m i)))
        (when (and (<= (mem :u64 x) va) (< va (mem :u64 (+ x 8))))
          (result x)))
      (incf i))
    0))

(define-low rights-of (w)
  (mem :u64 (+ w +w-rights+)))

(define-low has-rights (needed)
  (= (logand (rights-of (current-world)) needed) needed))

(define-low privileged ()
  (has-rights +right-physmap+))

(define-low physmap-world-p (w)
  (logand (rights-of w) +right-physmap+))

(define-low user-range (a len)
  (and (< a +user-top+) (<= len +user-top+) (<= (+ a len) +user-top+)))

(define-low user-ok (a len (write :u32))
  (when (privileged) (result 1))
  (unless (user-range a len) (result 0))
  (let ((p (page-down a)))
    (while (< p (+ a len))
      (unless (the :u32 (vm-fault p (logior 4 (if write 2 0)))) (result 0))
      (incf p +page-size+)))
  1)

(define-low vm-fault (va err)
  (when (and (>= va +user-top+) (logand err 4) (not (privileged))) (result 0))
  (when (the :u32 (pmap-access-ok (page-down va) err)) (result 1))
  (let ((x (lookup (map-for va) va)))
    (when (and x (logand err 2) (logand (mem :u64 (+ x 16)) +prot-write+) (< va +user-top+))
      (when (the :u32 (cow-fault va (mem :u64 (+ x 16)))) (result 1)))
    (when (or (not x) (logand err 1) (not (mem :u64 (+ x 16)))) (result 0))
    (when (and (logand err 2) (not (logand (mem :u64 (+ x 16)) +prot-write+))) (result 0))
    (when (and (logand err #x10) (not (logand (mem :u64 (+ x 16)) +prot-execute+))) (result 0))
    (when (pmap-find-phys va) (result 0))
    (let ((pa (vm-page-grab)))
      (when (= pa 0) (result 0))
      (rep-stosb (+ pa +physmap-base+) 0 +page-size+)
      (pmap-enter (page-down va) pa (mem :u64 (+ x 16)))
      1)))

(define-low world-create ()
  (let ((w (kalloc +world-size+))
        (pml4 (pmap-create)))
    (when (= pml4 0) (result 0))
    (rep-stosb w 0 +world-size+)
    (setf (mem :u64 (+ w +w-pml4+)) pml4)
    (setf next-world-id (+ next-world-id 1))
    (setf (mem :u64 (+ w +w-id+)) next-world-id)
    (setf (mem :u64 (+ w +w-next+)) (mem :u64 (+ (world-0) +w-next+)))
    (setf (mem :u64 (+ (world-0) +w-next+)) w)
    w))

(define-low io-map (pa size wcomb)
  (when (= io-next 0) (setf io-next +io-map-base+))
  (let* ((offset (logand pa (- +page-size+ 1)))
         (base (page-down pa))
         (len (page-up (+ size offset)))
         (va io-next)
         (off 0))
    (incf io-next len)
    (while (< off len)
      (pmap-enter-io (+ va off) (+ base off) wcomb)
      (incf off +page-size+))
    (+ va offset)))

(define-low ml-io-map (pa size) (io-map pa size 0))

(define-low ml-io-map-wcomb (pa size) (io-map pa size 1))
