(defpackage #:darterfly/link
  (:use #:cl)
  (:export #:read-object #:link-kernel))
(in-package #:darterfly/link)

(defun u (v at n) (loop :for i :below n :sum (ash (aref v (+ at i)) (* 8 i))))

(defun put (v at value n)
  (dotimes (i n v) (setf (aref v (+ at i)) (ldb (byte 8 (* 8 i)) value))))

(defun octets (n) (make-array n :element-type '(unsigned-byte 8) :initial-element 0))

(defun align (n to) (if (<= to 1) n (* to (ceiling n to))))

(defun c-string (v at)
  (let ((end (position 0 v :start at)))
    (map 'string #'code-char (subseq v at end))))

(defstruct section name kind data size alignment object (address 0) relocations tls)
(defstruct sym name binding section value object)
(defstruct object name sections symbols region)

(defun classify (name type flags)
  (cond ((logtest flags #x400) (if (= type 8) :tbss :tdata))
        ((not (logtest flags 2)) nil)
        ((= type 8) :bss)
        ((logtest flags 4) :text)
        ((logtest flags 1) :data)
        ((or (string= name ".rodata") (uiop:string-prefix-p ".rodata." name)) :rodata)
        (t :rodata)))

(defun read-object (octets name region)
  (let* ((shoff (u octets 40 8))
         (shnum (u octets 60 2))
         (shstrndx (u octets 62 2))
         (headers (loop :for i :below shnum
                        :collect (let ((h (+ shoff (* 64 i))))
                                   (list :name (u octets h 4) :type (u octets (+ h 4) 4) :flags (u octets (+ h 8) 8)
                                         :offset (u octets (+ h 24) 8) :size (u octets (+ h 32) 8)
                                         :link (u octets (+ h 40) 4) :info (u octets (+ h 44) 4)
                                         :alignment (u octets (+ h 48) 8)))))
         (names (getf (nth shstrndx headers) :offset))
         (object (make-object :name name :region region))
         (sections (make-array shnum :initial-element nil)))
    (loop :for h :in headers :for i :from 0
          :for sname := (c-string octets (+ names (getf h :name)))
          :for kind := (and (member (getf h :type) '(1 8 14 15)) (classify sname (getf h :type) (getf h :flags)))
          :when kind
            :do (setf (aref sections i)
                      (make-section :name sname :kind kind :size (getf h :size)
                                    :alignment (max 1 (getf h :alignment)) :object object
                                    :tls (member kind '(:tdata :tbss))
                                    :data (if (= (getf h :type) 8)
                                              nil
                                              (subseq octets (getf h :offset) (+ (getf h :offset) (getf h :size)))))))
    (let* ((symtab (find 2 headers :key (lambda (h) (getf h :type))))
           (strings (getf (nth (getf symtab :link) headers) :offset))
           (symbols (loop :for at :from (getf symtab :offset) :below (+ (getf symtab :offset) (getf symtab :size)) :by 24
                          :collect (let ((shndx (u octets (+ at 6) 2)))
                                     (make-sym :name (c-string octets (+ strings (u octets at 4)))
                                                  :binding (ash (aref octets (+ at 4)) -4)
                                                  :section (cond ((= shndx 0) :undefined)
                                                                 ((= shndx #xFFF1) :absolute)
                                                                 ((< shndx shnum) (aref sections shndx)))
                                                  :value (u octets (+ at 8) 8)
                                                  :object object)))))
      (setf (object-symbols object) (coerce symbols 'vector))
      (loop :for h :in headers
            :when (= (getf h :type) 4)
              :do (let ((target (aref sections (getf h :info))))
                    (when target
                      (setf (section-relocations target)
                            (loop :for at :from (getf h :offset) :below (+ (getf h :offset) (getf h :size)) :by 24
                                  :collect (list (u octets at 8)
                                                 (aref (object-symbols object) (ash (u octets (+ at 8) 8) -32))
                                                 (ldb (byte 32 0) (u octets (+ at 8) 8))
                                                 (let ((a (u octets (+ at 16) 8))) (if (logbitp 63 a) (- a (ash 1 64)) a))))))))
      (setf (object-sections object) (remove nil (coerce sections 'list)))
      object)))

(defparameter +order+ '(:text :rodata :data :got :tdata :tbss :bss))

(defstruct image region base sections got got-slots tls-start tls-end tls-align segments)

(defun lay-out (region base objects)
  (let* ((image (make-image :region region :base base :got-slots (make-hash-table :test 'equal)))
         (at base)
         (by-kind (make-hash-table)))
    (dolist (o objects)
      (dolist (s (object-sections o))
        (push s (gethash (section-kind-of s) by-kind))))
    (dolist (o objects)
      (dolist (s (object-sections o))
        (dolist (r (section-relocations s))
          (when (member (third r) '(9 41 42 22))
            (let ((key (got-key (second r) (third r))))
              (unless (gethash key (image-got-slots image))
                (setf (gethash key (image-got-slots image)) (hash-table-count (image-got-slots image)))))))))
    (dolist (kind +order+)
      (when (eq kind :data) (setf at (align at 4096)))
      (let ((start at))
        (if (eq kind :got)
            (progn
              (setf at (align at 8))
              (setf (image-got image) at)
              (incf at (* 8 (hash-table-count (image-got-slots image)))))
            (dolist (s (reverse (gethash kind by-kind)))
              (setf at (align at (section-alignment s)))
              (setf (section-address s) at)
              (incf at (section-size s))
              (push s (image-sections image))))
        (when (eq kind :tdata) (setf (image-tls-start image) start))
        (when (eq kind :tbss) (setf (image-tls-end image) at))
        (push (list kind start at) (image-segments image))))
    (setf (image-tls-align image)
          (reduce #'max (append (gethash :tdata by-kind) (gethash :tbss by-kind))
                  :key #'section-alignment :initial-value 1))
    (setf (image-sections image) (nreverse (image-sections image))
          (image-segments image) (nreverse (image-segments image)))
    image))

(defun section-kind-of (s) (section-kind s))

(defun got-key (symbol type)
  (list (sym-name symbol) (sym-object symbol) (if (= type 22) :tls :address)))

(defun define (table name value)
  (setf (gethash name table) value))

(defun symbol-address (symbol globals)
  (let ((s (sym-section symbol)))
    (cond ((eq s :absolute) (sym-value symbol))
          ((section-p s) (+ (section-address s) (sym-value symbol)))
          ((gethash (sym-name symbol) globals))
          ((= (sym-binding symbol) 2) 0)
          (t (error "link: ~a is undefined (from ~a)" (sym-name symbol) (object-name (sym-object symbol)))))))

(defun globals-of (objects)
  (let ((table (make-hash-table :test 'equal))
        (weak (make-hash-table :test 'equal)))
    (dolist (o objects table)
      (loop :for sym :across (object-symbols o)
            :when (and (section-p (sym-section sym)) (/= (sym-binding sym) 0) (plusp (length (sym-name sym))))
              :do (let ((name (sym-name sym))
                        (address (+ (section-address (sym-section sym)) (sym-value sym))))
                    (cond ((not (gethash name table))
                           (setf (gethash name table) address)
                           (when (= (sym-binding sym) 2) (setf (gethash name weak) t)))
                          ((= (sym-binding sym) 2))
                          ((gethash name weak)
                           (setf (gethash name table) address)
                           (remhash name weak))
                          (t (error "link: ~a is defined twice" name))))))))

(defun tpoff (address image)
  (- address (+ (image-tls-start image)
                (align (- (image-tls-end image) (image-tls-start image)) (image-tls-align image)))))

(defun relocate (image globals tls-image)
  (let ((got (octets (* 8 (hash-table-count (image-got-slots image))))))
    (maphash (lambda (key slot)
               (destructuring-bind (name object kind) key
                 (let* ((sym (find name (object-symbols object) :key #'sym-name :test #'string=))
                        (address (symbol-address sym globals)))
                   (put got (* 8 slot) (ldb (byte 64 0) (if (eq kind :tls) (tpoff address tls-image) address)) 8))))
             (image-got-slots image))
    (dolist (s (image-sections image))
      (when (section-data s)
        (setf (section-data s) (copy-seq (section-data s)))
        (dolist (r (section-relocations s))
          (destructuring-bind (offset sym type addend) r
            (let* ((p (+ (section-address s) offset))
                   (address (symbol-address sym globals)))
              (flet ((put32 (value)
                       (unless (<= (- (ash 1 31)) value (1- (ash 1 32)))
                         (error "link: relocation ~d to ~a at ~x overflows" type (sym-name sym) p))
                       (put (section-data s) offset (ldb (byte 32 0) value) 4))
                     (slot () (+ (image-got image) (* 8 (gethash (got-key sym type) (image-got-slots image))))))
                (ecase type
                  ((2 4) (put32 (- (+ address addend) p)))
                  (1 (put (section-data s) offset (ldb (byte 64 0) (+ address addend)) 8))
                  ((10 11) (put32 (+ address addend)))
                  ((9 41 42 22) (put32 (- (+ (slot) addend) p)))
                  (23 (put32 (+ (tpoff address tls-image) addend))))))))))
    got))

(defun link-kernel (kernel-objects user-objects &key (kernel-base #xFFFFFFFF80000000) (user-base #x0000100000000000)
                                                     (entry "_start") (keep '("_start")))
  (let* ((kernel (lay-out :kernel kernel-base kernel-objects))
         (user (lay-out :user user-base user-objects))
         (user-globals (globals-of user-objects))
         (kernel-globals (globals-of kernel-objects)))
    (define user-globals "__tdata_start" (image-tls-start user))
    (define user-globals "__tdata_end" (third (find :tdata (image-segments user) :key #'first)))
    (define user-globals "__tbss_start" (second (find :tbss (image-segments user) :key #'first)))
    (define user-globals "__tbss_end" (image-tls-end user))
    (define user-globals "__tls_align" (image-tls-align user))
    (maphash (lambda (k v) (unless (gethash k kernel-globals) (setf (gethash k kernel-globals) v))) user-globals)
    (let ((user-got (relocate user user-globals user))
          (kernel-got (relocate kernel kernel-globals user)))
      (write-executable kernel user kernel-got user-got
                        (gethash entry kernel-globals)
                        (append (loop :for name :in keep :collect (list name (gethash name kernel-globals) 1))
                                (symbols-of user-objects))))))

(defun symbols-of (objects)
  (loop :for o :in objects
        :nconc (loop :for sym :across (object-symbols o)
                     :when (and (section-p (sym-section sym)) (plusp (length (sym-name sym)))
                                (not (section-tls (sym-section sym))))
                       :collect (list (sym-name sym)
                                      (+ (section-address (sym-section sym)) (sym-value sym))
                                      (if (/= (sym-binding sym) 0) 1 0)))))

(defun segment-bytes (image got kinds)
  (let* ((start (second (find (first kinds) (image-segments image) :key #'first)))
         (end (third (find (car (last kinds)) (image-segments image) :key #'first)))
         (out (octets (- end start))))
    (dolist (s (image-sections image))
      (when (and (member (section-kind s) kinds) (section-data s))
        (replace out (section-data s) :start1 (- (section-address s) start))))
    (when (and (member :got kinds) (plusp (length got)))
      (replace out got :start1 (- (image-got image) start)))
    (values out start end)))

(defun write-executable (kernel user kernel-got user-got entry symbols)
  (let* ((loads (list (list kernel kernel-got '(:text :rodata) 5)
                      (list kernel kernel-got '(:data :got :tdata) 6)
                      (list user user-got '(:text :rodata) 5)
                      (list user user-got '(:data :got :tdata) 6)))
         (bss (list kernel user))
         (phnum (+ (count-if (lambda (l) (plusp (length (segment-bytes (first l) (second l) (third l))))) loads)
                   (length bss) 1))
         (at (align (+ 64 (* 56 phnum)) 4096))
         (blobs nil)
         (phdrs nil))
    (dolist (image bss)
      (loop :for (owner got kinds flags) :in loads
            :when (eq owner image)
              :do (multiple-value-bind (bytes start end) (segment-bytes owner got kinds)
                    (when (plusp (length bytes))
                      (setf at (+ (align at 4096) (mod start 4096)))
                      (push (list at bytes) blobs)
                      (push (list 1 flags at start (- end start) (- end start)) phdrs)
                      (incf at (length bytes)))))
      (let* ((tbss (find :tbss (image-segments image) :key #'first))
             (b (find :bss (image-segments image) :key #'first))
             (start (second tbss)) (end (third b)))
        (push (list 1 6 at start 0 (- end start)) phdrs)))
    (push (list 7 4 at (image-tls-start user) (- (third (find :tdata (image-segments user) :key #'first)) (image-tls-start user))
                (- (image-tls-end user) (image-tls-start user)) (image-tls-align user))
          phdrs)
    (setf phdrs (nreverse phdrs))
    (multiple-value-bind (strtab names) (strings (mapcar #'first symbols))
      (multiple-value-bind (shstrtab shnames) (strings '(".symtab" ".strtab" ".shstrtab"))
        (let* ((ordered (append (remove-if-not (lambda (s) (= (third s) 0)) symbols)
                                (remove-if-not (lambda (s) (= (third s) 1)) symbols)))
               (locals (1+ (count 0 symbols :key #'third)))
               (symtab (octets (* 24 (1+ (length ordered)))))
               (symtab-at (align at 8))
               (strtab-at (+ symtab-at (length symtab)))
               (shstrtab-at (+ strtab-at (length strtab)))
               (shoff (align (+ shstrtab-at (length shstrtab)) 8))
               (out (octets (+ shoff (* 64 4)))))
          (loop :for (name value global) :in ordered :for i :from 1
                :do (let ((e (* 24 i)))
                      (put symtab e (gethash name names) 4)
                      (setf (aref symtab (+ e 4)) (if (= global 1) #x10 0))
                      (put symtab (+ e 6) #xFFF1 2)
                      (put symtab (+ e 8) value 8)))
          (replace out #(#x7F #x45 #x4C #x46 2 1 1))
          (put out 16 2 2) (put out 18 62 2) (put out 20 1 4) (put out 24 entry 8) (put out 32 64 8)
          (put out 40 shoff 8) (put out 52 64 2) (put out 54 56 2) (put out 56 phnum 2)
          (put out 58 64 2) (put out 60 4 2) (put out 62 3 2)
          (loop :for (type flags offset address filesz memsz alignment) :in phdrs :for i :from 0
                :do (let ((h (+ 64 (* 56 i))))
                      (put out h type 4) (put out (+ h 4) flags 4) (put out (+ h 8) offset 8)
                      (put out (+ h 16) address 8) (put out (+ h 24) address 8)
                      (put out (+ h 32) filesz 8) (put out (+ h 40) memsz 8) (put out (+ h 48) (or alignment 4096) 8)))
          (dolist (b blobs) (replace out (second b) :start1 (first b)))
          (replace out symtab :start1 symtab-at)
          (replace out strtab :start1 strtab-at)
          (replace out shstrtab :start1 shstrtab-at)
          (flet ((section (i name type offset size &key (link 0) (info 0) (entsize 0))
                   (let ((h (+ shoff (* 64 i))))
                     (put out h (gethash name shnames) 4) (put out (+ h 4) type 4)
                     (put out (+ h 24) offset 8) (put out (+ h 32) size 8)
                     (put out (+ h 40) link 4) (put out (+ h 44) info 4) (put out (+ h 48) 8 8) (put out (+ h 56) entsize 8))))
            (section 1 ".symtab" 2 symtab-at (length symtab) :link 2 :info locals :entsize 24)
            (section 2 ".strtab" 3 strtab-at (length strtab))
            (section 3 ".shstrtab" 3 shstrtab-at (length shstrtab)))
          out)))))

(defun strings (names)
  (let ((table (make-array 1 :element-type '(unsigned-byte 8) :fill-pointer 1 :adjustable t :initial-element 0))
        (at (make-hash-table :test 'equal)))
    (dolist (name names)
      (unless (gethash name at)
        (setf (gethash name at) (fill-pointer table))
        (loop :for c :across (sb-ext:string-to-octets name) :do (vector-push-extend c table))
        (vector-push-extend 0 table)))
    (values (coerce table '(simple-array (unsigned-byte 8) (*))) at)))
