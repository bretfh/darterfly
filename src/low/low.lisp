(defpackage #:finch/low
  (:use #:cl #:finch/asm)
  (:shadow #:compile)
  (:export #:define-low #:define-global #:low-object #:inb #:outb #:ref #:mem #:pause #:result #:while
           #:package-object #:shl #:shr #:rdmsr #:wrmsr #:wbinvd #:cli #:sti #:hlt #:address
           #:rep-movsb #:rep-stosb #:&va #:va-next #:rdtsc #:return-address
           #:invlpg #:set-cr3 #:cpuid-edx #:cpuid #:cpu-data #:fxsave #:fxrstor #:code-address #:call-pointer #:read-cr #:set-cr #:fninit #:compare-and-swap #:rdrand #:int3 #:build-date #:*build-date* #:lidt #:ltr
           #:efi-call #:wide #:define-efi-entry #:package-image
           #:signed< #:signed<= #:signed> #:signed>= #:sar #:sign-extend #:signed-truncate #:signed-rem))
(in-package #:finch/low)

(defvar *functions* (make-hash-table :test 'equal))
(defvar *globals* (make-hash-table :test 'equal))

(defstruct global name type count alignment extern export package)
(defstruct low-function name args body package abi)

(defun c-name (symbol)
  (let ((name (symbol-name symbol)))
    (if (string= name (string-upcase name))
        (substitute #\_ #\- (string-downcase name))
        name)))

(defmacro define-global (name type &key (count 1) (alignment 8) extern export)
  `(let ((existing (gethash (c-name ',name) *globals*)))
     (unless (and ,extern existing (not (global-extern existing)))
       (setf (gethash (c-name ',name) *globals*)
             (make-global :name (c-name ',name) :type ',type :count ,count :alignment ,alignment
                          :extern ,extern :export ,export :package (package-name *package*))))))

(defmacro define-efi-entry (name args &body body)
  `(setf (gethash (c-name ',name) *functions*)
         (make-low-function :name (c-name ',name) :args ',args :body ',body :package (package-name *package*) :abi :ms)))

(defmacro define-low (name args &body body)
  `(setf (gethash (c-name ',name) *functions*)
         (make-low-function :name (c-name ',name) :args ',args :body ',body :package (package-name *package*))))

(defun width (type) (ecase type (:u8 1) (:u16 2) (:u32 4) (:u64 8)))

(defconstant +frame+ 512)
(defconstant +locals-limit+ -256)
(defconstant +save-area+ -512)
(defconstant +va-list+ -448)
(defconstant +ms-saves+ -264)
(defconstant +efi-rsp+ -296)

(defvar *locals*)
(defvar *exit*)
(defvar *depth* 0)

(defun spush (r) (inst push r) (incf *depth*))
(defun spop (r) (inst pop r) (decf *depth*))

(defun pad-for-call (stacked)
  (if (oddp (+ *depth* stacked))
      (progn (inst sub rsp-tn 8) (incf *depth*) 1)
      0))

(defun unwind-call (stacked pad)
  (when (plusp (+ stacked pad))
    (inst add rsp-tn (* 8 (+ stacked pad)))
    (decf *depth* (+ stacked pad))))
(defvar *build-date* "")
(defvar *strings*)

(defun global-of (symbol) (gethash (c-name symbol) *globals*))

(defun local-of (symbol) (cdr (assoc symbol *locals*)))

(defun load-into-rax (type)
  (ecase type
    (:u8 (inst movzx '(:byte :dword) (reg :dword 0) (ea 0 rax-tn)))
    (:u16 (inst movzx '(:word :dword) (reg :dword 0) (ea 0 rax-tn)))
    (:u32 (inst mov :dword (reg :dword 0) (ea 0 rax-tn)))
    (:u64 (inst mov rax-tn (ea 0 rax-tn)))))

(defun store-rcx-at-rax (type)
  (ecase type
    (:u8 (inst mov :byte (ea 0 rax-tn) (reg :byte 1)))
    (:u16 (inst mov :word (ea 0 rax-tn) (reg :word 1)))
    (:u32 (inst mov :dword (ea 0 rax-tn) (reg :dword 1)))
    (:u64 (inst mov (ea 0 rax-tn) rcx-tn))))

(defun address-of (place)
  (if (symbolp place)
      (let ((g (global-of place)))
        (unless g (error "~s is not a global" place))
        (inst lea rax-tn (data (global-name g)))
        (global-type g))
      (destructuring-bind (op target index) place
        (ecase (or (find-symbol (symbol-name op) '#:finch/low) op)
          (mem (compile index)
               target)
          (ref (let ((g (global-of target)))
                 (unless g (error "~s is not a global" target))
                 (compile index)
                 (spush rax-tn)
                 (inst lea rax-tn (data (global-name g)))
                 (spop rcx-tn)
                 (inst lea rax-tn (ea 0 rax-tn rcx-tn (width (global-type g))))
                 (global-type g)))))))

(defun binary (op a b)
  (compile b)
  (spush rax-tn)
  (compile a)
  (spop rcx-tn)
  (ecase op
    (+ (inst add rax-tn rcx-tn))
    (- (inst sub rax-tn rcx-tn))
    (logand (inst and rax-tn rcx-tn))
    (logior (inst or rax-tn rcx-tn))
    (logxor (inst xor rax-tn rcx-tn))
    (* (inst imul rax-tn rcx-tn))))

(defun comparison (op a b)
  (compile b)
  (spush rax-tn)
  (compile a)
  (spop rcx-tn)
  (inst cmp rax-tn rcx-tn)
  (inst set (ecase op (= :e) (/= :ne) (< :b) (<= :be) (> :a) (>= :ae)) (reg :byte 0))
  (inst movzx '(:byte :dword) (reg :dword 0) (reg :byte 0)))

(defun branch-false (test label)
  (compile test)
  (inst test rax-tn rax-tn)
  (inst jmp :z label))

(defun compile-body (forms)
  (if forms (mapc #'compile forms) (inst xor :dword (reg :dword 0) (reg :dword 0))))

(defparameter +argument-registers+ (list rdi-tn rsi-tn rdx-tn rcx-tn r8-tn r9-tn))

(defun compile (form)
  (cond ((integerp form) (inst mov rax-tn form))
        ((stringp form)
         (let ((label (sb-assem:gen-label)))
           (push (cons label (sb-ext:string-to-octets form :null-terminate t)) *strings*)
           (inst lea rax-tn (rip-relative-ea label))))
        ((vectorp form)
         (let ((label (sb-assem:gen-label)))
           (push (cons label (coerce form '(simple-array (unsigned-byte 8) (*)))) *strings*)
           (inst lea rax-tn (rip-relative-ea label))))
        ((null form) (inst xor :dword (reg :dword 0) (reg :dword 0)))
        ((eq form t) (inst mov rax-tn 1))
        ((and (symbolp form) (not (local-of form)) (constantp form)) (compile (symbol-value form)))
        ((symbolp form)
         (let ((at (local-of form)))
           (if at
               (inst mov rax-tn (ea at rbp-tn))
               (let ((type (address-of form))) (load-into-rax type)))))
        (t
         (destructuring-bind (op &rest args) form
           (case (or (find-symbol (symbol-name op) '#:finch/low) op)
             ((+ - logand logior logxor *)
              (if (cddr args)
                  (compile `(,op (,op ,(first args) ,(second args)) ,@(cddr args)))
                  (binary op (first args) (second args))))
             ((= /= < <= > >=) (comparison op (first args) (second args)))
             ((signed< signed<= signed> signed>=)
              (compile (second args))
              (spush rax-tn)
              (compile (first args))
              (spop rcx-tn)
              (inst cmp rax-tn rcx-tn)
              (inst set (ecase (find-symbol (symbol-name op) '#:finch/low)
                          (signed< :l) (signed<= :le) (signed> :g) (signed>= :ge))
                    (reg :byte 0))
              (inst movzx '(:byte :dword) (reg :dword 0) (reg :byte 0)))
             (sar (compile (second args))
                  (spush rax-tn)
                  (compile (first args))
                  (spop rcx-tn)
                  (inst sar rax-tn :cl))
             (sign-extend (compile (second args))
                          (ecase (first args)
                            (:u8 (inst movsx '(:byte :qword) rax-tn (reg :byte 0)))
                            (:u16 (inst movsx '(:word :qword) rax-tn (reg :word 0)))
                            (:u32 (inst movsx '(:dword :qword) rax-tn (reg :dword 0)))))
             ((signed-truncate signed-rem)
              (compile (second args))
              (spush rax-tn)
              (compile (first args))
              (spop rcx-tn)
              (inst cqo)
              (inst idiv rcx-tn)
              (when (eq (find-symbol (symbol-name op) '#:finch/low) 'signed-rem) (inst mov rax-tn rdx-tn)))
             (not (compile (first args))
                  (inst test rax-tn rax-tn)
                  (inst set :e (reg :byte 0))
                  (inst movzx '(:byte :dword) (reg :dword 0) (reg :byte 0)))
             (and (let ((false (sb-assem:gen-label)) (done (sb-assem:gen-label)))
                    (dolist (a (butlast args)) (branch-false a false))
                    (compile (car (last args)))
                    (inst jmp done)
                    (sb-assem::emit-label false)
                    (inst xor :dword (reg :dword 0) (reg :dword 0))
                    (sb-assem::emit-label done)))
             (or (let ((true (sb-assem:gen-label)))
                   (dolist (a args)
                     (compile a)
                     (inst test rax-tn rax-tn)
                     (inst jmp :nz true))
                   (sb-assem::emit-label true)))
             (ash (compile (first args))
                  (let ((n (second args)))
                    (if (minusp n) (inst shr rax-tn (- n)) (inst shl rax-tn n))))
             (progn (compile-body args))
             (if (let ((else (sb-assem:gen-label)) (done (sb-assem:gen-label)))
                   (branch-false (first args) else)
                   (compile (second args))
                   (inst jmp done)
                   (sb-assem::emit-label else)
                   (compile (third args))
                   (sb-assem::emit-label done)))
             (when (compile `(if ,(first args) (progn ,@(rest args)) nil)))
             (unless (compile `(if ,(first args) nil (progn ,@(rest args)))))
             (cond (compile (reduce (lambda (clause rest) `(if ,(first clause) (progn ,@(rest clause)) ,rest))
                                    args :from-end t :initial-value nil)))
             (while (let ((top (sb-assem:gen-label)) (done (sb-assem:gen-label)))
                      (sb-assem::emit-label top)
                      (branch-false (first args) done)
                      (compile-body (rest args))
                      (inst jmp top)
                      (sb-assem::emit-label done)))
             ((let let*) (let ((*locals* *locals*))
                    (dolist (binding (first args))
                      (destructuring-bind (name value) binding
                        (compile value)
                        (let ((at (- (* 8 (1+ (length *locals*))))))
                          (when (< at +locals-limit+) (error "too many locals"))
                          (inst mov (ea at rbp-tn) rax-tn)
                          (push (cons name at) *locals*))))
                    (compile-body (rest args))))
             (setf (destructuring-bind (place value) args
                     (let ((at (and (symbolp place) (local-of place))))
                       (compile value)
                       (if at
                           (inst mov (ea at rbp-tn) rax-tn)
                           (progn
                             (spush rax-tn)
                             (let ((type (address-of place)))
                               (spop rcx-tn)
                               (store-rcx-at-rax type)
                               (inst mov rax-tn rcx-tn)))))))
             (incf (compile `(setf ,(first args) (+ ,(first args) ,(or (second args) 1)))))
             (decf (compile `(setf ,(first args) (- ,(first args) ,(or (second args) 1)))))
             ((ref mem) (load-into-rax (address-of form)))
             (lognot (compile (first args)) (inst not rax-tn))
             (wide (let ((label (sb-assem:gen-label)))
                     (push (cons label (sb-ext:string-to-octets (first args) :external-format :utf-16le :null-terminate t))
                           *strings*)
                     (inst lea rax-tn (rip-relative-ea label))))
             (efi-call (let ((n (length (rest args))))
                         (dolist (a (reverse (rest args)))
                           (compile a)
                           (spush rax-tn))
                         (compile (first args))
                         (spush rax-tn)
                         (inst mov r11-tn rsp-tn)
                         (inst mov (ea +efi-rsp+ rbp-tn) r11-tn)
                         (inst sub rsp-tn (+ 32 (* 8 (max 0 (- n 4)))))
                         (inst and rsp-tn -16)
                         (loop :for i :from 5 :to n
                               :do (inst mov rax-tn (ea (* 8 i) r11-tn))
                                   (inst mov (ea (+ 32 (* 8 (- i 5))) rsp-tn) rax-tn))
                         (loop :for r :in (list rcx-tn rdx-tn r8-tn r9-tn) :for i :from 1 :to (min n 4)
                               :do (inst mov r (ea (* 8 i) r11-tn)))
                         (inst mov rax-tn (ea 0 r11-tn))
                         (inst call rax-tn)
                         (inst mov rsp-tn (ea +efi-rsp+ rbp-tn))
                         (inst add rsp-tn (* 8 (1+ n)))
                         (decf *depth* (1+ n))))
             (address (let ((at (and (symbolp (first args)) (local-of (first args)))))
                        (when at
                          (inst lea rax-tn (ea at rbp-tn))
                          (return-from compile)))
                      (let ((g (global-of (first args))))
                        (unless g (error "~s is not a global" (first args)))
                        (inst lea rax-tn (data (global-name g)))))
             (the (compile (second args))
                  (ecase (first args)
                    (:u8 (inst movzx '(:byte :dword) (reg :dword 0) (reg :byte 0)))
                    (:u16 (inst movzx '(:word :dword) (reg :dword 0) (reg :word 0)))
                    (:u32 (inst mov :dword (reg :dword 0) (reg :dword 0)))
                    (:u64)))
             ((shl shr) (compile (second args))
                        (spush rax-tn)
                        (compile (first args))
                        (spop rcx-tn)
                        (if (eq (find-symbol (symbol-name op) '#:finch/low) 'shl)
                            (inst shl rax-tn :cl)
                            (inst shr rax-tn :cl)))
             (rdmsr (compile (first args))
                    (inst mov rcx-tn rax-tn)
                    (inst byte #x0F) (inst byte #x32)
                    (inst shl rdx-tn 32)
                    (inst mov :dword (reg :dword 0) (reg :dword 0))
                    (inst or rax-tn rdx-tn))
             (wrmsr (compile (second args))
                    (spush rax-tn)
                    (compile (first args))
                    (inst mov rcx-tn rax-tn)
                    (spop rax-tn)
                    (inst mov rdx-tn rax-tn)
                    (inst shr rdx-tn 32)
                    (inst byte #x0F) (inst byte #x30))
             (truncate (compile (second args))
                       (spush rax-tn)
                       (compile (first args))
                       (spop rcx-tn)
                       (inst xor :dword (reg :dword 2) (reg :dword 2))
                       (inst div rcx-tn))
             (rem (compile (second args))
                  (spush rax-tn)
                  (compile (first args))
                  (spop rcx-tn)
                  (inst xor :dword (reg :dword 2) (reg :dword 2))
                  (inst div rcx-tn)
                  (inst mov rax-tn rdx-tn))
             ((rep-movsb rep-stosb)
              (compile (third args)) (spush rax-tn)
              (compile (second args)) (spush rax-tn)
              (compile (first args))
              (inst mov rdi-tn rax-tn)
              (spop rax-tn)
              (inst mov rsi-tn rax-tn)
              (spop rcx-tn)
              (inst mov rax-tn rsi-tn)
              (inst byte #xF3)
              (inst byte (if (eq (find-symbol (symbol-name op) '#:finch/low) 'rep-movsb) #xA4 #xAA)))
             (wbinvd (inst byte #x0F) (inst byte #x09))
             (rdtsc (inst byte #x0F) (inst byte #x31)
                    (inst shl rdx-tn 32)
                    (inst mov :dword (reg :dword 0) (reg :dword 0))
                    (inst or rax-tn rdx-tn))
             (return-address (inst mov rax-tn (ea 8 rbp-tn)))
             (fxsave (compile (first args))
                     (dolist (b '(#x48 #x0F #xAE #x00)) (inst byte b)))
             (fxrstor (compile (first args))
                      (dolist (b '(#x48 #x0F #xAE #x08)) (inst byte b)))
             (code-address (inst lea rax-tn (data (if (stringp (first args)) (first args) (c-name (first args))))))
             (call-pointer (when (> (length (rest args)) 6) (error "call-pointer: more than six arguments"))
                           (let ((pad (pad-for-call 0)))
                             (dolist (a (reverse (rest args)))
                               (compile a)
                               (spush rax-tn))
                             (compile (first args))
                             (inst mov r11-tn rax-tn)
                             (loop :for r :in +argument-registers+ :repeat (length (rest args)) :do (spop r))
                             (inst xor :dword (reg :dword 0) (reg :dword 0))
                             (inst call r11-tn)
                             (unwind-call 0 pad)))
             (cpu-data (dolist (b '(#x65 #x48 #x8B #x04 #x25 0 0 0 0)) (inst byte b)))
             (invlpg (compile (first args))
                     (inst byte #x0F) (inst byte #x01) (inst byte #x38))
             (set-cr3 (compile (first args))
                      (inst byte #x0F) (inst byte #x22) (inst byte #xD8))
             (cpuid-edx (compile (first args))
                        (inst push rbx-tn)
                        (inst xor :dword (reg :dword 1) (reg :dword 1))
                        (inst byte #x0F) (inst byte #xA2)
                        (inst pop rbx-tn)
                        (inst mov :dword (reg :dword 0) (reg :dword 2)))
             (cpuid (compile (first args))
                    (inst push rbx-tn)
                    (inst xor :dword (reg :dword 1) (reg :dword 1))
                    (inst byte #x0F) (inst byte #xA2)
                    (ecase (second args)
                      (:eax)
                      (:ebx (inst mov :dword (reg :dword 0) (reg :dword 3)))
                      (:ecx (inst mov :dword (reg :dword 0) (reg :dword 1)))
                      (:edx (inst mov :dword (reg :dword 0) (reg :dword 2))))
                    (inst pop rbx-tn))
             (cli (inst byte #xFA))
             (sti (inst byte #xFB))
             (hlt (inst byte #xF4))
             (inb (compile (first args))
                  (inst mov rdx-tn rax-tn)
                  (in :byte)
                  (inst movzx '(:byte :dword) (reg :dword 0) (reg :byte 0)))
             (outb (compile (second args))
                   (spush rax-tn)
                   (compile (first args))
                   (inst mov rdx-tn rax-tn)
                   (spop rax-tn)
                   (out :byte))
             (pause (inst pause))
             (result (compile (first args)) (inst jmp *exit*))
             (set-cr (compile (second args))
                     (inst byte #x0F) (inst byte #x22)
                     (inst byte (ecase (first args) (0 #xC0) (3 #xD8) (4 #xE0))))
             (fninit (inst byte #xDB) (inst byte #xE3))
             (int3 (inst byte #xCC))
             (lidt (compile (first args))
                   (inst byte #x0F) (inst byte #x01) (inst byte #x18))
             (ltr (compile (first args))
                  (inst byte #x0F) (inst byte #x00) (inst byte #xD8))
             (build-date (compile *build-date*))
             (rdrand (compile (first args))
                     (inst mov rcx-tn rax-tn)
                     (dolist (b '(#x48 #x0F #xC7 #xF0)) (inst byte b))
                     (inst mov (ea 0 rcx-tn) rax-tn)
                     (inst set :c (reg :byte 0))
                     (inst movzx '(:byte :dword) (reg :dword 0) (reg :byte 0)))
             (compare-and-swap (compile (third args)) (spush rax-tn)
                               (compile (second args)) (spush rax-tn)
                               (compile (first args))
                               (inst mov rdx-tn rax-tn)
                               (spop rax-tn)
                               (spop rcx-tn)
                               (dolist (b '(#xF0 #x0F #xB1 #x0A)) (inst byte b))
                               (inst set :e (reg :byte 0))
                               (inst movzx '(:byte :dword) (reg :dword 0) (reg :byte 0)))
             (read-cr (inst byte #x0F) (inst byte #x20)
                      (inst byte (ecase (first args) (0 #xC0) (2 #xD0) (3 #xD8) (4 #xE0))))
             (t (let* ((stacked (max 0 (- (length args) 6)))
                       (pad (pad-for-call stacked)))
                  (dolist (a (reverse args))
                    (compile a)
                    (spush rax-tn))
                  (loop :for r :in +argument-registers+ :repeat (length args) :do (spop r))
                  (inst xor :dword (reg :dword 0) (reg :dword 0))
                  (inst call (external (c-name op)))
                  (unwind-call stacked pad))))))))


(defun function-routine (f)
  (let ((*locals* nil)
        (*strings* nil)
        (*depth* 0)
        (*exit* (sb-assem:gen-label)))
    (routine (low-function-name f)
      (inst push rbp-tn)
      (inst mov rbp-tn rsp-tn)
      (inst sub rsp-tn +frame+)
      (when (eq (low-function-abi f) :ms)
        (inst mov (ea +ms-saves+ rbp-tn) rdi-tn)
        (inst mov (ea (- +ms-saves+ 8) rbp-tn) rsi-tn)
        (inst mov (ea (- +ms-saves+ 16) rbp-tn) rbx-tn))
      (let* ((args (low-function-args f))
             (va (member '&va args :test (lambda (a b) (and (symbolp b) (string= (symbol-name a) (symbol-name b)))))))
        (when va
          (loop :for r :in +argument-registers+ :for i :from 0
                :do (inst mov (ea (+ +save-area+ (* 8 i)) rbp-tn) r))
          (inst mov :dword (ea +va-list+ rbp-tn) (* 8 (- (length args) (length va))))
          (inst mov :dword (ea (+ +va-list+ 4) rbp-tn) 176)
          (inst lea rax-tn (ea 16 rbp-tn))
          (inst mov (ea (+ +va-list+ 8) rbp-tn) rax-tn)
          (inst lea rax-tn (ea +save-area+ rbp-tn))
          (inst mov (ea (+ +va-list+ 16) rbp-tn) rax-tn)
          (inst lea rax-tn (ea +va-list+ rbp-tn))
          (let ((at (- (* 8 (1+ (length *locals*))))))
            (inst mov (ea at rbp-tn) rax-tn)
            (push (cons (second va) at) *locals*))))
      (loop :for arg :in (ldiff (low-function-args f)
                               (member '&va (low-function-args f)
                                       :test (lambda (a b) (and (symbolp b) (string= (symbol-name a) (symbol-name b))))))
            :for r :in (if (eq (low-function-abi f) :ms) (list rcx-tn rdx-tn r8-tn r9-tn) +argument-registers+)
            :do (destructuring-bind (name &optional (type :u64)) (if (listp arg) arg (list arg))
                  (let ((at (- (* 8 (1+ (length *locals*))))))
                    (inst mov rax-tn r)
                    (ecase type
                      (:u8 (inst movzx '(:byte :dword) (reg :dword 0) (reg :byte 0)))
                      (:u16 (inst movzx '(:word :dword) (reg :dword 0) (reg :word 0)))
                      (:u32 (inst mov :dword (reg :dword 0) (reg :dword 0)))
                      (:u64))
                    (inst mov (ea at rbp-tn) rax-tn)
                    (push (cons name at) *locals*))))
      (let* ((fixed (ldiff (low-function-args f)
                           (member '&va (low-function-args f)
                                   :test (lambda (a b) (and (symbolp b) (string= (symbol-name a) (symbol-name b)))))))
             (in-registers (if (eq (low-function-abi f) :ms) 4 6))
             (base (if (eq (low-function-abi f) :ms) 48 16)))
        (loop :for arg :in (nthcdr in-registers fixed)
              :for k :from 0
              :do (destructuring-bind (name &optional (type :u64)) (if (listp arg) arg (list arg))
                    (let ((at (- (* 8 (1+ (length *locals*))))))
                      (inst mov rax-tn (ea (+ base (* 8 k)) rbp-tn))
                      (ecase type
                        (:u8 (inst movzx '(:byte :dword) (reg :dword 0) (reg :byte 0)))
                        (:u16 (inst movzx '(:word :dword) (reg :dword 0) (reg :word 0)))
                        (:u32 (inst mov :dword (reg :dword 0) (reg :dword 0)))
                        (:u64))
                      (inst mov (ea at rbp-tn) rax-tn)
                      (push (cons name at) *locals*)))))
      (compile-body (low-function-body f))
      (sb-assem::emit-label *exit*)
      (when (eq (low-function-abi f) :ms)
        (inst mov rdi-tn (ea +ms-saves+ rbp-tn))
        (inst mov rsi-tn (ea (- +ms-saves+ 8) rbp-tn))
        (inst mov rbx-tn (ea (- +ms-saves+ 16) rbp-tn)))
      (inst mov rsp-tn rbp-tn)
      (inst pop rbp-tn)
      (inst ret)
      (loop :for (label . octets) :in *strings*
            :do (sb-assem::emit-label label)
                (loop :for b :across octets :do (inst byte b))))))

(defun package-object (package &key extra routines)
  (let ((names (append (loop :for f :being :the :hash-values :of *functions*
                             :when (string= (low-function-package f) package)
                               :collect (low-function-name f))
                       (copy-list extra))))
    (object (append routines (mapcar (lambda (n) (function-routine (gethash n *functions*))) (sort names #'string<)))
            :bss (loop :for g :being :the :hash-values :of *globals*
                       :when (and (not (global-extern g)) (string= (global-package g) package))
                         :collect (list (global-name g) (* (width (global-type g)) (global-count g))
                                        (global-alignment g) (global-export g))))))

(defun low-object (names)
  (let ((functions (mapcar (lambda (n) (or (gethash (c-name n) *functions*) (error "no low function ~s" n))) names))
        (package (package-name (symbol-package (first names)))))
    (object (mapcar #'function-routine functions)
            :bss (loop :for g :being :the :hash-values :of *globals*
                       :when (and (not (global-extern g)) (string= (global-package g) package))
                         :collect (list (global-name g) (* (width (global-type g)) (global-count g))
                                        (global-alignment g) (global-export g))))))

(define-low va-next (ap)
  (let ((gp (mem :u32 ap)))
    (if (< gp 48)
        (progn
          (setf (mem :u32 ap) (+ gp 8))
          (mem :u64 (+ (mem :u64 (+ ap 16)) gp)))
        (let ((p (mem :u64 (+ ap 8))))
          (setf (mem :u64 (+ ap 8)) (+ p 8))
          (mem :u64 p)))))

(defun package-image (package entry)
  (let ((names (sort (loop :for f :being :the :hash-values :of *functions*
                           :when (string= (low-function-package f) package)
                             :collect (low-function-name f))
                     #'string<)))
    (pe-image (mapcar (lambda (n) (function-routine (gethash n *functions*)))
                      (cons entry (remove entry names :test #'string=)))
              :bss (loop :for g :being :the :hash-values :of *globals*
                         :when (and (not (global-extern g)) (string= (global-package g) package))
                           :collect (list (global-name g) (* (width (global-type g)) (global-count g))
                                          (global-alignment g))))))
