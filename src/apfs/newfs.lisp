(in-package #:finch/apfs)

(defconstant +block-size+ 4096)

(defun put-u8 (v at x) (setf (aref v at) (ldb (byte 8 0) x)))
(defun put-u16 (v at x) (put-u8 v at x) (put-u8 v (1+ at) (ash x -8)))
(defun put-u32 (v at x) (put-u16 v at (ldb (byte 16 0) x)) (put-u16 v (+ at 2) (ldb (byte 16 16) x)))
(defun put-u64 (v at x) (put-u32 v at (ldb (byte 32 0) x)) (put-u32 v (+ at 4) (ldb (byte 32 32) x)))
(defun put-bytes (v at bytes) (replace v bytes :start1 at))

(defun parse-uuid (string)
  (let ((hex (remove #\- string)))
    (coerce (loop for i below 16 collect (parse-integer hex :start (* 2 i) :end (+ 2 (* 2 i)) :radix 16))
            '(vector (unsigned-byte 8)))))

(defun new-block () (make-array +block-size+ :element-type '(unsigned-byte 8) :initial-element 0))

(defun object-header (v oid xid type &optional (subtype 0))
  (put-u64 v 8 oid)
  (put-u64 v 16 xid)
  (put-u32 v 24 type)
  (put-u32 v 28 subtype)
  v)

(defun seal (v)
  (put-u64 v 0 (fletcher-64 v))
  v)

(defconstant +obj-physical+ #x40000000)
(defconstant +obj-ephemeral+ #x80000000)

(defun btree-node (oid xid type subtype records &key fixed (key-size 0) (value-size 0) info-flags leaf root (level 0)
                                                    (info-key-size key-size) (info-value-size value-size)
                                                    (key-count (length records)) (node-count 1)
                                                    (longest-key (reduce #'max records :key (lambda (r) (length (car r))) :initial-value 0))
                                                    (longest-value (reduce #'max records :key (lambda (r) (length (cdr r))) :initial-value 0)))
  (let* ((v (new-block))
         (n (length records))
         (end (- +block-size+ (if root 40 0)))
         (toc (toc-size fixed n (- end 56) key-size value-size))
         (keys (+ 56 toc))
         (key-at 0)
         (value-at 0))
    (object-header v oid xid type subtype)
    (put-u16 v 32 (logior (if root 1 0) (if leaf 2 0) (if fixed 4 0)))
    (put-u16 v 34 level)
    (put-u32 v 36 n)
    (put-u16 v 40 0)
    (put-u16 v 42 toc)
    (loop for (key . value) in records
          for i from 0
          do (put-bytes v (+ keys key-at) key)
             (incf value-at (length value))
             (put-bytes v (- end value-at) value)
             (if fixed
                 (progn (put-u16 v (+ 56 (* 4 i)) key-at) (put-u16 v (+ 58 (* 4 i)) value-at))
                 (progn (put-u16 v (+ 56 (* 8 i)) key-at) (put-u16 v (+ 58 (* 8 i)) (length key))
                        (put-u16 v (+ 60 (* 8 i)) value-at) (put-u16 v (+ 62 (* 8 i)) (length value))))
             (incf key-at (length key)))
    (put-u16 v 44 key-at)
    (put-u16 v 46 (- end keys key-at value-at))
    (put-u16 v 48 #xffff)
    (put-u16 v 52 #xffff)
    (when root
      (let ((info (- +block-size+ 40)))
        (put-u32 v info info-flags)
        (put-u32 v (+ info 4) +block-size+)
        (put-u32 v (+ info 8) info-key-size)
        (put-u32 v (+ info 12) info-value-size)
        (put-u32 v (+ info 16) longest-key)
        (put-u32 v (+ info 20) longest-value)
        (put-u64 v (+ info 24) key-count)
        (put-u64 v (+ info 32) node-count)))
    (seal v)))

(defun toc-size (fixed n avail key-size value-size)
  (if fixed
      (* 4 (* 8 (ceiling (floor avail (+ 4 key-size value-size)) 8)))
      (* 8 (* 8 (max 1 (ceiling n 8))))))

(defun fits-p (records fixed root key-size value-size)
  (let* ((avail (- +block-size+ (if root 40 0) 56))
         (n (length records)))
    (if fixed
        (<= (* n (+ key-size value-size)) (- avail (toc-size t n avail key-size value-size)))
        (<= (+ (toc-size nil n avail 0 0) (reduce #'+ records :key (lambda (r) (+ (length (car r)) (length (cdr r))))))
            avail))))

(defun split-records (records fixed key-size value-size)
  (let ((nodes nil) (current nil))
    (dolist (r records)
      (if (fits-p (append current (list r)) fixed nil key-size value-size)
          (setf current (append current (list r)))
          (progn (push current nodes) (setf current (list r)))))
    (when current (push current nodes))
    (nreverse nodes)))

(defun pack-btree (records &key fixed (key-size 0) (value-size 0) info-flags subtype physical xid next-oid)
  (let* ((longest-key (reduce #'max records :key (lambda (r) (length (car r))) :initial-value 0))
         (longest-value (reduce #'max records :key (lambda (r) (length (cdr r))) :initial-value 0))
         (key-count (length records))
         (levels (list (if (fits-p records fixed t key-size value-size)
                           (list records)
                           (split-records records fixed key-size value-size)))))
    (loop while (> (length (first levels)) 1)
          do (let ((index (mapcar (lambda (group) (cons (car (first group)) (le 0 8))) (first levels))))
               (push (if (fits-p index fixed t key-size 8) (list index) (split-records index fixed key-size 8))
                     levels)))
    (setf levels (nreverse levels))
    (let ((top (1- (length levels)))
          (total (reduce #'+ levels :key #'length))
          (built nil)
          (children nil))
      (loop for level from 0
            for groups in levels
            do (let ((oids nil))
                 (dolist (group groups)
                   (let* ((root (= level top))
                          (oid (funcall next-oid))
                          (entries (if (zerop level)
                                       group
                                       (mapcar (lambda (r) (cons (car r) (le (pop children) 8))) group))))
                     (push oid oids)
                     (push (list* oid level
                                  (btree-node oid xid (logior (if physical +obj-physical+ 0) (if root 2 3)) subtype entries
                                              :fixed fixed :key-size key-size
                                              :value-size (if (zerop level) value-size 8)
                                              :info-key-size key-size :info-value-size value-size
                                              :info-flags info-flags :leaf (zerop level) :root root :level level
                                              :key-count key-count :node-count total
                                              :longest-key longest-key :longest-value longest-value))
                           built)))
                 (setf children (nreverse oids))))
      built)))

(defun octets (&rest parts)
  (let ((out (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    (dolist (p parts (coerce out '(simple-array (unsigned-byte 8) (*))))
      (loop for b across p do (vector-push-extend b out)))))

(defun le (n width)
  (let ((v (make-array width :element-type '(unsigned-byte 8))))
    (dotimes (i width v) (setf (aref v i) (ldb (byte 8 (* 8 i)) n)))))

(defun crc32c (octets)
  (let ((crc #xffffffff))
    (loop for b across octets
          do (setf crc (logxor crc b))
             (dotimes (k 8) (setf crc (if (logtest crc 1) (logxor (ash crc -1) #x82f63b78) (ash crc -1)))))
    crc))

(defun name-hash (name)
  (let* ((folded (sb-unicode:normalize-string (sb-unicode:casefold name) :nfd))
         (utf32 (apply #'octets (map 'list (lambda (c) (le (char-code c) 4)) folded))))
    (logand (crc32c utf32) #x3fffff)))

(defun c-octets (string) (sb-ext:string-to-octets string :external-format :utf-8 :null-terminate t))

(defun j-key (oid type) (le (logior oid (ash type 60)) 8))

(defun drec-record (parent name file-id time type)
  (let ((n (c-octets name)))
    (cons (octets (j-key parent +apfs-type-dir-rec+) (le (logior (length n) (ash (name-hash name) 10)) 4) n)
          (octets (le file-id 8) (le time 8) (le type 2)))))

(defun xfield-blob (fields)
  (let* ((headers (apply #'octets (loop for (type flags data) in fields
                                        collect (octets (le type 1) (le flags 1) (le (length data) 2)))))
         (data (apply #'octets (loop for (nil nil d) in fields
                                     collect (octets d (make-array (- (* 8 (ceiling (length d) 8)) (length d))
                                                                   :element-type '(unsigned-byte 8) :initial-element 0))))))
    (octets (le (length fields) 2) (le (length data) 2) headers data)))

(defun inode-record (id &key parent private-id time (flags #x8000) (nchildren 0) (owner 0) (group 0) mode name dstream)
  (cons (j-key id +apfs-type-inode+)
        (octets (le parent 8) (le (or private-id id) 8) (le time 8) (le time 8) (le time 8) (le time 8)
                (le flags 8) (le nchildren 4) (le 0 4) (le 1 4) (le 0 4) (le owner 4) (le group 4)
                (le mode 2) (le 0 2) (le 0 8)
                (xfield-blob (append (when name (list (list +ino-ext-type-name+ 2 (c-octets name))))
                                     (when dstream (list (list +ino-ext-type-dstream+ 32 dstream))))))))

(defun record-rank (key)
  (let* ((id (u64 key 0)) (type (ash id -60)))
    (list (logand id #x0fffffffffffffff) type
          (cond ((= type +apfs-type-dir-rec+) (ash (u32 key 8) -10))
                ((= type +apfs-type-file-extent+) (u64 key 8))
                (t 0))
          (cond ((= type +apfs-type-dir-rec+) (subseq key 12))
                ((= type +apfs-type-xattr+) (subseq key 10))
                (t #())))))

(defun octets< (a b)
  (loop for x across a for y across b
        when (< x y) return t
        when (> x y) return nil
        finally (return (< (length a) (length b)))))

(defun sort-fs-records (records)
  (sort (copy-list records)
        (lambda (a b)
          (destructuring-bind (o1 t1 s1 n1) (record-rank (car a))
            (destructuring-bind (o2 t2 s2 n2) (record-rank (car b))
              (cond ((/= o1 o2) (< o1 o2))
                    ((/= t1 t2) (< t1 t2))
                    ((/= s1 s2) (< s1 s2))
                    (t (octets< n1 n2))))))))

(defun dstream-field (size blocks)
  (octets (le size 8) (le (* blocks +block-size+) 8) (le 0 8) (le size 8) (le 0 8)))

(defun build-tree (entries &key time owner group data-start)
  "ENTRIES are (:dir path) (:file path octets) (:symlink path target). Returns fs records, extentref records,
data blocks as (block . octets), the next inode number and counts."
  (let ((ids (make-hash-table :test 'equal))
        (children (make-hash-table :test 'equal))
        (next 16) (block data-start)
        (fs nil) (extents nil) (data nil)
        (files 0) (dirs 0) (links 0))
    (setf (gethash "" ids) +root-dir-ino-num+)
    (flet ((parent-of (path) (let ((slash (position #\/ path :from-end t))) (if slash (subseq path 0 slash) "")))
           (leaf-of (path) (let ((slash (position #\/ path :from-end t))) (if slash (subseq path (1+ slash)) path))))
      (dolist (e entries)
        (let ((path (string-trim "/" (second e))))
          (setf (gethash path ids) (prog1 next (incf next)))
          (push path (gethash (parent-of path) children))))
      (dolist (e entries)
        (destructuring-bind (kind raw &optional content (mode #o644)) e
          (let* ((path (string-trim "/" raw))
                 (id (gethash path ids))
                 (parent (or (gethash (parent-of path) ids) (error "~a has no parent directory" raw)))
                 (name (leaf-of path)))
            (ecase kind
              (:dir
               (incf dirs)
               (push (drec-record parent name id time 4) fs)
               (push (inode-record id :parent parent :time time :owner owner :group group :mode #o040755 :name name
                                      :nchildren (length (gethash path children)))
                     fs))
              (:file
               (incf files)
               (let ((n (ceiling (length content) +block-size+)))
                 (push (drec-record parent name id time 8) fs)
                 (push (inode-record id :parent parent :time time :owner owner :group group :mode (logior #o100000 (logand mode #o7777)) :name name
                                        :nchildren 1 :dstream (and (plusp n) (dstream-field (length content) n)))
                       fs)
                 (when (plusp n)
                   (push (cons (j-key id 6) (le 1 4)) fs)
                   (push (cons (octets (j-key id +apfs-type-file-extent+) (le 0 8))
                               (octets (le (* n +block-size+) 8) (le block 8) (le 0 8)))
                         fs)
                   (push (cons (j-key block 2) (octets (le (logior n (ash 1 60)) 8) (le id 8) (le 1 4))) extents)
                   (push (cons block content) data)
                   (incf block n))))
              (:symlink
               (incf links)
               (push (drec-record parent name id time 10) fs)
               (push (inode-record id :parent parent :time time :owner owner :group group :mode #o120755 :name name
                                      :nchildren 1)
                     fs)
               (let ((target (c-octets content)))
                 (push (cons (octets (j-key id +apfs-type-xattr+) (le 21 2) (c-octets "com.apple.fs.symlink"))
                             (octets (le 6 2) (le (length target) 2) target))
                       fs))))))))
    (values fs (reverse extents) (reverse data) next block files dirs links
            (length (gethash "" children)))))

(defparameter +layouts+
  '((4096 8 52 1 1) (8192 8 124 3 3) (16384 8 160 4 4) (32768 8 304 8 8) (65536 8 332 15 8)
    (131072 8 388 29 8) (262144 16 992 116 8))
  "Blocks, descriptor blocks, data blocks, main free-queue node limit, ephemeral minimum: what Tahoe's
newfs_apfs chose for empty containers of these sizes.")

(defun layout (blocks)
  (or (assoc blocks +layouts+)
      (fail "newfs: no measured layout for ~d blocks; sizes are ~{~d~^ ~} MB" blocks
            (mapcar (lambda (l) (/ (* (first l) +block-size+) 1048576)) +layouts+))))

(defun newfs (path &key (size (* 16 1048576)) (volume-name "untitled") (container-uuid "00000000-0000-0000-0000-000000000001")
                        (volume-uuid "00000000-0000-0000-0000-000000000002")
                        (time (* 1000000000 1791936000)) (formatted-by "finch newfs") (owner 501) (group 20)
                        entries)
  (let* ((blocks (floor size +block-size+)) (xid 1)
         (layout (layout blocks))
         (desc (second layout)) (data-blocks (third layout)) (fq-limit (fourth layout)) (eph-min (fifth layout))
         (data-base (+ 1 desc))
         (ip-bm-base (+ data-base data-blocks))
         (ip-base (+ ip-bm-base 16))
         (chunks (ceiling blocks 32768))
         (ip-count (+ 3 (* 3 chunks)))
         (fixed-end (+ ip-base ip-count))
         (max-fs (max 1 (ceiling blocks 131072)))
         (image (make-hash-table))
         (volume-oid #x402) (virtual #x403))
    (multiple-value-bind (fs-records extent-records data next-ino data-end files dirs links root-children)
        (build-tree entries :time time :owner owner :group group :data-start fixed-end)
      (let* ((free-block data-end)
             (alloc (lambda () (prog1 free-block (incf free-block))))
             (container-omap (funcall alloc))
             (container-omap-tree nil)
             (volume-omap (funcall alloc))
             (fs-records (sort-fs-records
                          (append (list (drec-record 1 "root" +root-dir-ino-num+ time 4)
                                        (drec-record 1 "private-dir" 3 time 4)
                                        (inode-record +root-dir-ino-num+ :parent 1 :time time :owner owner :group group
                                                                         :mode #o040755 :name "root" :nchildren root-children)
                                        (inode-record 3 :parent 1 :time time :mode #o040644 :name "private-dir"))
                                  fs-records)))
             (fs-nodes (pack-btree fs-records :info-flags #x42 :subtype #xe :xid xid
                                              :next-oid (lambda () (prog1 virtual (incf virtual)))))
             (fs-blocks (loop for nil in fs-nodes collect (funcall alloc)))
             (volume-omap-nodes (pack-btree (sort (loop for (oid) in fs-nodes for block in fs-blocks
                                                        collect (cons (octets (le oid 8) (le xid 8))
                                                                      (octets (le 0 4) (le +block-size+ 4) (le block 8))))
                                                  #'< :key (lambda (r) (u64 (car r) 0)))
                                            :fixed t :key-size 16 :value-size 16 :info-flags #x12 :subtype #xb
                                            :physical t :xid xid :next-oid alloc))
             (extentref-nodes (pack-btree extent-records :info-flags #x52 :subtype #xf :physical t :xid xid :next-oid alloc))
             (snapmeta-nodes (pack-btree nil :info-flags #x52 :subtype #x10 :physical t :xid xid :next-oid alloc))
             (volume-block (funcall alloc))
             (volume-alloc (+ 1 (length volume-omap-nodes) (length extentref-nodes) (length snapmeta-nodes)
                              (length fs-nodes) (- data-end fixed-end))))
        (setf container-omap-tree
              (pack-btree (list (cons (octets (le volume-oid 8) (le xid 8))
                                      (octets (le 0 4) (le +block-size+ 4) (le volume-block 8))))
                          :fixed t :key-size 16 :value-size 16 :info-flags #x12 :subtype #xb
                          :physical t :xid xid :next-oid alloc))
        (let ((used free-block))
          (when (> used blocks) (error "newfs: ~d blocks do not fit in ~d" used blocks))
          (flet ((put (n v) (setf (gethash n image) v))
                 (omap (block tree flags)
                   (let ((om (new-block)))
                     (object-header om block xid (logior +obj-physical+ #xb))
                     (put-u32 om 32 flags)
                     (put-u32 om 40 (logior +obj-physical+ 2)) (put-u32 om 44 (logior +obj-physical+ 2))
                     (put-u64 om 48 tree)
                     (seal om))))
            (loop for (block . octets) in data
                  do (loop for at from 0 below (length octets) by +block-size+
                           for b from block
                           do (let ((v (new-block))) (replace v octets :start2 at) (put b v))))
            (loop for (oid nil . node) in (append volume-omap-nodes extentref-nodes snapmeta-nodes container-omap-tree)
                  do (put oid node))
            (loop for (nil nil . node) in fs-nodes for block in fs-blocks do (put block node))
            (put container-omap (omap container-omap (first (first container-omap-tree)) 1))
            (put volume-omap (omap volume-omap (first (first volume-omap-nodes)) 0))
            (let ((nx (new-block)))
              (object-header nx 1 xid (logior +obj-ephemeral+ 1))
              (put-u32 nx 32 +nx-magic+) (put-u32 nx 36 +block-size+) (put-u64 nx 40 blocks)
              (put-u64 nx 64 2)
              (put-bytes nx 72 (parse-uuid container-uuid))
              (put-u64 nx 88 virtual) (put-u64 nx 96 (1+ xid))
              (put-u32 nx 104 desc) (put-u32 nx 108 data-blocks) (put-u64 nx 112 1) (put-u64 nx 120 data-base)
              (put-u32 nx 128 2) (put-u32 nx 132 2) (put-u32 nx 136 0) (put-u32 nx 140 2) (put-u32 nx 144 0) (put-u32 nx 148 2)
              (put-u64 nx 152 #x400) (put-u64 nx 160 container-omap) (put-u64 nx 168 #x401)
              (put-u32 nx 180 max-fs) (put-u64 nx 184 volume-oid)
              (put-u64 nx 984 12) (put-u64 nx 1312 (logior (ash eph-min 32) #x40001))
              (seal nx)
              (put 0 nx)
              (put 2 (copy-seq nx)))
            (let ((cpm (new-block)))
              (object-header cpm 1 xid (logior +obj-physical+ #xc))
              (put-u32 cpm 32 1) (put-u32 cpm 36 2)
              (loop for (type oid paddr) in `((,(logior +obj-ephemeral+ 5) #x400 ,data-base) (,(logior +obj-ephemeral+ #x11) #x401 ,(1+ data-base)))
                    for at from 40 by 40
                    do (put-u32 cpm at type) (put-u32 cpm (+ at 8) +block-size+) (put-u64 cpm (+ at 24) oid) (put-u64 cpm (+ at 32) paddr))
              (put 1 (seal cpm)))
            (let ((sm (new-block)))
              (object-header sm #x400 xid (logior +obj-ephemeral+ 5))
              (put-u32 sm 32 +block-size+) (put-u32 sm 36 #x8000) (put-u32 sm 40 #x7e) (put-u32 sm 44 #x1fb)
              (put-u64 sm 48 blocks) (put-u64 sm 56 chunks) (put-u32 sm 64 1)
              (put-u64 sm 72 (- blocks used)) (put-u32 sm 80 #xa08) (put-u32 sm 128 #xa10)
              (put-u32 sm 144 1) (put-u32 sm 148 #x10)
              (put-u64 sm 152 ip-count) (put-u32 sm 160 1) (put-u32 sm 164 16) (put-u64 sm 168 ip-bm-base) (put-u64 sm 176 ip-base)
              (put-u16 sm 224 1) (put-u16 sm 264 fq-limit)
              (put-u16 sm 320 1) (put-u16 sm 322 15) (put-u32 sm 324 #x9d8) (put-u32 sm 328 #x9e0) (put-u32 sm 332 #x9e8)
              (put-u32 sm 336 1) (put-u32 sm 340 #x9d8)
              (put-u64 sm #x9d8 xid)
              (put-u16 sm #x9e8 #xffff)
              (loop for slot from 1 below 15 do (put-u16 sm (+ #x9e8 (* 2 slot)) (1+ slot)))
              (put-u16 sm (+ #x9e8 30) #xffff)
              (put-u64 sm #xa08 ip-base)
              (put data-base (seal sm)))
            (let ((reaper (new-block)))
              (object-header reaper #x401 xid (logior +obj-ephemeral+ #x11))
              (put-u64 reaper 32 1) (put-u32 reaper 64 1) (put-u32 reaper 108 (- +block-size+ 112))
              (put (1+ data-base) (seal reaper)))
            (let ((ip-bitmap (new-block)))
              (dotimes (b (1+ chunks)) (setf (ldb (byte 1 (mod b 8)) (aref ip-bitmap (floor b 8))) 1))
              (put ip-bm-base ip-bitmap))
            (let ((cib (new-block)))
              (object-header cib ip-base xid (logior +obj-physical+ 7))
              (put-u32 cib 36 chunks)
              (dotimes (c chunks)
                (let* ((at (+ 40 (* 32 c)))
                       (start (* c 32768))
                       (count (min 32768 (- blocks start)))
                       (used-here (max 0 (min count (- used start)))))
                  (put-u64 cib at xid) (put-u64 cib (+ at 8) start) (put-u32 cib (+ at 16) count)
                  (put-u32 cib (+ at 20) (- count used-here)) (put-u64 cib (+ at 24) (+ ip-base 1 c))
                  (let ((bitmap (new-block)))
                    (dotimes (b used-here) (setf (ldb (byte 1 (mod b 8)) (aref bitmap (floor b 8))) 1))
                    (put (+ ip-base 1 c) bitmap))))
              (put ip-base (seal cib)))
            (let ((vol (new-block)))
              (object-header vol volume-oid xid #xd)
              (put-u32 vol 32 +apfs-magic+)
              (put-u64 vol 40 2) (put-u64 vol 56 1)
              (put-u64 vol 88 volume-alloc)
              (put-u16 vol 96 5) (put-u32 vol 104 6) (put-u16 vol 112 1)
              (put-u32 vol 116 2) (put-u32 vol 120 (logior +obj-physical+ 2)) (put-u32 vol 124 (logior +obj-physical+ 2))
              (put-u64 vol 128 volume-omap) (put-u64 vol 136 (first (first fs-nodes)))
              (put-u64 vol 144 (first (first extentref-nodes))) (put-u64 vol 152 (first (first snapmeta-nodes)))
              (put-u64 vol 176 next-ino)
              (put-u64 vol 184 files) (put-u64 vol 192 dirs) (put-u64 vol 200 links)
              (put-bytes vol 240 (parse-uuid volume-uuid))
              (put-u64 vol 256 time) (put-u64 vol 264 1)
              (put-bytes vol 272 (subseq (c-octets formatted-by) 0 (min 32 (length (c-octets formatted-by)))))
              (put-u64 vol 304 time) (put-u64 vol 312 xid)
              (put-bytes vol 704 (c-octets volume-name))
              (put-u32 vol 960 3)
              (put volume-block (seal vol)))))
        (with-open-file (s path :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
          (loop for n in (sort (loop for k being the hash-keys of image collect k) #'<)
                do (file-position s (* n +block-size+))
                   (write-sequence (gethash n image) s))
          (file-position s (* (1- blocks) +block-size+))
          (write-sequence (or (gethash (1- blocks) image) (new-block)) s))
        path))))
