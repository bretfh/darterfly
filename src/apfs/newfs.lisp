(in-package #:finch/apfs)

(defconstant +block-size+ 4096)

(defun put-u8 (v at x) (setf (aref v at) (ldb (byte 8 0) x)))
(defun put-u16 (v at x) (put-u8 v at x) (put-u8 v (1+ at) (ash x -8)))
(defun put-u32 (v at x) (put-u16 v at (ldb (byte 16 0) x)) (put-u16 v (+ at 2) (ldb (byte 16 16) x)))
(defun put-u64 (v at x) (put-u32 v at (ldb (byte 32 0) x)) (put-u32 v (+ at 4) (ldb (byte 32 32) x)))
(defun put-bytes (v at bytes) (replace v bytes :start1 at))

(defun parse-uuid (string)
  (let ((hex (remove #\- string)))
    (coerce (loop for i below 16 collect (parse-integer hex :start (* 2 i) :end (+ 2 (* 2 i)) :radix 16))
            '(vector (unsigned-byte 8)))))

(defun new-block () (make-array +block-size+ :element-type '(unsigned-byte 8) :initial-element 0))

(defun object-header (v oid xid type &optional (subtype 0))
  (put-u64 v 8 oid)
  (put-u64 v 16 xid)
  (put-u32 v 24 type)
  (put-u32 v 28 subtype)
  v)

(defun seal (v)
  (put-u64 v 0 (fletcher-64 v))
  v)

(defconstant +obj-physical+ #x40000000)
(defconstant +obj-ephemeral+ #x80000000)

(defun btree-node (oid xid type subtype records &key fixed (key-size 0) (value-size 0) info-flags leaf root (level 0))
  (let* ((v (new-block))
         (n (length records))
         (end (- +block-size+ (if root 40 0)))
         (avail (- end 56))
         (toc (if fixed
                  (* 4 (* 8 (ceiling (floor avail (+ 4 key-size value-size)) 8)))
                  (* 8 (* 8 (max 1 (ceiling n 8))))))
         (keys (+ 56 toc))
         (key-at 0)
         (value-at 0))
    (object-header v oid xid type subtype)
    (put-u16 v 32 (logior (if root 1 0) (if leaf 2 0) (if fixed 4 0)))
    (put-u16 v 34 level)
    (put-u32 v 36 n)
    (put-u16 v 40 0)
    (put-u16 v 42 toc)
    (loop for (key . value) in records
          for i from 0
          do (put-bytes v (+ keys key-at) key)
             (incf value-at (length value))
             (put-bytes v (- end value-at) value)
             (if fixed
                 (progn (put-u16 v (+ 56 (* 4 i)) key-at) (put-u16 v (+ 58 (* 4 i)) value-at))
                 (progn (put-u16 v (+ 56 (* 8 i)) key-at) (put-u16 v (+ 58 (* 8 i)) (length key))
                        (put-u16 v (+ 60 (* 8 i)) value-at) (put-u16 v (+ 62 (* 8 i)) (length value))))
             (incf key-at (length key)))
    (put-u16 v 44 key-at)
    (put-u16 v 46 (- end keys key-at value-at))
    (put-u16 v 48 #xffff)
    (put-u16 v 52 #xffff)
    (when root
      (let ((info (- +block-size+ 40)))
        (put-u32 v info info-flags)
        (put-u32 v (+ info 4) +block-size+)
        (put-u32 v (+ info 8) key-size)
        (put-u32 v (+ info 12) value-size)
        (put-u32 v (+ info 16) (reduce #'max records :key (lambda (r) (length (car r))) :initial-value 0))
        (put-u32 v (+ info 20) (reduce #'max records :key (lambda (r) (length (cdr r))) :initial-value 0))
        (put-u64 v (+ info 24) n)
        (put-u64 v (+ info 32) 1)))
    (seal v)))

(defun octets (&rest parts)
  (let ((out (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    (dolist (p parts (coerce out '(simple-array (unsigned-byte 8) (*))))
      (loop for b across p do (vector-push-extend b out)))))

(defun le (n width)
  (let ((v (make-array width :element-type '(unsigned-byte 8))))
    (dotimes (i width v) (setf (aref v i) (ldb (byte 8 (* 8 i)) n)))))

(defun crc32c (octets)
  (let ((crc #xffffffff))
    (loop for b across octets
          do (setf crc (logxor crc b))
             (dotimes (k 8) (setf crc (if (logtest crc 1) (logxor (ash crc -1) #x82f63b78) (ash crc -1)))))
    crc))

(defun name-hash (name)
  (let* ((folded (sb-unicode:normalize-string (sb-unicode:casefold name) :nfd))
         (utf32 (apply #'octets (map 'list (lambda (c) (le (char-code c) 4)) folded))))
    (logand (crc32c utf32) #x3fffff)))

(defun c-octets (string) (sb-ext:string-to-octets string :external-format :utf-8 :null-terminate t))

(defun j-key (oid type) (le (logior oid (ash type 60)) 8))

(defun drec-record (parent name file-id time type)
  (let ((n (c-octets name)))
    (cons (octets (j-key parent +apfs-type-dir-rec+) (le (logior (length n) (ash (name-hash name) 10)) 4) n)
          (octets (le file-id 8) (le time 8) (le type 2)))))

(defun xfield-blob (fields)
  (let* ((headers (apply #'octets (loop for (type flags data) in fields
                                        collect (octets (le type 1) (le flags 1) (le (length data) 2)))))
         (data (apply #'octets (loop for (nil nil d) in fields
                                     collect (octets d (make-array (- (* 8 (ceiling (length d) 8)) (length d))
                                                                   :element-type '(unsigned-byte 8) :initial-element 0))))))
    (octets (le (length fields) 2) (le (length data) 2) headers data)))

(defun inode-record (id &key parent private-id time (flags #x8000) (nchildren 0) (owner 0) (group 0) mode name dstream)
  (cons (j-key id +apfs-type-inode+)
        (octets (le parent 8) (le (or private-id id) 8) (le time 8) (le time 8) (le time 8) (le time 8)
                (le flags 8) (le nchildren 4) (le 0 4) (le 1 4) (le 0 4) (le owner 4) (le group 4)
                (le mode 2) (le 0 2) (le 0 8)
                (xfield-blob (append (when name (list (list +ino-ext-type-name+ 2 (c-octets name))))
                                     (when dstream (list (list +ino-ext-type-dstream+ 32 dstream))))))))

(defun sort-fs-records (records)
  (flet ((rank (key)
           (let ((id (u64 key 0)))
             (list (logand id #x0fffffffffffffff) (ash id -60)
                   (if (= (ash id -60) +apfs-type-dir-rec+) (ash (u32 key 8) -10) 0)))))
    (sort (copy-list records)
          (lambda (a b)
            (let ((x (rank (car a))) (y (rank (car b))))
              (loop for p in x for q in y
                    when (< p q) return t
                    when (> p q) return nil
                    finally (return nil)))))))

(defun newfs (path &key (volume-name "untitled") (container-uuid "00000000-0000-0000-0000-000000000001")
                        (volume-uuid "00000000-0000-0000-0000-000000000002")
                        (time (* 1000000000 1791936000)) (formatted-by "finch newfs") (owner 501) (group 20))
  (let* ((blocks 4096) (xid 1)
         (image (make-hash-table))
         (used 91)
         (fs-tree-oid #x403) (volume-oid #x402))
    (flet ((put (n v) (setf (gethash n image) v)))
      (let ((nx (new-block)))
        (object-header nx 1 xid (logior +obj-ephemeral+ 1))
        (put-u32 nx 32 +nx-magic+)
        (put-u32 nx 36 +block-size+)
        (put-u64 nx 40 blocks)
        (put-u64 nx 64 2)
        (put-bytes nx 72 (parse-uuid container-uuid))
        (put-u64 nx 88 #x404)
        (put-u64 nx 96 (1+ xid))
        (put-u32 nx 104 8) (put-u32 nx 108 52)
        (put-u64 nx 112 1) (put-u64 nx 120 9)
        (put-u32 nx 128 2) (put-u32 nx 132 2)
        (put-u32 nx 136 0) (put-u32 nx 140 2)
        (put-u32 nx 144 0) (put-u32 nx 148 2)
        (put-u64 nx 152 #x400) (put-u64 nx 160 83) (put-u64 nx 168 #x401)
        (put-u32 nx 180 1)
        (put-u64 nx 184 volume-oid)
        (put-u64 nx 984 12)
        (put-u64 nx 1312 #x100040001)
        (seal nx)
        (put 0 nx)
        (put 2 (copy-seq nx)))
      (let ((cpm (new-block)))
        (object-header cpm 1 xid (logior +obj-physical+ #xc))
        (put-u32 cpm 32 1)
        (put-u32 cpm 36 2)
        (loop for (type oid paddr) in `((,(logior +obj-ephemeral+ 5) #x400 9) (,(logior +obj-ephemeral+ #x11) #x401 10))
              for at from 40 by 40
              do (put-u32 cpm at type) (put-u32 cpm (+ at 8) +block-size+)
                 (put-u64 cpm (+ at 24) oid) (put-u64 cpm (+ at 32) paddr))
        (put 1 (seal cpm)))
      (let ((sm (new-block)))
        (object-header sm #x400 xid (logior +obj-ephemeral+ 5))
        (put-u32 sm 32 +block-size+) (put-u32 sm 36 #x8000) (put-u32 sm 40 #x7e) (put-u32 sm 44 #x1fb)
        (put-u64 sm 48 blocks) (put-u64 sm 56 1) (put-u32 sm 64 1) (put-u32 sm 68 0)
        (put-u64 sm 72 (- blocks used)) (put-u32 sm 80 #xa08)
        (put-u32 sm 128 #xa10)
        (put-u32 sm 144 1) (put-u32 sm 148 #x10)
        (put-u64 sm 152 6) (put-u32 sm 160 1) (put-u32 sm 164 16)
        (put-u64 sm 168 61) (put-u64 sm 176 77)
        (put-u16 sm 224 1) (put-u16 sm 264 1)
        (put-u16 sm 320 1) (put-u16 sm 322 15) (put-u32 sm 324 #x9d8)
        (put-u32 sm 328 #x9e0) (put-u32 sm 332 #x9e8)
        (put-u32 sm 336 1) (put-u32 sm 340 #x9d8)
        (put-u64 sm #x9d8 xid)
        (put-u16 sm #x9e0 0)
        (put-u16 sm #x9e8 #xffff)
        (loop for slot from 1 below 15 do (put-u16 sm (+ #x9e8 (* 2 slot)) (1+ slot)))
        (put-u16 sm (+ #x9e8 30) #xffff)
        (put-u64 sm #xa08 77)
        (put 9 (seal sm)))
      (let ((reaper (new-block)))
        (object-header reaper #x401 xid (logior +obj-ephemeral+ #x11))
        (put-u64 reaper 32 1)
        (put-u32 reaper 64 1)
        (put-u32 reaper 108 (- +block-size+ 112))
        (put 10 (seal reaper)))
      (let ((ip-bitmap (new-block)))
        (put-u8 ip-bitmap 0 3)
        (put 61 ip-bitmap))
      (let ((cib (new-block)))
        (object-header cib 77 xid (logior +obj-physical+ 7))
        (put-u32 cib 32 0) (put-u32 cib 36 1)
        (put-u64 cib 40 xid) (put-u64 cib 48 0) (put-u32 cib 56 blocks) (put-u32 cib 60 (- blocks used))
        (put-u64 cib 64 78)
        (put 77 (seal cib)))
      (let ((bitmap (new-block)))
        (dotimes (b used) (setf (ldb (byte 1 (mod b 8)) (aref bitmap (floor b 8))) 1))
        (put 78 bitmap))
      (flet ((omap (block tree flags)
               (let ((om (new-block)))
                 (object-header om block xid (logior +obj-physical+ #xb))
                 (put-u32 om 32 flags)
                 (put-u32 om 40 (logior +obj-physical+ 2)) (put-u32 om 44 (logior +obj-physical+ 2))
                 (put-u64 om 48 tree)
                 (seal om)))
             (omap-tree (block oid paddr)
               (btree-node block xid (logior +obj-physical+ 2) #xb
                           (list (cons (octets (le oid 8) (le xid 8)) (octets (le 0 4) (le +block-size+ 4) (le paddr 8))))
                           :fixed t :key-size 16 :value-size 16 :info-flags #x12 :leaf t :root t))
             (empty-tree (block subtype)
               (btree-node block xid (logior +obj-physical+ 2) subtype nil :info-flags #x52 :leaf t :root t)))
        (put 83 (omap 83 84 1))
        (put 84 (omap-tree 84 volume-oid 90))
        (put 85 (omap 85 86 0))
        (put 86 (omap-tree 86 fs-tree-oid 89))
        (put 87 (empty-tree 87 #xf))
        (put 88 (empty-tree 88 #x10)))
      (put 89 (btree-node fs-tree-oid xid 2 #xe
                          (sort-fs-records
                           (list (drec-record 1 "root" +root-dir-ino-num+ time 4)
                                 (drec-record 1 "private-dir" 3 time 4)
                                 (inode-record +root-dir-ino-num+ :parent 1 :time time :owner owner :group group
                                                                  :mode #o040755 :name "root")
                                 (inode-record 3 :parent 1 :time time :mode #o040644 :name "private-dir")))
                          :info-flags #x42 :leaf t :root t))
      (let ((vol (new-block)))
        (object-header vol volume-oid xid #xd)
        (put-u32 vol 32 +apfs-magic+)
        (put-u64 vol 40 2)
        (put-u64 vol 56 1)
        (put-u64 vol 88 5)
        (put-u16 vol 96 5) (put-u32 vol 104 6) (put-u16 vol 112 1)
        (put-u32 vol 116 2) (put-u32 vol 120 (logior +obj-physical+ 2)) (put-u32 vol 124 (logior +obj-physical+ 2))
        (put-u64 vol 128 85) (put-u64 vol 136 fs-tree-oid) (put-u64 vol 144 87) (put-u64 vol 152 88)
        (put-u64 vol 176 16)
        (put-bytes vol 240 (parse-uuid volume-uuid))
        (put-u64 vol 256 time)
        (put-u64 vol 264 1)
        (put-bytes vol 272 (subseq (c-octets formatted-by) 0 (min 32 (length (c-octets formatted-by)))))
        (put-u64 vol 304 time) (put-u64 vol 312 xid)
        (put-bytes vol 704 (c-octets volume-name))
        (put-u32 vol 960 3)
        (put 90 (seal vol))))
    (with-open-file (s path :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
      (let ((zero (new-block)))
        (dotimes (n blocks)
          (write-sequence (or (gethash n image) zero) s))))
    path))
