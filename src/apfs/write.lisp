(in-package #:finch/apfs)

(defstruct (wvolume (:constructor %make-wvolume)) nx records extents children pending-free (by-id (make-hash-table)))

(defun key-id (key) (logand (u64 key 0) #x0fffffffffffffff))

(defun put-record (w key value)
  (unless (nth-value 1 (gethash key (wvolume-records w)))
    (push key (gethash (key-id key) (wvolume-by-id w))))
  (setf (gethash key (wvolume-records w)) value))

(defun drop-record (w key)
  (when (nth-value 1 (gethash key (wvolume-records w)))
    (remhash key (wvolume-records w))
    (setf (gethash (key-id key) (wvolume-by-id w)) (delete key (gethash (key-id key) (wvolume-by-id w)) :test #'equalp))))

(defun record-table (records)
  (let ((h (make-hash-table :test 'equalp)))
    (dolist (r records h) (setf (gethash (car r) h) (cdr r)))))

(defun make-wvolume (nx)
  (let ((w (%make-wvolume :nx nx :records (record-table (nx-fs-records nx)) :extents (record-table (nx-extent-records nx))
                          :children (make-hash-table))))
    (maphash (lambda (k v)
               (when (= (ash (u64 k 0) -60) +apfs-type-dir-rec+)
                 (push (list (c-string k 12 (+ 12 (logand (u32 k 8) #x3ff))) (u64 v 0) k)
                       (gethash (logand (u64 k 0) #x0fffffffffffffff) (wvolume-children w))))
               (push k (gethash (key-id k) (wvolume-by-id w))))
             (wvolume-records w))
    w))

(defun wvolume-sb (w) (nx-vol-sb (wvolume-nx w)))

(defun wcommit (w)
  (let ((nx (wvolume-nx w)))
    (setf (nx-fs-records nx) (loop for k being the hash-keys of (wvolume-records w) using (hash-value v) collect (cons k v))
          (nx-extent-records nx) (sort (loop for k being the hash-keys of (wvolume-extents w) using (hash-value v) collect (cons k v))
                                       #'< :key (lambda (r) (u64 (car r) 0))))
    (let ((freed (wvolume-pending-free w)))
      (setf (wvolume-pending-free w) nil)
      (commit nx :also-free freed))))

(defun parse-xfields (v at)
  (when (< (+ at 4) (length v))
    (let* ((n (u16 v at)) (data (+ at 4 (* 4 n))))
      (loop for i below n
            for size = (u16 v (+ at 6 (* 4 i)))
            collect (list (u8 v (+ at 4 (* 4 i))) (u8 v (+ at 5 (* 4 i))) (subseq v data (+ data size)))
            do (incf data (* 8 (ceiling size 8)))))))

(defun winode (w id) (or (gethash (j-key id +apfs-type-inode+) (wvolume-records w)) (fail "no inode ~d" id)))

(defun update-inode (w id &key parent nchildren mode owner group name dstream (touch t))
  (let* ((v (copy-seq (winode w id)))
         (fields (parse-xfields v 92)))
    (when parent (put-u64 v 0 parent))
    (when nchildren (put-u32 v 56 nchildren))
    (when mode (put-u16 v 80 mode))
    (when owner (put-u32 v 72 owner))
    (when group (put-u32 v 76 group))
    (when touch (let ((now (now-ns))) (put-u64 v 24 now) (put-u64 v 32 now)))
    (when (or name dstream)
      (when name (setf fields (cons (list +ino-ext-type-name+ 2 (c-octets name)) (remove +ino-ext-type-name+ fields :key #'first))))
      (when dstream (setf fields (append (remove +ino-ext-type-dstream+ fields :key #'first)
                                         (list (list +ino-ext-type-dstream+ 32 dstream)))))
      (setf fields (sort fields #'< :key #'first))
      (setf v (octets (subseq v 0 92) (xfield-blob fields))))
    (put-record w (j-key id +apfs-type-inode+) v)))

(defun inode-field (w id offset width)
  (let ((v (winode w id))) (ecase width (2 (u16 v offset)) (4 (u32 v offset)) (8 (u64 v offset)))))

(defun inode-dstream (w id)
  (third (find +ino-ext-type-dstream+ (parse-xfields (winode w id) 92) :key #'first)))

(defun wlookup (w parent name)
  (let ((ci (logtest (u64 (wvolume-sb w) 56) 1)))
    (second (find name (gethash parent (wvolume-children w)) :key #'first
                                                              :test (lambda (a b) (if ci (string-equal a b) (string= a b)))))))

(defun wentries (w parent)
  (mapcar (lambda (e) (cons (first e) (second e))) (gethash parent (wvolume-children w))))

(defun counter (w offset delta) (put-u64 (wvolume-sb w) offset (+ (u64 (wvolume-sb w) offset) delta)))

(defun add-drec (w parent name id type)
  (let ((r (drec-record parent name id (now-ns) type)))
    (put-record w (car r) (cdr r))
    (push (list name id (car r)) (gethash parent (wvolume-children w)))
    (update-inode w parent :nchildren (1+ (inode-field w parent 56 4)))))

(defun drop-drec (w parent name)
  (let ((e (find name (gethash parent (wvolume-children w)) :key #'first :test #'string-equal)))
    (when e
      (drop-record w (third e))
      (setf (gethash parent (wvolume-children w)) (remove e (gethash parent (wvolume-children w))))
      (update-inode w parent :nchildren (1- (inode-field w parent 56 4))))))

(defun wcreate (w parent name kind &key (mode #o644) target)
  (when (wlookup w parent name) (vfs:fail :eexist))
  (let* ((sb (wvolume-sb w))
         (id (u64 sb 176))
         (pv (winode w parent)))
    (put-u64 sb 176 (1+ id))
    (put-record w (j-key id +apfs-type-inode+)
          (cdr (inode-record id :parent parent :time (now-ns) :owner (u32 pv 72) :group (u32 pv 76)
                                :mode (logior (ecase kind (:dir #o040000) (:file #o100000) (:symlink #o120000)) (logand mode #o7777))
                                :name name :nchildren (if (eq kind :dir) 0 1))))
    (when (eq kind :symlink)
      (let ((t8 (c-octets target)))
        (put-record w (octets (j-key id +apfs-type-xattr+) (le 21 2) (c-octets "com.apple.fs.symlink"))
                    (octets (le 6 2) (le (length t8) 2) t8))))
    (counter w (ecase kind (:file 184) (:dir 192) (:symlink 200)) 1)
    (add-drec w parent name id (ecase kind (:dir 4) (:file 8) (:symlink 10)))
    id))

(defun file-extents (w id)
  (let ((prefix (j-key id +apfs-type-file-extent+)))
    (sort (loop for k in (gethash id (wvolume-by-id w))
                for v = (gethash k (wvolume-records w))
                when (and (= (length k) 16) (equalp (subseq k 0 8) prefix))
                  collect (list k (u64 k 8) (logand (u64 v 0) #x00ffffffffffffff) (u64 v 8)))
          #'< :key #'second)))

(defun wread (w id start end)
  (let* ((size (let ((d (inode-dstream w id))) (if d (u64 d 0) 0)))
         (end (min end size))
         (out (make-array (max 0 (- end start)) :element-type '(unsigned-byte 8) :initial-element 0))
         (nx (wvolume-nx w)))
    (loop for (nil logical length physical) in (file-extents w id)
          for from = (max start logical)
          for to = (min end (+ logical length))
          when (and (< from to) (plusp physical))
            do (replace out (funcall (nx-read nx) (+ (* physical +block-size+) (- from logical)) (- to from))
                        :start1 (- from start)))
    out))

(defun drop-data (w id)
  (dolist (e (file-extents w id))
    (destructuring-bind (key logical length physical) e
      (declare (ignore logical))
      (drop-record w key)
      (when (plusp physical)
        (remhash (j-key physical 2) (wvolume-extents w))
        (loop for b from physical below (+ physical (ceiling length +block-size+)) do (push b (wvolume-pending-free w)))))))

(defun wset-content (w id content)
  (let* ((nx (wvolume-nx w))
         (n (ceiling (length content) +block-size+)))
    (drop-data w id)
    (if (zerop n)
        (progn (drop-record w (j-key id 6))
               (update-inode w id :dstream (dstream-field 0 0)))
        (let ((start (alloc-extent nx n))
              (padded (make-array (* n +block-size+) :element-type '(unsigned-byte 8) :initial-element 0)))
          (replace padded content)
          (funcall (nx-write nx) (* start +block-size+) padded)
          (put-record w (j-key id 6) (le 1 4))
          (put-record w (octets (j-key id +apfs-type-file-extent+) (le 0 8))
                      (octets (le (* n +block-size+) 8) (le start 8) (le 0 8)))
          (setf (gethash (j-key start 2) (wvolume-extents w))
                (octets (le (logior n (ash 1 60)) 8) (le id 8) (le 1 4)))
          (update-inode w id :dstream (dstream-field (length content) n))))
    (length content)))

(defun file-size (w id)
  (let ((d (inode-dstream w id))) (if d (u64 d 0) 0)))

(defun add-extent (w id logical blocks physical)
  (put-record w (octets (j-key id +apfs-type-file-extent+) (le logical 8))
              (octets (le (* blocks +block-size+) 8) (le physical 8) (le 0 8)))
  (setf (gethash (j-key physical 2) (wvolume-extents w))
        (octets (le (logior blocks (ash 1 60)) 8) (le id 8) (le 1 4))))

(defun remap (w id from to physical)
  (dolist (e (file-extents w id))
    (destructuring-bind (key logical length phys) e
      (let ((end (+ logical length)))
        (when (and (< logical to) (> end from) (plusp phys))
          (drop-record w key)
          (remhash (j-key phys 2) (wvolume-extents w))
          (when (< logical from)
            (add-extent w id logical (floor (- from logical) +block-size+) phys))
          (when (> end to)
            (add-extent w id to (ceiling (- end to) +block-size+) (+ phys (floor (- to logical) +block-size+))))
          (loop for b from (+ phys (floor (- (max logical from) logical) +block-size+))
                  below (+ phys (ceiling (- (min end to) logical) +block-size+))
                do (push b (wvolume-pending-free w)))))))
  (add-extent w id from (floor (- to from) +block-size+) physical))

(defun wwrite (w id offset octets)
  (when (plusp (length octets))
    (let* ((nx (wvolume-nx w))
           (size (file-size w id))
           (end (+ offset (length octets)))
           (from (* +block-size+ (floor (min offset size) +block-size+)))
           (to (* +block-size+ (ceiling end +block-size+)))
           (buf (make-array (- to from) :element-type '(unsigned-byte 8) :initial-element 0))
           (start (alloc-extent nx (floor (- to from) +block-size+))))
      (replace buf (wread w id from (min to size)))
      (replace buf octets :start1 (- offset from))
      (funcall (nx-write nx) (* start +block-size+) buf)
      (unless (nth-value 1 (gethash (j-key id 6) (wvolume-records w)))
        (put-record w (j-key id 6) (le 1 4)))
      (remap w id from to start)
      (let ((new-size (max size end)))
        (update-inode w id :dstream (dstream-field new-size (ceiling new-size +block-size+))))))
  (length octets))

(defun wtruncate (w id size)
  (let ((old (wread w id 0 size)))
    (wset-content w id (let ((v (make-array size :element-type '(unsigned-byte 8) :initial-element 0))) (replace v old) v))))

(defun wremove (w parent name id)
  (let ((mode (inode-field w id 80 2)))
    (drop-data w id)
    (dolist (k (copy-list (gethash id (wvolume-by-id w)))) (drop-record w k))
    (drop-drec w parent name)
    (counter w (case (logand mode #o170000) (#o040000 192) (#o120000 200) (t 184)) -1)))

(defun wrename (w from-parent from-name id to-parent to-name)
  (let ((existing (wlookup w to-parent to-name)))
    (when (and existing (/= existing id)) (wremove w to-parent to-name existing)))
  (let ((type (case (logand (inode-field w id 80 2) #o170000) (#o040000 4) (#o120000 10) (t 8))))
    (drop-drec w from-parent from-name)
    (add-drec w to-parent to-name id type)
    (update-inode w id :parent to-parent :name to-name)))
