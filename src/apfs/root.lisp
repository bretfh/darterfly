(in-package #:darterfly/apfs)

(defun mountroot ()
  (let ((rd (devices:boot-arg "rd")))
    (when (stringp rd)
      (devices:start-devices)
      (let ((media (cond ((equal rd "ram")
                          (find-if (lambda (e) (typep (devices:media-device e) 'devices::ram-disk))
                                   (devices:find-entries 'apfs-volume-media)))
                         ((uiop:string-prefix-p "uuid:" rd)
                          (find (subseq rd 5) (devices:find-entries 'apfs-volume-media)
                                :key (lambda (e) (princ-to-string (devices:get-property e "UUID"))) :test #'string-equal))
                         (t (find rd (devices:find-entries 'apfs-volume-media)
                                  :key (lambda (e) (devices:get-property e "BSD Name")) :test #'equal)))))
        (unless media
          (format *error-output* "~&mountroot: no APFS volume ~a~%" rd)
          (return-from mountroot nil))
        (mount-writable (lambda (at length) (devices:media-read media at length))
                        (lambda (at octets) (devices:media-write media at octets))
                        "/"
                        (lambda () (devices:media-flush media)))
        (setf *root-media* media)
        (start-syncer)
        (dolist (dir '("/dev" "/proc" "/tmp" "/Volumes" "/System/Library/Kernels")) (vfs:vfs-mkdirs dir))
        (vfs:vfs-mount (vfs:make-devfs) "/dev")
        (vfs:vfs-mount (vfs:make-procfs) "/proc")
        (vfs:vfs-mount (vfs:make-ram-node :vdir #o1777) "/tmp")
        (vfs:vfs-mount (vfs:make-kernel-dir) "/System/Library/Kernels")
        rd))))

(pushnew 'forget-mounts sb-ext:*save-hooks*)

(defun forget-mounts ()
  (setf *root-media* nil *syncer* nil)
  (clrhash *vnodes*)
  (clrhash *wvnodes*))
