(in-package #:finch/apfs)

(defun mountroot ()
  (let ((rd (iokit:boot-arg "rd")))
    (when (stringp rd)
      (iokit:start-iokit)
      (let ((media (find rd (iokit:find-entries 'apple-apfs-volume)
                         :key (lambda (e) (iokit:get-property e "BSD Name")) :test #'equal)))
        (unless media
          (format *error-output* "~&mountroot: no APFS volume ~a~%" rd)
          (return-from mountroot nil))
        (mount-writable (lambda (at length) (iokit:media-read media at length))
                        (lambda (at octets) (iokit:media-write media at octets))
                        "/")
        (setf *root-media* media)
        (dolist (dir '("/dev" "/tmp" "/Volumes" "/System/Library/Kernels")) (vfs:vfs-mkdirs dir))
        (vfs:vfs-mount (vfs:make-devfs) "/dev")
        (vfs:vfs-mount (vfs:make-ram-node :vdir #o1777) "/tmp")
        (vfs:vfs-mount (vfs:make-kernel-dir) "/System/Library/Kernels")
        rd))))
