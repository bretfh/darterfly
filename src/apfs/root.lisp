(in-package #:finch/apfs)

(defun mountroot ()
  (let ((rd (iokit:boot-arg "rd")))
    (when (stringp rd)
      (iokit:start-iokit)
      (let ((media (cond ((equal rd "ram")
                          (find-if (lambda (e) (typep (iokit:media-device e) 'iokit::io-ram-block-storage-device))
                                   (iokit:find-entries 'apple-apfs-volume)))
                         ((uiop:string-prefix-p "uuid:" rd)
                          (find (subseq rd 5) (iokit:find-entries 'apple-apfs-volume)
                                :key (lambda (e) (princ-to-string (iokit:get-property e "UUID"))) :test #'string-equal))
                         (t (find rd (iokit:find-entries 'apple-apfs-volume)
                                  :key (lambda (e) (iokit:get-property e "BSD Name")) :test #'equal)))))
        (unless media
          (format *error-output* "~&mountroot: no APFS volume ~a~%" rd)
          (return-from mountroot nil))
        (mount-writable (lambda (at length) (iokit:media-read media at length))
                        (lambda (at octets) (iokit:media-write media at octets))
                        "/"
                        (lambda () (iokit:media-flush media)))
        (setf *root-media* media)
        (start-syncer)
        (dolist (dir '("/dev" "/proc" "/tmp" "/Volumes" "/System/Library/Kernels")) (vfs:vfs-mkdirs dir))
        (vfs:vfs-mount (vfs:make-devfs) "/dev")
        (vfs:vfs-mount (vfs:make-procfs) "/proc")
        (vfs:vfs-mount (vfs:make-ram-node :vdir #o1777) "/tmp")
        (vfs:vfs-mount (vfs:make-kernel-dir) "/System/Library/Kernels")
        rd))))

(pushnew 'forget-mounts sb-ext:*save-hooks*)

(defun forget-mounts ()
  (setf *root-media* nil *syncer* nil)
  (clrhash *vnodes*)
  (clrhash *wvnodes*))
