(in-package #:finch/apfs)

(defstruct nx
  read write block-count sb xid next-oid
  desc-base desc-blocks desc-next data-base data-blocks data-next
  sm cib-paddr bitmap-paddrs bitmap ip-base ip-count ip-bm-base ip-bitmap
  ip-fq main-fq fq-oids reaper carry (low 0) flush
  omap-paddr omap-nodes omap-entries
  vol-oid vol-sb vol-paddr vol-omap-paddr vol-omap-nodes fs-records fs-nodes extent-records extent-nodes snap-node)

(defun file-store (path &key (offset 0))
  (values (file-device path :offset offset)
          (lambda (at octets)
            (with-open-file (s path :direction :output :element-type '(unsigned-byte 8) :if-exists :overwrite)
              (file-position s (+ offset at))
              (write-sequence octets s)))))

(defun nx-block (nx n) (funcall (nx-read nx) (* n +block-size+) +block-size+))
(defun nx-put (nx n v) (funcall (nx-write nx) (* n +block-size+) v))

(defun walk-tree (nx root &key resolve)
  "All leaf records of the tree at ROOT, and the blocks of its nodes as (oid . paddr)."
  (let ((records nil) (nodes nil))
    (labels ((visit (oid)
               (let* ((paddr (if resolve (funcall resolve oid) oid))
                      (block (nx-block nx paddr)))
                 (unless (object-valid-p block) (fail "tree node ~d at ~d fails its checksum" oid paddr))
                 (push (cons oid paddr) nodes)
                 (let ((node (make-node block)))
                   (dotimes (i (node-count node))
                     (multiple-value-bind (k ks v vs) (node-entry node i 16 (if (logtest (node-flags node) +btnode-fixed-kv-size+) 16 0))
                       (if (node-leaf-p node)
                           (push (cons (subseq block k (+ k ks)) (subseq block v (+ v vs))) records)
                           (visit (u64 block v)))))))))
      (visit root))
    (values (nreverse records) (nreverse nodes))))

(defun omap-entries (records)
  (mapcar (lambda (r) (list (u64 (car r) 0) (u64 (car r) 8) (u64 (cdr r) 8))) records))

(defun fq-records (nx root)
  (when (plusp root)
    (let ((block (nx-block nx root)))
      (let ((node (make-node block)))
        (loop for i below (node-count node)
              collect (multiple-value-bind (k ks v vs) (node-entry node i 16 8)
                        (declare (ignore ks))
                        (list (u64 block k) (u64 block (+ k 8)) (if (plusp vs) (u64 block v) 1))))))))

(defun open-writable (read write &optional flush)
  (multiple-value-bind (sb) (checkpoint-superblock read)
    (let* ((nx (make-nx :read read :write write :flush flush :sb (copy-seq sb) :xid (object-xid sb) :block-count (u64 sb 40)
                        :next-oid (u64 sb 88)
                        :desc-base (u64 sb 112) :desc-blocks (logand (u32 sb 104) #x7fffffff) :desc-next (u32 sb 128)
                        :data-base (u64 sb 120) :data-blocks (logand (u32 sb 108) #x7fffffff) :data-next (u32 sb 132)))
           (cpm (nx-block nx (+ (nx-desc-base nx) (u32 sb 136))))
           (ephemeral (loop for i below (u32 cpm 36)
                            for at = (+ 40 (* 40 i))
                            collect (cons (u64 cpm (+ at 24)) (u64 cpm (+ at 32)))))
           (where (lambda (oid) (or (cdr (assoc oid ephemeral)) (fail "ephemeral object ~x is not in the checkpoint" oid))))
           (sm (copy-seq (nx-block nx (funcall where (u64 sb 152))))))
      (setf (nx-sm nx) sm
            (nx-reaper nx) (copy-seq (nx-block nx (funcall where (u64 sb 168))))
            (nx-cib-paddr nx) (u64 sm (u32 sm 80))
            (nx-ip-base nx) (u64 sm 176) (nx-ip-count nx) (u64 sm 152) (nx-ip-bm-base nx) (u64 sm 168))
      (let* ((cib (nx-block nx (nx-cib-paddr nx)))
             (paddrs (loop for c below (u32 cib 36) collect (u64 cib (+ 40 (* 32 c) 24)))))
        (setf (nx-bitmap-paddrs nx) paddrs
              (nx-bitmap nx) (apply #'octets (mapcar (lambda (b) (nx-block nx b)) paddrs))))
      (setf (nx-ip-bitmap nx) (copy-seq (nx-block nx (+ (nx-ip-bm-base nx) (u16 sm (u32 sm 328))))))
      (setf (nx-fq-oids nx) (list (u64 sm 208) (u64 sm 248))
            (nx-ip-fq nx) (fq-records nx (if (plusp (u64 sm 208)) (funcall where (u64 sm 208)) 0))
            (nx-main-fq nx) (fq-records nx (if (plusp (u64 sm 248)) (funcall where (u64 sm 248)) 0)))
      (let ((omap (nx-block nx (u64 sb 160))))
        (setf (nx-omap-paddr nx) (u64 sb 160))
        (multiple-value-bind (records nodes) (walk-tree nx (u64 omap 48))
          (setf (nx-omap-entries nx) (omap-entries records) (nx-omap-nodes nx) (mapcar #'cdr nodes))))
      (let* ((vol-oid (u64 sb 184))
             (entry (car (last (remove-if-not (lambda (e) (= (first e) vol-oid)) (nx-omap-entries nx)))))
             (vol (copy-seq (nx-block nx (third entry))))
             (vol-omap (nx-block nx (u64 vol 128))))
        (setf (nx-vol-oid nx) vol-oid (nx-vol-sb nx) vol (nx-vol-paddr nx) (third entry) (nx-vol-omap-paddr nx) (u64 vol 128))
        (multiple-value-bind (records nodes) (walk-tree nx (u64 vol-omap 48))
          (let ((entries (omap-entries records)))
            (setf (nx-vol-omap-nodes nx) (mapcar #'cdr nodes))
            (multiple-value-bind (fs fs-nodes)
                (walk-tree nx (u64 vol 136) :resolve (lambda (oid) (third (car (last (remove-if-not (lambda (e) (= (first e) oid)) entries))))))
              (setf (nx-fs-records nx) fs (nx-fs-nodes nx) (mapcar #'cdr fs-nodes)))))
        (multiple-value-bind (records nodes) (walk-tree nx (u64 vol 144))
          (setf (nx-extent-records nx) records (nx-extent-nodes nx) (mapcar #'cdr nodes)))
        (setf (nx-snap-node nx) (u64 vol 152)))
      nx)))

(defun bitmap-bit (bitmap n) (ldb (byte 1 (mod n 8)) (aref bitmap (floor n 8))))
(defun (setf bitmap-bit) (v bitmap n) (setf (ldb (byte 1 (mod n 8)) (aref bitmap (floor n 8))) v))

(defun alloc-block (nx)
  (loop for n from (nx-low nx) below (nx-block-count nx)
        when (zerop (bitmap-bit (nx-bitmap nx) n))
          do (setf (bitmap-bit (nx-bitmap nx) n) 1 (nx-low nx) (1+ n)) (return n)
        finally (fail "the container is full")))

(defun alloc-ip-block (nx)
  (loop for n from 0 below (nx-ip-count nx)
        when (zerop (bitmap-bit (nx-ip-bitmap nx) n))
          do (setf (bitmap-bit (nx-ip-bitmap nx) n) 1) (return (+ (nx-ip-base nx) n))
        finally (fail "the internal pool is full")))

(defun alloc-extent (nx count)
  (loop with start = (nx-low nx)
        while (<= (+ start count) (nx-block-count nx))
        do (let ((used (loop for n from start below (+ start count)
                             unless (zerop (bitmap-bit (nx-bitmap nx) n)) return n)))
             (if used
                 (setf start (1+ used))
                 (progn (loop for n from start below (+ start count) do (setf (bitmap-bit (nx-bitmap nx) n) 1))
                        (when (= start (nx-low nx)) (setf (nx-low nx) (+ start count)))
                        (return start))))
        finally (fail "no ~d free blocks in a row" count)))

(defun free-count (nx)
  (loop for n below (nx-block-count nx) count (zerop (bitmap-bit (nx-bitmap nx) n))))

(defun coalesce (xid blocks)
  (let ((runs nil))
    (dolist (b (sort (copy-list blocks) #'<))
      (if (and runs (= b (+ (second (first runs)) (third (first runs)))))
          (incf (third (first runs)))
          (push (list xid b 1) runs)))
    (nreverse runs)))

(defun fq-tree (oid xid entries)
  (unless (fits-p entries t t 16 8)
    (fail "free queue of ~d ranges is more than one node holds" (length entries)))
  (btree-node oid xid (logior +obj-ephemeral+ 2) 9
              (mapcar (lambda (e) (cons (octets (le (first e) 8) (le (second e) 8)) (le (third e) 8))) entries)
              :fixed t :key-size 16 :value-size 8 :info-flags #xe :leaf t :root t))

(defun ring-next (nx kind)
  (ecase kind
    (:desc (prog1 (+ (nx-desc-base nx) (nx-desc-next nx))
             (setf (nx-desc-next nx) (mod (1+ (nx-desc-next nx)) (nx-desc-blocks nx)))))
    (:data (prog1 (+ (nx-data-base nx) (nx-data-next nx))
             (setf (nx-data-next nx) (mod (1+ (nx-data-next nx)) (nx-data-blocks nx)))))))

(defun omap-object (paddr xid tree flags)
  (let ((om (new-block)))
    (object-header om paddr xid (logior +obj-physical+ #xb))
    (put-u32 om 32 flags)
    (put-u32 om 40 (logior +obj-physical+ 2)) (put-u32 om 44 (logior +obj-physical+ 2))
    (put-u64 om 48 tree)
    (seal om)))

(defun omap-records (entries)
  (mapcar (lambda (e) (cons (octets (le (first e) 8) (le (second e) 8))
                            (octets (le 0 4) (le +block-size+ 4) (le (third e) 8))))
          (sort (copy-list entries) (lambda (a b) (or (< (first a) (first b)) (and (= (first a) (first b)) (< (second a) (second b))))))))

(defvar *clock* nil)

(defun now-ns ()
  (if *clock*
      (funcall *clock*)
      (multiple-value-bind (sec usec) (sb-ext:get-time-of-day) (+ (* sec 1000000000) (* usec 1000)))))

(defun commit (nx &key (modified-by "finch") also-free)
  (let* ((xid (1+ (nx-xid nx)))
         (sm (nx-sm nx))
         (writes nil))
    (flet ((put (n v) (push (cons n v) writes)))
      (dolist (e (nx-ip-fq nx))
        (loop for b from (second e) below (+ (second e) (third e)) do (setf (bitmap-bit (nx-ip-bitmap nx) (- b (nx-ip-base nx))) 0)))
      (dolist (e (nx-main-fq nx))
        (loop for b from (second e) below (+ (second e) (third e)) do (setf (bitmap-bit (nx-bitmap nx) b) 0))
        (setf (nx-low nx) (min (nx-low nx) (second e))))
      (setf (nx-ip-fq nx) (coalesce xid (cons (nx-cib-paddr nx) (nx-bitmap-paddrs nx))))
      (let ((main (coalesce xid (append (list (nx-omap-paddr nx) (nx-vol-paddr nx) (nx-vol-omap-paddr nx) (nx-snap-node nx))
                                        (nx-omap-nodes nx) (nx-vol-omap-nodes nx) (nx-fs-nodes nx) (nx-extent-nodes nx)
                                        also-free (shiftf (nx-carry nx) nil)))))
        (loop :until (fits-p main t t 16 8)
              :do (destructuring-bind (x start count) (car (last main))
                    (declare (ignore x))
                    (loop :for b :from start :below (+ start count) :do (push b (nx-carry nx)))
                    (setf main (butlast main))))
        (setf (nx-main-fq nx) main))
      (let* ((alloc (lambda () (alloc-block nx)))
             (virtual (nx-next-oid nx))
             (fs-nodes (pack-btree (sort-fs-records (nx-fs-records nx)) :info-flags #x42 :subtype #xe :xid xid
                                                                         :next-oid (lambda () (prog1 virtual (incf virtual)))))
             (fs-blocks (loop for nil in fs-nodes collect (funcall alloc)))
             (vol-omap-nodes (pack-btree (omap-records (loop for (oid) in fs-nodes for b in fs-blocks collect (list oid xid b)))
                                         :fixed t :key-size 16 :value-size 16 :info-flags #x12 :subtype #xb
                                         :physical t :xid xid :next-oid alloc))
             (vol-omap (funcall alloc))
             (extent-nodes (pack-btree (nx-extent-records nx) :info-flags #x52 :subtype #xf :physical t :xid xid :next-oid alloc))
             (snap-nodes (pack-btree nil :info-flags #x52 :subtype #x10 :physical t :xid xid :next-oid alloc))
             (vol-block (funcall alloc))
             (vol (nx-vol-sb nx))
             (data-blocks (reduce #'+ (nx-extent-records nx) :key (lambda (r) (logand (u64 (cdr r) 0) #x0fffffffffffffff)))))
        (loop for (nil nil . node) in fs-nodes for b in fs-blocks do (put b node))
        (loop for (oid nil . node) in (append vol-omap-nodes extent-nodes snap-nodes) do (put oid node))
        (put vol-omap (omap-object vol-omap xid (first (first vol-omap-nodes)) 0))
        (object-header vol (nx-vol-oid nx) xid #xd)
        (put-u64 vol 88 (+ 1 (length vol-omap-nodes) (length extent-nodes) (length snap-nodes) (length fs-nodes) data-blocks))
        (put-u64 vol 128 vol-omap) (put-u64 vol 136 (first (first fs-nodes)))
        (put-u64 vol 144 (first (first extent-nodes))) (put-u64 vol 152 (first (first snap-nodes)))
        (put-u64 vol 256 (now-ns))
        (fill vol 0 :start 320 :end 368)
        (put-bytes vol 320 (subseq (c-octets modified-by) 0 (min 32 (length (c-octets modified-by)))))
        (put-u64 vol 352 (now-ns)) (put-u64 vol 360 xid)
        (put vol-block (seal vol))
        (setf (nx-omap-entries nx) (cons (list (nx-vol-oid nx) xid vol-block)
                                         (remove (nx-vol-oid nx) (nx-omap-entries nx) :key #'first)))
        (let* ((omap-nodes (pack-btree (omap-records (nx-omap-entries nx)) :fixed t :key-size 16 :value-size 16
                                                                          :info-flags #x12 :subtype #xb :physical t :xid xid :next-oid alloc))
               (omap (funcall alloc)))
          (loop for (oid nil . node) in omap-nodes do (put oid node))
          (put omap (omap-object omap xid (first (first omap-nodes)) 1))
          (setf (nx-omap-paddr nx) omap (nx-omap-nodes nx) (mapcar #'first omap-nodes)))
        (setf (nx-vol-paddr nx) vol-block (nx-vol-omap-paddr nx) vol-omap
              (nx-vol-omap-nodes nx) (mapcar #'first vol-omap-nodes)
              (nx-fs-nodes nx) fs-blocks (nx-extent-nodes nx) (mapcar #'first extent-nodes)
              (nx-snap-node nx) (first (first snap-nodes))
              (nx-next-oid nx) virtual))
      (let* ((chunks (length (nx-bitmap-paddrs nx)))
             (cib-block (alloc-ip-block nx))
             (bitmap-blocks (loop repeat chunks collect (alloc-ip-block nx)))
             (free (free-count nx))
             (slot (u16 sm (u32 sm 328)))
             (free-next (u32 sm 332))
             (new-slot (u16 sm 320))
             (cib (new-block)))
        (object-header cib cib-block xid (logior +obj-physical+ 7))
        (put-u32 cib 36 chunks)
        (loop for c from 0
              for block in bitmap-blocks
              for start = (* c 32768)
              for count = (min 32768 (- (nx-block-count nx) start))
              for at = (+ 40 (* 32 c))
              do (put block (subseq (nx-bitmap nx) (* c +block-size+) (* (1+ c) +block-size+)))
                 (put-u64 cib at xid) (put-u64 cib (+ at 8) start) (put-u32 cib (+ at 16) count)
                 (put-u32 cib (+ at 20) (loop for n from start below (+ start count) count (zerop (bitmap-bit (nx-bitmap nx) n))))
                 (put-u64 cib (+ at 24) block))
        (put cib-block (seal cib))
        (put-u16 sm 320 (u16 sm (+ free-next (* 2 new-slot))))
        (put-u16 sm (+ free-next (* 2 new-slot)) #xffff)
        (put-u16 sm (+ free-next (* 2 (u16 sm 322))) slot)
        (put-u16 sm 322 slot)
        (put-u16 sm (+ free-next (* 2 slot)) #xffff)
        (put-u16 sm (u32 sm 328) new-slot)
        (put-u64 sm (u32 sm 324) xid)
        (put (+ (nx-ip-bm-base nx) new-slot) (copy-seq (nx-ip-bitmap nx)))
        (setf (nx-cib-paddr nx) cib-block (nx-bitmap-paddrs nx) bitmap-blocks)
        (put-u64 sm (u32 sm 80) cib-block)
        (put-u64 sm 72 free)))
    (let* ((data-start (nx-data-next nx))
           (ephemeral nil))
      (loop for (oid entries at) in `((,(first (nx-fq-oids nx)) ,(nx-ip-fq nx) 200) (,(second (nx-fq-oids nx)) ,(nx-main-fq nx) 240))
            for i from 0
            do (let ((oid (if (plusp oid) oid (prog1 (nx-next-oid nx) (incf (nx-next-oid nx))))))
                 (setf (nth i (nx-fq-oids nx)) oid)
                 (put-u64 sm at (reduce #'+ entries :key #'third))
                 (put-u64 sm (+ at 8) oid)
                 (put-u64 sm (+ at 16) (if entries (reduce #'min entries :key #'first) 0))
                 (let ((paddr (ring-next nx :data)))
                   (push (list (logior +obj-ephemeral+ 2) 9 oid paddr) ephemeral)
                   (push (cons paddr (fq-tree oid xid entries)) writes))))
      (object-header sm (u64 (nx-sb nx) 152) xid (logior +obj-ephemeral+ 5))
      (let ((paddr (ring-next nx :data)))
        (push (list (logior +obj-ephemeral+ 5) 0 (u64 (nx-sb nx) 152) paddr) ephemeral)
        (push (cons paddr (seal (copy-seq sm))) writes))
      (let ((reaper (nx-reaper nx)) (paddr (ring-next nx :data)))
        (object-header reaper (u64 (nx-sb nx) 168) xid (logior +obj-ephemeral+ #x11))
        (push (list (logior +obj-ephemeral+ #x11) 0 (u64 (nx-sb nx) 168) paddr) ephemeral)
        (push (cons paddr (seal (copy-seq reaper))) writes))
      (setf ephemeral (nreverse ephemeral))
      (let* ((cpm-index (nx-desc-next nx))
             (cpm-block (ring-next nx :desc))
             (sb-block (ring-next nx :desc))
             (cpm (new-block))
             (sb (nx-sb nx)))
        (object-header cpm cpm-block xid (logior +obj-physical+ #xc))
        (put-u32 cpm 32 1) (put-u32 cpm 36 (length ephemeral))
        (loop for (type subtype oid paddr) in ephemeral
              for at from 40 by 40
              do (put-u32 cpm at type) (put-u32 cpm (+ at 4) subtype) (put-u32 cpm (+ at 8) +block-size+)
                 (put-u64 cpm (+ at 24) oid) (put-u64 cpm (+ at 32) paddr))
        (seal cpm)
        (object-header sb 1 xid (logior +obj-ephemeral+ 1))
        (put-u64 sb 88 (nx-next-oid nx)) (put-u64 sb 96 (1+ xid))
        (put-u32 sb 128 (nx-desc-next nx)) (put-u32 sb 132 (nx-data-next nx))
        (put-u32 sb 136 cpm-index) (put-u32 sb 140 2)
        (put-u32 sb 144 data-start) (put-u32 sb 148 (length ephemeral))
        (put-u64 sb 160 (nx-omap-paddr nx))
        (seal sb)
        (dolist (w (reverse writes)) (nx-put nx (car w) (cdr w)))
        (nx-put nx cpm-block cpm)
        (nx-put nx sb-block sb)
        (when (nx-flush nx) (funcall (nx-flush nx)))
        (nx-put nx 0 sb)
        (when (nx-flush nx) (funcall (nx-flush nx)))
        (setf (nx-xid nx) xid)))
    xid))
