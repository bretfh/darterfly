(defpackage #:finch/apfs
  (:use #:cl)
  (:local-nicknames (#:vfs #:finch/vfs))
  (:export
   #:apfs-error #:open-container #:file-device
   #:container #:container-block-size #:container-uuid #:container-xid #:container-volumes
   #:volume #:volume-name #:volume-uuid #:volume-role #:volume-case-insensitive-p
   #:+root-dir-ino-num+ #:lookup #:inode #:directory-entries #:read-file #:readlink
   #:inode-id #:inode-parent-id #:inode-mode #:inode-nlink #:inode-owner #:inode-group
   #:inode-size #:inode-name #:inode-mod-time #:inode-private-id
   #:entry-name #:entry-file-id #:entry-type #:volume-index #:volume-formatted-by #:volume-incompatible-features
   #:container-size #:mount-volume #:mount-volumes #:newfs #:file-store #:open-writable #:commit #:mount-writable #:*clock*))
(in-package #:finch/apfs)

(define-condition apfs-error (error)
  ((text :initarg :text :reader apfs-error-text))
  (:report (lambda (c s) (write-string (apfs-error-text c) s))))

(defun fail (format &rest args) (error 'apfs-error :text (apply #'format nil format args)))

(defconstant +nx-magic+ #x4253584e)
(defconstant +apfs-magic+ #x42535041)
(defconstant +root-dir-ino-num+ 2)
(defconstant +object-type-nx-superblock+ 1)
(defconstant +btnode-root+ 1)
(defconstant +btnode-leaf+ 2)
(defconstant +btnode-fixed-kv-size+ 4)
(defconstant +apfs-type-inode+ 3)
(defconstant +apfs-type-xattr+ 4)
(defconstant +apfs-type-file-extent+ 8)
(defconstant +apfs-type-dir-rec+ 9)
(defconstant +ino-ext-type-name+ 4)
(defconstant +ino-ext-type-dstream+ 8)
(defconstant +xattr-data-embedded+ 2)

(defun u8 (v at) (aref v at))
(defun u16 (v at) (logior (aref v at) (ash (aref v (1+ at)) 8)))
(defun u32 (v at) (logior (u16 v at) (ash (u16 v (+ at 2)) 16)))
(defun u64 (v at) (logior (u32 v at) (ash (u32 v (+ at 4)) 32)))

(defun utf-8 (v start end) (sb-ext:octets-to-string v :external-format :utf-8 :start start :end end))

(defun c-string (v start end)
  (utf-8 v start (or (position 0 v :start start :end end) end)))

(defun uuid-string (v at)
  (format nil "~{~2,'0X~}-~{~2,'0X~}-~{~2,'0X~}-~{~2,'0X~}-~{~2,'0X~}"
          (coerce (subseq v at (+ at 4)) 'list) (coerce (subseq v (+ at 4) (+ at 6)) 'list)
          (coerce (subseq v (+ at 6) (+ at 8)) 'list) (coerce (subseq v (+ at 8) (+ at 10)) 'list)
          (coerce (subseq v (+ at 10) (+ at 16)) 'list)))

(defun fletcher-64 (block)
  (let ((sum1 0) (sum2 0))
    (declare (type (unsigned-byte 64) sum1 sum2))
    (loop for at from 8 below (length block) by 4
          do (setf sum1 (mod (+ sum1 (u32 block at)) #xffffffff)
                   sum2 (mod (+ sum2 sum1) #xffffffff)))
    (let* ((c1 (- #xffffffff (mod (+ sum1 sum2) #xffffffff)))
           (c2 (- #xffffffff (mod (+ sum1 c1) #xffffffff))))
      (logior (ash c2 32) c1))))

(defun object-valid-p (block) (= (u64 block 0) (fletcher-64 block)))
(defun object-xid (block) (u64 block 16))
(defun object-type (block) (logand (u32 block 24) #xffff))

(defun file-device (path &key (offset 0))
  (lambda (at length)
    (with-open-file (s path :element-type '(unsigned-byte 8))
      (file-position s (+ offset at))
      (let ((v (make-array length :element-type '(unsigned-byte 8))))
        (read-sequence v s)
        v))))

(defstruct container device block-size uuid xid omap volumes superblock)

(defun read-block (container n)
  (funcall (container-device container) (* n (container-block-size container)) (container-block-size container)))

(defun read-object (container paddr)
  (let ((block (read-block container paddr)))
    (unless (object-valid-p block) (fail "object at block ~d fails its checksum" paddr))
    block))

(defstruct (node (:constructor %make-node)) block flags level count toc keys values-end)

(defun make-node (block)
  (let* ((flags (u16 block 32))
         (table (+ 56 (u16 block 40))))
    (%make-node :block block :flags flags :level (u16 block 34) :count (u32 block 36)
                :toc table :keys (+ table (u16 block 42))
                :values-end (- (length block) (if (logtest flags +btnode-root+) 40 0)))))

(defun node-leaf-p (node) (logtest (node-flags node) +btnode-leaf+))

(defun node-entry (node i &optional (key-size 16) (value-size 16))
  (let ((b (node-block node)))
    (if (logtest (node-flags node) +btnode-fixed-kv-size+)
        (let ((at (+ (node-toc node) (* 4 i))))
          (values (+ (node-keys node) (u16 b at)) key-size
                  (- (node-values-end node) (u16 b (+ at 2))) (if (node-leaf-p node) value-size 8)))
        (let ((at (+ (node-toc node) (* 8 i))))
          (values (+ (node-keys node) (u16 b at)) (u16 b (+ at 2))
                  (- (node-values-end node) (u16 b (+ at 4))) (u16 b (+ at 6)))))))

(defun omap-lookup (container omap-root oid xid)
  (let ((node (make-node (read-object container omap-root))))
    (loop
      (let ((b (node-block node)) (found nil))
        (dotimes (i (node-count node))
          (let* ((k (node-entry node i))
                 (koid (u64 b k)) (kxid (u64 b (+ k 8))))
            (when (or (< koid oid) (and (= koid oid) (<= kxid xid)))
              (setf found i))))
        (unless found (return nil))
        (multiple-value-bind (k ks v) (node-entry node found)
          (declare (ignore ks))
          (cond ((node-leaf-p node)
                 (return (and (= (u64 b k) oid) (not (logtest (u32 b v) 1)) (u64 b (+ v 8)))))
                (t (setf node (make-node (read-object container (u64 b v)))))))))))

(defun omap-root (container omap-oid)
  (u64 (read-object container omap-oid) 48))

(defun checkpoint-superblock (device)
  (let* ((zero (funcall device 0 4096))
         (block-size (u32 zero 36)))
    (unless (= (u32 zero 32) +nx-magic+) (fail "no APFS container here"))
    (let* ((zero (funcall device 0 block-size))
           (base (u64 zero 112))
           (blocks (logand (u32 zero 104) #x7fffffff))
           (best zero))
      (dotimes (i blocks)
        (let ((b (funcall device (* (+ base i) block-size) block-size)))
          (when (and (= (object-type b) +object-type-nx-superblock+)
                     (= (u32 b 32) +nx-magic+)
                     (object-valid-p b)
                     (> (object-xid b) (object-xid best)))
            (setf best b))))
      (unless (object-valid-p best) (fail "no valid container superblock"))
      (values best block-size))))

(defstruct volume container superblock name uuid role omap root-tree xid case-insensitive-p hashed-p)

(defun volume-index (v) (u32 (volume-superblock v) 36))
(defun volume-formatted-by (v) (c-string (volume-superblock v) 272 304))
(defun volume-incompatible-features (v) (u64 (volume-superblock v) 56))
(defun container-size (c) (* (container-block-size c) (u64 (container-superblock c) 40)))

(defun open-container (device)
  (multiple-value-bind (sb block-size) (checkpoint-superblock device)
    (let ((c (make-container :device device :block-size block-size :superblock sb
                             :uuid (uuid-string sb 72) :xid (object-xid sb))))
      (setf (container-omap c) (omap-root c (u64 sb 160)))
      (setf (container-volumes c)
            (loop for i below (u32 sb 180)
                  for oid = (u64 sb (+ 184 (* 8 i)))
                  unless (zerop oid)
                    collect (open-volume c (or (omap-lookup c (container-omap c) oid (container-xid c))
                                               (fail "volume ~d has no object map entry" oid)))))
      c)))

(defun open-volume (c paddr)
  (let ((sb (read-object c paddr)))
    (unless (= (u32 sb 32) +apfs-magic+) (fail "block ~d is not a volume superblock" paddr))
    (let* ((incompat (u64 sb 56))
           (v (make-volume :container c :superblock sb :name (c-string sb 704 960) :uuid (uuid-string sb 240)
                           :role (u16 sb 964) :xid (container-xid c)
                           :case-insensitive-p (logtest incompat 1)
                           :hashed-p (logtest incompat 9))))
      (setf (volume-omap v) (omap-root c (u64 sb 128)))
      (setf (volume-root-tree v) (u64 sb 136))
      v)))

(defun fs-node (v oid)
  (let ((c (volume-container v)))
    (make-node (read-object c (or (omap-lookup c (volume-omap v) oid (volume-xid v))
                                  (fail "fs tree node ~d has no object map entry" oid))))))

(defun key-oid (b k) (logand (u64 b k) #x0fffffffffffffff))
(defun key-type (b k) (ash (u64 b k) -60))

(defun compare-id (oid type woid wtype)
  (cond ((< oid woid) -1) ((> oid woid) 1) ((< type wtype) -1) ((> type wtype) 1) (t 0)))

(defun fs-records (v oid type)
  (let ((records nil))
    (labels ((walk (node)
               (let ((b (node-block node)) (n (node-count node)))
                 (dotimes (i n)
                   (let* ((k (node-entry node i))
                          (here (compare-id (key-oid b k) (key-type b k) oid type)))
                     (if (node-leaf-p node)
                         (when (zerop here)
                           (multiple-value-bind (k ks vo vs) (node-entry node i)
                             (push (cons (subseq b k (+ k ks)) (subseq b vo (+ vo vs))) records)))
                         (when (and (<= here 0)
                                    (or (= i (1- n))
                                        (let ((next (node-entry node (1+ i))))
                                          (>= (compare-id (key-oid b next) (key-type b next) oid type) 0))))
                           (multiple-value-bind (k ks vo) (node-entry node i)
                             (declare (ignore k ks))
                             (walk (fs-node v (u64 b vo)))))))))))
      (walk (fs-node v (volume-root-tree v))))
    (nreverse records)))

(defstruct inode id parent-id private-id create-time mod-time change-time access-time nlink owner group mode size name xfields)

(defun xfields (v at end)
  (when (< (+ at 4) end)
    (let* ((n (u16 v at))
           (data (+ at 4 (* 4 n))))
      (loop for i below n
            for type = (u8 v (+ at 4 (* 4 i)))
            for size = (u16 v (+ at 6 (* 4 i)))
            collect (cons type (subseq v data (+ data size)))
            do (incf data (* 8 (ceiling size 8)))))))

(defun inode (v id)
  (let ((record (first (fs-records v id +apfs-type-inode+))))
    (unless record (fail "no inode ~d" id))
    (let* ((val (cdr record))
           (fields (xfields val 92 (length val)))
           (dstream (cdr (assoc +ino-ext-type-dstream+ fields)))
           (name (cdr (assoc +ino-ext-type-name+ fields))))
      (make-inode :id id :parent-id (u64 val 0) :private-id (u64 val 8)
                  :create-time (u64 val 16) :mod-time (u64 val 24) :change-time (u64 val 32) :access-time (u64 val 40)
                  :nlink (u32 val 56) :owner (u32 val 72) :group (u32 val 76) :mode (u16 val 80)
                  :size (if dstream (u64 dstream 0) 0)
                  :name (and name (c-string name 0 (length name)))
                  :xfields fields))))

(defstruct (dir-entry (:conc-name entry-)) name file-id type)

(defun directory-entries (v id)
  (loop for (key . val) in (fs-records v id +apfs-type-dir-rec+)
        collect (make-dir-entry :name (if (volume-hashed-p v)
                                          (c-string key 12 (+ 12 (logand (u32 key 8) #x3ff)))
                                          (c-string key 10 (+ 10 (u16 key 8))))
                                :file-id (u64 val 0)
                                :type (logand (u16 val 16) #xf))))

(defun name-equal (v a b)
  (if (volume-case-insensitive-p v) (string-equal a b) (string= a b)))

(defun lookup (v path)
  (let ((id +root-dir-ino-num+))
    (dolist (part (remove "" (uiop:split-string path :separator "/") :test #'string=) id)
      (unless (string= part ".")
        (let ((entry (find part (directory-entries v id) :key #'entry-name :test (lambda (a b) (name-equal v a b)))))
          (unless entry (return nil))
          (setf id (entry-file-id entry)))))))

(defun read-file (v id &key (start 0) end)
  (let* ((ino (inode v id))
         (end (min (or end (inode-size ino)) (inode-size ino)))
         (out (make-array (max 0 (- end start)) :element-type '(unsigned-byte 8) :initial-element 0))
         (c (volume-container v))
         (bs (container-block-size c)))
    (loop for (key . val) in (fs-records v (inode-private-id ino) +apfs-type-file-extent+)
          for logical = (u64 key 8)
          for length = (logand (u64 val 0) #x00ffffffffffffff)
          for physical = (u64 val 8)
          for from = (max start logical)
          for to = (min end (+ logical length))
          when (and (< from to) (plusp physical))
            do (let ((data (funcall (container-device c) (+ (* physical bs) (- from logical)) (- to from))))
                 (replace out data :start1 (- from start))))
    out))

(defun readlink (v id)
  (loop for (key . val) in (fs-records v id +apfs-type-xattr+)
        when (string= (c-string key 10 (+ 10 (u16 key 8))) "com.apple.fs.symlink")
          return (if (logtest (u16 val 0) +xattr-data-embedded+)
                     (c-string val 4 (+ 4 (u16 val 2)))
                     (fail "symlink ~d keeps its target in a data stream" id))))
