(in-package #:finch/vfs)

(defparameter +errno+
  '((:eperm . 1) (:enoent . 2) (:eintr . 4) (:eio . 5) (:ebadf . 9) (:eacces . 13) (:ebusy . 16) (:eexist . 17)
    (:exdev . 18) (:enotdir . 20) (:eisdir . 21) (:einval . 22) (:emfile . 24) (:enotty . 25) (:espipe . 29)
    (:erofs . 30) (:erange . 34) (:enametoolong . 36) (:enosys . 38) (:enotempty . 39) (:eloop . 40) (:enotsup . 95)))

(defun errno-code (errno) (or (cdr (assoc errno +errno+)) 5))

(defparameter +ops+
  #(nil :open :close :read :write :pread :pwrite :lseek :stat :lstat :fstat :readlink :symlink :mkdir :rmdir
    :unlink :rename :chdir :fchdir :getcwd :realpath :chmod :fchmod :chown :fchown :truncate :ftruncate :dup :dup2
    :fcntl :readdir :link :utimes :fsync :umask))

(defun c-string (address)
  (let* ((sap (sb-sys:int-sap address))
         (n (loop for i from 0 until (zerop (sb-sys:sap-ref-8 sap i)) finally (return i)))
         (v (make-array n :element-type '(unsigned-byte 8))))
    (sb-sys:with-pinned-objects (v) (sb-kernel:system-area-ub8-copy sap 0 (sb-sys:vector-sap v) 0 n))
    (sb-ext:octets-to-string v :external-format :utf-8)))

(defun put-octets (octets address &optional (limit (length octets)))
  (let ((n (min limit (length octets)))
        (v (coerce octets '(simple-array (unsigned-byte 8) (*)))))
    (sb-sys:with-pinned-objects (v) (sb-kernel:system-area-ub8-copy (sb-sys:vector-sap v) 0 (sb-sys:int-sap address) 0 n))
    n))

(defun get-octets (address n)
  (let ((v (make-array n :element-type '(unsigned-byte 8))))
    (sb-sys:with-pinned-objects (v) (sb-kernel:system-area-ub8-copy (sb-sys:int-sap address) 0 (sb-sys:vector-sap v) 0 n))
    v))

(defun put-string (string address size)
  (let ((octets (sb-ext:string-to-octets string :external-format :utf-8 :null-terminate t)))
    (when (> (length octets) size) (fail :erange))
    (put-octets octets address)
    (1- (length octets))))

(defun open-flags (flags)
  (list :access (ecase (logand flags 3) (0 :rdonly) (1 :wronly) (2 :rdwr))
        :creat (logtest flags #o100) :excl (logtest flags #o200) :trunc (logtest flags #o1000)
        :append (logtest flags #o2000) :nonblock (logtest flags #o4000) :directory (logtest flags #o200000)))

(defun libsa-flags (flags)
  (logior (ecase (getf flags :access) (:rdonly 0) (:wronly 1) (:rdwr 2))
          (if (getf flags :append) #o2000 0) (if (getf flags :nonblock) #o4000 0)))

(defun put-stat (attr vnode address)
  (let ((sap (sb-sys:int-sap address))
        (mtime (vattr-mtime attr)))
    (dotimes (i 144) (setf (sb-sys:sap-ref-8 sap i) 0))
    (setf (sb-sys:sap-ref-64 sap 8) (vnode-id vnode)
          (sb-sys:sap-ref-64 sap 16) (vattr-nlink attr)
          (sb-sys:sap-ref-32 sap 24) (vattr-mode attr)
          (sb-sys:sap-ref-32 sap 28) (logand (vattr-uid attr) #xffffffff)
          (sb-sys:sap-ref-32 sap 32) (logand (vattr-gid attr) #xffffffff)
          (sb-sys:sap-ref-64 sap 40) (vattr-rdev attr)
          (sb-sys:sap-ref-64 sap 48) (vattr-size attr)
          (sb-sys:sap-ref-64 sap 56) 4096
          (sb-sys:sap-ref-64 sap 64) (ceiling (vattr-size attr) 512))
    (loop for at in '(72 88 104)
          do (setf (sb-sys:sap-ref-64 sap at) (floor mtime 1000000000)
                   (sb-sys:sap-ref-64 sap (+ at 8)) (mod mtime 1000000000)))
    0))

(defun put-dirent (name vnode address)
  (let ((sap (sb-sys:int-sap address))
        (octets (sb-ext:string-to-octets name :external-format :utf-8 :null-terminate t)))
    (setf (sb-sys:sap-ref-64 sap 0) (vnode-id vnode)
          (sb-sys:sap-ref-64 sap 8) 0
          (sb-sys:sap-ref-16 sap 16) 280
          (sb-sys:sap-ref-8 sap 18) (case (vnode-type vnode) (:vdir 4) (:vreg 8) (:vlnk 10) (:vchr 2) (t 0)))
    (put-octets octets (+ address 19) 256)
    1))

(defun signed (n) (if (logbitp 63 n) (- n (ash 1 64)) n))

(defun vfs-call (op a b c d)
  (ecase op
    (:open (vfs-open (c-string a) (open-flags b) c))
    (:close (vfs-close a))
    (:read (put-octets (vfs-read a c) b))
    (:write (vfs-write a (get-octets b c)))
    (:pread (put-octets (vfs-read a c (signed d)) b))
    (:pwrite (vfs-write a (get-octets b c) (signed d)))
    (:lseek (vfs-lseek a (signed b) c))
    (:stat (let ((v (namei (c-string a)))) (put-stat (vnop-getattr v) v b)))
    (:lstat (let ((v (namei (c-string a) :follow nil))) (put-stat (vnop-getattr v) v b)))
    (:fstat (let ((v (file-vnode (fd-file a)))) (put-stat (vnop-getattr v) v b)))
    (:readlink (put-octets (sb-ext:string-to-octets (vfs-readlink (c-string a)) :external-format :utf-8) b c))
    (:symlink (vfs-symlink (c-string a) (c-string b)))
    (:mkdir (vfs-mkdir (c-string a) b))
    (:rmdir (vfs-remove (c-string a) t))
    (:unlink (vfs-remove (c-string a) nil))
    (:rename (vfs-rename (c-string a) (c-string b)))
    (:chdir (vfs-chdir (c-string a)))
    (:fchdir (vfs-fchdir a))
    (:getcwd (put-string (vfs-getcwd) a b))
    (:realpath (put-string (vfs-realpath (c-string a)) b c))
    (:chmod (vnop-setattr (namei (c-string a)) :mode b))
    (:fchmod (vnop-setattr (file-vnode (fd-file a)) :mode b))
    (:chown (vnop-setattr (namei (c-string a)) :uid (signed b) :gid (signed c)))
    (:fchown (vnop-setattr (file-vnode (fd-file a)) :uid (signed b) :gid (signed c)))
    (:truncate (vnop-truncate (namei (c-string a)) b) 0)
    (:ftruncate (vnop-truncate (file-vnode (fd-file a)) b) 0)
    (:dup (vfs-dup a))
    (:dup2 (vfs-dup2 a b))
    (:fcntl (let ((f (fd-file a)))
              (case b
                (0 (vfs-dup a c))
                (3 (libsa-flags (file-flags f)))
                (4 (setf (getf (file-flags f) :append) (logtest c #o2000)
                         (getf (file-flags f) :nonblock) (logtest c #o4000))
                   0)
                (t 0))))
    (:readdir (let ((entry (vfs-readdir a b)))
                (if entry (put-dirent (car entry) (cdr entry) c) 0)))
    (:link (fail :enotsup))
    (:utimes (namei (c-string a)) 0)
    (:fsync (fd-file a) 0)
    (:umask (prog1 *umask* (setf *umask* (logand a #o777))))))

(defun vfs-entry (op a b c d)
  (sb-sys:without-interrupts
    (handler-case (or (vfs-call (aref +ops+ op) a b c d) 0)
      (vfs-error (e) (- (errno-code (vfs-errno e))))
      (error () (- (errno-code :eio))))))

(defvar *entry* nil)

(defun machdep-pair (n)
  (let ((pair (sb-alien:make-alien (sb-alien:unsigned 64) 2)))
    (unwind-protect
         (progn
           (sb-alien:alien-funcall
            (sb-alien:extern-alien "__machdep" (function sb-alien:long sb-alien:long sb-alien:long sb-alien:long))
            n (sb-sys:sap-int (sb-alien:alien-sap pair)) 0)
           (values (sb-alien:deref pair 0) (sb-alien:deref pair 1)))
      (sb-alien:free-alien pair))))

(defun vfs-start ()
  (let ((root (make-ram-node :vdir #o755)))
    (vfs-mount root "/")
    (let ((dev (mkdirs root "/dev")))
      (add-child dev "console" (make-instance 'dev-node :type :vchr :device :console :mode #o620))
      (add-child dev "tty" (make-instance 'dev-node :type :vchr :device :console :mode #o666))
      (add-child dev "null" (make-instance 'dev-node :type :vchr :device :null :mode #o666)))
    (mkdirs root "/tmp")
    (mkdirs root "/Volumes")
    (multiple-value-bind (address size) (machdep-pair 6)
      (let ((k (vnop-create (mkdirs root "/System/Library/Kernels") "kernel" #o555)))
        (setf (node-external k) (sb-sys:int-sap address) (node-size k) size)))
    (multiple-value-bind (address size) (machdep-pair 7)
      (when (plusp address) (load-cpio root (sb-sys:int-sap address) size)))
    (let ((console (vnop-lookup (vnop-lookup root "dev") "console")))
      (dotimes (fd 3)
        (setf (gethash fd *files*) (make-file :vnode console :flags (list :access :rdwr)))))
    (setf *entry* (sb-alien::alien-lambda sb-alien:long ((op sb-alien:long) (a sb-alien:unsigned-long) (b sb-alien:unsigned-long)
                                                          (c sb-alien:unsigned-long) (d sb-alien:unsigned-long))
                    (vfs-entry op a b c d)))
    (sb-alien:alien-funcall
     (sb-alien:extern-alien "__libsa_vfs_register" (function sb-alien:void sb-alien:system-area-pointer))
     (sb-alien:alien-sap *entry*))
    root))
