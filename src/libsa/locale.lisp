(define-low iswalpha_l ((c :u32) locale) (iswalpha c))
(define-low iswblank ((c :u32)) (and (< c 128) (isblank c)))
(define-low iswblank_l ((c :u32) locale) (iswblank c))
(define-low iswcntrl ((c :u32)) (and (< c 128) (iscntrl c)))
(define-low iswcntrl_l ((c :u32) locale) (iswcntrl c))
(define-low iswdigit ((c :u32)) (and (< c 128) (isdigit c)))
(define-low iswdigit_l ((c :u32) locale) (iswdigit c))
(define-low iswgraph ((c :u32)) (and (< c 128) (isgraph c)))
(define-low iswgraph_l ((c :u32) locale) (iswgraph c))
(define-low iswlower ((c :u32)) (and (< c 128) (islower c)))
(define-low iswlower_l ((c :u32) locale) (iswlower c))
