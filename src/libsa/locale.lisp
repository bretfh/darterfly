;; C-locale wide characters are ASCII. Reject unrepresentable input with
;; EILSEQ; do not pass UTF-8 bytes through as if they were wide characters.
(define-low wcslen (s)
  (let ((n 0)) (while (mem :u32 (+ s (* 4 n))) (incf n)) n))
(define-low wmemcmp (a b n)
  (while n
    (let ((x (sign-extend :u32 (mem :u32 a)))
          (y (sign-extend :u32 (mem :u32 b))))
      (when (/= x y) (result (if (signed< x y) (- 0 1) 1))))
    (incf a 4) (incf b 4) (decf n)) 0)
(define-low wmemchr (s (c :u32) n)
  (while n (when (= (mem :u32 s) c) (result s)) (incf s 4) (decf n)) 0)
(define-low wmemcpy (d s n) (memcpy d s (* 4 n)))
(define-low wmemmove (d s n) (memmove d s (* 4 n)))
(define-low wmemset (d (c :u32) n)
  (let ((p d)) (while n (setf (mem :u32 p) c) (incf p 4) (decf n))) d)
(define-low wcscmp (a b)
  (while (and (mem :u32 a) (= (mem :u32 a) (mem :u32 b)))
    (incf a 4) (incf b 4))
  (wmemcmp a b 1))
(define-low wcscoll_l (a b locale) (wcscmp a b))
(define-low wcsxfrm_l (d s n locale)
  (let ((len (wcslen s))) (when (> n len) (wmemcpy d s (+ len 1))) len))
(define-low btowc ((c :u32)) (if (< c 128) c #xFFFFFFFF))
(define-low wctob ((c :u32)) (if (< c 128) c #xFFFFFFFF))
(define-low mbsinit (s) 1)
(define-low mbrtowc (wc s n state)
  (when (= s 0) (result 0))
  (when (= n 0) (result (- 0 2)))
  (let ((c (mem :u8 s)))
    (when (>= c 128) (fail-with 84) (result (lognot 0)))
    (when wc (setf (mem :u32 wc) c))
    (if c 1 0)))
(define-low mbrlen (s n state) (mbrtowc 0 s n state))
(define-low mbtowc (wc s n) (mbrtowc wc s n 0))
(define-low mblen (s n) (mbrtowc 0 s n 0))
(define-low wcrtomb (s (wc :u32) state)
  (when (= s 0) (result 1))
  (when (>= wc 128) (fail-with 84) (result (lognot 0)))
  (setf (mem :u8 s) wc) 1)
(define-low wctomb (s (wc :u32)) (if s (wcrtomb s wc 0) 0))
(define-low mbsnrtowcs (dst src bytes n state)
  (let ((p (mem :u64 src)) (done 0))
    (while (and bytes (or (= dst 0) (< done n)))
      (let ((c (mem :u8 p)))
        (when (>= c 128)
          (when dst (setf (mem :u64 src) p))
          (fail-with 84) (result (lognot 0)))
        (when dst (setf (mem :u32 (+ dst (* done 4))) c))
        (when (= c 0) (when dst (setf (mem :u64 src) 0)) (result done)))
      (incf done) (incf p) (decf bytes))
    (when dst (setf (mem :u64 src) p)) done))
(define-low mbsrtowcs (d s n state) (mbsnrtowcs d s (lognot 0) n state))
(define-low mbstowcs (d s n) (mbsrtowcs d (address s) n 0))
(define-low wcsnrtombs (dst src chars n state)
  (let ((p (mem :u64 src)) (done 0))
    (while (and chars (or (= dst 0) (< done n)))
      (let ((c (mem :u32 p)))
        (when (>= c 128)
          (when dst (setf (mem :u64 src) p))
          (fail-with 84) (result (lognot 0)))
        (when dst (setf (mem :u8 (+ dst done)) c))
        (when (= c 0) (when dst (setf (mem :u64 src) 0)) (result done)))
      (incf done) (incf p 4) (decf chars))
    (when dst (setf (mem :u64 src) p)) done))
(define-low wcsrtombs (d s n state) (wcsnrtombs d s (lognot 0) n state))
(define-low wcstombs (d s n) (wcsrtombs d (address s) n 0))
(define-low fputwc ((wc :u32) fp)
  (when (>= wc 128) (fail-with 84) (result #xFFFFFFFF))
  (fputc wc fp))
(define-low getwc (fp)
  (let ((c (the :u32 (fgetc fp))))
    (when (and (/= c #xFFFFFFFF) (>= c 128))
      (setf (mem :u32 (+ fp 8)) 1) (fail-with 84) (result #xFFFFFFFF)) c))
(define-low ungetwc ((wc :u32) fp)
  (if (< wc 128) (ungetc wc fp) #xFFFFFFFF))

;; Numeric wide conversions use the same existing parser, preserving the
;; endpoint in wchar_t units. Non-ASCII terminates a numeric subject sequence.
(define-low wide-numeric-string (s)
  (let* ((n (wcslen s)) (p (malloc (+ n 1))) (i 0))
    (unless p (result 0))
    (while (and (< i n) (< (mem :u32 (+ s (* i 4))) 128))
      (setf (mem :u8 (+ p i)) (mem :u32 (+ s (* i 4)))) (incf i))
    (setf (mem :u8 (+ p i)) 0) p))
(define-low wcstol (s end (base :u32))

  (let ((p (wide-numeric-string s)) (at 0) (v 0))
    (unless p (when end (setf (mem :u64 end) s)) (result 0))
    (setf v (strtol p (address at) base))
    (when end (setf (mem :u64 end) (+ s (* 4 (- at p)))))
    (free p) v))
(define-low wcstoul (s end (base :u32))

  (let ((p (wide-numeric-string s)) (at 0) (v 0))
    (unless p (when end (setf (mem :u64 end) s)) (result 0))
    (setf v (strtoul p (address at) base))
    (when end (setf (mem :u64 end) (+ s (* 4 (- at p)))))
    (free p) v))
(define-low wcstoll (s end (base :u32))

  (let ((p (wide-numeric-string s)) (at 0) (v 0))
    (unless p (when end (setf (mem :u64 end) s)) (result 0))
    (setf v (strtoll p (address at) base))
    (when end (setf (mem :u64 end) (+ s (* 4 (- at p)))))
    (free p) v))
(define-low wcstoull (s end (base :u32))

  (let ((p (wide-numeric-string s)) (at 0) (v 0))
    (unless p (when end (setf (mem :u64 end) s)) (result 0))
    (setf v (strtoull p (address at) base))
    (when end (setf (mem :u64 end) (+ s (* 4 (- at p)))))
    (free p) v))
(define-low wcstod (s end)
  (declare (returns :f64))
  (let ((p (wide-numeric-string s)) (at 0) (v 0))
    (unless p (when end (setf (mem :u64 end) s)) (result 0))
    (setf v (strtod p (address at)))
    (when end (setf (mem :u64 end) (+ s (* 4 (- at p)))))
    (free p) v))
(define-low wcstof (s end)
  (declare (returns :f32-bits))
  (let ((p (wide-numeric-string s)) (at 0) (v 0))
    (unless p (when end (setf (mem :u64 end) s)) (result 0))
    (setf v (strtof p (address at)))
    (when end (setf (mem :u64 end) (+ s (* 4 (- at p)))))
    (free p) v))
(define-low wcstold-bits (s end out)
  (let ((p (wide-numeric-string s)) (at 0))
    (unless p (when end (setf (mem :u64 end) s)) (memset out 0 16) (result 0))
    (strtold-bits p (address at) out)
    (when end (setf (mem :u64 end) (+ s (* 4 (- at p)))))
    (free p) 0))
(defun wcstold-routine ()
  (darterfly/asm:routine "wcstold"
    (darterfly/asm:inst sub darterfly/asm:rsp-tn 24)
    (darterfly/asm:inst mov darterfly/asm:rdx-tn darterfly/asm:rsp-tn)
    (darterfly/asm:inst call (darterfly/asm:external "wcstold_bits"))
    (dolist (b '(#xDB #x2C #x24)) (darterfly/asm:inst byte b))
    (darterfly/asm:inst add darterfly/asm:rsp-tn 24)
    (darterfly/asm:inst ret)))

;; Numeric wide formatting for std::to_wstring. General wide printf remains
;; unsupported: reject text conversions rather than misinterpret their ABI.
(define-low vswprintf (out cap fmt ap)
  (let ((f (wide-numeric-string fmt)) (p 0) (buf 0) (n 0) (i 0))
    (unless f (result (- 0 1)))
    (when (/= (strlen f) (wcslen fmt)) (free f) (fail-with 84) (result (- 0 1)))
    (setf p f)
    (while (mem :u8 p)
      (when (= (mem :u8 p) 37)
        (incf p)
        (while (and (mem :u8 p) (strchr "-+ #0.123456789hljztL*" (mem :u8 p))) (incf p))
        (unless (and (mem :u8 p) (strchr "diouxXaAeEfFgG%" (mem :u8 p)))
          (free f) (fail-with 95) (result (- 0 1))))
      (incf p))
    (setf buf (malloc (if cap cap 1)))
    (unless buf (free f) (result (- 0 1)))
    (setf n (sign-extend :u32 (vsnprintf buf cap f ap)))
    (free f)
    (when (or (signed< n 0) (>= n cap)) (free buf) (result (- 0 1)))
    (while (<= i n) (setf (mem :u32 (+ out (* 4 i))) (mem :u8 (+ buf i))) (incf i))
    (free buf) n))
(define-low swprintf (out cap fmt &va ap) (declare (floats)) (vswprintf out cap fmt ap))
