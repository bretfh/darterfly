(in-package #:darterfly/libsa)

;; The one supported locale is C/POSIX. Locale objects have no mutable state;
;; unsupported names fail instead of silently selecting another locale.
(define-low locale-name-p (name)
  (and name (or (= (strcmp name "C") 0) (= (strcmp name "POSIX") 0)
                (= (mem :u8 name) 0))))
(define-low setlocale ((category :u32) name)
  (when (> category 6) (fail-with +einval+) (result 0))
  (if (or (= name 0) (locale-name-p name)) "C"
      (progn (fail-with +enoent+) 0)))
(define-low newlocale ((mask :u32) name base)
  (when (logand mask (lognot 63)) (fail-with +einval+) (result 0))
  (if (locale-name-p name) 1 (progn (fail-with +enoent+) 0)))
(define-low uselocale (locale)
  (if (or (= locale 0) (= locale 1) (= locale (lognot 0))) 1
      (progn (fail-with +einval+) 0)))
(define-low freelocale (locale) 0)
(define-global c-lconv :u8 :count 96)
(define-global c-lconv-once :u32)
(define-low init-c-lconv ()
  (let ((p (address c-lconv)) (i 0))
    (while (< i 10) (setf (mem :u64 (+ p (* i 8))) "") (incf i))
    (setf (mem :u64 p) ".")
    (memset (+ p 80) 127 14)))
(define-low localeconv ()
  (pthread_once (address c-lconv-once) (code-address init-c-lconv))
  (address c-lconv))
(define-low isascii ((c :u32)) (< c 128))
(define-low isblank ((c :u32)) (or (= c 32) (= c 9)))
(define-low strcoll_l (a b locale) (strcmp a b))
(define-low strxfrm_l (d s n locale)
  (let ((len (strlen s))) (when (> n len) (memcpy d s (+ len 1))) len))
(define-low strftime_l (s n fmt tm locale) (strftime s n fmt tm))
(define-low isalnum_l ((c :u32) locale) (isalnum c))
(define-low isalpha_l ((c :u32) locale) (isalpha c))
(define-low isdigit_l ((c :u32) locale) (isdigit c))
(define-low isxdigit_l ((c :u32) locale) (isxdigit c))
(define-low isspace_l ((c :u32) locale) (isspace c))
(define-low isupper_l ((c :u32) locale) (isupper c))
(define-low islower_l ((c :u32) locale) (islower c))
(define-low isprint_l ((c :u32) locale) (isprint c))
(define-low isgraph_l ((c :u32) locale) (isgraph c))
(define-low ispunct_l ((c :u32) locale) (ispunct c))
(define-low iscntrl_l ((c :u32) locale) (iscntrl c))
(define-low isblank_l ((c :u32) locale) (isblank c))
(define-low toupper_l ((c :u32) locale) (toupper c))
(define-low tolower_l ((c :u32) locale) (tolower c))
(define-low iswalnum ((c :u32)) (and (< c 128) (isalnum c)))
(define-low iswalnum_l ((c :u32) locale) (iswalnum c))
