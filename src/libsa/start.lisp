(in-package #:darterfly/libsa)

(define-low __errno_location () (+ (fs-word 0) 16))

(define-low __libsa_tls_new (self)
  (let* ((align (if (< (absolute "__tls_align") 16) 16 (absolute "__tls_align")))
         (start (absolute "__tdata_start"))
         (data (- (absolute "__tdata_end") start))
         (size (logand (+ (- (absolute "__tbss_end") start) align -1) (lognot (- align 1))))
         (block (aligned_alloc align (+ size 64)))
         (tp (+ block size)))
    (memset block 0 (+ size 64))
    (memcpy block start data)
    (setf (mem :u64 tp) tp)
    (setf (mem :u64 (+ tp 8)) self)
    tp))

(define-global env-storage :u64 :count 65)
(define-global environ :u64 :export t)

(define-low environment-init ()
  (setf (ref env-storage 0) "HOME=/Users/darterfly")
  (setf (ref env-storage 1) "PATH=/bin:/usr/bin")
  (setf (ref env-storage 2) "TERM=dumb")
  (setf (ref env-storage 3) "SBCL_HOME=/usr/lib/sbcl")
  (setf environ (address env-storage)))

(define-low env-match (e name n)
  (and (= (the :u32 (strncmp e name n)) 0) (= (mem :u8 (+ e n)) 61)))

(define-low getenv (name)
  (let ((n (strlen name)) (e environ))
    (while (mem :u64 e)
      (when (env-match (mem :u64 e) name n) (result (+ (mem :u64 e) n 1)))
      (incf e 8))
    0))

(define-low unsetenv (name)
  (let ((n (strlen name)) (e environ) (w environ))
    (while (mem :u64 e)
      (unless (env-match (mem :u64 e) name n)
        (setf (mem :u64 w) (mem :u64 e))
        (incf w 8))
      (incf e 8))
    (setf (mem :u64 w) 0)
    0))

(define-low setenv (name value (overwrite :u32))
  (when (and (getenv name) (= overwrite 0)) (result 0))
  (unsetenv name)
  (let ((i 0))
    (while (mem :u64 (+ environ (* 8 i))) (incf i))
    (when (>= i 63) (result (fail-with +enomem+)))
    (let* ((n (strlen name)) (v (strlen value)) (s (malloc (+ n v 2))))
      (memcpy s name n)
      (setf (mem :u8 (+ s n)) 61)
      (memcpy (+ s n 1) value (+ v 1))
      (setf (mem :u64 (+ environ (* 8 i))) s)
      (setf (mem :u64 (+ environ (* 8 i) 8)) 0)
      0)))

(define-low putenv (s)
  (let ((eq (strchr s 61)))
    (unless eq (result (unsetenv s)))
    (let* ((n (if (< (- eq s) 255) (- eq s) 255)) (name (malloc 256)) (r 0))
      (memcpy name s n)
      (setf (mem :u8 (+ name n)) 0)
      (setf r (setenv name (+ eq 1) 1))
      (free name)
      r)))

(define-global argv-storage :u64 :count 32)
(define-global command-line :u8 :count 1024)

(define-low tls-init-stack (bottom size)
  (let ((m (__libsa_main_thread)))
    (setf (mem :u64 m) (__libsa_tls_new m))
    (setf (mem :u64 (+ m 40)) bottom)
    (setf (mem :u64 (+ m 48)) size)
    (__machdep 3 (mem :u64 m) 0)
    (setf (mem :u64 (+ m 8)) (__syscall 372 0 0 0 0 0 0))))

(define-low tls-init ()
  (tls-init-stack (- #x00007ff000000000 (shl 8 20)) (shl 8 20)))

(define-global native-runtime :u64)

(define-low __libsa_native_start (argc argv envp)
  (setf native-runtime 1)
  (tls-init-stack (- #x00007ff000000000 (shl 1 20)) (shl 1 20))
  ;; Keep writable capacity for setenv; the loader supplies a tight vector.
  (let ((i 0))
    (while (and (< i 64) (mem :u64 (+ envp (* i 8))))
      (setf (ref env-storage i) (mem :u64 (+ envp (* i 8))))
      (incf i))
    (setf (ref env-storage i) 0))
  (setf environ (address env-storage))
  (stdio-init)
  (__libsa_vfs_register (code-address port-vfs))
  (exit (main (the :u32 argc) argv environ)))

(define-low _libsa_start (cmdline)
  (environment-init)
  (stdio-init)
  (tls-init)
  (let ((argc 0) (rest 0) (tok 0))
    (when (__libsa_run_start (address argc) (address argv-storage) 32)
      (exit (main (the :u32 argc) (address argv-storage) environ)))
    (setf (ref argv-storage argc) "/System/Library/Kernels/kernel")
    (incf argc)
    (setf rest (strstr cmdline "-- "))
    (when rest
      (strncpy (address command-line) (+ rest 3) 1023)
      (setf tok (strtok (address command-line) " "))
      (while (and tok (< argc 31))
        (setf (ref argv-storage argc) tok)
        (incf argc)
        (setf tok (strtok 0 " "))))
    (setf (ref argv-storage argc) 0)
    (exit (main argc (address argv-storage) environ))))

(defun setjmp-routine (name)
  (darterfly/asm:routine name
    (loop :for r :in (list darterfly/asm:rbx-tn darterfly/asm:rbp-tn darterfly/asm:r12-tn darterfly/asm:r13-tn darterfly/asm:r14-tn darterfly/asm:r15-tn)
          :for at :from 0 :by 8
          :do (darterfly/asm:inst mov (darterfly/asm:ea at darterfly/asm:rdi-tn) r))
    (darterfly/asm:inst lea darterfly/asm:rdx-tn (darterfly/asm:ea 8 darterfly/asm:rsp-tn))
    (darterfly/asm:inst mov (darterfly/asm:ea 48 darterfly/asm:rdi-tn) darterfly/asm:rdx-tn)
    (darterfly/asm:inst mov darterfly/asm:rdx-tn (darterfly/asm:ea 0 darterfly/asm:rsp-tn))
    (darterfly/asm:inst mov (darterfly/asm:ea 56 darterfly/asm:rdi-tn) darterfly/asm:rdx-tn)
    (darterfly/asm:inst xor :dword (darterfly/asm:reg :dword 0) (darterfly/asm:reg :dword 0))
    (darterfly/asm:inst ret)))

(defun longjmp-routine (name)
  (darterfly/asm:routine name
    (let ((nonzero (sb-assem:gen-label)))
      (darterfly/asm:inst mov :dword (darterfly/asm:reg :dword 0) (darterfly/asm:reg :dword 6))
      (darterfly/asm:inst test darterfly/asm:rax-tn darterfly/asm:rax-tn)
      (darterfly/asm:inst jmp :nz nonzero)
      (darterfly/asm:inst mov :dword (darterfly/asm:reg :dword 0) 1)
      (sb-assem::emit-label nonzero)
      (loop :for r :in (list darterfly/asm:rbx-tn darterfly/asm:rbp-tn darterfly/asm:r12-tn darterfly/asm:r13-tn darterfly/asm:r14-tn darterfly/asm:r15-tn)
            :for at :from 0 :by 8
            :do (darterfly/asm:inst mov r (darterfly/asm:ea at darterfly/asm:rdi-tn)))
      (darterfly/asm:inst mov darterfly/asm:rsp-tn (darterfly/asm:ea 48 darterfly/asm:rdi-tn))
      (darterfly/asm:inst jmp (darterfly/asm:ea 56 darterfly/asm:rdi-tn)))))

(defun jump-routines ()
  (append (mapcar #'setjmp-routine '("setjmp" "_setjmp" "sigsetjmp"))
          (mapcar #'longjmp-routine '("longjmp" "_longjmp" "siglongjmp"))))
