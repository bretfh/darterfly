(in-package #:darterfly/libsa)

(defconstant +default-stack+ (ash 8 20))
(defconstant +keys-max+ 128)
(defconstant +eagain+ 11)
(defconstant +ebusy+ 16)
(defconstant +etimedout+ 110)
(defconstant +recursive+ 1)

(defconstant +t-tp+ 0)
(defconstant +t-tid+ 8)
(defconstant +t-start+ 16)
(defconstant +t-arg+ 24)
(defconstant +t-retval+ 32)
(defconstant +t-stack+ 40)
(defconstant +t-stacksize+ 48)
(defconstant +t-done+ 56)
(defconstant +t-detached+ 60)
(defconstant +t-specific+ 64)
(defconstant +t-name+ 1088)
(defconstant +thread-size+ 1120)

(define-global main-thread :u8 :count 1120)
(define-global next-key :u32)
(define-global destructors :u64 :count 128)

(define-low ulock-wait (addr (value :u32) usec)
  (if (signed< (__syscall 515 1 addr value usec 0 0) 0)
      (mem :u32 (__errno_location))
      0))

(define-low ulock-wake (addr all)
  (let ((saved (mem :u32 (__errno_location))))
    (__syscall 516 (if all #x101 1) addr 0 0 0 0)
    (setf (mem :u32 (__errno_location)) saved)))

(define-low usec-until (abstime)
  (let ((nsec 0) (sec 0))
    (clock_gettime 0 (address sec))
    (let ((usec (+ (* (- (mem :u64 abstime) sec) 1000000)
                   (signed-truncate (- (mem :u64 (+ abstime 8)) nsec) 1000))))
      (if (signed<= usec 0) 1 usec))))

(define-low __libsa_main_thread () (address main-thread))

(define-low pthread_self () (fs-word 8))

(define-low pthread_equal (a b) (= a b))

(define-low _pthread_start (self)
  (pthread_exit (call-pointer (mem :u64 (+ self +t-start+)) (mem :u64 (+ self +t-arg+)))))

(define-low pthread_create (out attr start arg)
  (let ((th (calloc 1 +thread-size+)))
    (when (= th 0) (result +eagain+))
    (setf (mem :u64 (+ th +t-start+)) start)
    (setf (mem :u64 (+ th +t-arg+)) arg)
    (setf (mem :u32 (+ th +t-detached+)) (and attr (mem :u32 (+ attr 24))))
    (if (and attr (mem :u64 attr))
        (progn (setf (mem :u64 (+ th +t-stack+)) (mem :u64 attr))
               (setf (mem :u64 (+ th +t-stacksize+)) (mem :u64 (+ attr 8))))
        (progn
          (setf (mem :u64 (+ th +t-stacksize+)) (if (and attr (mem :u64 (+ attr 8))) (mem :u64 (+ attr 8)) +default-stack+))
          (setf (mem :u64 (+ th +t-stack+)) (anonymous (mem :u64 (+ th +t-stacksize+))))
          (when (= (mem :u64 (+ th +t-stack+)) (lognot 0))
            (free th)
            (result +eagain+))))
    (setf (mem :u64 (+ th +t-tp+)) (__libsa_tls_new th))
    (let* ((top (- (logand (+ (mem :u64 (+ th +t-stack+)) (mem :u64 (+ th +t-stacksize+))) (lognot 15)) 8))
           (tid (__syscall 360 (code-address _pthread_start) th top (mem :u64 (+ th +t-tp+)) 0 0)))
      (when (signed< tid 0)
        (free th)
        (result +eagain+))
      (setf (mem :u64 (+ th +t-tid+)) tid)
      (setf (mem :u64 out) th)
      0)))

(define-low __libsa_key_dtors ()
  ;; POSIX permits a destructor to set a key again, for up to four passes.
  (let ((pass 0) (key 0) (slot 0) (value 0) (dtor 0) (again 1))
    (while (and again (< pass 4))
      (setf again 0)
      (setf key 0)
      (while (< key +keys-max+)
        (setf slot (+ (pthread_self) +t-specific+ (* key 8)))
        (setf value (mem :u64 slot))
        (setf dtor (ref destructors key))
        (when (and value dtor)
          (setf (mem :u64 slot) 0)
          (call-pointer dtor value)
          (setf again 1))
        (incf key))
      (incf pass))))

(define-low pthread_exit (value)
  (__libsa_thread_dtors)
  (__libsa_key_dtors)
  (__libsa_dl_tls_destroy)
  (let ((self (pthread_self)))
    (setf (mem :u64 (+ self +t-retval+)) value)
    (__syscall 361 0 0 0 (+ self +t-done+) 0 0)
    (while 1)))

(define-low pthread_join (th value)
  (while (= (mem :u32 (+ th +t-done+)) 0)
    (ulock-wait (+ th +t-done+) 0 0))
  (when value (setf (mem :u64 value) (mem :u64 (+ th +t-retval+))))
  0)

(define-low pthread_detach (th) (setf (mem :u32 (+ th +t-detached+)) 1) 0)

(define-low pthread_kill (th (sig :u32))
  (if (signed< (__syscall 328 (mem :u64 (+ th +t-tid+)) sig 0 0 0 0) 0)
      (mem :u32 (__errno_location))
      0))

(define-low pthread_attr_init (a) (memset a 0 32) 0)
(define-low pthread_attr_destroy (a) 0)
(define-low pthread_attr_setstack (a s n) (setf (mem :u64 a) s) (setf (mem :u64 (+ a 8)) n) 0)
(define-low pthread_attr_getstack (a s n) (setf (mem :u64 s) (mem :u64 a)) (setf (mem :u64 n) (mem :u64 (+ a 8))) 0)
(define-low pthread_attr_setstacksize (a n) (setf (mem :u64 (+ a 8)) n) 0)
(define-low pthread_attr_getstacksize (a n)
  (setf (mem :u64 n) (if (mem :u64 (+ a 8)) (mem :u64 (+ a 8)) +default-stack+))
  0)
(define-low pthread_attr_setguardsize (a n) (setf (mem :u64 (+ a 16)) n) 0)
(define-low pthread_attr_getguardsize (a n) (setf (mem :u64 n) (mem :u64 (+ a 16))) 0)
(define-low pthread_attr_setdetachstate (a (d :u32)) (setf (mem :u32 (+ a 24)) d) 0)

(define-low pthread_getattr_np (th a)
  (memset a 0 32)
  (setf (mem :u64 a) (mem :u64 (+ th +t-stack+)))
  (setf (mem :u64 (+ a 8)) (mem :u64 (+ th +t-stacksize+)))
  0)

(define-low pthread_mutex_init (m a)
  (memset m 0 16)
  (setf (mem :u32 (+ m 4)) (if a (mem :u32 a) 0))
  0)

(define-low pthread_mutex_destroy (m) 0)

(define-low self-id () (the :u32 (mem :u64 (+ (pthread_self) +t-tid+))))

(define-low recursive-again (m)
  (and (= (mem :u32 (+ m 4)) +recursive+) (= (mem :u32 (+ m 8)) (self-id))))

(define-low pthread_mutex_trylock (m)
  (when (recursive-again m)
    (setf (mem :u32 (+ m 12)) (+ (mem :u32 (+ m 12)) 1))
    (result 0))
  (unless (compare-and-swap m 0 1) (result +ebusy+))
  (setf (mem :u32 (+ m 8)) (self-id))
  (setf (mem :u32 (+ m 12)) 1)
  0)

(define-low lock-until (m usec)
  (when (recursive-again m)
    (setf (mem :u32 (+ m 12)) (+ (mem :u32 (+ m 12)) 1))
    (result 0))
  (unless (compare-and-swap m 0 1)
    (let ((c (mem :u32 m)))
      (when (/= c 2) (setf c (exchange m 2)))
      (while (/= c 0)
        (when (= (the :u32 (ulock-wait m 2 usec)) +etimedout+) (result +etimedout+))
        (setf c (exchange m 2)))))
  (setf (mem :u32 (+ m 8)) (self-id))
  (setf (mem :u32 (+ m 12)) 1)
  0)

(define-low pthread_mutex_lock (m) (lock-until m 0))
(define-low pthread_mutex_timedlock (m abstime) (lock-until m (usec-until abstime)))

(define-low pthread_mutex_unlock (m)
  (when (= (mem :u32 (+ m 4)) +recursive+)
    (setf (mem :u32 (+ m 12)) (- (mem :u32 (+ m 12)) 1))
    (when (signed> (sign-extend :u32 (mem :u32 (+ m 12))) 0) (result 0)))
  (setf (mem :u32 (+ m 8)) 0)
  (when (/= (fetch-add m #xFFFFFFFF) 1)
    (setf (mem :u32 m) 0)
    (ulock-wake m 0))
  0)

(define-low pthread_mutexattr_init (a) (setf (mem :u32 a) 0) 0)
(define-low pthread_mutexattr_destroy (a) 0)
(define-low pthread_mutexattr_settype (a (k :u32)) (setf (mem :u32 a) k) 0)

(define-low pthread_cond_init (c a) (setf (mem :u32 c) 0) 0)
(define-low pthread_cond_destroy (c) 0)

(define-low cond-wait (c m usec)
  (let ((seq (mem :u32 c)) (count (mem :u32 (+ m 12))) (r 0))
    (setf (mem :u32 (+ m 12)) 1)
    (pthread_mutex_unlock m)
    (setf r (ulock-wait c seq usec))
    (pthread_mutex_lock m)
    (setf (mem :u32 (+ m 12)) count)
    (if (= (the :u32 r) +etimedout+) +etimedout+ 0)))

(define-low pthread_cond_wait (c m) (cond-wait c m 0))
(define-low pthread_cond_timedwait (c m abstime) (cond-wait c m (usec-until abstime)))
(define-low pthread_cond_signal (c) (fetch-add c 1) (ulock-wake c 0) 0)
(define-low pthread_cond_broadcast (c) (fetch-add c 1) (ulock-wake c 1) 0)
(define-low pthread_condattr_init (a) (memset a 0 8) 0)
(define-low pthread_condattr_destroy (a) 0)
(define-low pthread_condattr_setpshared (a (p :u32)) (setf (mem :u32 a) p) 0)
(define-low pthread_condattr_setclock (a (c :u32)) (setf (mem :u32 (+ a 4)) c) 0)

(define-low pthread_key_create (k d)
  (let ((key (fetch-add (address next-key) 1)))
    (when (>= key +keys-max+) (result +eagain+))
    (setf (ref destructors key) d)
    (setf (mem :u32 k) key)
    0))

(define-low pthread_key_delete ((k :u32))
  (when (>= k +keys-max+) (result +einval+))
  (setf (ref destructors k) 0) 0)
(define-low pthread_getspecific ((k :u32)) (mem :u64 (+ (pthread_self) +t-specific+ (* 8 k))))
(define-low pthread_setspecific ((k :u32) v) (setf (mem :u64 (+ (pthread_self) +t-specific+ (* 8 k))) v) 0)

(define-low pthread_once (o f)
  (if (compare-and-swap o 0 1)
      (progn (call-pointer f)
             (exchange o 2)
             (ulock-wake o 1))
      (while (/= (mem :u32 o) 2) (ulock-wait o 1 0)))
  0)

(define-low pthread_setname_np (th n) (strncpy (+ th +t-name+) n 31) 0)
(define-low pthread_getname_np (th n len) (strncpy n (+ th +t-name+) len) 0)

(define-low sched_yield () (trap #x81 (- 0 60)) 0)

(define-low sem_init (s (pshared :u32) (v :u32)) (setf (mem :u32 s) v) 0)
(define-low sem_destroy (s) 0)

(define-low sem_trywait (s)
  (let ((v (mem :u32 s)))
    (while (> v 0)
      (when (compare-and-swap s v (- v 1)) (result 0))
      (setf v (mem :u32 s))))
  (setf (mem :u32 (__errno_location)) +eagain+)
  (- 0 1))

(define-low sem-wait-until (s usec)
  (while 1
    (when (= (the :u32 (sem_trywait s)) 0) (result 0))
    (let ((r (ulock-wait s 0 usec)))
      (when (or (= r +etimedout+) (= r +eintr+))
        (setf (mem :u32 (__errno_location)) r)
        (result (- 0 1))))))

(define-low sem_wait (s) (sem-wait-until s 0))
(define-low sem_timedwait (s abstime) (sem-wait-until s (usec-until abstime)))
(define-low sem_post (s) (fetch-add s 1) (ulock-wake s 0) 0)
(define-low sem_getvalue (s v) (setf (mem :u32 v) (mem :u32 s)) 0)

;; Shared reader/writer lock for LLVM libunwind's address cache.
(define-low pthread_rwlock_init (lock attr) (setf (mem :u32 lock) 0) 0)
(define-low pthread_rwlock_destroy (lock)
  (if (mem :u32 lock) +ebusy+ 0))
(define-low pthread_rwlock_rdlock (lock)
  (let ((state 0))
    (while 1
      (setf state (mem :u32 lock))
      (if (< state #x7fffffff)
          (when (compare-and-swap lock state (+ state 1)) (result 0))
          (ulock-wait lock state 0)))))
(define-low pthread_rwlock_wrlock (lock)
  (let ((state 0))
    (while (not (compare-and-swap lock 0 #x80000000))
      (setf state (mem :u32 lock))
      (when state (ulock-wait lock state 0))))
  0)
(define-low pthread_rwlock_unlock (lock)
  (if (= (mem :u32 lock) #x80000000)
      (exchange lock 0)
      (fetch-add lock -1))
  (ulock-wake lock 1)
  0)
