  (let ((n (find-node path)))
    (when (and (= n 0) (is-dir path)) (setf n (add-node path (logior +s-ifdir+ #o755))))
    (when (and n (dir-mode-p (mem :u32 (+ n +n-mode+)))) (result (new-fd n (logior flags #o200000))))
    (cond ((= n 0)
           (unless (logand flags +o-creat+) (result (- 0 +enoent+)))
           (setf n (add-node path (logior +s-ifreg+ (logand mode #o7777))))
           (setf (mem :u32 (+ n +n-written+)) 1))
          ((and (logand flags +o-creat+) (logand flags #o200)) (result (- 0 +eexist+))))
    (when (/= (logand flags 3) 0)
      (own n)
      (when (logand flags #o1000) (setf (mem :u64 (+ n +n-size+)) 0)))
    (new-fd n flags)))

