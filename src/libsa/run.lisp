(define-low load-archive (p size)
  (let ((end (+ p size)) (path (malloc 2048)))
    (while (and (<= (+ p 110) end) (= (the :u32 (memcmp p "070701" 6)) 0))
      (let* ((mode (hex8 (+ p 14))) (mtime (hex8 (+ p 46))) (filesize (hex8 (+ p 54))) (namesize (hex8 (+ p 94)))
             (name (+ p 110)) (data (+ p (pad4 (+ 110 namesize)))))
