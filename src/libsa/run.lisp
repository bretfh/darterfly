               (incf n)
               (strcpy (+ out n) part)
               (setf n (+ n (strlen part)))))
      (setf part (strtok 0 "/")))
    (when (= n 0) (strcpy out "/"))
    (free tmp)))

(define-low node-at (i) (mem :u64 (+ nodes (* 8 i))))

(define-low find-node (path)
  (let ((i node-count))
    (while (> i 0)
      (decf i)
      (let ((n (node-at i)))
        (when (= (the :u32 (strcmp (mem :u64 n) path)) 0)
          (result (if (mem :u32 (+ n +n-dead+)) 0 n)))))
    0))

(define-low add-node (path (mode :u32))
  (when (= node-count node-cap)
    (setf node-cap (if node-cap (* node-cap 2) 1024))
    (setf nodes (realloc nodes (* node-cap 8))))
  (let ((n (calloc 1 64)))
    (setf (mem :u64 (+ nodes (* 8 node-count))) n)
    (incf node-count)
    (setf (mem :u64 (+ n +n-ino+)) (+ node-count 1))
    (setf (mem :u64 n) (strdup path))
    (setf (mem :u32 (+ n +n-mode+)) mode)
    n))

(define-low dir-mode-p ((mode :u32)) (= (logand mode +s-ifmt+) +s-ifdir+))

