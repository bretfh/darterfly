               (strncat tmp in (- 2047 (strlen tmp)))))
    (setf (mem :u8 (+ tmp 2047)) 0)
    (setf (mem :u8 out) 0)
    (setf part (strtok tmp "/"))
    (while part
      (cond ((= (the :u32 (strcmp part ".")) 0))
            ((= (the :u32 (strcmp part "..")) 0)
             (while (and n (/= (mem :u8 (+ out n -1)) 47)) (decf n))
             (when n (decf n))
             (setf (mem :u8 (+ out n)) 0))
