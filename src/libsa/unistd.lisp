(define-low syscall (n &va ap)
  (let* ((a (va-next ap)) (b (va-next ap)) (c (va-next ap)) (d (va-next ap)) (e (va-next ap)) (f (va-next ap)))
    (cond ((= n 9) (mmap a b c d e f))
          ((= n 10) (mprotect a b c))
          ((= n 11) (munmap a b))
          ((= n 186) (__syscall 372 0 0 0 0 0 0))
          (t (fail-with +enosys+)))))

(define-low poll (fds n (timeout :u32))
  (when vfs (result (ret (call 50 fds n timeout 0))))
  (let ((second 0) (first 0) (ready 0) (count 0) (want-in 0) (want-out 0) (i 0) (console 0))
    (setf console (address first))
    (while (< i n)
      (let* ((p (+ fds (* 8 i))) (events (mem :u16 (+ p 4))) (c (sign-extend :u32 (__libsa_fd_console (mem :u32 p)))))
        (setf (mem :u16 (+ p 6)) 0)
        (cond ((signed< c 0) (setf (mem :u16 (+ p 6)) 0))
              ((= c 0) (setf (mem :u16 (+ p 6))
                                (if (kfd (mem :u32 p)) (logand events 5) #x20)))
              (t (setf want-in (logior want-in (logand events 1)))
                 (setf want-out (logior want-out (logand events 4)))))
        (when (mem :u16 (+ p 6)) (incf ready)))
      (incf i))
    (when want-in
      (setf (mem :u64 (+ console (* 8 count))) (shl 1 32))
      (incf count))
    (when want-out
      (setf (mem :u64 (+ console (* 8 count))) (logior 1 (shl 4 32)))
      (incf count))
    (when (= count 0) (result ready))
    (when (signed< (__syscall 230 console count (if ready 0 (sign-extend :u32 timeout)) 0 0 0) 0)
      (result (if ready ready (- 0 1))))
    (setf i 0)
    (while (< i n)
      (let ((p (+ fds (* 8 i))) (j 0))
        (when (= (the :u32 (__libsa_fd_console (mem :u32 p))) 1)
          (while (< j count)
            (setf (mem :u16 (+ p 6)) (logior (mem :u16 (+ p 6))
                                             (logand (mem :u16 (+ console (* 8 j) 6)) (mem :u16 (+ p 4)))))
            (incf j))
          (when (mem :u16 (+ p 6)) (incf ready))))
      (incf i))
    ready))

