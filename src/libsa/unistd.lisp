(define-low _exit ((code :u32))
  (let ((core 0) (size 0))
    (__libsa_run_finish code)
    (when (and (= code 0) (the :u32 (__libsa_saved_core (address core) (address size))))
      (__machdep 19 core size))
    (__syscall 1 code 0 0 0 0 0)
    (while 1)))

