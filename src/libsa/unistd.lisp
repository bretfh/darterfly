(define-global root-passwd :u8 :count 48)

(define-low root-entry ()
  (let ((p (address root-passwd)))
    (setf (mem :u64 p) "root")
    (setf (mem :u64 (+ p 8)) "")
    (setf (mem :u64 (+ p 16)) 0)
    (setf (mem :u64 (+ p 24)) "root")
    (setf (mem :u64 (+ p 32)) "/")
    (setf (mem :u64 (+ p 40)) "/bin/sh")
    p))

(define-low getpwuid ((u :u32)) (if (= u 0) (root-entry) 0))
(define-low getpwnam (n) (if (= (the :u32 (strcmp n "root")) 0) (root-entry) 0))

(define-global dl-failed :u64)
(define-global runtime-handle :u64)

(define-low dlopen (p f)
  (when (or (= p 0) (= (the :u32 (strcmp p "/System/Library/Kernels/kernel")) 0)) (result (address runtime-handle)))
  (setf dl-failed 1)
  0)

(define-low dlclose (h) 0)

(define-low dlerror ()
  (unless dl-failed (result 0))
  (setf dl-failed 0)
  "no dynamic loading on darterfly")

(define-global symbols :u64)
(define-global symbol-names :u64)
(define-global symbol-count :u64)
(define-global kimage :u64 :count 2)

(define-low load-symbols ()
  (when (= (ref kimage 0) 0) (__machdep 6 (address kimage) 0))
  ;; Native worlds have no kernel ELF mapping. dladdr/dlsym must report a
  ;; missing symbol rather than dereference a failed boot-image request.
  (when (or (= (ref kimage 0) 0) (< (ref kimage 1) 64)) (result 0))
  (let* ((k (ref kimage 0)) (sh (+ k (mem :u64 (+ k 40)))) (i 0))
    (while (< i (mem :u16 (+ k 60)))
      (let ((h (+ sh (* 64 i))))
        (when (= (mem :u32 (+ h 4)) 2)
          (setf symbols (+ k (mem :u64 (+ h 24))))
          (setf symbol-count (truncate (mem :u64 (+ h 32)) 24))
          (setf symbol-names (+ k (mem :u64 (+ sh (* 64 (mem :u32 (+ h 40))) 24))))))
      (incf i))))

(define-low dlsym (h name)
  (when (and h (/= h (address runtime-handle)))
    (setf dl-failed 1)
    (result 0))
  (unless symbols (load-symbols))
  (let ((i 0))
    (while (< i symbol-count)
      (let ((sym (+ symbols (* 24 i))))
        (when (and (/= (mem :u16 (+ sym 6)) 0) (= (shr (mem :u8 (+ sym 4)) 4) 1)
                   (= (the :u32 (strcmp (+ symbol-names (mem :u32 sym)) name)) 0))
          (result (mem :u64 (+ sym 8)))))
      (incf i)))
  (setf dl-failed 1)
  0)

(define-low dladdr (a info)
  (unless symbols (load-symbols))
  (let ((best 0) (i 0))
    (while (< i symbol-count)
      (let ((sym (+ symbols (* 24 i))))
        (when (and (/= (mem :u16 (+ sym 6)) 0) (<= (mem :u64 (+ sym 8)) a)
                   (or (= best 0) (> (mem :u64 (+ sym 8)) (mem :u64 (+ best 8)))))
          (setf best sym)))
      (incf i))
    (unless best (result 0))
    (setf (mem :u64 info) "/System/Library/Kernels/kernel")
    (setf (mem :u64 (+ info 8)) 0)
    (setf (mem :u64 (+ info 16)) (+ symbol-names (mem :u32 best)))
    (setf (mem :u64 (+ info 24)) (mem :u64 (+ best 8)))
    1))

(define-global h_errno :u32 :export t)

(define-low map-shared (at len (prot :u32) (fd :u32) off)
  (let ((size 0) (data 0) (whole (logand len (lognot 4095))))
    (setf data (__libsa_boot_data fd (address size)))
    (when (or (= data 0) (logand at 4095) (logand (+ data off) 4095) (>= off size)) (result 0))
    (when (> whole (- size off)) (setf whole (logand (- size off) (lognot 4095))))
    (when (or (= whole 0) (/= (__machdep5 51 at (+ data off) whole 0 0) whole)) (result 0))
    (when (< whole len)
      (let ((left (- len whole)))
        (when (> left (- size off whole)) (setf left (- size off whole)))
        (memcpy (+ at whole) (+ data off whole) left)))
    (when (/= prot 3) (mprotect at len prot))
    1))

(define-low mmap (addr len (prot :u32) (flags :u32) (fd :u32) off)
  (if (= (logand flags #x20) 0)
      (let ((at (mmap addr len 3 (logior (logand flags #x10) #x22) #xFFFFFFFF 0)) (done 0) (n 0))
        (when (= at (lognot 0)) (result at))
        (when (map-shared at len prot fd off) (result at))
        (while (< done len)
          (setf n (pread fd (+ at done) (- len done) (+ off done)))
          (when (signed< n 0)
            (munmap at len)
            (result (lognot 0)))
          (if (= n 0) (setf done len) (setf done (+ done n))))
        (when (/= prot 3) (mprotect at len prot))
        at)
      (let ((kflags (logior #x1000 (if (logand flags #x10) #x10 0) (if (logand flags 2) 2 0) (if (logand flags 1) 1 0))))
        (__syscall 197 addr len prot kflags (sign-extend :u32 fd) off))))

