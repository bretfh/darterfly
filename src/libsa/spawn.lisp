(in-package #:darterfly/libsa)

;; One public spawn implementation for the system image and foreign worlds.
;; The existing VFS callback chooses local dispatch or the port transport.
(define-low spawn-string (data at string)
  (unless string (result (- 0 14)))
  (let ((n 0))
    (while (and (< n 4096) (mem :u8 (+ string n))) (incf n))
    (when (or (= n 4096) (> (+ at n 1) 4096)) (result (- 0 7)))
    (memcpy (+ data at) string (+ n 1))
    (+ at n 1)))

(define-low posix_spawn_file_actions_init (actions)
  (unless actions (result 22))
  (let ((buffer (calloc 1 4112)))
    (unless buffer (result +enomem+))
    (setf (mem :u32 actions) 0)
    (setf (mem :u64 (+ actions 8)) buffer)
    0))

(define-low posix_spawn_file_actions_destroy (actions)
  (unless actions (result 22))
  (free (mem :u64 (+ actions 8)))
  (memset actions 0 16)
  0)

(define-low spawn-action (actions op a b c path)
  (unless (and actions (mem :u64 (+ actions 8))) (result 22))
  (let* ((buffer (mem :u64 (+ actions 8))) (at (mem :u64 buffer))
         (data (+ buffer 16)) (end (+ at 32)))
    (when (or (>= (mem :u64 (+ buffer 8)) 64) (> end 4096)) (result 7))
    (when path
      (setf end (spawn-string data end path))
      (when (signed< end 0) (result (- 0 end))))
    (setf (mem :u64 (+ data at)) op)
    (setf (mem :u64 (+ data at 8)) a)
    (setf (mem :u64 (+ data at 16)) b)
    (setf (mem :u64 (+ data at 24)) c)
    (setf (mem :u64 buffer) end)
    (incf (mem :u64 (+ buffer 8)))
    (setf (mem :u32 actions) (mem :u64 (+ buffer 8)))
    0))

(define-low posix_spawn_file_actions_adddup2 (actions (fd :u32) (to :u32))
  (when (or (> fd 4095) (> to 4095)) (result 9))
  (spawn-action actions 1 fd to 0 0))
(define-low posix_spawn_file_actions_addclose (actions (fd :u32))
  (when (> fd 4095) (result 9))
  (spawn-action actions 2 fd 0 0 0))
(define-low posix_spawn_file_actions_addclosefrom_np (actions (fd :u32))
  (when (> fd 4096) (result 9))
  (spawn-action actions 3 fd 0 0 0))
(define-low posix_spawn_file_actions_addopen (actions (fd :u32) path (flags :u32) (mode :u32))
  (when (> fd 4095) (result 9))
  (unless path (result 22))
  (spawn-action actions 4 fd flags mode path))
(define-low posix_spawn_file_actions_addchdir_np (actions path)
  (unless path (result 22))
  (spawn-action actions 5 0 0 0 path))

(define-low posix_spawnattr_init (a) (unless a (result 22)) (memset a 0 264) 0)
(define-low posix_spawnattr_destroy (a) (if a 0 22))
(define-low posix_spawnattr_setflags (a (flags :u16))
  (unless a (result 22))
  (when (logand flags (lognot #x400c)) (result 95))
  (setf (mem :u16 a) flags) 0)
(define-low posix_spawnattr_setpgroup (a (p :u32)) 95)
(define-low posix_spawnattr_setsigmask (a s)
  (unless (and a s) (result 22)) (memcpy (+ a 8) s 128) 0)
(define-low posix_spawnattr_setsigdefault (a s)
  (unless (and a s) (result 22)) (memcpy (+ a 136) s 128) 0)

(define-low spawn-pack (data path argv envp search actions attr)
  (let ((at 24) (argc 0) (envc 0) (i 0) (buffer 0) (value 0))
    (unless argv (result (- 0 22)))
    (while (and (< argc 64) (mem :u64 (+ argv (* 8 argc)))) (incf argc))
    (when (and (= argc 64) (mem :u64 (+ argv (* 8 argc)))) (result (- 0 7)))
    (when envp
      (while (and (< envc 64) (mem :u64 (+ envp (* 8 envc)))) (incf envc))
      (when (and (= envc 64) (mem :u64 (+ envp (* 8 envc)))) (result (- 0 7))))
    (setf at (spawn-string data at path))
    (when (signed< at 0) (result at))
    (setf value (if search (getenv "PATH") 0))
    (setf at (spawn-string data at (if value value "/bin:/usr/bin")))
    (when (signed< at 0) (result at))
    (while (< i argc)
      (setf at (spawn-string data at (mem :u64 (+ argv (* 8 i)))))
      (when (signed< at 0) (result at))
      (incf i))
    (setf i 0)
    (while (< i envc)
      (setf at (spawn-string data at (mem :u64 (+ envp (* 8 i)))))
      (when (signed< at 0) (result at))
      (incf i))
    (setf (mem :u64 data) argc)
    (setf (mem :u64 (+ data 8)) envc)
    (setf (mem :u64 (+ data 16)) 0)
    (when actions
      (setf buffer (mem :u64 (+ actions 8)))
      (unless buffer (result (- 0 22)))
      (when (> (+ at (mem :u64 buffer)) 4096) (result (- 0 7)))
      (memcpy (+ data at) (+ buffer 16) (mem :u64 buffer))
      (incf at (mem :u64 buffer))
      (setf (mem :u64 (+ data 16)) (mem :u64 (+ buffer 8))))
    ;; One fixed-size signal record follows the ordinary file actions.
    ;; Capture the calling thread's mask and inherited ignored dispositions.
    (when (> (+ at 32) 4096) (result (- 0 7)))
    (let ((mask 0) (mask-buffer (calloc 1 128)) (ignored 0) (sig 1)
          (flags (if attr (mem :u16 attr) 0)))
      (unless mask-buffer (result (- 0 12)))
      (pthread_sigmask 2 0 mask-buffer)
      (setf mask (mem :u64 mask-buffer))
      (free mask-buffer)
      (when (logand flags 8) (setf mask (mem :u64 (+ attr 8))))
      (while (< sig 65)
        (when (= (mem :u64 (action-of sig)) 1)
          (setf ignored (logior ignored (shl 1 (- sig 1)))))
        (incf sig))
      (when (logand flags 4)
        (setf ignored (logand ignored (lognot (mem :u64 (+ attr 136))))))
      (setf (mem :u64 (+ data at)) 6)
      (setf (mem :u64 (+ data at 8)) mask)
      (setf (mem :u64 (+ data at 16)) ignored)
      (setf (mem :u64 (+ data at 24)) (if (logand flags #x4000) 1 0))
      (incf (mem :u64 (+ data 16)))
      (+ at 32))))

(define-low spawn-public (pid path actions attr argv envp search)
  (unless (and pid path argv) (result 22))
  (when (and attr (logand (mem :u16 attr) (lognot #x400c))) (result 95))
  (let ((data (malloc 4096)) (size 0) (r 0))
    (unless data (result +enomem+))
    (setf size (spawn-pack data path argv envp search actions attr))
    (setf r (if (signed< size 0) size (call 51 data size (if search 1 0) 0)))
    (free data)
    (when (signed< r 0) (result (- 0 r)))
    (setf (mem :u32 pid) r)
    0))

(define-low posix_spawn (pid path actions attr argv envp)
  (spawn-public pid path actions attr argv envp 0))
(define-low posix_spawnp (pid path actions attr argv envp)
  (spawn-public pid path actions attr argv envp 1))
