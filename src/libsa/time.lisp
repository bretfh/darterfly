(in-package #:darterfly/libsa)

(defconstant +billion+ 1000000000)
(defconstant +zone-types+ 256)

(define-global commpage :u64)

(define-low page ()
  (when (= commpage 0) (setf commpage (__machdep 4 0 0)))
  commpage)

(define-low nanos-since-boot ()
  (let* ((c (page)) (hz (mem :u64 c)) (ticks (- (rdtsc) (mem :u64 (+ c 8)))))
    (+ (* (truncate ticks hz) +billion+) (truncate (* (rem ticks hz) +billion+) hz))))

(define-low clock_gettime ((id :u32) ts)
  (let ((ns (nanos-since-boot)))
    (when (or (= id 0) (= id 5) (= id 8) (= id 11))
      (setf ns (+ ns (* (mem :u64 (+ (page) 16)) +billion+))))
    (setf (mem :u64 ts) (truncate ns +billion+))
    (setf (mem :u64 (+ ts 8)) (rem ns +billion+))
    0))

(define-low clock_getres ((id :u32) ts)
  (setf (mem :u64 ts) 0)
  (setf (mem :u64 (+ ts 8)) 1)
  0)

(define-low gettimeofday (tv tz)
  (let ((nsec 0) (sec 0))
    (clock_gettime 0 (address sec))
    (setf (mem :u64 tv) sec)
    (setf (mem :u64 (+ tv 8)) (truncate nsec 1000))
    0))

(define-low time (out)
  (let ((nsec 0) (sec 0))
    (clock_gettime 0 (address sec))
    (when out (setf (mem :u64 out) sec))
    sec))

(define-low clock () (truncate (nanos-since-boot) 1000))

(define-low times (out)
  (when out (memset out 0 32))
  (truncate (nanos-since-boot) 10000000))

(define-low nanosleep (req left)
  (let* ((end (+ (nanos-since-boot) (* (mem :u64 req) +billion+) (mem :u64 (+ req 8))))
         (r (__syscall 334 (mem :u64 req) (mem :u64 (+ req 8)) 0 0 0 0)))
    (when left
      (let* ((now (nanos-since-boot)) (rest (if (< now end) (- end now) 0)))
        (setf (mem :u64 left) (truncate rest +billion+))
        (setf (mem :u64 (+ left 8)) (rem rest +billion+))))
    (if (signed< r 0) (- 0 1) 0)))

(define-low sleep ((s :u32))
  (let ((nsec 0) (sec s))
    (nanosleep (address sec) 0)
    0))

(define-low usleep ((us :u32))
  (let ((nsec (* (rem us 1000000) 1000)) (sec (truncate us 1000000)))
    (nanosleep (address sec) 0)))

(define-low setitimer ((which :u32) v old) (__syscall 83 which v old 0 0 0))
(define-low getitimer ((which :u32) v) (__syscall 86 which v 0 0 0 0))

(define-global timezone :u64 :export t)
(define-global daylight :u32 :export t)
(define-global tzname :u64 :count 2 :export t)

(define-low tzset ()
  (setf (ref tzname 0) "UTC")
  (setf (ref tzname 1) "UTC")
  0)

(define-low leap (y)
  (or (and (= (signed-rem y 4) 0) (/= (signed-rem y 100) 0)) (= (signed-rem y 400) 0)))

(define-low month-days (m (y :u64))
  (+ (mem :u8 (+ #(31 28 31 30 31 30 31 31 30 31 30 31) m)) (and (= m 1) (leap y))))

(define-low gmtime_r (at tm)
  (let* ((s (mem :u64 at)) (days (signed-truncate s 86400)) (left (signed-rem s 86400)) (y 1970) (m 0) (going 1))
    (when (signed< left 0)
      (setf left (+ left 86400))
      (decf days))
    (setf (mem :u32 (+ tm 8)) (truncate left 3600))
    (setf (mem :u32 (+ tm 4)) (truncate (rem left 3600) 60))
    (setf (mem :u32 tm) (rem left 60))
    (let ((w (signed-rem (+ days 4) 7)))
      (setf (mem :u32 (+ tm 24)) (if (signed< w 0) (+ w 7) w)))
    (while going
      (cond ((signed< days 0)
             (decf y)
             (setf days (+ days (if (leap y) 366 365))))
            ((signed< days (if (leap y) 366 365)) (setf going 0))
            (t (setf days (- days (if (leap y) 366 365)))
               (incf y))))
    (setf (mem :u32 (+ tm 20)) (- y 1900))
    (setf (mem :u32 (+ tm 28)) days)
    (while (and (< m 12) (>= days (month-days m y)))
      (setf days (- days (month-days m y)))
      (incf m))
    (setf (mem :u32 (+ tm 16)) m)
    (setf (mem :u32 (+ tm 12)) (+ days 1))
    (setf (mem :u32 (+ tm 32)) 0)
    (setf (mem :u64 (+ tm 40)) 0)
    (setf (mem :u64 (+ tm 48)) "UTC")
    tm))

(define-global zone-loaded :u64)
(define-global zone-lock :u32)
(define-global zone-count :u64)
(define-global zone-type-count :u64)
(define-global zone-at :u64)
(define-global zone-index :u64)
(define-global zone-names :u64)
(define-global zone-posix :u64)
(define-global zone-has-dst :u64)
(define-global zone-type :u8 :count 6144)
(define-global zone-std :u8 :count 24)
(define-global zone-dst :u8 :count 24)
(define-global zone-start :u8 :count 40)
(define-global zone-end :u8 :count 40)
(define-global std-name :u8 :count 16)
(define-global dst-name :u8 :count 16)

(define-low set-zone-type (z utoff isdst name)
  (setf (mem :u64 z) utoff)
  (setf (mem :u64 (+ z 8)) isdst)
  (setf (mem :u64 (+ z 16)) name))

(define-low set-rule (r kind month week day time)
  (setf (mem :u64 r) kind)
  (setf (mem :u64 (+ r 8)) month)
  (setf (mem :u64 (+ r 16)) week)
  (setf (mem :u64 (+ r 24)) day)
  (setf (mem :u64 (+ r 32)) time))

(define-low be (p n)
  (let ((v 0) (i 0))
    (while (< i n)
      (setf v (logior (shl v 8) (mem :u8 (+ p i))))
      (incf i))
    (if (= n 4) (sign-extend :u32 v) v)))

(define-low letter-p ((c :u8)) (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))))

(define-low posix-name (s out)
  (let ((n 0))
    (if (= (mem :u8 s) 60)
        (progn
          (incf s)
          (while (and (mem :u8 s) (/= (mem :u8 s) 62))
            (when (< n 15) (setf (mem :u8 (+ out n)) (mem :u8 s)) (incf n))
            (incf s))
          (when (mem :u8 s) (incf s)))
        (while (letter-p (mem :u8 s))
          (when (< n 15) (setf (mem :u8 (+ out n)) (mem :u8 s)) (incf n))
          (incf s)))
    (setf (mem :u8 (+ out n)) 0)
    (if n s 0)))

(define-low posix-number (s v)
  (let ((n 0))
    (unless (isdigit (mem :u8 s)) (result 0))
    (while (isdigit (mem :u8 s))
      (setf n (+ (* n 10) (- (mem :u8 s) 48)))
      (incf s))
    (setf (mem :u64 v) n)
    s))

(define-low posix-time (s v)
  (let ((sign 1) (h 0) (m 0) (sec 0))
    (when (or (= (mem :u8 s) 43) (= (mem :u8 s) 45))
      (setf sign (if (= (mem :u8 s) 45) (- 0 1) 1))
      (incf s))
    (setf s (posix-number s (address h)))
    (unless s (result 0))
    (when (= (mem :u8 s) 58)
      (setf s (posix-number (+ s 1) (address m)))
      (unless s (result 0)))
    (when (= (mem :u8 s) 58)
      (setf s (posix-number (+ s 1) (address sec)))
      (unless s (result 0)))
    (setf (mem :u64 v) (* sign (+ (* h 3600) (* m 60) sec)))
    s))

(define-low posix-rule (s r)
  (let ((a 0) (b 0) (c 0))
    (cond ((= (mem :u8 s) 77)
           (setf s (posix-number (+ s 1) (address a)))
           (unless (and s (= (mem :u8 s) 46)) (result 0))
           (setf s (posix-number (+ s 1) (address b)))
           (unless (and s (= (mem :u8 s) 46)) (result 0))
           (setf s (posix-number (+ s 1) (address c)))
           (unless s (result 0))
           (set-rule r 77 a b c 0))
          ((= (mem :u8 s) 74)
           (setf s (posix-number (+ s 1) (address a)))
           (unless s (result 0))
           (set-rule r 74 0 0 a 0))
          (t
           (setf s (posix-number s (address a)))
           (unless s (result 0))
           (set-rule r 68 0 0 a 0)))
    (setf (mem :u64 (+ r 32)) 7200)
    (when (= (mem :u8 s) 47)
      (setf s (posix-time (+ s 1) (+ r 32))))
    s))

(define-low parse-posix (s)
  (let ((off 0))
    (setf s (posix-name s (address std-name)))
    (unless s (result 0))
    (setf s (posix-time s (address off)))
    (unless s (result 0))
    (set-zone-type (address zone-std) (- 0 off) 0 (address std-name))
    (setf zone-posix 1)
    (when (= (mem :u8 s) 0) (result 0))
    (setf s (posix-name s (address dst-name)))
    (unless s (result 0))
    (set-zone-type (address zone-dst) (+ (mem :u64 (address zone-std)) 3600) 1 (address dst-name))
    (when (and (mem :u8 s) (/= (mem :u8 s) 44))
      (setf s (posix-time s (address off)))
      (unless s (result 0))
      (setf (mem :u64 (address zone-dst)) (- 0 off)))
    (set-rule (address zone-start) 77 3 2 0 7200)
    (set-rule (address zone-end) 77 11 1 0 7200)
    (when (= (mem :u8 s) 44)
      (setf s (posix-rule (+ s 1) (address zone-start)))
      (unless (and s (= (mem :u8 s) 44)) (result 0))
      (setf s (posix-rule (+ s 1) (address zone-end)))
      (unless s (result 0)))
    (setf zone-has-dst 1)))

(define-low days-from-civil (y m d)
  (when (<= m 2) (decf y))
  (let* ((era (signed-truncate (if (signed>= y 0) y (- y 399)) 400))
         (yoe (- y (* era 400)))
         (doy (+ (truncate (+ (* 153 (+ m (if (> m 2) (- 0 3) 9))) 2) 5) d -1))
         (doe (+ (* yoe 365) (truncate yoe 4) (- 0 (truncate yoe 100)) doy)))
    (+ (* era 146097) doe -719468)))

(define-low rule-seconds (y r)
  (let ((kind (mem :u64 r)) (day 0))
    (cond ((= kind 74)
           (setf day (+ (days-from-civil y 1 1) (mem :u64 (+ r 24)) -1))
           (when (and (leap y) (>= (mem :u64 (+ r 24)) 60)) (incf day)))
          ((= kind 68)
           (setf day (+ (days-from-civil y 1 1) (mem :u64 (+ r 24)))))
          (t
           (let* ((month (mem :u64 (+ r 8)))
                  (first (days-from-civil y month 1))
                  (wday (signed-rem (+ (signed-rem (+ first 4) 7) 7) 7))
                  (mday (+ 1 (rem (+ (- (mem :u64 (+ r 24)) wday) 7) 7) (* (- (mem :u64 (+ r 16)) 1) 7)))
                  (length (month-days (- month 1) y)))
             (while (> mday length) (setf mday (- mday 7)))
             (setf day (+ first mday -1)))))
    (+ (* day 86400) (mem :u64 (+ r 32)))))

(define-low posix-type (at)
  (unless zone-has-dst (result (address zone-std)))
  (let* ((tm (malloc 56))
         (local (+ at (mem :u64 (address zone-std))))
         (y 0) (start 0) (end 0) (in 0))
    (gmtime_r (address local) tm)
    (setf y (+ (sign-extend :u32 (mem :u32 (+ tm 20))) 1900))
    (free tm)
    (setf start (- (rule-seconds y (address zone-start)) (mem :u64 (address zone-std))))
    (setf end (- (rule-seconds y (address zone-end)) (mem :u64 (address zone-dst))))
    (setf in (if (signed< start end)
                 (and (signed>= at start) (signed< at end))
                 (not (and (signed>= at end) (signed< at start)))))
    (if in (address zone-dst) (address zone-std))))

(define-low load-zone ()
  (let ((fd (sign-extend :u32 (open "/etc/localtime" 0))) (st 0) (b 0) (size 0) (got 0) (n 0) (p 0) (width 4) (pass 0))
    (when (signed< fd 0) (result 0))
    (setf st (malloc 144))
    (when (and (= (the :u32 (fstat fd st)) 0) (signed> (mem :u64 (+ st 48)) 44))
      (setf size (mem :u64 (+ st 48)))
      (setf b (malloc (+ size 1)))
      (when b
        (setf n 1)
        (while (and (< got size) (signed> n 0))
          (setf n (read fd (+ b got) (- size got)))
          (when (signed> n 0) (setf got (+ got n))))
        (when (/= got size)
          (free b)
          (setf b 0))))
    (free st)
    (close fd)
    (unless b (result 0))
    (setf (mem :u8 (+ b size)) 0)
    (when (/= (the :u32 (memcmp b "TZif" 4)) 0) (free b) (result 0))
    (while (< pass 2)
      (when (signed> (+ p 44) size) (free b) (result 0))
      (let* ((isut (be (+ b p 20) 4)) (isstd (be (+ b p 24) 4)) (leaps (be (+ b p 28) 4))
             (count (be (+ b p 32) 4)) (types (be (+ b p 36) 4)) (chars (be (+ b p 40) 4))
             (body (+ (* count width) count (* types 6) chars (* leaps (+ width 4)) isstd isut)))
        (when (or (signed< types 1) (signed> types +zone-types+) (signed> (+ p 44 body) size)) (free b) (result 0))
        (if (and (= pass 0) (>= (mem :u8 (+ b 4)) 50))
            (progn (setf p (+ p 44 body))
                   (setf width 8)
                   (incf pass))
            (let ((q (+ b p 44)) (i 0) (names 0))
              (setf zone-count count)
              (setf zone-type-count types)
              (setf zone-at (malloc (* 8 (if count count 1))))
              (setf zone-index (malloc (if count count 1)))
              (setf zone-names (malloc (+ chars 1)))
              (unless (and zone-at zone-index zone-names) (free b) (result 0))
              (while (signed< i count)
                (setf (mem :u64 (+ zone-at (* 8 i))) (be (+ q (* i width)) width))
                (incf i))
              (setf q (+ q (* count width)))
              (setf i 0)
              (while (signed< i count)
                (setf (mem :u8 (+ zone-index i)) (if (< (mem :u8 (+ q i)) types) (mem :u8 (+ q i)) 0))
                (incf i))
              (setf q (+ q count))
              (setf names (+ q (* types 6)))
              (memcpy zone-names names chars)
              (setf (mem :u8 (+ zone-names chars)) 0)
              (setf i 0)
              (while (signed< i types)
                (let ((at (mem :u8 (+ q (* i 6) 5))))
                  (set-zone-type (+ (address zone-type) (* 24 i)) (be (+ q (* i 6)) 4) (mem :u8 (+ q (* i 6) 4))
                                 (+ zone-names (if (< at chars) at chars))))
                (incf i))
              (setf p (+ p 44 body))
              (when (and (= width 8) (signed< p size) (= (mem :u8 (+ b p)) 10))
                (let ((end (strchr (+ b p 1) 10)))
                  (when end
                    (setf (mem :u8 end) 0)
                    (parse-posix (+ b p 1)))))
              (setf pass 2)))))
    (free b)
    0))

(define-low find-zone-type (at)
  (when (= zone-loaded 0)
    (while (not (compare-and-swap (address zone-lock) 0 1)) (sched_yield))
    (when (= zone-loaded 0)
      (load-zone)
      (tzset)
      (setf zone-loaded 1))
    (setf zone-lock 0))
  (when (and (= zone-type-count 0) (not zone-posix)) (result 0))
  (when (and zone-count (signed>= at (mem :u64 (+ zone-at (* 8 (- zone-count 1))))) zone-posix)
    (result (posix-type at)))
  (when (= zone-count 0)
    (result (if zone-posix (posix-type at) (address zone-type))))
  (when (signed< at (mem :u64 zone-at))
    (let ((i 0))
      (while (< i zone-type-count)
        (unless (mem :u64 (+ (address zone-type) (* 24 i) 8)) (result (+ (address zone-type) (* 24 i))))
        (incf i)))
    (result (address zone-type)))
  (let ((lo 0) (hi (- zone-count 1)))
    (while (< lo hi)
      (let ((mid (truncate (+ lo hi 1) 2)))
        (if (signed<= (mem :u64 (+ zone-at (* 8 mid))) at)
            (setf lo mid)
            (setf hi (- mid 1)))))
    (+ (address zone-type) (* 24 (mem :u8 (+ zone-index lo))))))

(define-low localtime_r (at tm)
  (let ((z (find-zone-type (mem :u64 at))) (local 0))
    (unless z (result (gmtime_r at tm)))
    (setf local (+ (mem :u64 at) (mem :u64 z)))
    (gmtime_r (address local) tm)
    (setf (mem :u32 (+ tm 32)) (mem :u64 (+ z 8)))
    (setf (mem :u64 (+ tm 40)) (mem :u64 z))
    (setf (mem :u64 (+ tm 48)) (mem :u64 (+ z 16)))
    tm))

(define-global shared-tm :u8 :count 56)

(define-low gmtime (at) (gmtime_r at (address shared-tm)))
(define-low localtime (at) (localtime_r at (address shared-tm)))

(define-low mktime (tm)
  (let ((y (+ (sign-extend :u32 (mem :u32 (+ tm 20))) 1900)) (days 0) (i 1970) (m 0))
    (while (signed< i y)
      (setf days (+ days (if (leap i) 366 365)))
      (incf i))
    (while (signed< m (sign-extend :u32 (mem :u32 (+ tm 16))))
      (setf days (+ days (month-days m y)))
      (incf m))
    (setf days (+ days (sign-extend :u32 (mem :u32 (+ tm 12))) -1))
    (+ (* days 86400) (* (sign-extend :u32 (mem :u32 (+ tm 8))) 3600)
       (* (sign-extend :u32 (mem :u32 (+ tm 4))) 60) (sign-extend :u32 (mem :u32 tm)))))

(define-low strftime (out n f tm)
  (let ((k (sign-extend :u32 (snprintf out n "%04d-%02d-%02d %02d:%02d:%02d"
                                       (+ (mem :u32 (+ tm 20)) 1900) (+ (mem :u32 (+ tm 16)) 1) (mem :u32 (+ tm 12))
                                       (mem :u32 (+ tm 8)) (mem :u32 (+ tm 4)) (mem :u32 tm)))))
    (if (or (signed< k 0) (>= k n)) 0 k)))

(define-low select (n r w e tv)
  (setf (mem :u32 (__errno_location)) +enosys+)
  (- 0 1))

(define-global asctime-buffer :u8 :count 26)
(define-low asctime_r (tm out)
  (let ((day (mem :u32 (+ tm 24))) (month (mem :u32 (+ tm 16)))
        (year (+ 1900 (sign-extend :u32 (mem :u32 (+ tm 20))))))
    (when (or (> day 6) (> month 11) (signed< year 0) (> year 9999))
      (fail-with +einval+) (result 0))
    (snprintf out 26 "%.3s %.3s %2d %02d:%02d:%02d %04d
"
              (+ "SunMonTueWedThuFriSat" (* day 3))
              (+ "JanFebMarAprMayJunJulAugSepOctNovDec" (* month 3))
              (mem :u32 (+ tm 12)) (mem :u32 (+ tm 8))
              (mem :u32 (+ tm 4)) (mem :u32 tm) year)
    out))
(define-low asctime (tm) (asctime_r tm (address asctime-buffer)))
