(in-package #:darterfly/libsa)

(define-low glob-char (ch flags)
  (if (and (logand flags 16) (>= ch 65) (<= ch 90)) (+ ch 32) ch))

(define-low glob-class (name len ch)
  (cond ((and (= len 5) (= (strncmp name "alnum" 5) 0)) (isalnum ch))
        ((and (= len 5) (= (strncmp name "alpha" 5) 0)) (isalpha ch))
        ((and (= len 5) (= (strncmp name "blank" 5) 0)) (or (= ch 32) (= ch 9)))
        ((and (= len 5) (= (strncmp name "cntrl" 5) 0)) (iscntrl ch))
        ((and (= len 5) (= (strncmp name "digit" 5) 0)) (isdigit ch))
        ((and (= len 5) (= (strncmp name "graph" 5) 0)) (isgraph ch))
        ((and (= len 5) (= (strncmp name "lower" 5) 0)) (islower ch))
        ((and (= len 5) (= (strncmp name "print" 5) 0)) (isprint ch))
        ((and (= len 5) (= (strncmp name "punct" 5) 0)) (ispunct ch))
        ((and (= len 5) (= (strncmp name "space" 5) 0)) (isspace ch))
        ((and (= len 5) (= (strncmp name "upper" 5) 0)) (isupper ch))
        ((and (= len 6) (= (strncmp name "xdigit" 6) 0)) (isxdigit ch))
        (t 0)))

;; Return -1 for a malformed bracket; NEXT points just after a valid bracket.
(define-low glob-bracket (pattern ch flags next)
  (let ((p (+ pattern 1)) (negate 0) (matched 0) (first 1))
    (when (or (= (mem :u8 p) 33) (= (mem :u8 p) 94))
      (setf negate 1) (incf p))
    (while (mem :u8 p)
      (when (and (= (mem :u8 p) 93) (= first 0))
        (setf (mem :u64 next) (+ p 1))
        (result (if negate (not matched) matched)))
      (setf first 0)
      (if (and (= (mem :u8 p) 91) (= (mem :u8 (+ p 1)) 58))
          (let ((start (+ p 2)) (end (+ p 2)))
            (while (and (mem :u8 end)
                        (not (and (= (mem :u8 end) 58)
                                  (= (mem :u8 (+ end 1)) 93))))
              (incf end))
            (when (= (mem :u8 end) 0) (result -1))
            (when (glob-class start (- end start) ch) (setf matched 1))
            (setf p (+ end 2)))
          (let ((low (mem :u8 p)) (high 0))
            (when (and (= low 92) (= (logand flags 2) 0))
              (incf p) (setf low (mem :u8 p))
              (when (= low 0) (result -1)))
            (incf p)
            (if (and (= (mem :u8 p) 45) (mem :u8 (+ p 1))
                     (/= (mem :u8 (+ p 1)) 93))
                (progn
                  (incf p) (setf high (mem :u8 p))
                  (when (and (= high 92) (= (logand flags 2) 0))
                    (incf p) (setf high (mem :u8 p))
                    (when (= high 0) (result -1)))
                  (incf p)
                  (when (and (>= (glob-char ch flags) (glob-char low flags))
                             (<= (glob-char ch flags) (glob-char high flags)))
                    (setf matched 1)))
                (when (= (glob-char ch flags) (glob-char low flags))
                  (setf matched 1))))))
    -1))

(define-low fnmatch (pattern string (flags :u32))
  (let ((p pattern) (s string) (star 0) (retry 0))
    (while 1
      (let ((pc (mem :u8 p)) (ch (mem :u8 s)) (next (+ p 1)) (match 0)
            (period (and (logand flags 4) (= (mem :u8 s) 46)
                         (or (= s string)
                             (and (logand flags 1) (= (mem :u8 (+ s -1)) 47))))))
        (cond
          ((= pc 0)
           (when (or (= ch 0) (and (logand flags 8) (= ch 47))) (result 0)))
          ((= pc 42)
           (unless period
             (setf star (+ p 1)) (setf retry s) (setf p star)
             (setf match 2)))
          ((= pc 63)
           (setf match (and ch (not period) (or (= (logand flags 1) 0) (/= ch 47)))))
          ((= pc 91)
           (let ((r (glob-bracket p ch flags (address next))))
             (if (= r -1)
                 (setf match (= ch 91))
                 (setf match (and r ch (not period)
                                 (or (= (logand flags 1) 0) (/= ch 47)))))))
          (t
           (when (and (= pc 92) (= (logand flags 2) 0))
             (setf pc (mem :u8 next)) (incf next))
           (setf match (and pc (= (glob-char pc flags) (glob-char ch flags))))))
        (cond ((= match 2))
              (match (setf p next) (incf s)
                     (when (and (logand flags 1) (= ch 47)) (setf star 0)))
              (t
               (when (or (= star 0) (= (mem :u8 retry) 0)
                         (and (logand flags 1) (= (mem :u8 retry) 47))) (result 1))
               (incf retry) (setf s retry) (setf p star)))))))
