(in-package #:darterfly/libsa)

(defconstant +erange+ 34)

(define-low memcpy (d s n)
  (rep-movsb d s n)
  d)

(define-low memmove (d s n)
  (cond ((or (= d s) (= n 0)) d)
        ((or (< d s) (>= d (+ s n))) (rep-movsb d s n) d)
        (t (while (> n 0)
             (decf n)
             (setf (mem :u8 (+ d n)) (mem :u8 (+ s n))))
           d)))

(define-low memset (d (c :u8) n)
  (rep-stosb d c n)
  d)

(define-low memcmp (a b n)
  (while (> n 0)
    (when (/= (mem :u8 a) (mem :u8 b))
      (result (- (mem :u8 a) (mem :u8 b))))
    (decf n) (incf a) (incf b))
  0)

(define-low memchr (s (c :u8) n)
  (while (> n 0)
    (when (= (mem :u8 s) c) (result s))
    (decf n) (incf s))
  0)

(define-low strlen (s)
  (let ((p s))
    (while (mem :u8 p) (incf p))
    (- p s)))

(define-low strnlen (s n)
  (let ((i 0))
    (while (and (< i n) (mem :u8 (+ s i))) (incf i))
    i))

(define-low strcpy (d s)
  (let ((i 0))
    (while (progn (setf (mem :u8 (+ d i)) (mem :u8 (+ s i))) (mem :u8 (+ s i)))
      (incf i))
    d))

(define-low strncpy (d s n)
  (let ((i 0))
    (while (and (< i n) (mem :u8 (+ s i)))
      (setf (mem :u8 (+ d i)) (mem :u8 (+ s i)))
      (incf i))
    (while (< i n)
      (setf (mem :u8 (+ d i)) 0)
      (incf i))
    d))

(define-low strcat (d s)
  (strcpy (+ d (strlen d)) s)
  d)

(define-low strncat (d s n)
  (let ((p (+ d (strlen d))))
    (while (and (> n 0) (mem :u8 s))
      (setf (mem :u8 p) (mem :u8 s))
      (incf p) (incf s) (decf n))
    (setf (mem :u8 p) 0)
    d))

(define-low strcmp (a b)
  (while (and (mem :u8 a) (= (mem :u8 a) (mem :u8 b)))
    (incf a) (incf b))
  (- (mem :u8 a) (mem :u8 b)))

(define-low strncmp (a b n)
  (while (> n 0)
    (when (/= (mem :u8 a) (mem :u8 b)) (result (- (mem :u8 a) (mem :u8 b))))
    (when (= (mem :u8 a) 0) (result 0))
    (decf n) (incf a) (incf b))
  0)

(define-low strcasecmp (a b)
  (while (and (mem :u8 a) (= (tolower (mem :u8 a)) (tolower (mem :u8 b))))
    (incf a) (incf b))
  (- (tolower (mem :u8 a)) (tolower (mem :u8 b))))

(define-low strncasecmp (a b n)
  (while (> n 0)
    (let ((x (tolower (mem :u8 a))) (y (tolower (mem :u8 b))))
      (when (/= x y) (result (- x y)))
      (when (= x 0) (result 0)))
    (decf n) (incf a) (incf b))
  0)

(define-low strchr (s (c :u8))
  (while 1
    (when (= (mem :u8 s) c) (result s))
    (when (= (mem :u8 s) 0) (result 0))
    (incf s)))

(define-low strrchr (s (c :u8))
  (let ((r 0))
    (while 1
      (when (= (mem :u8 s) c) (setf r s))
      (when (= (mem :u8 s) 0) (result r))
      (incf s))))

(define-low strstr (h n)
  (let ((k (strlen n)))
    (when (= k 0) (result h))
    (while (mem :u8 h)
      (when (= (the :u32 (strncmp h n k)) 0) (result h))
      (incf h))
    0))

(define-low strspn (s a)
  (let ((i 0))
    (while (and (mem :u8 (+ s i)) (strchr a (mem :u8 (+ s i)))) (incf i))
    i))

(define-low strcspn (s r)
  (let ((i 0))
    (while (and (mem :u8 (+ s i)) (not (strchr r (mem :u8 (+ s i))))) (incf i))
    i))

(define-low strpbrk (s a)
  (let ((p (+ s (strcspn s a))))
    (if (mem :u8 p) p 0)))

(define-global strtok-next :u64)

(define-low strtok (s sep)
  (when s (setf strtok-next s))
  (when (= strtok-next 0) (result 0))
  (setf strtok-next (+ strtok-next (strspn strtok-next sep)))
  (when (= (mem :u8 strtok-next) 0)
    (setf strtok-next 0)
    (result 0))
  (let ((tok strtok-next))
    (setf strtok-next (+ strtok-next (strcspn strtok-next sep)))
    (if (mem :u8 strtok-next)
        (progn (setf (mem :u8 strtok-next) 0) (incf strtok-next))
        (setf strtok-next 0))
    tok))

(define-low strdup (s)
  (let* ((n (+ (strlen s) 1)) (d (malloc n)))
    (when d (memcpy d s n))
    d))

(define-low strndup (s n)
  (let* ((k (strnlen s n)) (d (malloc (+ k 1))))
    (when d
      (memcpy d s k)
      (setf (mem :u8 (+ d k)) 0))
    d))

(define-low ffs ((i :u32))
  (if (= i 0)
      0
      (let ((n 1))
        (while (= (logand i 1) 0)
          (setf i (shr i 1))
          (incf n))
        n)))

(define-low strerror ((e :u32))
  (cond ((= e 0) "Success") ((= e 1) "Operation not permitted") ((= e 2) "No such file or directory")
        ((= e 3) "No such process") ((= e 4) "Interrupted system call") ((= e 5) "Input/output error")
        ((= e 9) "Bad file descriptor") ((= e 10) "No child processes") ((= e 11) "Resource temporarily unavailable")
        ((= e 12) "Cannot allocate memory") ((= e 13) "Permission denied") ((= e 14) "Bad address")
        ((= e 17) "File exists") ((= e 20) "Not a directory") ((= e 21) "Is a directory")
        ((= e 22) "Invalid argument") ((= e 24) "Too many open files") ((= e 25) "Inappropriate ioctl for device")
        ((= e 28) "No space left on device") ((= e 29) "Illegal seek") ((= e 30) "Read-only file system")
        ((= e 32) "Broken pipe") ((= e 34) "Numerical result out of range") ((= e 38) "Function not implemented")
        ((= e 36) "File name too long") ((= e 39) "Directory not empty") ((= e 40) "Too many levels of symbolic links")
        ((= e 110) "Connection timed out") ((= e 111) "Connection refused") ((= e 104) "Connection reset by peer")
        ((= e 107) "Transport endpoint is not connected") ((= e 106) "Transport endpoint is already connected")
        ((= e 100) "Network is down") ((= e 101) "Network is unreachable") ((= e 113) "No route to host")
        ((= e 98) "Address already in use") ((= e 88) "Socket operation on non-socket")
        ((= e 97) "Address family not supported by protocol") ((= e 95) "Operation not supported")
        (t "Unknown error")))

(define-low isdigit ((c :u32)) (and (>= c 48) (<= c 57)))
(define-low islower ((c :u32)) (and (>= c 97) (<= c 122)))
(define-low isupper ((c :u32)) (and (>= c 65) (<= c 90)))
(define-low isalpha ((c :u32)) (or (islower c) (isupper c)))
(define-low isalnum ((c :u32)) (or (isalpha c) (isdigit c)))
(define-low isxdigit ((c :u32)) (or (isdigit c) (and (>= c 97) (<= c 102)) (and (>= c 65) (<= c 70))))
(define-low isspace ((c :u32)) (or (= c 32) (and (>= c 9) (<= c 13))))
(define-low isprint ((c :u32)) (and (>= c 32) (< c 127)))
(define-low isgraph ((c :u32)) (and (> c 32) (< c 127)))
(define-low iscntrl ((c :u32)) (or (< c 32) (= c 127)))
(define-low ispunct ((c :u32)) (and (isgraph c) (not (isalnum c))))
(define-low toupper ((c :u32)) (if (islower c) (- c 32) c))
(define-low tolower ((c :u32)) (if (isupper c) (+ c 32) c))

(define-low parse-unsigned (s end (base :u32) negative overflow)
  (let ((p s) (v 0) (digits 0) (d 0) (going 1))
    (while (isspace (mem :u8 p)) (incf p))
    (setf (mem :u32 negative) 0)
    (when (or (= (mem :u8 p) 43) (= (mem :u8 p) 45))
      (setf (mem :u32 negative) (= (mem :u8 p) 45))
      (incf p))
    (if (and (or (= base 0) (= base 16)) (= (mem :u8 p) 48)
             (or (= (mem :u8 (+ p 1)) 120) (= (mem :u8 (+ p 1)) 88)) (isxdigit (mem :u8 (+ p 2))))
        (progn (setf p (+ p 2)) (setf base 16))
        (when (= base 0) (setf base (if (= (mem :u8 p) 48) 8 10))))
    (setf digits p)
    (setf (mem :u32 overflow) 0)
    (while going
      (cond ((isdigit (mem :u8 p)) (setf d (- (mem :u8 p) 48)))
            ((isalpha (mem :u8 p)) (setf d (+ (- (tolower (mem :u8 p)) 97) 10)))
            (t (setf going 0)))
      (when (and going (>= d base)) (setf going 0))
      (when going
        (when (> v (truncate (- (lognot 0) d) base)) (setf (mem :u32 overflow) 1))
        (setf v (+ (* v base) d))
        (incf p)))
    (when end (setf (mem :u64 end) (if (= p digits) s p)))
    v))

(define-low strtoull (s end (base :u32))
  (let ((neg 0) (over 0))
    (let ((v (parse-unsigned s end base (address neg) (address over))))
      (cond ((the :u32 over) (setf (mem :u32 (__errno_location)) +erange+) (lognot 0))
            ((the :u32 neg) (- 0 v))
            (t v)))))

(define-low strtoul (s end (base :u32)) (strtoull s end base))

(define-low strtoll (s end (base :u32))
  (let ((neg 0) (over 0))
    (let ((v (parse-unsigned s end base (address neg) (address over))))
      (cond ((or (the :u32 over) (> v (if (the :u32 neg) (shl 1 63) (- (shl 1 63) 1))))
             (setf (mem :u32 (__errno_location)) +erange+)
             (if (the :u32 neg) (shl 1 63) (- (shl 1 63) 1)))
            ((the :u32 neg) (- 0 v))
            (t v)))))

(define-low strtol (s end (base :u32)) (strtoll s end base))
(define-low strtoimax (s end (base :u32)) (strtoll s end base))
(define-low strtoumax (s end (base :u32)) (strtoull s end base))
(define-low atoi (s) (strtol s 0 10))
(define-low atol (s) (strtol s 0 10))

(define-low atof (s) (strtod s 0))

(define-low abs ((x :u32)) (let ((v (sign-extend :u32 x))) (if (signed< v 0) (- 0 v) v)))
(define-low labs (x) (if (signed< x 0) (- 0 x) x))
(define-low llabs (x) (if (signed< x 0) (- 0 x) x))

(define-low swap-bytes (a b n)
  (while (> n 0)
    (let ((x (mem :u8 a)))
      (setf (mem :u8 a) (mem :u8 b))
      (setf (mem :u8 b) x))
    (incf a) (incf b) (decf n)))

(define-low qsort (base n size cmp)
  (let ((i 1))
    (while (< i n)
      (let ((j i))
        (while (and (> j 0)
                    (signed> (sign-extend :u32 (call-pointer cmp (+ base (* (- j 1) size)) (+ base (* j size)))) 0))
          (swap-bytes (+ base (* (- j 1) size)) (+ base (* j size)) size)
          (decf j)))
      (incf i))))

(define-low bsearch (key base n size cmp)
  (let ((lo 0) (hi n))
    (while (< lo hi)
      (let* ((mid (truncate (+ lo hi) 2))
             (c (sign-extend :u32 (call-pointer cmp key (+ base (* mid size))))))
        (cond ((= c 0) (result (+ base (* mid size))))
              ((signed< c 0) (setf hi mid))
              (t (setf lo (+ mid 1))))))
    0))

(define-low strerror_r ((err :u32) buf size)
  (let* ((message (strerror err)) (length (strlen message)))
    (when (<= size length)
      (when size
        (memcpy buf message (- size 1))
        (setf (mem :u8 (+ buf size -1)) 0))
      (result +erange+))
    (memcpy buf message (+ length 1))
    0))

(define-low memmem (haystack size needle length)
  (when (= length 0) (result haystack))
  (when (> length size) (result 0))
  (let ((n (- size length)) (i 0))
    (while (<= i n)
      (when (= (memcmp (+ haystack i) needle length) 0)
        (result (+ haystack i)))
      (incf i)))
  0)

(define-low strtok_r (s separators save)
  (unless s (setf s (mem :u64 save)))
  (unless s (result 0))
  (incf s (strspn s separators))
  (when (= (mem :u8 s) 0) (setf (mem :u64 save) s) (result 0))
  (let ((end (+ s (strcspn s separators))))
    (when (mem :u8 end) (setf (mem :u8 end) 0) (incf end))
    (setf (mem :u64 save) end)
    s))
