(in-package #:darterfly/libsa)

(defconstant +limbs+ 720)
(defconstant +max-digits+ 800)
(defconstant +big-size+ 2888)

(define-low limb (a i) (mem :u32 (+ a 4 (* 4 i))))
(define-low set-limb (a i v) (setf (mem :u32 (+ a 4 (* 4 i))) v))
(define-low limbs (a) (sign-extend :u32 (mem :u32 a)))
(define-low set-limbs (a n) (setf (mem :u32 a) n))

(define-low new-big () (calloc 1 +big-size+))
(define-low copy-big (to from) (memcpy to from +big-size+))

(define-low big-set (a (v :u32))
  (set-limbs a (if v 1 0))
  (set-limb a 0 v))

(define-low big-trim (a)
  (while (and (signed> (limbs a) 0) (= (limb a (- (limbs a) 1)) 0))
    (set-limbs a (- (limbs a) 1))))

(define-low big-muladd (a (m :u32) (add :u32))
  (let ((carry add) (i 0))
    (while (signed< i (limbs a))
      (let ((v (+ (* (limb a i) m) carry)))
        (set-limb a i (the :u32 v))
        (setf carry (shr v 32)))
      (incf i))
    (when carry
      (set-limb a (limbs a) carry)
      (set-limbs a (+ (limbs a) 1)))))

(define-low big-pow10 (a e)
  (while (signed>= e 9)
    (big-muladd a 1000000000 0)
    (setf e (- e 9)))
  (when e
    (big-muladd a (ref-power-of-ten e) 0)))

(define-low ref-power-of-ten (e)
  (let ((v 1))
    (while (signed> e 0) (setf v (* v 10)) (decf e))
    v))

(define-low big-bits (a)
  (when (= (limbs a) 0) (result 0))
  (let ((bits (* (- (limbs a) 1) 32)) (top (limb a (- (limbs a) 1))))
    (while top (incf bits) (setf top (shr top 1)))
    bits))

(define-low big-shl (a s)
  (when (or (= (limbs a) 0) (= s 0)) (result 0))
  (let* ((w (truncate s 32)) (b (rem s 32)) (n (+ (limbs a) w 1)) (i (- n 1)))
    (while (signed>= i 0)
      (let ((hi (if (and (signed>= (- i w) 0) (signed< (- i w) (limbs a))) (limb a (- i w)) 0))
            (lo (if (and (signed>= (- i w 1) 0) (signed< (- i w 1) (limbs a))) (limb a (- i w 1)) 0)))
        (set-limb a i (if b (the :u32 (logior (shl hi b) (shr lo (- 32 b)))) hi)))
      (decf i))
    (set-limbs a n)
    (big-trim a)))

(define-low big-cmp (a b)
  (when (/= (limbs a) (limbs b)) (result (if (signed< (limbs a) (limbs b)) (- 0 1) 1)))
  (let ((i (- (limbs a) 1)))
    (while (signed>= i 0)
      (when (/= (limb a i) (limb b i)) (result (if (< (limb a i) (limb b i)) (- 0 1) 1)))
      (decf i))
    0))

(define-low big-sub (a b)
  (let ((borrow 0) (i 0))
    (while (signed< i (limbs a))
      (let ((v (- (- (limb a i) (if (signed< i (limbs b)) (limb b i) 0)) borrow)))
        (setf borrow (signed< v 0))
        (set-limb a i (the :u32 v)))
      (incf i))
    (big-trim a)))

(define-low big-low (a bits)
  (let ((v 0))
    (when (signed> (limbs a) 0) (setf v (limb a 0)))
    (when (signed> (limbs a) 1) (setf v (logior v (shl (limb a 1) 32))))
    (if (signed>= bits 64) v (logand v (- (shl 1 bits) 1)))))

(define-low big-bit (a i)
  (and (signed< (truncate i 32) (limbs a)) (logand (shr (limb a (truncate i 32)) (rem i 32)) 1)))

(define-low big-low-nonzero (a bits)
  (let ((i 0) (rest (rem bits 32)))
    (while (and (signed< i (truncate bits 32)) (signed< i (limbs a)))
      (when (limb a i) (result 1))
      (incf i))
    (and rest (signed< (truncate bits 32) (limbs a))
         (/= (logand (limb a (truncate bits 32)) (- (shl 1 rest) 1)) 0))))

(define-low big-div (num den)
  (let ((q 0) (shifted (new-big)) (i (- (big-bits num) (big-bits den))))
    (while (signed>= i 0)
      (copy-big shifted den)
      (big-shl shifted i)
      (when (signed>= (sign-extend :u32 (big-cmp num shifted)) 0)
        (big-sub num shifted)
        (setf q (logior q (shl 1 i))))
      (decf i))
    (free shifted)
    q))

(define-low round-decimal (m e10 p emin mant exp2)
  (let ((den (new-big)) (lead 0) (e 0) (q 0) (cmp 0))
    (if (signed>= e10 0)
        (progn (big-pow10 m e10)
               (setf lead (- (big-bits m) 1)))
        (let* ((s (- (big-bits m) (big-bits den))) (tt (new-big)))
          (big-set den 1)
          (big-pow10 den (- 0 e10))
          (setf s (- (big-bits m) (big-bits den)))
          (copy-big tt (if (signed>= s 0) den m))
          (big-shl tt (if (signed>= s 0) s (- 0 s)))
          (setf lead (if (signed>= (sign-extend :u32 (if (signed>= s 0) (big-cmp m tt) (big-cmp tt den))) 0) s (- s 1)))
          (free tt)))
    (setf e (+ (- (if (signed< lead emin) emin lead) p) 1))
    (cond ((and (signed>= e10 0) (signed>= e 0))
           (let ((i 0))
             (while (and (signed< i p) (signed<= (+ e i) lead))
               (setf q (logior q (shl (big-bit m (+ e i)) i)))
               (incf i)))
           (setf cmp (cond ((= e 0) (- 0 1))
                           ((not (big-bit m (- e 1))) (- 0 1))
                           ((big-low-nonzero m (- e 1)) 1)
                           (t 0))))
          ((signed>= e10 0)
           (big-shl m (- 0 e))
           (setf q (big-low m 64))
           (setf cmp (- 0 1)))
          (t
           (if (signed>= e 0) (big-shl den e) (big-shl m (- 0 e)))
           (setf q (big-div m den))
           (big-shl m 1)
           (setf cmp (sign-extend :u32 (big-cmp m den)))))
    (when (or (signed> cmp 0) (and (= cmp 0) (logand q 1)))
      (incf q)
      (when (or (= q 0) (and (signed< p 64) (= q (shl 1 p))))
        (setf q (shl 1 (- p 1)))
        (incf e)))
    (free den)
    (setf (mem :u64 mant) q)
    (setf (mem :u64 exp2) e)
    lead))

(defconstant +d-sign+ 0)
(defconstant +d-special+ 8)
(defconstant +d-e10+ 16)
(defconstant +d-end+ 24)
(defconstant +d-m+ 32)

(define-low match-word (p word)
  (while (mem :u8 word)
    (when (/= (tolower (mem :u8 p)) (mem :u8 word)) (result 0))
    (incf p) (incf word))
  1)

(define-low parse-decimal (s d)
  (let ((p s) (m (+ d +d-m+)) (digits 0) (seen 0) (sticky 0) (dot 0) (going 1))
    (while (isspace (mem :u8 p)) (incf p))
    (setf (mem :u64 (+ d +d-sign+)) 0)
    (when (or (= (mem :u8 p) 43) (= (mem :u8 p) 45))
      (setf (mem :u64 (+ d +d-sign+)) (= (mem :u8 p) 45))
      (incf p))
    (setf (mem :u64 (+ d +d-special+)) 0)
    (setf (mem :u64 (+ d +d-e10+)) 0)
    (big-set m 0)
    (when (match-word p "inf")
      (setf (mem :u64 (+ d +d-special+)) 1)
      (setf (mem :u64 (+ d +d-end+)) (+ p (if (match-word p "infinity") 8 3)))
      (result 0))
    (when (match-word p "nan")
      (setf (mem :u64 (+ d +d-special+)) 2)
      (setf (mem :u64 (+ d +d-end+)) (+ p 3))
      (result 0))
    (while going
      (cond ((and (= (mem :u8 p) 46) (not dot)) (setf dot 1) (incf p))
            ((not (isdigit (mem :u8 p))) (setf going 0))
            (t (setf seen 1)
               (if (signed< digits +max-digits+)
                   (progn
                     (when (or digits (/= (mem :u8 p) 48))
                       (big-muladd m 10 (- (mem :u8 p) 48))
                       (incf digits))
                     (when dot (setf (mem :u64 (+ d +d-e10+)) (- (mem :u64 (+ d +d-e10+)) 1))))
                   (progn
                     (when (/= (mem :u8 p) 48) (setf sticky 1))
                     (unless dot (setf (mem :u64 (+ d +d-e10+)) (+ (mem :u64 (+ d +d-e10+)) 1)))))
               (incf p))))
    (unless seen
      (setf (mem :u64 (+ d +d-end+)) s)
      (result 0))
    (when sticky
      (big-muladd m 10 1)
      (setf (mem :u64 (+ d +d-e10+)) (- (mem :u64 (+ d +d-e10+)) 1)))
    (when (or (= (mem :u8 p) 101) (= (mem :u8 p) 69))
      (let ((q (+ p 1)) (neg 0) (x 0))
        (when (or (= (mem :u8 q) 43) (= (mem :u8 q) 45))
          (setf neg (= (mem :u8 q) 45))
          (incf q))
        (when (isdigit (mem :u8 q))
          (while (isdigit (mem :u8 q))
            (when (< x 100000) (setf x (+ (* x 10) (- (mem :u8 q) 48))))
            (incf q))
          (setf (mem :u64 (+ d +d-e10+)) (+ (mem :u64 (+ d +d-e10+)) (if neg (- 0 x) x)))
          (setf p q))))
    (setf (mem :u64 (+ d +d-end+)) p)
    0))

(define-low convert-decimal (d p emin emax mant exp2)
  (let* ((m (+ d +d-m+)) (e10 (mem :u64 (+ d +d-e10+))) (magnitude 0))
    (when (= (limbs m) 0) (result 0))
    (setf magnitude (+ e10 (truncate (* (big-bits m) 3) 10)))
    (when (signed> magnitude (+ (signed-truncate emax 3) 2)) (result 2))
    (when (signed< magnitude (- (signed-truncate (- emin p) 3) 2)) (result 0))
    (round-decimal m e10 p emin mant exp2)
    (when (= (mem :u64 mant) 0) (result 0))
    (when (signed> (+ (mem :u64 exp2) p -1) emax) (result 2))
    1))

(define-low read-decimal (s end)
  (let ((d (malloc (+ +d-m+ +big-size+))))
    (parse-decimal s d)
    (when end (setf (mem :u64 end) (mem :u64 (+ d +d-end+))))
    d))

(define-low strtod (s end) (declare (returns :f64))
  (let ((d (read-decimal s end)) (r 0) (mant 0) (e 0) (kind 0))
    (cond ((= (mem :u64 (+ d +d-special+)) 1) (setf r (shl #x7ff 52)))
          ((= (mem :u64 (+ d +d-special+)) 2) (setf r (shl #x7ff8 48)))
          (t (setf kind (convert-decimal d 53 (- 0 1022) 1023 (address mant) (address e)))
             (cond ((= kind 2) (setf r (shl #x7ff 52)) (setf (mem :u32 (__errno_location)) +erange+))
                   ((= kind 1) (setf r (if (shr mant 52)
                                           (logior (shl (+ e 52 1023) 52) (logand mant (- (shl 1 52) 1)))
                                           mant)))
                   ((limbs (+ d +d-m+)) (setf (mem :u32 (__errno_location)) +erange+)))))
    (when (mem :u64 (+ d +d-sign+)) (setf r (logior r (shl 1 63))))
    (free d)
    r))

(define-low strtof (s end) (declare (returns :f32-bits))
  (let ((d (read-decimal s end)) (r 0) (mant 0) (e 0) (kind 0))
    (cond ((= (mem :u64 (+ d +d-special+)) 1) (setf r (shl #xff 23)))
          ((= (mem :u64 (+ d +d-special+)) 2) (setf r #x7fc00000))
          (t (setf kind (convert-decimal d 24 (- 0 126) 127 (address mant) (address e)))
             (cond ((= kind 2) (setf r (shl #xff 23)) (setf (mem :u32 (__errno_location)) +erange+))
                   ((= kind 1) (setf r (if (shr mant 23)
                                           (logior (shl (+ e 23 127) 23) (logand mant (- (shl 1 23) 1)))
                                           mant)))
                   ((limbs (+ d +d-m+)) (setf (mem :u32 (__errno_location)) +erange+)))))
    (when (mem :u64 (+ d +d-sign+)) (setf r (logior r (shl 1 31))))
    (free d)
    (the :u32 r)))

(define-low strtold-bits (s end out)
  (let ((d (read-decimal s end)) (m 0) (se 0) (mant 0) (e 0) (kind 0))
    (cond ((= (mem :u64 (+ d +d-special+)) 1) (setf m (shl 1 63)) (setf se #x7fff))
          ((= (mem :u64 (+ d +d-special+)) 2) (setf m (shl 3 62)) (setf se #x7fff))
          (t (setf kind (convert-decimal d 64 (- 0 16382) 16383 (address mant) (address e)))
             (cond ((= kind 2) (setf m (shl 1 63)) (setf se #x7fff) (setf (mem :u32 (__errno_location)) +erange+))
                   ((= kind 1) (setf m mant) (setf se (if (shr mant 63) (the :u16 (+ e 63 16383)) 0)))
                   ((limbs (+ d +d-m+)) (setf (mem :u32 (__errno_location)) +erange+)))))
    (when (mem :u64 (+ d +d-sign+)) (setf se (logior se #x8000)))
    (free d)
    (setf (mem :u64 out) m)
    (setf (mem :u16 (+ out 8)) se)
    0))

(defun strtold-routine ()
  (darterfly/asm:routine "strtold"
    (darterfly/asm:inst sub darterfly/asm:rsp-tn 24)
    (darterfly/asm:inst mov darterfly/asm:rdx-tn darterfly/asm:rsp-tn)
    (darterfly/asm:inst call (darterfly/asm:external "strtold_bits"))
    (dolist (b '(#xDB #x2C #x24)) (darterfly/asm:inst byte b))
    (darterfly/asm:inst add darterfly/asm:rsp-tn 24)
    (darterfly/asm:inst ret)))
