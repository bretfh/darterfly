(in-package #:darterfly/libsa)

(define-low inet4-parse (source dest)
  (let ((i 0) (p source))
    (while (< i 4)
      (let ((value 0) (digits 0) (first (mem :u8 p)))
        (while (and (>= (mem :u8 p) 48) (<= (mem :u8 p) 57))
          (when (and (> digits 0) (= first 48)) (result 0))
          (setf value (+ (* value 10) (- (mem :u8 p) 48)))
          (incf digits) (incf p)
          (when (> value 255) (result 0)))
        (when (= digits 0) (result 0))
        (setf (mem :u8 (+ dest i)) value)
        (if (= i 3)
            (when (/= (mem :u8 p) 0) (result 0))
            (progn (when (/= (mem :u8 p) 46) (result 0)) (incf p))))
      (incf i))
    1))

(define-low inet-hex (ch)
  (cond ((and (>= ch 48) (<= ch 57)) (- ch 48))
        ((and (>= (logior ch 32) 97) (<= (logior ch 32) 102))
         (+ 10 (- (logior ch 32) 97)))
        (t 16)))

(define-low inet6-finish (dest used gap)
  (if (= gap -1)
      (if (= used 16) 1 0)
      (progn
        (when (>= used 16) (result 0))
        (memmove (+ dest gap (- 16 used)) (+ dest gap) (- used gap))
        (memset (+ dest gap) 0 (- 16 used))
        1)))

(define-low inet6-parse (source dest)
  (let ((p source) (used 0) (gap -1))
    (when (= (mem :u8 p) 58)
      (unless (= (mem :u8 (+ p 1)) 58) (result 0))
      (setf gap 0) (incf p 2))
    (while (mem :u8 p)
      (let ((start p) (value 0) (digits 0))
        (while (< (inet-hex (mem :u8 p)) 16)
          (setf value (+ (* value 16) (inet-hex (mem :u8 p))))
          (incf digits) (incf p)
          (when (> digits 4) (result 0)))
        (when (= (mem :u8 p) 46)
          (when (or (> used 12) (= (inet4-parse start (+ dest used)) 0))
            (result 0))
          (result (inet6-finish dest (+ used 4) gap)))
        (when (or (= digits 0) (> used 14)) (result 0))
        (setf (mem :u8 (+ dest used)) (shr value 8))
        (setf (mem :u8 (+ dest used 1)) (logand value 255))
        (incf used 2)
        (when (mem :u8 p)
          (unless (= (mem :u8 p) 58) (result 0))
          (incf p)
          (when (= (mem :u8 p) 58)
            (unless (= gap -1) (result 0))
            (setf gap used) (incf p)
            (when (= (mem :u8 p) 0)
              (result (inet6-finish dest used gap))))
          (when (= (mem :u8 p) 0) (result 0)))))
    (inet6-finish dest used gap)))

(define-low inet_pton ((family :u32) source dest)
  (unless (or (= family 2) (= family 10))
    (result (fail-with +eafnosupport+)))
  (let ((buf (calloc 1 16)) (ok 0))
    (unless buf (result (fail-with +enomem+)))
    (setf ok (if (= family 2) (inet4-parse source buf) (inet6-parse source buf)))
    (when ok (memcpy dest buf (if (= family 2) 4 16)))
    (free buf)
    ok))

(define-low inet_aton (source dest) (inet_pton 2 source dest))

(define-low inet-word (source index)
  (logior (shl (mem :u8 (+ source (* index 2))) 8)
          (mem :u8 (+ source (* index 2) 1))))

(define-low inet4-format (source output)
  (snprintf output 16 "%u.%u.%u.%u" (mem :u8 source)
            (mem :u8 (+ source 1)) (mem :u8 (+ source 2))
            (mem :u8 (+ source 3))))

(define-low inet6-format (source output)
  (let ((best 8) (length 1) (i 0) (at 0))
    (when (and (= (mem :u64 source) 0) (= (mem :u16 (+ source 8)) 0)
               (= (mem :u16 (+ source 10)) 65535))
      (memcpy output "::ffff:" 7)
      (result (+ 7 (inet4-format (+ source 12) (+ output 7)))))
    (while (< i 8)
      (let ((run 0))
        (while (and (< (+ i run) 8) (= (inet-word source (+ i run)) 0))
          (incf run))
        (when (> run length) (setf best i) (setf length run)))
      (incf i))
    (setf i 0)
    (while (< i 8)
      (if (= i best)
          (progn
            (setf (mem :u8 (+ output at)) 58)
            (setf (mem :u8 (+ output at 1)) 58)
            (incf at 2) (incf i length))
          (progn
            (when (and (> at 0) (/= (mem :u8 (+ output at -1)) 58))
              (setf (mem :u8 (+ output at)) 58) (incf at))
            (incf at (snprintf (+ output at) 5 "%x" (inet-word source i)))
            (incf i))))
    (setf (mem :u8 (+ output at)) 0)
    at))

(define-low inet_ntop ((family :u32) source dest (capacity :u32))
  (unless (or (= family 2) (= family 10))
    (fail-with +eafnosupport+) (result 0))
  (let ((buf (malloc 64)) (len 0))
    (unless buf (fail-with +enomem+) (result 0))
    (setf len (if (= family 2) (inet4-format source buf) (inet6-format source buf)))
    (when (>= len capacity) (free buf) (fail-with 28) (result 0))
    (memcpy dest buf (+ len 1)) (free buf) dest))

(define-low getnameinfo (addr (length :u32) host (hostlen :u32)
                             service (servlen :u32) (flags :u32))
  (when (< length 2) (result -6))
  (let ((family (mem :u16 addr)))
    (unless (or (and (= family 2) (>= length 16))
                (and (= family 10) (>= length 28))) (result -6))
    (when (and host hostlen)
      (when (logand flags 8) (result -2))
      (unless (inet_ntop family (+ addr (if (= family 2) 4 8)) host hostlen)
        (result -12)))
    (when (and service servlen)
      (when (>= (snprintf service servlen "%u"
                  (logior (shl (mem :u8 (+ addr 2)) 8) (mem :u8 (+ addr 3))))
                servlen) (result -12)))
    0))

(define-global inet-services :u64 :count 8)
(define-low getservbyname (name protocol)
  (when (and protocol (/= (strcmp protocol "tcp") 0)) (result 0))
  (let ((record (address inet-services)) (port 0) (literal 0))
    (cond ((= (strcmp name "http") 0) (setf literal "http") (setf port 80))
          ((= (strcmp name "https") 0)
           (incf record 32) (setf literal "https") (setf port 443))
          (t (result 0)))
    (setf (mem :u64 record) literal)
    (setf (mem :u64 (+ record 8)) 0)
    (setf (mem :u32 (+ record 16)) (logior (shl (logand port 255) 8) (shr port 8)))
    (setf (mem :u64 (+ record 24)) "tcp")
    record))

;; POSIX permits inet_ntoa's static buffer to be overwritten by the next call.
;; Reentrant clients use inet_ntop with their own buffer instead.
(define-global inet-ntoa-buffer :u8 :count 16)
(define-low inet_ntoa ((value :u32))
  (inet_ntop 2 (address value) (address inet-ntoa-buffer) 16))
