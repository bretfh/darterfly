(in-package #:darterfly/libsa)

(defconstant +min-class+ 4)
(defconstant +max-class+ 19)
(defconstant +arena+ (ash 1 22))
(defconstant +enomem+ 12)

(define-global free-lists :u64 :count 20)
(define-global malloc-lock :u32)
(define-global arena-next :u64)
(define-global arena-end :u64)

(define-low malloc-grab ()
  (while (not (compare-and-swap (address malloc-lock) 0 1))
    (sched_yield)))

(define-low malloc-release ()
  (setf malloc-lock 0))

(define-low anonymous (n)
  (mmap 0 n 3 #x22 (lognot 0) 0))

(define-low class-of (n)
  (let ((c +min-class+))
    (while (< (shl 1 c) n) (incf c))
    c))

(define-low carve (n)
  (when (> (+ arena-next n) arena-end)
    (let ((a (anonymous +arena+)))
      (when (= a (lognot 0)) (result 0))
      (setf arena-next a)
      (setf arena-end (+ a +arena+))))
  (let ((p arena-next))
    (setf arena-next (+ arena-next n))
    p))

(define-low malloc (n)
  (let ((total (+ n 16)))
    (when (> total (shl 1 +max-class+))
      (let ((h (anonymous (logand (+ total 4095) (lognot 4095)))))
        (when (= h (lognot 0))
          (setf (mem :u32 (__errno_location)) +enomem+)
          (result 0))
        (setf (mem :u64 h) n)
        (setf (mem :u64 (+ h 8)) 0)
        (result (+ h 16))))
    (let ((c (class-of total)) (h 0))
      (malloc-grab)
      (setf h (ref free-lists c))
      (if h
          (setf (ref free-lists c) (mem :u64 h))
          (setf h (carve (shl 1 c))))
      (malloc-release)
      (when (= h 0)
        (setf (mem :u32 (__errno_location)) +enomem+)
        (result 0))
      (setf (mem :u64 h) n)
      (setf (mem :u64 (+ h 8)) c)
      (+ h 16))))

(define-low free (p)
  (when (= p 0) (result 0))
  (let* ((h (- p 16)) (c (mem :u64 (+ h 8))))
    (when (= c 0)
      (munmap h (logand (+ (mem :u64 h) 16 4095) (lognot 4095)))
      (result 0))
    (malloc-grab)
    (setf (mem :u64 h) (ref free-lists c))
    (setf (ref free-lists c) h)
    (malloc-release)
    0))

(define-low calloc (a b)
  (let ((n (* a b)))
    (when (and b (/= (truncate n b) a))
      (setf (mem :u32 (__errno_location)) +enomem+)
      (result 0))
    (let ((p (malloc n)))
      (when p (memset p 0 n))
      p)))

(define-low realloc (p n)
  (when (= p 0) (result (malloc n)))
  (let* ((h (- p 16)) (c (mem :u64 (+ h 8))))
    (when (and c (<= (+ n 16) (shl 1 c)))
      (setf (mem :u64 h) n)
      (result p))
    (let ((q (malloc n)))
      (when (= q 0) (result 0))
      (memcpy q p (if (< (mem :u64 h) n) (mem :u64 h) n))
      (free p)
      q)))

(define-low posix_memalign (out align n)
  (when (<= align 16)
    (setf (mem :u64 out) (malloc n))
    (result (if (mem :u64 out) 0 +enomem+)))
  (let* ((len (logand (+ n align 4095) (lognot 4095)))
         (p (anonymous (+ len align))))
    (when (= p (lognot 0)) (result +enomem+))
    (setf (mem :u64 out) (logand (+ p align -1) (lognot (- align 1))))
    0))

(define-low aligned_alloc (align n)
  (let ((p 0))
    (if (= (the :u32 (posix_memalign (address p) align n)) 0) p 0)))

(define-global exit-handlers :u64 :count 32)
(define-global exit-handler-count :u64)

(define-low atexit (f)
  (when (= exit-handler-count 32) (result (- 0 1)))
  (setf (ref exit-handlers exit-handler-count) f)
  (incf exit-handler-count)
  0)

(define-low exit ((code :u32))
  (while exit-handler-count
    (decf exit-handler-count)
    (call-pointer (ref exit-handlers exit-handler-count)))
  (_exit code))

(define-low |_Exit| ((code :u32)) (_exit code))

(define-low abort ()
  (raise 6)
  (_exit 134))

(define-global seed-flipped :u64)

(define-low rand ()
  (let ((seed (+ (* (logxor seed-flipped 1) 6364136223846793005) 1)))
    (setf seed-flipped (logxor seed 1))
    (the :u32 (shr seed 33))))

(define-low srand ((s :u32)) (setf seed-flipped (logxor s 1)) 0)
(define-low random () (rand))
(define-low srandom ((s :u32)) (srand s))
(define-low system (c) (- 0 1))

(define-low __assert_fail (e file (line :u32) fn)
  (dprintf 2 "assertion failed: %s at %s:%u in %s
" e file line fn)
  (abort))
