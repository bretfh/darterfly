(in-package #:darterfly/libsa)

;; ELF64/SysV DSOs for the native libsa ABI. All storage, I/O, locks and TLS
;; ownership are the existing runtime's. No interpreter or Linux libc is loaded.
;; Successful modules remain resident until process exit (including dlclose).
(define-low __libsa_export (name) 0) ; generated by LIBSA-OBJECT
(define-global dl-modules :u64 :count 64)
(define-global dl-count :u64)
(define-global dl-order :u64 :count 64)
(define-global dl-initialized :u64)
(define-global dl-lock :u8 :count 16)
(define-global dl-once :u32)

;; Module fields; followed by up to 64 direct dependency pointers.
(defconstant +dl-path+ 0)
(defconstant +dl-base+ 8)
(defconstant +dl-size+ 16)
(defconstant +dl-phdr+ 24)
(defconstant +dl-phnum+ 32)
(defconstant +dl-dynamic+ 40)
(defconstant +dl-dynsize+ 48)
(defconstant +dl-symtab+ 56)
(defconstant +dl-strtab+ 64)
(defconstant +dl-strsz+ 72)
(defconstant +dl-nsym+ 80)
(defconstant +dl-rela+ 88)
(defconstant +dl-relasz+ 96)
(defconstant +dl-jmprel+ 104)
(defconstant +dl-pltsz+ 112)
(defconstant +dl-init+ 120)
(defconstant +dl-fini+ 128)
(defconstant +dl-initarray+ 136)
(defconstant +dl-initsz+ 144)
(defconstant +dl-finiarray+ 152)
(defconstant +dl-finisz+ 160)
(defconstant +dl-relro+ 168)
(defconstant +dl-relrosz+ 176)
(defconstant +dl-tlsimage+ 184)
(defconstant +dl-tlsfilesz+ 192)
(defconstant +dl-tlssize+ 200)
(defconstant +dl-tlsalign+ 208)
(defconstant +dl-id+ 216)
(defconstant +dl-state+ 224)
(defconstant +dl-global+ 232)
(defconstant +dl-refs+ 240)
(defconstant +dl-ndep+ 248)
(defconstant +dl-deps+ 256)
(defconstant +dl-sizeof+ 768)

(define-low dl-lock-init () (setf (mem :u32 (+ (address dl-lock) 4)) 1))
(define-low dl-enter ()
  (pthread_once (address dl-once) (code-address dl-lock-init))
  (pthread_mutex_lock (address dl-lock)))
(define-low dl-leave () (pthread_mutex_unlock (address dl-lock)))
;; Remaining reserved words of libsa's existing thread pointer: DTV at 32,
;; dlerror at 40, diagnostic allocation at 48. Separate from errno and dtors.
(define-low dl-fail (message) (setf (mem :u64 (+ (fs-word 0) 40)) message) 0)
(define-low dl-symbol-fail (name)
  (let ((slot (+ (fs-word 0) 48)))
    (unless (mem :u64 slot) (setf (mem :u64 slot) (malloc 256)))
    (unless (mem :u64 slot) (result (dl-fail "dlopen: unresolved symbol")))
    (strcpy (mem :u64 slot) "dlopen: unresolved symbol: ")
    (strncpy (+ (mem :u64 slot) 26) name 229)
    (setf (mem :u8 (+ (mem :u64 slot) 255)) 0)
    (dl-fail (mem :u64 slot))))
(define-low dlerror ()
  (let ((message (mem :u64 (+ (fs-word 0) 40))))
    (setf (mem :u64 (+ (fs-word 0) 40)) 0)
    message))
(define-low dl-page (n) (logand n (lognot 4095)))
(define-low dl-up (n) (logand (+ n 4095) (lognot 4095)))
(define-low dl-bound (offset size limit)
  (and (<= offset limit) (<= size (- limit offset))))
(define-low dl-power (n) (and n (not (logand n (- n 1)))))
(define-low dl-read (fd to size offset)
  (let ((done 0))
    (while (< done size)
      (let ((n (pread fd (+ to done) (- size done) (+ offset done))))
        (when (signed<= n 0) (result 0))
        (incf done n)))
    1))
(define-low dl-range (m va size flags)
  (let ((i 0))
    (while (< i (mem :u64 (+ m +dl-phnum+)))
      (let ((h (+ (mem :u64 (+ m +dl-phdr+)) (* i 56))))
        (when (and (= (mem :u32 h) 1)
                   (= (logand (mem :u32 (+ h 4)) flags) flags)
                   (>= va (mem :u64 (+ h 16)))
                   (dl-bound (- va (mem :u64 (+ h 16))) size (mem :u64 (+ h 40))))
          (result 1)))
      (incf i))
    0))
(define-low dl-pointer (m va size flags)
  (if (dl-range m va size flags) (+ (mem :u64 (+ m +dl-base+)) va) 0))
(define-low dl-string (m offset)
  (let ((size (mem :u64 (+ m +dl-strsz+))) (p 0) (i offset))
    (when (>= offset size) (result 0))
    (setf p (mem :u64 (+ m +dl-strtab+)))
    (while (< i size)
      (when (= (mem :u8 (+ p i)) 0) (result (+ p offset)))
      (incf i))
    0))
(define-low dl-tag (m tag)
  (let ((at (mem :u64 (+ m +dl-dynamic+)))
        (end (+ (mem :u64 (+ m +dl-dynamic+)) (mem :u64 (+ m +dl-dynsize+)))))
    (while (< at end)
      (when (= (mem :u64 at) tag) (result (mem :u64 (+ at 8))))
      (when (= (mem :u64 at) 0) (result 0))
      (incf at 16))
    0))

(define-low dl-has-tag (m tag)
  (let ((at (mem :u64 (+ m +dl-dynamic+)))
        (end (+ (mem :u64 (+ m +dl-dynamic+)) (mem :u64 (+ m +dl-dynsize+)))))
    (while (< at end)
      (when (= (mem :u64 at) tag) (result 1))
      (when (= (mem :u64 at) 0) (result 0))
      (incf at 16))
    0))

(define-low dl-map (m fd)
  (let ((header (calloc 1 64)) (size (lseek fd 0 2)) (ph 0) (count 0)
        (last 0) (i 0) (dynamic 0) (dynsize 0) (raw 0) (base 0))
    (unless header (result (dl-fail "dlopen: out of memory")))
    (unless (and (>= size 64) (<= size #x20000000) (dl-read fd header 64 0)
                 (= (mem :u32 header) #x464c457f)
                 (= (mem :u8 (+ header 4)) 2) (= (mem :u8 (+ header 5)) 1)
                 (= (mem :u8 (+ header 6)) 1) (= (mem :u16 (+ header 16)) 3)
                 (= (mem :u16 (+ header 18)) 62) (= (mem :u32 (+ header 20)) 1)
                 (= (mem :u16 (+ header 52)) 64) (= (mem :u16 (+ header 54)) 56)
                 (> (mem :u16 (+ header 56)) 0) (<= (mem :u16 (+ header 56)) 64)
                 (dl-bound (mem :u64 (+ header 32)) (* 56 (mem :u16 (+ header 56))) size))
      (free header) (result (dl-fail "dlopen: expected bounded x86-64 ELF DSO")))
    (setf count (mem :u16 (+ header 56)))
    (setf ph (malloc (* count 56)))
    (unless ph (free header) (result (dl-fail "dlopen: out of memory")))
    (setf (mem :u64 (+ m +dl-phdr+)) ph)
    (setf (mem :u64 (+ m +dl-phnum+)) count)
    (unless (dl-read fd ph (* count 56) (mem :u64 (+ header 32)))
      (free header) (result (dl-fail "dlopen: truncated program headers")))
    (free header)
    (while (< i count)
      (let* ((h (+ ph (* i 56))) (type (mem :u32 h)) (flags (mem :u32 (+ h 4)))
             (off (mem :u64 (+ h 8))) (va (mem :u64 (+ h 16)))
             (filesz (mem :u64 (+ h 32))) (memsz (mem :u64 (+ h 40)))
             (align (mem :u64 (+ h 48))))
        (when (or (= type 3) (and (= type #x6474e551) (logand flags 1)))
          (result (dl-fail "dlopen: interpreter or executable stack unsupported")))
        (when (= type 1)
          (unless (and (<= filesz memsz) (dl-bound off filesz size)
                       (dl-bound va memsz #x40000000)
                       (or (<= align 1) (and (dl-power align) (<= align 65536)
                         (= (logand va (- align 1)) (logand off (- align 1)))))
                       (not (= (logand flags 3) 3)) (logand flags 4)
                       (or (= memsz 0) (>= (dl-page va) last)))
            (result (dl-fail "dlopen: invalid, overlapping or W+X load segment")))
          (when memsz (setf last (dl-up (+ va memsz)))))
        (when (= type 2)
          (when dynamic (result (dl-fail "dlopen: duplicate dynamic segment")))
          (setf dynamic va) (setf dynsize filesz))
        (when (= type #x6474e552)
          (setf (mem :u64 (+ m +dl-relro+)) va)
          (setf (mem :u64 (+ m +dl-relrosz+)) memsz))
        (when (= type 7)
          (when (or (mem :u64 (+ m +dl-tlssize+)) (> memsz #x100000)
                    (> filesz memsz) (not (dl-power align)) (> align 65536))
            (result (dl-fail "dlopen: unsupported TLS segment")))
          (setf (mem :u64 (+ m +dl-tlsimage+)) va)
          (setf (mem :u64 (+ m +dl-tlsfilesz+)) filesz)
          (setf (mem :u64 (+ m +dl-tlssize+)) memsz)
          (setf (mem :u64 (+ m +dl-tlsalign+)) align)))
      (incf i))
    (unless (and last dynamic (>= dynsize 16) (= (rem dynsize 16) 0)
                 (dl-range m dynamic dynsize 4))
      (result (dl-fail "dlopen: missing or invalid dynamic segment")))
    (setf raw (mmap 0 (+ last 65536) 0 #x22 #xffffffff 0))
    (when (= raw (lognot 0)) (result (dl-fail "dlopen: image allocation failed")))
    (setf base (logand (+ raw 65535) (lognot 65535)))
    (when (> base raw) (munmap raw (- base raw)))
    (munmap (+ base last) (- (+ raw last 65536) (+ base last)))
    (setf (mem :u64 (+ m +dl-base+)) base)
    (setf (mem :u64 (+ m +dl-size+)) last)
    (setf i 0)
    (while (< i count)
      (let ((h (+ ph (* i 56))))
        (when (and (= (mem :u32 h) 1) (mem :u64 (+ h 40)))
          (let ((va (mem :u64 (+ h 16))) (n (mem :u64 (+ h 40))))
            (when (or (mprotect (+ base (dl-page va)) (- (dl-up (+ va n)) (dl-page va)) 3)
                      (not (dl-read fd (+ base va) (mem :u64 (+ h 32)) (mem :u64 (+ h 8)))))
              (result (dl-fail "dlopen: segment read failed"))))))
      (incf i))
    (setf (mem :u64 (+ m +dl-dynamic+)) (+ base dynamic))
    (setf (mem :u64 (+ m +dl-dynsize+)) dynsize)
    (let ((n (mem :u64 (+ m +dl-tlsfilesz+))) (va (mem :u64 (+ m +dl-tlsimage+))))
      (when (and n (not (dl-range m va n 4)))
        (result (dl-fail "dlopen: TLS template outside image")))
      (setf (mem :u64 (+ m +dl-tlsimage+)) (+ base va)))
    1))

(define-low dl-tables (m)
  (let ((at (mem :u64 (+ m +dl-dynamic+))) (found 0) (hash 0) (n 0))
    (while (and (not found) (< at (+ (mem :u64 (+ m +dl-dynamic+)) (mem :u64 (+ m +dl-dynsize+)))))
      (when (= (mem :u64 at) 0) (setf found 1))
      (incf at 16))
    (unless found (result (dl-fail "dlopen: unterminated dynamic table")))
    (when (or (dl-has-tag m 16) (logand (dl-tag m 30) 2))
      (result (dl-fail "dlopen: symbolic lookup unsupported")))
    (when (or (dl-has-tag m 17) (dl-has-tag m 22) (dl-has-tag m 35) (dl-has-tag m 36)
              (dl-tag m #x6ffffffe) (dl-tag m #x6ffffffc) (dl-tag m #x6ffffff0)
              (logand (dl-tag m 30) #x14))
      (result (dl-fail "dlopen: foreign/versioned ABI, text relocation or static TLS unsupported")))
    (unless (and (= (dl-tag m 11) 24) (dl-tag m 10)
                 (or (not (dl-tag m 7)) (= (dl-tag m 9) 24))
                 (or (not (dl-tag m 23)) (= (dl-tag m 20) 7)))
      (result (dl-fail "dlopen: unsupported dynamic table layout")))
    (setf (mem :u64 (+ m +dl-strsz+)) (dl-tag m 10))
    (setf (mem :u64 (+ m +dl-strtab+)) (dl-pointer m (dl-tag m 5) (dl-tag m 10) 4))
    (unless (mem :u64 (+ m +dl-strtab+)) (result (dl-fail "dlopen: invalid string table")))
    ;; SysV hash provides the exact symbol count. GNU-only tables are bounded
    ;; by their validated buckets/chains and the containing PT_LOAD.
    (setf hash (dl-tag m 4))
    (if hash
        (progn
          (unless (dl-range m hash 8 4) (result (dl-fail "dlopen: invalid ELF hash")))
          (let ((p (+ (mem :u64 (+ m +dl-base+)) hash)))
            (setf n (mem :u32 (+ p 4)))
            (unless (and (> n 0) (<= n 1048576) (<= (mem :u32 p) 1048576)
                         (dl-range m hash (* 4 (+ 2 n (mem :u32 p))) 4))
              (result (dl-fail "dlopen: invalid ELF hash bounds")))))
        (let* ((va (dl-tag m #x6ffffef5)) (p (dl-pointer m va 16 4)))
          (unless p (result (dl-fail "dlopen: missing symbol hash")))
          (let* ((buckets (mem :u32 p)) (first (mem :u32 (+ p 4)))
                 (bloom (mem :u32 (+ p 8))) (start (+ va 16 (* bloom 8)))
                 (chains (+ start (* buckets 4))) (i 0) (highest 0) (ended 0))
            (unless (and (> buckets 0) (<= buckets 1048576) (> bloom 0)
                         (<= bloom 1048576) (< first 1048576)
                         (dl-range m va (- chains va) 4))
              (result (dl-fail "dlopen: invalid GNU hash bounds")))
            (while (< i buckets)
              (let ((v (mem :u32 (+ (mem :u64 (+ m +dl-base+)) start (* i 4)))))
                (when (and v (< v first)) (result (dl-fail "dlopen: invalid GNU hash bucket")))
                (when (> v highest) (setf highest v)))
              (incf i))
            (setf n first)
            (when highest
              (setf n highest)
              (while (not ended)
                (when (or (>= n 1048576) (not (dl-range m (+ chains (* (- n first) 4)) 4 4)))
                  (result (dl-fail "dlopen: unterminated GNU hash chain")))
                (let ((end (logand (mem :u32 (+ (mem :u64 (+ m +dl-base+)) chains (* (- n first) 4))) 1)))
                  (incf n) (setf ended end)))))))
    (setf (mem :u64 (+ m +dl-nsym+)) n)
    (setf (mem :u64 (+ m +dl-symtab+)) (dl-pointer m (dl-tag m 6) (* n 24) 4))
    (unless (mem :u64 (+ m +dl-symtab+)) (result (dl-fail "dlopen: invalid symbol table")))
    (let ((i 1))
      (while (< i n)
        (let* ((s (+ (mem :u64 (+ m +dl-symtab+)) (* i 24)))
               (section (mem :u16 (+ s 6))) (type (logand (mem :u8 (+ s 4)) 15))
               (value (mem :u64 (+ s 8))) (size (mem :u64 (+ s 16))))
          (unless (dl-string m (mem :u32 s))
            (result (dl-fail "dlopen: invalid symbol name")))
          (when section
            (unless (and (or (= type 0) (= type 1) (= type 2) (= type 6))
                         (or (= section #xfff1)
                             (and (< section #xff00)
                                  (if (= type 6)
                                      (dl-bound value size (mem :u64 (+ m +dl-tlssize+)))
                                      (dl-range m value size (if (= type 2) 1 4))))))
              (result (dl-fail "dlopen: unsupported or out-of-bounds symbol")))))
        (incf i)))
    (setf (mem :u64 (+ m +dl-rela+)) (dl-tag m 7))
    (setf (mem :u64 (+ m +dl-relasz+)) (dl-tag m 8))
    (setf (mem :u64 (+ m +dl-jmprel+)) (dl-tag m 23))
    (setf (mem :u64 (+ m +dl-pltsz+)) (dl-tag m 2))
    (setf (mem :u64 (+ m +dl-init+)) (dl-tag m 12))
    (setf (mem :u64 (+ m +dl-fini+)) (dl-tag m 13))
    (setf (mem :u64 (+ m +dl-initarray+)) (dl-tag m 25))
    (setf (mem :u64 (+ m +dl-initsz+)) (dl-tag m 27))
    (setf (mem :u64 (+ m +dl-finiarray+)) (dl-tag m 26))
    (setf (mem :u64 (+ m +dl-finisz+)) (dl-tag m 28))
    (unless (and (or (not (dl-tag m 12)) (dl-range m (dl-tag m 12) 1 1))
                 (or (not (dl-tag m 13)) (dl-range m (dl-tag m 13) 1 1))
                 (= (rem (dl-tag m 27) 8) 0) (= (rem (dl-tag m 28) 8) 0)
                 (or (not (dl-tag m 27)) (dl-range m (dl-tag m 25) (dl-tag m 27) 4))
                 (or (not (dl-tag m 28)) (dl-range m (dl-tag m 26) (dl-tag m 28) 4)))
      (result (dl-fail "dlopen: invalid constructor/destructor table")))
    ;; This ABI has a deterministic sibling dependency directory.
    (let ((path (if (dl-tag m 29) (dl-tag m 29) (dl-tag m 15))))
      (when path
        (let ((name (dl-string m path)))
          (unless (and name (= (the :u32 (strcmp name "$ORIGIN")) 0))
            (result (dl-fail "dlopen: only $ORIGIN search paths supported"))))))
    1))

(define-low dl-destroy (m)
  (when (mem :u64 (+ m +dl-base+))
    (munmap (mem :u64 (+ m +dl-base+)) (mem :u64 (+ m +dl-size+))))
  (free (mem :u64 (+ m +dl-phdr+)))
  (free (mem :u64 (+ m +dl-path+)))
  (free m))
(define-low dl-dependency (m name)
  (when (= (the :u32 (strcmp name "libdarterfly.so.1")) 0) (result 1))
  (when (or (strchr name 47) (strchr name 36) (= (mem :u8 name) 0))
    (result (dl-fail "dlopen: invalid dependency name")))
  (let* ((parent (mem :u64 (+ m +dl-path+))) (slash (strrchr parent 47))
         (prefix (+ (- slash parent) 1)) (path (malloc (+ prefix (strlen name) 1))) (dep 0))
    (unless path (result (dl-fail "dlopen: out of memory")))
    (memcpy path parent prefix)
    (strcpy (+ path prefix) name)
    (setf dep (dl-load path 0))
    (free path)
    (unless dep (result 0))
    (let ((n (mem :u64 (+ m +dl-ndep+))))
      (when (>= n 64) (result (dl-fail "dlopen: too many dependencies")))
      (setf (mem :u64 (+ m +dl-deps+ (* n 8))) dep)
      (incf (mem :u64 (+ m +dl-ndep+))))
    1))
(define-low dl-load (path resident-only)
  (let ((canonical (realpath path 0)) (i 0) (fd 0) (m 0))
    (unless canonical (result (dl-fail "dlopen: library path unavailable")))
    (while (< i dl-count)
      (let ((old (ref dl-modules i)))
        (when (= (the :u32 (strcmp canonical (mem :u64 (+ old +dl-path+)))) 0)
          (free canonical) (result old)))
      (incf i))
    (when resident-only
      (free canonical) (result (dl-fail "dlopen: library not loaded")))
    (when (= dl-count 64) (free canonical) (result (dl-fail "dlopen: module limit")))
    (setf m (calloc 1 +dl-sizeof+))
    (unless m (free canonical) (result (dl-fail "dlopen: out of memory")))
    (setf (mem :u64 (+ m +dl-path+)) canonical)
    (setf fd (open canonical 0 0))
    (when (signed< fd 0) (dl-destroy m) (result (dl-fail "dlopen: open failed")))
    (let ((ok (and (dl-map m fd) (dl-tables m))))
      (close fd)
      (unless ok (dl-destroy m) (result 0)))
    (setf (mem :u64 (+ m +dl-id+)) (+ dl-count 1))
    (setf (ref dl-modules dl-count) m)
    (incf dl-count)
    (let ((at (mem :u64 (+ m +dl-dynamic+))))
      (while (mem :u64 at)
        (when (= (mem :u64 at) 1)
          (let ((name (dl-string m (mem :u64 (+ at 8)))))
            (unless name (result (dl-fail "dlopen: invalid DT_NEEDED string")))
            (unless (dl-dependency m name) (result 0))))
        (incf at 16)))
    m))

(define-low dl-find-symbol (m name info)
  (let ((i 1))
    (while (< i (mem :u64 (+ m +dl-nsym+)))
      (let* ((s (+ (mem :u64 (+ m +dl-symtab+)) (* i 24)))
             (binding (shr (mem :u8 (+ s 4)) 4)) (type (logand (mem :u8 (+ s 4)) 15))
             (visibility (logand (mem :u8 (+ s 5)) 3)) (label (dl-string m (mem :u32 s))))
        (when (and (or (= binding 1) (= binding 2)) (or (= visibility 0) (= visibility 3))
                   (mem :u16 (+ s 6)) label (= (the :u32 (strcmp label name)) 0))
          (unless (or (= type 0) (= type 1) (= type 2) (= type 6)) (result 0))
          (setf (mem :u64 info) (if (or (= type 6) (= (mem :u16 (+ s 6)) #xfff1)) (mem :u64 (+ s 8))
                                   (+ (mem :u64 (+ m +dl-base+)) (mem :u64 (+ s 8)))))
          (setf (mem :u64 (+ info 8)) m)
          (setf (mem :u64 (+ info 16)) type)
          (result 1)))
      (incf i))
    0))
(define-low dl-scope (root name info)
  (let ((queue (malloc 512)) (read 0) (count 1) (seen 0) (found 0))
    (unless queue (result 0))
    (setf (mem :u64 queue) root)
    (setf seen (shl 1 (- (mem :u64 (+ root +dl-id+)) 1)))
    (while (< read count)
      (let ((m (mem :u64 (+ queue (* read 8)))) (i 0))
        (when (dl-find-symbol m name info) (free queue) (result 1))
        (while (< i (mem :u64 (+ m +dl-ndep+)))
          (let* ((dep (mem :u64 (+ m +dl-deps+ (* i 8))))
                 (bit (shl 1 (- (mem :u64 (+ dep +dl-id+)) 1))))
            (unless (logand seen bit)
              (setf seen (logior seen bit))
              (setf (mem :u64 (+ queue (* count 8))) dep)
              (incf count)))
          (incf i)))
      (incf read))
    (free queue)
    found))
(define-low dl-lookup (root name info)
  (let ((value (__libsa_export name)) (i 0))
    (unless value (setf value (dl-legacy-symbol name)))
    (when value
      (setf (mem :u64 info) value) (setf (mem :u64 (+ info 8)) 0)
      (setf (mem :u64 (+ info 16)) 0) (result 1))
    (while (< i dl-count)
      (let ((m (ref dl-modules i)))
        (when (and (mem :u64 (+ m +dl-global+)) (dl-find-symbol m name info)) (result 1)))
      (incf i))
    (if root (dl-scope root name info) 0)))

(define-low dl-relocate (m root va size)
  (unless size (result 1))
  (unless (and (= (rem size 24) 0) (dl-range m va size 4))
    (result (dl-fail "dlopen: invalid RELA table")))
  (let ((at (+ (mem :u64 (+ m +dl-base+)) va)) (end (+ (mem :u64 (+ m +dl-base+)) va size))
        (info (calloc 1 24)) (ok 1))
    (unless info (result (dl-fail "dlopen: out of memory")))
    (while (< at end)
      (let* ((target (mem :u64 at)) (index (shr (mem :u64 (+ at 8)) 32))
             (type (the :u32 (mem :u64 (+ at 8)))) (addend (mem :u64 (+ at 16)))
             (symbol 0) (name 0) (value 0) (owner 0) (kind 0))
        (when type
          (unless (and (dl-range m target 8 2) (< index (mem :u64 (+ m +dl-nsym+)))
                       (or (= type 1) (= type 6) (= type 7) (= type 8) (= type 16) (= type 17)))
            (dl-fail "dlopen: unsupported relocation or nonwritable target") (free info) (result 0))
          (setf target (+ (mem :u64 (+ m +dl-base+)) target))
          (if (= type 8)
              (progn
                (unless (and (= index 0) (<= addend (mem :u64 (+ m +dl-size+))))
                  (dl-fail "dlopen: invalid RELATIVE relocation") (free info) (result 0))
                (setf (mem :u64 target) (+ (mem :u64 (+ m +dl-base+)) addend)))
              (progn
                (setf symbol (+ (mem :u64 (+ m +dl-symtab+)) (* index 24)))
                (setf name (dl-string m (mem :u32 symbol)))
                (unless name (dl-fail "dlopen: invalid symbol name") (free info) (result 0))
                (cond ((and (= type 16) (= index 0))
                       (setf owner m) (setf kind 6))
                      ((and (mem :u16 (+ symbol 6))
                            (or (= (shr (mem :u8 (+ symbol 4)) 4) 0)
                                (/= (logand (mem :u8 (+ symbol 5)) 3) 0)))
                       (setf kind (logand (mem :u8 (+ symbol 4)) 15))
                       (setf owner m)
                       (setf value (if (or (= kind 6) (= (mem :u16 (+ symbol 6)) #xfff1)) (mem :u64 (+ symbol 8))
                                        (+ (mem :u64 (+ m +dl-base+)) (mem :u64 (+ symbol 8))))))
                      ((dl-lookup root name info)
                       (setf value (mem :u64 info)) (setf owner (mem :u64 (+ info 8)))
                       (setf kind (mem :u64 (+ info 16))))
                      ((/= (shr (mem :u8 (+ symbol 4)) 4) 2)
                       (dl-symbol-fail name) (free info) (result 0)))
                (cond ((or (= type 16) (= type 17))
