(in-package #:darterfly/libsa)

;; errno occupies TCB bytes 16..19; resolver error is independently per-thread.
(define-low __h_errno_location () (+ (fs-word 0) 20))

(define-low resolver-fail (error)
  (setf (mem :u32 (__h_errno_location)) error)
  (- 0 1))

(define-low res_query (name (class :u32) (type :u32) answer (size :u32))
  (when (or (= name 0) (= answer 0) (signed<= (sign-extend :u32 size) 0)
            (= class 0) (> class 65535) (= type 0) (> type 65535))
    (result (resolver-fail 3)))
  (let ((n (call 58 name answer (if (> size 65000) 65000 size)
                 (logior type (shl class 16)))))
    (when (signed< n 0)
      (result (resolver-fail (if (or (= n (- 0 +etimedout+))
                                    (= n (- 0 +eagain+))) 2 3))))
    (when (< size 12) (result n))
    (let ((rcode (logand (mem :u8 (+ answer 3)) 15)))
      (when (/= rcode 0)
        (result (resolver-fail (cond ((= rcode 3) 1) ((= rcode 2) 2) (t 3)))))
      (when (= (logior (mem :u8 (+ answer 6)) (mem :u8 (+ answer 7))) 0)
        (result (resolver-fail 4))))
    (setf (mem :u32 (__h_errno_location)) 0)
    n))

(define-low dn_expand (message end source output (capacity :u32))
  (when (or (< source message) (>= source end) (= capacity 0)
            (signed< (sign-extend :u32 capacity) 0)) (result (- 0 1)))
  (let ((p source) (at 0) (consumed 0) (jumps 0) (wire 1))
    (while 1
      (when (>= p end) (result (- 0 1)))
      (let ((n (mem :u8 p)))
        (incf p)
        (cond
          ((= n 0)
           (setf (mem :u8 (+ output at)) 0)
           (result (if (= consumed 0) (- p source) consumed)))
          ((= (logand n #xc0) #xc0)
           (when (>= p end) (result (- 0 1)))
           (when (= consumed 0) (setf consumed (- (+ p 1) source)))
           (setf p (+ message (logior (shl (logand n #x3f) 8) (mem :u8 p))))
           (incf jumps)
           (when (or (>= p end) (> jumps (- end message))) (result (- 0 1))))
          (t
           (when (or (> n 63) (> (+ p n) end)) (result (- 0 1)))
           (incf wire (+ n 1))
           (when (> wire 255) (result (- 0 1)))
           (when (/= at 0)
             (when (>= (+ at 1) capacity) (result (- 0 1)))
             (setf (mem :u8 (+ output at)) 46) (incf at))
           (let ((i 0))
             (while (< i n)
               (let ((ch (mem :u8 (+ p i))))
                 (cond ((or (= ch 46) (= ch 92))
                        (when (>= (+ at 2) capacity) (result (- 0 1)))
                        (setf (mem :u8 (+ output at)) 92) (incf at)
                        (setf (mem :u8 (+ output at)) ch) (incf at))
                       ((or (< ch 33) (> ch 126))
                        (when (>= (+ at 4) capacity) (result (- 0 1)))
                        (setf (mem :u8 (+ output at)) 92)
                        (setf (mem :u8 (+ output at 1)) (+ 48 (truncate ch 100)))
                        (setf (mem :u8 (+ output at 2)) (+ 48 (rem (truncate ch 10) 10)))
                        (setf (mem :u8 (+ output at 3)) (+ 48 (rem ch 10)))
                        (incf at 4))
                       (t
                        (when (>= (+ at 1) capacity) (result (- 0 1)))
                        (setf (mem :u8 (+ output at)) ch) (incf at))))
               (incf i)))
           (incf p n)))))))
