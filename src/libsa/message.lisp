(in-package #:darterfly/libsa)

;; Flatten msghdr/iovec/cmsghdr into a bounded pointer-free service request.
;; Header: byte count, rights count, output flags; rights[253]; payload at 1040.
;; The same request is used in the supervisor and in isolated native/Lisp worlds.
(defconstant +msg-data+ 1040)
(defconstant +msg-limit+ 32768)
(defconstant +msg-rights+ 253)

(define-low message-call ((fd :u32) msg (flags :u32) receive)
  (unless msg (result (fail-with 14)))
  (let* ((iov (mem :u64 (+ msg 16))) (iovlen (mem :u64 (+ msg 24)))
         (control (mem :u64 (+ msg 32))) (clen (mem :u64 (+ msg 40)))
         (n 0) (i 0) (count 0) (at 0) (packed 0) (r 0))
    (when (or (> iovlen 1024) (and iovlen (= iov 0)) (and clen (= control 0)))
      (result (fail-with 22)))
    (when (mem :u32 (+ msg 8)) (result (fail-with 95)))
    (when (and (= receive 0) (> clen 4096)) (result (fail-with 22)))
    (while (< i iovlen)
      (let ((len (mem :u64 (+ iov (* i 16) 8))))
        (when (and len (= (mem :u64 (+ iov (* i 16))) 0)) (result (fail-with 14)))
        (if (> len (- +msg-limit+ n))
            (if receive (setf n +msg-limit+) (result (fail-with 90)))
            (incf n len)))
      (incf i))
    (setf packed (calloc 1 (+ +msg-data+ n)))
    (unless packed (result (fail-with +enomem+)))
    (setf (mem :u64 packed) n)
    (if receive
        (setf count (if (>= clen 16) (capped (truncate (- clen 16) 4) +msg-rights+) 0))
        (progn
          (while (< at clen)
            (when (< (- clen at) 16) (free packed) (result (fail-with 22)))
            (let ((size (mem :u64 (+ control at))))
              (when (or (< size 16) (> size (- clen at))
                        (/= (mem :u32 (+ control at 8)) 1)
                        (/= (mem :u32 (+ control at 12)) 1)
                        (logand (- size 16) 3)
                        (> (truncate (- size 16) 4) (- +msg-rights+ count)))
                (free packed) (result (fail-with 22)))
              (memcpy (+ packed 24 (* count 4)) (+ control at 16) (- size 16))
              (incf count (truncate (- size 16) 4))
              (incf at (logand (+ size 7) (lognot 7)))))))
    (setf (mem :u64 (+ packed 8)) count)
    (setf i 0) (setf at 0)
    (unless receive
      (while (< i iovlen)
        (let ((len (mem :u64 (+ iov (* i 16) 8))))
          (memcpy (+ packed +msg-data+ at) (mem :u64 (+ iov (* i 16))) len)
          (incf at len))
        (incf i)))
    (setf r (ret (call (if receive 55 54) fd packed (+ +msg-data+ n) flags)))
    (when (and receive (signed>= r 0))
      (let ((bytes (mem :u64 packed)) (rights (mem :u64 (+ packed 8)))
            (used 0))
        ;; The supervisor's reply is checked before touching caller buffers.
        (when (or (> bytes n) (> rights count))
          (free packed) (result (fail-with 5)))
        (setf i 0) (setf at 0)
        (while (and (< i iovlen) (< at bytes))
          (let ((len (capped (mem :u64 (+ iov (* i 16) 8)) (- bytes at))))
            (memcpy (mem :u64 (+ iov (* i 16))) (+ packed +msg-data+ at) len)
            (incf at len))
          (incf i))
        (when rights
          (setf used (+ 16 (* rights 4)))
          (memset control 0 (capped (logand (+ used 7) (lognot 7)) clen))
          (setf (mem :u64 control) used)
          (setf (mem :u32 (+ control 8)) 1)
          (setf (mem :u32 (+ control 12)) 1)
          (memcpy (+ control 16) (+ packed 24) (* rights 4))
          (setf used (capped (logand (+ used 7) (lognot 7)) clen)))
        (setf (mem :u64 (+ msg 40)) used)
        (setf (mem :u32 (+ msg 48)) (mem :u32 (+ packed 16)))
        (setf (mem :u32 (+ msg 8)) 0)))
    (free packed)
    r))

(define-low sendmsg ((fd :u32) msg (flags :u32)) (message-call fd msg flags 0))
(define-low recvmsg ((fd :u32) msg (flags :u32)) (message-call fd msg flags 1))
