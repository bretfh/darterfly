                                (when (and (/= end tmp) (not suppress))
                                  (if (= len 8) (setf (mem :u64 dst) value)
                                      (setf (mem :u32 dst) value))))))
                         (t
                          (when (= c 105) (setf base 0))
                          (when (= c 111) (setf base 8))
                          (when (or (= c 120) (= c 88)) (setf base 16))
                          (setf value (if (or (= c 100) (= c 105))
                                          (strtoll tmp (address end) base)
                                          (strtoull tmp (address end) base)))
                          (when (and (/= end tmp) (not suppress))
                            (cond ((= len 8) (setf (mem :u64 dst) value))
                                  ((= len 2) (setf (mem :u16 dst) value))
                                  ((= len 1) (setf (mem :u8 dst) value))
                                  (t (setf (mem :u32 dst) value))))))
                       (setf n (- end tmp)) (free tmp)
                       (when (= n 0) (result assigned))
                       (incf s n))
                      (t (result assigned)))
                    (incf matched)
                    (unless suppress (incf assigned)))))))))
    assigned))
(define-low sscanf (s fmt &va ap) (vsscanf s fmt ap))
