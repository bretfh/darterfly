(in-package #:darterfly/libsa)

(defconstant +eof+ #xFFFFFFFF)
(defconstant +double-max+ #x7FEFFFFFFFFFFFFF)
(defconstant +ten+ #x4024000000000000)
(defconstant +1e16+ #x4341C37937E08000)
(defconstant +1e18+ #x43ABC16D674EC800)

(define-global files :u8 :count 48)
(define-global stdin :u64 :export t)
(define-global stdout :u64 :export t)
(define-global stderr :u64 :export t)

(define-low reset-file (fp (fd :u32))
  (setf (mem :u32 fp) fd)
  (setf (mem :u32 (+ fp 4)) 0)
  (setf (mem :u32 (+ fp 8)) 0)
  (setf (mem :u32 (+ fp 12)) #xFFFFFFFF))

(define-low stdio-init ()
  (reset-file (address files) 0)
  (reset-file (+ (address files) 16) 1)
  (reset-file (+ (address files) 32) 2)
  (setf stdin (address files))
  (setf stdout (+ (address files) 16))
  (setf stderr (+ (address files) 32)))

(define-low sink-fd (s) (sign-extend :u32 (mem :u32 (+ s 24))))

(define-low emit (s (c :u8))
  (cond ((signed>= (sink-fd s) 0) (write (sink-fd s) (address c) 1))
        ((< (+ (mem :u64 (+ s 16)) 1) (mem :u64 (+ s 8))) (setf (mem :u8 (+ (mem :u64 s) (mem :u64 (+ s 16)))) c)))
  (setf (mem :u64 (+ s 16)) (+ (mem :u64 (+ s 16)) 1)))

(define-low emit-n (s p n)
  (if (signed>= (sink-fd s) 0)
      (progn (write (sink-fd s) p n)
             (setf (mem :u64 (+ s 16)) (+ (mem :u64 (+ s 16)) n)))
      (while (> n 0)
        (emit s (mem :u8 p))
        (incf p) (decf n))))

(define-low pad (s (c :u8) n)
  (while (signed> n 0)
    (emit s c)
    (decf n)))

(define-low format-unsigned (out v base upper)
  (let ((digits (if upper "0123456789ABCDEF" "0123456789abcdef")) (n 0) (i 0))
    (while (progn (setf (mem :u8 (+ out n)) (mem :u8 (+ digits (rem v base))))
                  (incf n)
                  (setf v (truncate v base))
                  v))
    (while (< i (truncate n 2))
      (let ((x (mem :u8 (+ out i))))
        (setf (mem :u8 (+ out i)) (mem :u8 (+ out (- n 1 i))))
        (setf (mem :u8 (+ out (- n 1 i))) x))
      (incf i))
    n))

(define-low format-double-masked (out v precision (conv :u8))
  (let ((n 0) (exponent 0) (general (= conv 103)))
    (when (nan-p v) (strcpy out "nan") (result 3))
    (when (logand v +sign+)
      (setf (mem :u8 out) 45)
      (incf n)
      (setf v (negate v)))
    (when (f> v +double-max+) (strcpy (+ out n) "inf") (result (+ n 3)))
    (when (signed< precision 0) (setf precision 6))
    (when (signed> precision 17) (setf precision 17))
    (when (or (= conv 101) (= conv 103))
      (unless (f= v +zero+)
        (while (f>= v +ten+) (setf v (f/ v +ten+)) (incf exponent))
        (while (f< v +one+) (setf v (f* v +ten+)) (decf exponent)))
      (if (and (= conv 103) (signed>= exponent (- 0 4)) (signed< exponent (if precision precision 1)))
          (progn
            (let ((e exponent))
              (while (signed> e 0) (setf v (f* v +ten+)) (decf e))
              (while (signed< e 0) (setf v (f/ v +ten+)) (incf e)))
            (setf conv 102))
          (setf conv 101)))
    (when general
      ;; %g precision counts significant digits, not digits after the dot.
      (setf precision (if (= conv 101) (- (if precision precision 1) 1)
                          (- (if precision precision 1) exponent 1)))
      (when (signed< precision 0) (setf precision 0)))
    (when (and (= conv 102) (f>= v +1e18+))
      (let ((e 0) (m v) (digits (malloc 32)) (k 0) (i 0))
        (while (f>= m +ten+) (setf m (f/ m +ten+)) (incf e))
        (setf k (format-unsigned digits (float-truncate (f+ (f* m +1e16+) +half+)) 10 0))
        (memcpy (+ out n) digits k)
        (free digits)
        (setf n (+ n k))
        (setf i (- k 1))
        (while (signed< i e) (setf (mem :u8 (+ out n)) 48) (incf n) (incf i))
        (when precision
          (setf (mem :u8 (+ out n)) 46)
          (incf n)
          (setf i 0)
          (while (signed< i precision) (setf (mem :u8 (+ out n)) 48) (incf n) (incf i)))
        (result n)))
    (let ((scale +one+) (i 0) (rounded 0) (whole 0) (frac 0))
      (while (signed< i precision) (setf scale (f* scale +ten+)) (incf i))
      (setf rounded (f+ (f* v scale) +half+))
      (setf whole (float-truncate (f/ rounded scale)))
      (setf frac (float-truncate (f- rounded (f* (float-of whole) scale))))
      (when (and (= conv 101) (>= whole 10))
        (setf whole (truncate whole 10))
        (incf exponent))
      (setf n (+ n (format-unsigned (+ out n) whole 10 0)))
      (when precision
        (let ((digits (malloc 32)) (k 0) (j 0))
          (setf (mem :u8 (+ out n)) 46)
          (incf n)
          (setf k (format-unsigned digits frac 10 0))
          (setf j k)
          (while (signed< j precision) (setf (mem :u8 (+ out n)) 48) (incf n) (incf j))
          (memcpy (+ out n) digits k)
          (setf n (+ n k))
          (free digits))))
    (when (= conv 101)
      (setf (mem :u8 (+ out n)) 101)
      (incf n)
      (setf (mem :u8 (+ out n)) (if (signed< exponent 0) 45 43))
      (incf n)
      (when (signed< exponent 0) (setf exponent (- 0 exponent)))
      (when (< exponent 10) (setf (mem :u8 (+ out n)) 48) (incf n))
      (setf n (+ n (format-unsigned (+ out n) exponent 10 0))))
    n))

(define-low format-double (out v precision conv)
  (let ((csr (mxcsr)) (n 0))
    (set-mxcsr (logior csr #x1f80))
    (setf n (format-double-masked out v precision conv))
    (set-mxcsr csr)
    n))

(define-low vformat (s f ap)
  (let ((buf (malloc 128)))
    (while (mem :u8 f)
      (if (/= (mem :u8 f) 37)
          (emit s (mem :u8 f))
          (let ((left 0) (plus 0) (space 0) (alt 0) (zero 0) (width 0) (precision (- 0 1)) (len 0)
                (body buf) (n 0) (sign 0) (prefix "") (going 1) (skip 0) (c 0))
            (incf f)
            (while going
              (setf c (mem :u8 f))
              (cond ((= c 45) (setf left 1))
                    ((= c 43) (setf plus 1))
                    ((= c 32) (setf space 1))
                    ((= c 35) (setf alt 1))
                    ((= c 48) (setf zero 1))
                    (t (setf going 0)))
              (when going (incf f)))
            (if (= (mem :u8 f) 42)
                (progn (setf width (sign-extend :u32 (va-next ap))) (incf f))
                (while (isdigit (mem :u8 f))
                  (setf width (+ (* width 10) (- (mem :u8 f) 48)))
                  (incf f)))
            (when (signed< width 0) (setf left 1) (setf width (- 0 width)))
            (when (= (mem :u8 f) 46)
              (incf f)
              (setf precision 0)
              (if (= (mem :u8 f) 42)
                  (progn (setf precision (sign-extend :u32 (va-next ap))) (incf f))
                  (while (isdigit (mem :u8 f))
                    (setf precision (+ (* precision 10) (- (mem :u8 f) 48)))
                    (incf f))))
            (setf going 1)
            (while going
              (setf c (mem :u8 f))
              (cond ((= c 104) (setf len (if (= len (- 0 1)) (- 0 2) (- 0 1))))
                    ((= c 108) (incf len))
                    ((or (= c 122) (= c 106) (= c 116)) (setf len 2))
                    ((= c 76) (setf len 3))
                    (t (setf going 0)))
              (when going (incf f)))
            (setf c (mem :u8 f))
            (cond ((or (= c 100) (= c 105))
                   (let ((v (if (signed>= len 1) (va-next ap) (sign-extend :u32 (va-next ap)))) (u 0))
                     (when (= len (- 0 1)) (setf v (sign-extend :u16 v)))
                     (when (= len (- 0 2)) (setf v (sign-extend :u8 v)))
                     (setf u (if (signed< v 0) (- 0 v) v))
                     (setf sign (cond ((signed< v 0) 45) (plus 43) (space 32) (t 0)))
                     (setf n (if (and (= precision 0) (= u 0)) 0 (format-unsigned buf u 10 0)))))
                  ((or (= c 117) (= c 120) (= c 88) (= c 111))
                   (let ((u (if (signed>= len 1) (va-next ap) (the :u32 (va-next ap))))
                         (base (cond ((= c 111) 8) ((= c 117) 10) (t 16))))
                     (when (= len (- 0 1)) (setf u (the :u16 u)))
                     (when (= len (- 0 2)) (setf u (the :u8 u)))
                     (setf n (if (and (= precision 0) (= u 0)) 0 (format-unsigned buf u base (= c 88))))
                     (when (and alt u (= base 16)) (setf prefix (if (= c 88) "0X" "0x")))
                     (when (and alt (= base 8)) (setf prefix "0"))))
                  ((= c 112)
                   (setf n (format-unsigned buf (va-next ap) 16 0))
                   (setf prefix "0x"))
                  ((= c 99)
                   (setf (mem :u8 buf) (va-next ap))
                   (setf n 1)
                   (setf precision (- 0 1)))
                  ((= c 115)
                   (setf body (va-next ap))
                   (unless body (setf body "(null)"))
                   (setf n (if (signed>= precision 0) (strnlen body precision) (strlen body)))
                   (setf precision (- 0 1)))
                  ((or (= c 102) (= c 70) (= c 101) (= c 69) (= c 103) (= c 71))
                   (let ((v (if (= len 3) (long-double-arg ap) (va-next-double ap))))
                     (setf n (format-double buf v precision (logior c 32)))
                     (when (and (= (logior c 32) 103) (not alt))
                       (let ((end n) (dot 0) (at 0))
                         (while (< at n)
                           (when (= (mem :u8 (+ buf at)) 46) (setf dot (+ at 1)))
                           (when (= (mem :u8 (+ buf at)) 101) (setf end at) (setf at n))
                           (incf at))
                         (when dot
                           (setf at end)
                           (while (and (>= at dot) (= (mem :u8 (+ buf (- at 1))) 48)) (decf at))
                           (when (= at dot) (decf at))
                           (memmove (+ buf at) (+ buf end) (- n end))
                           (decf n (- end at)))))
                     (if (= (mem :u8 buf) 45)
                         (progn (setf sign 45) (setf body (+ buf 1)) (decf n))
                         (when (or plus space) (setf sign (if plus 43 32))))
                     (setf precision (- 0 1))))
                  ((= c 110)
                   (setf (mem :u32 (va-next ap)) (mem :u64 (+ s 16)))
                   (setf skip 1))
                  ((= c 37) (emit s 37) (setf skip 1))
                  (t (emit s 37) (emit s c) (setf skip 1)))
            (unless skip
              (let* ((zeros (if (signed> precision n) (- precision n) 0))
                     (total (+ n zeros (if sign 1 0) (strlen prefix))))
                (unless (or left (and zero (signed< precision 0))) (pad s 32 (- width total)))
                (when sign (emit s sign))
                (emit-n s prefix (strlen prefix))
                (when (and (not left) zero (signed< precision 0)) (pad s 48 (- width total)))
                (pad s 48 zeros)
                (emit-n s body n)
                (when left (pad s 32 (- width total)))))))
      (incf f))
    (free buf)
    (the :u32 (mem :u64 (+ s 16)))))

(define-low long-double-arg (ap)
  (let ((p (logand (+ (mem :u64 (+ ap 8)) 15) (lognot 15))))
    (setf (mem :u64 (+ ap 8)) (+ p 16))
    (long_double_bits p)))

(defun long-double-bits-routine ()
  (darterfly/asm:routine "long_double_bits"
    (dolist (b '(#x48 #x83 #xEC #x08 #xDB #x2F #xDD #x1C #x24 #x48 #x8B #x04 #x24 #x48 #x83 #xC4 #x08 #xC3))
      (darterfly/asm:inst byte b))))

(define-low make-sink (buf cap (fd :u32))
  (let ((s (malloc 32)))
    (setf (mem :u64 s) buf)
    (setf (mem :u64 (+ s 8)) cap)
    (setf (mem :u64 (+ s 16)) 0)
    (setf (mem :u32 (+ s 24)) fd)
    s))

(define-low vsnprintf (buf cap f ap)
  (let ((s (make-sink buf cap #xFFFFFFFF)) (len 0))
    (vformat s f ap)
    (setf len (mem :u64 (+ s 16)))
    (free s)
    (when cap (setf (mem :u8 (+ buf (if (< len cap) len (- cap 1)))) 0))
    (the :u32 len)))

(define-low vsprintf (buf f ap) (vsnprintf buf (shr (lognot 0) 1) f ap))

(define-low snprintf (buf cap f &va ap) (declare (floats)) (vsnprintf buf cap f ap))
(define-low sprintf (buf f &va ap) (declare (floats)) (vsprintf buf f ap))

(define-low vdprintf ((fd :u32) f ap)
  (let ((buf (malloc 1024)) (copy (malloc 24)) (n 0))
    (memcpy copy ap 24)
    (setf n (sign-extend :u32 (vsnprintf buf 1024 f ap)))
    (if (signed< n 1024)
        (setf n (write fd buf n))
        (let ((s (make-sink 0 0 fd)))
          (setf n (vformat s f copy))
          (free s)))
    (free buf)
    (free copy)
    (the :u32 n)))

(define-low dprintf ((fd :u32) f &va ap) (declare (floats)) (vdprintf fd f ap))
(define-low vfprintf (fp f ap) (vdprintf (mem :u32 fp) f ap))
(define-low fprintf (fp f &va ap) (declare (floats)) (vfprintf fp f ap))
(define-low vprintf (f ap) (vfprintf stdout f ap))
(define-low printf (f &va ap) (declare (floats)) (vfprintf stdout f ap))

(define-low fputs (str fp)
  (if (signed< (write (mem :u32 fp) str (strlen str)) 0) +eof+ 0))

(define-low fputc ((c :u8) fp)
  (if (= (write (mem :u32 fp) (address c) 1) 1) c +eof+))

(define-low puts (str)
  (when (= (the :u32 (fputs str stdout)) +eof+) (result +eof+))
  (fputc 10 stdout))

(define-low putc ((c :u32) fp) (fputc c fp))
(define-low putchar ((c :u32)) (fputc c stdout))

(define-low fgetc (fp)
  (let ((b 0) (n 0))
    (when (/= (mem :u32 (+ fp 12)) #xFFFFFFFF)
      (setf b (mem :u32 (+ fp 12)))
      (setf (mem :u32 (+ fp 12)) #xFFFFFFFF)
      (result b))
    (setf n (read (mem :u32 fp) (address b) 1))
    (when (signed<= n 0)
      (if (= n 0) (setf (mem :u32 (+ fp 4)) 1) (setf (mem :u32 (+ fp 8)) 1))
      (result +eof+))
    (the :u8 b)))

(define-low getc (fp) (fgetc fp))
(define-low getchar () (fgetc stdin))

(define-low ungetc ((c :u32) fp)
  (when (= c +eof+) (result +eof+))
  (setf (mem :u32 (+ fp 12)) (the :u8 c))
  (setf (mem :u32 (+ fp 4)) 0)
  c)

(define-low fgets (buf (n :u32) fp)
  (let ((i 0) (c 0) (going 1))
    (while (and going (signed< i (- (sign-extend :u32 n) 1)))
      (setf c (the :u32 (fgetc fp)))
      (if (= c +eof+)
          (setf going 0)
          (progn (setf (mem :u8 (+ buf i)) c)
                 (incf i)
                 (when (= c 10) (setf going 0)))))
    (when (= i 0) (result 0))
    (setf (mem :u8 (+ buf i)) 0)
    buf))

(define-low fread (buf size count fp)
  (let ((want (* size count)) (got 0) (n 0) (going 1))
    (while (and going (< got want))
      (setf n (read (mem :u32 fp) (+ buf got) (- want got)))
      (if (signed<= n 0)
          (progn (if (= n 0) (setf (mem :u32 (+ fp 4)) 1) (setf (mem :u32 (+ fp 8)) 1))
                 (setf going 0))
          (setf got (+ got n))))
    (if size (truncate got size) 0)))

(define-low fwrite (buf size count fp)
  (when (or (= size 0) (= count 0)) (result 0))
  (let ((want (* size count)) (got 0) (n 0))
    (when (/= (truncate want count) size)
      (setf (mem :u32 (+ fp 8)) 1)
      (setf (mem :u32 (__errno_location)) +einval+)
      (result 0))
    ;; Native-world writes can stop at the port transfer limit. stdio must
    ;; consume successful short writes before reporting completed elements.
    (while (< got want)
      (setf n (write (mem :u32 fp) (+ buf got) (- want got)))
      (when (signed<= n 0)
        (setf (mem :u32 (+ fp 8)) 1)
        (when (= n 0) (setf (mem :u32 (__errno_location)) +eio+))
        (result (truncate got size)))
      (incf got n))
    count))

(define-low fflush (fp) 0)

(define-low mode-flags (mode)
  (let ((flags (if (= (mem :u8 mode) 114) 0 (logior 1 +o-creat+ (if (= (mem :u8 mode) 97) #o2000 #o1000)))))
    (when (strchr mode 43) (setf flags (logior (logand flags (lognot 3)) 2)))
    flags))

(define-low fdopen ((fd :u32) mode)
  (let ((fp (malloc 16)))
    (when (= fp 0) (result 0))
    (reset-file fp fd)
    fp))

(define-low fopen (path mode)
  (let ((fd (sign-extend :u32 (open path (mode-flags mode) #o666))))
    (if (signed< fd 0) 0 (fdopen fd mode))))

(define-low freopen (path mode fp)
  (let ((fd (sign-extend :u32 (open path (mode-flags mode) #o666))))
    (when (signed< fd 0) (result 0))
    (when (signed> (sign-extend :u32 (mem :u32 fp)) 2) (close (mem :u32 fp)))
    (reset-file fp fd)
    fp))

(define-low __libsa_redirect_stdout (path)
  (when (signed> (sign-extend :u32 (mem :u32 stdout)) 2) (close (mem :u32 stdout)))
  (reset-file stdout 1)
  (unless path (result 0))
  (let ((fd (sign-extend :u32 (open path (logior 1 +o-creat+ #o1000) #o666))))
    (when (signed< fd 0) (result (- 0 1)))
    (setf (mem :u32 stdout) fd)
    0))

(define-low tmpfile () (fail-with +enosys+) 0)

(define-low fclose (fp)
  (let ((r (close (mem :u32 fp))))
    (unless (or (= fp stdin) (= fp stdout) (= fp stderr)) (free fp))
    r))

(define-low fseeko (fp off (whence :u32))
  (setf (mem :u32 (+ fp 12)) #xFFFFFFFF)
  (setf (mem :u32 (+ fp 4)) 0)
  (if (signed< (lseek (mem :u32 fp) off whence) 0) (- 0 1) 0))

(define-low fseek (fp off (whence :u32)) (fseeko fp off whence))
(define-low ftello (fp) (lseek (mem :u32 fp) 0 1))
(define-low ftell (fp) (ftello fp))
(define-low rewind (fp) (fseek fp 0 0) (setf (mem :u32 (+ fp 8)) 0) 0)
(define-low feof (fp) (mem :u32 (+ fp 4)))
(define-low ferror (fp) (mem :u32 (+ fp 8)))
(define-low clearerr (fp) (setf (mem :u32 (+ fp 4)) 0) (setf (mem :u32 (+ fp 8)) 0) 0)
(define-low fileno (fp) (mem :u32 fp))
(define-low setvbuf (fp buf mode size) 0)
(define-low setbuf (fp buf) 0)

(define-low perror (s)
  (if (and s (mem :u8 s))
      (fprintf stderr "%s: %s
" s (strerror (mem :u32 (__errno_location))))
      (fprintf stderr "%s
" (strerror (mem :u32 (__errno_location)))))
  0)

(define-low vasprintf (out fmt ap)
  (let ((copy (malloc 24)) (n 0) (p 0))
    (unless copy (result (- 0 1)))
    (setf (mem :u64 out) 0)
    (memcpy copy ap 24)
    (setf n (sign-extend :u32 (vsnprintf 0 0 fmt copy)))
    (free copy)
    (when (signed< n 0) (result (- 0 1)))
    (setf p (malloc (+ n 1)))
    (unless p (result (- 0 1)))
    (vsnprintf p (+ n 1) fmt ap)
    (setf (mem :u64 out) p) n))

