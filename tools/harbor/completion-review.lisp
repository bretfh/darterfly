;; Native adverse-input fixture. No disk writes or generation changes.
(in-package #:darterfly/kit)
(defvar *completion-review* nil)
(defvar *completion-review-actions* 0)
(defvar *completion-review-ready* 0)
(defvar *completion-review-lock* (sb-thread:make-mutex :name "review records"))
(defun completion-review-state ()
  (list :count (length *completion-review*) :actions *completion-review-actions*
        :windows (loop for (name window entry) in *completion-review*
                       collect (list name (window-id window) (string-value entry)
                                     (entry-caret entry) (entry-anchor entry)))
        :server-windows (length (all-window-descriptions))
        :errors darterfly/bsd:*background-errors*))
(defun completion-review-note (kind)
  (with-open-file (s "/dev/console" :direction :output :if-exists :append)
    (format s "~&HARBOR-COMPLETION ~s ~s~%" kind (completion-review-state))))
(defun completion-review-stress (window)
  (let* ((entry (find-if (lambda (v) (typep v 'entry-field)) (subviews (content-view window))))
         (before (list (string-value entry) (entry-caret entry) (entry-anchor entry) (first-responder window)))
         (handle (getf (find (window-id window) (all-window-descriptions) :key (lambda (w) (second (getf w :handle)))) :handle)))
    (bsd:bsdthread-create
     (lambda ()
       (darterfly/stats:series :frame-ms :clear t)
       (dotimes (i 100)
         (layer:transaction-commit (list (list :minimize (window-id window) (>= i 50))))
         (sleep (if (< i 50) .045 .01))
         (assert (layer:window-restore handle :reduced-motion (>= i 50)))
         (sleep (if (< i 50) .06 .01)))
       (sleep .4)
       (assert (equal before (list (string-value entry) (entry-caret entry) (entry-anchor entry) (first-responder window))))
       (let ((times (sort (darterfly/stats:series :frame-ms) #'<)))
         (with-open-file (out "/dev/console" :direction :output :if-exists :append)
           (format out "~&HARBOR-STRESS :PASS :CYCLES 100 :SAMPLES ~d :P50 ~s :P95 ~s :MAX ~s :ERRORS ~s~%"
                   (length times) (nth (floor (length times) 2) times) (nth (floor (* .95 (length times))) times)
                   (car (last times)) darterfly/bsd:*background-errors*)))) "completion stress")))
(defun register-completion-review-commands ()
  (register-command :stress "Stress minimize and restore" #'completion-review-stress)
  (register-command :rename-later "Rename during window selection"
    (lambda (window)
      (read-window)
      (bsd:bsdthread-create
       (lambda () (sleep 1.5) (perform-on-main (lambda () (set-window-title window "Renamed during selection")))) "review rename")))
  (register-command :close-later "Close during window selection"
    (lambda (window)
      (read-window)
      (bsd:bsdthread-create
       (lambda () (sleep 1.5) (perform-on-main (lambda () (close-window window)))) "review close")))
  (register-command :slow "Slow completion review"
    (lambda (w) (declare (ignore w))
      (read-choice :prompt "Slow source review" :refresh t
        :source (lambda (query cancelled) (declare (ignore cancelled)) (sleep .8)
                  (list (make-choice :id :one :label (concatenate 'string "Result " query)))))))
  (register-command :failure "Fail then retry review"
    (lambda (w) (declare (ignore w))
      (let ((fail t))
        (read-choice :prompt "Source recovery review"
          :source (lambda (query cancelled) (declare (ignore query cancelled))
                    (if (shiftf fail nil) (error "Review source unavailable")
                        (list (make-choice :id :recovered :label "Recovered choice")))))))))
(defun start-completion-review (&optional (count 8))
  (setf *completion-review* nil *completion-review-actions* 0 *completion-review-ready* 0)
  (loop for app in '("Editor" "Files" "Terminal" "Listener" "Generations")
        for group from 0 do
    (let ((app app) (group group))
      (bsd:fork
       (lambda ()
         (let ((bindings (bsd::fresh-bindings)))
           (setf (bsd::proc-bindings bsd:*proc*) bindings)
           (bsd::call-with-bindings bindings (lambda ()
           (setf *menus* (standard-menus app))
           (setf (bsd::proc-comm bsd:*proc*) app)
           (register-completion-review-commands)
           (register-command :review-tick "Record a review action"
                             (lambda (window) (declare (ignore window)) (incf *completion-review-actions*) (completion-review-note :action)))
           (register-command :review-unavailable "Unavailable review command" (lambda (w) (declare (ignore w)) (error "Disabled command ran"))
                             :enabled (constantly nil))
           (dotimes (i count)
             (let* ((name (if (< i 2) "Notes.txt" (format nil "~a review ~d" app i)))
                    (path (format nil "/Users/darterfly/~a/Session ~d" (if (evenp i) "Projects" "Walks") (+ (* group count) i)))
                    (window (make-window :title name :location path :x (+ 80 (* group 90) (* i 12))
                                         :y (+ 64 (* group 38) (* i 8)) :width 550 :height 330))
                    (entry (make-instance 'entry-field :string (format nil "Unsaved ~a notes ~d — keep my place." app i)
                                          :frame #(24 82 460 30))))
               (add-subview (content-view window) (make-instance 'text-field :string app :font-size 18 :frame #(24 16 450 28)))
               (add-subview (content-view window) (make-instance 'text-field :string path :font-size 11 :frame #(24 48 480 22)))
               (add-subview (content-view window) entry)
               (add-subview (content-view window) (make-instance 'button :title "Choose a window…" :frame #(24 140 160 28)
                                       :action (lambda (sender) (declare (ignore sender)) (read-window))))
               (add-subview (content-view window) (make-instance 'button :title "Commands…" :frame #(200 140 120 28)
                                       :action (lambda (sender) (declare (ignore sender)) (read-command))))
               (show window) (set-key-focus window entry t)
               (sb-thread:with-mutex (*completion-review-lock*) (push (list app window entry) *completion-review*))
               (minimize-window window)))
           (sb-thread:with-mutex (*completion-review-lock*)
             (when (= 5 (incf *completion-review-ready*)) (completion-review-note :ready)))
           (run))))))))
  t)
(start-completion-review)
