        (flet ((ask (form) (image:send c form) (image:expect c (format nil "~%* ") :timeout 120)))
          (unwind-protect
               (progn
                 (is (image:expect c "boot.efi: generation gen-2" :timeout 60))
                 (is (image:expect c "init: pid 1" :timeout 120))
                 (sleep 10)
                 (is (search "=> 3" (nrepl-client port "world" "(+ 1 2)")) "a cold boot of the saved world serves nrepl")
                 (is (funcall #'beating #'ask) "and runs the thread"))
            (image:finish c 5)))))))

