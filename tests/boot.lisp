                 (screen-until (lambda (s) (= #xffffffff (image:pixel s 500 300))))
                 (image:send-keys (format nil "(progn (darterfly/nrepl:start :key \"world\") (sb-thread:make-thread (lambda () (loop (setf cl-user::*beat* (get-universal-time)) (sleep 1))) :name \"beat\") :started)~%"))
                 (is (search ":STARTED" (listener-text-until c ":STARTED")))
                 (is (search "=> 3" (nrepl-client port "world" "(+ 1 2)")) "nrepl started from the listener answers")
                 (is (funcall #'beating #'ask) "the thread started from the listener runs")
