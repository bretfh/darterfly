(test init-keeps-world-jobs-alive-and-quarantines
  (let ((disk (merge-pathnames "world-jobs.img" (darterfly-file "build/"))))
    (uiop:delete-file-if-exists disk)
    (darterfly/image::root-disk disk (* 256 1048576)
                                (append (darterfly/image::root-entries)
                                        (list (list :file "usr/lib/sbcl/sbcl.core" (image::octets (darterfly-file "build/sbcl-mt/output/sbcl.core"))))))
    (let ((c (image:bare-console :boot-args "init" :root disk)))
      (labels ((ask (form &optional (timeout 120))
                 (image:send c form)
                 (image:expect c (format nil "~%* ") :timeout timeout))
               (job (name)
                 (format nil "(find ~s (darterfly/init:jobs) :key (lambda (j) (getf j :label)) :test #'equal)" name))
               (until (name state seconds)
                 (format nil "(loop :repeat ~d :until (eq ~s (getf ~a :state)) :do (sleep 0.5) :finally (return ~a))"
                         (* 2 seconds) state (job name) (job name)))
               (in (name form)
                 (format nil "(ignore-errors (darterfly/run:world-eval (darterfly/run:find-world ~s) ~s))" name form)))
        (unwind-protect
             (progn
               (image:expect c "init: pid" :timeout 90)
               (ask "t")
               (ask "(darterfly/init:submit '(:label \"crashy\" :world t :keep-alive t :throttle 1 :most-exits 3))")
               (dotimes (i 3)
                 (ask (format nil "(loop :repeat 120 :for j := ~a :until (and (= ~d (getf j :exits)) (eq :running (getf j :state))) :do (sleep 0.5))" (job "crashy") i))
                 (ask (in "crashy" "(sb-ext:exit :code 3 :abort t)")))
               (let ((failed (ask (until "crashy" :failed 60))))
                 (is (search ":FAILED" failed) "a world job that keeps dying is restarted, then left down: ~a" failed)
                 (is (search "3 exits in 60 s" failed) "with why"))
               (ask "(darterfly/init:submit '(:label \"hog\" :world (:memory 256) :keep-alive t :throttle 1 :most-resident 1/2 :heartbeat 2))")
               (ask (until "hog" :running 60))
               (ask (in "hog" "(progn (defvar *hog* (make-array (* 200 1024 1024) :element-type '(unsigned-byte 8) :initial-element 1)) t)") 300)
               (let ((hog (ask (until "hog" :quarantined 30))))
                 (is (search ":QUARANTINED" hog) "a world growing past its share is quarantined: ~a" hog)
                 (is (search "resident" hog) "with why"))
               (let ((inside (ask "(let ((i (darterfly/init:inspect-job \"hog\"))) (list (length (getf (getf i :inside) :threads)) (every (lambda (th) (plusp (getf th :rip))) (getf (getf i :inside) :threads)) (some (lambda (th) (getf th :returns)) (getf (getf i :inside) :threads))))")))
                 (is (not (search " 0 " inside)) "and the paused world's threads can be read from outside: ~a" inside)
                 (is (not (search "NIL)" inside)) "with their registers and return addresses: ~a" inside))
               (sleep 8)
               (is (search ":PAUSED" (ask (format nil "(getf (find (getf ~a :world) (darterfly/worlds:worlds) :key (lambda (w) (getf w :id))) :state)" (job "hog"))))
                   "it is paused and kept, and its watchdog leaves it alone")
               (let ((refused (ask (in "hog" "(+ 1 2)"))))
                 (is (search "NIL" refused) "a paused world refuses an eval instead of hanging the caller: ~a" refused))
               (is (search "is paused" (ask "(handler-case (darterfly/run:world-eval (darterfly/run:find-world \"hog\") \"t\") (error (e) (princ-to-string e)))")))
               (ask "(progn (setf (getf (slot-value (find \"hog\" darterfly/init::*jobs* :key #'darterfly/init::label :test #'equal) 'darterfly/init::plist) :most-resident) 2) (darterfly/init:release \"hog\"))")
               (ask (in "hog" "(progn (setf *hog* nil) (sb-ext:gc :full t) t)"))
               (is (search "\"3\"" (ask (in "hog" "(+ 1 2)"))) "released, it answers again")
               (ask (in "hog" "(sb-thread:terminate-thread (find \"heartbeat\" (sb-thread:list-all-threads) :key #'sb-thread:thread-name :test #'equal))"))
               (let ((silent (ask (format nil "(loop :repeat 60 :until (plusp (getf ~a :exits)) :do (sleep 0.5) :finally (return ~a))" (job "hog") (job "hog")))))
                 (is (search "still silent" (image:transcript c)) "a world that stops checking in is stopped by the kernel")
                 (is (search ":EXITS 1" silent) "and init sees it: ~a" silent))
               (is (search ":RUNNING" (ask (until "hog" :running 60))) "and starts it again")
               (let ((slow (ask "(let ((start (get-internal-real-time)) (darterfly/run:*answer-within* 2)) (handler-case (darterfly/run:world-eval (darterfly/run:find-world \"hog\") \"(sleep 20)\") (darterfly/run:no-answer (e) (list (princ-to-string e) (round (- (get-internal-real-time) start) internal-time-units-per-second)))))")))
                 (is (search "didn't answer in 2 s\" 2)" slow) "a call gives up at the default deadline: ~a" slow))
               (is (search "\"3\"" (ask "(darterfly/run:world-eval (darterfly/run:find-world \"hog\") \"(+ 1 2)\" :timeout 60)"))
                   "and the world answers the next one")
               (ask "(darterfly/init:remove-job \"hog\")")
               (is (search "NIL" (ask (format nil "(loop :repeat 60 :while ~a :do (sleep 0.5) :finally (return ~a))" (job "hog") (job "hog"))))
                   "a removed job is stopped and forgotten")
               (is (search "hog stopped: removed" (image:transcript c)) "and not restarted"))
          (image:finish c 5))))))

