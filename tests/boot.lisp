(test a-world-calls-the-system-through-a-port
  ;; Global free-page accounting needs a quiet root: init's concurrent driver
  ;; startup allocates unrelated pages while the 200 short worlds run.
  (let ((c (image:bare-console)))
    (flet ((ask (form) (image:send c form) (image:expect c (format nil "~%* ") :timeout 60)))
      (unwind-protect
           (progn
             (is (image:expect c "* " :timeout 120))
             (ask "(defparameter *program* (let ((v (make-array 2052 :element-type '(unsigned-byte 8) :initial-element #x90))) (replace v #(184 41 0 0 0 191 1 0 0 0 72 190 0 8 0 64 0 0 0 0 186 4 0 0 0 73 186 0 9 0 64 0 0 0 0 65 184 16 0 0 0 205 130 184 41 0 0 0 191 1 0 0 0 72 190 0 9 0 64 0 0 0 0 186 4 0 0 0 73 186 0 10 0 64 0 0 0 0 65 184 16 0 0 0 205 130 184 1 0 0 0 49 255 205 128 235)) (replace v (sb-ext:string-to-octets \"ping\") :start1 #x800)))")
             (ask "(defparameter *port* (darterfly/worlds:make-port))")
             (ask "(defparameter *world* (darterfly/worlds:spawn *program* :port *port*))")
             (is (search "[ping 1]" (ask "(multiple-value-bind (m token world) (darterfly/worlds:receive *port* :timeout 5) (darterfly/worlds:reply token \"pong\") (format nil \"[~a ~a]\" (sb-ext:octets-to-string m) world))"))
                 "the world's message arrives with its world number")
             (is (search "[pong]" (ask "(multiple-value-bind (m token) (darterfly/worlds:receive *port* :timeout 5) (darterfly/worlds:reply token \"ok\") (format nil \"[~a]\" (sb-ext:octets-to-string m)))"))
                 "and the reply reached the world's memory")
             (is (search "[T]" (ask "(progn (sleep 0.5) (format nil \"[~a]\" (and (member (darterfly/worlds:world-state *world*) '(:stopped :gone)) t)))"))
                 "its exit stops the world")
             (is (search "[WORLD-ERROR]" (ask "(format nil \"[~a]\" (handler-case (darterfly/worlds:receive *port* :timeout 0.2) (darterfly/worlds:world-error (e) (type-of e))))"))
                 "an empty port times out")
             (is (search "[T 0]" (ask "(let ((w (darterfly/worlds:spawn *program* :port *port*))) (multiple-value-bind (m token) (darterfly/worlds:receive *port* :timeout 5) (declare (ignore m)) (darterfly/worlds:stop w) (format nil \"[~a ~a]\" (and (member (darterfly/worlds:world-state w) '(:stopped :gone)) t) (darterfly/worlds:reply token \"late\"))))"))
                 "a world stopped while its call is held is gone, and the late reply goes nowhere")
             (ask "(progn (darterfly/worlds:spawn *program* :entry #x56) (sleep 0.2) (sb-thread:join-thread (sb-thread:make-thread (lambda ()))) (sb-ext:gc :full t) (defparameter *free* (darterfly/worlds:free-pages)))")
             (is (search "[T " (ask "(let ((ws (loop :repeat 200 :collect (darterfly/worlds:spawn *program* :entry #x56)))) (sleep 0.5) (sb-thread:join-thread (sb-thread:make-thread (lambda ()))) (sb-ext:gc :full t) (let ((lost (- *free* (darterfly/worlds:free-pages)))) (format nil \"[~a ~a]\" (and (every (lambda (w) (eq (darterfly/worlds:world-state w) :gone)) ws) (< lost 400)) lost)))"))
                 "worlds that end give their memory back")
             (is (search "[ALIVE]" (ask "(format nil \"[~a]\" (if (sb-thread:thread-alive-p (sb-thread:main-thread)) :alive :gone))"))))
        (image:finish c 5)))))

