        "make-genesis-2 writes the cold core inside darterfly")
    (flet ((relatives (pattern) (mapcar (lambda (p) (enough-namestring p host)) (directory (merge-pathnames pattern host)))))
      (let ((files (append (list "output/cold-sbcl.core")
