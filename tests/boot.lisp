(defun chord (&rest names)
  (flet ((key (name down)
           (darterfly/qmp:dict "type" "key" "data" (darterfly/qmp:dict "down" down "key" (darterfly/qmp:dict "type" "qcode" "data" name)))))
    (image::qmp "input-send-event"
                (darterfly/qmp:dict "events" (coerce (append (loop :for n :in names :collect (key n t))
                                                         (loop :for n :in (reverse names) :collect (key n nil)))
                                                 'vector)))))

(defun listener-text-until (c text)
  (loop :with deadline := (+ (get-internal-real-time) (* 60 internal-time-units-per-second))
        :do (image:send c "(progn (ignore-errors (darterfly/shell:cat \"/tmp/Listener.txt\")) :done)")
            (let ((seen (image:expect c (format nil "~%* ") :timeout 60)))
              (when (or (search text seen) (> (get-internal-real-time) deadline))
                (return seen)))
            (sleep 1)))

(defun close-first-boot-app (c name)
  (flet ((ask (form) (image:send c form) (image:expect c (format nil "~%* ") :timeout 120)))
    (let ((owner (format nil "(let ((p (find ~s (darterfly/bsd:procs) :key (function darterfly/bsd::proc-comm) :test (function equal)))) (and p (let ((w (darterfly/windowserver::key-window))) (and w (eql (darterfly/bsd:proc-pid p) (ignore-errors (darterfly/windowserver::pid (darterfly/windowserver::context-client (darterfly/windowserver::window-context w))))))) :key))" name)))
      (when (search ":KEY" (ask (format nil "(loop :repeat 900 :until ~a :do (sleep 0.1) :finally (return ~a))" owner owner)))
        (image:send-keys (string #\Escape))
        (ask (format nil "(loop :repeat 300 :while (find ~s (darterfly/bsd:procs) :key (function darterfly/bsd::proc-comm) :test (function equal)) :do (sleep 0.1) :finally (return :closed))" name))))))

(defun marked (c form &optional (timeout 120))
  (image:send c (format nil "(format t \"~~&[[R ~~a]]~~%\" (substitute #\\_ #\\Newline (princ-to-string ~a)))" form))
  (image:expect c "[[R " :timeout timeout)
  (prog1 (image:expect c "]]" :timeout 10)
    (image:expect c (format nil "~%* ") :timeout 30)))

(defun settled (c)
  (image:send c ":sync")
  (image:expect c ":SYNC" :timeout 120)
  (image:expect c "* " :timeout 120))

(defun count-restarts (c)
  (let ((text (image:transcript c)))
    (loop with at = 0 for hit = (search "restart: core " text :start2 at)
          while hit count t do (setf at (1+ hit)))))

(defun nrepl-client (port key code)
  (multiple-value-bind (out err)
      (uiop:run-program (list "timeout" "60" "sbcl" "--script" (namestring (darterfly-file "tools/nrepl.lisp"))
                              "eval" "--new" "--host" "127.0.0.1" "--port" (princ-to-string port) "--key" key code)
                        :output :string :error-output :string :ignore-error-status t)
    (concatenate 'string out err)))

