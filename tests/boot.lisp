    (is (sbcl-phase disk "(progn (push (lambda () (throw 'after-xc t)) sb-ext:*save-hooks*) (catch 'after-xc (cl-user::load-sbcl-file \"make-host-2.lisp\" nil)) (format t \"~%HOST2-DONE~%\"))" "HOST2-DONE")
