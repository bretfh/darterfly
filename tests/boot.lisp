(test deploy-updates-an-installed-system
  (let* ((stick (image:usb-image))
         (disk (merge-pathnames "deploy-nvme.img" (darterfly-file "build/")))
         (port (free-udp-port)))
    (with-open-file (s disk :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
      (file-position s (1- (* 4096 1048576)))
      (write-byte 0 s))
    (let ((c (stick-machine "-drive" (format nil "if=none,id=stick,format=raw,snapshot=on,file=~a" (uiop:native-namestring stick))
                            "-device" "usb-storage,bus=xhci.0,drive=stick,bootindex=0"
                            "-drive" (format nil "if=none,id=disk,format=raw,file=~a" (uiop:native-namestring disk))
                            "-device" "nvme,serial=disk,drive=disk")))
      (flet ((ask (form) (image:send c form) (image:expect c (format nil "~%* ") :timeout 600)))
        (unwind-protect
             (progn
               (is (image:expect c "init: pid 1" :timeout 120))
               (is (search "\"" (ask "(darterfly/install:install-disk)")))
               (image:send c "(sb-ext:exit)")
               (image:expect c "exit(0)" :timeout 120))
          (image:finish c 5))))
    (let* ((*stick-netdev* (format nil "user,id=net0,hostfwd=tcp::~d-:4011" port))
           (c (stick-machine "-drive" (format nil "if=none,id=disk,format=raw,file=~a" (uiop:native-namestring disk))
                             "-device" "nvme,serial=disk,drive=disk,bootindex=0")))
      (flet ((ask (form) (image:send c form) (image:expect c (format nil "~%* ") :timeout 120)))
        (unwind-protect
             (progn
               (is (image:expect c "init: pid 1" :timeout 120))
               (ask "(progn (loop :repeat 100 :until darterfly/nrepl::*thread* :do (sleep 0.1)) :ready)")
               (is (search ":CLOSED" (close-first-boot-app c "Setup")) "a fresh install opens setup")
               (ask "(with-open-file (s \"/Users/darterfly/kept\" :direction :output :if-exists :supersede) (write-line \"kept\" s))")
               (ask "(darterfly/shell:spawn \"/System/Applications/Listener.app/Contents/Programs/Listener\")")
               (screen-until (lambda (s) (= #xffffffff (image:pixel s 500 300))))
               (image:send-keys (format nil "(+ 40 2)~%"))
               (is (search "42" (listener-text-until c "42")))
               (let ((result (remove #\Newline (image:deploy "127.0.0.1" :from "10.0.2.2" :nrepl-port port))))
                 (is (search ":SAVING" result) "~a" result))
               (is (image:expect c "restart: core " :timeout 300) "the deploy saves the running world")
               (is (image:expect c "init: pid 1" :timeout 120))
               (is (search "42" (listener-text-until c "42")) "the listener is still there after the deploy")
               (sleep 60)
               (is (= 1 (count-restarts c)) "the world saved once and stays up")
               (ask "(progn (loop :repeat 100 :until darterfly/nrepl::*thread* :do (sleep 0.1)) :ready)")
               (let ((result (remove #\Newline (image:deploy "127.0.0.1" :from "10.0.2.2" :nrepl-port port :restart t))))
                 (is (search ":SAVING" result) "~a" result))
               (is (loop :repeat 3000 :unless (uiop:process-alive-p (image::console-process c)) :return t :do (sleep 0.1))
                   "a deploy with a new kernel restarts the machine"))
          (image:finish c 5))))
    (let ((c (stick-machine "-drive" (format nil "if=none,id=disk,format=raw,file=~a" (uiop:native-namestring disk))
                            "-device" "nvme,serial=disk,drive=disk,bootindex=0")))
      (flet ((ask (form) (image:send c form) (image:expect c (format nil "~%* ") :timeout 120)))
        (unwind-protect
             (progn
               (is (image:expect c "boot.efi: generation gen-3" :timeout 60) "the newest deployed generation boots")
               (is (image:expect c "init: pid 1" :timeout 120))
               (is (search "42" (listener-text-until c "42")) "and the listener comes back with it")
               (sleep 60)
               (is (uiop:process-alive-p (image::console-process c)) "the new kernel's boot stays up")
               (is (search "NIL" (marked c "(and (probe-file darterfly/install::*pending-generation*) t)")) "nothing is left pending")
               (is (search "kept" (marked c "(with-open-file (s \"/Users/darterfly/kept\") (read-line s))")) "user files survive")
               (is (search "T" (marked c "(and (probe-file \"/usr/src/darterfly/src/install/deploy.lisp\") t)"))))
          (image:finish c 5))))))

(test install-from-the-desktop
  (let* ((stick (image:usb-image))
         (disk (merge-pathnames "install-ui.img" (darterfly-file "build/")))
         (image:*screen-size* '(1280 800)))
    (with-open-file (s disk :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
      (file-position s (1- (* 4096 1048576)))
      (write-byte 0 s))
    (let ((c (stick-machine "-drive" (format nil "if=none,id=stick,format=raw,snapshot=on,file=~a" (uiop:native-namestring stick))
                            "-device" "usb-storage,bus=xhci.0,drive=stick,bootindex=0" "-device" "usb-mouse,bus=xhci.0"
                            "-drive" (format nil "if=none,id=disk,format=raw,file=~a" (uiop:native-namestring disk))
                            "-device" "nvme,serial=disk,drive=disk")))
      (labels ((ask (form) (image:send c form) (image:expect c (format nil "~%* ") :timeout 120))
               (rel (dx dy) (image:qmp "input-send-event"
                                       (darterfly/qmp:dict "events" (vector (darterfly/qmp:dict "type" "rel" "data" (darterfly/qmp:dict "axis" "x" "value" dx))
                                                                        (darterfly/qmp:dict "type" "rel" "data" (darterfly/qmp:dict "axis" "y" "value" dy))))))
               (button (down) (image:qmp "input-send-event"
                                         (darterfly/qmp:dict "events" (vector (darterfly/qmp:dict "type" "btn" "data" (darterfly/qmp:dict "button" "left" "down" down))))))
               (click (x y)
                 (dotimes (i 40) (rel -100 -100) (sleep 0.01))
                 (loop :with at-x := 0 :with at-y := 0
                       :until (and (>= at-x x) (>= at-y y))
                       :do (let ((dx (min 50 (- x at-x))) (dy (min 50 (- y at-y))))
                             (rel dx dy) (incf at-x dx) (incf at-y dy) (sleep 0.02)))
                 (sleep 0.5)
                 (button t) (sleep 0.05) (button nil) (sleep 1)))
        (unwind-protect
             (progn
               (is (image:expect c "init: pid 1" :timeout 120))
               (screen-until (lambda (s) (= #xffffffff (image:pixel s 400 510))) 60)
               (sleep 2)
               (click 800 513)
               (click 800 513)
               (is (search "\"EFI PART\"" (ask "(loop :repeat 600 :until (equal \"EFI PART\" (map 'string #'code-char (darterfly/devices:media-read (darterfly/install:internal-disk) 512 8))) :do (sleep 0.5) :finally (return (map 'string #'code-char (darterfly/devices:media-read (darterfly/install:internal-disk) 512 8))))"))
                   "Install... then Erase and Install writes the disk")
               (sleep 20)
               (image:screendump)
               (uiop:copy-file (darterfly/image::build-path "screen.ppm") (darterfly-file "build/install-done.ppm")))
          (image:finish c 5))))))

(test stopping-world-calls-does-not-race-late-replies
  (let* ((image::*console-log-directory* (merge-pathnames "port-stop-console/" (scratch)))
         (c (image:bare-console :boot-args "init")))
    (flet ((ask (form)
             (image:send c form)
             (image:expect c (format nil "~%* ") :timeout 90)))
      (unwind-protect
          (progn
            (is (image:expect c "init: pid 1" :timeout 120))
             (ask "(defparameter *program* (let ((v (make-array 2052 :element-type '(unsigned-byte 8) :initial-element #x90))) (replace v #(184 41 0 0 0 191 1 0 0 0 72 190 0 8 0 64 0 0 0 0 186 4 0 0 0 73 186 0 9 0 64 0 0 0 0 65 184 16 0 0 0 205 130 184 41 0 0 0 191 1 0 0 0 72 190 0 9 0 64 0 0 0 0 186 4 0 0 0 73 186 0 10 0 64 0 0 0 0 65 184 16 0 0 0 205 130 184 1 0 0 0 49 255 205 128 235)) (replace v (sb-ext:string-to-octets \"ping\") :start1 #x800)))")
            (ask "(defparameter *port* (darterfly/worlds:make-port))")
            (is (search "[STOP-REPLY-RACE PASS]"
                  (ask "(progn (dotimes (i 200) (let ((w (darterfly/worlds:spawn *program* :port *port*))) (multiple-value-bind (m token) (darterfly/worlds:receive *port* :timeout 5) (declare (ignore m)) (darterfly/worlds:stop w) (darterfly/worlds:reply token \"late\")) (assert (loop repeat 100 when (eq :gone (darterfly/worlds:world-state w)) return t do (sleep .001))))) (format nil \"[STOP-REPLY-RACE PASS]\"))")))
            (is (search "[ALIVE]" (ask "(format nil \"[ALIVE]\")"))))
        (with-open-file (s (merge-pathnames "nyxt-port-stop-guest.log" image:*build*)
                           :direction :output :if-exists :supersede)
          (write-string (image:transcript c) s))
        (image:finish c 5)))))
