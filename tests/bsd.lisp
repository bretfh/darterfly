(in-package #:finch/test)

(def-suite bsd :in all)
(in-suite bsd)

(defvar *emit* (sb-thread:make-mutex :name "emit"))

(defun emit (out control &rest args)
  (sb-thread:with-mutex (*emit*)
    (apply #'format out control args)
    (finish-output out)))

(defun bsd-value (vars word)
  (cond ((string= word "any") -1)
        ((digit-char-p (char word 0)) (parse-integer word))
        (t (gethash word vars 0))))

(defun bsd-key (vars value)
  (let ((found "?"))
    (maphash (lambda (k v) (when (eql v value) (setf found k))) vars)
    found))

(defun bsd-signal (word)
  (if (digit-char-p (char word 0))
      (parse-integer word)
      (bsd:signo (intern (format nil "SIG~:@(~a~)" word) :keyword))))

(defun bsd-status (status)
  (cond ((bsd:wifexited status) (format nil "exited ~d" (bsd:wexitstatus status)))
        ((bsd:wifsignaled status) (format nil "signaled ~(~a~)" (subseq (symbol-name (bsd:signame (bsd:wtermsig status))) 3)))
        ((bsd:wifstopped status) (format nil "stopped ~(~a~)" (subseq (symbol-name (bsd:signame (bsd:wstopsig status))) 3)))
        ((bsd:wifcontinued status) "continued")))

(defun octets-of (string)
  (map '(vector (unsigned-byte 8)) #'char-code string))

(defun string-of (octets)
  (map 'string #'code-char octets))

(defun nonblocking (fd on)
  (let ((flags (bsd:fcntl fd bsd:+f-getfl+)))
    (bsd:fcntl fd bsd:+f-setfl+ (if on (logior flags bsd:+o-nonblock+) (logandc2 flags bsd:+o-nonblock+)))))

(defun open-flags (word)
  (loop :for flag :in (uiop:split-string word :separator "|")
        :sum (symbol-value (find-symbol (format nil "+O-~:@(~a~)+" flag) :finch/bsd))))

(defun bsd-run (lines at vars out ready)
  (loop
    (when (>= at (length lines)) (return))
    (let* ((line (aref lines at))
           (words (uiop:split-string line :separator " "))
           (op (first words))
           (args (rest words)))
      (incf at)
      (emit out "~a |" line)
      (flet ((done (control &rest more) (emit out "~?~%" control more))
             (value (word) (bsd-value vars word))
             (bind (word v) (setf (gethash word vars) v)))
        (handler-case
            (cond
              ((string= op "self") (bind (first args) (bsd:getpid)) (done " 0"))
              ((string= op "ppid-is")
               (done " 0 ~a" (if (= (bsd:getppid) (value (first args))) "yes" "no")))
              ((string= op "fork")
               (multiple-value-bind (r w) (bsd:pipe)
                 (done " 0")
                 (let* ((start at)
                        (child-vars (let ((h (make-hash-table :test 'equal)))
                                      (maphash (lambda (k v) (setf (gethash k h) v)) vars)
                                      h))
                        (pid (bsd:fork (lambda ()
                                         (bsd:close r)
                                         (when ready (bsd:close ready))
                                         (bsd-run lines start child-vars out w)))))
                   (bind (first args) pid)
                   (bsd:close w)
                   (let ((depth 1))
                     (loop :while (and (plusp depth) (< at (length lines)))
                           :do (let ((l (aref lines at)))
                                 (when (uiop:string-prefix-p "fork" l) (incf depth))
                                 (when (uiop:string-prefix-p "end" l) (decf depth))
                                 (incf at))))
                   (loop :while (plusp (length (bsd:read r 1))))
                   (bsd:close r))))
              ((string= op "exit") (done " 0") (bsd:exit (parse-integer (first args))))
              ((string= op "hold")
               (done " 0")
               (bsd:close ready)
               (loop (handler-case (bsd:pause) (bsd:errno () nil))))
              ((string= op "end") (done " 0"))
              ((string= op "wait")
               (multiple-value-bind (pid status)
                   (bsd:wait4 (value (first args)) :untraced t :continued t
                                                    :nohang (equal (second args) "nohang"))
                 (if (zerop pid)
                     (done " 0 none")
                     (done " 0 ~a ~a" (bsd-key vars pid) (bsd-status status)))))
              ((string= op "kill") (bsd:kill (value (first args)) (bsd-signal (second args))) (done " 0"))
              ((string= op "signal")
               (bsd:sigaction (bsd-signal (first args))
                              (cond ((string= (second args) "ignore") :ignore)
                                    ((string= (second args) "default") :default)
                                    (t (lambda (signo) (bsd:exit (+ 100 signo))))))
               (done " 0"))
              ((member op '("mask" "unmask") :test #'string=)
               (bsd:sigprocmask (if (string= op "mask") :block :unblock) (list (bsd-signal (first args))))
               (done " 0"))
              ((string= op "pipe")
               (multiple-value-bind (r w) (bsd:pipe)
                 (bind (first args) r)
                 (bind (second args) w))
               (done " 0"))
              ((string= op "write")
               (done " 0 ~d" (bsd:write (value (first args)) (octets-of (second args)))))
              ((string= op "fill")
               (let ((fd (value (first args)))
                     (block (make-array 4096 :element-type '(unsigned-byte 8) :initial-element 0))
                     (total 0))
                 (nonblocking fd t)
                 (let ((code (handler-case (loop (incf total (bsd:write fd block)))
                               (bsd:errno (e) (bsd:errno-code e)))))
                   (nonblocking fd nil)
                   (done " 0 ~d ~d" total code))))
              ((string= op "read")
               (let ((octets (bsd:read (value (first args)) (parse-integer (second args)))))
                 (done " 0 ~d ~a" (length octets) (string-of octets))))
              ((string= op "drain")
               (let ((fd (value (first args)))
                     (total 0))
                 (nonblocking fd t)
                 (let ((code (handler-case (loop (let ((n (length (bsd:read fd 4096))))
                                                   (when (zerop n) (return 0))
                                                   (incf total n)))
                               (bsd:errno (e) (bsd:errno-code e)))))
                   (nonblocking fd nil)
                   (done " 0 ~d ~d" total code))))
              ((string= op "close") (bsd:close (value (first args))) (done " 0"))
              ((string= op "dup") (bind (second args) (bsd:dup (value (first args)))) (done " 0"))
              ((string= op "scratch")
               (bsd:chdir (sb-posix:mkdtemp (format nil "~a/finch.XXXXXX" (string-right-trim "/" (uiop:native-namestring (scratch))))))
               (done " 0"))
              ((string= op "open")
               (bind (first args) (bsd:open (second args) (open-flags (third args))))
               (done " 0"))
              ((string= op "lseek")
               (done " 0 ~d" (bsd:lseek (value (first args)) (parse-integer (second args))
                                       (intern (string-upcase (third args)) :keyword))))
              ((member op '("stat" "lstat" "fstat") :test #'string=)
               (let* ((stat (cond ((string= op "stat") (bsd:stat (first args)))
                                  ((string= op "lstat") (bsd:lstat (first args)))
                                  (t (bsd:fstat (value (first args))))))
                      (kind (let ((f (logand (getf stat :mode) bsd:+s-ifmt+)))
                              (cond ((= f bsd:+s-ifdir+) "dir") ((= f bsd:+s-ifreg+) "file")
                                    ((= f bsd:+s-ififo+) "fifo") ((= f bsd:+s-iflnk+) "link") (t "other")))))
                 (if (string= kind "file")
                     (done " 0 ~a ~d" kind (getf stat :size))
                     (done " 0 ~a" kind))))
              ((string= op "mkdir") (bsd:mkdir (first args)) (done " 0"))
              ((string= op "rmdir") (bsd:rmdir (first args)) (done " 0"))
              ((string= op "unlink") (bsd:unlink (first args)) (done " 0"))
              ((string= op "rename") (bsd:rename (first args) (second args)) (done " 0"))
              ((string= op "symlink") (bsd:symlink (first args) (second args)) (done " 0"))
              ((string= op "chdir") (bsd:chdir (first args)) (done " 0"))
              ((string= op "cwd-ends")
               (done " 0 ~a" (if (uiop:string-suffix-p (bsd:getcwd) (first args)) "yes" "no")))
              ((string= op "readdir")
               (done " 0~{ ~a~}" (sort (bsd:readdir (first args)) #'string<)))
              ((string= op "same")
               (done " 0 ~a" (if (= (value (first args)) (value (second args))) "yes" "no")))
              (t (done " ?")))
          (bsd:errno (e) (done " ~d" (bsd:errno-code e))))))))

(test bsd-matches-xnu
  (let* ((lines (coerce (remove "" (uiop:read-file-lines (asdf:system-relative-pathname :finch "src/tahoe/bsd.script"))
                                :test #'string=)
                        'vector))
         (out (make-string-output-stream))
         (pid (bsd:fork (lambda () (bsd-run lines 0 (make-hash-table :test 'equal) out nil)))))
    (multiple-value-bind (reaped status) (bsd:wait4 pid)
      (is (= pid reaped))
      (is (bsd:wifexited status)))
    (let ((finch (uiop:split-string (get-output-stream-string out) :separator '(#\Newline)))
          (xnu (uiop:read-file-lines (asdf:system-relative-pathname :finch "tests/bsd.txt"))))
      (loop :for x :in xnu
            :for f :in finch
            :do (is (string= x f) "xnu ~s, finch ~s" x f))
      (is (= (length xnu) (length (remove "" finch :test #'string=)))))))
