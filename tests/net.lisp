(in-package #:finch/test)

(def-suite net :in all)
(in-suite net)

(defclass captured-device () ((frames :initform nil :accessor frames)))

(defmethod finch/net:if-output ((device captured-device) frame)
  (push frame (frames device)))

(defparameter +peer-mac+ (coerce #(2 0 0 0 0 2) '(vector (unsigned-byte 8))))

(defun peer-segment (seq ack flags &optional (data ""))
  (let ((d (sb-ext:string-to-octets data)))
    (finch/net::octets (finch/net::be 5000 2) (finch/net::be 80 2) (finch/net::be seq 4) (finch/net::be ack 4)
                       (finch/net::be #x50 1) (finch/net::be flags 1) (finch/net::be 65535 2) (finch/net::be 0 4) d)))

(defun last-segment (device)
  (subseq (first (frames device)) 34))

(defun last-ack (device) (finch/net::u32be (last-segment device) 8))

(test tcp-reassembles-out-of-order-segments
  (let* ((device (make-instance 'captured-device))
         (peer (finch/net:ip-address "10.0.2.2"))
         (finch/net:*interface* (finch/net::make-interface :device device :mac (coerce #(2 0 0 0 0 1) '(vector (unsigned-byte 8)))
                                                           :ip (finch/net:ip-address "10.0.2.15") :prefix 24 :gateway peer))
         (finch/net::*connections* (make-hash-table :test 'equal))
         (finch/net::*listeners* (make-hash-table)))
    (setf (gethash peer (finch/net::interface-arp finch/net:*interface*)) +peer-mac+)
    (let ((listener (finch/net:tcp-listen 80)))
        (finch/net::receive-tcp peer (peer-segment 1000 0 finch/net::+syn+))
        (let* ((syn-ack (last-segment device))
               (iss (finch/net::u32be syn-ack 4))
               (ack-flags finch/net::+ack+))
          (is (= 1001 (last-ack device)))
          (finch/net::receive-tcp peer (peer-segment 1001 (1+ iss) ack-flags))
          (let ((c (finch/net:tcp-accept listener :timeout 1)))
            (is (not (null c)))
            (flet ((in (seq &optional (data "") (flags ack-flags)) (finch/net::receive-tcp peer (peer-segment seq (1+ iss) flags data)))
                   (got () (let ((v (finch/net:tcp-receive c :timeout 0))) (and v (map 'string #'code-char v)))))
              (in 1007 "ccc")
              (is (= 1001 (last-ack device)) "a segment past a gap is held and the old ack repeated")
              (in 1004 "bbb")
              (is (= 1001 (last-ack device)))
              (is (equal "" (got)))
              (in 1001 "aaa")
              (is (= 1010 (last-ack device)) "the gap filled, everything held is delivered")
              (is (equal "aaabbbccc" (got)))
              (in 1007 "cccddd")
              (is (= 1013 (last-ack device)) "an overlapping retransmission gives only its new bytes")
              (is (equal "ddd" (got)))
              (in 1001 "aaa")
              (is (= 1013 (last-ack device)) "an old duplicate is re-acked")
              (is (equal "" (got)))
              (in 1016 "fff" (logior ack-flags finch/net::+fin+))
              (in 1013 "eee")
              (is (= 1020 (last-ack device)) "a held FIN counts once the data before it arrives")
              (is (equal "eeefff" (got)))
              (is (null (got)) "end of stream")
              (is (eq :close-wait (finch/net::tcp-state c)))))))))
