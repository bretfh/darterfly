(in-package #:finch/test)

(def-suite net :in all)
(in-suite net)

(defclass captured-device () ((frames :initform nil :accessor frames)))

(defmethod finch/net:if-output ((device captured-device) frame)
  (push frame (frames device)))

(defparameter +peer-mac+ (coerce #(2 0 0 0 0 2) '(vector (unsigned-byte 8))))

(defun peer-segment (seq ack flags &optional (data ""))
  (let ((d (sb-ext:string-to-octets data)))
    (finch/net::octets (finch/net::be 5000 2) (finch/net::be 80 2) (finch/net::be seq 4) (finch/net::be ack 4)
                       (finch/net::be #x50 1) (finch/net::be flags 1) (finch/net::be 65535 2) (finch/net::be 0 4) d)))

(defun last-segment (device)
  (subseq (first (frames device)) 34))

(defun last-ack (device) (finch/net::u32be (last-segment device) 8))

(test tcp-reassembles-out-of-order-segments
  (let* ((device (make-instance 'captured-device))
         (peer (finch/net:ip-address "10.0.2.2"))
         (finch/net:*interface* (finch/net::make-interface :device device :mac (coerce #(2 0 0 0 0 1) '(vector (unsigned-byte 8)))
                                                           :ip (finch/net:ip-address "10.0.2.15") :prefix 24 :gateway peer))
         (finch/net::*connections* (make-hash-table :test 'equalp))
         (finch/net::*listeners* (make-hash-table)))
    (setf (gethash peer (finch/net::interface-arp finch/net:*interface*)) +peer-mac+)
    (let ((listener (finch/net:tcp-listen 80)))
        (finch/net::receive-tcp peer (peer-segment 1000 0 finch/net::+syn+))
        (let* ((syn-ack (last-segment device))
               (iss (finch/net::u32be syn-ack 4))
               (ack-flags finch/net::+ack+))
          (is (= 1001 (last-ack device)))
          (finch/net::receive-tcp peer (peer-segment 1001 (1+ iss) ack-flags))
          (let ((c (finch/net:tcp-accept listener :timeout 1)))
            (is (not (null c)))
            (flet ((in (seq &optional (data "") (flags ack-flags)) (finch/net::receive-tcp peer (peer-segment seq (1+ iss) flags data)))
                   (got () (let ((v (finch/net:tcp-receive c :timeout 0))) (and v (map 'string #'code-char v)))))
              (in 1007 "ccc")
              (is (= 1001 (last-ack device)) "a segment past a gap is held and the old ack repeated")
              (in 1004 "bbb")
              (is (= 1001 (last-ack device)))
              (is (equal "" (got)))
              (in 1001 "aaa")
              (is (= 1010 (last-ack device)) "the gap filled, everything held is delivered")
              (is (equal "aaabbbccc" (got)))
              (in 1007 "cccddd")
              (is (= 1013 (last-ack device)) "an overlapping retransmission gives only its new bytes")
              (is (equal "ddd" (got)))
              (in 1001 "aaa")
              (is (= 1013 (last-ack device)) "an old duplicate is re-acked")
              (is (equal "" (got)))
              (in 1016 "fff" (logior ack-flags finch/net::+fin+))
              (in 1013 "eee")
              (is (= 1020 (last-ack device)) "a held FIN counts once the data before it arrives")
              (is (equal "eeefff" (got)))
              (is (null (got)) "end of stream")
              (is (eq :close-wait (finch/net::tcp-state c)))))))))

(defun data-segments (device)
  (loop for frame in (reverse (frames device))
        for segment = (subseq frame 34)
        when (> (length segment) (* 4 (ash (aref segment 12) -4)))
          collect (finch/net::u32be segment 4)))

(test tcp-congestion-control
  (let* ((device (make-instance 'captured-device))
         (peer (finch/net:ip-address "10.0.2.2"))
         (finch/net:*interface* (finch/net::make-interface :device device :mac (coerce #(2 0 0 0 0 1) '(vector (unsigned-byte 8)))
                                                           :ip (finch/net:ip-address "10.0.2.15") :prefix 24 :gateway peer))
         (finch/net::*connections* (make-hash-table :test 'equalp))
         (finch/net::*listeners* (make-hash-table))
         (mss finch/net::+mss+))
    (setf (gethash peer (finch/net::interface-arp finch/net:*interface*)) +peer-mac+)
    (let ((listener (finch/net:tcp-listen 80)))
      (finch/net::receive-tcp peer (peer-segment 1000 0 finch/net::+syn+))
      (let* ((iss (finch/net::u32be (last-segment device) 4))
             (base (1+ iss)))
        (finch/net::receive-tcp peer (peer-segment 1001 base finch/net::+ack+))
        (let ((c (finch/net:tcp-accept listener :timeout 1)))
          (flet ((ack (n) (finch/net::receive-tcp peer (peer-segment 1001 (+ base (* n mss)) finch/net::+ack+))))
            (finch/net:tcp-send c (make-array (* 20 mss) :element-type '(unsigned-byte 8) :initial-element 7))
            (is (= 10 (length (data-segments device))) "slow start begins with ten segments")
            (ack 1)
            (is (= 12 (length (data-segments device))) "each ack in slow start opens the window by a segment")
            (is (= (* 11 mss) (finch/net::tcp-snd-cwnd c)))
            (ack 1) (ack 1)
            (is (= 12 (length (data-segments device))) "two duplicate acks retransmit nothing")
            (ack 1)
            (is (= (+ base mss) (first (last (data-segments device)))) "the third retransmits the lost segment")
            (is (= (* 5 mss) (finch/net::tcp-snd-ssthresh c)) "ssthresh is half the window")
            (is (= (* 8 mss) (finch/net::tcp-snd-cwnd c)) "cwnd is ssthresh plus the three segments that left")
            (ack 2)
            (is (= (+ base (* 2 mss)) (first (last (data-segments device)))) "a partial ack retransmits the next hole")
            (ack 12)
            (is (null (finch/net::tcp-snd-recover c)) "an ack past the recovery point ends fast recovery")
            (is (= (* 5 mss) (finch/net::tcp-snd-ssthresh c)))
            (is (<= (finch/net::tcp-snd-cwnd c) (* 5 mss)) "and deflates cwnd to ssthresh")
            (is (<= 1 (finch/net::tcp-rxtcur c) 64) "the retransmit timeout follows the measured round trip")))))))

(defun peer-ip6 (src dst next payload &optional (hops 255))
  (finch/net::octets (finch/net::be #x60000000 4) (finch/net::be (length payload) 2) (finch/net::be next 1) (finch/net::be hops 1)
                     src dst payload))

(defun peer-icmp6 (src dst type body)
  (peer-ip6 src dst 58 (finch/net::icmp6-packet type 0 body src dst)))

(test ip6-addresses-and-neighbor-discovery
  (flet ((a (s) (finch/net:ip-address s)))
    (dolist (s '("fec0::5054:ff:fe12:3456" "::1" "::" "fe80::1" "2001:db8::1:0:0:1" "2001:db8:0:1:1:1:1:1" "ff02::1:ff12:3456"))
      (is (equal s (finch/net:address-string (a s)))))
    (is (equal "2001:db8::1:0:0:1" (finch/net:address-string (a "2001:0db8:0000:0000:0001:0000:0000:0001"))) "the longest zero run, leftmost on ties")
    (is (equal "10.0.2.2" (finch/net:address-string (a "10.0.2.2"))))
    (let* ((device (make-instance 'captured-device))
           (mac (coerce #(#x52 #x54 0 #x12 #x34 #x56) '(vector (unsigned-byte 8))))
           (router (a "fe80::2"))
           (finch/net:*interface* (finch/net::make-interface :device device :mac mac))
           (finch/net::*connections* (make-hash-table :test 'equalp))
           (finch/net::*listeners* (make-hash-table)))
      (finch/net::start-ip6)
      (let ((rs (first (frames device))))
        (is (equalp #(#x33 #x33 0 0 0 2) (subseq rs 0 6)) "the router solicitation goes to all-routers")
        (is (= 133 (aref rs 54))))
      (is (equal '("fe80::5054:ff:fe12:3456") (mapcar #'finch/net:address-string (finch/net::interface-ip6 finch/net:*interface*))))
      (setf (gethash router (finch/net::interface-nd6 finch/net:*interface*)) +peer-mac+)
      (finch/net::receive-ip6
       (peer-icmp6 router (a "ff02::1") 134
                   (finch/net::octets (finch/net::be 64 1) (finch/net::be 0 1) (finch/net::be 1800 2) (finch/net::be 0 8)
                                      (finch/net::be 3 1) (finch/net::be 4 1) (finch/net::be 64 1) (finch/net::be #xc0 1)
                                      (finch/net::be 86400 4) (finch/net::be 14400 4) (finch/net::be 0 4) (a "fec0::")
                                      (finch/net::be 25 1) (finch/net::be 3 1) (finch/net::be 0 2) (finch/net::be 3600 4) (a "fec0::3"))))
      (is (equal '("fe80::5054:ff:fe12:3456" "fec0::5054:ff:fe12:3456")
                 (mapcar #'finch/net:address-string (finch/net::interface-ip6 finch/net:*interface*)))
          "the advertised prefix and the interface identifier make an address")
      (is (equalp router (finch/net::interface-router6 finch/net:*interface*)))
      (is (equal '("fec0::3") (mapcar #'finch/net:address-string (finch/net::interface-dns6 finch/net:*interface*))))
      (let ((ours (a "fec0::5054:ff:fe12:3456")) (peer (a "fec0::2")))
        (finch/net::receive-ip6
         (peer-icmp6 peer (finch/net::solicited-node ours) 135
                     (finch/net::octets (finch/net::be 0 4) ours (finch/net::be 1 1) (finch/net::be 1 1) +peer-mac+)))
        (let* ((frame (first (frames device))) (icmp (subseq frame 54)))
          (is (= 136 (aref icmp 0)) "a solicitation for our address is answered")
          (is (equalp ours (subseq icmp 8 24)))
          (is (zerop (finch/net::transport-checksum (subseq frame 22 38) (subseq frame 38 54) 58 icmp))))
        (is (equalp +peer-mac+ (gethash peer (finch/net::interface-nd6 finch/net:*interface*))) "and the solicitor is learned")
        (let ((listener (finch/net:tcp-listen 80)))
          (finch/net::receive-ip6 (peer-ip6 peer ours 6 (let ((s (peer-segment 1000 0 finch/net::+syn+)))
                                                          (replace s (finch/net::be (finch/net::transport-checksum peer ours 6 s) 2) :start1 16))))
          (let* ((frame (first (frames device))) (segment (subseq frame 54)))
            (is (= #x86dd (finch/net::u16be frame 12)))
            (is (= (logior finch/net::+syn+ finch/net::+ack+) (aref segment 13)) "a SYN over IPv6 is answered")
            (is (zerop (finch/net::transport-checksum ours peer 6 segment)))
            (is (= 1440 (finch/net::u16be segment 22)) "with the IPv6 segment size")
            (finch/net:tcp-unlisten listener)))))))
