(in-package #:finch/test)

(def-suite ca :in all)
(in-suite ca)

(defun oracle-commits ()
  (with-open-file (s (asdf:system-relative-pathname :finch "tests/commits.txt"))
    (loop :for line := (read-line s nil)
          :while line
          :for words := (uiop:split-string line :separator " ")
          :when (string= "bytes" (first words))
            :collect (ca:commit-stream (hex-octets (remove "" (rest words) :test #'string=))))))

(defun commands (commit name)
  (remove name (getf commit :commands) :key #'first :test-not #'eql))

(test commits-round-trip
  (let ((streams (oracle-commits)))
    (is (= 3 (length streams)))
    (dolist (stream streams)
      (let* ((commit (ca:decode-commit stream))
             (octets (ca:encode-commit commit)))
        (is (equalp octets (subseq stream 0 (length octets))))
        (is (every #'zerop (subseq stream (length octets))))
        (is (< (- (length stream) (length octets)) 4))))))

(test commits-carry-the-layers
  (destructuring-bind (bare child teardown) (mapcar #'ca:decode-commit (oracle-commits))
    (is (= 1 (logand 1 (getf bare :flags))))
    (is (equal (getf bare :context) (getf child :context)))
    (let* ((root-id (second (first (commands bare :set-layer-id))))
           (root (fourth (first (commands bare :set-object)))))
      (is (= 1 (length (commands bare :set-colorspace))))
      (is (= root-id (second (first (commands bare :set-object)))))
      (is (equalp #(320d0 240d0) (getf root :position)))
      (is (equalp #(0d0 0d0 640d0 480d0) (getf root :bounds)))
      (is (= 255 (getf root :opacity)))
      (is (null (getf root :sublayers)))
      (destructuring-bind (child-set root-set) (commands child :set-object)
        (let ((c (fourth child-set))
              (r (fourth root-set)))
          (is (= root-id (second root-set)))
          (is (equalp #(60d0 45d0) (getf c :position)))
          (is (equalp #(0d0 0d0 100d0 50d0) (getf c :bounds)))
          (is (logbitp 40 (getf c :flags-a)))
          (is (not (logbitp 40 (getf r :flags-a))))
          (is (= 128 (getf r :opacity)))
          (is (equalp #(1.0 0.0 0.0 1.0) (getf r :background-color)))
          (is (logbitp 19 (getf r :flags-b)))
          (is (equalp (vector (second child-set)) (getf r :sublayers)))))
      (is (equal (list (second (first (commands child :set-object))) root-id)
                 (mapcar #'second (commands teardown :delete-object)))))))
