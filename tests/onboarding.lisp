(in-package #:darterfly/test)

(def-suite onboarding :in host)
(in-suite onboarding)

(test first-start-preferences-survive-and-resume
  (let* ((darterfly/apps::*desktop-preferences-path* (namestring (merge-pathnames "preferences/desktop.sexp" (scratch))))
         (darterfly/apps::*setup-pending-path* (namestring (merge-pathnames "setup-pending" (scratch))))
         (darterfly/apps::*desktop-preferences* (darterfly/apps::default-desktop-preferences)))
    (uiop:delete-file-if-exists darterfly/apps::*desktop-preferences-path*)
    (uiop:delete-file-if-exists darterfly/apps::*setup-pending-path*)
    (is (not (darterfly/apps::setup-needed-p)) "existing disks are not mistaken for fresh installs")
    (with-open-file (s darterfly/apps::*setup-pending-path* :direction :output) (write-line "1" s))
    (is (not (null (darterfly/apps::setup-needed-p))))
    (let ((value (darterfly/apps::default-desktop-preferences)))
      (setf (getf value :page) 1 (getf value :color) :forest (getf value :clock-24) t)
      (darterfly/apps::save-desktop-preferences value)
      (is (equal value (darterfly/apps::read-desktop-preferences)))
      (is (not (null (darterfly/apps::setup-needed-p))) "a saved choice does not finish setup")
      (setf (getf value :complete) t)
      (darterfly/apps::save-desktop-preferences value)
      (setf darterfly/apps::*desktop-preferences* (darterfly/apps::read-desktop-preferences))
      (is (not (darterfly/apps::setup-needed-p))))
    (dolist (bad '("(:version 99)" "(:version 1 :color :bogus :clock-24 nil :page 0 :complete t)"
                   "(:version 1 :color :ocean :clock-24 nil :page 8 :complete t)" "(:version" "#.(error \"never evaluate preferences\")"))
      (with-open-file (s darterfly/apps::*desktop-preferences-path* :direction :output :if-exists :supersede)
        (write-string bad s))
      (is (equal (darterfly/apps::default-desktop-preferences) (darterfly/apps::read-desktop-preferences))))))

(test failed-preference-write-does-not-finish-setup
  (let* ((dir (merge-pathnames "not-a-directory" (scratch)))
         (darterfly/apps::*desktop-preferences-path* (concatenate 'string (namestring dir) "/prefs"))
         (darterfly/apps::*desktop-preferences* (darterfly/apps::default-desktop-preferences))
         (value (darterfly/apps::default-desktop-preferences)))
    (with-open-file (s dir :direction :output :if-exists :supersede) (write-line "file" s))
    (setf (getf value :complete) t)
    (signals error (darterfly/apps::save-desktop-preferences value))
    (is (not (getf darterfly/apps::*desktop-preferences* :complete)))))

(test fresh-install-does-not-inherit-completed-setup
  (let ((darterfly/vfs:*root* nil)
        (darterfly/vfs:*mounts* nil)
        (prefs "Users/darterfly/Library/Preferences/desktop.sexp"))
    (darterfly/vfs:vfs-mount (darterfly/vfs:make-ram-node :vdir #o755) "/")
    (dolist (dir '("/src" "/src/Library" "/src/Library/Settings" "/src/Users" "/src/Users/darterfly"
                   "/src/Users/darterfly/Library" "/src/Users/darterfly/Library/Preferences" "/dst"))
      (darterfly/vfs:vfs-mkdir dir #o755))
    (dolist (file (list "Library/Settings/setup-pending" prefs (concatenate 'string prefs ".new") "Users/darterfly/document"))
      (put-file (concatenate 'string "/src/" file) "x"))
    (darterfly/install::copy-system "/src" "/dst")
    (flet ((there (rel) (and (darterfly/vfs::lookup-or-nil (concatenate 'string "/dst/" rel)) t)))
      (is (not (there "Library/Settings/setup-pending")) "the setup marker is written by the installer, not copied")
      (is (there "Library/Settings"))
      (is (not (there prefs)) "the installing desktop's finished setup stays behind")
      (is (not (there (concatenate 'string prefs ".new"))))
      (is (there "Users/darterfly/document") "the user's own files come along"))))

(test journey-keyboard-actions
  (let ((page (make-instance 'darterfly/apps::journey-page)) (chosen nil))
    (darterfly/apps::journey-layout page "TEST" "Test" nil :escape (lambda () (setf chosen :escape)))
    (darterfly/apps::journey-button page "One" (lambda () (setf chosen 1)) 0 0)
    (darterfly/apps::journey-button page "Two" (lambda () (setf chosen 2)) 0 40)
    ;; Clicking a heading must not swallow subsequent keyboard navigation.
    (darterfly/kit:key-down (first (darterfly/kit:subviews page)) (string #\Tab) 0)
    (darterfly/kit:key-down page (string #\Return) 0)
    (is (eql 2 chosen))
    (darterfly/kit:key-down page (string #\Tab) 0)
    (darterfly/kit:key-down page " " 0)
    (is (eql 1 chosen))
    (darterfly/kit:key-down page (string #\Escape) 0)
    (is (eql :escape chosen))
    (darterfly/apps::journey-layout page "INSTALLING" "Busy" nil)
    (setf chosen nil)
    (darterfly/kit:key-down page (string #\Return) 0)
    (darterfly/kit:key-down page (string #\Escape) 0)
    (is (null chosen) "busy pages have no navigation actions")))
