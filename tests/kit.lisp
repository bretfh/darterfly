(test server-delivers-release-to-original-window
  (in-task ()
    (let* ((events (port))
           (window (test-server-window 1 10 100 100 400 300))
           (other (test-server-window 2 20 700 100 300 300))
           (client (make-instance 'darterfly/windowserver::client :port nil :context 50 :pid 10 :events events))
           (darterfly/windowserver::*windows* (list window other))
           (darterfly/windowserver::*clients* (list client))
           (darterfly/windowserver::*focused-window* window)
           (darterfly/windowserver::*framebuffer* nil)
           (darterfly/windowserver::*capture* nil)
           (darterfly/windowserver::*damage* nil)
           (darterfly/windowserver::*drag* nil))
      (setf (darterfly/windowserver::window-context window) 50)
      (darterfly/windowserver::pointer-down 200 200)
      (is (eq :left-mouse-down (server:event-type (mach:msgh-body (mach:mach-msg-receive events :timeout 100)))))
      (darterfly/windowserver::pointer-up 800 200)
      (let ((event (mach:msgh-body (mach:mach-msg-receive events :timeout 100))))
        (is (eq :left-mouse-up (server:event-type event)))
        (is (= 1 (server:event-value event :window)))
        (is (equal '(700 100) (server:event-window-location event)))))))

(test setup-focus-matches-default-action
  (let* ((window (darterfly/kit:make-window :width 600 :height 380))
         (page (make-instance 'darterfly/apps::journey-page :frame #(0 0 576 328))))
    (darterfly/kit:add-subview (darterfly/kit:content-view window) page)
    (darterfly/apps::setup-page page (darterfly/apps::default-desktop-preferences))
    (let ((buttons (darterfly/apps::journey-buttons page)))
      (is (eq (car (last buttons)) (darterfly/kit:first-responder window)))
      (is (= 1 (count-if #'darterfly/kit:focused-p buttons)))
      (is (string= "Continue" (darterfly/kit:title (darterfly/kit:first-responder window)))))))

(test retiring-context-releases-its-rights
  (in-task ()
    (let* ((connection (port))
           (events (mach:mach-port-allocate mach:*task* :receive))
           (context (make-instance 'layer:context :id 42 :port connection :events events)))
      (layer:context-destroy context)
      (is (equal '(:receive) (mach:mach-port-type mach:*task* connection)))
      (fails-with :kern-invalid-name (mach:mach-port-type mach:*task* events)))))

(defun ui-luminance (color)
  (loop for i below 3 for weight in '(0.2126 0.7152 0.0722)
        for value = (aref color i)
        sum (* weight (if (<= value 0.04045) (/ value 12.92)
                         (expt (/ (+ value 0.055) 1.055) 2.4)))))

(test command-labels-retain-contrast-on-hover
  (dolist (roles '((:button-top :ink :secondary) (:primary-top :light-ink :primary)
                   (:caution-top :light-ink :caution) (:danger-top :light-ink :danger)))
    (destructuring-bind (surface ink role) roles
      (dolist (hover '(nil t))
        (let* ((face (darterfly/kit:theme-color surface))
               (face (if hover (darterfly/kit::tint-color face (if (eq role :secondary) 0.035 0.02)) face))
               (a (ui-luminance face)) (b (ui-luminance (darterfly/kit:theme-color ink))))
          (is (>= (/ (+ (max a b) 0.05) (+ (min a b) 0.05)) 4.5) "~a hover=~a" role hover))))))

