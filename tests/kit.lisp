    (setf (darterfly/kit::dirty (darterfly/kit::frame-view window)) nil)
    (darterfly/kit::window-frame-changed window '(70 60 610 310))
    (is (= 0 (layout-calls page)))
    (is (= 70 (darterfly/kit::window-x window)))
    (is (= 60 (darterfly/kit::window-y window)))
    (is (not (darterfly/kit::dirty (darterfly/kit::frame-view window))))
    (darterfly/kit::window-frame-changed window '(70 60 760 390))
    (is (= 1 (layout-calls page)))
    (is (equalp #(0 0 760 364) (darterfly/kit:view-frame page)))))

(test checkbox-pointer-cancel-disabled-and-keyboard
  (let* ((calls 0)
         (control (make-instance 'darterfly/kit:checkbox :frame #(0 0 200 26)
                                :action (lambda (sender) (declare (ignore sender)) (incf calls)))))
    (darterfly/kit:mouse-down control 100 10)
    (darterfly/kit:mouse-up control 220 10)
    (is (not (darterfly/kit:checked-p control)))
    (is (= 0 calls))
    (darterfly/kit:mouse-down control 100 10)
    (darterfly/kit:mouse-up control 100 10)
    (is (darterfly/kit:checked-p control))
    (is (= 1 calls))
    (darterfly/kit:key-down control " " 57)
    (is (darterfly/kit:checked-p control) "Space waits for release")
    (darterfly/kit:key-up control " " 57)
