(test framebuffer-handoff-honors-pitch-and-depth
  (dolist (depth '(24 32))
    (let* ((bytes (make-array 32 :element-type '(unsigned-byte 8) :initial-element 222))
           (pixel-bytes (/ depth 8)))
      (loop for y below 2 do (loop for x below 2 do
        (let ((at (+ (* y 16) (* x pixel-bytes))))
          (setf (aref bytes at) (+ 10 x) (aref bytes (+ at 1)) (+ 20 y) (aref bytes (+ at 2)) 30))))
      (sb-sys:with-pinned-objects (bytes)
        (let* ((fb (make-instance 'darterfly/io:framebuffer :width 2 :height 2 :stride 16
                                 :depth depth :sap (sb-sys:vector-sap bytes)))
               (capture (darterfly/io:capture-framebuffer fb)))
          (is (= #xff1e140a (aref capture 0)))
          (is (= #xff1e140b (aref capture 1)))
          (is (= #xff1e150a (aref capture 2)))
          (is (= #xff1e150b (aref capture 3))))))))

(test startup-readiness-needs-committed-shell-surfaces
  (let ((darterfly/windowserver::*windows* nil) (darterfly/windowserver::*clients* nil))
    (is (not (darterfly/windowserver::startup-desktop-ready-p)))
    (loop for level in '(-2147483623 20 23 24) for id from 1 do
      (let* ((window (test-server-window id 1 0 0 100 100 level))
             (client (make-instance 'darterfly/windowserver::client :port nil :context id :pid 1)))
        (setf (darterfly/windowserver::window-context window) id)
        (push window darterfly/windowserver::*windows*)
        (push client darterfly/windowserver::*clients*)
        (is (not (darterfly/windowserver::startup-desktop-ready-p)))
        (setf (darterfly/windowserver::root client) 1)))
    (is (darterfly/windowserver::startup-desktop-ready-p))))

(test resume-keeps-content-but-not-stale-menu-and-pointer-state
  (let* ((calls 0)
         (button (make-instance 'darterfly/kit:button :frame #(0 0 120 26)
                   :action (lambda (sender) (declare (ignore sender)) (incf calls)))))
    (darterfly/kit:mouse-down button 10 10)
    (darterfly/kit::resume-view button)
    (is (not (darterfly/kit::button-hovered button)))
    (darterfly/kit:mouse-up button 10 10)
    (is (zerop calls) "restoring a world must not execute an old mouse press")
    (dolist (level '(:main-menu :pop-up-menu))
      (is (not (darterfly/kit::resumable-window-p (darterfly/kit:make-window :level level)))))
    (is (darterfly/kit::resumable-window-p (darterfly/kit:make-window :level :normal)))
    (let ((frame (darterfly/kit::frame-view (darterfly/kit:make-window))))
      (setf (darterfly/kit::chrome-hover frame) :close (darterfly/kit::chrome-pressed frame) :close)
      (darterfly/kit::resume-view frame)
      (is (null (darterfly/kit::chrome-hover frame)))
      (is (null (darterfly/kit::chrome-pressed frame))))))

(test control-focus-paints-outside-without-changing-layout-or-hit-target
  (let* ((darterfly/text::*fonts-dir* (namestring (darterfly/image:asset "branding/fonts/")))
         (parent (make-instance 'darterfly/kit:view :frame #(0 0 300 100)))
         (button (make-instance 'darterfly/kit:button :frame #(20 20 100 26) :title "Continue")))
    (darterfly/kit:add-subview parent button)
    (dolist (focused '(nil t nil))
      (setf (darterfly/kit:focused-p button) focused)
      (darterfly/kit:needs-display button)
      (darterfly/kit::display parent)
      (is (equalp #(20 20 100 26) (darterfly/kit:view-frame button)))
      (is (equalp #(16d0 16d0 108d0 34d0) (darterfly/layer:layer-frame (darterfly/kit::view-layer button))))
      (is (not (eq button (first (darterfly/kit::view-at parent 18 30)))))
      (is (eq button (first (darterfly/kit::view-at parent 20 30)))))))

