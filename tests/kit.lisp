(test server-only-front-app-owns-menu
  (let* ((front (test-server-window 1 10 100 100 400 300))
         (active-menu (test-server-window 2 10 0 0 350 26 24))
         (orphan-menu (test-server-window 3 20 0 0 300 26 24))
         (background (test-server-window 4 30 0 0 1280 26 23))
         (desktop (test-server-window 5 40 0 0 1280 800 -2147483623))
         (desktop-menu (test-server-window 6 40 0 0 400 26 24))
         (darterfly/windowserver::*windows*
           (list orphan-menu active-menu desktop-menu background front desktop)))
    (is (darterfly/windowserver::visible-p background))
    (is (darterfly/windowserver::visible-p active-menu))
    (is (not (darterfly/windowserver::visible-p orphan-menu))
        "An app with no document windows must not overlay the front app's menu")
    (is (not (darterfly/windowserver::visible-p desktop-menu)))
    (setf (darterfly/windowserver::ordered front) nil)
    (is (darterfly/windowserver::visible-p desktop-menu))
    (is (not (darterfly/windowserver::visible-p active-menu)))
    (is (not (darterfly/windowserver::visible-p orphan-menu)))))

(test attached-menu-corners-preserve-straight-top
  (let* ((pixels (make-array 400 :element-type '(unsigned-byte 32) :initial-element #xff112233))
         (fb (make-instance 'darterfly/io:framebuffer :width 20 :height 20 :pixels pixels))
         (saved (darterfly/io:save-corners fb 2 2 16 16 4)))
    (darterfly/io:blend-rect fb 2 2 18 18 1.0 1.0 1.0 1.0)
    (darterfly/io:restore-corners fb 2 2 16 16 4 saved :top nil)
    (is (= #xffffffff (aref pixels (+ 2 (* 2 20)))))
    (is (= #xffffffff (aref pixels (+ 17 (* 2 20)))))
    (is (= #xff112233 (aref pixels (+ 2 (* 17 20)))))
    (is (= #xff112233 (aref pixels (+ 17 (* 17 20)))))))

(test view-geometry-is-owned-and-mutable
  (let* ((supplied #(0 0 610 284))
         (first (make-instance 'darterfly/kit:view :frame supplied))
         (second (make-instance 'darterfly/kit:view :frame supplied)))
    (is (not (eq supplied (darterfly/kit:view-frame first))))
    (is (not (eq (darterfly/kit:view-frame first) (darterfly/kit:view-frame second))))
    (darterfly/kit:resize-view first 720 400)
    (is (equalp #(0 0 610 284) supplied))
    (is (equalp supplied (darterfly/kit:view-frame second)))
    (setf (darterfly/kit:view-frame first) supplied)
    (darterfly/kit:resize-view first 800 500)
    (is (equalp #(0 0 610 284) supplied))
    (is (equalp #(0 0 800 500) (darterfly/kit:view-frame first)))))

(defclass layout-count-view (darterfly/kit:view)
  ((calls :initform 0 :accessor layout-calls)))
(defmethod darterfly/kit:resize-view :before ((view layout-count-view) width height)
  (declare (ignore width height))
  (incf (layout-calls view)))

(test position-only-window-events-do-not-relayout
  (let* ((window (darterfly/kit:make-window :width 610 :height 310 :content-insets #(0 26 0 0)))
         (page (make-instance 'layout-count-view :frame #(0 0 610 284))))
