(test image-blit-opaque-translucent-and-clipped
  (let* ((pixels (make-array 16 :element-type '(unsigned-byte 8)
                              :initial-contents '(12 24 36 255 0 0 0 0 64 32 16 128 200 100 50 255)))
         (out (make-array 16 :element-type '(unsigned-byte 32) :initial-element #xffffffff))
         (fb (make-instance 'darterfly/io:framebuffer :width 4 :height 4 :pixels out)))
    (darterfly/io:blit-image fb 1 1 2 2 pixels 2 2 1.0 '(0 0 4 4))
    (is (= #xff0c1824 (aref out 5)) "opaque pixels replace, with no destination leak")
    (is (= #xffffffff (aref out 6)) "transparent pixels preserve destination")
    (is (= #xffbf9f8f (aref out 9)) "premultiplied translucency still blends")
    (is (= #xffc86432 (aref out 10)))
    (fill out #xffffffff)
    (darterfly/io:blit-image fb 0 0 4 4 pixels 2 2 1.0 '(1 1 3 3))
    (is (= #xffffffff (aref out 0)) "scaled blit respects clip")
    (is (= #xff0c1824 (aref out 5)))
    (is (= #xffc86432 (aref out 10)))))

