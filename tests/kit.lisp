(test slider-clamps-cancels-and-obeys-keyboard
  (let ((control (make-instance 'darterfly/kit:slider :frame #(0 0 200 26) :value 50)))
    (darterfly/kit:mouse-down control 100 13)
    (darterfly/kit:mouse-moved control 1000 13)
    (is (= 100 (darterfly/kit:slider-value control)))
    (darterfly/kit:key-down control (string #\Escape) 1)
    (is (= 50 (darterfly/kit:slider-value control)))
    (darterfly/kit:mouse-up control 1000 13)
    (is (= 50 (darterfly/kit:slider-value control)) "release after cancellation must not change value")
    (darterfly/kit:key-down control "" 102)
    (is (= 0 (darterfly/kit:slider-value control)))
    (let ((darterfly/kit:*key-modifiers* '(:shift))) (darterfly/kit:key-down control "" 106))
    (is (= 10 (darterfly/kit:slider-value control)))
    (darterfly/kit:key-down control "" 107)
    (is (= 100 (darterfly/kit:slider-value control)))
    (setf (darterfly/kit:button-enabled control) nil)
    (darterfly/kit:key-down control "" 102)
    (is (= 100 (darterfly/kit:slider-value control)))))

(test entry-selection-history-clipboard-validation
  (let* ((submitted nil)
         (control (make-instance 'darterfly/kit:entry-field :string "Darter" :limit 12
                    :validator (lambda (value) (when (zerop (length value)) "Enter a name."))
                    :action (lambda (field) (setf submitted (darterfly/kit:string-value field)))))
         (other (make-instance 'darterfly/kit:entry-field)))
    (let ((darterfly/kit:*key-modifiers* '(:control)))
      (darterfly/kit:key-down control "" 30)
      (darterfly/kit:key-down control "" 46))
    (darterfly/kit:key-down control "Fly" 33)
    (is (string= "Fly" (darterfly/kit:string-value control)))
    (let ((darterfly/kit:*key-modifiers* '(:control)))
      (darterfly/kit:key-down control "" 44))
    (is (string= "Darter" (darterfly/kit:string-value control)))
    (let ((darterfly/kit:*key-modifiers* '(:control)))
      (darterfly/kit:key-down control "" 21)
      (darterfly/kit:key-down other "" 47))
    (is (string= "Fly" (darterfly/kit:string-value control)))
    (is (string= "Darter" (darterfly/kit:string-value other)))
    (darterfly/kit:key-down control "" 28)
    (is (string= "Fly" submitted))
    (darterfly/kit:key-down control "too long for this field" 20)
    (is (string= "Fly" (darterfly/kit:string-value control)))
    (let ((darterfly/kit:*key-modifiers* '(:control))) (darterfly/kit:key-down control "" 30))
    (darterfly/kit:key-down control "" 14)
    (darterfly/kit:key-down control "" 28)
