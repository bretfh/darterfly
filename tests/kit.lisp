(in-package #:darterfly/test)

(def-suite kit :in host)
(in-suite kit)

(test button-release-and-cancellation
  (let* ((calls 0)
         (button (make-instance 'darterfly/kit:button :frame #(0 0 120 26)
                    :action (lambda (sender) (declare (ignore sender)) (incf calls)))))
    (darterfly/kit:mouse-down button 10 10)
    (is (zerop calls) "press does not execute")
    (darterfly/kit:mouse-moved button 150 10)
    (darterfly/kit:mouse-up button 150 10)
    (is (zerop calls) "releasing outside cancels")
    (darterfly/kit:mouse-up button 10 10)
    (is (zerop calls) "a stray release cannot activate")
    (darterfly/kit:mouse-down button 10 10)
    (darterfly/kit:mouse-moved button 150 10)
    (darterfly/kit:mouse-moved button 10 10)
    (darterfly/kit:mouse-up button 10 10)
    (is (= 1 calls) "returning inside before release activates once")
    (darterfly/kit:mouse-down button 10 10)
    (darterfly/kit:key-down button (string #\Escape) 1)
    (darterfly/kit:mouse-up button 10 10)
    (is (= 1 calls) "Escape cancels a pointer press even when released inside")
    (darterfly/kit:mouse-down button 10 10)
    (setf (darterfly/kit:button-enabled button) nil)
    (darterfly/kit:mouse-up button 10 10)
    (is (= 1 calls) "disabling during a press cancels it")))

(test window-captures-original-control
  (let* ((calls 0) (window (darterfly/kit:make-window))
         (button (make-instance 'darterfly/kit:button :frame #(20 20 100 26)
                    :action (lambda (sender) (declare (ignore sender)) (incf calls)))))
    (darterfly/kit:add-subview (darterfly/kit:content-view window) button)
    (darterfly/kit::window-mouse-down window 40 65)
    (is (eq button (darterfly/kit::capture-view window)))
    (darterfly/kit::window-mouse-moved window 300 200)
    (is (not (darterfly/kit::button-hovered button)))
    (darterfly/kit::window-mouse-up window 300 200)
    (is (zerop calls))
    (is (null (darterfly/kit::capture-view window)))
    (darterfly/kit::window-mouse-down window 40 65)
    (darterfly/kit::window-active window nil)
    (darterfly/kit::window-mouse-up window 40 65)
    (is (zerop calls) "deactivation cancels a pending control press")))

(test keyboard-focus-skips-disabled-and-reverses
  (let* ((window (darterfly/kit:make-window))
         (one (make-instance 'darterfly/kit:button))
         (disabled (make-instance 'darterfly/kit:button :enabled nil))
         (two (make-instance 'darterfly/kit:button)))
    (dolist (view (list one disabled two)) (darterfly/kit:add-subview (darterfly/kit:content-view window) view))
    (darterfly/kit::window-key-down window (string #\Tab) 15)
    (is (eq one (darterfly/kit:first-responder window)))
    (darterfly/kit::window-key-down window (string #\Tab) 15)
    (is (eq two (darterfly/kit:first-responder window)))
    (is (not (darterfly/kit:focused-p one)))
    (let ((darterfly/kit:*key-modifiers* '(:shift)))
      (darterfly/kit::window-key-down window (string #\Tab) 15))
    (is (eq one (darterfly/kit:first-responder window)))
    (is (darterfly/kit:focused-p one))))

(test resizing-keeps-filling-content-attached
  (let* ((window (darterfly/kit:make-window :width 400 :height 300))
         (view (make-instance 'darterfly/kit:view :frame #(0 0 376 248))))
    (darterfly/kit:add-subview (darterfly/kit:content-view window) view)
    (darterfly/kit::window-frame-changed window '(40 44 800 600))
    (is (= 776 (darterfly/kit:view-width view)))
    (is (= 548 (darterfly/kit:view-height view)))
    (is (equalp #(0 0 800 600) (darterfly/kit:view-frame (darterfly/kit::frame-view window))))))

(defun test-server-window (id owner x y width height &optional (level 0))
  (let ((window (make-instance 'darterfly/windowserver::window :id id :owner owner :port nil)))
    (setf (darterfly/windowserver::window-x window) x (darterfly/windowserver::window-y window) y
          (darterfly/windowserver::window-width window) width (darterfly/windowserver::window-height window) height
          (darterfly/windowserver::window-level window) level (darterfly/windowserver::ordered window) t)
    window))

(test server-menu-dismissal-consumes-outside-click
  (let* ((normal (test-server-window 1 10 100 100 400 300))
         (popup (test-server-window 2 10 100 24 200 100 101))
         (darterfly/windowserver::*windows* (list popup normal))
         (darterfly/windowserver::*clients* nil)
         (darterfly/windowserver::*capture* nil)
         (darterfly/windowserver::*focused-window* normal)
         (darterfly/windowserver::*framebuffer* nil)
         (darterfly/windowserver::*damage* nil)
         (darterfly/windowserver::*drag* nil))
    (darterfly/windowserver::pointer-down 200 200)
    (is (not (darterfly/windowserver::ordered popup)))
    (is (null darterfly/windowserver::*capture*) "outside click cannot activate an underlying command")
    (darterfly/windowserver::pointer-down 200 200)
    (is (eq normal darterfly/windowserver::*capture*))
    (darterfly/windowserver::pointer-up 900 700)
    (is (null darterfly/windowserver::*capture*) "capture clears even when release is outside the window")))

(test server-focus-switch-dismisses-other-app-menus
  (let* ((old (test-server-window 1 10 100 100 400 300))
         (new (test-server-window 2 20 120 120 400 300))
         (popup (test-server-window 3 10 100 24 200 100 101))
         (darterfly/windowserver::*windows* (list new popup old))
         (darterfly/windowserver::*clients* nil)
         (darterfly/windowserver::*focused-window* old)
         (darterfly/windowserver::*framebuffer* nil)
         (darterfly/windowserver::*damage* nil))
    (darterfly/windowserver::update-focus)
    (is (eq new darterfly/windowserver::*focused-window*))
    (is (not (darterfly/windowserver::ordered popup)))))

(test server-zoom-restores-exact-frame
  (let* ((window (test-server-window 1 10 100 100 400 300))
         (darterfly/windowserver::*clients* nil)
         (darterfly/windowserver::*framebuffer* (make-instance 'darterfly/io:framebuffer :width 1280 :height 800)))
    (darterfly/windowserver::zoom-window window)
    (is (equal '(40 44 1240 684) (darterfly/windowserver::window-frame window)))
    (darterfly/windowserver::zoom-window window)
