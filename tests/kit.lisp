         (button (make-instance 'darterfly/kit:button
                    :action (lambda (sender) (declare (ignore sender)) (incf calls))))
         (other (make-instance 'darterfly/kit:button)))
    (darterfly/kit:add-subview (darterfly/kit:content-view window) button)
    (darterfly/kit:add-subview (darterfly/kit:content-view window) other)
    (darterfly/kit::set-key-focus window button t)
    (dotimes (i 5) (darterfly/kit:key-down button " " 57))
    (is (= 0 calls))
    (is (darterfly/kit::button-armed button))
    (darterfly/kit:key-up button " " 57)
    (is (= 1 calls))
    (darterfly/kit:key-up button " " 57)
    (is (= 1 calls) "A duplicate release cannot execute twice")
    (darterfly/kit:key-down button " " 57)
    (darterfly/kit:key-down button "" 1)
    (darterfly/kit:key-up button " " 57)
    (is (= 1 calls) "Escape cancels a held Space")
    (darterfly/kit:key-down button " " 57)
    (darterfly/kit::set-key-focus window other t)
    (darterfly/kit:key-up button " " 57)
    (is (= 1 calls) "Tab/focus loss cancels a held key")
    (darterfly/kit:key-down button " " 57)
    (setf (darterfly/kit:button-enabled button) nil)
    (darterfly/kit:key-up button " " 57)
    (is (= 1 calls) "Disable cancels a held key")))

