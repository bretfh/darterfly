(in-package #:finch/test)

(def-suite apfs :in all)
(in-suite apfs)

(defun apfs-volume ()
  (let* ((disk (gunzip-fixture "apfs-disk.img.gz" "apfs-host.img"))
         (part (find "7C3457EF-0000-11AA-AA11-00306543ECAC" (ioreg-media (finch-file "tests/media.txt"))
                     :test #'equal :key (lambda (m) (cdr (assoc "Content" (third m) :test #'string=)))))
         (base (cdr (assoc "Base" (third part) :test #'string=))))
    (first (apfs:container-volumes (apfs:open-container (apfs:file-device disk :offset base))))))

(defun file-type-bits (name)
  (cdr (assoc name '(("Directory" . #o040000) ("Regular File" . #o100000) ("Symbolic Link" . #o120000))
              :test #'string=)))

(test container-and-volume
  (let ((v (apfs-volume)))
    (is (equal "finch" (apfs:volume-name v)))
    (is (apfs:volume-case-insensitive-p v))
    (is (null (apfs:lookup v "/not/there")))))

(test files-match-tahoe
  (let ((v (apfs-volume)))
    (dolist (line (uiop:read-file-lines (finch-file "tests/apfs-files.txt")))
      (destructuring-bind (path type perms size ino nlink uid gid target md5)
          (uiop:split-string line :separator "|")
        (let ((id (apfs:lookup v path)))
          (is (eql (parse-integer ino) id) "~a: inode ~a, finch ~a" path ino id)
          (when id
            (let* ((i (apfs:inode v id))
                   (dir (string= type "Directory"))
                   (links (if dir (+ 2 (apfs:inode-nlink i)) (apfs:inode-nlink i))))
              (is (= (file-type-bits type) (logand (apfs:inode-mode i) #o170000)) "~a: type" path)
              (is (= (parse-integer perms :radix 8) (logand (apfs:inode-mode i) #o7777)) "~a: mode" path)
              (is (= (parse-integer nlink) links) "~a: links" path)
              (is (= (parse-integer uid) (apfs:inode-owner i)) "~a: owner" path)
              (is (= (parse-integer gid) (apfs:inode-group i)) "~a: group" path)
              (is (= (parse-integer size)
                     (cond (dir (* 32 links))
                           ((string= type "Symbolic Link") (length (sb-ext:string-to-octets (apfs:readlink v id) :external-format :utf-8)))
                           (t (apfs:inode-size i))))
                  "~a: size" path)
              (when (string= type "Symbolic Link")
                (is (equal target (apfs:readlink v id))))
              (unless (string= md5 "-")
                (is (equal md5 (string-downcase (format nil "~{~2,'0x~}" (coerce (sb-md5:md5sum-sequence (apfs:read-file v id)) 'list))))
                    "~a: contents" path)))))))))

(test directories-list
  (let* ((v (apfs-volume))
         (many (apfs:directory-entries v (apfs:lookup v "/many"))))
    (is (= 300 (length many)))
    (is (equal "file 7" (string-right-trim '(#\Newline) (map 'string #'code-char (apfs:read-file v (apfs:lookup v "/many/f7"))))))
    (is (equal "line 12345 of a" (map 'string #'code-char (apfs:read-file v (apfs:lookup v "/big.txt") :start (* 12345 47) :end (+ (* 12345 47) 15)))))))

(defun image-md5 (path)
  (with-open-file (s path :element-type '(unsigned-byte 8))
    (string-downcase (format nil "~{~2,'0x~}" (coerce (sb-md5:md5sum-stream s) 'list)))))

(defun text (s) (sb-ext:string-to-octets s :external-format :utf-8))

(defun newfs-entries ()
  (append (list '(:dir "System") '(:dir "System/Library")
                (list :file "System/Library/name" (text (format nil "finch~%")))
                (list :file "hello.txt" (text (format nil "hello from finch~%")))
                '(:symlink "link" "hello.txt")
                (list :file "big.txt" (text (with-output-to-string (s)
                                              (dotimes (i 20000) (format s "line ~5,'0d of a file finch wrote~%" i)))))
                (list :file "café.txt" (text (format nil "accent~%")))
                '(:dir "many"))
          (loop for i from 1 to 300 collect (list :file (format nil "many/f~d" i) (text (format nil "file ~d~%" i))))))

(defun newfs-image ()
  (apfs:newfs (merge-pathnames "newfs.img" (finch-file "build/")) :volume-name "finch" :entries (newfs-entries)))

(defun record-newfs ()
  (let* ((image (newfs-image))
         (verdict (tahoe:apfs-check image)))
    (with-open-file (s (finch-file "tests/apfs-newfs.txt") :direction :output :if-exists :supersede)
      (format s "md5 ~a~%~a" (image-md5 image) verdict))
    verdict))

(test newfs-was-judged-by-tahoe
  (let* ((lines (uiop:read-file-lines (finch-file "tests/apfs-newfs.txt")))
         (image (newfs-image))
         (listing (remove-if-not (lambda (l) (search "|" l)) lines)))
    (is (equal (first lines) (format nil "md5 ~a" (image-md5 image))))
    (is (find "** The container /dev/disk7 appears to be OK." lines :test #'search))
    (is (= 309 (length listing)))
    (dolist (e (newfs-entries))
      (destructuring-bind (kind path &optional content) e
        (let ((line (find (format nil "./~a|" path) listing :test (lambda (p l) (eql 0 (search p l))))))
          (is (not (null line)) "~a is missing in Tahoe's listing" path)
          (when line
            (destructuring-bind (name type perms size ino nlink uid gid target md5) (uiop:split-string line :separator "|")
              (declare (ignore name ino uid gid))
              (ecase kind
                (:dir (is (equal type "Directory")) (is (equal perms "755")))
                (:symlink (is (equal type "Symbolic Link")) (is (equal target content)) (is (equal nlink "1")))
                (:file (is (equal type "Regular File"))
                 (is (= (length content) (parse-integer size)))
                 (is (equal md5 (string-downcase (format nil "~{~2,'0x~}" (coerce (sb-md5:md5sum-sequence content) 'list)))))
                 (is (equal nlink "1")))))))))
    (let ((v (first (apfs:container-volumes (apfs:open-container (apfs:file-device image))))))
      (is (equal "finch" (apfs:volume-name v)))
      (is (= 300 (length (apfs:directory-entries v (apfs:lookup v "/many"))))))))

(defun put-file (path content)
  (let ((fd (finch/vfs:vfs-open path (list :access :wronly :creat t :trunc t) #o644)))
    (finch/vfs:vfs-write fd (text content))
    (finch/vfs:vfs-close fd)))

(defun big-text ()
  (let ((big (with-output-to-string (s) (dotimes (i 8000) (format s "finch line ~5,'0d~%" i)))))
    (replace big "PATCHED" :start1 4096)))

(defun write-image ()
  (let* ((image (newfs-image))
         (tick (* 1000000000 1791940000))
         (apfs:*clock* (lambda () (incf tick 1000)))
         (finch/vfs:*root* nil)
         (finch/vfs:*mounts* nil))
    (finch/vfs:vfs-mount (finch/vfs:make-ram-node :vdir #o755) "/")
    (finch/vfs:vfs-mkdir "/mnt" #o755)
    (multiple-value-bind (r w) (apfs:file-store image) (apfs:mount-writable r w "/mnt"))
    (finch/vfs:vfs-mkdir "/mnt/new" #o755)
    (put-file "/mnt/new/a.txt" (format nil "written by finch~%"))
    (put-file "/mnt/new/big.txt" (with-output-to-string (s) (dotimes (i 8000) (format s "finch line ~5,'0d~%" i))))
    (let ((fd (finch/vfs:vfs-open "/mnt/new/big.txt" (list :access :rdwr) 0)))
      (finch/vfs:vfs-write fd (text "PATCHED") 4096)
      (finch/vfs:vfs-close fd))
    (finch/vfs:vfs-symlink "a.txt" "/mnt/new/link")
    (finch/vfs:vfs-rename "/mnt/hello.txt" "/mnt/new/hello2.txt")
    (loop for i from 1 to 50 do (finch/vfs:vfs-unlink (format nil "/mnt/many/f~d" i)))
    (put-file "/mnt/System/Library/name" (format nil "finch rewrote this~%"))
    (finch/vfs:vnop-setattr (finch/vfs:namei "/mnt/new/a.txt") :mode #o600)
    (finch/vfs:vfs-mkdir "/mnt/gone" #o755)
    (finch/vfs:vfs-remove "/mnt/gone" t)
    image))

(defun record-write ()
  (let* ((image (write-image))
         (verdict (tahoe:apfs-check image)))
    (with-open-file (s (finch-file "tests/apfs-write.txt") :direction :output :if-exists :supersede)
      (format s "md5 ~a~%~a" (image-md5 image) verdict))
    verdict))

(defun md5-text (string)
  (string-downcase (format nil "~{~2,'0x~}" (coerce (sb-md5:md5sum-sequence (text string)) 'list))))

(test writes-were-judged-by-tahoe
  (let* ((lines (uiop:read-file-lines (finch-file "tests/apfs-write.txt")))
         (image (write-image))
         (listing (remove-if-not (lambda (l) (search "|" l)) lines)))
    (flet ((entry (path) (find (format nil "~a|" path) listing :test (lambda (p l) (eql 0 (search p l)))))
           (field (line n) (nth n (uiop:split-string line :separator "|"))))
      (is (equal (first lines) (format nil "md5 ~a" (image-md5 image))))
      (is (find "** The container /dev/disk7 appears to be OK." lines :test #'search))
      (is (= 263 (length listing)))
      (is (equal (md5-text (format nil "written by finch~%")) (field (entry "./new/a.txt") 9)))
      (is (equal "600" (field (entry "./new/a.txt") 2)))
      (is (equal (md5-text (big-text)) (field (entry "./new/big.txt") 9)))
      (is (equal (md5-text (format nil "finch rewrote this~%")) (field (entry "./System/Library/name") 9)))
      (is (equal "a.txt" (field (entry "./new/link") 8)))
      (is (equal (md5-text (format nil "hello from finch~%")) (field (entry "./new/hello2.txt") 9)))
      (is (null (entry "./hello.txt")))
      (is (null (entry "./many/f1")))
      (is (null (entry "./gone")))
      (is (entry "./many/f51")))))

(test update-root-keeps-what-is-not-the-system
  (let ((disk (merge-pathnames "update-root.img" (finch-file "build/"))))
    (apfs:newfs disk :volume-name "finch HD"
                     :entries (list '(:dir "Users") '(:dir "System")
                                    (list :file "Users/notes.txt" (text "mine")) (list :file "System/name" (text "old"))))
    (image:update-root disk (list '(:dir "System") '(:dir "System/Library")
                                  (list :file "System/name" (text "new system"))
                                  (list :file "System/Library/added" (text "added") #o100755)))
    (let* ((v (first (apfs:container-volumes (apfs:open-container (apfs:file-device disk)))))
           (read (lambda (path) (map 'string #'code-char (apfs:read-file v (apfs:lookup v path))))))
      (is (equal "mine" (funcall read "/Users/notes.txt")))
      (is (equal "new system" (funcall read "/System/name")))
      (is (equal "added" (funcall read "/System/Library/added")))
      (is (= #o100755 (apfs:inode-mode (apfs:inode v (apfs:lookup v "/System/Library/added"))))))))

(test update-root-rewrites-many-files-in-one-transaction
  (let ((disk (merge-pathnames "update-many.img" (finch-file "build/")))
        (files (lambda (tag) (cons '(:dir "many")
                                   (loop :for i :below 2000
                                         :collect (list :file (format nil "many/f~d" i) (text (format nil "~a ~d" tag i))))))))
    (apfs:newfs disk :size (* 64 1048576) :volume-name "finch HD" :entries '((:dir "Users")))
    (image:update-root disk (funcall files "first"))
    (image:update-root disk (funcall files "second"))
    (let* ((v (first (apfs:container-volumes (apfs:open-container (apfs:file-device disk)))))
           (read (lambda (path) (map 'string #'code-char (apfs:read-file v (apfs:lookup v path))))))
      (is (= 2000 (length (apfs:directory-entries v (apfs:lookup v "/many")))))
      (is (equal "second 1999" (funcall read "/many/f1999"))))
    (delete-file disk)))

(test a-free-queue-too-big-for-one-node-carries-over
  (let ((disk (merge-pathnames "carry.img" (finch-file "build/")))
        (finch/vfs:*root* nil)
        (finch/vfs:*mounts* nil))
    (apfs:newfs disk :size (* 64 1048576) :volume-name "finch HD" :entries '((:dir "Users")))
    (image:update-root disk (cons '(:dir "many") (loop :for i :below 2000
                                                       :collect (list :file (format nil "many/f~d" i) (make-array 5000 :element-type '(unsigned-byte 8) :initial-element (mod i 256))))))
    (finch/vfs:vfs-mount (finch/vfs:make-ram-node :vdir #o755) "/")
    (finch/vfs:vfs-mkdir "/mnt" #o755)
    (multiple-value-bind (r w) (apfs:file-store disk) (apfs:mount-writable r w "/mnt"))
    (apfs:with-batch
      (loop :for i :from 0 :below 2000 :by 2 :do (finch/vfs:vfs-unlink (format nil "/mnt/many/f~d" i))))
    (image:update-root disk (list (list :file "many/after" (text "still writable"))))
    (let* ((v (first (apfs:container-volumes (apfs:open-container (apfs:file-device disk)))))
           (read (lambda (path) (map 'string #'code-char (apfs:read-file v (apfs:lookup v path))))))
      (is (= 1001 (length (apfs:directory-entries v (apfs:lookup v "/many")))))
      (is (equal "still writable" (funcall read "/many/after"))))
    (delete-file disk)))
