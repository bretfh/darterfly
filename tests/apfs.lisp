(in-package #:darterfly/test)

(def-suite apfs :in host)
(in-suite apfs)

(defun text (s) (sb-ext:string-to-octets s :external-format :utf-8))

(defun newfs-entries ()
  (append (list '(:dir "System") '(:dir "System/Library")
                (list :file "System/Library/name" (text (format nil "darterfly~%")))
                (list :file "hello.txt" (text (format nil "hello from darterfly~%")))
                '(:symlink "link" "hello.txt")
                (list :file "big.txt" (text (with-output-to-string (s)
                                              (dotimes (i 20000) (format s "line ~5,'0d of a file darterfly wrote~%" i)))))
                (list :file "café.txt" (text (format nil "accent~%")))
                '(:dir "many"))
          (loop for i from 1 to 300 collect (list :file (format nil "many/f~d" i) (text (format nil "file ~d~%" i))))))

(defun newfs-image ()
  (apfs:newfs (merge-pathnames "newfs.img" (darterfly-file "build/")) :volume-name "darterfly" :entries (newfs-entries)))

(defun image-volume (image)
  (first (apfs:container-volumes (apfs:open-container (apfs:file-device image)))))

(defun file-text (v path)
  (let ((id (apfs:lookup v path)))
    (and id (sb-ext:octets-to-string (apfs:read-file v id) :external-format :utf-8))))

(test newfs-reads-back
  (let ((v (image-volume (newfs-image))))
    (is (equal "darterfly" (apfs:volume-name v)))
    (is (null (apfs:lookup v "/not/there")))
    (dolist (e (newfs-entries))
      (destructuring-bind (kind path &optional content) e
        (let ((id (apfs:lookup v (concatenate 'string "/" path))))
          (is (not (null id)) "~a is there" path)
          (when id
            (let ((mode (apfs:inode-mode (apfs:inode v id))))
              (ecase kind
                (:dir (is (= #o040755 mode) "~a: mode ~o" path mode))
                (:symlink (is (= #o120000 (logand mode #o170000))) (is (equal content (apfs:readlink v id))))
                (:file (is (= #o100000 (logand mode #o170000)))
                 (is (equalp content (apfs:read-file v id)) "~a: contents" path))))))))
    (is (= 300 (length (apfs:directory-entries v (apfs:lookup v "/many")))))
    (let ((start (* 12345 (length (text (format nil "line ~5,'0d of a file darterfly wrote~%" 0)))))
          (expected "line 12345 of a"))
      (is (equal expected (map 'string #'code-char
                              (apfs:read-file v (apfs:lookup v "/big.txt")
                                              :start start :end (+ start (length expected)))))))))

(defun put-file (path content)
  (let ((fd (darterfly/vfs:vfs-open path (list :access :wronly :creat t :trunc t) #o644)))
    (darterfly/vfs:vfs-write fd (text content))
    (darterfly/vfs:vfs-close fd)))

(defun big-text ()
  (let ((big (with-output-to-string (s) (dotimes (i 8000) (format s "darterfly line ~5,'0d~%" i)))))
    (replace big "PATCHED" :start1 4096)))

(defun write-image ()
  (let* ((image (newfs-image))
         (tick (* 1000000000 1791940000))
         (apfs:*clock* (lambda () (incf tick 1000)))
         (darterfly/vfs:*root* nil)
         (darterfly/vfs:*mounts* nil))
    (darterfly/vfs:vfs-mount (darterfly/vfs:make-ram-node :vdir #o755) "/")
    (darterfly/vfs:vfs-mkdir "/mnt" #o755)
    (multiple-value-bind (r w) (apfs:file-store image) (apfs:mount-writable r w "/mnt"))
    (darterfly/vfs:vfs-mkdir "/mnt/new" #o755)
    (put-file "/mnt/new/a.txt" (format nil "written by darterfly~%"))
    (put-file "/mnt/new/big.txt" (with-output-to-string (s) (dotimes (i 8000) (format s "darterfly line ~5,'0d~%" i))))
    (let ((fd (darterfly/vfs:vfs-open "/mnt/new/big.txt" (list :access :rdwr) 0)))
      (darterfly/vfs:vfs-write fd (text "PATCHED") 4096)
      (darterfly/vfs:vfs-close fd))
    (darterfly/vfs:vfs-symlink "a.txt" "/mnt/new/link")
    (darterfly/vfs:vfs-rename "/mnt/hello.txt" "/mnt/new/hello2.txt")
    (loop for i from 1 to 50 do (darterfly/vfs:vfs-unlink (format nil "/mnt/many/f~d" i)))
    (put-file "/mnt/System/Library/name" (format nil "darterfly rewrote this~%"))
    (darterfly/vfs:vnop-setattr (darterfly/vfs:namei "/mnt/new/a.txt") :mode #o600)
    (darterfly/vfs:vfs-mkdir "/mnt/gone" #o755)
    (darterfly/vfs:vfs-remove "/mnt/gone" t)
    image))

(test writes-read-back
  (let ((v (image-volume (write-image))))
    (is (equal (format nil "written by darterfly~%") (file-text v "/new/a.txt")))
    (is (= #o600 (logand #o7777 (apfs:inode-mode (apfs:inode v (apfs:lookup v "/new/a.txt"))))))
    (is (equal (big-text) (file-text v "/new/big.txt")))
    (is (equal (format nil "darterfly rewrote this~%") (file-text v "/System/Library/name")))
    (is (equal "a.txt" (apfs:readlink v (apfs:lookup v "/new/link"))))
    (is (equal (format nil "hello from darterfly~%") (file-text v "/new/hello2.txt")))
    (is (null (apfs:lookup v "/hello.txt")))
    (is (null (apfs:lookup v "/many/f1")))
    (is (null (apfs:lookup v "/gone")))
    (is (apfs:lookup v "/many/f51"))
    (is (= 250 (length (apfs:directory-entries v (apfs:lookup v "/many")))))))

(test newfs-over-a-used-container-leaves-nothing-of-it
  (let* ((image (write-image))
         (v (image-volume image)))
    (is (equal "00000000-0000-0000-0000-000000000002" (string-upcase (apfs:volume-uuid v))))
    (let ((apfs:*clock* (lambda () 1)))
      (multiple-value-bind (r w) (apfs:file-store image)
        (declare (ignore r))
        (dotimes (i 30)
          (let ((darterfly/vfs:*root* nil) (darterfly/vfs:*mounts* nil))
            (darterfly/vfs:vfs-mount (darterfly/vfs:make-ram-node :vdir #o755) "/")
            (darterfly/vfs:vfs-mkdir "/mnt" #o755)
            (multiple-value-bind (r2 w2) (apfs:file-store image) (apfs:mount-writable r2 w2 "/mnt"))
            (put-file (format nil "/mnt/churn~d" i) "x")))
        (apfs:newfs w :size (* 16 1048576) :volume-name "fresh" :volume-uuid "AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE"
                      :entries (list (list :file "new.txt" (text "new"))))))
    (let ((fresh (image-volume image)))
      (is (equal "AAAAAAAA-BBBB-4CCC-8DDD-EEEEEEEEEEEE" (string-upcase (apfs:volume-uuid fresh))) "the new volume is the one found")
      (is (equal "fresh" (apfs:volume-name fresh)))
      (is (null (apfs:lookup fresh "/new/a.txt")) "nothing of the old volume is visible"))))

(test update-root-keeps-what-is-not-the-system
  (let ((disk (merge-pathnames "update-root.img" (darterfly-file "build/"))))
    (apfs:newfs disk :volume-name "darterfly HD"
                     :entries (list '(:dir "Users") '(:dir "System")
                                    (list :file "Users/notes.txt" (text "mine")) (list :file "System/name" (text "old"))))
    (image:update-root disk (list '(:dir "System") '(:dir "System/Library")
                                  (list :file "System/name" (text "new system"))
                                  (list :file "System/Library/added" (text "added") #o100755)))
    (let* ((v (first (apfs:container-volumes (apfs:open-container (apfs:file-device disk)))))
           (read (lambda (path) (map 'string #'code-char (apfs:read-file v (apfs:lookup v path))))))
      (is (equal "mine" (funcall read "/Users/notes.txt")))
      (is (equal "new system" (funcall read "/System/name")))
      (is (equal "added" (funcall read "/System/Library/added")))
      (is (= #o100755 (apfs:inode-mode (apfs:inode v (apfs:lookup v "/System/Library/added"))))))))

(test update-root-rewrites-many-files-in-one-transaction
  (let ((disk (merge-pathnames "update-many.img" (darterfly-file "build/")))
        (files (lambda (tag) (cons '(:dir "many")
                                   (loop :for i :below 2000
                                         :collect (list :file (format nil "many/f~d" i) (text (format nil "~a ~d" tag i))))))))
    (apfs:newfs disk :size (* 64 1048576) :volume-name "darterfly HD" :entries '((:dir "Users")))
    (image:update-root disk (funcall files "first"))
    (image:update-root disk (funcall files "second"))
    (let* ((v (first (apfs:container-volumes (apfs:open-container (apfs:file-device disk)))))
           (read (lambda (path) (map 'string #'code-char (apfs:read-file v (apfs:lookup v path))))))
      (is (= 2000 (length (apfs:directory-entries v (apfs:lookup v "/many")))))
      (is (equal "second 1999" (funcall read "/many/f1999"))))
    (delete-file disk)))

(test a-free-queue-too-big-for-one-node-carries-over
  (let ((disk (merge-pathnames "carry.img" (darterfly-file "build/")))
        (darterfly/vfs:*root* nil)
        (darterfly/vfs:*mounts* nil))
    (apfs:newfs disk :size (* 64 1048576) :volume-name "darterfly HD" :entries '((:dir "Users")))
    (image:update-root disk (cons '(:dir "many") (loop :for i :below 2000
                                                       :collect (list :file (format nil "many/f~d" i) (make-array 5000 :element-type '(unsigned-byte 8) :initial-element (mod i 256))))))
    (darterfly/vfs:vfs-mount (darterfly/vfs:make-ram-node :vdir #o755) "/")
    (darterfly/vfs:vfs-mkdir "/mnt" #o755)
    (multiple-value-bind (r w) (apfs:file-store disk) (apfs:mount-writable r w "/mnt"))
    (apfs:with-batch
      (loop :for i :from 0 :below 2000 :by 2 :do (darterfly/vfs:vfs-unlink (format nil "/mnt/many/f~d" i))))
    (image:update-root disk (list (list :file "many/after" (text "still writable"))))
    (let* ((v (first (apfs:container-volumes (apfs:open-container (apfs:file-device disk)))))
           (read (lambda (path) (map 'string #'code-char (apfs:read-file v (apfs:lookup v path))))))
      (is (= 1001 (length (apfs:directory-entries v (apfs:lookup v "/many")))))
      (is (equal "still writable" (funcall read "/many/after"))))
    (delete-file disk)))

(test a-root-one-entry-too-full-splits
  (let* ((records (loop :for i :below 112 :collect (cons (apfs::octets (apfs::le i 8) (apfs::le 1 8)) (apfs::le i 16))))
         (nodes (apfs::pack-btree records :fixed t :key-size 16 :value-size 16 :info-flags #x12 :subtype #xb
                                          :physical t :xid 1 :next-oid (let ((n 100)) (lambda () (incf n))))))
    (is (not (apfs::fits-p records t t 16 16)))
    (is (= 3 (length nodes)))
    (is (= 112 (loop :for (nil level . node) :in nodes :when (zerop level) :sum (apfs::node-count (apfs::make-node node)))))))

(in-suite recovery)

(test a-full-container-says-no-space
  (let* ((image (apfs:newfs (merge-pathnames "full.img" (darterfly-file "build/")) :volume-name "full" :size (* 16 1048576)))
         (darterfly/vfs:*root* nil)
         (darterfly/vfs:*mounts* nil)
         (chunk (make-string 65536 :initial-element #\x)))
    (darterfly/vfs:vfs-mount (darterfly/vfs:make-ram-node :vdir #o755) "/")
    (darterfly/vfs:vfs-mkdir "/mnt" #o755)
    (multiple-value-bind (r w) (apfs:file-store image) (apfs:mount-writable r w "/mnt"))
    (let ((errno (handler-case (progn (loop for i from 0 below 400 do (put-file (format nil "/mnt/f~d" i) chunk)) :never-full)
                   (darterfly/vfs:vfs-error (e) (darterfly/vfs:vfs-errno e)))))
      (is (eq :enospc errno)))))

(test a-torn-commit-mounts-the-checkpoint-before-it
  (let* ((image (newfs-image))
         (tear nil)
         (darterfly/vfs:*root* nil)
         (darterfly/vfs:*mounts* nil))
    (darterfly/vfs:vfs-mount (darterfly/vfs:make-ram-node :vdir #o755) "/")
    (darterfly/vfs:vfs-mkdir "/mnt" #o755)
    (multiple-value-bind (r w) (apfs:file-store image)
      (apfs:mount-writable r (lambda (at octets)
                               (unless (and tear (not (member (apfs::object-type octets) '(1 #xc))))
                                 (funcall w at octets)))
                           "/mnt"))
    (put-file "/mnt/kept.txt" "made before the power went")
    (setf tear t)
    (put-file "/mnt/torn.txt" "never landed")
    (let ((v (image-volume image)))
      (is (equal "made before the power went" (file-text v "/kept.txt")))
      (is (null (apfs:lookup v "/torn.txt"))))
    (setf darterfly/vfs:*root* nil darterfly/vfs:*mounts* nil)
    (darterfly/vfs:vfs-mount (darterfly/vfs:make-ram-node :vdir #o755) "/")
    (darterfly/vfs:vfs-mkdir "/mnt" #o755)
    (multiple-value-bind (r w) (apfs:file-store image) (apfs:mount-writable r w "/mnt"))
    (put-file "/mnt/after.txt" "written after recovery")
    (let ((v (image-volume image)))
      (is (equal "written after recovery" (file-text v "/after.txt")))
      (is (equal "made before the power went" (file-text v "/kept.txt")))
      (is (equal (format nil "hello from darterfly~%") (file-text v "/hello.txt"))))))

(test a-container-of-any-size-takes-files
  (let* ((image (merge-pathnames "big-container.img" (darterfly-file "build/")))
         (size (* 20 1024 1048576))
         (blocks (/ size 4096)))
    (with-open-file (s image :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
      (file-position s (1- size))
      (write-byte 0 s))
    (apfs:newfs image :size size :volume-name "big")
    (let ((free (multiple-value-bind (r w) (apfs:file-store image) (apfs::nx-free (apfs:open-writable r w)))))
      (is (< (- blocks 30000) free blocks) "a fresh 20 GB container is nearly all free: ~d of ~d" free blocks)
      (let ((darterfly/vfs:*root* nil) (darterfly/vfs:*mounts* nil))
        (darterfly/vfs:vfs-mount (darterfly/vfs:make-ram-node :vdir #o755) "/")
        (darterfly/vfs:vfs-mkdir "/mnt" #o755)
        (multiple-value-bind (r w) (apfs:file-store image) (apfs:mount-writable r w "/mnt"))
        (put-file "/mnt/a.txt" (format nil "on a big disk~%"))
        (put-file "/mnt/b.txt" (make-string 300000 :initial-element #\b))
        (apfs::sync-volumes))
      (let ((after (multiple-value-bind (r w) (apfs:file-store image) (apfs::nx-free (apfs:open-writable r w)))))
        (is (< (- free 200) after (- free 70)) "the files take their blocks: ~d free before, ~d after" free after)))
    (let ((v (image-volume image)))
      (is (equal (format nil "on a big disk~%") (file-text v "/a.txt")))
      (is (= 300000 (length (file-text v "/b.txt")))))
    (delete-file image)))

(in-suite apfs)

(test repeated-directories-survive-edit-and-remount
  (let* ((image (merge-pathnames "duplicate-directories.img" (scratch)))
         (darterfly/vfs:*root* nil) (darterfly/vfs:*mounts* nil))
    (apfs:newfs image :entries (list '(:dir "tree") '(:dir "/tree/")
                                   (list :file "tree/child" (text "kept"))))
    (darterfly/vfs:vfs-mount (darterfly/vfs:make-ram-node :vdir #o755) "/")
    (darterfly/vfs:vfs-mkdir "/mnt" #o755)
    (multiple-value-bind (r w) (apfs:file-store image)
      (let* ((volume (apfs:mount-writable r w "/mnt"))
             (tree (apfs::nx-fs-tree (apfs::wvolume-nx volume)))
             (keys (loop for leaf across (apfs::tree-leaves tree)
                         append (coerce (apfs::leaf-keys leaf) 'list))))
        (is (= (length keys) (length (remove-duplicates keys :test #'equalp))))))
    (darterfly/vfs:vfs-unlink "/mnt/tree/child")
    (darterfly/vfs:vfs-remove "/mnt/tree" t)
    (multiple-value-bind (r w) (apfs:file-store image)
      (let ((volume (apfs::make-wvolume (apfs::open-writable r w))))
        (is (null (apfs::wlookup volume apfs::+root-dir-ino-num+ "tree")))))))

(test older-images-with-repeated-directories-remain-editable
  (let* ((image (merge-pathnames "legacy-directories.img" (scratch)))
         (darterfly/vfs:*root* nil) (darterfly/vfs:*mounts* nil))
    (sb-int:encapsulate 'apfs::unique-entries 'legacy-image
                        (lambda (original entries) (declare (ignore original)) entries))
    (unwind-protect
         (apfs:newfs image :entries (list '(:dir "tree") '(:dir "tree")
                                        (list :file "tree/child" (text "kept"))))
      (sb-int:unencapsulate 'apfs::unique-entries 'legacy-image))
    (darterfly/vfs:vfs-mount (darterfly/vfs:make-ram-node :vdir #o755) "/")
    (darterfly/vfs:vfs-mkdir "/mnt" #o755)
    (multiple-value-bind (r w) (apfs:file-store image) (apfs:mount-writable r w "/mnt"))
    (darterfly/vfs:vfs-unlink "/mnt/tree/child")
    (darterfly/vfs:vfs-remove "/mnt/tree" t)
    (multiple-value-bind (r w) (apfs:file-store image)
      (let* ((nx (apfs::open-writable r w))
             (keys (mapcar #'car (apfs::nx-fs-records nx))))
        (is (= (length keys) (length (remove-duplicates keys :test #'equalp))))
        (is (null (apfs::wlookup (apfs::make-wvolume nx) apfs::+root-dir-ino-num+ "tree")))))))

(test duplicate-files-are-refused-before-formatting
  (signals error
    (apfs::unique-entries '((:file "a" #(1)) (:file "/a/" #(2)))))
  (signals error (apfs::unique-entries '((:dir "a") (:file "a" #(1)))))
  (signals error (apfs::record-table (list (cons #(1) #(2)) (cons #(1) #(3))))))

(test legacy-duplicate-keys-across-leaves-are-rewritten-together
  (let* ((image (merge-pathnames "legacy-large-directories.img" (scratch)))
         (darterfly/vfs:*root* nil) (darterfly/vfs:*mounts* nil))
    (sb-int:encapsulate 'apfs::unique-entries 'legacy-image
                        (lambda (original entries) (declare (ignore original)) entries))
    (unwind-protect
         (apfs:newfs image :entries
                     (loop for i below 200 for dir = (format nil "dir~d" i)
                           append (list (list :dir dir) (list :dir dir)
                                        (list :file (concatenate 'string dir "/child") (text "kept")))))
      (sb-int:unencapsulate 'apfs::unique-entries 'legacy-image))
    (darterfly/vfs:vfs-mount (darterfly/vfs:make-ram-node :vdir #o755) "/")
    (darterfly/vfs:vfs-mkdir "/mnt" #o755)
    (multiple-value-bind (r w) (apfs:file-store image) (apfs:mount-writable r w "/mnt"))
    (darterfly/vfs:vfs-unlink "/mnt/dir100/child")
    (darterfly/vfs:vfs-remove "/mnt/dir100" t)
    (multiple-value-bind (r w) (apfs:file-store image)
      (let* ((nx (apfs::open-writable r w))
             (keys (mapcar #'car (apfs::nx-fs-records nx)))
             (volume (apfs::make-wvolume nx)))
        (is (= (length keys) (length (remove-duplicates keys :test #'equalp))))
        (is (= 199 (length (apfs::wentries volume apfs::+root-dir-ino-num+))))
        (is (null (apfs::wlookup volume apfs::+root-dir-ino-num+ "dir100")))))))

(test open-unlinked-files-retain-data-until-last-close
  (let* ((disk (darterfly-file "build/apfs-open-unlink.img"))
         (darterfly/vfs:*root* nil) (darterfly/vfs:*mounts* nil)
         (darterfly/vfs::*files* (make-hash-table))
         (darterfly/apfs::*syncer* nil)
         (volume nil))
    (apfs:newfs disk :entries nil)
    (darterfly/vfs:vfs-mount (darterfly/vfs:make-ram-node :vdir #o755) "/")
    (darterfly/vfs:vfs-mkdir "/mnt" #o755)
    (multiple-value-bind (read write) (apfs:file-store disk)
      (setf volume (apfs:mount-writable read write "/mnt")))
    (let* ((fd (darterfly/vfs:vfs-open "/mnt/temp" '(:access :rdwr :creat t) #o600))
           (other (darterfly/vfs:vfs-open "/mnt/temp" '(:access :rdwr) 0))
           (dup (darterfly/vfs::vfs-dup fd))
           (id (darterfly/vfs:vnode-id (darterfly/vfs:fd-vnode fd))))
      (darterfly/vfs:vfs-write fd (text "before"))
      (darterfly/vfs:vfs-unlink "/mnt/temp")
      (signals darterfly/vfs:vfs-error (darterfly/vfs:vfs-stat "/mnt/temp"))
      (is (zerop (darterfly/vfs:vattr-nlink (darterfly/vfs:vfs-fstat fd))))
      (darterfly/vfs:vfs-write fd (text "after"))
      (darterfly/vfs:vfs-close fd)
      (is (equalp (text "beforeafter") (darterfly/vfs:vfs-read other 11)))
      (darterfly/vfs:vfs-close other)
      (is (= 11 (darterfly/vfs:vfs-lseek dup 0 2)))
      (darterfly/vfs:vfs-write dup (text "!"))
      (is (equalp (text "beforeafter!") (darterfly/vfs:vfs-read dup 12 0)))
      (let* ((target (darterfly/vfs:vfs-open "/mnt/dup-target" '(:access :rdwr :creat t) #o600))
             (target-id (darterfly/vfs:vnode-id (darterfly/vfs:fd-vnode target))))
        (darterfly/vfs:vfs-unlink "/mnt/dup-target")
        (is (= dup (darterfly/vfs::vfs-dup2 dup dup)))
        (is (= target (darterfly/vfs::vfs-dup2 dup target)))
        (is (null (gethash target-id (apfs::wvolume-by-id volume))))
        (darterfly/vfs:vfs-close dup)
        (is (equalp (text "beforeafter!") (darterfly/vfs:vfs-read target 12 0)))
        (darterfly/vfs:vfs-close target))
      (is (null (gethash id (apfs::wvolume-by-id volume)))))
    ;; Atomic replacement must preserve the old target through its open FD.
    (put-file "/mnt/source" "new") (put-file "/mnt/target" "old")
    (let ((old (darterfly/vfs:vfs-open "/mnt/target" '(:access :rdonly) 0)))
      (darterfly/vfs:vfs-rename "/mnt/source" "/mnt/target")
      (is (equalp (text "old") (darterfly/vfs:vfs-read old 3)))
      (is (zerop (darterfly/vfs:vattr-nlink (darterfly/vfs:vfs-fstat old))))
      (darterfly/vfs:vfs-close old))
    (is (equal "new" (file-text (image-volume disk) "/target")))
    ;; Simulate power loss after unlink has committed, before final close.
    (let* ((fd (darterfly/vfs:vfs-open "/mnt/orphan" '(:access :rdwr :creat t) #o600))
           (id (darterfly/vfs:vnode-id (darterfly/vfs:fd-vnode fd))))
      (darterfly/vfs:vfs-write fd (make-array 8192 :element-type '(unsigned-byte 8)
                                                :initial-element 42))
      (darterfly/vfs:vfs-unlink "/mnt/orphan")
      (is (not (null (gethash id (apfs::wvolume-by-id volume)))))
      ;; Discard the old descriptor table; never close against the old mount.
      (setf darterfly/vfs::*files* (make-hash-table))
      (multiple-value-bind (read write) (apfs:file-store disk)
        (setf volume (apfs:mount-writable read write "/mnt")))
      (is (null (gethash id (apfs::wvolume-by-id volume))))
      (is (equal "new" (file-text (image-volume disk) "/target")))
      (signals darterfly/vfs:vfs-error (darterfly/vfs:vfs-stat "/mnt/orphan"))))
  (format t "~&[APFS OPEN UNLINK REPLACEMENT REMOUNT PASS]~%"))


(test retained-volume-adopts-old-descriptor-lifetimes
  (let* ((disk (darterfly-file "build/apfs-adoption.img"))
         (darterfly/vfs:*root* nil) (darterfly/vfs:*mounts* nil)
         (darterfly/vfs::*files* (make-hash-table))
         (darterfly/vfs::*file-lifetime-version* 1)
         (apfs::*open-inodes* (make-hash-table :test 'eq :weakness :key))
         (apfs::*syncer* nil) (volume nil))
    (apfs:newfs disk :entries nil)
    (darterfly/vfs:vfs-mount (darterfly/vfs:make-ram-node :vdir #o755) "/")
    (darterfly/vfs:vfs-mkdir "/mnt" #o755)
    (multiple-value-bind (r w) (apfs:file-store disk)
      (setf volume (apfs:mount-writable r w "/mnt")))
    (let* ((fd (darterfly/vfs:vfs-open "/mnt/kept" '(:access :rdwr :creat t) #o600))
           (file (darterfly/vfs::fd-file fd))
           (node (darterfly/vfs:fd-vnode fd))
           (other (darterfly/vfs:vfs-open "/mnt/kept" '(:access :rdonly) 0))
           (dup (darterfly/vfs::vfs-dup fd))
           (id (darterfly/vfs:vnode-id node)))
      (darterfly/vfs:vfs-write fd (text "kept"))
      ;; The old implementation duplicated the table entry without incrementing
      ;; FILE-REFS and did not maintain per-inode counts.
      (setf (darterfly/vfs::file-refs file) 1)
      (clrhash apfs::*open-inodes*)
      (is (= 2 (getf (apfs::adopt-open-files) :descriptions)))
      (is (= 2 darterfly/vfs::*file-lifetime-version*))
      (is (eq volume (apfs::vnode-mount node)))
      (is (= 2 (darterfly/vfs::file-refs file)))
      (is (= 2 (gethash id (apfs::wvolume-opens volume))))
      (apfs::adopt-open-files)
      (is (= 2 (gethash id (apfs::wvolume-opens volume))) "adoption is idempotent")
      (darterfly/vfs:vfs-unlink "/mnt/kept")
      (darterfly/vfs:vfs-close fd)
      (is (equalp (text "kept") (darterfly/vfs:vfs-read other 4)))
      (darterfly/vfs:vfs-close other)
      (is (= 1 (gethash id (apfs::wvolume-opens volume))))
      (darterfly/vfs:vfs-write dup (text "!"))
      (is (equalp (text "kept!") (darterfly/vfs:vfs-read dup 5 0)))
      (darterfly/vfs:vfs-close dup)
      (is (null (gethash id (apfs::wvolume-by-id volume))))
      (is (zerop (hash-table-count (apfs::wvolume-opens volume)))))))
