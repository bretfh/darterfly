(in-package #:finch/test)

(def-suite objc :in all)
(in-suite objc)

(defparameter +appkit+ "/System/Library/Frameworks/AppKit.framework/Versions/C/AppKit")

(defun nm-methods (file)
  (let ((by-name (make-hash-table :test 'equal))
        (by-address (make-hash-table)))
    (dolist (line (uiop:split-string (sh "llvm-nm" "--no-dyldinfo" "--defined-only" file)
                                     :separator '(#\Newline))
                  (values by-name by-address))
      (let ((at (position #\[ line))
            (address (and (> (length line) 16) (parse-integer line :end 16 :radix 16 :junk-allowed t))))
        (when address
          (setf (gethash address by-address) t))
        (when (and address at (> at 1) (member (char line (1- at)) '(#\- #\+))
                   (char= #\] (char line (1- (length line)))))
          (let* ((space (position #\Space line :start at))
                 (class (subseq line (1+ at) space))
                 (key (list (char line (1- at)) (subseq class 0 (position #\( class))
                            (subseq line (1+ space) (1- (length line))))))
            (push address (gethash key by-name))
            (setf (gethash address by-address) key)))))))

(test appkit-methods-match-the-symbols
  (with-tahoe
    (multiple-value-bind (by-name by-address)
        (nm-methods (namestring (dyld:extract-image (cache) +appkit+ (merge-pathnames "AppKit" (scratch)))))
      (let* ((image (objc:image-objc (cache) +appkit+))
             (text (first (macho:segments (dyld:image-macho (cache) +appkit+))))
             (low (macho:segment-vmaddr text))
             (high (+ low (macho:segment-vmsize text)))
            (confirmed 0) (unchecked 0) (wrong 0) (first nil))
        (dolist (c (objc:objc-image-classes image))
          (loop :for (kind methods) :in `((#\- ,(objc:class-instance-methods c))
                                          (#\+ ,(objc:class-class-methods c)))
                :do (dolist (m methods)
                      (let* ((k (list kind (objc:class-name c) (objc:method-selector m)))
                             (imps (gethash k by-name))
                             (there (gethash (objc:method-imp m) by-address)))
                        (cond ((not (< low (objc:method-imp m) high)))
                              ((member (objc:method-imp m) imps) (incf confirmed))
                              ((consp there)
                               (incf wrong)
                               (setf first (or first (list k (objc:method-imp m) there))))
                              (t (incf unchecked)))))))
        (is (< 50000 confirmed))
        (is (zerop wrong) "~d methods disagree with the symbols, first ~s" wrong first)
        (is (< unchecked (/ confirmed 20)) "~d unchecked against ~d confirmed" unchecked confirmed)))))

(test appkit-nswindow
  (with-tahoe
    (let* ((image (objc:image-objc (cache) +appkit+))
           (w (find "NSWindow" (objc:objc-image-classes image) :key #'objc:class-name :test #'equal)))
      (is (string= "NSResponder" (objc:class-superclass w)))
      (is (member "NSWindowDelegate" (mapcar #'objc:protocol-name (objc:objc-image-protocols image))
                  :test #'equal))
      (is (find "_frameSaveName" (objc:class-ivars w) :key #'objc:ivar-name :test #'equal))
      (is (find "setTitle:" (objc:class-instance-methods w) :key #'objc:method-selector :test #'equal))
      (is (member "NSUserInterfaceValidations" (objc:class-protocols w) :test #'equal))
      (is (find "v24@0:8@16" (objc:class-instance-methods w) :key #'objc:method-types :test #'equal)))))
