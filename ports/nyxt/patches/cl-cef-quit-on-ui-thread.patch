+
+// Wait for all asynchronous browser closes before stopping the event loop.
+// Drop CEF references on its UI thread, before CefShutdown tears CEF down.
+void FinishShutdown() {
+  if (!g_quit_requested || !g_browser_to_view.empty())
+    return;
+  decltype(g_views) views;
+  decltype(g_windows) windows;
+  {
+    std::lock_guard<std::mutex> lock(g_mu);
+    views.swap(g_views);
+    windows.swap(g_windows);
+  }
+  // Destructors may call back into the bridge: do not hold g_mu here.
+  views.clear();
+  windows.clear();
+  g_download_callbacks.clear();
+  g_menu = nullptr;
+  CefQuitMessageLoop();
+}
+
+void RequestShutdown() {
+  if (g_quit_requested)
+    return;
+  g_quit_requested = true;
+  // Nyxt discards its browser state as soon as termination is requested.
+  g_event_cb.store(nullptr);
+  std::vector<int> views;
+  std::vector<CefRefPtr<CefWindow>> windows;
+  {
+    std::lock_guard<std::mutex> lock(g_mu);
+    for (const auto& entry : g_views) {
+      views.push_back(entry.first);
+    }
+    for (const auto& entry : g_windows) {
+      if (entry.second->window)
+        windows.push_back(entry.second->window);
+    }
+  }
+  for (const auto& window : windows)
+    window->Close();
+  for (int id : views)
+    cl_cef_view_destroy(id);
+  CefPostTask(TID_UI, new ClosureTask(FinishShutdown));
 }
 
