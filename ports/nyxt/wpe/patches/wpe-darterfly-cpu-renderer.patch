@@ -146,6 +146,12 @@
 
 void WebProcess::initializePlatformDisplayIfNeeded() const
 {
+#if OS(DARTERFLY)
+    // CPU Skia uses shared bitmaps and needs no GL platform display.
+    // Do not ask Epoxy to load an EGL implementation that is not present.
+    ProcessCapabilities::setCanUseAcceleratedBuffers(false);
+    return;
+#endif
     if (PlatformDisplay::sharedDisplayIfExists())
         return;
 
