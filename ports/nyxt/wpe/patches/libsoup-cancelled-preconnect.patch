--- a/libsoup/soup-session.c
+++ b/libsoup/soup-session.c
@@ -1734,6 +1734,15 @@
                 return FALSE;
 
         if (!preconnect_item->connect_only || preconnect_item->state != SOUP_MESSAGE_CONNECTING)
+                return FALSE;
+
+        /* Cancellation can precede the async connect completion. In particular,
+         * rejecting a preconnect certificate cancels its GCancellable while
+         * the connection still appears to be CONNECTING. Do not hand that
+         * failed operation to a real request: it must make its own connection
+         * and receive its own certificate decision, not G_IO_ERROR_CANCELLED.
+         */
+        if (g_cancellable_is_cancelled (preconnect_item->cancellable))
                 return FALSE;
 
         soup_message_transfer_connection (preconnect_item->msg, item->msg);
