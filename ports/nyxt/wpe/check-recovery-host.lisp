;;;; Deterministic policy and transport bounds, independent of a live browser.
(require :asdf)
(asdf:load-system :darterfly/test)
(load "ports/nyxt/wpe/nyxt-wire.lisp")
(in-package #:darterfly/test)
(let* ((plist (darterfly/apps::world-job
                "/System/Applications/Nyxt.app/Contents/Programs/Nyxt" '(:memory 2048)))
       (job (make-instance 'darterfly/init:job :label "Nyxt"
                          :program nil :arguments nil :plist plist)))
  (assert (eq :leave (darterfly/init:decide job :exit '(:exit 0))))
  (dotimes (n 3)
    (push (list :time (get-universal-time) :exit 1) (darterfly/init::exits job))
    (assert (eq (if (= n 2) :give-up :restart)
                (darterfly/init:decide job :exit '(:exit 1)))))
  (setf (darterfly/init::removing job) t)
  (assert (eq :leave (darterfly/init:decide job :exit '(:exit 1)))))
(format t "~&[NYXT RECOVERY POLICY PASS]~%")
(in-package #:darterfly/nyxt-wire)
(let ((original (symbol-function 'raw-io))
      (*io-timeout* .03))
  (unwind-protect
       (labels ((timed-out (function)
                  (let ((start (get-internal-real-time)) (failed nil))
                    (handler-case (funcall function) (error () (setf failed t)))
                    (assert failed)
                    (assert (< (- (get-internal-real-time) start)
                               (* 2 internal-time-units-per-second))))))
         ;; A peer that never drains its socket must not hold a writer forever.
         (setf (symbol-function 'raw-io)
               (lambda (&rest args) (declare (ignore args)) (values -1 11)))
         (timed-out (lambda () (send-packet (make-connection :fd 1 :root t) 18 0)))
         ;; A truncated header must not leave the event reader waiting forever.
         (let ((first t))
           (setf (symbol-function 'raw-io)
             (lambda (c v start end writep)
               (declare (ignore c end writep))
               (if first (progn (setf first nil (aref v start) 1) 1)
                   (values -1 11))))
           (timed-out (lambda () (receive-packet (make-connection :fd 1 :root t)))))
         ;; Reply body shares the header's deadline; it gets no fresh timeout.
         (let ((header (words 1000 0 1 0 0 4)))
           (setf (symbol-function 'raw-io)
             (lambda (c v start end writep)
               (declare (ignore c end writep))
               (if header (prog1 24 (replace v header :start1 start) (setf header nil))
                   (values -1 11))))
           (timed-out (lambda () (receive-packet (make-connection :fd 1 :root t)))))
         (let ((c (make-connection :fd 1 :root t)))
           (cancel-connection c)
           (timed-out (lambda () (receive-packet c))))
         ;; Writer contention itself is bounded, before any socket transfer.
         (let* ((c (make-connection :fd 1 :root t))
                (locked nil)
                (thread (sb-thread:make-thread
                          (lambda () (sb-thread:with-mutex ((connection-lock c))
                                       (setf locked t) (sleep .2))))))
           (loop until locked do (sleep .001))
           (timed-out (lambda () (send-packet c 18 0)))
           (sb-thread:join-thread thread)))
    (setf (symbol-function 'raw-io) original)))
(format t "~&[NYXT RECOVERY TRANSPORT BOUNDS PASS]~%")
