;;;; Bounded work queues. Workers execute outside the queue lock.
(defpackage #:darterfly/nyxt-work
  (:use #:cl)
  (:export #:make-queue #:enqueue #:take #:discard #:close-queue #:snapshot))
(in-package #:darterfly/nyxt-work)
(defstruct (queue (:constructor make-queue (&key (limit 128) (byte-limit (* 2 1024 1024)) coalesce)))
  (limit 128) (byte-limit (* 2 1024 1024)) coalesce
  (lock (sb-thread:make-mutex :name "Nyxt work"))
  (wait (sb-thread:make-waitqueue)) closed
  (items nil) (bytes 0) (peak-count 0) (peak-bytes 0)
  (coalesced 0) (evicted 0))
(defun discard-locked (queue key)
  (setf (queue-items queue)
    (delete-if (lambda (item)
                 (when (eql key (first item))
                   (decf (queue-bytes queue) (second item)) t))
               (queue-items queue))))
(defun discard (queue key)
  (sb-thread:with-mutex ((queue-lock queue)) (discard-locked queue key)))
(defun enqueue (queue key function &optional (bytes 0))
  (sb-thread:with-mutex ((queue-lock queue))
    (when (queue-closed queue) (return-from enqueue nil))
    (unless (<= 0 bytes (queue-byte-limit queue)) (error "Nyxt work item too large"))
    (when (and (queue-coalesce queue) (assoc key (queue-items queue)))
      (incf (queue-coalesced queue)) (discard-locked queue key))
    (loop while (or (>= (length (queue-items queue)) (queue-limit queue))
                    (> (+ (queue-bytes queue) bytes) (queue-byte-limit queue)))
          do (unless (queue-coalesce queue) (error "Nyxt callback queue full"))
             (decf (queue-bytes queue) (second (pop (queue-items queue))))
             (incf (queue-evicted queue)))
    (setf (queue-items queue)
          (nconc (queue-items queue) (list (list key bytes function))))
    (incf (queue-bytes queue) bytes)
    (setf (queue-peak-count queue) (max (queue-peak-count queue) (length (queue-items queue)))
          (queue-peak-bytes queue) (max (queue-peak-bytes queue) (queue-bytes queue)))
    (sb-thread:condition-notify (queue-wait queue)) t))
(defun take (queue)
  (sb-thread:with-mutex ((queue-lock queue))
    (loop until (or (queue-closed queue) (queue-items queue))
          do (sb-thread:condition-wait (queue-wait queue) (queue-lock queue)))
    (unless (queue-closed queue)
      (let ((item (pop (queue-items queue))))
        (decf (queue-bytes queue) (second item)) (third item)))))
(defun close-queue (queue)
  (sb-thread:with-mutex ((queue-lock queue))
    (setf (queue-closed queue) t (queue-items queue) nil (queue-bytes queue) 0)
    (sb-thread:condition-broadcast (queue-wait queue))))
(defun snapshot (queue)
  (sb-thread:with-mutex ((queue-lock queue))
    (list :count (length (queue-items queue)) :bytes (queue-bytes queue)
          :peak-count (queue-peak-count queue) :peak-bytes (queue-peak-bytes queue)
          :coalesced (queue-coalesced queue) :evicted (queue-evicted queue)
          :closed (queue-closed queue))))
