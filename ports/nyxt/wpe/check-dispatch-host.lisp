(load "ports/nyxt/wpe/nyxt-work.lisp")
(in-package #:darterfly/nyxt-work)
;; FIFO order, accounting, rejection without losing accepted work.
(let ((q (make-queue :limit 2 :byte-limit 8)) (seen nil))
  (enqueue q 1 (lambda () (push 1 seen)) 4)
  (enqueue q 2 (lambda () (push 2 seen)) 4)
  (assert (handler-case (progn (enqueue q 3 #'identity 1) nil) (error () t)))
  (funcall (take q)) (funcall (take q)) (assert (equal seen '(2 1)))
  (assert (zerop (getf (snapshot q) :bytes))))
;; Latest frame wins, other views survive, deletion removes stale work.
(let ((q (make-queue :limit 2 :byte-limit 8 :coalesce t)) (seen nil))
  (dotimes (i 1000) (let ((n i)) (enqueue q 1 (lambda () (push n seen)) 4)))
  (enqueue q 2 (lambda () (push 2 seen)) 4)
  (assert (= 999 (getf (snapshot q) :coalesced)))
  (assert (= 2 (getf (snapshot q) :peak-count)))
  (funcall (take q)) (assert (equal seen '(999)))
  (discard q 2) (assert (zerop (getf (snapshot q) :bytes)))
  (enqueue q 3 #'identity 8) (enqueue q 4 #'identity 8)
  (assert (= 1 (getf (snapshot q) :evicted)))
  (close-queue q) (assert (null (take q)))
  (assert (null (enqueue q 5 #'identity))))
;; Closing wakes all sleeping fixed workers, without holding a lock to join.
(let* ((q (make-queue))
       (workers (loop repeat 4 collect (sb-thread:make-thread (lambda () (take q))))))
  (sleep .03) (close-queue q)
  (dolist (thread workers) (assert (null (sb-thread:join-thread thread :timeout 2)))))
(format t "~&[NYXT DISPATCH QUEUES PASS]~%")
(let ((*read-suppress* t))
  (dolist (file '("ports/nyxt/wpe/nyxt-renderer.lisp"
                  "ports/nyxt/wpe/run-nyxt-app.lisp"))
    (with-open-file (in file)
      (loop until (eq :eof (read in nil :eof))))))
(format t "~&[NYXT DISPATCH READER PASS]~%")
