;;;; Exercise the actual harness guard against IMAGE's consuming transcript API.
(require :asdf)
(asdf:load-system :darterfly/test)
(in-package #:darterfly/test)
(let ((guard nil))
  (labels ((find-guard (tree)
             (when (consp tree)
               (or (when (and (eq (first tree) 'let)
                              (equal (second tree)
                                     '((transcript (image:transcript c)))))
                     tree)
                   (find-guard (car tree)) (find-guard (cdr tree))))))
    (with-open-file (in (darterfly-file "ports/nyxt/wpe/run-nyxt-app.lisp"))
      (loop for form = (read in nil :eof) until (eq form :eof)
            for found = (find-guard form) when found do (setf guard found))))
  (assert guard)
  (dolist (failure (list nil "panic(test)" "debugger invoked"
                        (format nil "~%stopped 42: WindowServer")))
    (let* ((c (image::%console nil))
           (before (concatenate 'string "boot and browser checks" failure))
           (check `(let ((c ',c)) ,guard)))
      (write-string before (image::console-seen c))
      ;; Rechecking must neither consume nor duplicate captured output.
      (dotimes (i 2)
        (assert (eql (not (null failure))
                     (handler-case (progn (eval check) nil) (error () t)))))
      ;; Cleanup appends more output even after the guard reports a failure.
      (write-string " cleanup" (image::console-seen c))
      (assert (string= (concatenate 'string before " cleanup")
                       (image:transcript c)))
      (assert (string= "" (image:transcript c))))))
(format t "~&[NYXT COMPLETE TRANSCRIPT EXPORT PASS]~%")
