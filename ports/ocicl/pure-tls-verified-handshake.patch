                                   (random-bytes 1)))))
           extensions)
-    ;; Check for cached session ticket for resumption
-    (let ((ticket (and (client-handshake-hostname hs)
+    ;; Verified connections require a fresh certificate handshake: this cache
+    ;; retains no certificate chain or verification policy, and the verified
+    ;; Finished path below rejects certificate-less PSK handshakes.
